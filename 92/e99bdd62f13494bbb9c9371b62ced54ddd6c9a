pwsh -NoProfile -File D:\Projects\Camel-wt\camel-remote.ps1 `
  -Path D:\Projects\Camel-wt\h105-gpu-placement `
  -Plan test/plans/feat/modules/tiles.plan.toml -Jobs 1
```

```sh
# 在主机上手动观察（Release 构建）
out/latest/bin/camel --devices cpu  test/cases/modules/tiles/gpu_fallback.cml std::nvm
out/latest/bin/camel --devices 0    test/cases/modules/tiles/gpu_fallback.cml std::nvm
CUDA_VISIBLE_DEVICES=-1 out/latest/bin/camel --devices 63 test/cases/modules/tiles/gpu_fallback.cml std::nvm
out/latest/bin/camel --devices invalid test/cases/modules/tiles/gpu_fallback.cml
out/latest/bin/camel --explain DeviceUnavailable
```

`--devices 63` 在有卡的机器上、不设 `CUDA_VISIBLE_DEVICES` 时，理由会写出机器上的卡数；设了
`CUDA_VISIBLE_DEVICES=-1` 时写"没有 CUDA 设备"。两者都点名 63。