/**
 * Signatures of the built-in functions: they need no import.
 *
 * The operators behind the language's own operators (`+`, `==`, `[]`, `??`, assignment, ...) are
 * registered under reserved names (`__add__`, ...) and are not listed here.
 *
 * These declarations are compiled with every program: a name they write that does not exist fails
 * every program, with its location here. They give a call's arguments their expected types (so a
 * lambda passed to `filter` needs no parameter types), --verify-ops checks them against the
 * operators the core registers, and docs/stdlib-reference.md is generated from them
 * (scripts/stdlib-reference.mjs).
 *
 * The parameter names written here are the names a call binds to by name (`len(x: xs)`), and they
 * are the ones the reference page prints: `--verify-ops` compares them with the names of the
 * registered rules, position by position, in both the `with` list and the ordinary one. Until
 * these declarations also decide which function a call matches (design principles, "the single
 * source of a signature"), the C++ rules still do, so the two have to stay equal, and a difference
 * is a test failure rather than a silent drift. The names here are the ones to keep:
 * the reference page is generated from them, and a position a call names is the position this file
 * names (stdlib-conventions.cn.md, section 4).
 */

import { ElementOf, WithElement, is_array, is_map, is_set, is_complex, is_numeric, is_real, is_same, is_string, is_function } from types

// An array of numbers or booleans (the element types an array stores compactly): the argument the
// elementwise conversions below take.
func is_compact_array::<A>() => bool {
    return match type A {
        case array => is_numeric::<ElementOf<A>>() || is_same::<ElementOf<A>, bool>()
        case _ => false
    }
}

/// The value an error carries: its kind, its message and the position it was made at. `error(...)`
/// makes one, and a `T!` that failed holds one. The module provides the type.
export type Error

// ---- memory ----
//
// Data blocks (design principles 10.5): the process-wide counters, read between two operations.

/// The data-block counters: blocks allocated so far, freed so far, live now, and the bytes the
/// live blocks hold. The call is not pure: it reports process state, so the optimizer must not
/// fold, merge or drop it.
/// @example std::mem::blocks().live    // 0 when no block is alive
#op(':op/mem_blocks')
export func std::mem::blocks() => { allocs: int, frees: int, live: int, bytes: int }

// ---- the tags of a derivative rule ----
//
// A tag is written on a function and holds a rule for it: `#jvp(rule)` is the rule forward mode
// uses, `#transpose(rule)` the one the transpose uses, `#vjp(rule)` the custom derivative. The
// rule has the signature of the transformation (`lib/autodiff/signatures/autodiff.cml`), and the tags
// are declared here, beside the operators the library writes them on, because a tag is a fact
// about any function and every program reads this file.

/// The rule of the function it is written on for forward mode: along the tangents of the
/// function's arguments it gives the tangent of its result. The rule has the signature of the
/// forward derivative of the function (`lib/autodiff/signatures/autodiff.cml`). The tag is written
/// where `vjp` is and takes the same kind of argument.
export tag jvp::<F>(rule: F) on func when is_function::<F>()

/// The rule of the function it is written on for the transpose, when the function is linear in
/// its arguments: from the cotangent of the result it gives the cotangents of the arguments. The
/// values the function was given are known when the transpose runs, so a rule is written only for
/// the arguments that carry the data.
export tag transpose::<F>(rule: F) on func when is_function::<F>()

/// The custom derivative of the function it is written on: calls of that function use `rule`
/// instead of differentiating its body. The rule has the signature of the pullback of the
/// function (`lib/autodiff/signatures/autodiff.cml`).
export tag vjp::<F>(rule: F) on func when is_function::<F>()

// ---- operators ----
//
// The scalar arithmetic operators of the core, declared here so that the library can name them:
// `a + b` is a call of the declaration below, and the two are one operator, not two.

/// The sum of two 32-bit floats.
/// @example f32(1.5) + f32(2.5)    // 4.0
#op(':op/add_f')
export func operator +(x: f32, y: f32) => f32

/// The sum of two 64-bit floats.
/// @example 1.5 + 2.5    // 4.0
#op(':op/add_d')
export func operator +(x: float, y: float) => float

/// The difference of two 32-bit floats.
/// @example f32(3.5) - f32(1.25)    // 2.25
#op(':op/sub_f')
export func operator -(x: f32, y: f32) => f32

/// The difference of two 64-bit floats.
/// @example 3.5 - 1.25    // 2.25
#op(':op/sub_d')
export func operator -(x: float, y: float) => float

// The remaining element types of `+` and `-`, one declaration per type: the sum of two integers is
// `+` at those two types, the sum of two strings is `+` too, and `-` is the difference at every
// numeric type. The two tokens end up as **ten** declarations for `+` (every one of them at two
// operands) and **sixteen** for `-`: eight differences at two operands and eight negations at one.
// One token, one operator, and the overloads are the element types -- the number of operands is what
// tells a negation apart from a difference.

/// The sum of two 32-bit integers.
#op(':op/add_i')
export func operator +(x: i32, y: i32) => i32

/// The sum of two 64-bit integers.
#op(':op/add_l')
export func operator +(x: int, y: int) => int

/// The sum of two 16-bit floats.
#op(':op/add_f6')
export func operator +(x: f16, y: f16) => f16

/// The sum of two `bf16` values.
#op(':op/add_bf')
export func operator +(x: bf16, y: bf16) => bf16

/// The sum of two single-precision complex numbers.
#op(':op/add_c')
export func operator +(x: c64, y: c64) => c64

/// The sum of two double-precision complex numbers.
#op(':op/add_z')
export func operator +(x: c128, y: c128) => c128

/// Two strings joined into one, the left one first.
#op(':op/add_s')
export func operator +(x: string, y: string) => string

/// Two byte strings joined into one, the left one first.
#op(':op/add_bytes')
export func operator +(x: Bytes, y: Bytes) => Bytes

/// The difference of two 32-bit integers.
#op(':op/sub_i')
export func operator -(x: i32, y: i32) => i32

/// The difference of two 64-bit integers.
#op(':op/sub_l')
export func operator -(x: int, y: int) => int

/// The difference of two 16-bit floats.
#op(':op/sub_f6')
export func operator -(x: f16, y: f16) => f16

/// The difference of two `bf16` values.
#op(':op/sub_bf')
export func operator -(x: bf16, y: bf16) => bf16

/// The difference of two single-precision complex numbers.
#op(':op/sub_c')
export func operator -(x: c64, y: c64) => c64

/// The difference of two double-precision complex numbers.
#op(':op/sub_z')
export func operator -(x: c128, y: c128) => c128

// The rest of the scalar arithmetic, one declaration per element type: a token's meaning at a type
// is what the type's operator is, and the declaration below is that meaning written down. `*`, `/`
// and unary `-` are one name with eight types each, so the eight are the overloads of one operator,
// not eight operators: `a * b` is a call of whichever of these the operands' type selects.
//
// A unary `-` is the same token as the binary one above (`-x` and `x - y` are two calls of one
// operator), so the two spellings are told apart by how many operands they take.

/// The product of two 32-bit floats.
#op(':op/mul_f')
export func operator *(x: f32, y: f32) => f32

/// The product of two 64-bit floats.
#op(':op/mul_d')
export func operator *(x: float, y: float) => float

/// The product of two 32-bit integers.
#op(':op/mul_i')
export func operator *(x: i32, y: i32) => i32

/// The product of two 64-bit integers.
#op(':op/mul_l')
export func operator *(x: int, y: int) => int

/// The product of two 16-bit floats.
#op(':op/mul_f6')
export func operator *(x: f16, y: f16) => f16

/// The product of two `bf16` values.
#op(':op/mul_bf')
export func operator *(x: bf16, y: bf16) => bf16

/// The product of two single-precision complex numbers.
#op(':op/mul_c')
export func operator *(x: c64, y: c64) => c64

/// The product of two double-precision complex numbers.
#op(':op/mul_z')
export func operator *(x: c128, y: c128) => c128

/// The quotient of two 32-bit floats.
#op(':op/div_f')
export func operator /(x: f32, y: f32) => f32 panic

/// The quotient of two 64-bit floats.
#op(':op/div_d')
export func operator /(x: float, y: float) => float panic

/// The truncated quotient of two 32-bit integers.
#op(':op/div_i')
export func operator /(x: i32, y: i32) => i32 panic

/// The truncated quotient of two 64-bit integers.
#op(':op/div_l')
export func operator /(x: int, y: int) => int panic

/// The quotient of two 16-bit floats.
#op(':op/div_f6')
export func operator /(x: f16, y: f16) => f16 panic

/// The quotient of two `bf16` values.
#op(':op/div_bf')
export func operator /(x: bf16, y: bf16) => bf16 panic

/// The quotient of two single-precision complex numbers.
#op(':op/div_c')
export func operator /(x: c64, y: c64) => c64 panic

/// The quotient of two double-precision complex numbers.
#op(':op/div_z')
export func operator /(x: c128, y: c128) => c128 panic

/// The negation of a 32-bit float.
#op(':op/neg_f')
export func operator -(x: f32) => f32

/// The negation of a 64-bit float.
#op(':op/neg_d')
export func operator -(x: float) => float

/// The negation of a 32-bit integer.
#op(':op/neg_i')
export func operator -(x: i32) => i32

/// The negation of a 64-bit integer.
#op(':op/neg_l')
export func operator -(x: int) => int

/// The negation of a 16-bit float.
#op(':op/neg_f6')
export func operator -(x: f16) => f16

/// The negation of a `bf16` value.
#op(':op/neg_bf')
export func operator -(x: bf16) => bf16

/// The negation of a single-precision complex number.
#op(':op/neg_c')
export func operator -(x: c64) => c64

/// The negation of a double-precision complex number.
#op(':op/neg_z')
export func operator -(x: c128) => c128

// Indexing, `xs[i]`. The operator registers three words -- the array, the position, and the
// dimension the position names -- and its registration says so
// (`lib/std/builtin/modules/globals.cpp`: `(arr: T[], index: int, axis: int) => T`); the declaration
// writes two, because the third is the declaration's default and the mechanism fills it before the
// operator's type rule sees the call, so a two-word `xs[i]` stays a two-word call. That is why
// `[]` is declared with the parameters a call writes and not with the registration's whole list,
// and why the same shape appears wherever this operator is declared under a module's own name
// (`test/cases/compile/native/generic_module.cml`).
//
// `[]` is not a token: it is a pair of brackets, and the declaration writes both. The parser reads
// `func operator [` `]` as an operator name already (parse/src/syntax/parser.cpp#parseOperatorName,
// whose own example is `func operator [](m: M, i: int): T`), because a bracket form is an operator
// declaration like any other, not a form of its own.

/// The element at position `i` on the first dimension of `xs`.
/// @example [7, 8, 9][0]    // 7
#op(':op/idx_arr')
export func operator []::<T>(xs: T[], i: int) => T panic

/// The character at position i of a string.
/// @example 'abc'[1]    // 'b'
#op(':op/idx_str')
export func operator [](s: string, i: int) => string panic

/// The value stored under key, or null when the map has no such key.
/// @example ([('a', 1)] as Map<string, int>)['a']    // 1
#op(':coll/map_idx')
export func operator []::<K, V>(m: Map<K, V>, key: K) => V?

/// A copy of the array holding the elements at the given indices along the axis.
#op(':op/idx_take')
export func operator []::<T>(arr: T[], indices: int[], axis: int) => T[] panic

// ---- the unary operators ----

/// The bitwise complement of a 32-bit integer.
/// @example ~i32(0)    // -1
#op(':op/inv_i')
export func operator ~(x: i32) => i32

/// The bitwise complement of a 64-bit integer.
/// @example ~0    // -1
#op(':op/inv_l')
export func operator ~(x: int) => int

/// The negation of a boolean.
/// @example !true    // false
#op(':op/not')
export func operator !(x: bool) => bool

// ---- the remaining binary operators: `%`, `&`, `|`, and the generic `==` ----

/// The remainder of dividing the first 32-bit integer by the second.
/// @example i32(7) % i32(2)    // 1
#op(':op/mod_i')
export func operator %(x: i32, y: i32) => i32 panic

/// The remainder of dividing the first 64-bit integer by the second.
/// @example 7 % 2    // 1
#op(':op/mod_l')
export func operator %(x: int, y: int) => int panic

/// The conjunction of two booleans.
/// @example true & false    // false
#op(':op/and')
export func operator &(x: bool, y: bool) => bool

/// The disjunction of two booleans.
/// @example true | false    // true
#op(':op/or')
export func operator |(x: bool, y: bool) => bool

/// Whether two arrays, tuples or structs of comparable parts are equal, part by part.
#op(':op/eq')
export func operator ==::<T>(a: T, b: T) => bool

// ---- comparison ----
//
// `==` and `!=` are operators of their own group (`__eq__`, `__ne__`; operator_names.h), and the
// rule each one names is the kernel for the operand type: `:op/eq_d` is the one for `float`.

/// Whether two 64-bit floats are equal.
/// @example 1.5 == 1.5    // true
#op(':op/eq_d')
export func operator ==(x: float, y: float) => bool

/// Whether two 32-bit floats are equal.
/// @example f32(1.5) == f32(1.5)    // true
#op(':op/eq_f')
export func operator ==(x: f32, y: f32) => bool

/// Whether two 32-bit integers are equal.
/// @example i32(3) == i32(3)    // true
#op(':op/eq_i')
export func operator ==(x: i32, y: i32) => bool

/// Whether two 64-bit integers are equal.
/// @example 3 == 3    // true
#op(':op/eq_l')
export func operator ==(x: int, y: int) => bool

/// Whether two half floats are equal.
/// @example f16(0.5) == f16(0.5)    // true
#op(':op/eq_f6')
export func operator ==(x: f16, y: f16) => bool

/// Whether two bfloat16 values are equal.
/// @example bf16(0.5) == bf16(0.5)    // true
#op(':op/eq_bf')
export func operator ==(x: bf16, y: bf16) => bool

/// Whether two single-precision complex values are equal.
/// @example c64(1.0, 2.0) == c64(1.0, 2.0)    // true
#op(':op/eq_c')
export func operator ==(x: c64, y: c64) => bool

/// Whether two double-precision complex values are equal.
/// @example c128(1.0, 2.0) == c128(1.0, 2.0)    // true
#op(':op/eq_z')
export func operator ==(x: c128, y: c128) => bool

/// Whether two strings are equal, character by character.
/// @example 'ab' == 'ab'    // true
#op(':op/eq_s')
export func operator ==(x: string, y: string) => bool

/// Whether two byte blocks are equal, byte by byte.
/// @example to_bytes([1] as i32[]) == to_bytes([1] as i32[])    // true
#op(':op/eq_bytes')
export func operator ==(x: Bytes, y: Bytes) => bool

/// Whether two booleans are equal.
/// @example true == true    // true
#op(':op/eq_b')
export func operator ==(x: bool, y: bool) => bool

// ---- ordering ----

/// Whether the first 64-bit float is less than the second.
/// @example 1.5 < 2.5    // true
#op(':op/lt_d')
export func operator <(x: float, y: float) => bool

/// Whether the first of two 32-bit floats is less than the second.
#op(':op/lt_f')
export func operator <(x: f32, y: f32) => bool

/// Whether the first of two 32-bit integers is less than the second.
#op(':op/lt_i')
export func operator <(x: i32, y: i32) => bool

/// Whether the first of two 64-bit integers is less than the second.
#op(':op/lt_l')
export func operator <(x: int, y: int) => bool

/// Whether the first of two half floats is less than the second.
#op(':op/lt_f6')
export func operator <(x: f16, y: f16) => bool

/// Whether the first of two bfloat16 values is less than the second.
#op(':op/lt_bf')
export func operator <(x: bf16, y: bf16) => bool

/// Whether the first of two strings is less than the second.
#op(':op/lt_s')
export func operator <(x: string, y: string) => bool

// ---- ordering: `<=` ----

/// Whether the first 64-bit float is less than or equal to the second.
/// @example 1.5 <= 1.5    // true
#op(':op/le_d')
export func operator <=(x: float, y: float) => bool

/// Whether the first 32-bit float is less than or equal to the second.
#op(':op/le_f')
export func operator <=(x: f32, y: f32) => bool

/// Whether the first 32-bit integer is less than or equal to the second.
#op(':op/le_i')
export func operator <=(x: i32, y: i32) => bool

/// Whether the first 64-bit integer is less than or equal to the second.
#op(':op/le_l')
export func operator <=(x: int, y: int) => bool

/// Whether the first half float is less than or equal to the second.
#op(':op/le_f6')
export func operator <=(x: f16, y: f16) => bool

/// Whether the first bfloat16 value is less than or equal to the second.
#op(':op/le_bf')
export func operator <=(x: bf16, y: bf16) => bool

/// Whether the first string is less than or equal to the second, character by character.
#op(':op/le_s')
export func operator <=(x: string, y: string) => bool

// ---- ordering: `>` ----

/// Whether the first of two 64-bit floats is greater than the second.
/// @example 2.5 > 1.5    // true
#op(':op/gt_d')
export func operator >(x: float, y: float) => bool

/// Whether the first of two 32-bit floats is greater than the second.
#op(':op/gt_f')
export func operator >(x: f32, y: f32) => bool

/// Whether the first of two 32-bit integers is greater than the second.
#op(':op/gt_i')
export func operator >(x: i32, y: i32) => bool

/// Whether the first of two 64-bit integers is greater than the second.
#op(':op/gt_l')
export func operator >(x: int, y: int) => bool

/// Whether the first of two half floats is greater than the second.
#op(':op/gt_f6')
export func operator >(x: f16, y: f16) => bool

/// Whether the first of two bfloat16 values is greater than the second.
#op(':op/gt_bf')
export func operator >(x: bf16, y: bf16) => bool

/// Whether the first of two strings is greater than the second.
#op(':op/gt_s')
export func operator >(x: string, y: string) => bool

// ---- ordering: `>=` ----

/// Whether the first of two 64-bit floats is greater than or equal to the second.
/// @example 2.5 >= 2.5    // true
#op(':op/ge_d')
export func operator >=(x: float, y: float) => bool

/// Whether the first of two 32-bit floats is greater than or equal to the second.
#op(':op/ge_f')
export func operator >=(x: f32, y: f32) => bool

/// Whether the first of two 32-bit integers is greater than or equal to the second.
#op(':op/ge_i')
export func operator >=(x: i32, y: i32) => bool

/// Whether the first of two 64-bit integers is greater than or equal to the second.
#op(':op/ge_l')
export func operator >=(x: int, y: int) => bool

/// Whether the first of two half floats is greater than or equal to the second.
#op(':op/ge_f6')
export func operator >=(x: f16, y: f16) => bool

/// Whether the first of two bfloat16 values is greater than or equal to the second.
#op(':op/ge_bf')
export func operator >=(x: bf16, y: bf16) => bool

/// Whether the first of two strings is greater than or equal to the second.
#op(':op/ge_s')
export func operator >=(x: string, y: string) => bool

// ---- power and the remaining binary operators ----

/// The 64-bit float raised to the power of the second.
/// @example 2.0 ^ 3.0    // 8.0
#op(':op/pow_d')
export func operator ^(x: float, y: float) => float

/// The 32-bit float raised to the power of the second.
/// @example f32(2.0) ^ f32(3.0)    // 8.0
#op(':op/pow_f')
export func operator ^(x: f32, y: f32) => f32

/// The 32-bit integer raised to the power of the second.
#op(':op/pow_i')
export func operator ^(x: i32, y: i32) => i32

/// The 64-bit integer raised to the power of the second.
#op(':op/pow_l')
export func operator ^(x: int, y: int) => int

/// The half float raised to the power of the second.
#op(':op/pow_f6')
export func operator ^(x: f16, y: f16) => f16

/// The bfloat16 value raised to the power of the second.
#op(':op/pow_bf')
export func operator ^(x: bf16, y: bf16) => bf16

/// The single-precision complex value raised to the power of the second.
#op(':op/pow_c')
export func operator ^(x: c64, y: c64) => c64

/// The single-precision complex value raised to a 32-bit integer power.
#op(':op/pow_c_i')
export func operator ^(x: c64, y: i32) => c64

/// The single-precision complex value raised to a 64-bit integer power.
#op(':op/pow_c_l')
export func operator ^(x: c64, y: int) => c64

/// The double-precision complex value raised to the power of the second.
#op(':op/pow_z')
export func operator ^(x: c128, y: c128) => c128

/// The double-precision complex value raised to a 32-bit integer power.
#op(':op/pow_z_i')
export func operator ^(x: c128, y: i32) => c128

/// The double-precision complex value raised to a 64-bit integer power.
#op(':op/pow_z_l')
export func operator ^(x: c128, y: int) => c128

// ---- conversions ----
//
// Numeric types are never converted implicitly; these functions do it. There is one conversion
// per target type, named by the type: `int`, `i32`, `float`, `f32`, `bf16`, `f16`, `c64`, `c128`
// (and `i64`, `f64`, the spellings of `int` and `float`). Each is one declaration per source type,
// the overloads of one name written under one comment. Applied to an array, a conversion converts every element (one rule with arithmetic:
// `f32(xs)` is one node, and `T(xs)` does it for the type a generic function is given); that entry
// is declared below, with the core's conversions: it needs no import. Converting a float to an integer drops the fraction.

/// x as a 64-bit integer.
/// @fails fault `InvalidNumberText` when x is a string that is not, as a whole, one integer (blanks and a trailing part included); fault `ConversionOutOfRange` when x is a string that is an integer beyond the range, or a float that is NaN, infinite or beyond the range; use parse_int to handle text in the program
/// @example int(2.9)    // 2
#op(':op/itol')
export func int(x: i32) => int
#op(':op/ltol')
export func int(x: int) => int
#op(':op/ftol')
export func int(x: f32) => int
#op(':op/dtol')
export func int(x: float) => int
#op(':op/stol')
export func int(x: string) => int
#op(':op/bftol')
export func int(x: bf16) => int
#op(':op/f6tol')
export func int(x: f16) => int

/// The same as int.
/// @fails fault `InvalidNumberText` when x is a string that is not, as a whole, one integer; fault `ConversionOutOfRange` when x is a string that is an integer beyond the range, or an int or a float beyond the range of i32, or NaN
/// @example i64('42')    // 42
#op(':op/itol')
export func i64(x: i32) => int
#op(':op/ltol')
export func i64(x: int) => int
#op(':op/ftol')
export func i64(x: f32) => int
#op(':op/dtol')
export func i64(x: float) => int
#op(':op/stol')
export func i64(x: string) => int
#op(':op/bftol')
export func i64(x: bf16) => int
#op(':op/f6tol')
export func i64(x: f16) => int

/// x as a 32-bit integer.
/// @fails fault `InvalidNumberText` when x is a string that is not, as a whole, one integer; fault `ConversionOutOfRange` when x is a string that is an integer beyond the range, or an int or a float beyond the range of i32, or NaN
/// @example i32(7)    // 7
#op(':op/itoi')
export func i32(x: i32) => i32
#op(':op/ltoi')
export func i32(x: int) => i32
#op(':op/ftoi')
export func i32(x: f32) => i32
#op(':op/dtoi')
export func i32(x: float) => i32
#op(':op/stoi')
export func i32(x: string) => i32
#op(':op/bftoi')
export func i32(x: bf16) => i32
#op(':op/f6toi')
export func i32(x: f16) => i32

/// x as a 64-bit float.
/// @fails fault `InvalidNumberText` when x is a string that is not, as a whole, one number; fault `ConversionOutOfRange` when x is a string that is a number beyond the range of float (overflow or underflow); use parse_float to handle that in the program
/// @example float(3)    // 3
#op(':op/itod')
export func float(x: i32) => float
#op(':op/ltod')
export func float(x: int) => float
#op(':op/ftod')
export func float(x: f32) => float
#op(':op/dtod')
export func float(x: float) => float
#op(':op/stod')
export func float(x: string) => float
#op(':op/bftod')
export func float(x: bf16) => float
#op(':op/f6tod')
export func float(x: f16) => float

/// The same as float.
/// @fails fault `InvalidNumberText` when x is a string that is not a number; fault `ConversionOutOfRange` when x is a string that is a number beyond the range of float (overflow or underflow)
/// @example f64('2.5')    // 2.5
#op(':op/itod')
export func f64(x: i32) => float
#op(':op/ltod')
export func f64(x: int) => float
#op(':op/ftod')
export func f64(x: f32) => float
#op(':op/dtod')
export func f64(x: float) => float
#op(':op/stod')
export func f64(x: string) => float
#op(':op/bftod')
export func f64(x: bf16) => float
#op(':op/f6tod')
export func f64(x: f16) => float

/// x as a 32-bit float.
/// @fails fault `InvalidNumberText` when x is a string that is not a number; fault `ConversionOutOfRange` when x is a string that is a number beyond the range of f32 (overflow or underflow)
/// @example f32(0.5)    // 0.5
#op(':op/itof')
export func f32(x: i32) => f32
#op(':op/ltof')
export func f32(x: int) => f32
#op(':op/ftof')
export func f32(x: f32) => f32
#op(':op/dtof')
export func f32(x: float) => f32
#op(':op/stof')
export func f32(x: string) => f32
#op(':op/bftof')
export func f32(x: bf16) => f32
#op(':op/f6tof')
export func f32(x: f16) => f32

/// x as a bf16: the nearest bf16 of x, rounding to nearest with ties to even, once. A bf16 is a
/// floating-point type of the language (design principles 7.3), not only a tensor element type,
/// and writing the conversion asks for that precision, so no numeric permission is involved.
/// @fails fault `InvalidNumberText` when x is a string that is not a number; fault `ConversionOutOfRange` when x is a string that is a number beyond the range of bf16 (overflow or underflow)
/// @example bf16(0.5)    // 0.5
#op(':op/itobf')
export func bf16(x: i32) => bf16
#op(':op/ltobf')
export func bf16(x: int) => bf16
#op(':op/ftobf')
export func bf16(x: f32) => bf16
#op(':op/dtobf')
export func bf16(x: float) => bf16
#op(':op/bftobf')
export func bf16(x: bf16) => bf16
#op(':op/stobf')
export func bf16(x: string) => bf16

/// x as an f16: the nearest f16 of x, rounding to nearest with ties to even, once. The same
/// conversion as bf16, at the other reduced precision (design principles 7.3).
/// @fails fault `InvalidNumberText` when x is a string that is not a number; fault `ConversionOutOfRange` when x is a string that is a number beyond the range of f16 (overflow or underflow)
/// @example f16(0.5)    // 0.5
#op(':op/itof6')
export func f16(x: i32) => f16
#op(':op/ltof6')
export func f16(x: int) => f16
#op(':op/ftof6')
export func f16(x: f32) => f16
#op(':op/dtof6')
export func f16(x: float) => f16
#op(':op/f6tof6')
export func f16(x: f16) => f16
#op(':op/stof6')
export func f16(x: string) => f16

/// The conversion `i32` applied to every element of a numeric array: the result has the input's extents and element type `i32`. A scalar converts by the declaration above.
/// @pure
/// @example i32([1.0, 2.0])
#op(':op/atoi')
export func i32::<A>(x: A) => WithElement<A, i32> when is_compact_array::<A>()

/// The conversion `i64` applied to every element of a numeric array: the result has the input's extents and element type `int64`. A scalar converts by the declaration above.
/// @pure
/// @example i64([1.0, 2.0])
#op(':op/atol')
export func i64::<A>(x: A) => WithElement<A, int> when is_compact_array::<A>()

/// The conversion `int` applied to every element of a numeric array: the result has the input's extents and element type `int64`. A scalar converts by the declaration above.
/// @pure
/// @example int([1.0, 2.0])
#op(':op/atol')
export func int::<A>(x: A) => WithElement<A, int> when is_compact_array::<A>()

/// The conversion `f32` applied to every element of a numeric array: the result has the input's extents and element type `f32`. A scalar converts by the declaration above.
/// @pure
/// @example f32([1.0, 2.0])
#op(':op/atof')
export func f32::<A>(x: A) => WithElement<A, f32> when is_compact_array::<A>()

/// The conversion `f64` applied to every element of a numeric array: the result has the input's extents and element type `f64`. A scalar converts by the declaration above.
/// @pure
/// @example f64([1.0, 2.0])
#op(':op/atod')
export func f64::<A>(x: A) => WithElement<A, float> when is_compact_array::<A>()

/// The conversion `float` applied to every element of a numeric array: the result has the input's extents and element type `f64`. A scalar converts by the declaration above.
/// @pure
/// @example float([1.0, 2.0])
#op(':op/atod')
export func float::<A>(x: A) => WithElement<A, float> when is_compact_array::<A>()

/// The conversion `bf16` applied to every element of a numeric array: the result has the input's extents and element type `bf16`. A scalar converts by the declaration above. A conversion into `bf16` or `f16` rounds (to nearest, ties to even); writing it asks for that precision, so it needs no numeric permission (`change_precision` governs a computation the compiler moves to lower precision, design principles 7.2-7.3).
/// @pure
/// @example bf16([1.0, 2.0])
#op(':op/atobf')
export func bf16::<A>(x: A) => WithElement<A, bf16> when is_compact_array::<A>()

/// The conversion `f16` applied to every element of a numeric array: the result has the input's extents and element type `f16`. A scalar converts by the declaration above. A conversion into `bf16` or `f16` rounds (to nearest, ties to even); writing it asks for that precision, so it needs no numeric permission (`change_precision` governs a computation the compiler moves to lower precision, design principles 7.2-7.3).
/// @pure
/// @example f16([1.0, 2.0])
#op(':op/atof6')
export func f16::<A>(x: A) => WithElement<A, f16> when is_compact_array::<A>()

/// x as a 64-bit complex number: the real part is x and the imaginary part is zero. A c128
/// keeps both parts as they are.
/// @example c64(2)    // 2+0i
#op(':op/itoc')
export func c64(x: i32) => c64
#op(':op/ltoc')
export func c64(x: int) => c64
#op(':op/ftoc')
export func c64(x: f32) => c64
#op(':op/dtoc')
export func c64(x: float) => c64
#op(':op/ctoc')
export func c64(x: c64) => c64
#op(':op/ztoc')
export func c64(x: c128) => c64

/// x as a 128-bit complex number: the real part is x and the imaginary part is zero.
/// @example c128(2)    // 2+0i
#op(':op/itoz')
export func c128(x: i32) => c128
#op(':op/ltoz')
export func c128(x: int) => c128
#op(':op/ftoz')
export func c128(x: f32) => c128
#op(':op/dtoz')
export func c128(x: float) => c128
#op(':op/ctoz')
export func c128(x: c64) => c128
#op(':op/ztoz')
export func c128(x: c128) => c128

/// x as text, as println writes it. A float is written as the shortest text that reads back as
/// the same number: string(2.5) is '2.5', string(2.0) is '2.0'.
/// @example string(42)    // '42'
#op(':op/atos')
export func string::<T>(x: T) => string

/// The integer a text spells, or an error value.
/// @fails error `ParseError` when the text is not, as a whole, one integer (blanks are not skipped)
/// @example parse_int('42') !! 0    // 42
#op(':op/parse_int')
export func parse_int(text: string) => int!

/// The number a text spells, or an error value.
/// @fails error `ParseError` when the text is not a number
/// @example parse_float('2.5') !! 0.0    // 2.5
#op(':op/parse_float')
export func parse_float(text: string) => float!

/// An Error value of the given kind with the given message; the compiler adds the source
/// position of the call. `return error(...)` hands it out of a function declared `T!`.
/// @example return error('RangeError', 'too large')
#op(':op/error_new')
export func error(kind: string, message: string) => Error

// ---- input and output ----

/// Writes the arguments, separated by spaces, without a line end, and gives back the first one
/// (so that the write can be part of the data flow). The other arguments may each have a type
/// of their own. With a format, print<fmt>(...), writes the format with the arguments put in,
/// also without a line end.
/// @example print('a', 1)    // a 1
#op(':io/print')
with <fmt: string>
export func print::<T>(x: T, ...rest) => T panic
#op(':io/print')
export func print::<T>(x: T, ...rest) => T panic
#op(':io/print')
export func print() => void panic

/// Writes the arguments, separated by spaces, and a line end, and gives back the first one (so
/// that the write can be part of the data flow). The other arguments may each have a type of
/// their own. With a format, println<fmt>(...), writes the format with the arguments put in and
/// one line end.
/// @example println('a', 1)    // a 1
#op(':io/println')
with <fmt: string>
export func println::<T>(x: T, ...rest) => T panic
#op(':io/println')
export func println::<T>(x: T, ...rest) => T panic
#op(':io/println')
export func println() => void panic

/// Writes the arguments, separated by spaces, and a line end, to standard error, and gives back
/// the first one (so that the write can be part of the data flow). The other arguments may each
/// have a type of their own. With a format, eprintln<fmt>(...), writes the format with the
/// arguments put in and one line end.
/// @example eprintln('a', 1)    // a 1
#op(':io/eprintln')
with <fmt: string>
export func eprintln::<T>(x: T, ...rest) => T panic
#op(':io/eprintln')
export func eprintln::<T>(x: T, ...rest) => T panic
#op(':io/eprintln')
export func eprintln() => void panic

// ---- strings ----

/// The text fmt with each `{}` placeholder replaced by the next argument; placeholders take
/// format specifications such as `{:.2f}` and `{:>8}`.
///
/// A specification whose argument is a numeric array acts on each element on its own, while the
/// brackets and the `, ` between the elements are the array's own form: `'{:.4f}'->format<xs>`
/// with `xs = [0.7692267, 0.780836, 0.77707076]` is `[0.7692, 0.7808, 0.7771]`, and an array of
/// rank 2 keeps one bracket level per dimension (`[[0.7692, 0.7808], [0.7771, 2.0000]]`). Each
/// element is written by the specification and by its own type, so `{:.2f}` rounds an `f32`
/// element and an `f64` element each at two places. An array without a specification prints as
/// it does everywhere else: every element in the shortest text that reads back as the same
/// number, which is `'{}'->format<xs>` giving `[0.7692267, 0.780836, 0.77707076]`.
/// @fails fault `FormatFailed` when the placeholders and the arguments do not fit
/// @example '{} is {:.2f}'->format<'x', 2.5>    // 'x is 2.50'
#op(':str/format')
with <...args>
export func format(fmt: string) => string panic

/// The strings of xs joined with sep between them.
/// @example ['a', 'b']->join<', '>    // 'a, b'
#op(':str/join')
with <sep: string>
export func join(xs: string[]) => string

/// The number of code points of a string.
/// @pure
/// @example len('h€')    // 2
#op(':struct/len_str')
export func len(x: string) => int

/// The length of the first dimension of an array of any rank.
/// @pure
/// @example len([1, 2, 3])    // 3
#op(':struct/len_arr')
export func len::<A>(x: A) => int when is_array::<A>()

/// The number of bytes of a `Bytes`.
/// @pure
/// @example len(encode('h€'))    // 4
/// @example-fragment the example builds its `Bytes` with `encode` from the `bytes` module, which this page does not import
#op(':struct/len_bytes')
export func len(x: Bytes) => int

/// The extents an array type writes down, in order: `extent_of::<float[2, 3]>()` is `[2, 3]`.
///
/// The answer is a fact of the type argument and of nothing else, so the call takes no argument and
/// names one type: `A` is the whole array type, the way a transposition law names one (`matmul_t::<T,
/// A, B>`). Every extent of `A` has to be a number written in the type; a type that leaves one open
/// states no shape -- `float[]` (= `float[?]`) states one dimension and no length, and `float[...]`
/// states neither the rank nor a length -- and is refused where the call is instantiated. A shape
/// that is a fact of a *value* is `shape(x)`, which is a question about the value and not the type.
///
/// A transposition is where this is needed: the adjoint of a map is a function of the cotangent and
/// of the shape of the map's domain, and a parameter whose cotangent is what the transposed function
/// takes has no value to read (`func pick(x: float[3])`). `transpose(pick)` answers
/// `([0.0, 1.0, 0.0])` because the shape the law spreads its cotangent over is written in the type
/// `x` is declared with, and this is the language's one spelling of "the shape a type writes down" --
/// the transposition walk asks the same rule (`statedExtentsOf`).
///
/// The value is settled where the call is built and where the name is used as a value, and the
/// graph holds the list itself: the operator records the instantiated type of the call but not the
/// type argument it was written with, so the run has nothing left to read
/// (`lib/std/builtin/operators/struct.cpp#ExtentOfResolver`, the rule's
/// `valueFromTypeArgs`). The refusal names the **position** that has no number in it
/// (`SemanticDiag::ExtentOfNeedsStatedShape`).
///
/// @pure
/// @example extent_of::<float[2, 3]>()    // [2, 3]
#op(':op/extent_of')
export func extent_of::<A>() => int[] when is_array::<A>()

/// A second name of a mutable value: a write the program makes through the copy is not seen
/// through the original, and vice versa. A value the collector traces is cloned under its own
/// type; a scalar and a value whose parts no write could be seen through are handed on as they
/// are. `var b = a` asks the same question at a declaration, and the answer is the same one.
///
/// A copy is a call of `:op/copy`, an `OPER` node like any other operator call (plan 2.3, step
/// 1): the three backends ask the same two things of the value -- whether its type is one the
/// collector traces, and what its static type is -- so the operator answers with their rule and
/// not a second one (`lib/std/builtin/operators/copy.cpp`).
///
/// @pure
/// @example copy([1, 2])    // [1, 2]
#op(':op/copy')
export func copy::<T>(x: T) => T

/// A conversion is a call of `:op/cast`, an `OPER` node like any other operator call (plan 2.3,
/// step 2). The target type is the call's own result type and the source type is the operand's, so
/// a conversion needs no compile-time parameter beside them: the two facts a record keyed by URI
/// holds are the two a conversion asks. The implementation is the type's own conversion
/// (`lib/std/builtin/operators/cast.cpp`), so a conversion that checks its value still checks it
/// and one that cannot fail still cannot. It states `panic` because one conversion of a pair whose
/// types make it safe is not the one being looked at here: the operator is a call of every pair
/// the compiler builds.
///
/// A program writes a conversion as `T(x)` or `x as T`, and those reach this operator by the
/// language's own conversion rules; the call form is the name a graph holds the conversion under.
/// The two type parameters are the pair a conversion is about, so a call names them.
/// @pure
/// @example cast::<int, int>(1)    // the pair that is already one type: no table is asked
#op(':op/cast')
export func cast::<T, U>(x: T) => U panic

/// Entering is a call of `:op/enter`, the operator the **compiler** writes and a program does not
/// (design principles 5.1, "entering is not a conversion"): the step that puts a value into a form
/// it belongs in -- `T` into `T?` or `T!`, an error value into a type with `!` -- to make two types
/// meet. It always succeeds: it asks no safety table (`:op/cast` above is the conversion a program
/// writes, and that one checks the pair), and the record states no fault for it.
///
/// A value reaches this operator only where the language puts it into a position of that form by
/// itself: an argument, a typed `let`, an array element, an arm of a branch, a declared return. A
/// program that needs a conversion writes `T(x)` or `x as T`, which is `:op/cast`; where making
/// two types meet would need a conversion that can fail, the program is a type error and no call
/// is built at all, so what the compiler inserted never fails at run time.
/// @pure
/// @example let x: int? = 1    // the literal enters the optional that position asks for
#op(':op/enter')
export func enter::<T, U>(x: T) => U

/// A construction as an ordinary operator: the FILL node kind written as a call of the operator
/// that does the same thing (plan 2.3, step 2). `template` is the aggregate the value is made from
/// -- the compiler builds one constant of the target type and every construction of that type
/// clones it -- and the rest parameters are the field values. The fill kind is the target type's
/// own: a tuple is filled by position, an array by element, a struct by field and a function value
/// by capture (`lib/std/builtin/operators/struct.cpp`). A caller whose field order is not the
/// component order states the component each field fills as a `with` argument -- the same rule
/// `:op/access` follows with `with <at: int>` -- one `int` per field, in the order the fields are
/// given, because a position is a compile-time constant of the call and an ordinary parameter
/// could not be told apart from a field value that is an `int`. `fill::<(int, int), int,
/// int><1, 0>((0, 0), 1, 2)` reads the first value into component 1 and the second into component
/// 0, which is the value `(2, 1)`; with no `with` argument the fields are the components in order.
///
/// A program writes a construction as the aggregate itself, `(1, 'a')` or `Point { x: 1 }`, and
/// those reach this operator through the language's own rules; the call form is the name a graph
/// holds the construction under, and it is where a field order the aggregate cannot spell is
/// written down.
///
/// It states no `panic`: `template` is a constant of the target type and the call's result type is
/// that same type, so a run clones a value that already fits and has nothing left to check. A
/// construction the compiler builds for an aggregate literal is that same step, and it is the one
/// that answered "cannot fault" while it was a node kind.
/// @pure
/// @example fill((0, 0), 1, 2)    // (1, 2)
#op(':op/fill')
with <...slots: int>
export func fill::<T, ...F>(template: T, ...fields: ...F) => T

/// A member read as an ordinary operator: the ACCS node kind written as a call of the operator
/// that does the same thing (plan 2.3, step 2). The position is a compile-time parameter of the
/// operator and a `with` argument of the call: an `int` for the element of a tuple, a `string`
/// for the field of a struct. The value the read reads is the call's one ordinary operand; the
/// compiler puts the member in `with` and links the value as the call's operand
/// (`lib/std/builtin/operators/struct.cpp`).
///
/// A program writes a member read as `t[0]` or `s.x`, and those reach this operator through the
/// language's own rules; the call form is the name a graph holds the read under.
///
/// It states no `panic`: the position is a compile-time parameter of the call, so the type being
/// read and the member being named are both settled before a run starts, and a run has nothing to
/// check. The `ACCS` kind this operator used to be answered the same way.
/// @pure
/// @example access::<(int, int), int><0>((1, 2))    // 1
#op(':op/access')
with <at: int>
export func access::<T, U>(x: T) => U

/// The same member read by name: the field of a struct, which the compiler spells `s.x`. It is a
/// second URI rather than a second rule of `:op/access`, because the two read different things of
/// the value (an element by position, a field by name) and a graph says which it means by the URI
/// it holds -- the operand's type would answer the same question, but a rule that has to be asked
/// the type to know what it does is what the node kinds were.
/// @pure
/// @example access_key::<{ x: int, y: int }, int><'y'>({ x: 1, y: 2 })    // 2
#op(':op/access_key')
with <key: string>
export func access_key::<T, U>(x: T) => U

// ---- arrays ----

/// The array of the integers of a step: `start`, `start + step`, ... up to, not including, `end`;
/// with no step the step is 1. This is the materialised form and nothing else asks for it: the
/// interval `a..b` is the value `to_range(a, b, 1)` (design principles 4.2, 5.4), and `to_array`
/// is the one place a range becomes an array. `step` must move: a step of 0 is a fault, and a
/// constant call with a step of 0 is refused where it is written. The result is empty when the
/// step does not carry `start` towards `end`.
/// @fails fault `InvalidArgument` when the step is 0
/// @example range(0, 10, 3)     // [0, 3, 6, 9]
/// @example range(10, 0, -3)    // [10, 7, 4, 1]
#op(':struct/range')
export func range(start: int, end: int, step: int) => int[] panic

// ---- ranges ----
//
// A range is a value of its own type, not an array (design principles 5.4): `Range` writes the
// three numbers that name it down, `to_array` is the one conversion from it to the integers it
// names, and `to_range` is the constructor the interval `a..b` itself is built with (with a step
// of 1).
//
// These names are written without an `import`: the prelude is the built-in module's declaration
// file, and what it exports comes along with the built-in rules it declares (design principles
// 10.2, the last layer) -- the types with the functions. `to_range` is an operator as well, so the
// compiler writes its name for `a..b` like any other operator's.

/// The three numbers naming a step of integers: `start`, `start + step`, ... up to, not
/// including, `stop`. An end is null when a range is written without it (`..b`, `a..`, `..`), and
/// there the missing end is the axis's own where the range is a subscript of it.
export type Range = { start: int?, stop: int?, step: int }

/// The range from start up to, not including, stop, taken in steps of step: what the interval
/// `a..b` is, with a step of 1, and what its three numbers are. `step` must move, as the array
/// `range(a, b, s)` requires.
/// @fails fault `InvalidArgument` when the step is 0
/// @example to_range(1, 5, 1)->to_array()    // [1, 2, 3, 4]
#op(':range/to_range')
export func to_range(start: int, stop: int, step: int) => Range panic

/// The integers of r as an array: the conversion from a range to the array it is not, and the only
/// one -- nothing turns an array into a range. A range whose end is left out names no array (an
/// open end is a bound of the axis the range is a subscript of), so the call faults instead of
/// inventing one.
/// @fails fault `RangeWithoutEnd` when start or stop is null
/// @example to_range(1, 5, 1)->to_array()    // [1, 2, 3, 4]
export func to_array(r: Range) => int[] {
    let start = r.start ?? fail<'RangeWithoutEnd'>('an open range has no array form: start is left out')
    let stop = r.stop ?? fail<'RangeWithoutEnd'>('an open range has no array form: stop is left out')
    return range(start, stop, r.step)
}

/// Whether r holds no integer.
/// @example to_range(3, 3, 1)->is_empty()    // true
export func is_empty(r: Range) => bool {
    return len(to_array(r)) == 0
}

// The functions a range shares with an `int[]` are ordinary functions of the same names, declared
// beside the operators of those names. What each does is the array's own, on the array the range
// names -- a range is a value and `to_array` is the one conversion from it, so a range gets no
// second implementation of these.
//
// They are the prelude's exports like the rest, so no `import` is written for them either. They
// are functions of this module and not rules of the operator group of the same spelling, though:
// a call from another module resolves the name through that group, which has no rule for a range,
// so `(0 .. 3)->map<f>` there reports no matching function today (`:mark/map_arr` is the only
// candidate). Making a range reachable under these names is a rule in the group -- an operator's
// work -- and not a change to these declarations.

/// f applied to every integer r names; the calls have no order among them, and the result is by
/// position, as `map` on the array the range names.
/// @example (0 .. 3)->map<func (x: int) => int { x * 2 }>    // [0, 2, 4]
with <f: (item: int) => U>
export func map::<U>(r: Range) => U[] {
    return to_array(r)->map<f>
}

/// The integers of r for which f is true, in order; the calls of f have no order among them.
/// @example (0 .. 5)->filter<func (x: int) => bool { x % 2 == 0 }>    // [0, 2, 4]
with <f: (item: int) => bool>
export func filter(r: Range) => int[] {
    return to_array(r)->filter<f>
}

/// Calls f for every integer r names, in order, as `foreach` on the array the range names.
/// @example (0 .. 3)->foreach<func (x) { println(x) }>
with <f: (item: int) => void>
export func foreach(r: Range) => void {
    return to_array(r)->foreach<f>
}

/// The integers of r for which pred is true, counted. The calls of pred have no order among
/// them.
/// @example (0 .. 5)->count<func (x: int) => bool { x % 2 == 0 }>    // 3
with <pred: (item: int) => bool>
export func count(r: Range) => int {
    return loop n = 0 for x in r do if pred(x) then n + 1 else n
}

/// The first integer of r for which pred is true, or null when none is. The calls of pred have
/// no order among them.
/// @example (0 .. 5)->find<func (x: int) => bool { x > 2 }>    // 3
with <pred: (item: int) => bool>
export func find(r: Range) => int? {
    let hits = filter<pred>(r)
    return if len(hits) == 0 then null else hits[0]
}

/// The integers of r combined from left to right with initial:
/// f(...f(f(initial, start), start + step)..., the last one). Both are written in the angle
/// brackets, as `reduce` on an array writes them.
/// @example (0 .. 3)->reduce<func (acc: int, x: int) => int { acc + x }, 0>    // 3
with <f: (acc: U, item: int) => U, initial: U>
export func reduce::<U>(r: Range) => U {
    return to_array(r)->reduce<f, initial>
}

/// How many integers r names.
/// @example (0 .. 5)->len()    // 5
export func len(r: Range) => int {
    return len(to_array(r))
}

/// The integers of r, written as the array they are.
/// @example (0 .. 3)->print()    // [0, 1, 2]
export func print(r: Range) => void {
    return println(to_array(r))
}

// ---- a range's stream ----
//
// `for i in r` asks the type of `r` how to walk it (design principles 3.10, 5.4): it calls the
// operator group `__iter__`, exactly as `r[i]` calls `__idx__`. The operator is `for`, so a type
// answers with `func operator for(v: V) => T..`, and a range's answer is `operator for` below. Its
// parameters are the value to walk -- one, like `operator []`'s two -- and what it answers is a
// stream (the loop reads it round by round), which the compiler checks when the operator is
// declared: a `for` that answers a value has no reading in a loop.
//
// A range hands out its integers one round at a time instead of building the array `to_array`
// makes: the operator is a generator (design principles 5.4), so the body runs one stretch per
// pull and the integer a round sees is the one the pull before it stopped at.
//
// The loop counts towards the end the range names, and a range whose end is left out counts on:
// that is the one form `a..b` cannot write (an interval always names both ends, design principles
// 4.2), but the type allows it and walking it is what "count on" means.

/// One round of the walk while the count has not reached stop: the integer and the walk from the
/// next one, or null when the range has run out. A stream cannot name itself in the closure that
/// makes it (a closure cannot capture a stream, design principles 5.4), so the round is a function
/// of its own and the stream is the `match` over it -- the shape `unfold` has in stdlib/stream.cml.
func upto_round(i: int, stop: int, stride: int) => (int, int..)? {
    return if (if stride > 0 then i < stop else i > stop) then
        (i, range_upto(i + stride, stop, stride))
    else
        null
}

/// The integers from i on, in steps of stride, while the count has not reached stop: a stop that
/// does not lie past i names no integer at all (design principles 4.2).
func range_upto(i: int, stop: int, stride: int) => int.. {
    return func () {
        match upto_round(i, stop, stride) {
            case null => null
            case pair => pair
        }
    }
}

/// One round of the walk without end: the integer and the walk from the next one.
func from_round(i: int, stride: int) => (int, int..)? {
    return (i, range_from(i + stride, stride))
}

/// The integers from i on, in steps of stride, without end.
func range_from(i: int, stride: int) => int.. {
    return func () {
        match from_round(i, stride) {
            case null => null
            case pair => pair
        }
    }
}

/// The integers r names, one per round: `for i in 0..3` takes the next one each round, so a loop
/// over a range counts instead of walking an array. This is `Range`'s `for` operator, and the
/// compiler reads it for the type of the thing a `for` walks (design principles 4.3, 5.4, 5.7: a
/// named type's operators go with the type, and the group `__iter__` is where `for` lands).
/// @example loop acc = 0 for i in to_range(0, 4, 1) do acc + i    // 6
export func operator for(r: Range) => int.. {
    let first = r.start ?? 0
    return match r.stop {
        case null => range_from(first, r.step)
        case stop => range_upto(first, stop, r.step)
    }
}

/// The last element. An empty array has none: check len first. Negative indices are not
/// counted from the end (a negative index is a fault), so this is how the last element is
/// written.
/// @fails fault `IndexOutOfRange` when the array is empty
/// @example last([1, 2, 3])    // 3
#op(':struct/last_arr')
export func last::<T>(xs: T[]) => T panic

/// The part of x from start up to, not including, end along one axis, taking every step-th
/// position (a step of 1 by default, any non-zero value allowed). x is an array of any rank, a
/// string (by code point) or a `Bytes`; this is the same node the subscript `x[range(a, b, s)]` builds, so
/// a pipeline can write it: `xs->slice<0, 1, 3>`. A bound outside the value (a negative one
/// included) is a fault, as an index out of range is; a start after the end gives the empty
/// value. The last element is `last(x)` and the length of an axis `dim(x, axis)`.
/// @fails fault `IndexOutOfRange` when a bound lies outside the axis; fault `InvalidArgument` when the step is 0
/// @example [1, 2, 3, 4]->slice<0, 1, 3>    // [2, 3]
#op(':op/slice_sub')
with <axis: int, start: int, end: int, step: int = 1>
export func slice::<T>(x: T[]) => T[] panic

/// The same slice of a string, by code point: a string has the one axis 0, and the result is a
/// string. `'中文字'[1..3]` and `'中文字'->slice<0, 1, 3>` are both `'文字'`.
/// @example 'hello'->slice<0, 1, 4>    // 'ell'
#op(':op/slice_str')
with <axis: int, start: int, end: int, step: int = 1>
export func slice(x: string) => string panic

/// The same slice of a `Bytes`, by byte: it has the one axis 0, and the result is a `Bytes`.
/// `b[1..3]` and `b->slice<0, 1, 3>` are the same bytes.
/// @example encode('hello')->slice<0, 1, 4>    // the bytes of 'ell'
/// @example-fragment the example names `encode`, which is `bytes`'s, and a doc example is compiled with this module's names only
#op(':op/slice_bytes')
with <axis: int, start: int, end: int, step: int = 1>
export func slice(x: Bytes) => Bytes panic

/// The elements of xs followed by those of ys, as a new array.
/// @example concat([1], [2, 3])    // [1, 2, 3]
#op(':struct/concat_arr')
export func concat::<T>(xs: T[], ys: T[]) => T[]

/// Whether an element of xs equals value, by the `==` of the element type (by content for
/// arrays, tuples and structs).
/// @example [1, 2, 3]->contains<2>    // true
#op(':struct/contains_arr')
with <value: T>
export func contains::<T>(xs: T[]) => bool

/// Whether sub occurs in the string s (bytes are compared). The empty string occurs in every
/// string.
/// @example 'hello'->contains<'ell'>    // true
#op(':struct/contains_str')
with <sub: string>
export func contains(s: string) => bool

/// Two arrays combined element by element into pairs. They must have the same length.
/// Three or more arrays (`zip(xs, ys, zs)`) give tuples of that many elements.
/// @fails fault `InvalidArgument` when the lengths differ
/// @example zip([1, 2], ['a', 'b'])    // [(1, 'a'), (2, 'b')]
#op(':struct/zip')
export func zip::<...A>(...xs: ...A) => (...ElementOf<A>)[] panic
    when ...is_array::<A>()

/// A new array: the elements of xs, then value. xs is unchanged; to add to a variable, bind it
/// to the result: `acc = acc->append<4>` (as a statement, that form grows the array in place
/// when nothing else refers to it, which cannot be observed).
/// @example [1, 2, 3]->append<4>    // [1, 2, 3, 4]
#op(':struct/append_arr')
with <value: T>
export func append::<T>(xs: T[]) => T[]

// ---- higher-order functions ----
//
// `map` and `filter` apply f to the elements with no order among the calls: the parallel
// scheduler may run them at the same time, and the result is by position. `foreach` and
// `reduce` call f element by element in order. `T[]` is an array of that element type (rank 1); the rank-n meaning is P5
// work. They are declared with effects because what a
// call does is what f does.

/// f applied to every element; the calls have no order among them. One call batches one array,
/// along the one axis that array has, and the result is by position: a function of one value
/// becomes a function of an array of them, and of nothing else. Batching a second array, choosing
/// or naming the axis, and applying the batch where no array is written yet are not this function.
/// @example [1, 2, 3]->map<func (x) { x * 2 }>    // [2, 4, 6]
#op(':mark/map_arr')
with <f: (item: T) => U>
export func map::<T, U>(xs: T[]) => U[]

/// The elements for which f is true, in order; the calls of f have no order among them.
/// @example [1, 2, 3, 4]->filter<func (x) { x % 2 == 0 }>    // [2, 4]
#op(':mark/filter_arr')
with <f: (item: T) => bool>
export func filter::<T>(xs: T[]) => T[]

/// The elements combined from left to right: f(...f(f(initial, xs[0]), xs[1])..., xs[n-1]).
/// @example [1, 2, 3]->reduce<func (acc: int, x: int) { acc + x }, 0>    // 6
#op(':mark/reduce_arr')
with <f: (acc: U, item: T) => U, initial: U>
export func reduce::<U, T>(xs: T[]) => U

/// Calls f for every element, in order.
/// @example [1, 2, 3]->foreach<func (x) { println(x) }>
#op(':mark/foreach_arr')
with <f: (item: T) => void>
export func foreach::<T>(xs: T[]) => void

// ---- fault isolation ----
//
// A fault (a division by zero, an index out of range, a recursion that is too deep, ...) ends
// the program with a located diagnostic. `attempt` isolates it at the boundary of one call
// (design principles 3.9; docs/technical/33_fault_isolation.md). It is a function transform:
// `attempt(f)` is the function whose parameters are f's and whose calls are calls of f made
// inside the boundary. The name is provisional.

/// Raises a fault of the kind the program writes, with the message it gives. The call gives no
/// value at all: its type is the bottom type `never` (design principles 3.9), so it may stand
/// where any type is expected, and a branch arm that raises the fault leaves the branch's type
/// to the other arm. The fault is raised where the call is written, and `attempt` isolates it
/// into an error value whose kind is the name in the angle brackets.
/// @fails fault `<Kind>` with the message, which `attempt` isolates
/// @example fail<'BadLimit'>('the limit must be positive')
#op(':op/fail')
with <Kind: string>
export func fail(message: string) => never panic

/// The function f with the faults of its calls turned into error values: `attempt(f)` takes the
/// parameters of f and gives the result of f plus `!`. A fault raised inside a call becomes an
/// error value whose kind is the name of the fault (`DivisionByZero`, ...), with the fault's
/// message and position; otherwise the call gives the result of f. When f itself returns `U!`,
/// so does `attempt(f)`. What the call did before the fault is not undone; exit() and the
/// failures of the compiler itself are not isolated. `attempt(f)` itself calls nothing: the
/// faults are those of a call of the value.
/// @fails fault `DivisionByZero` and every other fault of a call of f: the call gives an error value whose kind is the fault's name, with the fault's message and position; an error value f itself returns is handed on unchanged
/// @example attempt(func (x: int) { 10 / x })(2) !! -1    // 5
/// @example attempt(func (x: int) { 10 / x })(0) !! -1    // -1: the division fault becomes an error value
#op(':mark/attempt')
export func attempt::<F>(f: F) => F!

// ---- Map<K, V> and Set<T> ---------------------------------------------------------------------
// Built-in collection types (docs/technical/31_map_and_set.md). Every operator returns a new
// value. One calling form: the collection is the ordinary argument, the rest are
// with-arguments, put<k, v>(m) or m->put<k, v>; put(m, k, v) is refused with a hint.

/// The number of entries of a map or of elements of a set. The collection is `x`, the name the
/// string and array declarations above give their one parameter: the position means the value
/// whose length is asked for, whatever its type.
/// @example len([('a', 1), ('b', 2)] as Map<string, int>)    // 2
#op(':coll/len')
export func len::<C>(x: C) => int when is_map::<C>() || is_set::<C>()

/// The value stored under key, or null when the map has no such key. `m[key]` is the same lookup.
/// @example ([('a', 1)] as Map<string, int>)->get<'z'> ?? 0    // 0 when the map has no 'z'
#op(':coll/map_get')
with <key: K>
export func get::<K, V>(m: Map<K, V>) => V?

/// The value stored under key, or fallback when the map has no such key.
/// @example ([('a', 1)] as Map<string, int>)->get_or<'z', -1>    // -1 when the map has no 'z'
#op(':coll/map_get_or')
with <key: K, fallback: V>
export func get_or::<K, V>(m: Map<K, V>) => V

/// A map with value stored under key; an existing entry of that key is replaced. m is unchanged.
/// @example ([('a', 1), ('b', 2)] as Map<string, int>)->put<'c', 3>    // {a: 1, b: 2, c: 3}
#op(':coll/map_put')
with <key: K, value: V>
export func put::<K, V>(m: Map<K, V>) => Map<K, V>

/// A map without the entry of key, or a set without the element; a key or element that is not there changes nothing. The argument is unchanged.
/// @example ([('a', 1), ('b', 2)] as Map<string, int>)->remove<'a'>    // {b: 2}
#op(':coll/remove')
with <key: K>
export func remove::<K, V>(c: Map<K, V>) => Map<K, V>
#op(':coll/remove')
with <key: K>
export func remove::<K>(c: Set<K>) => Set<K>

/// Whether a map has an entry of key. (A set is asked with `contains`.)
/// @example ([('a', 1)] as Map<string, int>)->has<'a'>    // true
#op(':coll/has')
with <key: K>
export func has::<K, V>(c: Map<K, V>) => bool

/// The keys of a map, in ascending order.
/// @example keys([('b', 2), ('a', 1)] as Map<string, int>)    // [a, b]
#op(':coll/keys')
export func keys::<K, V>(m: Map<K, V>) => K[]

/// The values of a map, in the ascending order of their keys.
/// @example values([('b', 2), ('a', 1)] as Map<string, int>)    // [1, 2]
#op(':coll/map_values')
export func values::<K, V>(m: Map<K, V>) => V[]

/// The entries of a map as (key, value) tuples, in ascending order of the keys.
/// @example items([('b', 2), ('a', 1)] as Map<string, int>)    // [(a, 1), (b, 2)]
#op(':coll/map_items')
export func items::<K, V>(m: Map<K, V>) => (K, V)[]

/// The elements of a set as an array, in ascending order. The collection is `m`, the name the
/// map declaration above gives its one parameter: the position means the collection whose items
/// are listed.
/// @example items([3, 1, 2] as Set<int>)    // [1, 2, 3]
#op(':coll/set_items')
export func items::<T>(m: Set<T>) => T[]

/// A map with the entries of both maps; for a key in both, the entry of other is taken. Neither argument is changed.
/// @example merge([('a', 1), ('b', 2)] as Map<string, int>, [('b', 20), ('c', 30)] as Map<string, int>)    // {a: 1, b: 20, c: 30}
#op(':coll/merge')
export func merge::<K, V>(m: Map<K, V>, other: Map<K, V>) => Map<K, V>

/// Whether value is an element of the set.
/// @example ([1, 2, 3] as Set<int>)->contains<9>    // false
#op(':coll/set_contains')
with <value: T>
export func contains::<T>(s: Set<T>) => bool

/// A set with value added; s is unchanged.
/// @example ([1, 2, 3] as Set<int>)->add<9>    // {1, 2, 3, 9}
#op(':coll/set_add')
with <value: T>
export func add::<T>(s: Set<T>) => Set<T>

/// The set of the elements that are in either set.
/// @example union([1, 2, 3] as Set<int>, [3, 4] as Set<int>)    // {1, 2, 3, 4}
#op(':coll/set_union')
export func union::<T>(s: Set<T>, other: Set<T>) => Set<T>

/// The set of the elements that are in both sets.
/// @example intersect([1, 2, 3] as Set<int>, [3, 4] as Set<int>)    // {3}
#op(':coll/set_intersect')
export func intersect::<T>(s: Set<T>, other: Set<T>) => Set<T>

/// The set of the elements of s that are not in other.
/// @example difference([1, 2, 3] as Set<int>, [3, 4] as Set<int>)    // {1, 2}
#op(':coll/set_difference')
export func difference::<T>(s: Set<T>, other: Set<T>) => Set<T>

/// Whether every element of s is an element of other.
/// @example is_subset([1, 2] as Set<int>, [1, 2, 3] as Set<int>)    // true
#op(':coll/set_is_subset')
export func is_subset::<T>(s: Set<T>, other: Set<T>) => bool

// ---- streams ----

/// Records one `tee` (design principles 5.4) for the report of a profile session: the hint it
/// took, the widest hint the implementation honours, the elements it has pulled from its source so
/// far, and the most elements it has buffered at once -- with the stream it reads, whose value
/// tells one tee from another and whose type the operator takes, and whose elements it does not.
/// A program does not write this: `tee` calls it once per element it pulls, and `std::profile`
/// prints what it recorded (`STREAM_TEE`).
/// @example tee_note(8, 64, 2, 2, s)    // the tee written `s->tee<8>` reports itself this way
/// @example-fragment the last operand is the stream a tee reads, and no example program has one
#op(':stream/tee_note')
export func tee_note::<T>(
    hint: int,
    cap: int,
    elements: int,
    peak: int,
    s: T..
) => void
