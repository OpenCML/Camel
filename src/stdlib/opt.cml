/**
 * The optimization passes of the standard library written in Camel: `opt::fold`, `opt::cse`, `opt::inline`,
 * `opt::dce`, `opt::algebra` and `opt::saturate`. A pass is a function from a function to a function of the same type,
 * `(f: F) => F!`, so it applies to one function, `loss->opt::fold->opt::cse`, and the pipeline
 * names it by its module: `camel prog.cml opt::fold std::nvm`. They are the meaning of the C++
 * passes of the same names, `std::cxx::fold`, `std::cxx::cse`, `std::cxx::inline` and `std::cxx::dce` (the names those
 * passes had before they were separated from this module, `std::opt::fold` and the rest, are gone
 * with the separation: they are not aliases, and a pipeline that writes one is refused), which run
 * by default; neither set is deleted before the two have been compared
 * (docs/roadmap.cn.md section 0, P; design principles 10.4). That comparison is a run, not a
 * reading: the same program is folded, or swept for repeated expressions, by each implementation,
 * `std::jgir canonical=true` reads both graphs, and the two documents have to be equal byte for
 * byte (test/plans/feat/opt/cxx_isolation.plan.toml).
 *
 * A pass is a transaction over the function the `graph` module hands out: read a node, `replace`
 * it by another, `erase` one nobody reads, evaluate an operator over constants with `eval`,
 * `commit`, and read the next round from the function that comes back.
 *
 *     func shrink::<F>(f: F): F! {
 *         return f->fold -> cse
 *     }
 *
 * The arithmetic is `eval`'s and follows the C++ pass: an integer operation is exact and a float
 * operation is the double one, computed the way the operator's kernel computes it, once per
 * folding. No other number is computed here.
 */

import { flatten, all, any, drop, flat_map, unique } from array
import { Node, Graph, Draft, NodeKind, Region, RegionKind, graphs_of, graphs, nodes, inputs, with_inputs, value_users, kind, op, op_name, callee, callee_is_self, may_be_recomputed, may_fault, may_be_rearranged, is_anchor, is_written_slot, is_constant, constant_bytes, type_of, type_name, region_of, region_kind, region_parent, permissions, tags, constant, open, replace, erase, eval, commit, abort, inline_call } from graph
import { saturate as saturate_rules } from rewrite
import { algebra as algebra_laws, distribution, simplify } from rules
import { is_function } from types

// ---- reading a node as the key of a comparison ----

func op_text(n: Node) => string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func type_text(n: Node) => string {
    return match type_of(n) {
        case null => ''
        case t => type_name(t)
    }
}

func all_nodes(gs: Graph[]) => Node[] {
    return flatten(gs->map<nodes>)
}

// ---- common subexpressions ----

// Whether the two nodes hold the same value of the type T.
func same_value::<T>(a: Node, b: Node) => bool {
    let x = constant::<T>(a)
    let y = constant::<T>(b)
    return if x != null && y != null then x == y else false
}

// Whether the two nodes are constants of one type and one value. Only the types whose `==` in
// Camel is the equality of the graph's values are compared: a float is left out on purpose, for
// Camel cannot read the bits of a scalar, so `0.0 == -0.0` holds while the two constants are
// different values of the graph, and merging them would change the program.
func same_constant(a: Node, b: Node) => bool {
    return match type_text(a) {
        case 'int' => same_value::<int>(a, b)
        case 'i32' => same_value::<i32>(a, b)
        case 'bool' => same_value::<bool>(a, b)
        case _ => false
    }
}

// A constant the sweep may merge: a static value that no node may write in place.
func mergeable_constant(n: Node) => bool {
    return kind(n) == NodeKind::Data && is_constant(n) && !is_written_slot(n)
}

// Whether the two lists name the same nodes in the same order.
func same_nodes(xs: Node[], ys: Node[]) => bool {
    return len(xs) == len(ys) && zip(xs, ys)->all<func (p: (Node, Node)) => bool {
        p.0 == p.1
    }>
}

// A pure operation the sweep may merge: one a pass may arrange anywhere (`may_be_rearranged`:
// pure *and* unable to fault). The merge pulls the computation back to its first writing, so a
// node that may fault stays where the program wrote it -- what it does when it fails is
// observable, and moving it ahead of an effect would show the failure sooner. Reading no value
// that may be written in place, and not one itself: an operation over such a value is not one
// value, the two times it is written are two results. A pure operator that must run where the
// program writes it (a rule's value, a `fact`) is not merged either: running it is the
// declaration itself.
func mergeable_operation(n: Node) => bool {
    return kind(n) == NodeKind::Oper && may_be_rearranged(n) && op_text(n) != '' && !is_written_slot(n) && !inputs(n)->any<is_written_slot> && !with_inputs(n)->any<is_written_slot>
}

// The control region a node lies in: the innermost region the node is in that decides *when* it
// runs -- an arm of a branch, a loop's condition, a loop's body -- or the body itself (region 0)
// when the node lies in none of them. It is the key the C++ sweep compares (`armRegions`,
// std/cxx/opt/generic/generic.cpp: the walk up the parents keeps `Arm`, `LoopCond` and
// `LoopBody` and nothing else).
//
// A region an `inline` made is **not** a control region: the inlined body runs where the call it
// replaced was, not at a moment of its own, and the same holds of a `Block` region and of a
// region the sweep itself left `Dead`. Asking for the innermost region instead makes an inlined
// node answer with the region `inline` made and the call site's own node answer with the body --
// two answers for one moment of the run -- and the sweep then never merges an inlined expression
// with the one it duplicates, which is what the four-node gap between `opt::cse` and
// `std::cxx::cse` after `std::cxx::inline` was.
func control_region_of(r: Region) => Region {
    return if is_control_region(r) then r else match region_parent(r) {
        case null => r
        case p => control_region_of(p)
    }
}

func is_control_region(r: Region) => bool {
    let k = region_kind(r)
    return k == RegionKind::Arm || k == RegionKind::LoopCond || k == RegionKind::LoopBody
}

func control_region(n: Node) => Region {
    return control_region_of(region_of(n))
}

// Whether the two operations are the same computation: the same operator on values of the same
// type, the same operands in the same order, in the same control region, with the same permissions
// and the same attributes.
func same_operation(a: Node, b: Node) => bool {
    return op_text(a) == op_text(b) && type_text(a) == type_text(b) && permissions(a) == permissions(b) && tags(a) == tags(b) && control_region(a) == control_region(b) && same_nodes(inputs(a), inputs(b)) && same_nodes(with_inputs(a), with_inputs(b))
}

// Whether one node may stand for the other in a graph: as a constant of the same value, or as
// the same operation. Two constants are one value only in one control region, because a value
// written in the body and one written in an arm are two writings of the same number, not one node
// of the graph; the C++ sweep keys them by the same walk (`armRegions`) it keys operations by.
func same_node(a: Node, b: Node) => bool {
    return (mergeable_constant(a) && mergeable_constant(b) && control_region(a) == control_region(b) && same_constant(a, b)) || (mergeable_operation(a) && mergeable_operation(b) && same_operation(a, b))
}

// The node `n` is replaced by: the first node of its graph that has the same value, or `n`
// itself when it is the first. "First" is the order `nodes` answers in the draft: a node's `id`
// exists only once the commit publishes the program. That first node is never a node the same
// round merges away, which is what makes one transaction enough for a round.
func keep_of(ns: Node[], n: Node) => Node {
    let same = ns->filter<func (m: Node) => bool {
        m == n || (!is_anchor(m) && same_node(n, m))
    }>
    return same[0]
}

func is_hit(ns: Node[], n: Node) => bool {
    // A node that anchors its graph is not merged away: the transaction does not replace or erase
    // it, and a round that tried would stop on the refusal instead of merging the rest.
    return !is_anchor(n) && keep_of(ns, n) != n
}

func graph_has_hit(g: Graph) => bool {
    let ns = nodes(g)
    return ns->any<func (n: Node) => bool {
        is_hit(ns, n)
    }>
}

// Every node a round merges is paired with the node it keeps before any edit: an edit acts on the
// draft at once, so a node replaced earlier in the round is a handle that names nothing, and
// comparing a later node against it would ask a question of a node that is gone.
func merge_hits_of(g: Graph) => void {
    let ns = nodes(g)
    let hits = ns->filter<func (n: Node) => bool {
        is_hit(ns, n)
    }>
    let keeps = hits->map<func (n: Node) => Node {
        keep_of(ns, n)
    }>
    zip(hits, keeps)->foreach<func ((n, k)) => void {
        replace(n, k)
    }>
}

func merge_hits::<F>(f: F) => F! sync {
    let d = open(f)
    graphs(d)->foreach<func (g: Graph) => void {
        merge_hits_of(g)
    }>
    return commit(d)
}

/// Equal values written twice are one node, until none is left.
/// @example (func (x: int) { x * 2 + x * 2 })->cse
export func cse::<F>(f: F) => F! when is_function::<F>() {
    return if graphs_of(f)->any<graph_has_hit> then merge_hits(f)->cse else f
}

// ---- dead values ----

// Whether the node computes a value: a constant, an access, a fill, or an operation a pass may
// arrange anywhere (`may_be_rearranged`: pure *and* unable to fault). A conversion and a copy are
// operations now (`:op/cast`, `:op/copy`), so they answer in the `NodeKind::Oper` arm. This is
// `isValueOnly` of the C++, which asks the same entry. The kinds that compute no value (a port, a
// call, a loop, a gate) answer no: a port is a frame's edge, not a value written in the graph.
func value_only(n: Node) => bool {
    let k = kind(n)
    return ((k == NodeKind::Accs || k == NodeKind::Fill || k == NodeKind::Oper) && may_be_rearranged(n)) || (k == NodeKind::Data && is_constant(n))
}

// Whether the node reads a computation that may fault, and is the only node that reads it. Removing
// such a node takes that computation's last use away, which is the one thing design principles 3.3
// forbids: a removal that takes the last use of a node whose running is observed hands that use to a
// `GATE` (data port reading the value that was there, sync predecessor that node). The C++ sweep
// does exactly that (`keepThroughValue`, lib/std/cxx/opt/generic/rewrite.cpp); a transaction can write
// no node of the graph's own, so this sweep does not stand a keeper in the statement's place -- it
// keeps the reader instead, and the computation keeps the read that says it runs.
func last_read_of_a_fault(n: Node) => bool {
    return inputs(n)->any<func (m: Node) => bool {
        may_fault(m) && len(value_users(m)) <= 1
    }> || with_inputs(n)->any<func (m: Node) => bool {
        may_fault(m) && len(value_users(m)) <= 1
    }>
}

// Whether the node computes a value no node reads. A node that anchors its graph is not one: a
// transaction refuses to erase it, and the graph would lose its exit.
//
// A node that is the last reader of a computation that may fault is not one either
// (`last_read_of_a_fault`). Dropping it would leave that computation with no read of its value and,
// where the program gives it no place in a chain, the commit refuses the graph as `GraphInvalid`
// (docs/technical/45_graph_module.md, the gap table) -- the same rule not kept, loudly instead of
// silently. Keeping the reader keeps the fault in the program, which is what 3.3 asks.
func dead_value(n: Node) => bool {
    return value_only(n) && len(value_users(n)) == 0 && !is_anchor(n) && !last_read_of_a_fault(n)
}

// An edit acts on the draft its node belongs to, so the hits are erased in the draft they were
// found in, and that draft is the one committed.
func erased::<F>(d: Draft<F>, hits: Node[]) => F! sync {
    hits->foreach<func (n: Node) => void {
        erase(n)
    }>
    return commit(d)
}

func dead_values::<F>(f: F) => F! when is_function::<F>() sync {
    let d = open(f)
    let hits = all_nodes(graphs(d))->filter<dead_value>
    return if len(hits) == 0 then abandoned(d, f) else erased::<F>(d, hits)->dead_values
}

/// Values nobody reads are erased, until none is left: the value half of `std::cxx::dce`.
/// @example (func (x: int) { x + 1 })->dce
export func dce::<F>(f: F) => F! when is_function::<F>() {
    return dead_values(f)
}

// ---- constant folding ----

// Whether the node is one this pass may put a value in the place of: not one that anchors its
// graph, and not one whose value may be written in place. In a function graph the returned value
// is also the graph's exit and output value, and `replace` refuses a node that anchors its graph,
// so a returned constant expression is left as written. A value that may be written in place is
// left too: a constant replacing it would share one object between every run of the graph.
func foldable(n: Node) => bool {
    return !is_anchor(n) && !is_written_slot(n)
}

// Whether the node is an operation this pass evaluates: one whose operator a pass may compute
// itself (`may_be_recomputed`: pure and foldable, the C++ pass's `isPureOper`), so folding it
// cannot move a computation that must run where it is written. The conversions, copies, accesses
// and fills are not evaluated here, and neither is an operation that may fault without its value
// being read: `eval` refuses the node it cannot compute, and a faulting expression is left as
// written (below).
func is_operation(n: Node) => bool {
    return kind(n) == NodeKind::Oper && may_be_recomputed(n)
}

// Whether every value the node reads is a constant of the graph: what its operator is computed
// over. An operation that reads nothing is not one: `eval` has nothing to compute it from. A
// constant that may be written in place is not one either, the way `foldable` refuses the node
// itself: the C++ pass leaves a folding that reads such a value alone (`readsNoWrittenSlot`),
// because a constant replacing it would share one object between every run of the graph.
func constant_operands(n: Node) => bool {
    let ins = inputs(n)
    return len(ins) > 0 && ins->all<func (m: Node) => bool {
        is_constant(m) && !is_written_slot(m)
    }>
}

// Whether the round evaluates this node: a pure operation whose operands are all constants. A
// node the round may not replace is evaluated all the same, because `eval` is what warns about a
// constant expression that can only fault: the C++ fold evaluates such a node "to tell the user
// of a constant that faults where it is written" (`generic.cpp`) and leaves it where it is.
func evaluated(n: Node) => bool {
    return is_operation(n) && constant_operands(n)
}

// Replaces one operation by the value its operator computes; the answer is whether it did. The
// arm of a `match` is a graph of its own, so the edit is a call of its own: a statement inside an
// arm has nothing that depends on it and does not run.
func put_value(n: Node, value: Node, budget: int) => bool sync {
    return if foldable(n) && constant_bytes(value) < budget then replaced(n, value) else false
}

func replaced(n: Node, value: Node) => bool sync {
    replace(n, value)
    return true
}

// The value the round computes for this node, or null when there is nothing to compute or when
// the expression can only fault, which is left as written and warned about.
func fold_one(n: Node, budget: int) => bool sync {
    return match eval(n) {
        case null => false
        case v => put_value(n, v, budget)
    }
}

// One round over the nodes it evaluates: whether it replaced anything.
func fold_round(hits: Node[], budget: int) => bool {
    return hits->map<func (n: Node) => bool {
        fold_one(n, budget)
    }>->any<func (did: bool) => bool {
        did
    }>
}

// Commits a round that replaced something, and abandons one that replaced nothing: the program the
// round started from is then the answer. Each is a function of its own because an effect written
// inside an arm of a `match` or an `if` does not run, so one branch cannot commit inline while the
// other abandons.
func committed::<F>(d: Draft<F>) => F! sync {
    return commit(d)
}

func abandoned::<F>(d: Graph, f: F) => F! sync {
    abort(d)
    return f
}

// Folds round after round until a round replaces nothing, which is the end. A round whose nodes
// `eval` all refused (a constant expression that can only fault is left as written and warned
// about) is such a round, and recursing on the function it started from would not stop, so it is
// abandoned.
func fold_rounds::<F>(f: F, budget: int) => F! when is_function::<F>() sync {
    let d = open(f)
    let changed = fold_round(all_nodes(graphs(d))->filter<evaluated>, budget)
    return if changed then committed(d)->fold_rounds(budget) else abandoned(d, f)
}

/// A pure operation whose operands are all constants is the value they compute, until none is
/// left. A function that holds no node to evaluate at all is answered without opening a draft.
/// @example (func (x: int) { 1 + 2 + x })->fold
with </// Bytes of constants this pass may materialize in a graph: the same measure and the same
/// default as `std::cxx::fold` (`constantBytesOf`), read through `constant_bytes`; a value
/// above it is left as the computation that builds it, and 0 materializes none.
constant_budget: int = 8388608>
export func fold::<F>(f: F) => F! when is_function::<F>() {
    return if all_nodes(graphs_of(f))->any<evaluated> then fold_rounds(f, constant_budget) else f
}

// ---- algebraic simplification ----

/// The algebraic laws of the rules library, one way, to a fixpoint: `x + 0` is `x`, like terms
/// merge (`a*x + b*x` is `(a+b)*x`), constant factors gather. It is `rules::simplify`, the same pass
/// `std::cxx::algebra` runs, so a law is written once, in `rules.cml`. With `strict` only the laws
/// that need no numeric permission are used, as `safe_fp=true` does for `std::cxx::algebra`.
/// @fails error value `RuleInvalid` when a rule does not compile
/// @example (func (x: int) { x * 3 + x * 4 })->algebra
with <strict: bool = false>
export func algebra::<F>(f: F) => F! when is_function::<F>() {
    return f->simplify<strict: strict>
}

// ---- saturation ----

/// The rules library's laws, rearranging ones included, applied both ways to the writings of every
/// value for at most `rounds` rounds; nothing is extracted, so the function keeps every writing the
/// saturation found (`f->extract<nodes>` of `rules` chooses among them). With `strict` only the
/// laws that need no permission are used, as `safe_fp=true` does for `std::opt`.
/// @example (func (x: int) { x * 3 + x * 4 })->saturate
with <rounds: int = 6, strict: bool = false>
export func saturate::<F>(f: F) => F! when is_function::<F>() {
    return f->saturate_rules<concat(algebra_laws, distribution), rounds: rounds, strict: strict>
}

// ---- inlining ----

// The selection rules of `std::cxx::inline`, as far as the graph module's reads reach them
// (InlineRewriteConfig, src/stdlib/std/cxx/opt/include/camel/passes/opt/config.h). The C++ engine
// reads four things this module has no read for, and this pass does without them:
//
//   unaligned 1. the call graph's components: which functions recurse. Whether the callee recurses is
//               read (`recurses`, a walk of the callees), and such a call is left as it is; the C++
//               engine also reads *where* the cycle is and inlines inside one, which this pass does
//               not do -- both sides of a recursive pair keep their call to the other;
//   unaligned 2. whether a call is the head of a branch arm (`isDraftBranchArmHead`);
//   unaligned 3. the inline history: whether a call lies in a copy inlined from its own callee;
//   unaligned 4. how many direct calls each graph has, which the duplication budget is about.
//
// So the rules below are the ones that can be read: a callee is small, the copy fits the caller and
// what is left of the budget, and a call of the graph being edited is left alone (`callee_is_self`;
// `inline_call` refuses it). Where the C++ engine would also inline a non-small callee called once,
// or a callee that returns a closure, this pass keeps the call. The program means the same; it is
// only less inlined, and the difference is listed here rather than approximated.

// What a copy of `g` carries into its caller: every node but the constants and the parameters,
// which the caller already has. This is what one expansion costs the growth budget (the C++ engine's
// `inlinedNodeCount`).
func copy_cost(g: Graph) => int {
    return len(nodes(g)->filter<func (n: Node) => bool {
        let k = kind(n)
        return k != NodeKind::Data && k != NodeKind::Port
    }>)
}

// How small a callee is: its operators, its calls and its structural nodes (the C++ engine's
// `inlinedComputeNodeCount`). The C++ counts the nodes of one `??` lowering once; here every node
// counts for itself.
func compute_size(g: Graph) => int {
    return len(nodes(g)->filter<func (n: Node) => bool {
        let k = kind(n)
        return k == NodeKind::Oper || k == NodeKind::Call || k == NodeKind::Func || k == NodeKind::Brch || k == NodeKind::Join || k == NodeKind::Loop
    }>)
}

func cost_of_call(n: Node) => int {
    return match callee(n) {
        case null => 0
        case c => copy_cost(c)
    }
}

// The graphs the calls of `g` name, each once: the call graph's edges out of one graph.
func callees_of(g: Graph) => Graph[] {
    return nodes(g)
        ->flat_map<func (n: Node) => Graph[] {
            return match callee(n) {
                case null => []
                case c => [c]
            }
        }>
        ->unique
}

// Whether `target` is reached from `g` by the graphs its calls name. `seen` holds the graphs already
// walked, so a cycle in the call graph ends the walk instead of going round it.
func reaches(g: Graph, target: Graph, seen: Graph[]) => bool {
    return if g == target then true else if seen->any<func (s: Graph) => bool { s == g }> then false else callees_of(g)->any<func (c: Graph) => bool { reaches(c, target, concat(seen, [g])) }>
}

// Whether the graph `g` reaches itself: whether its function recurses, directly or through other
// functions. This is the C++ engine's first rule (`InlineRewriteConfig`, "which functions recurse"):
// a call whose callee recurses is left as it is. Without it the pass would expand `down` into `main`,
// the copy would bring `down(n - 1)` into `main`, and that call would be expandable again -- the
// caller would grow to the whole growth budget.
func recurses(g: Graph) => bool {
    return callees_of(g)->any<func (c: Graph) => bool { reaches(c, g, [g]) }>
}

// Whether the pass expands this call: its callee is a graph of its own (`callee_is_self` is false:
// a recursive call names the graph being edited, and `inline_call` would refuse it), that graph does
// not recurse (`recurses`: the C++ engine declines the callers of a recursive function, not only the
// call inside it), it is small (`smallSubgraphMaxComputeNodes`, 8), and the copy fits the caller's
// cap (`maxOwnerNodes`, 4096) and what is left of the budget.
func expandable(g: Graph, n: Node, remaining: int) => bool {
    return match callee(n) {
        case null => false
        case c => !callee_is_self(n) && !recurses(c) && compute_size(c) <= 8 && copy_cost(c) <= remaining && len(nodes(g)) + copy_cost(c) <= 4096
    }
}

func calls_of(g: Graph) => Node[] {
    return nodes(g)->filter<func (n: Node) => bool {
        callee(n) != null
    }>
}

func do_expand(g: Graph, n: Node, rest: Node[], remaining: int) => int sync {
    let cost = cost_of_call(n)
    let _ = inline_call(n)
    return expand_calls(g, rest, remaining - cost)
}

func expand_one(g: Graph, n: Node, rest: Node[], remaining: int) => int sync {
    return if expandable(g, n, remaining) then do_expand(g, n, rest, remaining) else expand_calls(g, rest, remaining)
}

// One graph's round: each call the rules select is expanded, paying for its copy out of `remaining`;
// the answer is what is left. A call whose copy does not fit is left as written, and the calls after
// it may still be expanded: the pool is spent call by call, as the C++ engine spends one
// `growthSpent` across its round, not one pool for each call.
func expand_calls(g: Graph, calls: Node[], remaining: int) => int sync {
    return if len(calls) == 0 then remaining else expand_one(g, calls[0], drop<1>(calls), remaining)
}

func expand_graph(g: Graph, rest: Graph[], remaining: int) => int sync {
    return expand_graphs(rest, expand_calls(g, calls_of(g), remaining))
}

func expand_graphs(gs: Graph[], remaining: int) => int sync {
    return if len(gs) == 0 then remaining else expand_graph(gs[0], drop<1>(gs), remaining)
}

// Commits a round that expanded something, and abandons one that expanded nothing: the program the
// round started from is then the answer.
func inline_rounds::<F>(f: F, remaining: int) => F! when is_function::<F>() sync {
    let d = open(f)
    let left = expand_graphs(graphs(d), remaining)
    return if left < remaining then committed(d)->inline_rounds(left) else abandoned(d, f)
}

/// Calls are expanded at their call sites (`inline_call`), round after round, until a round expands
/// nothing: the body stands where the call stood, its parameters bound to the call's arguments and
/// its captures carried in by the function value. The selection rules are `std::cxx::inline`'s as far
/// as this module can read them (see the four unaligned items above).
/// @fails fault `InvalidArgument` when a selected call is one `inline_call` refuses
/// @example (func (x: int) { x + 1 })->inline
with </// Nodes a run may copy: one pool for the whole run, each expansion paying for the nodes its copy
/// carries (`copy_cost`) -- the way `std::cxx::inline` spends one `growthSpent` (its default 4096);
/// 0 expands nothing at all.
growth_budget: int = 4096>
export func inline::<F>(f: F) => F! when is_function::<F>() {
    return inline_rounds(f, growth_budget)
}


