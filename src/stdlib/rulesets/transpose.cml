/**
 * The `transpose` ruleset: the transpose (the pullback) of a linear primitive, written where the
 * primitive is (design principles 9.9, program transforms).
 *
 * A transpose rule's right side is "the cotangent of the result => the cotangent of the operand that
 * carries the data", and it is linear in that cotangent: `x + c` passes it through, `x * c` scales
 * it by `c`, and `-x` negates it. The value the primitive was given is a value here, not a constant
 * of the rule, so `mul_t` is also the transpose of `x * 3`.
 *
 * A left side that names two values answers two cotangents, in the order it names them: the right
 * side's value is a tuple of two, and the transform that answers the second name takes the second
 * component. The two answers share nothing -- `x - c` negates one and passes the other through, and
 * `x / c` divides by `c` in one and needs both values in the other -- so each is written once,
 * where its own law is.
 *
 * A rule belongs to the family of the module it is declared in, and to a primitive by the operator
 * of its left side and the number of operands that operator was given. The forward rules of the
 * same primitives are in `rulesets.jvp`: the two left sides are the same text, and a module holds
 * one rule per operator and parameter-type list, so the two families live in two modules -- a module
 * does not serve two families, just as it does not serve both a library and a ruleset.
 *
 * Adding a rule changes docs/stdlib-reference.md; regenerate it with
 * `node scripts/stdlib-reference.mjs --write`.
 */

import {
    add_cotangent,
    add_cotangent_c,
    div_cotangent,
    div_cotangent_c,
    mul_cotangent,
    mul_cotangent_c,
    neg_cotangent,
    stop_gradient,
    sub_cotangent,
    sub_cotangent_c
} from laws
// `log as math_log`, for the reason `rulesets.jvp` records: the plain `log` here is the **array**
// one (`log_t` files its law below), and a second import of one name hides the first instead of
// overloading it, so `pow_d_t`'s scalar `log(x)` is spelled `math_log`.
import { erfc as math_erfc, erf as math_erf, exp as math_exp, log as math_log, pow, sqrt as math_sqrt } from math
// The `nn` module's primitives and the gradients they answer with: this module's left sides spell
// the operators (`conv2d(x, w, b)`) and its right sides are the engine's own gradient operators, so
// both halves of each law name `nn`'s declarations and nothing else. The direction is the one
// design principles 10.1 allows between modules (only a *type* cycle is diagnosed; the one-way
// layering the build enforces is the C++ kernel's, 10.5) and `rulesets.jvp` records the same
// import from the forward side.
import { avg_pool2d, avg_pool2d_grad, conv2d, conv2d_bias_grad, conv2d_bias_grad_shaped, conv2d_input_grad, conv2d_input_grad_shaped, conv2d_kernel_grad, conv2d_kernel_grad_shaped, embedding, embedding_table_grad, max_pool2d, max_pool2d_grad, softmax_cross_entropy, softmax_cross_entropy_grad } from nn
import { abs, add_stated, broadcast_like, div_stated, erf, erfc, exp, full, gelu, layer_norm, layer_norm_grad, linear, log, log_softmax, matmul, matmul_stated, max, max_axis_stated, maximum, mean, mean_axis_stated, mean_stated, min, min_axis_stated, minimum, mul_stated, numel, permute, pick_at, relu, reshape, rsqrt, shape, sigmoid, softmax, softmax_grad, sqrt, subtract, subtract_stated, sum, sum_axis_stated, sum_stated, sum_to, take, take_stated, tanh, transpose, where, zeros, zeros_like } from tensor
import { is_float } from types

/// The transpose of `x + c`: the cotangent of the sum, of `x` and of `c`.
export rule add_t::<T>(x: T, c: T) when is_float::<T>() { x + c => func (ct: T) {
    (add_cotangent(ct), add_cotangent_c(ct))
} }

/// The transpose of `x - c`: `ct` for `x`, `-ct` for `c`.
export rule sub_t::<T>(x: T, c: T) when is_float::<T>() { x - c => func (ct: T) {
    (sub_cotangent(ct), sub_cotangent_c(ct))
} }

/// The transpose of `x * c`: `ct * c` for `x`, `ct * x` for `c`.
export rule mul_t::<T>(x: T, c: T) when is_float::<T>() { x * c => func (ct: T) {
    (mul_cotangent(c, ct), mul_cotangent_c(x, ct))
} }

/// The transpose of `x / c`: `ct / c` for `x`, `-ct * x / (c * c)` for `c`.
export rule div_t::<T>(x: T, c: T) when is_float::<T>() { x / c => func (ct: T) {
    (div_cotangent(c, ct), div_cotangent_c(x, c, ct))
} }

/// The transpose of `-x`: `-ct`.
export rule neg_t::<T>(x: T) when is_float::<T>() { -x => func (ct: T) {
    neg_cotangent(ct)
} }


/// The transpose of `float(x)` where `x` is a float: a conversion between float widths is linear,
/// so its transpose is the same conversion read backwards -- the cotangent of the result carried
/// into the width of `x`. One law for every float width, the way `jvp_float_from_float`
/// (`lib/rulesets/jvp.cml`) is one law for every float width. `float`'s own case is the cotangent
/// itself, because `:op/dtod` converts a value to the width it already has and the pullback the core
/// writes for it is the identity (`lib/std/builtin/operators/derivative.cpp`:
/// `registry.setRule(":op/dtod", identityVjp)`).
///
/// It was written for `float` alone (`dtod_t::<T>(x: T) when is_same::<T, float>()`), and a program
/// that converts an `f32` to a double -- `float(sum(err * err))`, the loss in every
/// `examples/case-study` program -- then met this family at `:op/ftod` and was refused:
///
///     the rule the index filed for `:op/ftod` was written for another shape: the rule takes
///     (float), and the operator has (f32)
///
/// The index files a rule under the head of its left side and that head's operand count and reads
/// no operand types (`lib/transforms/transpose_operator.cpp`), so a law written for one width
/// is the law every width of `float(...)` is given, and a width it does not spell is refused by
/// shape rather than served by a second law: a module holds one rule per operator and
/// parameter-type list. Widening the law is therefore the repair; a second `float(x)` rule beside
/// this one is refused where it is written.
///
/// Two type parameters, in the order the expansion names a law's ports -- the cotangent's element
/// first, then the operands (`lib/transforms/transpose/rules.cpp#chooseTransposedRule`) -- because the cotangent of
/// `float(x)` is a `float` whatever width `x` has, and one type parameter cannot be both. `T` is
/// that cotangent and `S` the width of the operand, so the guard names both ports and not one of
/// them: a rule's `when` says which shapes it serves, and a law filed under `float(x)` without a
/// word about the operand's width would be handed a `float(n)` over an `int` and would have to
/// invent a width for a value that has no tangent (`jvp_float_from_int` is the forward half's
/// reading of that case).
///
/// The conversion back is a `match type` on `S` inside the body and not a helper call with `S` in
/// its angle brackets: a generic call whose type argument is a rule's type parameter arrives at the
/// width as a **name used as a value** (`'f32' is used as a value here, but it names an operator
/// with 8 signatures`), and the match is the
/// spelling `zero_tangent` already uses in `lib/rulesets/jvp.cml`.
export rule dtod_t::<T, S>(x: S) when is_float::<S>() && is_float::<T>() { float(x) => func (ct: T) {
    return match type S {
        case float => ct
        case f32 => f32(ct)
        case f16 => f16(ct)
        case bf16 => bf16(ct)
    }
} }

// ---- the transpose rule of `stop_gradient` ----
//
// The engine answers `stop_gradient` with `camel::core::noGradient` (`lib/autodiff/operators.cpp`
// registers it) -- a rule that contributes nothing -- and the pullback then materializes the missing
// contribution as the zero of the value's own type
// (`lib/autodiff/pullback.cpp#Backward::checkGradientType`). The library's half is the same
// answer written as a value: the cotangent of the argument is the zero of its own type, so nothing
// flows back and the result's cotangent is not read at all.
//
// Like the forward half (`jvp_stop_gradient`), the zero is the zero of the rule's own type parameter
// and no operand is read: `stop_gradient::<T>(x: T): T` declares one value and one result of one type,
// and a scalar needs no shape to be zeroed. An array argument would need its extents, which are the
// operand's value or `:op/extent_of` from the type -- the second of which this tree does not have -- so an
// array is refused by name rather than answered with a zero of the wrong shape.

/// The transpose of `stop_gradient(x)`: nothing flows back, so the cotangent of `x` is the zero of its
/// own type.
export rule stop_gradient_t::<T>(x: T) when is_float::<T>() { stop_gradient(x) => func (ct: T) {
    T(0.0)
} }


// ---- the transpose rule of the array product ----
//
// `x * w` on two arrays is `tensor:multiply`, the operator whose key cannot be derived from its
// name -- `*/2` is `:op/mul_d`'s key, and one key holds one rule -- so the core names it in
// `ruleKeyExceptions()` and the family files the key as the call `mul_tensor(x, w)`, declared here
// the way `rulesets.jvp` declares its own: a module cannot read another module's private function.
//
// It is the adjoint of `jvp_mul_tensor`: a product is linear in each operand while the other is a
// known value, so an operand's cotangent is `ct * other`, and the second half of the law is "then
// summed back to the shape the operand states". That second half is not a detail. The operator is
// called with an array and a *number* as well as with two arrays, and the number's cotangent is a
// reduction: the number fed every lane the broadcast spread it over, so its cotangent is the sum
// of what it fed. One law covers both shapes because it names the extents instead of assuming them --
// `sum_to(ct * other, shape(operand))` is the identity when the shapes are equal, and `T[...]`
// includes rank 0, a rank-zero array being that element and nothing else (design principles 5.4), so
// the number's shape is a shape like any other and its reduction is the total sum.
//
// The list is `shape(operand)` and not the operand itself: `sum_to` takes the extents,
// and a value is only needed where the walk holds one. Where the forward rule states the list
// instead, `mul_stated_t` below is the same law with that port in place of the call.
//
// This is one rule and cannot be two: the index tells two rules of one key apart by their `when`
// condition, so a second rule `(T[...], T)` -- no position of which overlaps the shapes above --
// was refused where it was written:
//
//     The rule 'mul_tensor_t' and the rule 'mul_tensor_scalar_t' both have 'mul_tensor' with 2
//     operand(s) as the head of their left side, and one ruleset has one rule per operator.
//
// The shapes differ in the operand list, not in the condition, so no wording of the condition
// lets them share this key; past that the walk asks for one rule per key by name
// (`camel/core/forward.cpp#transposeRuleOf`). Writing the reduction into the law is what makes the
// one rule correct for both shapes, and the sum is the engine's own reduction for the same operand
// (`lib/tensor/ops/vjp.cpp#accumulateOperand`: a tensor operand gets `tensor:sum_to`, a float
// one gets `tensor:sum`) -- read here as one expression rather than as a branch on the type.

/// `x + w` on two arrays: what `tensor:add` means, and the left side this rule is filed under.
func add::<T>(x: T[...], w: T[...]) => T[...] when is_float::<T>() {
    return x + w
}

/// The transpose of `x + w`: each operand answers with `ct` **reduced to that operand's own shape**.
///
/// `x + w` on two arrays is one operation with two shapes of operand: a sum whose two operands are
/// one shape, and a sum that **broadcasts** (design principles 5.4), whose smaller operand's
/// cotangent is the sum of what it fed. `sum_to` is the identity when the extents are the ones the
/// cotangent already has, so `sum_to(ct, shape(x))` answers both, and neither the law nor the walk
/// decides between them: for `x: float[2, 3]` with `w: float[3]`, `dL/dw` is `sum_to(ct, shape(w))`
/// -- three numbers and not the whole `[2, 3]` tensor, which answered under a static type that said
/// `[3]` would be a wrong number with exit 0 and no diagnostic (`[[1, 2, 3], [4, 5, 6]]` where the
/// answer is `[5, 7, 9]`).
///
/// This law is the one entry for `add` written by a **program**, and its extents come from
/// `shape(..)` of its own ports: the type the operand's declaration states, answered by the rule
/// layer where the law is expanded (`lib/transforms/rule_expand.cpp#expandRuleRightSide`). A
/// sum a **forward rule** wrote is not this operator: `jvp_add_tensor` writes the shape-carrying
/// `add_stated(dx, dw, shape(x), shape(w))`, and the law below answers that one from the two lists.
/// The two entries are one law per operator and not two spellings of one: a node either carries its
/// extents as operands or it does not, and the operator it is filed under says which.
///
/// A pair whose declarations state no extents (`float[...]` with `float[...]`) has no shape to
/// reduce by, and that step stops by name (`skip=law-reads-a-value uri=tensor:add`) instead of
/// answering the cotangent unchanged: an answer that may not be the operand's shape is refused and
/// not guessed (design principles 9.9). A sum whose operands are tangents never reaches here --
/// `jvp` always hands the extents over as values, so it is `add_stated` and the law below.
///
/// The head names one type parameter per operand for the reason `mul_tensor_t` below records:
/// written as one `T` for both, the instance is made at the element type and its ports state no
/// extents at all, so `shape(..)` would have nothing to read.
export rule add_tensor_t::<T, X, W>(x: X, w: W) { add(x, w) => func (ct: T[...]) {
    (sum_to(ct, shape(x)), sum_to(ct, shape(w)))
} }

/// The transpose of `add_stated(x, w, ax, aw)`: `ct` reduced to `ax` for `x`, and `ct` reduced to
/// `aw` for `w` -- `add_tensor_t`'s two answers with the two shapes **handed over**.
///
/// This is the entry every array sum of a derivative walks, and the one `jvp_add_tensor` hands it
/// (`lib/rulesets/jvp.cml`): the forward half writes `add_stated(dx, dw, shape(x), shape(w))`,
/// where both operands are values of the primal, so the two lists are values it computes. That is
/// the whole reason the operator exists -- on the reverse side the sum's operands are **tangents**,
/// `float[...]`, which state no extents (design principles 5.4), and a shape that is not in the type
/// has to be in the call. The law reads the two lists and nothing of the position it answers.
///
/// Two lists and not one, for the reason `mul_stated_t` below records: a sum broadcasts, so the two
/// cotangents come back to two different shapes.
export rule add_stated_t::<T, X, W, AX, AW>(x: X, w: W, ax: AX, aw: AW) { add_stated(x, w, ax, aw) => func (ct: T[...]) {
    (sum_to(ct, ax), sum_to(ct, aw))
} }

/// `x * w` on two arrays: what `tensor:multiply` means, and the left side this rule is filed under.
func mul_tensor::<T>(x: T[...], w: T[...]) => T[...] when is_float::<T>() {
    return x * w
}

// The shape a law needs arrives as `at` and goes straight into `sum_to`, which takes the extents
// themselves (`lib/tensor/tensor.cml#sum_to`): `sum_to(t, shape(x))` is the reduction, and there is no
// helper between the list and the call: a `sum_to_stated(t, at)` that built `zeros::<T>(at)`
// would be a second spelling of one call, and two spellings of one move are avoided.

/// The transpose of `x * w`: `ct * w` reduced to `x`'s shape for `x`, `ct * x` reduced to `w`'s
/// shape for `w`. The reduction is `sum_to` with the extents, so the law is written once for both
/// shapes the operator is called with -- two arrays, and an array and a number.
///
/// The second operand of each `sum_to` is `shape(x)` / `shape(w)` -- the extents **computed from the
/// value**, which is the layer the extents belong to (the primal's runtime
/// shape, not the type). It is answered where the walk carries that value
/// (`lib/transforms/rule_expand.cpp#expandRuleRightSide`); where it does not, the step is
/// refused by name rather than guessed at, and the stated pair of rules below is the spelling for a
/// law whose forward half writes the lists into the call. That is what makes the broadcast shape
/// `w`'s own and not `x`'s -- reading the other operand was measured to answer `[6.0]` where the
/// engine answers a `[2, 2, 2]` tensor, and reading a zero carrier for it answered zeros -- and it
/// is the difference between a law that names a shape and one that guesses at it.
export rule mul_tensor_t::<T, X, W>(x: X, w: W) { mul_tensor(x, w) => func (ct: T[...]) {
    (sum_to(ct * w, shape(x)), sum_to(ct * x, shape(w)))
} }

/// The transpose of `mul_stated(x, w, ax, aw)`: `ct * w` reduced to `ax` for `x`, and `ct * x`
/// reduced to `aw` for `w` -- `mul_tensor_t`'s two answers with the two shapes **handed over**.
///
/// The law reads the other operand's value (`ct * w` is a product with a value the cut carries) and
/// the answered operand's shape as a value of the primal (`ax` / `aw`), and nothing of the position
/// it answers. That is the difference from `mul_tensor_t` above, and it is the difference a
/// transposition needs: the operand whose cotangent this is has no value on this side (design
/// principles 4.3), and its type is `float[...]`, which states no extents. The forward half computes
/// both lists, where both operands are values (`lib/rulesets/jvp.cml#jvp_mul_tensor`).
///
/// Two lists and not one: a product broadcasts, so the two cotangents come back to two different
/// shapes, and one list would answer the wrong one of them (`mul_tensor_t` records the measurement:
/// `sum_to(ct * w, shape(w))` answers `[6.0]` where the engine answers a `[2, 2, 2]` tensor).
export rule mul_stated_t::<T, X, W, AX, AW>(x: X, w: W, ax: AX, aw: AW) { mul_stated(x, w, ax, aw) => func (ct: T[...]) {
    (sum_to(ct * w, ax), sum_to(ct * x, aw))
} }

/// `relu(x) = maximum(x, 0)` per element: the cotangent is `ct` where the input was positive and
/// zero where it was not, so the rule is the mask `x > 0` and nothing else. It writes that mask with
/// `where`, a registered operator, and not with a function of this rule's making: a helper named on a
/// rule's right side becomes a call in the graph the backward walk has to transpose, and a call with
/// no transpose of its own stops the walk (`skip=call-no-transpose`; `jvp_pow` writes its law out in place for that reason). A
/// rule's right side is the answer, so a three-operand
/// `where` is allowed here; the forward rule cannot write it that way, and `jvp_relu` records the
/// measurement (`skip=arity uri=tensor:where operands=3`).
///
/// `x > 0` and not `x >= 0`: the input zero has no slope, and both halves say so the same way --
/// `jvp_relu` (`lib/rulesets/jvp.cml`) kills the tangent with the same comparison, so the forward
/// and the reverse reading of the boundary cannot drift apart.
export rule relu_t::<T, A>(x: A) when is_float::<T>() { relu(x) => func (ct: T[...]) {
    (where(x > 0.0, ct, 0.0))
} }
/// The transpose of `tanh`: `ct * (1 - y * y)` with `y = tanh(x)`, the adjoint of `jvp_tanh` and the
/// same slope the engine's `tanhVjp` builds from its own output. The right side recomputes `tanh(x)`,
/// an x-only value -- the shape the cut carries (`exp`, `sigmoid`).
export rule tanh_t::<T>(x: T[...]) when is_float::<T>() { tanh(x) => func (ct: T[...]) {
    (ct * (1.0 - tanh(x) * tanh(x)))
} }

/// The transpose of `exp`: `ct * y` with `y = exp(x)` -- the cotangent scaled by the output, which is
/// the same rule the engine's `expVjp` (`lib/tensor/ops/elementwise_ops.cpp`) applies to its own
/// cotangent. The right side recomputes the forward value from `x`, which is the only way a law with
/// one operand can name it; that recomputation is the point the question below asks about, so this
/// rule and `jvp_exp` (`lib/rulesets/jvp.cml`) are a measurement as well as a law.
export rule exp_t::<T>(x: T[...]) when is_float::<T>() { exp(x) => func (ct: T[...]) {
    ct * exp(x)
} }

/// The transpose of `sigmoid`: `ct * y * (1 - y)` with `y = sigmoid(x)`, the cotangent scaled by the
/// slope the engine's own rule builds (`sigmoidVjp`, `lib/tensor/ops/elementwise_ops.cpp`: `y`,
/// then `1 - y`, then the two multiplied into the cotangent). The law has one operand, so the slope
/// can only be named by recomputing it, and `sigmoid(x)` depends on `x` alone -- the recomputation
/// `exp` measured the cut carrying as a residue (`jvp_exp`, `exp_t`). What stays in the linear half
/// is `ct * <residual> * <residual>`, two `mul_tensor` nodes, each of which already has a transpose
/// (`mul_tensor_t`), so the walk needs nothing new by name.
export rule sigmoid_t::<T>(x: T[...]) when is_float::<T>() { sigmoid(x) => func (ct: T[...]) {
    (ct * sigmoid(x) * (1.0 - sigmoid(x)))
} }
/// The transpose of `log_softmax`: `ct - exp(y) * sum(ct)` with `y = log_softmax(x)` and the axis summed
/// with `keepdims` -- the expression the engine's own rule writes (`logSoftmaxVjp`,
/// `lib/tensor/ops/reduction_ops.cpp`: `dy - exp(output) * sum<axis, true>(dy)`), not the
/// transposed direction of `jvp_log_softmax`, which is `ct - sum(exp(y) * ct)`. The two differ by a
/// broadcast: for `ct = 1` the wrong one answers zero everywhere, because `sum(p) = 1`.
export rule log_softmax_t::<T>(x: T[...]) when is_float::<T>() { log_softmax<0>(x) => func (ct: T[...]) {
    (ct - exp(log_softmax<0>(x)) * sum<0, true>(ct))
} }

// ---- the transpose rule of `softmax` ----
//
// `softmax<axis>(x)` was the other key of the `forward-only` column here: `jvp_softmax` answered the
// tangent and nothing answered the cotangent. The reverse is not the forward rule transposed --
// that is `log_softmax_t`'s note one section up -- it is `y * (ct - sum<axis, true>(ct * y))` with
// `y = softmax<axis>(x)`, the jacobian `diag(p) - p pᵀ` read from the right.
//
// **The law calls `softmax_grad` and does not write that arithmetic out.** The engine's `softmaxVjp`
// builds the operator (`lib/tensor/ops/reduction_ops.cpp#softmaxVjp`: `tensor:softmax_grad(output,
// dy[, axis])`), and the kernel behind it is the one place the subtraction's broadcast and the
// axis' normalization are decided. A law that recomputed the same expression would be a second
// implementation of one rule, and the two legs of a `grad` are compared bit for bit: the day the
// kernel's grouping moved, the library's copy would answer a number one place off and nothing
// would say which of the two was the rule. So the law names the operator, which is also why
// `softmax_grad` is exported by `tensor` at all.
//
// The axis is the operator's second port and the law names it, exactly as `jvp_softmax` does: a law
// that wrote `<0>` would answer the first axis of a rank-1 input and no other axis at all
// (`jvp_softmax` records the refusal that spelling produces). The `y` the law feeds the kernel is
// the forward value recomputed from the operand -- the channel `exp_t` established -- and it is the
// same number the engine's node carries, because the kernel is deterministic and the operand is
// the same value.
export rule softmax_t::<T>(x: T[...], axis: int) when is_float::<T>() { softmax<axis>(x) => func (ct: T[...]) {
    softmax_grad(softmax<axis>(x), ct, axis)
} }

// ---- the transpose rule of `layer_norm` ----
//
// `layer_norm(x, gamma, beta)` normalizes each lane of `gamma`'s element count, and its adjoint is
// three cotangents -- one per operand -- each of which is the same operator read at a different
// `which`. The library cannot write the arithmetic: the lane is a **block of axes**, and every
// reduction it declares takes one axis (`jvp_layer_norm` records the same wall from the forward
// side, and it is why that rule is written as the normalization's own derivative rather than as a
// composition).
//
// The engine answers with one operator and a selector -- `tensor:layer_norm_grad(x, gamma, dy,
// which[, eps])`, once per operand (`lib/tensor/ops/reduction_ops.cpp#layerNormVjp`) -- and that
// operator is exported by `tensor`, so the law is the engine's own three accumulations written as
// one tuple: `which = 0` for `x`, `1` for `gamma`, `2` for `beta`, in the order the cotangents are
// answered. Writing the three calls instead of one is not a choice: a law's right side is the
// answer, and the answer is a tuple of three.
//
// `eps` is not read: the law's left side is the three-operand spelling, so a call that passes the
// fourth operand reaches no law and is refused by shape rather than answered with the default
// (design principles: a step the library cannot answer is refused by name, never guessed).
export rule layer_norm_t::<T>(x: T[...], gamma: T[...], beta: T[...]) {
    layer_norm(x, gamma, beta) => func (ct: T[...]) {
        (
            layer_norm_grad(x, gamma, ct, 0),
            layer_norm_grad(x, gamma, ct, 1),
            layer_norm_grad(x, gamma, ct, 2)
        )
    }
}

// ---- the transpose laws of the eight basic elementwise operators ----
//
// The reverse half of the tranche whose forward half is in `lib/rulesets/jvp.cml`
// (`jvp_neg_tensor`, `jvp_abs`, `jvp_sqrt`, `jvp_log`, `jvp_rsqrt`, `jvp_maximum`, `jvp_minimum`,
// `jvp_divide`). Each law is the adjoint of its forward rule and the same number the engine's own
// rule answers (`lib/tensor/ops/elementwise_ops.cpp`: `negVjp`, `absVjp`, `sqrtVjp`, `logVjp`,
// `rsqrtVjp`, `extremumVjp`, `divideVjp`), in the engine's grouping, because the two legs of a
// `grad` are compared bit for bit and an algebraically equal grouping is not the same double.
//
// A law is used by the backward walk wherever the *forward* rule put the operator on a linear value;
// for the five that recompute, the operator is applied to the operand instead, so what the walk meets
// is the residue the cut carried (`residuals=` on the `split` line) plus the products and quotients
// around it. The law is the family's own answer either way: a second-order walk, a hand-written
// linear function over one of these operators, and the day a forward rule is written with the
// operator inside the linear half all read it, and none of them may read a missing one.

/// `-x` on an array: the left side `tensor:neg`'s law is filed under, the way `mul_tensor` above
/// stands for `tensor:multiply`. `tensor:neg`'s exported spelling is `__neg__`, which is not a call.
func neg::<T>(x: T[...]) => T[...] when is_float::<T>() {
    return -x
}

/// The transpose of `-x`: `-ct`. A sign flip is its own adjoint, and the law reads the cotangent and
/// nothing else -- the cheapest shape a law has.
export rule neg_tensor_t::<T>(x: T[...]) when is_float::<T>() { neg(x) => func (ct: T[...]) {
    -ct
} }

/// The transpose of `sqrt`: `(ct * 0.5) / sqrt(x)` -- one over twice the root, written as the
/// engine's `sqrtVjp` writes it (`ct * 0.5` first, then the division, so the two legs round the same
/// way). The root is recomputed from the operand; it is a function of `x` alone, the channel
/// `exp_t` above established.
export rule sqrt_t::<T>(x: T[...]) when is_float::<T>() { sqrt(x) => func (ct: T[...]) {
    (ct * 0.5) / sqrt(x)
} }

/// The transpose of `rsqrt`: `(ct * -0.5) * (y * (y * y))` with `y = rsqrt(x)`, which is the grouping
/// the engine's `rsqrtVjp` builds (`cube = y * (y * y)`, `scaled = ct * -0.5`, `scaled * cube`).
export rule rsqrt_t::<T>(x: T[...]) when is_float::<T>() { rsqrt(x) => func (ct: T[...]) {
    (ct * (-0.5)) * (rsqrt(x) * (rsqrt(x) * rsqrt(x)))
} }

/// `x / w` on two arrays: the left side `tensor:divide`'s law is filed under. `tensor:divide`'s
/// exported spellings are `__div__` and the infix form, and neither is a call -- the same stand-in
/// `subtract` below is.
func divide::<T>(x: T[...], w: T[...]) => T[...] when is_float::<T>() {
    return x / w
}

/// The transpose of `x / w`: `ct / w` for `x`, and `-(ct / w) * (x / w)` for `w` -- the two answers
/// the engine's `divideVjp` builds, in its order (`dlhs = ct / w`, then `dlhs * (x / w)`, then the
/// negation), so the quotients that produce the two cotangents are the same quotients.
export rule divide_t::<T, X, W>(x: X, w: W) when is_float::<T>() { divide(x, w) => func (ct: T[...]) {
    (sum_to(ct / w, shape(x)), sum_to(-((ct / w) * (x / w)), shape(w)))
} }

/// The transpose of `div_stated(x, w, ax, aw)`: `ct / w` reduced to `ax` for `x`, and
/// `-(ct / w) * (x / w)` reduced to `aw` for `w` -- `divide_t`'s two answers with the two shapes
/// **handed over**.
///
/// This is the entry every quotient a derivative walks is turned round by, and the reason the operator
/// exists: on the reverse side the dividend and the divisor are **tangents**, `float[...]`, which state
/// no extents (design principles 5.4), so `divide_t`'s `shape(x)` / `shape(w)` name the position the
/// law answers for and nothing can be read there (`skip=parameter-shape`, measured on `jvp_sqrt`,
/// `jvp_log` and `jvp_divide` before this law existed). The forward half states both lists where both
/// operands are values -- `lib/rulesets/jvp.cml#jvp_divide`, `#jvp_div_stated` for a program that
/// writes this operator itself -- and this law reads them and nothing of the position it answers.
///
/// The two products are `ct / w` and `(x / w)`, in the engine's grouping (`divideVjp`:
/// `dlhs = ct / w`, then `dlhs * y`, then the negation), so the quotients that produce the two
/// cotangents are the same quotients and round the same way.
///
/// Two lists and not one, for the reason `mul_stated_t` records: a quotient broadcasts as a product
/// does, so `[2, 2, 3] / [3]` has two different operand shapes and each cotangent comes back to its
/// own.
export rule div_stated_t::<T, X, W, AX, AW>(x: X, w: W, ax: AX, aw: AW) when is_float::<T>() { div_stated(x, w, ax, aw) => func (ct: T[...]) {
    (sum_to(ct / w, ax), sum_to(-((ct / w) * (x / w)), aw))
} }

// ---- why `abs`, `log`, `maximum` and `minimum` have no law here ----
//
// These four are the largest block of `scripts/vjp-parity.mjs`'s `forward-only` column: their
// forward laws are in `lib/rulesets/jvp.cml` (`jvp_abs`, `jvp_log`, `jvp_maximum`, `jvp_minimum`)
// and no transpose law stands beside them, so each key is one the library answers in one direction
// only. **That is the final state and not an open item: the four laws were written, and they were
// taken back out.** Two measurements are why, both made on the build host.
//
//   1. A law for any of the four cannot be walked. `transpose` of a one-operator function that
//      writes one refuses it by name --
//
//          TRANSPOSE function=f_abs skip=law-reads-a-value uri=tensor:abs position=0
//          operand-types=float[3] reason=the rule's right side reads a value the caller does not carry
//
//      -- and the sentence is exact. `transpose` turns a *linear* map around: the transposed
//      function is handed the cotangent and nothing else, and the adjoint of a linear map is
//      linear, so it cannot consult the operand's value. These four operators are not linear (the
//      slope reads the value: the sign, the reciprocal, which side of the other operand), so the
//      only law that could answer them is a law the walk can never reach. `jvp_abs` etc. do not put
//      the operator into their linear halves for that reason -- the mask is computed in the forward
//      half and carried -- so the reverse question is not asked anywhere either.
//
//   2. Filing them makes the refusal worse, and `test/plans/feat/compile/transforms.plan.toml`'s
//      `transpose_refuses_a_nonlinear_operator` and `transpose_refuses_maximum` are the guards that
//      say so. With the laws in place those two cases went red: the message a reader gets for
//      `transpose(abs)` changed from "the family holds no rule for `tensor:abs` ... `transpose` is
//      for linear functions ... take the gradient with `vjp`" to the first sentence above, which
//      tells them a law exists and has an obstacle, when the truth is that the operator has no
//      transpose at all. A law that no walk reaches and that degrades the diagnostic for the case it
//      is supposed to serve is decoration, so the four are not filed.
//
// What the library answers for these four is the **forward** half's mask, which is the same number
// the engine's `absVjp`/`logVjp`/`extremumVjp` answer, and
// `test/cases/modules/autodiff/library_forward_elementwise_both_legs.cml` reads all four through
// both legs to prove it. `scripts/vjp-parity.mjs` keeps counting them under `forward-only`, and that
// column is a difference of decomposition rather than a gap: the engine transposes the primal graph
// and so needs a rule per operator; the library transposes a linear map and answers these four in
// the forward half.
/// `x - w` on two arrays: what `tensor:subtract` means, and the left side this rule is filed under.
func subtract::<T>(x: T[...], w: T[...]) => T[...] when is_float::<T>() {
    return x - w
}

/// The transpose of `x - w`: `ct` for `x` and `-ct` for `w`, **each reduced to that operand's own
/// shape** -- the mirror of `add_tensor_t` above.
///
/// It is the one entry for a difference a **program** wrote, and it is here because a loss written
/// `pred - target` -- the one line every training step has -- puts this operator in the backward
/// graph between the product's law and the sum's. The reduction is the same one the add's law makes
/// and for the same reason: `x - w` broadcasts, so the operand that was spread over the larger one
/// gets the sum of the cotangents it fed, and answering `-ct` at the result's shape would put a
/// `[2, 3]` tensor under a `float[3]` type (`[[-1, -2, -3], [-4, -5, -6]]` where the answer is
/// `[-5, -7, -9]`). The extents are the operands' own, read the way that law reads them, and a
/// declaration that states none stops the step by name rather than answering the cotangent
/// unchanged. A difference a forward rule wrote is `subtract_stated`, and the law below answers it.
export rule subtract_t::<T, X, W>(x: X, w: W) { subtract(x, w) => func (ct: T[...]) {
    (sum_to(ct, shape(x)), sum_to(-ct, shape(w)))
} }

/// The transpose of `subtract_stated(x, w, ax, aw)`: `ct` reduced to `ax` for `x`, and `-ct`
/// reduced to `aw` for `w` -- the mirror of `add_stated_t` above, and the law the training step's
/// `pred - target` is turned round by.
///
/// The reason is that law's, one operator on: `jvp_subtract` writes its tangent as
/// `subtract_stated(dx, dw, shape(x), shape(w))`, because on the reverse side the position a
/// cotangent is answered for is a tangent and a tangent's type states no extents. The two shapes are
/// values of the primal, computed where both operands are values, and this law reads them instead of
/// reading the position it answers for.
///
/// This is the shape that must not fall back to `-ct` unanswered: a difference broadcasts, so the
/// operand that was spread over the larger one gets the sum of the cotangents it fed
/// (`subtract_t` above records the measurement that spelling was written for).
export rule subtract_stated_t::<T, X, W, AX, AW>(x: X, w: W, ax: AX, aw: AW) { subtract_stated(x, w, ax, aw) => func (ct: T[...]) {
    (sum_to(ct, ax), sum_to(-ct, aw))
} }

// ---- the transpose rule of the matrix product ----
//
// A product's cotangent is written with two more products: `a · b` passes `ct · bᵀ` back to `a` and
// `aᵀ · ct` back to `b`. Both are the operator itself, so the law needs no arithmetic of its own and
// no operator the library does not already publish -- the transposition of the *known* operand is
// `tensor:transpose` (the last two axes swapped, `src/stdlib/tensor/signatures/tensor.cml#transpose`), which
// reads a value the cut already carries, not the cotangent. Nothing here asks for a shape: the
// extents are the operands' own, `transpose` carries them through, and `matmul` checks the pair where
// the node is built -- the same place the forward rule's `matmul(da, b)` is checked
// (`lib/rulesets/jvp.cml#jvp_matmul`). So the law reads no linear operand's value and needs no
// count of anything: this is the shape the primitives' own declarations already state.
//
// It is the adjoint of `jvp_matmul` and it is filed under the operator's own name, `matmul(a, b)`,
// the way that forward rule is -- the key `tensor:matmul` needs no exception in `ruleKeyExceptions()`
// because the name derives it.
//
// **Every shape `matmul` takes is served, and the shapes are told apart by the cotangent helpers.** A
// vector operand is not the matrix shape with a smaller extent: the product reads a rank-one operand
// as a row or a column and drops that axis from the answer (`lib/tensor/kernels/gemm.cpp#planMatmul`),
// so the cotangent that comes back is a rank-one value where the operand is rank one, and the cotangent
// that goes to the *other* operand is an outer product the matmul cannot write -- the product of a
// rank-one value with a rank-one value is a number. That outer product is a **spread**, so it is
// `broadcast_like`'s, and it is written in the two lane orderings the shapes allow:
//
//   * `a` a vector, `b` a matrix: `bᵀ` is (n, k) and both the cotangent of the answer (n) and `a` (k)
//     spread into that shape from the right -- `broadcast_like(ct, bᵀ) * broadcast_like(a, bᵀ)` is
//     (n, k) with `ct[i] * a[j]` in it, and the transpose of it is the (k, n) outer product `a ⊗ ct`
//     that goes back to `b`. The shape is `bᵀ`'s own, read from a known operand; no extent is
//     reconstructed.
//   * `a` a matrix, `b` a vector: `a` is (m, k) and the cotangent of the answer (m) spreads along its
//     leading axis while `b` (k) spreads along its last -- `broadcast_like(ct, a) * broadcast_like(b, a)`
//     is `ct ⊗ b`.
//
// The spread is a different operator and not a direction of `sum_to`: a reduction
// removes leading axes from a target that is a suffix of its operand's shape, and `sum_to` refuses a
// target longer than its operand by name (`lib/tensor/tensor.cml#sum_to`). Using it for the spread was
// the wrong operator, and the two rules read better apart: the reduction names extents, the spread
// names the value whose lanes are wanted.
//
// Both are the same law `matmul` states, read at the rank the operands have; nothing here reads a
// linear operand's value or asks for a count. What the matrix form needs is the reduction
// `sum_to(matmul(ct, bᵀ), shape(a))`: the identity when the shapes agree, and the sum over a batch
// axis the day an operand carries one -- the reduction half of this law, written where it belongs
// rather than left to the day a batch appears.
//
// **The rank dispatch lives in the helpers, because a ruleset files one rule per operator and arity.**
// A second `matmul(a, b)` rule is refused by name (`SemanticDiag::DuplicateRuleForOperator`, 0x03000205:
// the transform would otherwise choose between them by the order they are written in), and a pattern
// cannot name a set of ranks. The head of the instance is type variables for a second reason: the walk
// hands a rule one type per value it can see -- the cotangent's element type, then each operand's own
// type (`ruleCotangent`, `lib/transforms/transpose/walk.cpp`) -- so a head that wrote `T[?, k], T[k, ?]`
// would state *one* shape and be instantiated for all three numbers anyway. `mul_tensor_t` above is
// `<T, X, W>` for the same reason. The shapes are therefore stated by the two cotangent helpers,
// overloaded on the operands' ranks.
//
// What a helper must not do is build a shape: every one of them ends by naming the extents of the
// *known* operand -- `sum_to(..., shape(a))` or `sum_to(..., shape(b))` -- so the extents are
// computed from a value the cut already carries and a shape is never reconstructed from a count
// (design principles 5.4: a shape may be taken from an operand, never
// read off the linear operand). `shape(x)` is the extents of a runtime value, which is the layer
// the extents belong to; the operator that reduces reads the list and never
// the operand's type. `sum_to` is also where the reduction half of this law lives: for two matrices
// the call is the identity, and it becomes the sum over a batch axis the day an operand has one.
//
// **What is outside the law stops in the helpers, and the walk has a word for it.** Rank three and
// above, and the vector-vector product whose answer is a number, have no overload; the law is chosen,
// its own body has nothing for these operands, and the walk refuses that by name -- the law, the
// operator and the ranks:
//
//     skip=rule-ranks uri=tensor:matmul rule=matmul_t node=6 position=0 ranks=(3, 2) operands=2
//     reason=No matching function found for argument types: <> (float[...], float[3, 2, 2], float[2, 2]).
//
// `rule-ranks` is not `rule-shape`, and the two must not be merged: `rule-shape` means the law's
// *pattern* rejected the operand types and nothing was built, which is where a reading stands when
// the law names its ranks in the pattern. A reader fixes those two differently -- widen the
// pattern, or write the missing shape's law -- so they are two words; both sentences below are
// pinned by
// `test/cases/compile/transforms/matmul_transpose_rank_three.cml`, and the day a batch axis is served
// that case fails and names what replaced them.
//
// The two matrices are also what makes the law checkable: the model it was written for multiplies a
// batch by a weight, both two-dimensional (`test/cases/compile/transforms/matmul_transpose_law.cml`),
// and the vector lanes are read in `matmul_transpose_vector_lhs.cml` and
// `matmul_transpose_vector_rhs.cml`.

/// The cotangent of the left operand, both operands matrices: `ct · bᵀ`, reduced to `a`'s extents.
func ct_of_a::<T>(ct: T[...], a: T[?, ?], b: T[?, ?]) => T[?, ?]
    when is_float::<T>() {
    return sum_to(matmul(ct, transpose(b)), shape(a)) as T[?, ?]
}

/// The cotangent of the left operand when it is a row: `ct · bᵀ` is already its own shape.
func ct_of_a::<T>(ct: T[...], a: T[?], b: T[?, ?]) => T[?] when is_float::<T>() {
    return sum_to(matmul(ct, transpose(b)), shape(a)) as T[?]
}

/// The cotangent of the left operand when the right one is a column: the outer product `ct ⊗ b`,
/// spread into `a`'s lanes from the two values that have the elements.
func ct_of_a::<T>(ct: T[...], a: T[?, ?], b: T[?]) => T[?, ?]
    when is_float::<T>() {
    return broadcast_like(ct, a) * broadcast_like(b, a)
}

/// The cotangent of the right operand, both matrices: `aᵀ · ct`, reduced to `b`'s extents.
func ct_of_b::<T>(ct: T[...], a: T[?, ?], b: T[?, ?]) => T[?, ?]
    when is_float::<T>() {
    return sum_to(matmul(transpose(a), ct), shape(b)) as T[?, ?]
}

/// The cotangent of the right operand when the left one is a row: the outer product `a ⊗ ct`, built
/// in `bᵀ`'s lanes and turned round, because a row's cotangent is where the missing axis is.
func ct_of_b::<T>(ct: T[...], a: T[?], b: T[?, ?]) => T[?, ?]
    when is_float::<T>() {
    return sum_to(
        transpose(broadcast_like(ct, transpose(b)) * broadcast_like(a, transpose(b))),
        shape(b)
    ) as T[?, ?]
}

/// The cotangent of the right operand when it is a column: `aᵀ · ct` is already its own shape.
func ct_of_b::<T>(ct: T[...], a: T[?, ?], b: T[?]) => T[?] when is_float::<T>() {
    return sum_to(matmul(transpose(a), ct), shape(b)) as T[?]
}

// ---- the same six answers, with the extents handed over instead of computed ----
//
// `matmul_stated_t` below answers a node whose two operands' shapes are ports (`sa`, `sb`) rather
// than values in the cut: `lib/rulesets/jvp.cml#jvp_matmul` states `shape(a)` and `shape(b)` in
// the linear call, where both operands are values. So each helper here is its `ct_of_a` / `ct_of_b`
// counterpart with `shape(a)` replaced by `sa` -- and that is the whole difference, which is why the
// six are written out rather than folded into the six above: what changes is where the list comes
// from, and the reduction itself is the same reduction. Both spellings pass a list into `sum_to`,
// which is the one signature (`lib/tensor/tensor.cml#sum_to`): one operator, one spelling of the call.
//
// **What the six still need of the answered operand is its rank, and what they may not ask the
// caller for is its value.** The rank picks the helper (`matmul` reads a row operand as a row and
// contracts its extent against the matrix's first axis), and the walk never holds a value for the
// position it is answering (`buildTransposeMember`: the transposition is handed the cotangent and the
// *other* operand). The plain helpers above therefore reach `float[]` and stop: `ct_of_a(ct, a, b)`
// names `a`, the expansion asks for a value behind it, the type states no extents, and the walk builds
// no zero array to stand in for it (`lib/transforms/transpose/walk.cpp#buildTransposeMember`), so the step is refused by name.
// The two vector cases of `test/plans/feat/showcase_s2.plan.toml` show it:
//
//     skip=parameter-shape uri=tensor:matmul_stated node=11 position=0 param=0 param-type=float[]
//
// So the law builds the carrier itself, from the list, and hands it over in the answered operand's
// place -- with the extents taken from `sa` / `sb` instead of from the type.
//
// **The carrier is not where the length comes from; `sa` is, and it goes straight into `sum_to`.**
// The reduction reads `at`, and here that is `sa`: the known argument of the linear
// call, written by the forward half (`matmul_stated(da, b, shape(a), shape(b))`) where `a` is a
// value, and carried to the backward half as a port. The carrier's extents agree with it -- `sa`
// *is* `shape(a)` -- but nothing reads the length off the carrier or off the type; what the carrier
// is read for is the **rank**, which is the part of the declaration the type does state. The cast
// keeps that rank: `float[]` says rank one and no extent, and `float[3, 2, 2]` still matches no
// helper, so a batched product is refused exactly as before (`skip=rule-ranks`). Where an answer is
// a spread instead of a reduction, the carrier's extents are the lanes it spreads into and
// `broadcast_like` reads them -- the same value, read for its shape, in the one operator that owns
// that direction.
//
// The alternative -- dropping the answered operand from the helpers and dispatching on the cotangent's
// rank -- does not exist: the law's closure types the cotangent `T[...]`, so a helper
// over `float[?]` / `float[?, ?]` never takes it (`No matching function found for argument
// types: <> (float[...], ...)`).
//
// The law's domain is unchanged: `mul_stated_t` and `matmul_stated_t` answer a product reached
// through a forward rule that states `shape(...)` in the half where both operands are values
// (`lib/rulesets/jvp.cml#jvp_mul_tensor`, `#jvp_matmul`, `#jvp_linear`,
// `#jvp_erf` and `#jvp_erfc` too). A product whose forward rule writes the bare operator still meets
// `mul_tensor_t` / `matmul_t`, and those compute the lists from the operands' values where the walk
// holds them.
//
// Twelve helpers, one family: `T` is the element type of every array here, and the guard
// `is_float::<T>()` is what the six above and the six below both say. They were written for
// `float[...]` and `float[?, ?]` outright, so a product over `f32` arrays had no law to reach -- the
// case study's tensors are `f32` -- and the walk reported it as a shape the law does not take. The
// cotangent of a product has the element type of its operands (`Tangent<f32[...]>` is `f32[...]`),
// so one type parameter per helper covers every float width and a second set of six is not owed.

/// Both operands matrices: `ct · bᵀ`, reduced to `sa`.
func ct_of_a_stated::<T>(
    ct: T[...],
    a: T[?, ?],
    b: T[?, ?],
    sa: int[]
) => T[?, ?]
    when is_float::<T>() {
    return sum_to(matmul(ct, transpose(b)), sa) as T[?, ?]
}

/// The left operand a row: `ct · bᵀ` is already its own shape, and `sa` is that shape.
func ct_of_a_stated::<T>(ct: T[...], a: T[?], b: T[?, ?], sa: int[]) => T[?]
    when is_float::<T>() {
    return sum_to(matmul(ct, transpose(b)), sa) as T[?]
}

/// The right operand a column: the outer product `ct ⊗ b`, spread into `a`'s lanes (the carrier's
/// extents are `sa`, so this is the spread into `sa`).
func ct_of_a_stated::<T>(ct: T[...], a: T[?, ?], b: T[?], sa: int[]) => T[?, ?]
    when is_float::<T>() {
    return broadcast_like(ct, a) * broadcast_like(b, a)
}

/// Both operands matrices: `aᵀ · ct`, reduced to `sb`.
func ct_of_b_stated::<T>(
    ct: T[...],
    a: T[?, ?],
    b: T[?, ?],
    sb: int[]
) => T[?, ?]
    when is_float::<T>() {
    return sum_to(matmul(transpose(a), ct), sb) as T[?, ?]
}

/// The left operand a row: the outer product `a ⊗ ct`, built in `bᵀ`'s lanes and turned round, then
/// reduced to `sb`. `b` here is the carrier, so `transpose(b)`'s lanes are `b`'s own extents.
func ct_of_b_stated::<T>(ct: T[...], a: T[?], b: T[?, ?], sb: int[]) => T[?, ?]
    when is_float::<T>() {
    return sum_to(
        transpose(broadcast_like(ct, transpose(b)) * broadcast_like(a, transpose(b))),
        sb
    ) as T[?, ?]
}

/// The right operand a column: `aᵀ · ct` is already its own shape, and `sb` is that shape.
func ct_of_b_stated::<T>(ct: T[...], a: T[?, ?], b: T[?], sb: int[]) => T[?]
    when is_float::<T>() {
    return sum_to(matmul(transpose(a), ct), sb) as T[?]
}

// The head takes three type parameters because the walk hands a rule one type per value it can see:
// the cotangent's element type first, then the operands' own types (`lib/transforms/transpose/walk.cpp`
// `ruleCotangent`). `mul_tensor_t` above is written `<T, X, W>` for the same reason. `A` and `B` are
// the operand types whole -- their ranks live in them, which is what the helpers above dispatch on --
// and `T` is only the element type every cotangent here has.
export rule matmul_t::<T, A, B>(a: A, b: B) when is_float::<T>() { matmul(a, b) => func (ct: T[...]) {
    (ct_of_a(ct, a, b), ct_of_b(ct, a, b))
} }

/// The transpose of `matmul_stated(a, b, sa, sb)`: `ct · bᵀ` reduced to `sa` for `a`, and `aᵀ · ct`
/// reduced to `sb` for `b` -- `matmul_t`'s two answers with the two shapes **handed over**.
///
/// It serves the same three shapes `matmul_t` does. What differs is where each answer's extents come
/// from: the `sa` / `sb` port the forward half computed, instead of `shape(a)` / `shape(b)` computed
/// here; and the answered operand arrives as the carrier the law builds from that list
/// (`zeros::<T>(sa) as A`), not as a value the walk would have to hold -- the carrier is what picks
/// the helper by rank, and `sa` is what `sum_to` reduces to. The rank is still the declaration's --
/// `A` and `B` are the operands' own types, so `float[3, 2, 2]` still matches nothing and a batched
/// product is refused by name in this law's body, the way `matmul_t` refuses one (`skip=rule-ranks`,
/// and the reading says which law declined:
/// `test/cases/compile/transforms/matmul_transpose_rank_three.cml`).
export rule matmul_stated_t::<T, A, B, SA, SB>(a: A, b: B, sa: SA, sb: SB)
    when is_float::<T>() { matmul_stated(a, b, sa, sb) => func (ct: T[...]) {
    (
        ct_of_a_stated(ct, zeros::<T>(sa) as A, b, sa),
        ct_of_b_stated(ct, a, zeros::<T>(sb) as B, sb)
    )
} }
// ---- the transpose rules of the reductions and the layout ----
//
// A forward rule that answers with the operator itself (`d(sum(xs)) = sum(dxs)`, `rulesets.jvp`)
// leaves the pullback one question: the adjoint of that operator. A sum is linear in the value, so
// its adjoint is the move it makes read backwards -- a reduction's adjoint spreads.
//
// The three operations whose adjoint needs the extents they consumed are below, written against the
// **stated** spelling their forward halves call (`sum_stated`, `take_stated`, `mean_axis_stated`):
// that spelling's second operand is the shape, so the law reads a known value instead of the tensor
// the cotangent comes back through. `reshape` still has no rule here, and what a
// rule's pattern cannot do is not the reason: a law *can* name the position the call writes
// in angle brackets (`rulesets.jvp#jvp_reshape` names `reshape`'s shape now), and what it names is
// the **target** shape -- not the extents the value had before it was reshaped, which is the shape
// this side needs and which no port of the node states.
//
// `softmax` was the other name in that sentence and is not one any more. Its law is `softmax_t`
// above, and
// it needed no extents: `softmax_grad(y, ct, axis)` is the kernel's own answer, so the law hands it
// the axis the node carries and the `y` it recomputes.

// ---- the transpose rules of the three operations that state their extents ----
//
// A reduction and a gather are linear in their data, so their adjoints are the moves they make read
// backwards -- a reduction's adjoint spreads one cotangent over the elements it added, a gather's
// adjoint scatters a row's cotangent back to where that row came from. Neither can be built from the
// operand the cotangent comes back through: a transpose law reads only **known** operands, and that operand has no value on this side.
//
// So the forward half states the extents, in the operator's second operand, and these three rules
// read that operand and nothing of the tensor: `sum_stated_t` spreads over the list's extents,
// `take_stated_t` scatters into an array of them, and `mean_axis_stated_t` spreads each lane's
// cotangent over `numel(t) / numel(ct)` positions. Each list's layout is stated where the forward
// half builds it: `shape(t)`, and the axis and the flag beside it.
//
// The value of a stated operator is the operation itself -- the extents are there for this side --
// so what a call site hands over is the operand's shape as a parameter of its own, and the arrays
// these laws build carry the extents of a value the transpose never reads.

/// `xs` with one number at every element: the shape a reduction's cotangent is spread over, taken
/// from the extents the forward half stated.
///
/// `full` is what makes a spread out of a scalar, and the declared `T[...]` is what lets a rule's
/// right side hold it: `full` answers an array of open rank from a runtime shape list, which is the
/// rank its callers already read it at.
func spread_over::<T>(ct: T, at: int[]) => T[...] when is_float::<T>() {
    return full(at, ct)
}

/// The cotangent of `sum_stated(t, at)`: the one number it answers is the sum of every element, so
/// its adjoint gives that number to every element of the extents `at` states.
///
/// The head declares one type parameter per position a law is instantiated at -- the cotangent's
/// element type and one per operand, the spelling `mul_tensor_t` uses -- so `t` and `at` are `X` and
/// `A` and not `T[...]` and `int[]`. A law built at the node's own types is the law the operands have
/// (`lib/transforms/transpose/rules.cpp`, `ruleTakesOperands`), and its parameters are read for their
/// types, not for a shape this side would have to restate.
export rule sum_stated_t::<T, X, A>(t: X, at: A) when is_float::<T>() { sum_stated(t, at) => func (ct: T) {
    spread_over(ct, at)
} }

// ---- the transpose rules of the lane sum and of the whole-tensor mean ----
//
// Both are linear in their data, so each adjoint is the move the operation makes read backwards: a
// lane sum's spreads each lane's cotangent back over the lane it added up, and the mean's spreads a
// `numel(t)`-th of the cotangent over every element. The extents are the operand's shape, which is a
// value of the primal and not of the cotangent, so the forward halves state them
// (`lib/rulesets/jvp.cml#jvp_sum_axis`, `#jvp_mean`) and the two laws below read the list and
// nothing of the tensor.

/// The extents of a reduction's operand with an extent of one on the axis it reduced: the shape a
/// lane's cotangent is read at, so that `full(extents, 1.0) * ct` broadcasts over the axis the
/// reduction took instead of over the last one.
///
/// The axis arrives as the call wrote it and may be negative; it is brought into `0 .. rank-1` here
/// because a list is indexed by a position, which is a different reading from the reduction's own
/// (that one resolves the axis on entry, `lib/tensor/kernels/reduce.cpp#normalizeAxis`, and the
/// list this law receives is the resolved shape).
func lane_shape(extents: int[], axis: int) => int[] {
    let a = if axis < 0 then axis + len(extents) else axis
    return range(0, len(extents), 1)->map<func (i: int) => int {
        if i == a then 1 else extents[i]
    }>
}

/// `ct` spread back over `extents` along `axis`: the shape a lane's cotangent takes.
///
/// With `keepdims` the cotangent already has one extent per axis -- one of them is 1 -- so the
/// broadcast is the whole of it. Without the flag the reduced axis is gone from the cotangent, and
/// it is put back as an extent of one before the broadcast: `reshape` is what inserts it, and the
/// multiplication by `full(extents, 1.0)` is what repeats the lane's number over the lane. Both
/// steps copy and neither rounds, so the answer is the engine's `tensor:expand_axis` element for
/// element.
func lane_spread::<T>(
    ct: T[...],
    extents: int[],
    axis: int,
    keepdims: bool
) => T[...] {
    return if keepdims then full(extents, 1.0) * ct else full(extents, 1.0) * reshape<lane_shape(extents, axis)>(ct)
}

/// The cotangent of `sum_axis_stated(t, axis, keepdims, extents)`: each lane's `ct` spread back over
/// the lane it summed. The three stated values are the law's own parameters, so nothing here counts
/// positions in a list: `extents` is the shape, `axis` the lane and `keepdims` whether `ct` kept it.
export rule sum_axis_stated_t::<T, X, A, K, E>(t: X, axis: A, keepdims: K, extents: E)
    when is_float::<T>() { sum_axis_stated(t, axis, keepdims, extents) => func (ct: T[...]) {
    lane_spread(ct, extents, axis, keepdims)
} }

/// The cotangent of `mean_stated(t, extents)`: the one number it answers is the mean of every
/// element, so its adjoint gives a `numel(t)`-th of that number to every element of the extents.
///
/// The count is `extents`' product -- the same number the mean divided by -- and the division is one
/// operation per element over the spread, which is the engine's `(dy / count)` broadcast exactly:
/// the two orders divide the same values by the same count.
export rule mean_stated_t::<T, X, A>(t: X, extents: A) when is_float::<T>() { mean_stated(t, extents) => func (ct: T) {
    spread_over(ct, extents) / float(extent_product(extents))
} }

/// The cotangent of `max_axis_stated(t, mask, axis, keepdims, extents)`: the lane's cotangent, spread
/// back along the axis the extremum took, and kept only where `mask` says the operand holds the lane's
/// largest element.
///
/// The mask is the whole of an extremum's reverse rule. An extremum is not linear, so its adjoint is
/// not a spread of `ct` but a *selection*: every position that holds the lane's largest element gets
/// the whole `ct`, and one that does not gets nothing (`lib/tensor/ops/reduction_ops.cpp`'s
/// `extremumAxisVjp` answers exactly that, with `strict_eq` against the broadcast output). Two laws a
/// reader might write instead -- the first position only, or `ct` divided among the tied ones -- are
/// different numbers on a tie, which is what the case's reading says.
export rule max_axis_stated_t::<T, X, M, A, K, E>(
    t: X,
    mask: M,
    axis: A,
    keepdims: K,
    extents: E
)
    when is_float::<T>() { max_axis_stated(t, mask, axis, keepdims, extents) => func (ct: T[...]) {
    where(mask, lane_spread(ct, extents, axis, keepdims), 0.0)
} }

/// The cotangent of `min_axis_stated(t, mask, axis, keepdims, extents)`: `max_axis_stated_t`'s rule, on
/// the mask of the lane's smallest elements.
export rule min_axis_stated_t::<T, X, M, A, K, E>(
    t: X,
    mask: M,
    axis: A,
    keepdims: K,
    extents: E
)
    when is_float::<T>() { min_axis_stated(t, mask, axis, keepdims, extents) => func (ct: T[...]) {
    where(mask, lane_spread(ct, extents, axis, keepdims), 0.0)
} }

// ---- the transpose rule of `:op/idx_arr` ----
//
// `ct` goes back to position `i` and every other position is zero: the cotangent of `xs[i]` is that
// one element, written into an array of zeros shaped like `xs`. The write is `:tangent/scatter_add_arr`
// (`base, index, delta[, axis]`); its declaration below is **private to this ruleset** -- the library
// keeps no public name for it, because the only caller is the rule and a public name would be one more
// shape the registry has to hold in step for no other user.
//
// The operator takes three or four operands: `axis` is optional (lib/std/builtin/operators/derivative.cpp#scatterAddArrayVjp)
// and omitting it means the operand's last axis, which is the axis an index of this shape reads.

/// `x[i]`: what `:op/idx_arr` means, and the left side this rule is filed under.
/// @example index_into([1.0, 2.0, 3.0], 2)    // 3.0
func index_into::<T>(x: T[], i: int) => T {
    return x[i]
}

/// `xs` with `delta` added at position `i`: the write a transposed read needs. Private to this module.
#op(':tangent/scatter_add_arr')
func scatter_into::<T>(xs: T[], i: int, delta: T) => T[] panic

/// `n` zeros of the cotangent's own element type, in a rank-one array: the base a transposed read
/// scatters into.
///
/// The declared result is the point. `zeros` answers an array of **open rank** (the rank comes from
/// a runtime shape list) and the scatter below takes a rank-one array, so the two do not unify. A
/// body that declares `T[]` settles it once, where `[n]` is also legal -- a runtime list is not
/// something a rule's right side may hold.
///
/// The cotangent is the call's element-type witness: the rule's right side cannot write `zeros_of::<T>`
/// (a spelled type argument there is a function value to the copy), and passing
/// the cotangent binds `T` without reading any value of the array the cotangent comes back through.
func zeros_of::<T>(ct: T, n: int) => T[] when is_float::<T>() {
    return zeros::<T>([n])
}

/// The transpose of `tensor:pick_at(xs, position, length)`: `ct` at `position`, zero everywhere else,
/// where the zeros are `length` of them and that is the length the **forward** half stated.
///
/// This is the law the linear half of a read meets (`rulesets.jvp`'s `jvp_idx_arr` passes
/// `i, len(xs)`). It reads `position` and `length` and nothing of `xs`: a transpose rule reads only
/// known operands, and `T[]` carries no length in its type (design principles 5.4), so the length
/// arrives as an operand instead of being taken from the array the cotangent comes back through.
/// `len(xs)` is a value of the primal, which the cut carries to the half that reads it, so what a
/// call site hands over is the number itself.
export rule pick_at_t::<T, X, P, L>(xs: X, position: P, length: L) when is_float::<T>() { pick_at(xs, position, length) => func (ct: T) {
    scatter_into(zeros_of(ct, length), position, ct)
} }

/// The transpose of `xs[i]`: `ct` at `i`, zero everywhere else, in the extents the operand's **type**
/// states.
///
/// The length is not read off `xs`: a transposition is handed the cotangent and no forward value
/// (design principles 4.3), so the number of positions comes from `extent_of::<X>()` -- the walk
/// states the type's extents as an `int[]` and hands it over as the law's last port -- and `xs` is
/// named here only because the operator has it. `zeros_of` is the rank-one base the scatter writes
/// into, exactly as in `pick_at_t` above.
///
/// A type that states no extents (`float[...]`) reaches no law at all: the walk refuses the step by
/// name (`parameter-shape`) instead of inventing a length.
export rule idx_arr_t::<T, X, I, A>(xs: X, i: I, at: A) when is_float::<T>() { index_into(xs, i) => func (ct: T) {
    scatter_into(zeros_of(ct, extent_product(at)), i, ct)
} }

// ---- the transpose rule of `tensor:take` ----
//
// A take picks rows, so its adjoint puts each row's cotangent back where that row came from and
// sums where an index repeats -- `take(t, [1, 1])` reads one row twice, and its cotangent is the sum
// of the two. The write is `:tangent/scatter_take_arr(base, indices, delta[, axis])`
// (lib/std/builtin/operators/derivative.cpp): the core's scatter for a read along a named axis, whose
// own gradient is the take back along the same axis -- which is why it is the adjoint and not a
// second implementation of one.
//
// The engine's own route names `tensor:take_grad` for this (lib/tensor/ops/layout_ops.cpp
// #takeVjp), and a ruleset cannot: that operator is declared by the tensor module, and a second
// declaration of it is refused by name ("The declaration 'take_into' names the operator
// 'tensor:take_grad', which another module declares"). `:tangent/scatter_take_arr` is the core's,
// so it can be declared here, privately, like `scatter_into` above.

/// `take(t, indices)`'s adjoint: `dy` added back at the rows the indices name, along the first axis.
#op(':tangent/scatter_take_arr')
func scatter_rows::<T>(xs: T[...], indices: int[], delta: T[...], axis: int) => T[...] panic

/// `n` zeros of the cotangent's own element type, in the shape the forward half stated: the base a
/// transposed take scatters into.
///
/// The declared result is open rank on purpose and not a shortfall: the base is the operand's **whole**
/// shape, which is a runtime list, so `T[...]` is the only honest spelling -- and it is the rank
/// `scatter_rows` takes. The cotangent is written `T[...]` because this cotangent is an array (a
/// take answers rows), so the parameter is what binds `T` to an element; a spelled type argument in a
/// rule's right side is a function value to the copy.
func zeros_of_shape::<T>(ct: T[...], s: int[]) => T[...] when is_float::<T>() {
    return zeros::<T>(s)
}

/// The cotangent of `take_stated(t, indices, extents)`: `ct`'s rows added back where `indices` say
/// they came from, in an array of `extents`.
///
/// The law reads `indices` and `extents` and nothing of `t`, which is what it may do: a transpose
/// rule reads only known operands, and the row count a take forgets -- the indices say where its rows
/// go, not how many there were -- is a value of the primal. Each parameter says which array it is, so
/// nothing here counts positions in a list.
///
/// The axis is `0` because that is the axis `take` reads (`tensor:take` names its first dimension).
func take_cotangent::<T>(ct: T[...], indices: int[], extents: int[]) => T[...]
    when is_float::<T>() {
    let base = zeros_of_shape(ct, extents)
    return scatter_rows(base, indices, ct, 0)
}

/// The transpose of `take_stated(t, indices, extents)`: the two `int[]` parameters take no
/// cotangent, so the rule's right side answers one value, and the extents it spreads into are the
/// third parameter's. The head states the same per-position type parameters as `sum_stated_t`.
export rule take_stated_t::<T, X, I, E>(t: X, indices: I, extents: E) when is_float::<T>() { take_stated(t, indices, extents) => func (ct: T[...]) {
    take_cotangent(ct, indices, extents)
} }

// ---- the transpose of `mean` over an axis ----
//
// `mean<axis, keepdims>(xs)` is how a program writes `tensor:mean_axis` -- the whole reduction's
// name, with the axis and the flag in angle brackets (design principles 7.3) -- and the forward
// half's linear call is `mean_axis_stated`, whose operands state the axis, the flag and the extents
// as parameters of their own.
//
// The law: the lane's mean spreads its cotangent back over exactly the elements it averaged, so
// every position of `t` that fed lane `k` gets `ct[k] / lane length`. `numel(t) / numel(ct)` is the
// lane length -- the count the average divided by, read off the extents and the cotangent rather
// than written down -- and the extents are also the shape the broadcast needs, which is why they are
// stated at all: `ct` knows only the reduced shape.
//
// The rule's left side names two values and answers one: `at` is an `int[]` and has no tangent space
// (`camel/core/tangent_space.h`), so nothing is asked of it.

/// The cotangent of `mean_axis_stated(t, at)`: each lane's `ct` spread back over the lane it was
/// averaged from, where `at = [axis, keepdims, d0, ..., d(rank-1)]`.
///
/// The spread is `lane_spread`'s and not a bare `full(extents, 1.0) * ct`: a cotangent of the reduced
/// shape against the extents broadcasts by **trailing** alignment, which is the right answer only
/// when the reduced axis is the leading one. On `[2, 2]` along axis 1 the broadcast succeeds and
/// answers the column array -- `[0.0, 0.5]` down the columns where the row's `[0.5, 0.5]` belongs,
/// measured before this fix -- and on `[2, 3]` it stops with a dimension mismatch. `lane_spread` puts
/// the reduced axis back as an extent of one and *then* broadcasts, which is the array the engine's
/// `tensor:expand_axis` builds for any axis.
///
/// The lane length is `numel(t) / numel(ct)` -- the count the mean divided by -- read off the stated
/// extents and the cotangent; the division is one operation per lane, applied before the spread, so
/// the answer divides the same values by the same count as the engine's.
///
/// A rank-zero answer -- one axis with `keepdims = false` on a rank-one operand -- has a cotangent
/// with no shape, and the rule below states the cotangent as `T[...]` all the same, because that is
/// the type the answer has whether it is one number or a lane per number. What makes the one law
/// serve both is the compiler's: a value entering a position of `T[...]` from the element is
/// converted where it enters, once, for every position (`ArrayType::castSlotFrom` ->
/// `Array::createRankZero`; `camel/core/type/composite/array.h#isRankZeroEdge`), so `numel(ct)`
/// answers 1 for a rank-zero cotangent and the lane count for an array one -- `numel` of a scalar in a `float[...]` position answers 1 and its `shape` answers `[]`. The ports say `T[...]`, and a scalar entering `T[...]` is converted by the compiler at the one
/// place, the way `T` entering `T?` is wrapped. Stating `ct: T` here instead is not the repair: it would say one number
/// where the answer has a lane per number, and the law that reads a length would then be handed a
/// shape it cannot see.
func mean_axis_cotangent::<T>(
    ct: T[...],
    axis: int,
    keepdims: bool,
    extents: int[]
) => T[...]
    when is_float::<T>() {
    let lanes = float(extent_product(extents)) / float(numel(ct))
    return lane_spread(ct / lanes, extents, axis, keepdims)
}
/// The number of positions a shape holds: what a lane mean divided by.
func extent_product(extents: int[]) => int {
    return extents->reduce<func (acc: int, d: int) {
        acc * d
    }, 1>
}

/// The transpose of `mean_axis_stated(t, axis, keepdims, extents)`: the cotangent spread back over the
/// averaged lane, in the same per-position type parameters `sum_stated_t` states.
///
/// The cotangent is stated `T[...]`, the way its twin `sum_axis_stated_t` states it and the way the
/// answer is typed: `mean_axis_stated` is computed as `(t: T[...], axis: int, keepdims: bool,
/// extents: int[]) : T[...]`, and a rank-zero answer is one shape of that same type, not a different
/// type a law would have to state. See `mean_axis_cotangent` above for the conversion that makes the
/// one port serve both.
export rule mean_axis_stated_t::<T, X, A, K, E>(t: X, axis: A, keepdims: K, extents: E)
    when is_float::<T>() { mean_axis_stated(t, axis, keepdims, extents) => func (ct: T[...]) {
    mean_axis_cotangent(ct, axis, keepdims, extents)
} }

// ---- the transpose rules of the logarithm and of `pow` (`math:pow_d`) ----
//
// `pow(x, w)` is `math:pow_d`, and it is not `^`: `^` on two floats is `:op/pow_d`, a written token
// whose key the core derives, while `pow` (`lib/math/math.cml#pow`) reaches the same kernel through a
// declared function and its key is the name `pow_d` at two operands. `log(x)` is `math:log_d` the
// same way. Both are filed here by declaring the call their operators are, the way `mul_tensor` and
// `index_into` are (`rulesets.jvp` declares its own copies: a family cannot read another module's
// private function).
//
// The two keys are the ones a **pullback** would ask for, and they are *not* what `^`'s backward walk
// stops on. `pow`'s forward rule is `jvp_pow_d` (`lib/rulesets/jvp.cml`), which writes
// `w * x^(w-1) * dx + x^w * log(x) * dy` inline, so the `pow` and the `log` land in the **primal**
// half of a `split` and the linear half holds only products and sums over their results: for example
// `vjp(x => pow(x, 3.0))(2.0)` answers `12.0` through `rhs=add_t,mul_t`, with
// neither `math:pow_d` nor `math:log_d` in the walk at all. So these two laws answer for a walk no
// program reaches today. Whether they should exist at all is the same
// question `abs_t`/`log_t`/`maximum_t`/`minimum_t` were answered with ("no"); they are left here
// because sweeping this file's laws is outside this paragraph.
//
// The exponent's branch is `ct * x^w * ln(x)`: for `x <= 0` that is `NaN`, the same reading the
// forward rule gives the same operator. It is not written as a zero -- an undefined derivative says
// so -- and it is not guarded either: a guard would be a branch on a value of the cotangent, which
// the transposed walk cannot turn around.

// ---- the transpose rule of `sum_to` ----
//
// `sum_to(t, at)` reduces the leading axes to the extents `at` states, and it is linear in `t`, so
// its adjoint is the spread that undoes it: `broadcast_like(ct, t)` -- the cotangent given back to
// every position of `t`. That is the engine's rule read backwards
// (`lib/tensor/ops/gradient_ops.cpp#sumToVjp`: `tensor:broadcast_like` of the cotangent, at
// `t`'s own value), and the two operators are the pair this file's broadcast laws already use the
// same way (`add_tensor_t`, `mul_tensor_t`: the reduction names extents, the spread names the value
// whose lanes are wanted).
//
// `t` is read as a **value**, and that is why the law can exist at all: `sum_to`'s first operand is
// in the primal, so the walk is handed it, and `broadcast_like`'s second operand is the donor whose
// shape the answer takes -- no extent is reconstructed and no list is read off a tangent.
//
// The extents operand is an `int[]` and takes no cotangent, so the law answers one value.
export rule sum_to_t::<T>(t: T[...], at: int[]) when is_float::<T>() { sum_to(t, at) => func (ct: T[...]) {
    broadcast_like(ct, t)
} }

// ---- the laws for a reduction whose extents are in its **type** ----
//
// The three laws above are for the *stated* call the linear half writes (`sum_stated(t, at)`): a cut
// carries the extents to the half that reads them, so `at` is a value of the primal, handed along
// with the cotangent. A **value graph** has no such cut. `transpose` walks `sum(mean<0, false>(x) *
// w)` as it is written, the extents of `x` were never a value in it, and until these laws
// existed the walk answered `skip=rule uri=tensor:sum reason=unbound`: the key has a law, and the
// law was written for a call the program did not make.
//
// What the walk has is the **type**, so these laws name one port more than their operator has and
// that port is `extent_of::<X>()` -- the extents the operand's type states, materialized as an
// `int[]` where the step is met (`lib/transforms/rule_expand.cpp#statedExtentsValue`). The
// argument is offered *after* the operands' own types, so a law that does not name it answers
// exactly as before, and only a step the family above left unanswered can reach these.
//
// The operand's own port stays in the head -- it is what fixes the instance -- and the right side
// does not read it: an array that stands in for the value would make the length a fact of the
// program's run rather than of its type, and an element of it could be read by mistake.

/// The cotangent of `sum(t)`: the one number spread over the extents `at` states.
export rule sum_from_type_t::<T, X, A>(t: X, at: A) when is_float::<T>() { sum(t) => func (ct: T) {
    spread_over(ct, at)
} }

/// The cotangent of `take(t, indices)` where the row count is the type's: the indices say where each
/// row's cotangent goes, `at` says how many rows there are, and no value of `t` is read.
func take_cotangent_from_type::<T>(
    ct: T[...],
    indices: int[],
    at: int[]
) => T[...]
    when is_float::<T>() {
    let base = zeros_of_shape(ct, at)
    return scatter_rows(base, indices, ct, 0)
}

/// The transpose of `take(t, indices)`: the indices are an `int[]` and take no cotangent, so the
/// right side answers one value, and the extents it scatters into are the operand's own.
export rule take_from_type_t::<T, X, I, A>(t: X, indices: I, at: A) when is_float::<T>() { take(t, indices) => func (ct: T[...]) {
    take_cotangent_from_type(ct, indices, at)
} }

/// The cotangent of `mean<axis, keepdims>(t)`: each lane's `ct` spread back over the lane it was
/// averaged from, where `at` is the extents of `t`.
///
/// The lane length is the same count `mean_axis_cotangent` takes: `numel(t) / numel(ct)`. It is read
/// off the extents and the cotangent rather than written down, and `keepdims` needs no reading at
/// all -- `numel(ct)` already says whether the reduced axis is still there.
func mean_axis_cotangent_from_type::<T>(ct: T[...], at: int[]) => T[...]
    when is_float::<T>() {
    let lanes = float(extent_product(at)) / float(numel(ct))
    return full(at, 1.0) * (ct / lanes)
}

/// The transpose of `mean<axis, keepdims>(t)`, with the extents taken from the operand's type.
export rule mean_axis_from_type_t::<T, X, A, B, C>(t: X, axis: A, keepdims: B, at: C)
    when is_float::<T>() { mean<axis, keepdims>(t) => func (ct: float[...]) {
    mean_axis_cotangent_from_type(ct, at)
} }


/// `pow(x, w)`: what `math:pow_d` means, and the left side this rule is filed under.
/// @example pow_d(2.0, 3.0)    // 8.0
func pow_d(x: float, y: float) => float {
    return pow(x, y)
}

/// The transpose of `pow(x, w)`: `ct * w * x^(w-1)` for the base, `ct * x^w * ln(x)` for the exponent.
/// Its numbers are pinned by `pow_gradient_through_the_library.cml`.
export rule pow_d_t(x: float, y: float) { pow_d(x, y) => func (ct: float) {
    (ct * y * pow(x, y - 1.0), ct * pow(x, y) * math_log(x))
} }

// ---- the transpose rule of `^` (`:op/pow_d`, `:op/pow_f`) ----
//
// `x ^ w` is a **written token**, so its key is derived rather than filed under a call, and the
// section above is about the other spelling of the same kernel (`math:pow_d`, reached through a
// declared function). The two are one arithmetic and two keys; `jvp.cml` answers both forward
// (`jvp_pow`, `jvp_pow_d`) and only the second one had its reverse half, which is why the parity
// check listed `^@2` as a key the library answered in one direction.
//
// The engine's rule for this operator is not the same rule as the array one and it is narrower:
// `lib/std/builtin/operators/derivative.cpp#powVjp` refuses a non-constant exponent by name
// ("Derivative of ':op/pow_d' requires a constant exponent") and answers the base's cotangent
// only -- `dy * (n * a ^ (n - 1))`. The grouping is that one: the slope `w * x ^ (w - 1)` is
// built first and the cotangent multiplies it, which is the same product `pow_d_t` writes above
// and is not the same register as `ct * w * x ^ (w - 1)`.
//
// The exponent's cotangent is answered here and refused by the engine. That is the direction this
// lane works in -- the library is the half that stays -- and the term is `pow_d_t`'s, the same
// `ct * x ^ w * ln(x)` that law has answered since it landed, NaN for `x <= 0` and not a guarded
// zero. A program whose exponent is a constant has no tangent there, so the forward half never
// builds the term and the number the two legs answer is the base's alone: the wider law is not a
// different number on the programs both legs can run.
export rule pow_t::<T>(x: T, w: T) when is_float::<T>() { x ^ w => func (ct: T) {
    (ct * (w * pow(x, w - T(1))), ct * pow(x, w) * math_log(x))
} }

/// `log(x)`: what `math:log_d` means, and the left side this rule is filed under.
/// @example log_d(1.0)    // 0.0
func log_d(x: float) => float {
    return math_log(x)
}

/// The transpose of `log(x)`: `ct / x`, which is the whole law -- the derivative of the logarithm is
/// `1 / x` wherever the logarithm has a real value.
export rule log_d_t(x: float) { log_d(x) => func (ct: float) {
    ct / x
} }

// ---- the transposes of the scalar math kernels ----
//
// The backward half of the five forward laws at the end of `lib/rulesets/jvp.cml` (`sqrt_d`,
// `erf_d`, `erfc_d`, `erf_f`, `erfc_f`). Each is the engine's own rule read backwards, in the
// engine's grouping, for the reason the array laws above record: the two legs of one `grad` are
// compared bit for bit, and `(ct * k) * exp(...)` and `ct * (k * exp(...))` are the same number on
// paper and a different last place in the register.

/// `sqrt(x)` in the double width: what `math:sqrt_d` means, and the left side this rule is filed under.
/// @example sqrt_d(9.0)    // 3.0
func sqrt_d(x: float) => float {
    return math_sqrt(x)
}

/// The transpose of `sqrt(x)`: `(ct * 0.5) / sqrt(x)`, the grouping `sqrtVjp` builds and the array
/// law `sqrt_t` above uses -- the multiplication first, then the division.
export rule sqrt_d_t(x: float) { sqrt_d(x) => func (ct: float) {
    (ct * 0.5) / math_sqrt(x)
} }

/// `erf(x)` in the double width.
/// @example erf_d(0.0)    // 0.0
func erf_d(x: float) => float {
    return math_erf(x)
}

/// The transpose of `erf(x)`: `(ct * 2/sqrt(pi)) * exp(-(x * x))`.
export rule erf_d_t(x: float) { erf_d(x) => func (ct: float) {
    (ct * 1.1283791670955126) * math_exp((x * x) * -1.0)
} }

/// `erfc(x)` in the double width.
/// @example erfc_d(0.0)    // 1.0
func erfc_d(x: float) => float {
    return math_erfc(x)
}

/// The transpose of `erfc(x)`: the law above with the sign of the constant changed.
export rule erfc_d_t(x: float) { erfc_d(x) => func (ct: float) {
    (ct * -1.1283791670955126) * math_exp((x * x) * -1.0)
} }

/// `erf(x)` in the single width: what `math:erf_f` means.
func erf_f(x: f32) => f32 {
    return math_erf(x)
}

/// The transpose of `erf(x)` over `f32`, with the constant at that width.
export rule erf_f_t(x: f32) { erf_f(x) => func (ct: f32) {
    (ct * f32(1.1283791670955126)) * math_exp((x * x) * f32(-1.0))
} }

/// `erfc(x)` in the single width.
func erfc_f(x: f32) => f32 {
    return math_erfc(x)
}

/// The transpose of `erfc(x)` over `f32`.
export rule erfc_f_t(x: f32) { erfc_f(x) => func (ct: f32) {
    (ct * f32(-1.1283791670955126)) * math_exp((x * x) * f32(-1.0))
} }


// ---- the transpose rules of the second tranche ----
//
// The backward half of the eight laws whose forward halves are at the end of `lib/rulesets/jvp.cml`.
// Each is written against the engine's own rule, node for node where the engine's rule is a graph
// and token for token where it is a kernel, because the two legs of one `grad` are compared bit for
// bit. A law's right side may name a helper of this module (it is the answer, not a step the walk
// transposes); the *forward* half may not, and its comments say why.

/// The transpose of `erf`: `(ct * 2/sqrt(pi)) * exp(-x*x)`, which is `erfGrad`'s own grouping
/// (`lib/tensor/kernels/gradient.cpp#erfGradArm`: `pg * kScale * exp(-px*px)`).
///
/// The forward rule chains its two products in the order this is the reverse of
/// (`lib/rulesets/jvp.cml#jvp_erf`), so the cotangent reaches the exponential on the same side of
/// the constant as the engine's does. Written `ct * (kScale * exp(...))` instead -- the same number
/// on paper -- this law answers a different last place, which is what the case beside it measures.
export rule erf_t::<T>(x: T[...]) when is_float::<T>() { erf(x) => func (ct: T[...]) {
    (ct * 1.1283791670955126) * exp((x * x) * -1.0)
} }

/// The transpose of `erfc`: `erf`'s with the sign folded into the constant, which is where the
/// engine puts it (`erfcVjp` is `erf_grad(x, neg(dy))`). `(ct * -k) * e` and `((-ct) * k) * e` are
/// one value bit for bit, and the case beside this law reads the sign of every lane.
export rule erfc_t::<T>(x: T[...]) when is_float::<T>() { erfc(x) => func (ct: T[...]) {
    (ct * -1.1283791670955126) * exp((x * x) * -1.0)
} }

/// The transpose of `gelu`: `ct * gelu'(x)`, the slope recomputed from `x` alone -- the shape the
/// cut carries (`exp_t`, `tanh_t`) -- and written in the kernel's token order
/// (`lib/tensor/kernels/gradient.cpp#geluGradArm`, the f64 arm), with the tangent multiplied in
/// once at the end. It is the tanh form's slope and not the `Phi` form's, so a reader who knows
/// `gelu` from its `erf` definition still reads the number this tree computes.
export rule gelu_t::<T>(x: T[...]) when is_float::<T>() { gelu(x) => func (ct: T[...]) {
    ct * (0.5 * (1.0 + tanh(0.7978845608028654 * (x + 0.044715 * x * x * x))) + 0.5 * x * (1.0 - tanh(0.7978845608028654 * (x + 0.044715 * x * x * x)) * tanh(0.7978845608028654 * (x + 0.044715 * x * x * x))) * 0.7978845608028654 * (1.0 + 3.0 * 0.044715 * x * x))
} }

/// The transpose of `transpose`: the same swap again, because swapping the last two axes twice is
/// the identity. The engine's rule is the same node (`transposeVjp`,
/// `lib/tensor/ops/layout_ops.cpp`: `tensor:transpose` of the cotangent), and this law needs no
/// shape, no extent and no operand: it is the one member of the tranche whose backward half reads
/// nothing but its cotangent.
export rule transpose_t::<T>(x: T[...]) when is_float::<T>() { transpose(x) => func (ct: T[...]) {
    transpose(ct)
} }

// ---- permute ----
//
// `permute<perm>(x)` moves elements and combines none, so its adjoint is the **inverse**
// permutation -- which is the list written back only when that list is its own inverse (`[1, 0, 2]`
// is; `[2, 0, 1]` is not, and answering `perm` there would put every element in the wrong place
// while looking like a law). `perm` is the operator's second port, so the call's own `<>` value
// reaches this family as an ordinary value, the protocol `rulesets/jvp.cml#jvp_permute` states.

/// Where `value` sits in a permutation, or the length of the list when it is not there.
func permute_position(perm: int[], value: int) => int {
    let n = len(perm)
    let at = loop i = 0 while i < n && perm[i] != value do i + 1
    return at
}

/// The permutation that undoes `perm`: the axis each axis of the permuted array came from.
func permute_inverse(perm: int[...]) => int[] {
    let row = range(0, numel(perm), 1)->map<func (i: int) => int {
        perm[i]
    }>
    return range(0, len(row), 1)->map<func (i: int) => int {
        permute_position(row, i)
    }>
}

/// `permute<perm>(x)` transposed: the inverse permutation of the cotangent.
export func permute_cotangent::<T>(ct: T[...], perm: int[]) => T[...]
    when is_float::<T>() {
    return permute<permute_inverse(perm)>(ct)
}

/// The transpose of `permute<perm>`.
export rule permute_t::<T>(x: T[...], perm: int[]) when is_float::<T>() { permute<perm>(x) => func (ct: T[...]) {
    permute_cotangent(ct, perm)
} }

/// The transpose of `where`: each branch takes the cotangent where it was selected and zero
/// elsewhere, and the condition takes nothing -- a boolean is a choice, not a magnitude. The two
/// nodes are the engine's own pair (`whereVjp`, `lib/tensor/ops/elementwise_ops.cpp`: the same
/// `tensor:where` over the same condition and a static `0.0`), so this is not an equality of two
/// arithmetics but the same graph.
///
/// **The right side answers one component per port, in the order the left side writes them, and the
/// component asked for is the operand's position** -- `expandRuleRightSide` picks the tuple's
/// `position`-th component (`lib/transforms/rule_expand.cpp`, "Position `i` is that tuple's
/// i-th component"), where the position is a *port* of the node and not a count of the ports that
/// happen to answer. So this law writes three components and the condition's is the first: it is
/// never selected -- a `bool` has no tangent space, and the walk records it as the zero it is
/// (`noteZero`) before any law is asked -- but leaving it out shifts the two answers that matter one
/// place to the left. Measured, both ways: with **two** components the branch that was *not* taken
/// took the cotangent (`where` answered `[1.0, 0.0, 0.0, 1.0]` for a mask of `[F, T, T, F]`) and the
/// last port was refused with `position=2 reason=the rule's right side answers 2 name(s)`; with three
/// where the first is a constant (`false`) the count was still 2 -- a constant component is not a
/// `with` input of the tuple -- so the first component is written as the condition itself. Its slot
/// is a shape, not an answer: the walk never asks for it.
export rule where_t::<T>(c: bool[...], a: T[...], b: T[...]) when is_float::<T>() { where(c, a, b) => func (ct: T[...]) {
    (c, where(c, ct, 0.0), where(c, 0.0, ct))
} }

/// The transpose of `max`: the cotangent of the extremum goes to every position that holds it, and
/// the mask is the one the forward half builds (`xs >= max(xs)`, `lib/rulesets/jvp.cml#jvp_max`).
///
/// The engine spreads the same way (`extremumAllVjp`: `cast_like(strict_eq(x, broadcast(out)), dy)`
/// times `broadcast_like(dy)`, `lib/tensor/ops/reduction_ops.cpp`), which for a scalar cotangent
/// is `dy` at every selected position -- so a tie gives each tied position the whole cotangent on
/// both sides, and `where(..., ct, 0.0)` with a scalar `ct` is that spread. Nothing here reads
/// `xs`'s shape off the cotangent's operand: the mask's shape is `xs`'s own.
export rule max_t::<T>(xs: T[...]) when is_float::<T>() { max(xs) => func (ct: T) {
    where(xs >= max(xs), ct, 0.0)
} }

/// The transpose of `min`: `max`'s mirror, one comparison turned round, over the mask the forward
/// half builds (`lib/rulesets/jvp.cml#jvp_min`).
export rule min_t::<T>(xs: T[...]) when is_float::<T>() { min(xs) => func (ct: T) {
    where(xs <= min(xs), ct, 0.0)
} }

/// The transpose of `linear`: `ct @ wᵀ` for `x` and `xᵀ @ ct` for `w`, each reduced to the extents
/// of its own operand with `sum_to` -- the two answers `matmul_t` already gives for `matmul`
/// (`#ct_of_a`, `#ct_of_b`), one operator further out, and the pair the engine reaches through
/// `tensor:matmul_grad_lhs` / `_rhs` (`lib/tensor/ops/linalg_ops.cpp#linearVjp`).
///
/// Both operands are read here and both are read from the *known* side: `x` and `w` are a call's
/// parameters, which the cut carries, the same way `matmul_t` reads them. The extents are
/// `shape(x)` / `shape(w)`, the runtime shape of those values, not a type's.
/// The head takes three type parameters for the reason that law's does -- the walk hands a rule the
/// cotangent's element type and then each operand's own type.
export rule linear_t::<T, A, B>(x: A, w: B) when is_float::<T>() { linear(x, w) => func (ct: T[...]) {
    (sum_to(matmul(ct, transpose(w)), shape(x)), sum_to(matmul(transpose(x), ct), shape(w)))
} }

// ---- the transpose rules of the model operators (`nn`) ----
//
// The four `nn` operators whose forward halves are in `lib/rulesets/jvp.cml`
// (`jvp_conv2d`, `jvp_max_pool2d`, `jvp_avg_pool2d`, `jvp_embedding`) and whose reverse halves were
// missing. They are one class and they were missing for one reason: each of these four answers its
// cotangent with **the model module's own gradient operator** -- there is no arithmetic to write --
// and the module, not the ruleset, is where those gradients live. So the laws are one call each and
// the import at the head of this file is the whole of them.
//
// Each is the engine's own rule with the same operands in the same order
// (`src/stdlib/nn/tensor_ops.cpp`): `conv2dVjp` builds `nn:conv2d_input_grad`,
// `nn:conv2d_kernel_grad` and `nn:conv2d_bias_grad`; `pool2dVjp` builds `<pool>_grad(input, dy,
// kernel)`; `embeddingVjp` builds `nn:embedding_table_grad(table, indices, dy)`. Naming one
// operator per answer is the only shape that keeps the two legs bit-identical: a law that
// recomputed a window's selection or a table's scatter would be a second implementation of the
// kernel, and the kernels are where the padding, the ties and the repeated indices are decided.
//
// Neither pooling law is reached today, and the two stops are measured (`--trace transforms`,
// `expect_exit = 0`) rather than assumed. A `max_pool2d` gradient stops one law before
// `max_pool2d_t` is asked, at the `avg_pool2d` that `jvp_max_pool2d` writes in its linear half:
//
//     TRANSPOSE ... skip=law-reads-a-value uri=nn:avg_pool2d position=0 operand-types=f32[...],int
//         reason=the rule's right side reads a value the caller does not carry
//
// The operand there is the **tangent**, and its type states no extents. An `avg_pool2d` gradient
// stops at the same law, the same position and the same reason with the extents still in the type
// (`operand-types=f32[1, 2, 4, 4],int`): `avg_pool2d_grad(x, ct, kernel)` reads `x` where the
// answer is the window's geometry alone, which is not an operator this module has. It is written
// with `avg_pool2d_grad` and not with `avg_pool2d` applied to the cotangent, for the reason above:
// the two agree at stride one and no padding, and the engine's rule is the one the two legs are
// compared against.
//
// The operand lists are the ones the forward halves write. `stride` and `padding` are not named: a
// call that passes either reaches no law and is refused by shape, which is the same limit the
// forward half has (`jvp_conv2d` records it: the tangent's extents have to be reduced, and the
// operator that would state them does not exist yet).

/// The cotangents of `conv2d(x, w, b)`: one per operand, from the kernel's own three gradients --
/// the **shaped** twins of them, which derive the answered operand's extents from the operands the
/// gradient does read where the plain ones read the tensor.
///
/// The plain spelling reads a value at the position it answers: `conv2d_input_grad(x, w, ct)` reads
/// `w` and `conv2d_kernel_grad(x, w, ct)` reads `x`, and at the position the law answers that operand
/// is the tangent the caller hands over (`stdlib/rulesets/jvp.cml#jvp_conv2d` writes the tangent
/// convolution with the primal in the other two places, and the answered place holds the tangent).
/// Nobody holds its value, so the walk refuses the plain law with `law-reads-a-value`, and no
/// spelling of `shape` of it helps: a tangent states no extents (design principles 5.4), so the
/// extended `shape(x)` is not a value a transposed half holds either.
///
/// What the transposed half *does* hold is the other two operands, and they are enough: a
/// convolution's output shape is `OH = (H + 2 * padding - KH) / stride + 1`, so `H` is
/// `(OH - 1) * stride + KH - 2 * padding`, and the kernel's window follows from the input and `dy`
/// the same way. The shaped twins read exactly that (`src/stdlib/tensor/kernels/conv.cpp
/// #conv2dInputGradShaped`), and the gradients themselves never read the values of the operand they
/// are the gradient of -- `col2im` writes every element of `dx` from the geometry and `dw` is
/// accumulated from zero -- so the numbers cannot move: each component calls the same kernel the
/// plain operator calls.
///
/// The bias needs no inversion: `conv2dBiasGrad` reads `dy` alone and answers `[O]`.
export rule conv2d_t::<T, X, Y, Z>(x: X, w: Y, b: Z) when is_float::<T>() { conv2d(x, w, b) => func (ct: T[...]) {
    (
        conv2d_input_grad_shaped(w, ct),
        conv2d_kernel_grad_shaped(x, ct),
        conv2d_bias_grad_shaped(ct)
    )
} }

/// The cotangent of `max_pool2d(x, kernel)`: the kernel's gradient, which gives each window's
/// cotangent to the position the window chose -- the same convention the forward law's mask uses
/// (`jvp_max_pool2d`), so the two halves are adjoints of one map even on a window whose maximum is
/// tied. The kernel is an `int` and takes no cotangent, so the law answers one value.
export rule max_pool2d_t::<T>(x: T[...], kernel: int) when is_float::<T>() { max_pool2d(x, kernel) => func (ct: T[...]) {
    max_pool2d_grad(x, ct, kernel)
} }

/// The cotangent of `avg_pool2d(x, kernel)`: the kernel's gradient. A mean of a window is linear, so
/// this is also the adjoint of the `avg_pool2d` a forward law writes in its **linear** half
/// (`jvp_max_pool2d` does). No walk reaches it: it is refused at `position = 0` with
/// `skip=law-reads-a-value` and `reason=the rule's right side reads a value the caller does not
/// carry`, because `avg_pool2d_grad(x, ct, kernel)` reads `x` and a transposed half is handed the
/// cotangent and nothing else.
export rule avg_pool2d_t::<T>(x: T[...], kernel: int) when is_float::<T>() { avg_pool2d(x, kernel) => func (ct: T[...]) {
    avg_pool2d_grad(x, ct, kernel)
} }

/// The cotangent of `embedding(table, indices)`: the table's rows added back where the indices
/// gathered them, unvisited rows zero. The indices are a discrete operand with no tangent space,
/// so the law answers one value -- the head names the `int[]` the forward law names, and that is
/// the shape both halves are filed at.
export rule embedding_t::<T>(table: T[...], indices: int[]) when is_float::<T>() { embedding(table, indices) => func (ct: T[...]) {
    embedding_table_grad(table, indices, ct)
} }
