/** The rule declarations the formatter writes on one line each (rewrite design 2). */
export rule mul_one(x: int) { x * 1 => x }
rule add_swap(a: int, b: int) { a + b <=> b + a }
rule combine(x: int, const c1: int, const c2: int) when true { x * c1 + x * c2 => x * (c1 + c2) }

func main(): int sync {
    return 0
}
