digraph GraphIR {
    graph [rankdir=LR, fontsize=18];
    node [fixedsize=true, width=1, height=1, fontsize=18];
    edge [minlen=2];
    subgraph cluster_F01 {
        label="main";
        tooltip="() => i64";
        O01 [label="EXIT", style=dashed, shape=circle];
        N00 [label="DATA", shape=circle, style=solid, tooltip="DATA\nmain::node#-1"];
        N01 [label="DATA", shape=circle, style=solid, tooltip="DATA\nmain::node#-2"];
        N02 [label=":op/\nadd_l", shape=diamond, style=solid, tooltip=":op/add_l\nmain::node#1"];
        N03 [label=":io/p\nrintln", shape=diamond, style=solid, tooltip=":io/println\nmain::node#2"];
        N04 [label="GATE", shape=diamond, style=dashed, tooltip="GATE\nmain::node#3"];
        N04 -> O01 [label="0", style=solid];
        N00 -> N02 [label="0|0"];
        N01 -> N02 [label="0|1"];
        N02 -> N03 [label="0|0"];
        N02 -> N04 [label="1|0"];
        N03 -> N04 [label="0|0", style=dashed, arrowhead=empty];
    }
    O00 [label="EXIT", style=dashed, shape=circle];
    N05 [label="DATA", shape=circle, style=solid, tooltip="DATA\n__root__::node#-1"];
    N06 [label="CALL", shape=diamond, style=solid, tooltip="CALL\n__root__::node#1"];
    N06 -> O00 [label="0", style=solid];
    N05 -> N06 [label="0|0", style=dashed];
}
