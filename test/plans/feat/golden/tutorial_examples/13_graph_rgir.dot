digraph GraphIR {
    graph [rankdir=LR, fontsize=18];
    node [fixedsize=true, width=1, height=1, fontsize=18];
    edge [minlen=2];
    subgraph cluster_F01 {
        label="main";
        tooltip="() => int uses stdout";
        subgraph cluster_F02 {
            label="add";
            tooltip="(a: int, b: int) => int pure";
            F02 [label="ARGS", type="ARGS", style=dashed, shape=circle];
            O02 [label="EXIT", type="EXIT", style=dashed, shape=circle];
            N00 [label="a", type="PORT", param_name="a", param_kind="normal", param_index="0", value_type="int", origin=<ORIGIN>, span="3:9-3:15", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", shape=circle, style=solid, tooltip="a\nadd::node#1"];
            N01 [label="b", type="PORT", param_name="b", param_kind="normal", param_index="1", value_type="int", origin=<ORIGIN>, span="3:17-3:23", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", shape=circle, style=solid, tooltip="b\nadd::node#2"];
            N02 [label=":op/\nadd_l", type="OPER", shape=diamond, style=solid, value_type="int", origin=<ORIGIN>, span="4:13-4:14", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip=":op/add_l\nadd::node#3"];
            F02 -> N00 [label="0", type="NORM_PORT", style=solid];
            F02 -> N01 [label="1", type="NORM_PORT", style=solid];
            N02 -> O02 [label="0", type="EXIT", style=solid];
            N00 -> N02 [label="0|0", type="NORM"];
            N01 -> N02 [label="0|1", type="NORM"];
        }
        O01 [label="EXIT", type="EXIT", style=dashed, shape=circle];
        N03 [label="1", type="DATA", shape=circle, style=solid, value_type="int", origin=<ORIGIN>, span="8:16-8:17", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip="1\nmain::node#-1"];
        N04 [label="2", type="DATA", shape=circle, style=solid, value_type="int", origin=<ORIGIN>, span="8:19-8:20", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip="2\nmain::node#-2"];
        N05 [label="add", type="FUNC", shape=Mdiamond, style=solid, width=1.1, height=1.1, value_type="int", origin=<ORIGIN>, span="8:12-8:21", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip="add\nmain::node#1"];
        N06 [label=":io/p\nrintln", type="OPER", shape=diamond, style=solid, value_type="int", origin=<ORIGIN>, span="9:4-9:11", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip=":io/println\nmain::node#2"];
        N07 [label="0", type="DATA", shape=circle, style=solid, value_type="int", origin=<ORIGIN>, span="10:11-10:12", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip="0\nmain::node#-3"];
        N08 [label="GATE", type="GATE", shape=diamond, style=dashed, value_type="int", tooltip="GATE\nmain::node#-3"];
        N08 -> O01 [label="0", type="EXIT", style=solid];
        N03 -> N05 [label="0|0", type="NORM"];
        N04 -> N05 [label="0|1", type="NORM"];
        N05 -> N06 [label="0|0", type="NORM"];
        N07 -> N08 [label="0|0", type="NORM"];
        N06 -> N08 [label="0|0", type="CTRL", style=dashed, arrowhead=empty];
        N06 -> N08 [label="SYNC", type="SYNC", style=solid, arrowhead=diamond];
    }
    O00 [label="EXIT", type="EXIT", style=dashed, shape=circle];
    N09 [label="Functio\nn(gr...", type="DATA", shape=circle, style=solid, value_type="() => int uses stdout", origin=<ORIGIN>, span="7:0-11:1", srcfile="<ROOT>/docs/tutorial/examples/13_graph.cml", tooltip="Function(graph=main, tupleSlots=0)\n__root__::node#-1"];
    N0A [label="CALL", type="CALL", shape=diamond, style=solid, value_type="int", tooltip="CALL\n__root__::node#1"];
    N0A -> O00 [label="0", type="EXIT", style=solid];
    N09 -> N0A [label="0|0", type="WITH", style=dashed];
