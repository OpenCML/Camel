// A generic function whose signature is still wider than the wrap width (80) after the `when`
// clause has moved to its own line: the parameters go one per line as well, and the result type
// follows the closing parenthesis.
func combine_all::<T>(
    first: T[..],
    second: T[..],
    third: T[..],
    scale: T
): T[..]
    when is_numeric::<T>() {
    return first + second + third
}

// A head that fits keeps the clauses on the signature's line.
func add::<T>(a: T, b: T): T when is_numeric::<T>() {
    return a + b
}
