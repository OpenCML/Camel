module subscript_format

func part(xs: int[], a: int, b: int): int[] {
    return xs[a:b]
}

func until(xs: int[], b: int): int[] {
    return xs[:b]
}

func whole(xs: int[]): int[] {
    return xs[:]
}

func stepped(xs: int[], a: int): int[] {
    return xs[a:4:1]
}

func reversed(xs: int[]): int[] {
    return xs[::-1]
}

func everyOther(xs: int[]): int[] {
    return xs[::2]
}

func after(xs: int[], start: int): int[] {
    return xs[start:]
}

func window(xs: int[], a: int, b: int, step: int): int[] {
    return xs[a:b:step]
}

func rows(xs: int[], idx: int[]): int[] {
    return xs[idx]
}
