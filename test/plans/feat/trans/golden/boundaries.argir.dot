            N0B [label=":op/\nmul_d", type="OPER", shape=diamond, style=solid, value_type="float", origin=204, span="12:53-12:54", srcfile="<ROOT>/test/cases/trans/annotated/boundaries.cml", tooltip=":op/mul_d\ngate::node#7"];
