    }
    O00 [label="EXIT", type="EXIT", style=dashed, shape=circle];
    N18 [label="Functio\nn(gr...", type="DATA", shape=circle, style=solid, value_type="() => int", origin=206, span="15:0-19:1", srcfile="<ROOT>/test/cases/trans/annotated/boundaries.cml", tooltip="Function(graph=main, tupleSlots=0)\n__root__::node#-1"];
    N19 [label="CALL", type="CALL", shape=diamond, style=solid, value_type="int", tooltip="CALL\n__root__::node#1"];
    N19 -> O00 [label="0", type="EXIT", style=solid];
    N18 -> N19 [label="0|0", type="WITH", style=dashed];
    subgraph cluster_legend {
        label="roles";
        "legend_scalar-boundary" [label="scalar boundary (tensor <-> host number)", type="LEGEND", role="scalar-boundary", shape=box, fixedsize=false, style=filled, fillcolor="#fff2cc"];
        "legend_branch-contract" [label="branch contract (arms agree on the result type)", type="LEGEND", role="branch-contract", shape=box, fixedsize=false, style=filled, fillcolor="#d9d2e9"];
        "legend_export-capability" [label="export capability (no ONNX lowering)", type="LEGEND", role="export-capability", shape=box, fixedsize=false, style=filled, fillcolor="#cfe2f3"];
        "legend_effect" [label="effect (ordered, never folded or removed)", type="LEGEND", role="effect", shape=box, fixedsize=false, style=filled, fillcolor="#f4cccc"];
