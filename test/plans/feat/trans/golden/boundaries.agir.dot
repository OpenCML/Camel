digraph GraphIR {
    graph [rankdir=LR, fontsize=18];
    node [fixedsize=true, width=1, height=1, fontsize=18];
    edge [minlen=2];
    subgraph cluster_F01 {
        label="main";
        tooltip="() => i64";
        subgraph cluster_F02 {
            label="gate";
            tooltip="(t: Tensor) => Tensor";
            subgraph cluster_F03 {
                label="__g_4__";
                tooltip="() => Tensor";
                F03 [label="ARGS", type="ARGS", style=dashed, shape=circle];
                O03 [label="EXIT", type="EXIT", style=dashed, shape=circle];
                N00 [label="PORT", type="PORT", shape=circle, style=solid, tooltip="PORT\n__g_4__::node#1"];
                N01 [label="tenso\nr:relu", type="OPER", shape=diamond, style=solid, tooltip="tensor:relu\n__g_4__::node#2"];
                F03 -> N00 [label="0", type="WITH_PORT", style=dashed, arrowhead=empty];
                N01 -> O03 [label="0", type="EXIT", style=solid];
                N00 -> N01 [label="0|0", type="NORM"];
            }
            subgraph cluster_F04 {
                label="__g_6__";
                tooltip="() => Tensor";
                F04 [label="ARGS", type="ARGS", style=dashed, shape=circle];
                O04 [label="EXIT", type="EXIT", style=dashed, shape=circle];
                N02 [label="PORT", type="PORT", shape=circle, style=solid, tooltip="PORT\n__g_6__::node#1"];
                N03 [label="1", type="DATA", shape=circle, style=solid, tooltip="1\n__g_6__::node#-1"];
                N04 [label="tenso\nr:idx", type="OPER", shape=diamond, style="filled,solid", fillcolor="#fff2cc", role="scalar-boundary", tooltip="tensor:idx\n__g_6__::node#2\nrole scalar-boundary: tensor -> host f64"];
                N05 [label="2", type="DATA", shape=circle, style=solid, tooltip="2\n__g_6__::node#-2"];
                N06 [label=":op/\nmul_d", type="OPER", shape=diamond, style=solid, tooltip=":op/mul_d\n__g_6__::node#3"];
                N07 [label="tensor:\nmult...", type="OPER", shape=diamond, style="filled,solid", fillcolor="#fff2cc", role="scalar-boundary", tooltip="tensor:multiply\n__g_6__::node#4\nrole scalar-boundary: host f64 -> tensor"];
                F04 -> N02 [label="0", type="WITH_PORT", style=dashed, arrowhead=empty];
                N07 -> O04 [label="0", type="EXIT", style=solid];
                N02 -> N04 [label="0|0", type="NORM"];
                N03 -> N04 [label="0|1", type="NORM"];
                N04 -> N06 [label="0|0", type="NORM"];
                N05 -> N06 [label="0|1", type="NORM"];
                N02 -> N07 [label="1|0", type="NORM"];
                N06 -> N07 [label="0|1", type="NORM"];
            }
            F02 [label="ARGS", type="ARGS", style=dashed, shape=circle];
            O02 [label="EXIT", type="EXIT", style=dashed, shape=circle];
            N08 [label="t", type="PORT", shape=circle, style=solid, tooltip="t\ngate::node#1"];
            N09 [label="0", type="DATA", shape=circle, style=solid, tooltip="0\ngate::node#-1"];
            N0A [label="tenso\nr:idx", type="OPER", shape=diamond, style="filled,solid", fillcolor="#fff2cc", role="scalar-boundary", tooltip="tensor:idx\ngate::node#2\nrole scalar-boundary: tensor -> host f64"];
            N0B [label="0.5", type="DATA", shape=circle, style=solid, tooltip="0.5\ngate::node#-2"];
            N0C [label=":op/\ngt_d", type="OPER", shape=diamond, style=solid, tooltip=":op/gt_d\ngate::node#3"];
            N0D [label="JOIN", type="JOIN", shape=diamond, style="filled,solid", fillcolor="#d9d2e9", role="branch-contract", tooltip="JOIN\ngate::node#7\nrole branch-contract: arms: Tensor"];
            N0E [label="BRCH", type="BRCH", shape=diamond, style=solid, tooltip="BRCH\ngate::node#4"];
            N0F [label="__g_4__", type="FUNC", shape=Mdiamond, style=solid, width=1.1, height=1.1, tooltip="__g_4__\ngate::node#5"];
            N10 [label="__g_6__", type="FUNC", shape=Mdiamond, style=solid, width=1.1, height=1.1, tooltip="__g_6__\ngate::node#6"];
            F02 -> N08 [label="0", type="NORM_PORT", style=solid];
            N0D -> O02 [label="0", type="EXIT", style=solid];
            N08 -> N0A [label="0|0", type="NORM"];
            N09 -> N0A [label="0|1", type="NORM"];
            N0A -> N0C [label="0|0", type="NORM"];
            N0B -> N0C [label="0|1", type="NORM"];
            N0F -> N0D [label="0|0", type="WITH", style=dashed];
            N10 -> N0D [label="0|1", type="WITH", style=dashed];
            N0E -> N0D [label="0|0", type="NORM"];
            N0C -> N0E [label="0|0", type="NORM"];
            N08 -> N0E [label="0|0", type="CTRL", style=dashed, arrowhead=empty];
            N08 -> N0F [label="0|0", type="WITH", style=dashed];
            N0E -> N0F [label="0|0", type="CTRL", style=dashed, arrowhead=empty];
            N08 -> N10 [label="1|0", type="WITH", style=dashed];
            N0E -> N10 [label="1|0", type="CTRL", style=dashed, arrowhead=empty];
        }
        O01 [label="EXIT", type="EXIT", style=dashed, shape=circle];
        N11 [label="[1, -2,\n 3, ...", type="DATA", shape=circle, style=solid, tooltip="[1, -2, 3, 0.5]\nmain::node#-1"];
        N12 [label="[4]", type="DATA", shape=circle, style=solid, tooltip="[4]\nmain::node#-2"];
        N13 [label="tensor:\nreshape", type="OPER", shape=diamond, style=solid, tooltip="tensor:reshape\nmain::node#1"];
        N14 [label="gate", type="FUNC", shape=Mdiamond, style=solid, width=1.1, height=1.1, tooltip="gate\nmain::node#2"];
        N15 [label="0", type="DATA", shape=circle, style=solid, tooltip="0\nmain::node#-3"];
        N16 [label="tenso\nr:idx", type="OPER", shape=diamond, style="filled,solid", fillcolor="#fff2cc", role="scalar-boundary", tooltip="tensor:idx\nmain::node#3\nrole scalar-boundary: tensor -> host f64"];
        N17 [label="gate={}", type="DATA", shape=circle, style=solid, tooltip="gate={}\nmain::node#-4"];
        N18 [label=":str/\nformat", type="OPER", shape=diamond, style="filled,solid", fillcolor="#cfe2f3", role="export-capability", tooltip=":str/format\nmain::node#4\nrole export-capability: ':str/format' has no ONNX lowering at opset 17"];
        N19 [label=":io/p\nrintln", type="OPER", shape=diamond, style="filled,solid", fillcolor="#f4cccc", role="effect;export-capability", tooltip=":io/println\nmain::node#5\nrole effect: :io/println\nrole export-capability: ':io/println' has no ONNX lowering at opset 17"];
        N1A [label="0", type="DATA", shape=circle, style=solid, tooltip="0\nmain::node#-5"];
        N1B [label="GATE", type="GATE", shape=diamond, style=dashed, tooltip="GATE\nmain::node#-5"];
        N1B -> O01 [label="0", type="EXIT", style=solid];
        N11 -> N13 [label="0|0", type="NORM"];
        N12 -> N13 [label="0|1", type="NORM"];
        N13 -> N14 [label="0|0", type="NORM"];
        N14 -> N16 [label="0|0", type="NORM"];
        N15 -> N16 [label="0|1", type="NORM"];
        N16 -> N18 [label="0|0", type="WITH", style=dashed];
        N17 -> N18 [label="0|0", type="NORM"];
        N18 -> N19 [label="0|0", type="NORM"];
        N1A -> N1B [label="0|0", type="NORM"];
        N19 -> N1B [label="0|0", type="CTRL", style=dashed, arrowhead=empty];
    }
    O00 [label="EXIT", type="EXIT", style=dashed, shape=circle];
    N1C [label="Functio\nn(gr...", type="DATA", shape=circle, style=solid, tooltip="Function(graph=main, tupleSlots=0)\n__root__::node#-1"];
    N1D [label="CALL", type="CALL", shape=diamond, style=solid, tooltip="CALL\n__root__::node#1"];
    N1D -> O00 [label="0", type="EXIT", style=solid];
    N1C -> N1D [label="0|0", type="WITH", style=dashed];
    subgraph cluster_legend {
        label="roles";
        "legend_scalar-boundary" [label="scalar boundary (tensor <-> host number)", type="LEGEND", role="scalar-boundary", shape=box, fixedsize=false, style=filled, fillcolor="#fff2cc"];
        "legend_branch-contract" [label="branch contract (arms agree on the result type)", type="LEGEND", role="branch-contract", shape=box, fixedsize=false, style=filled, fillcolor="#d9d2e9"];
        "legend_export-capability" [label="export capability (no ONNX lowering)", type="LEGEND", role="export-capability", shape=box, fixedsize=false, style=filled, fillcolor="#cfe2f3"];
        "legend_effect" [label="effect (ordered, never folded or removed)", type="LEGEND", role="effect", shape=box, fixedsize=false, style=filled, fillcolor="#f4cccc"];
    }
}
