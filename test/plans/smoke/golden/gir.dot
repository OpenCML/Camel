        N12 -> N13 [label="0|0"];
        N13 -> N14 [label="0|0", style=dashed, arrowhead=empty];
        N10 -> N15 [label="0|0"];
        N14 -> N15 [label="0|0", style=dashed, arrowhead=empty];
        N15 -> N16 [label="0|0", style=dashed, arrowhead=empty];
        N16 -> N17 [label="0|0"];
        N14 -> N17 [label="0|1"];
        N10 -> N19 [label="1|0", style=dashed];
