            N0D -> N0E [label="0|0", style=dashed, arrowhead=empty];
            N09 -> N0F [label="1|0", style=dashed];
            N0D -> N0F [label="1|0", style=dashed, arrowhead=empty];
        }
        O01 [label="EXIT", style=dashed, shape=circle];
        N10 [label="10", shape=circle, style=solid, tooltip="10\nmain::node#-1"];
