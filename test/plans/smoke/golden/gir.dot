            subgraph cluster_F03 {
                label="__g_4__";
                tooltip="() => i64";
                F03 [label="ARGS", style=dashed, shape=circle];
                O03 [label="EXIT", style=dashed, shape=circle];
                N00 [label="PORT", shape=circle, style=solid, tooltip="PORT\n__g_4__::node#1"];
                F03 -> N00 [label="0", style=dashed, arrowhead=empty];
                N00 -> O03 [label="0", style=solid];
            }
            subgraph cluster_F04 {
                label="__g_6__";
                tooltip="() => i64";
