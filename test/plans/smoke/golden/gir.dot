                N08 [label=":op/\nadd_l", shape=diamond, style=solid, tooltip=":op/add_l\n__g_6__::node#6"];
                F04 -> N01 [label="0", style=dashed, arrowhead=empty];
                N08 -> O04 [label="0", style=solid];
                N01 -> N03 [label="0|0"];
                N02 -> N03 [label="0|1"];
                N03 -> N04 [label="0|0"];
                N01 -> N06 [label="1|0"];
                N05 -> N06 [label="0|1"];
                N06 -> N07 [label="0|0"];
                N04 -> N08 [label="0|0"];
                N07 -> N08 [label="0|1"];
            }
            F02 [label="ARGS", style=dashed, shape=circle];
            O02 [label="EXIT", style=dashed, shape=circle];
            N09 [label="n", shape=circle, style=solid, tooltip="n\nfib::node#1"];
            N0A [label="1", shape=circle, style=solid, tooltip="1\nfib::node#-1"];
            N0B [label=":op/\nle_l", shape=diamond, style=solid, tooltip=":op/le_l\nfib::node#2"];
            N0C [label="JOIN", shape=diamond, style=solid, tooltip="JOIN\nfib::node#6"];
            N0D [label="BRCH", shape=diamond, style=solid, tooltip="BRCH\nfib::node#3"];
            N0E [label="__g_4__", shape=Mdiamond, style=solid, width=1.1, height=1.1, tooltip="__g_4__\nfib::node#4"];
            N0F [label="__g_6__", shape=Mdiamond, style=solid, width=1.1, height=1.1, tooltip="__g_6__\nfib::node#5"];
            F02 -> N09 [label="0", style=solid];
            N0C -> O02 [label="0", style=solid];
            N09 -> N0B [label="0|0"];
            N0A -> N0B [label="0|1"];
            N0E -> N0C [label="0|0", style=dashed];
            N0F -> N0C [label="0|1", style=dashed];
            N0D -> N0C [label="0|0"];
            N0B -> N0D [label="0|0"];
