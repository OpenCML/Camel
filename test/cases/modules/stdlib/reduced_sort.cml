/**
 * `sort` orders every ordered element type, with or without a kernel: the reduced-precision
 * floats, `string` and `bool` have no kernel and run the body `xs[argsort(xs)]`, so the
 * reduced-precision floats are ordered as the f32 they widen to, exactly, with -0 below +0.
 */
module stdlib_reduced_sort

import { sort } from array

func main(): int sync {
    let xs: f16[] = [3.0, -1.0, 2.0, 0.0, -0.0]
    let ys: bf16[] = [3.0, -1.0, 2.0]
    println(sort(xs), sort(ys))
    println(sort(['pear', 'fig', 'apple']), sort([true, false, true]))
    return 0
}
