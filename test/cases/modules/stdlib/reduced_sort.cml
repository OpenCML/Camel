/**
 * The sorts are declared once per element type and none of those declarations takes bf16 or f16
 * (src/builtin/operators/array.cpp has one executor per element type, and `stdlib/array.cml` names
 * them: `array:sort_i`, `array:sort_l`, `array:sort_f`, `array:sort_d`). bf16 and f16 are numbers
 * (`is_numeric` asks `is_float`), so the call is refused by name, where it is written, with what to
 * write instead rather than with a list of overloads that could never match: nothing is sorted as
 * raw two-byte slots, and the refusal is no longer the kernel's (the rule's
 * 「不在运行期拒绝」).
 */
module stdlib_reduced_sort_refused

import { sort } from array

func main(): int sync {
    let xs: f16[] = []
    println(sort(xs))
    return 0
}