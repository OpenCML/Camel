/**
 * Imports every standard library module that needs no external runtime, so that
 * `camel inspect --ops` lists their operators (see stdlib_registry.plan.toml).
 */
module registry_all

import algo
import bytes
import hash
import env
import fs
import graph
import io
import json
import math
import process
import para
import random
import re
import sim
import statistics
import str
import this
import time
import ckpt
import tensor
import array
// `nn` and `autodiff` load without PyTorch, a GPU or a Python interpreter: `inspect --ops`
// lists their operators, and the stdlib registry tests hold them to the modules' declarations
// (handover H165).
import nn
import autodiff
// `tiles` needs no device to load: `inspect --ops` lists its operators, and the stdlib registry
// tests hold them to the module's purity and signature declarations (handover H156).
import tiles
// `pyplot` loads the embedded Python interpreter (part of the build) and needs no display, no
// external Python installation and no GPU to be listed; its operator's declaration is checked
// against the registered one (handover H166).
import pyplot
// `python` is the same interpreter, now with the declarations of its six fixed operators; the
// remaining five are computed signatures (handover H166).
import python
// `rewrite` is the native half of the rules library: its eight callable operators are declared
// in `stdlib/rewrite.cml` (the three reserved groups the `rule`/`analysis` declarations compile
// to have no callable name and stay exported by C++; handover H183). Its only undeclared purity,
// `analysis`, is declared effectful; before that this probe never listed it, so no check saw it
// (handover H173).
import rewrite
// `onnx` loads without the ONNX runtime: `inspect --ops` lists its two operators, and the
// stdlib registry tests hold them to the declaration and the computed signature (handover H179).
import onnx

func main(): int {
    return 0
}