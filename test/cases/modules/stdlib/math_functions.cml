/**
 * The math module: elementary functions and constants. Numeric types are not converted
 * implicitly: a function over floats takes a float and returns the type it was given.
 * A constant is a value the module exports, written without parentheses: `pi` (design
 * principles 10.1).
 */

import { sin, cos, tan, asin, acos, atan, atan2, sinh, cosh, tanh, log, log2, log10, log1p, exp, expm1, pow, trunc, hypot, sqrt, is_nan, is_inf, pi, e, inf, nan } from math

func main(): int sync {
    // a NaN is shown through is_nan: how one prints differs between platforms
    println(pi, e, inf, -inf, is_nan(nan))
    println(sin(0.0), sin(pi / 2.0), cos(0.0), cos(pi), tan(0.0), tan(pi / 4.0))
    println(asin(0.0), asin(1.0), acos(1.0), acos(0.0), atan(0.0), atan(1.0))
    println(atan2(1.0, 1.0), atan2(1.0, -1.0), atan2(-1.0, -1.0), atan2(0.0, 1.0))
    println(sinh(0.0), sinh(1.0), cosh(0.0), cosh(1.0), tanh(0.0), tanh(1.0))
    println(log(1.0), log(e), log2(8.0), log2(1.0), log10(1000.0), log10(0.001))
    println(log1p(0.0), log1p(1.0e-10), expm1(0.0), expm1(1.0e-10), exp(1.0))
    println(pow(2.0, 10.0), pow(2.0, -1.0), pow(9.0, 0.5), pow(0.0, 0.0), is_nan(pow(-8.0, 1.0 / 3.0)))
    println(trunc(2.7), trunc(-2.7), trunc(0.0), trunc(1.0e300), hypot(3.0, 4.0), hypot(0.0, 0.0))

    // outside the domain: the IEEE result, not a fault
    println(log(0.0), is_nan(log(-1.0)), is_nan(asin(2.0)), is_nan(sqrt(-1.0)), pow(0.0, -1.0), exp(1000.0))
    println(is_nan(sin(inf)), is_nan(cos(nan)), atan(inf), tanh(inf), tanh(-inf), hypot(inf, nan))
    println(trunc(inf), is_nan(trunc(nan)), log(inf), expm1(-inf))

    println(is_nan(nan), is_nan(0.0), is_nan(inf), is_nan(log(-1.0)), is_nan(inf - inf))
    println(is_inf(inf), is_inf(-inf), is_inf(0.0), is_inf(nan), is_inf(exp(1000.0)))

    // f32 in, f32 out
    let x = f32(0.5)
    println(sin(x), pow(x, x), atan2(x, x), is_nan(x), is_inf(x), trunc(x))
    return 0
}
