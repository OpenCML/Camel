/**
 * `sort` orders what `argsort` orders: the real numbers, `string` and `bool` (`is_ordered`). A
 * complex array has no order, so the call is refused where it is written, with the condition it
 * does not meet, not by an executor at run time.
 */

import { sort } from array

func main(): int sync {
    let z0: c64 = 1 + 2i
    let z1: c64 = 3 + 4i
    let xs: c64[] = [z0, z1]
    println(sort(xs))
    return 0
}
