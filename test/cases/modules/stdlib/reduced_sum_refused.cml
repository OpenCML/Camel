/**
 * A reduction over an array of bf16 has no way to compute yet, and says which piece is missing:
 * `sum` accumulates in f64 and converts the sum into the element type once (design principles
 * 7.3; ruling docs/handover/reviews/reduced-precision.md item (d)), and the language still
 * declares no conversion into the two reduced-precision element types (the ruling's item (c),
 * which another change owns). The call passes `sum`'s `when is_numeric::<T>()` — bf16 is a
 * float — and is then refused where the `match type` in `sum` looks for its case:
 * SemanticDiag::StaticMatchNotExhaustive names the type bf16 and the instance `sum<bf16>`. The
 * two arms `bf16(sumF64(xs))` and `f16(sumF64(xs))` are what that `match type` is missing.
 *
 * Tensor reductions over bf16 do compute (modules/stdlib/reduced_reduction_bytes.cml), because
 * the tensor kernel accumulates in f64 and rounds once when it stores the element
 * (modules/tensor/kernels/reduce.cpp).
 */
module stdlib_reduced_sum_refused

import { sum } from array

func main(): int sync {
    let xs: bf16[] = []
    println(sum(xs))
    return 0
}
