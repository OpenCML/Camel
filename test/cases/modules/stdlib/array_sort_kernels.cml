/**
 * The sort of `array` is one Camel function, `xs[argsort(xs)]`, and a kernel per element type that
 * does the same thing without the index array: `array:sort_i` for `i32`, `array:sort_l` for `int`,
 * `array:sort_f` for `f32` and `array:sort_d` for `float`. The kernel is the body run faster, so
 * the two give the same bits: this program prints each (`sort`, then the body spelled out as
 * `xs[argsort(xs)]`) for the four element types, and for floats with a NaN and the two zeros, where
 * `-0` is below `+0` and every NaN comes last.
 *
 * Every call is bound to the element type of its own declaration (`let r_i: i32[] = sort(s_i)`),
 * so a call answered by another element type's declaration does not typecheck. The rebindings
 * `v = v->sort` are the compiler's in-place forms (design principles 11.3;
 * Builder::inPlaceRebindingOf), per element type as well because the form is chosen by name
 * (OperatorTable::inPlaceForm).
 */

import { sort, argsort } from array
import { nan } from math

func main(): int sync {
    let s_i: i32[] = [3, 1, 2]
    let s_l: int[] = [30, 10, 20]
    let s_f: f32[] = [3.5, 1.5, 2.5]
    let s_d: float[] = [3.5, 1.5, -2.5]
    let r_i: i32[] = sort(s_i)
    let r_l: int[] = sort(s_l)
    let r_f: f32[] = sort(s_f)
    let r_d: float[] = sort(s_d)
    println('sort', r_i, r_l, r_f, r_d)
    println('body', s_i[argsort(s_i)], s_l[argsort(s_l)], s_f[argsort(s_f)], s_d[argsort(s_d)])
    println('input', s_i, s_l, s_f, s_d)

    // ---- the in-place forms: nothing else refers to the variable ----
    var v_i: i32[] = [9, 8, 7]
    var v_l: int[] = [90, 70, 80]
    var v_f: f32[] = [9.5, 8.5, 7.5]
    var v_d: float[] = [9.5, -8.5, 7.5]
    v_i = v_i->sort
    v_l = v_l->sort
    v_f = v_f->sort
    v_d = v_d->sort
    println('in_place', v_i, v_l, v_f, v_d)

    // ---- the order of floats: -0 below +0, every NaN after the numbers, ties keep their order ----
    let z: float[] = [1.0, nan, 0.0, -0.0, -1.0, nan]
    println('floats', sort(z), z[argsort(z)])
    let w: f32[] = [f32(1.0), f32(0.0), f32(-0.0), f32(-1.0)]
    println('f32', sort(w), w[argsort(w)])
    return 0
}
