/**
 * A reduction over a bf16 tensor accumulates in a wider type than the element type and rounds
 * once when it stores the result (design principles 7.3; modules/tensor/kernels/reduce.cpp uses
 * a double accumulator for every floating element type). The result is a bf16[..], so it is
 * two bytes per element: the two reduced rows are four bytes.
 *
 * The values separate the two widths. Row 0 is [2^24, 1, -2^24]: f32 addition rounds 2^24 + 1
 * back to 2^24, so an f32 accumulator answers 0, while the exact sum 1 rounds once into bf16
 * 1.0 (0x3F80, bytes [128, 63]). Row 1 is [3, 2^-7, 0]: the exact sum 3.0078125 is the halfway
 * value between bf16 3.0 and 3.015625, which ties to even gives 3.0 (0x4040, bytes [64, 64]),
 * so the rounding happens once, on the stored element.
 */

import { reshape, sum, to_bytes } from tensor
import { to_array } from bytes

#[change_precision]
func narrow(x: f32[..]): bf16[..] {
    return bf16(x)
}

func main(): int sync {
    let rows: f32[] = [16777216.0, 1.0, -16777216.0, 3.0, 0.0078125, 0.0]
    let matrix = reshape<[2, 3]>(narrow(rows))
    let reduced = sum<1, true>(matrix)
    println(len(to_bytes(reduced)))
    println(to_array(to_bytes(reduced)))
    return 0
}