/**
 * `x as bf16` is a dynamic cast between primitive types, which `as` refuses the same way it
 * refuses `x as i32` on a float that may not fit: the static type of x is `f32`, and not every
 * f32 is a bf16 (the conversion rounds). The written conversion `bf16(x)` is how a program asks
 * for that rounding, and it needs no numeric permission, because writing it is asking for that
 * precision (design principles 7.2-7.3,
 * which is where the written conversion is grounded). Widening the other way — `b as f32` — is a cast that loses nothing and is accepted.
 */

func main(): int sync {
    let x: f32 = 0.1
    let y = x as bf16
    println(y)
    return 0
}