/**
 * A string is always valid UTF-8, indexed and measured in code points (design principles
 * 11.1); binary data is `Bytes`.
 */

import { split, trim, replace, index_of, starts_with, repeat, codepoints, to_upper } from str
import { encode, decode, from_array } from bytes
import { sha256 } from hash
import { has_match } from re

func main(): int sync {
    let s = '中文x😀'
    println(len(s), s[0], s[1], s[2], s[3], '中'[0] == '中')
    println(len(''), len('abc'), len('é'), len('\u{1F600}'), '\u{4E2D}\u{6587}' == '中文')
    println(s->index_of<'x'> ?? -1, s->index_of<'😀'> ?? -1, s->index_of<'z'> ?? -1)
    println(s[1:3], s[2:4], s[0:0])
    println(s->split<'文'>, s->replace<'文', 'W'>, s->starts_with<'中'>, '中'->repeat<3>)
    println(len('é中😀'->to_upper), 'é中x'->to_upper)

    // formatting counts code points
    println('[{:>4}][{:<4}][{:^5}][{:*^6}][{:.2}]'->format<'中', '文', 'ab', '😀', '中文😀'>)
    println('[{:>6}][{}]'->format<'é', '中'>)

    // the bytes of a string, and back: `bytes::encode` and `bytes::decode` are the one conversion
    let b = encode(s)
    println(len(b), len(encode(s)), decode(b) !! 'bad')
    println(decode(encode('héllo')) !! 'bad', len(decode(from_array([228, 184, 173])) !! 'bad'))
    println(codepoints(s))
    println(sha256('abc') == sha256(encode('abc')), sha256('中') == sha256(encode('中')))

    // regular expressions: `.` is one character
    println('中'->has_match<'^.$'>, '中文'->has_match<'^.{2}$'>, 'ab'->has_match<'^.$'>, 'a文b'->has_match<'文'>)
    return 0
}