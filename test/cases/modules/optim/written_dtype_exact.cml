/**
 * A tensor leaf of a written element type keeps it on both sides: a leaf written
 * `f64[?]` and built as `full([2], 0.1)` is still f64 after `nn:sgd` and after two
 * `nn:adam` steps, in the bytes of two doubles, and one written `f32[?]` and built as
 * `full([2], f32(0.25))` is f32 in the bytes of two floats.
 *
 * The element type a leaf writes is the element type it is updated at, and it is the leaf's own
 * type that says which writing of the formula the module takes -- nothing is asked of the value at
 * run time. The native path converted every tensor leaf to f32 before it updated it
 * (`floatTensor` and `newLike`, modules/nn/optim.cpp) and handed an f32 array back under an f64
 * type; the Camel module narrowed the same way. Both keep the written element type now, and this
 * case pins it: eight bytes an element for the f64 leaf and four for the f32 one, on both sides.
 *
 * The two sides are compared bit for bit as well, which is what the shared element type buys: the
 * `sgd` result and the parameter after two `adam` steps are the native result and the Camel one,
 * leaf by leaf. The Camel state's moments are tensors of the same element type as their parameter,
 * and the counts printed with every check say how many leaves and elements it looked at, so a walk
 * that examined nothing cannot pass.
 */

import { full, numel, sum, to_bytes } from tensor
import { size, to_array } from bytes
import { adam as native_adam, adam_state, sgd as native_sgd } from nn
import { adam, constant, init, sgd, update } from optim
import { with_grad } from autodiff

// The element type is written and the extent is not: the two leaves are the two floating element
// types, so which writing of the update each leaf takes is settled when the tree is expanded by
// field.
type Leaves = {
    wide: f64[?],
    narrow: f32[?]
}

// The loss the gradient comes from: the sum of each leaf, so the gradient is one at every element
// of both leaves -- in the element type of the leaf it belongs to.
with <m: Leaves>
func total(): float {
    return float(sum(m.wide)) + float(sum(m.narrow))
}

func main(): int sync {
    // `full` takes the element type of its value: 0.1 is an f64 number and `f32(0.25)` is an f32
    // one, so each leaf is built at the element type its own type writes.
    let model: Leaves = {
        wide: full([2], 0.1),
        narrow: full([2], f32(0.25))
    }
    let total_with_grad = with_grad(total)
    let (value, gradient) = total_with_grad<model>()
    var failures = 0

    // The gradient of a written leaf has its element type too: eight bytes an element for the f64
    // leaf and four for the f32 one. A gradient read at the wrong width is not the derivative
    // (modules.tensor.dtype, `gather_grad_f64`), so the steps below are only meaningful with this
    // held.
    if size(to_bytes(gradient.wide)) != 8 * numel(gradient.wide) then failures = failures + 1
    if size(to_bytes(gradient.narrow)) != 4 * numel(gradient.narrow) then failures = failures + 1
    'optim written_dtype_exact gradient leaves={} elements={} wide_bytes={} narrow_bytes={} total={}'
    ->format<2, 4, size(to_bytes(gradient.wide)), size(to_bytes(gradient.narrow)), value>
    ->println

    // ---- one `sgd` step of each leaf, through both paths ----
    let sgd_opt = sgd(constant(0.5))
    let stepped = native_sgd(model, gradient, 0.5)
    let camel_stepped = update(sgd_opt, model, gradient, init(sgd_opt, model))
    let wide = to_array(to_bytes(stepped.wide))
    let narrow = to_array(to_bytes(stepped.narrow))
    let agrees_wide = if wide == to_array(to_bytes(camel_stepped.0.wide)) then 1 else 0
    let agrees_narrow = if narrow == to_array(to_bytes(camel_stepped.0.narrow)) then 1 else 0
    if size(to_bytes(stepped.wide)) != 8 * numel(stepped.wide) then failures = failures + 1
    if size(to_bytes(stepped.narrow)) != 4 * numel(stepped.narrow) then failures = failures + 1
    if agrees_wide != 1 then failures = failures + 1
    if agrees_narrow != 1 then failures = failures + 1
    'optim written_dtype_exact sgd leaves={} elements={} wide_bytes={} narrow_bytes={} agrees_wide={} agrees_narrow={}'
    ->format<2, 4, size(to_bytes(stepped.wide)), size(to_bytes(stepped.narrow)), agrees_wide, agrees_narrow>
    ->println
    'optim written_dtype_exact sgd wide={}'->format<wide>->println
    'optim written_dtype_exact sgd narrow={}'->format<narrow>->println

    // ---- two `adam` steps: the parameters through both paths, and the Camel state's moments ----
    // A moment is a tensor of its parameter's element type, so the state would move the parameter
    // afterwards if it were f32: the widths of both parameters and of the two moment trees are
    // checked, and the two steps compare the parameters bit for bit.
    let opt = adam(constant(0.5), 0.5, 0.25, 0.0001)
    let first = native_adam(model, gradient, adam_state(model), 0.5, 0.5, 0.25, 0.0001)
    let second = native_adam(first.0, gradient, first.1, 0.5, 0.5, 0.25, 0.0001)
    let camel_first = update(opt, model, gradient, init(opt, model))
    let camel_second = update(opt, camel_first.0, gradient, camel_first.1)
    let adam_wide =
        if to_array(to_bytes(second.0.wide)) == to_array(to_bytes(camel_second.0.wide)) then 1 else 0
    let adam_narrow =
        if to_array(to_bytes(second.0.narrow)) == to_array(to_bytes(camel_second.0.narrow)) then 1 else 0
    if size(to_bytes(second.0.wide)) != 8 * numel(second.0.wide) then failures = failures + 1
    if size(to_bytes(second.0.narrow)) != 4 * numel(second.0.narrow) then failures = failures + 1
    if size(to_bytes(camel_second.1.m.wide)) != 8 * numel(camel_second.1.m.wide) then failures = failures + 1
    if size(to_bytes(camel_second.1.m.narrow)) != 4 * numel(camel_second.1.m.narrow) then failures = failures + 1
    if size(to_bytes(camel_second.1.v.wide)) != 8 * numel(camel_second.1.v.wide) then failures = failures + 1
    if size(to_bytes(camel_second.1.v.narrow)) != 4 * numel(camel_second.1.v.narrow) then failures = failures + 1
    if adam_wide != 1 then failures = failures + 1
    if adam_narrow != 1 then failures = failures + 1
    'optim written_dtype_exact adam leaves={} elements={} wide_bytes={} narrow_bytes={} moment_wide={} moment_narrow={} agrees_wide={} agrees_narrow={}'
    ->format<4, 8, size(to_bytes(second.0.wide)), size(to_bytes(second.0.narrow)), size(to_bytes(camel_second.1.m.wide)), size(to_bytes(camel_second.1.m.narrow)), adam_wide, adam_narrow>
    ->println
    'optim written_dtype_exact adam wide={}'->format<to_array(to_bytes(second.0.wide))>->println
    'optim written_dtype_exact adam narrow={}'->format<to_array(to_bytes(second.0.narrow))>->println
    'optim written_dtype_exact failures={}'->format<failures>->println
    return failures
}