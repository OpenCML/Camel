/**
 * The native optimizers keep the element type a tensor leaf was written with: a leaf written
 * `Tensor<f64, [?]>` is f64 after `nn:sgd` and after two `nn:adam` steps, and one written
 * `Tensor<f32, [?]>` is f32 with the f32 arithmetic it had.
 *
 * `16777217.0` is the smallest integer f32 cannot hold (`f32(16777217.0)` is `16777216.0`), so one
 * `sgd` step of it with a rate of 0.5 leaves `16777216.5`, a value no f32 can hold, in a leaf whose
 * bytes are the two f64 elements. The native path used to narrow every tensor leaf to f32
 * (`floatTensor` casts anything that is not f32, `newLike` allocates f32 -- modules/nn/optim.cpp)
 * and handed back an f32 array under a type that says f64; design principles 7.4 asks for the
 * element type the program wrote, and a narrower computation would need the `change_precision`
 * permission (7.2-7.3) that no one wrote here.
 *
 * The properties are read off the bytes, not off a printed summary: `to_bytes` answers at the
 * element type the leaf actually holds, so eight bytes an element is f64 and four is f32, and the
 * bytes themselves are decoded in the plan (an f64 element is the eight bytes of the double). Two
 * `adam` steps run as well, because the moments carry the leaf's element type too and an f32
 * moment moves the parameter: the parameter's bytes after the second step are compared to the
 * Camel `optim` module's own arm for the same leaf (`adam_wide`), bit for bit, which is the
 * agreement the two sides could not have while one of them narrowed the leaf.
 *
 * The gradient comes from `with_grad`, which is what `nn`'s optimizers take (a tree that merely has
 * the same type is refused, docs/technical/optim.md), and its two leaves are checked first: a
 * tangent has the element type of the parameter it belongs to.
 */
module optim_native_dtype_exact

import { Tensor, numel, new, sum, to_bytes } from tensor
import { size, to_array } from bytes
import { adam as native_adam, adam_state, sgd as native_sgd } from nn
import { adam, constant, init, update } from optim
import { with_grad } from autodiff

// The two leaves: the element type is written, the extent is not (the only spelling a tensor
// expression has here, and the one the native walk reads).
type Leaves = {
    wide: Tensor<f64, [?]>,
    narrow: Tensor<f32, [?]>
}

// The loss the gradient comes from: the sum of each leaf, so the gradient is one at every element
// of both leaves -- in the element type of the leaf it belongs to, which the case checks before it
// steps with it.
with <m: Leaves>
func total(): float {
    return sum(m.wide) + sum(m.narrow)
}

func main(): int sync {
    let model: Leaves = {
        wide: new([16777217.0, 1.0] as f64[]),
        narrow: new([f32(16777217.0), f32(1.0)])
    }
    let total_with_grad = with_grad(total)
    let (value, gradient) = total_with_grad<model>()
    var failures = 0
    var leaves = 0
    var elements = 0

    // The gradient of a written f64 leaf is f64 and of a written f32 leaf f32: 16 bytes and 8. A
    // gradient read at the wrong width is not the derivative (modules.tensor.dtype,
    // gather_grad_f64), so the step below is only meaningful with this held.
    leaves = leaves + 2
    elements = elements + 4
    if size(to_bytes(gradient.wide)) != 8 * numel(gradient.wide) then failures = failures + 1
    if size(to_bytes(gradient.narrow)) != 4 * numel(gradient.narrow) then failures = failures + 1

    // ---- one `sgd` step of each leaf, through the native path ----
    let stepped = native_sgd(model, gradient, 0.5)
    let wide = to_array(to_bytes(stepped.wide))
    let narrow = to_array(to_bytes(stepped.narrow))

    // The f64 leaf is 8 bytes an element and the f32 leaf 4: the element size is the element type.
    // The bytes are printed and decoded in the plan, where the f64 leaf's value is read as a double
    // and the f32 leaf's as a float -- a length alone would not say what the bytes hold.
    leaves = leaves + 2
    elements = elements + 4
    if size(to_bytes(stepped.wide)) != 8 * numel(stepped.wide) then failures = failures + 1
    if size(to_bytes(stepped.narrow)) != 4 * numel(stepped.narrow) then failures = failures + 1

    'optim native_dtype_exact sgd leaves={} elements={} wide_bytes={} narrow_bytes={} wide_elements={} total={}'
    ->format<leaves, elements, size(to_bytes(stepped.wide)), size(to_bytes(stepped.narrow)), numel(stepped.wide), value>
    ->println
    'optim native_dtype_exact wide_bytes={}'->format<wide>->println
    'optim native_dtype_exact narrow_bytes={}'->format<narrow>->println

    // ---- two `adam` steps of the same leaves: the native path against the Camel f64 arm ----
    // The counters are per step kind, so each line says what that check looked at.
    leaves = 0
    elements = 0
    let opt = adam(constant(0.5), 0.5, 0.25, 0.0001)
    let first = native_adam(model, gradient, adam_state(model), 0.5, 0.5, 0.25, 0.0001)
    let second = native_adam(first.0, gradient, first.1, 0.5, 0.5, 0.25, 0.0001)
    let camel_first = update(opt, model, gradient, init(opt, model))
    let camel_second = update(opt, camel_first.0, gradient, camel_first.1)
    let wide_second = to_array(to_bytes(second.0.wide))
    let narrow_second = to_array(to_bytes(second.0.narrow))
    let agrees_wide = if wide_second == to_array(to_bytes(camel_second.0.wide)) then 1 else 0
    let agrees_narrow = if narrow_second == to_array(to_bytes(camel_second.0.narrow)) then 1 else 0

    // An f64 leaf keeps its own arithmetic: after two steps it is the same 16 bytes the Camel
    // module's f64 arm gives, bit for bit. An f32 leaf stays f32: the same 8 bytes, and its step
    // is the f32 one (the Camel module's f32 arm narrows once, as the native kernel does).
    leaves = leaves + 2
    elements = elements + 4
    if size(to_bytes(second.0.wide)) != 8 * numel(second.0.wide) then failures = failures + 1
    if size(to_bytes(second.0.narrow)) != 4 * numel(second.0.narrow) then failures = failures + 1
    if agrees_wide != 1 then failures = failures + 1
    if agrees_narrow != 1 then failures = failures + 1

    'optim native_dtype_exact adam leaves={} elements={} wide_bytes={} narrow_bytes={} wide_agrees={} narrow_agrees={}'
    ->format<leaves, elements, size(to_bytes(second.0.wide)), size(to_bytes(second.0.narrow)), agrees_wide, agrees_narrow>
    ->println
    'optim native_dtype_exact failures={}'->format<failures>->println
    return failures
}