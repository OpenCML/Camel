/**
 * A tensor leaf whose element type is written as f64 keeps f64, and the bytes of the result say so.
 *
 * The native optimizer turns every tensor leaf into f32 before it updates it (`floatTensor` and
 * `newLike`, modules/nn/optim.cpp) and hands back an array that is f32 while the type of the tree
 * says f64; this module keeps the element type the program wrote, which is what design principles
 * 7.4 asks ("the element type is exact"). The two cannot agree on such a leaf, and this case
 * guards this side of it: `16777217.0` is exact in f64 and is `16777216.0` in f32, so one `sgd`
 * step of it with a rate of 0.5 is `16777216.5` here, a value no f32 can hold, in a leaf of 16
 * bytes. The native path is not run on this leaf: it would hand back an f32 array under an f64
 * type, and which of the two element types a read of it uses is not specified.
 */

import { new, to_bytes } from tensor

import { adam, constant, init, sgd, update } from optim

// The element type is written, the extent is not (that is the only spelling a tensor expression
// has here, and the one a type pattern takes): the leaf is a tensor and every element is f64.
type Wide = {
    w: f64[?]
}

// A tree of one number, for the property below: the number path and the tensor path must agree.
type Number = {
    w: float
}

func main(): int sync {
    // 16777217.0 is the smallest integer f32 cannot hold: `f32(16777217.0)` is 16777216.0.
    let numbers: f64[] = [16777217.0, 1.0]
    let gradients: f64[] = [1.0, 1.0]
    let model: Wide = { w: new(numbers) }
    let gradient: Wide = { w: new(gradients) }
    let opt = sgd(constant(0.5))
    let next = update(opt, model, gradient, init(opt, model))
    let value = next.0.w[0]
    let width = len(to_bytes(next.0.w))
    var failures = 0

    // The step is the exact f64 arithmetic, and the leaf is still 16 bytes (two f64 elements).
    if value != 16777216.5 then failures = failures + 1
    if width != 16 then failures = failures + 1
    // The stored value is not representable in f32: had the leaf been narrowed, it would be.
    if float(f32(value)) == value then failures = failures + 1
    // The step count of the state came back too.
    if next.1.step != 1 then failures = failures + 1

    'optim dtype_exact steps={} value={} f32_value={} bytes={}'
    ->format<next.1.step, value, float(f32(value)), width>
    ->println

    // One `adam` step of the same leaf: its moments are f64 as well, so the parameter is 16 bytes
    // and its value is the f64 one (a step of `0.5 / (1 + eps)` below the start, since the first
    // moments make the adaptive factor exactly one).
    let adam_opt = adam(constant(0.5), 0.5, 0.25, 0.0001)
    let trained = update(adam_opt, model, gradient, init(adam_opt, model))
    let adam_value = trained.0.w[0]
    let adam_width = len(to_bytes(trained.0.w))
    let delta = adam_value - 16777216.50005
    if adam_width != 16 then failures = failures + 1
    if delta > 0.000001 || delta < -0.000001 then failures = failures + 1
    if float(f32(adam_value)) == adam_value then failures = failures + 1
    if trained.1.step != 1 then failures = failures + 1

    'optim dtype_exact adam steps={} value={} bytes={}'
    ->format<trained.1.step, adam_value, adam_width>
    ->println

    // A tree of numbers and a tree of one-element tensors that hold the same numbers must land on
    // the same value: the leaf arithmetic is one implementation per leaf kind, and this pins the
    // number path (`adam_number`, `sgd`'s `float` arm) to the tensor path (`adam_wide`, its
    // `f64[?]` arm). A tree of one-element tensors of the same numbers, so every step is
    // the same arithmetic twice.
    let one: f64[] = [16777217.0]
    let one_gradient: f64[] = [1.0]
    let wide_one: Wide = { w: new(one) }
    let wide_one_gradient: Wide = { w: new(one_gradient) }
    let number_one: Number = { w: 16777217.0 }
    let number_one_gradient: Number = { w: 1.0 }
    let wide_sgd = update(opt, wide_one, wide_one_gradient, init(opt, wide_one))
    let number_sgd = update(opt, number_one, number_one_gradient, init(opt, number_one))
    let wide_adam = update(adam_opt, wide_one, wide_one_gradient, init(adam_opt, wide_one))
    let number_adam = update(adam_opt, number_one, number_one_gradient, init(adam_opt, number_one))
    if number_sgd.0.w != wide_sgd.0.w[0] then failures = failures + 1
    if number_adam.0.w != wide_adam.0.w[0] then failures = failures + 1

    'optim dtype_exact scalar sgd={} wide_sgd={} adam={} wide_adam={}'
    ->format<number_sgd.0.w, wide_sgd.0.w[0], number_adam.0.w, wide_adam.0.w[0]>
    ->println
    return failures
}