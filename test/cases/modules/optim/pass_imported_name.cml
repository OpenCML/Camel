/**
 * The same pass, imported by name: `import { cse } from opt` puts `cse` itself in scope, so the
 * call is `loss->cse`. The two spellings name one function, and both compute 12.0.
 */

import { cse } from opt

with <w: float>
func loss(x: float) => float { w*x + w*x }

func main() sync {
    let g = loss->cse !! loss
    println(g<2.0>(3.0))
}
