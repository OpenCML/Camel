/**
 * An optimization that is neither `Sgd` nor `Adam` is not one this module knows: `update` has no
 * overload for it, so the call is refused when the program is compiled. The type used to be
 * accepted whatever it was and ran the `adam` update with its default constants, which is the
 * fallback this rewrite deleted; there is no other optimizer to fall back to.
 */
module optim_unknown_optimizer_update

import { Tensor, full } from tensor
import { adam, constant, init, update } from optim

type Unknown = { rate: float }

type Model = { w: Tensor }

func model_at(): Model {
    return { w: full([4], f32(0.5)) }
}

func update_unknown(): int {
    let opt: Unknown = { rate: 0.1 }
    let model = model_at()
    let grad = model_at()
    let state = init(adam(constant(0.01)), model)
    let (next, after) = update(opt, model, grad, state)
    return after.step
}

func main(): int sync {
    let steps = update_unknown()
    'optim unknown optimizer update steps={}' ->format<steps> ->println
    return 0
}