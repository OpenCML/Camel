/**
 * argmax (design principles 7.7) exported to ONNX: ONNX ArgMax takes the first index on ties
 * with select_last_index=0, but it treats -0 and +0 the same and does not state what it does
 * with NaN, so the exporter composes the rule. The model returns, for a [2, 8] float input,
 * argmax along axis 1, the same with keepdims, and argmax along axis 0; MODE=int exports the
 * same three from an int64 input (no NaN, no -0: a direct ArgMax). Checked on ONNX Runtime by
 * ort_argmax.py.
 */
import { reshape, argmax } from tensor
import { is_numeric } from types
import { export_model } from onnx
import { get_env } from env

func forward::<T>(x: T[..]): (int[..], int[..], int[..]) when is_numeric::<T>() {
    return (argmax<1>(x), argmax<1, true>(x), argmax<0>(x))
}

func main(): int sync {
    if (get_env('MODE') ?? '') == 'int' then {
        let x = reshape<[2, 8]>([3, 7, 7, 1, 1, 2, 2, 9, 3, 7, 7, 1, 1, 2, 2, 9])
        let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((x: int[..]): (int[..], int[..], int[..]) => forward(x), x)
    } else {
        let x = reshape<[2, 8]>([1.0, 3.0, 3.0, -2.0, -2.0, 7.0, 7.0, 0.5, 1.0, 3.0, 3.0, -2.0, -2.0, 7.0, 7.0, 0.5] as f32[])
        let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((x: f32[..]): (int[..], int[..], int[..]) => forward(x), x)
    }
    println('exported')
    return 0
}