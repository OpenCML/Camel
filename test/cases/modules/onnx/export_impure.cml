/**
 * Side effects cannot be expressed in an ONNX model: an impure operator inside
 * the exported function is rejected even when its arguments are constants.
 */

import { reshape, randn } from tensor
import { export_model } from onnx
import { get_env } from env

func main(): void! sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    export_model<out: get_env('ONNX_OUT') ?? ''>((t: float[..]): float[..] => t + f64(randn([2, 2])), x)
}
