/**
 * Importing onnx (which links the tensor module) before tensor must not load a
 * second copy of the tensor module: operator inference has to see the same
 * registry, so shapes stay known through layer_norm and matmul.
 */

import { export_model } from onnx
import { random, ones, zeros, layer_norm, reshape, shape } from tensor
import { get_env } from env

func main(): int sync {
    let w = random([8, 8], -1.0, 1.0)
    let g = ones([8])
    let b = zeros([8])
    let x = random([2, 4, 8], -1.0, 1.0)
    // reshape(.., shape(..)) needs the static rank of the layer_norm/matmul result.
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((t: f32[..]): f32[..] => reshape(t, shape(layer_norm(t, g, b) @ w)), x)
    println('exported')
    return 0
}
