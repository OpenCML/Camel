/**
 * Level-2 boundary (E13/T5): a training step whose loss takes a data-dependent
 * branch with SCALAR arms exports even when the predicate is a dead
 * intermediate (used only as the branch condition). Companion to
 * export_train_step_branch (predicate is the returned loss value); together
 * they bracket the scalar-arm region of the Level-2 map.
 */

import { relu, mean, abs, reshape } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: float[..], b1: float[..], w2: float[..], b2: float[..] }

with <m: Mlp>
func loss(x: float[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    let s = float(mean(y * y))
    let c = float(mean(abs(h)))
    return if c > 0.5 then s * 2.0 else s
}

func step(m: Mlp, x: float[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1], [3]),
        w2: reshape([1.0, -1.0, 0.5], [3, 1]),
        b2: reshape([0.2], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5], [2, 2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(step, (m, x))
    println('exported')
    return 0
}
