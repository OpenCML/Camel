/**
 * The same collection on a `while`: the counter `k` is a state of its own and the condition
 * reads it, while the array the rounds are collected into grows beside it. How many values the
 * array holds is decided while the loop runs, not by a trip count the model states.
 */
import { get_env } from env
import { export_model } from onnx
import { sum } from tensor

func build(x: f32[?]) => (int[], int) {
    return loop acc = [] as int[], k = 0 while k < int(sum(x)) do (acc->append<k>, k + 1)
}

func main() => string! sync {
    let x = [1.0, 2.0, 3.0] as f32[?]
    let (xs, k) = build(x)
    println(len(xs))
    println(k)
    return match export_model<out: get_env('ONNX_OUT') ?? '', dynamic_axes: [0]>(func (x: f32[?]) => (int[], int) {
        build(x)
    }, (x)) {
        case error e => {
            return e
        }
        case v => 'exported'
    }
}