/**
 * A `while` that collects one value per round into an array, exported as an ONNX Loop whose scan
 * output is that array, and run on ONNX Runtime against Camel's own result.
 *
 * The rounds are the condition's business, not the input's: `sum(x)` decides how many values the
 * array holds, so the two inputs the driver feeds it collect two different counts. `x.npy` is
 * read from the working directory and the array the loop hands out is saved as `y.npy` (int64),
 * so the driver compares Camel's array with the model's output -- shape and values.
 */
import { get_env } from env
import { export_model } from onnx
import { load_npy, save_npy, sum } from tensor

func build(x: f32[?]) => (int[], int) {
    return loop acc = [] as int[], k = 0 while k < int(sum(x)) do (acc->append<k * 10>, k + 1)
}

func main() => string! sync {
    let x = (load_npy::<f32>('x.npy')) as f32[?]
    let (xs, k) = build(x)
    save_npy(xs, 'y.npy')
    println(k)
    let out = get_env('ONNX_OUT') ?? ''
    return if out == '' then '0'
    else match export_model<out: out, dynamic_axes: [0]>(func (x: f32[?]) => (int[], int) {
        build(x)
    }, (x)) {
        case error e => {
            return e
        }
        case v => '1'
    }
}