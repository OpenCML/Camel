/**
 * Driven by ort_train_dynamic.py: the export_train_step_dynamic.cml training
 * step with the input read from X (npy [B,2]). Exports the step to ONNX_OUT —
 * with dynamic axis 0 when DYN=1, specialized to B otherwise — runs it natively
 * on the same input, and dumps the updated parameters to DUMP.
 */
module ort_train_dynamic

import { relu, sum, reshape, shape, load_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..] }

with <m: Mlp>
func loss(x: f32[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    return float(sum(y * y)) / float(shape(y)[0] * shape(y)[1])
}

func step(m: Mlp, x: f32[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25] as f32[], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1] as f32[], [3]),
        w2: reshape([1.0, -1.0, 0.5] as f32[], [3, 1]),
        b2: reshape([0.2] as f32[], [1])
    }
    let x = load_npy::<f32>(get_env('X') ?? '')
    let vg = step(m, x)
    'CAMEL loss={}'->format<vg.0>->println
    save_params(vg.1, get_env('DUMP') ?? '')
    let out = get_env('ONNX_OUT') ?? ''
    if out != '' then
        if (get_env('DYN') ?? '') == '1' then export_model(step, (m, x), out, [0])
        else export_model(step, (m, x), out)
    return 0
}
