/**
 * M2: freezing a parameter with stop_gradient keeps the training step
 * exportable, and the exported graph carries no gradient computation for the
 * frozen weight — compared with export_train_step.cml (5 MatMul), the frozen
 * graph has one MatMul fewer (the dW1 product is gone) while still listing
 * every parameter as an input and an (identity-updated) output.
 */

import { relu, mean, reshape } from tensor
import { with_grad, stop_gradient } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: float[..], b1: float[..], w2: float[..], b2: float[..] }

with <m: Mlp>
func loss(x: float[..]): float {
    let h = relu(x @ stop_gradient(m.w1) + m.b1)
    let y = h @ m.w2 + m.b2
    return float(mean(y * y))
}

func step(m: Mlp, x: float[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape<[2, 3]>([0.5, -0.25, 0.75, 1.0, -0.5, 0.25]),
        b1: reshape<[3]>([0.1, 0.0, -0.1]),
        w2: reshape<[3, 1]>([1.0, -1.0, 0.5]),
        b2: reshape<[1]>([0.2])
    }
    let x = reshape<[2, 2]>([1.0, 2.0, -1.0, 0.5])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(step, (m, x))
    println('exported')
    return 0
}
