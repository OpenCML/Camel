/**
 * A training step (with_grad + sgd) through a function with a custom derivative rule
 * (#vjp): the exported gradient uses the rule, not the derivative of the body. For the example
 * input Camel prints the loss 5.56157 and the updated w [[0.3799, -0.2188], [0.6391, 0.8194]],
 * b [0.1628, -0.2505]; NumPy with the declared rule and the exported model on ONNX Runtime
 * agree (checked by hand, artifacts: b2/probes/p11_vjp_step.cml).
 */
module export_train_step_vjp
import { Tensor, reshape, sum, tanh, where } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

// A hard sign with a straight-through gradient scaled by 0.5: the rule, not the body, is what
// the gradient uses.
func hard_sign_rule(x: f32[..], dy: f32[..]): f32[..] {
    return dy * 0.5
}

#vjp(hard_sign_rule)
func hard_sign(x: f32[..]): f32[..] {
    return where(x > 0.0, x * 0.0 + 1.0, x * 0.0 - 1.0)
}

type P = { w: f32[..], b: f32[..] }

with <m: P>
func loss(x: f32[..]): float {
    let h = hard_sign(x @ m.w + m.b)
    return sum(tanh(h + x @ m.w) * h)
}

func step(m: P, x: f32[..]): (float, P) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.1))
}

func main(): int sync {
    let m = { w: reshape([0.5, -0.25, 0.75, 1.0] as f32[], [2, 2]), b: reshape([0.1, -0.2] as f32[], [2]) }
    let x = reshape([1.0, 2.0, -1.0, 0.5, 0.3, -0.7] as f32[], [3, 2])
    let r = step(m, x)
    println(r.0)
    println(r.1.w)
    println(r.1.b)
    export_model(step, (m, x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}
