/**
 * A slice whose end depends on the model input: Camel faults when the end leaves the axis
 * (design principles 3.9) where the ONNX Slice would clamp it, so the exported model must fail
 * on ONNX Runtime where Camel faults and agree with Camel elsewhere (checked by
 * ort_slice_bounds.py, for the slice alone and inside a branch on the data: MODE=branch).
 */
import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func head(x: f32[..]): f32[..] {
    return slice(x, 0, 0, int(sum(x)))
}

/// A branch on the data: an ONNX If, only the arm taken runs.
func branch(x: f32[..]): f32[..] {
    return if sum(x) > 100.0 then x else head(x)
}

func main(): int sync {
    let x = reshape<[3]>([1.0, 1.0, 1.0] as f32[])
    println(head(x))
    if (get_env('MODE') ?? '') == 'branch' then {
        let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((x: f32[..]): f32[..] => branch(x), x)
    } else {
        let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((x: f32[..]): f32[..] => head(x), x)
    }
    println('exported')
    return 0
}
