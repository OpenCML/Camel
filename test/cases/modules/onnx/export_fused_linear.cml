/**
 * A fused linear layer exports as the program's operators: `relu(x @ w + b)` is MatMul, Add and
 * Relu in the ONNX graph, whether tensor::fuse ran or not (design principles 9.6). The exporter
 * has no fused form to translate, so the ONNX graph is the same before and after the pass.
 */
import { reshape, relu, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func net(x: f32[..]): f32[..] {
    let w = reshape([0.5, -1.0, 2.0, 1.0, -0.5, 0.25] as f32[], [3, 2])
    let b = reshape([0.1, -0.2] as f32[], [2])
    return relu(x @ w + b)
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 0.5, -1.5, 2.5] as f32[], [2, 3])
    println(sum(net(x)))
    export_model((x: f32[..]): f32[..] => net(x), x, get_env('ONNX_OUT'))
    println('exported')
    return 0
}