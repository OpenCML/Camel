/**
 * Models run on ONNX Runtime by ort_run.py: `gate` branches on a value read
 * from the input (exports as If), `forward` has a dynamic batch dimension.
 * Reads the input from X (npy), writes Camel's own output to Y (npy), and,
 * when ONNX_OUT is set, exports the model selected by MODEL.
 */
module ort_models

import { Tensor, reshape, relu, zeros, shape, load_npy, save_npy } from tensor
import { export_model } from onnx
import { get_env } from sys

func gate(t: Tensor): Tensor {
    return if t[0] > 0.5 then relu(t) * 2.0 else t * (t[1] * 2.0) - 1.0
}

func forward(x: Tensor, w: Tensor): Tensor {
    let n = shape(x)[0]
    let h = zeros([n, shape(w)[1]]) + x @ w
    return reshape(h, [n * shape(w)[1]])
}

func main(): int sync {
    let x = load_npy(get_env('X'))
    let w = reshape([1.0, 0.0, 2.0, 0.0, 1.0, -1.0], [2, 3])
    let isGate = get_env('MODEL') == 'gate'
    let y = if isGate then gate(x) else forward(x, w)
    save_npy(y, get_env('Y'))
    let out = get_env('ONNX_OUT')
    return if out == '' then 0 else if isGate then sync {
        export_model(gate, x, out)
        return 0
    } else sync {
        export_model((t: Tensor): Tensor => forward(t, w), x, out, [0])
        return 0
    }
}
