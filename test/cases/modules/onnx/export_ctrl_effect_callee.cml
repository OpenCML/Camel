/**
 * The effect sits in a function the exported one still calls after
 * simplification (recursion whose depth depends on the input is not unrolled):
 * the export is refused at the println inside the callee, not only at the
 * leftover call.
 */

import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func shrink(t: f32[..]): f32[..] sync {
    println('EFFECT inside a callee')
    return if sum(t) > 1.0 then shrink(t * 0.5) else t
}

func main(): void! sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0] as f32[], [2, 2])
    export_model<out: get_env('ONNX_OUT') ?? ''>((t: f32[..]): f32[..] => shrink(t), x)
}
