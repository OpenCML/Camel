/**
 * An effect that is only on the control path of the exported function: the
 * println of a sync callee runs for its effect, its value reaches no output.
 * An ONNX model cannot print, so the export is refused at the println (it must
 * not write a model that silently lacks it).
 */
module export_ctrl_effect

import { Tensor, reshape, relu } from tensor
import { export_model } from onnx
import { get_env } from env

func scaled(t: Tensor): Tensor sync {
    println('EFFECT inside exported function')
    return relu(t) * 2.0
}

func noisy(t: Tensor): Tensor sync {
    return scaled(t) + 1.0
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 0.5] as f32[], [4])
    export_model((t: Tensor): Tensor => noisy(t), x, get_env('ONNX_OUT'))
    println('unreachable')
    return 0
}
