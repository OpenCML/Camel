/**
 * One training step as `main`: the weights are `with` parameters, the data ordinary ones, and
 * the result is the loss and the updated weights. Exported, the weights are inputs and
 * outputs of the model (`p_w`, `p_b` in, `output_1_w`, `output_1_b` out).
 */
module train_step

import { tanh, mean } from tensor
import { with_grad } from autodiff
import { sgd } from nn

type Linear = { w: f32[3, 4], b: f32[4] }

with <p: Linear>
func loss(x: f32[..], y: f32[..]): float {
    let d = tanh(x @ p.w + p.b) - y
    return float(mean(d * d))
}

with <p: Linear>
func main(x: f32[5, 3], y: f32[5, 4]): (float, Linear) {
    let vg = with_grad(loss)<p>(x, y)
    return (vg.0, sgd(p, vg.1, 0.1))
}
