/**
 * Weights as `with` parameters, data as ordinary parameters. Exported without values, every
 * leaf of the weights is a model input (`p_fc_w`, `p_fc_b`, before the data). Exported with
 * `--arg p=<dir>`, the weights are constants of the graph and become initializers.
 */

import { tanh } from tensor

type Linear = { w: f32[3, 4], b: f32[4] }
type Model = { fc: Linear }

with <p: Linear>
func linear(x: f32[..]): f32[..] {
    return x @ p.w + p.b
}

with <p: Model>
func main(x: f32[?, 3]): f32[..] {
    return x->linear<p.fc>->tanh
}
