/**
 * A loop whose depth depends on the model input, with weights READ FROM A FILE into a captured
 * struct: the forward (state, counter) and the gradient of a loss over the state with respect
 * to the weights, exported with a dynamic batch axis. The declared type of the weights says
 * nothing (`{ w: Tensor }`); the export gives the captured constant the element type and shape
 * its value has. Without that the body of the loop knew less about the weights than the place
 * calling it, and the export's simplification unrolled the recursion until it ran out of
 * memory ("Runtime draft encoding failed to allocate ... bytes").
 *
 * Reads w.npy and x.npy from the working directory, writes the native results next to them,
 * and exports when ONNX_OUT is set.
 */
module ort_loop_loaded_weights

import { Tensor, load_npy, reshape, save_npy, sum, tanh } from tensor
import { value_and_grad } from autodiff
import { export_model } from onnx
import { get_env } from sys

type P = { w: Tensor }

with <m: P>
func walk(h: Tensor, k: int): (Tensor, int) {
    return if k >= 6 || sum(h * h) < 1.0 then (h, k) else walk<m>(tanh(h @ m.w) * 0.3 + h * 0.6, k + 1)
}

with <m: P>
func loss(x: Tensor): float {
    let (h, k) = walk<m>(x, 0)
    return sum(h * h)
}

with <m: P>
func step(x: Tensor): (Tensor, int, Tensor, Tensor) {
    let (h, k) = walk<m>(x, 0)
    let g = value_and_grad(loss)<m>(x)
    return (h, k, reshape([g.0], [1]), g.1.w)
}

func main(): int sync {
    let m = { w: load_npy('w.npy') }
    let x = load_npy('x.npy')
    let r = step<m>(x)
    save_npy(r.0, 'native_0.npy')
    save_npy(reshape([r.1], [1]), 'native_1.npy')
    save_npy(r.2, 'native_2.npy')
    save_npy(r.3, 'native_3.npy')
    let exported = if get_env('ONNX_OUT') != '' then sync {
        export_model((x: Tensor): (Tensor, int, Tensor, Tensor) => step<m>(x), x, get_env('ONNX_OUT'), [0])
        1
    } else 0
    println(exported)
    return 0
}
