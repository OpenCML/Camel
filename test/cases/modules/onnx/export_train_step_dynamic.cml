/**
 * E14/T7: a training step (with_grad + sgd) exported with a dynamic batch
 * axis. The batch mean is written as sum / shape arithmetic: with dynamic_axes
 * = [0] the divisor shape(y)[0] lowers to Shape + Gather (+ Cast/Div) instead
 * of folding, and the gradient's broadcast_like becomes Expand on a Shape.
 * (The canonical mean(y*y) form cannot: its VJP emits tensor:numel, which has
 * no ONNX lowering — see export_train_step_dynamic_mean.)
 */

import { relu, sum, reshape, shape } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..] }

with <m: Mlp>
func loss(x: f32[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    return float(sum(y * y)) / float(shape(y)[0] * shape(y)[1])
}

func step(m: Mlp, x: f32[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25] as f32[], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1] as f32[], [3]),
        w2: reshape([1.0, -1.0, 0.5] as f32[], [3, 1]),
        b2: reshape([0.2] as f32[], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5, 0.25, -0.75, 1.5, 0.5] as f32[], [4, 2])
    export_model(step, (m, x), get_env('ONNX_OUT'), [0])
    println('exported')
    return 0
}
