/**
 * Level-2 (E13/T5, fixed): a training step whose data-dependent branch uses
 * DISJOINT parameter subsets per arm exports. Differentiating the branch makes
 * every arm pullback produce a full gradient struct, so the joined value is an
 * aggregate: the exporter emits one multi-output If for the gradient struct
 * (plus one If for the branch value). Loss mean(y*y), one SGD step at lr 0.01.
 */

import { relu, mean, abs, reshape, zeros } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = {
    w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..],
    w3: f32[..], b3: f32[..], wo: f32[..], bo: f32[..],
    we: f32[..], be: f32[..]
}

with <m: Mlp>
func loss(x: f32[..]): float {
    let h1 = relu(x @ m.w1 + m.b1)
    let h2 = relu(h1 @ m.w2 + m.b2)
    let y = if float(mean(abs(h2))) > 0.5 then h2 @ m.we + m.be else relu(h2 @ m.w3 + m.b3) @ m.wo + m.bo
    return float(mean(y * y))
}

func step(m: Mlp, x: f32[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape<[3, 4]>([0.5, -0.25, 0.75, -1.0, -0.5, 0.25, 0.5, -0.75, 1.0, 0.5, -0.25, -0.25] as f32[]),
        b1: zeros::<f32>([4]),
        w2: reshape<[4, 4]>([0.4, -0.3, 0.2, 0.1, -0.2, 0.5, -0.4, 0.3, 0.3, 0.1, -0.1, 0.6, -0.5, -0.4, -0.3, -0.2] as f32[]),
        b2: reshape<[4]>([0.5, 0.5, 0.5, 0.5] as f32[]),
        w3: reshape<[4, 4]>([0.3, -0.2, 0.1, 0.4, 0.2, 0.5, -0.3, -0.1, -0.4, 0.1, 0.6, 0.2, 0.1, -0.5, 0.3, -0.3] as f32[]),
        b3: reshape<[4]>([0.1, -0.1, 0.2, 0.0] as f32[]),
        wo: reshape<[4, 2]>([0.5, -0.5, 1.0, 0.25, -0.75, 0.5, 0.25, -1.0] as f32[]),
        bo: reshape<[2]>([0.2, -0.1] as f32[]),
        we: reshape<[4, 2]>([1.0, 0.5, -0.5, 1.0, 0.75, -0.25, 0.0, 0.5] as f32[]),
        be: reshape<[2]>([0.1, 0.2] as f32[])
    }
    let x = reshape<[2, 3]>([1.0, 2.0, -1.0, 0.5, -1.5, 2.0] as f32[])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(step, (m, x))
    println('exported')
    return 0
}
