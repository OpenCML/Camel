/**
 * A tail recursion whose depth depends on the model input and whose state is ONE tuple argument
 * that every call replaces. A loop carries tensors and scalars, so the tuple is flattened into
 * one carried value per element at the loop's entry and rebuilt at both ends (the outline,
 * item 3); the model has one Loop and the tuple's two values as outputs.
 */
module export_loop_tuple_argument
import { reshape, sum, tanh } from tensor
import { export_model } from onnx
import { get_env } from env

func walk(s: (float[..], int)): (float[..], int) {
    return if s.1 >= 6 || sum(s.0 * s.0) < 1.0 then s else walk((tanh(s.0) * 0.3 + s.0 * 0.6, s.1 + 1))
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    println(walk((x, 0)).1)
    export_model((x: float[..]): (float[..], int) => walk((x, 0)), (x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}