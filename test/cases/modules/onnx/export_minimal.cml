/**
 * The smallest function a model can be: one input-dependent product, exported by the runtime
 * operator. The export simplifies a private copy of the bound function (`rules::simplify` is its
 * algebraic stage), and that copy is not a version of the running program: a checked commit there
 * must not compare it with the program that is running.
 */

import { reshape } from tensor
import { export_model } from onnx
import { get_env } from env

func f(x: float[..]): float[..] {
    return x * 2.0
}

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(f, x)
    println('exported')
    return 0
}