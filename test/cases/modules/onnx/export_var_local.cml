/**
 * A variable declared, assigned and read directly in the exported function is only a name for a sequence of values: the export contains Mul, Add, Relu and no state.
 */
import { reshape, relu } from tensor
import { export_model } from onnx
import { get_env } from env

func forward(x: float[...]): float[...] sync {
    var acc = x * 2.0
    acc = acc + 1.0
    acc = relu(acc)
    return acc
}

func main(): string! sync {
    let x = reshape<[2, 2]>([1.0, -2.0, 3.0, 4.0])
    return match export_model<out: get_env('ONNX_OUT') ?? ''>((x: float[...]): float[...] => forward(x), x) {
        case error e => { return e }
        case v => 'exported'
    }
}
