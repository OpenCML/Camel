/**
 * The gradient of batched matrix products on doubles, exported.
 *
 * Both products of the loss transpose an operand in their backward pass (`dy @ b^T` and
 * `a^T @ dy`), and `a @ v` adds the batched-by-vector shape, whose gradient is a transposed
 * product with one rank-2 operand. On onnxruntime-cpu at its default optimisation level the
 * plain MatMul beside a Transpose is fused into com.microsoft.FusedMatMul, an operator the CPU
 * provider has a kernel for on float alone: a model written that way is valid ONNX and refuses
 * to load. The lowering writes every one of these as Gemm (rank 2) or Einsum (batched), so the
 * model opens and runs; ort_grad_matmul_batched.py checks the values against NumPy.
 */

import { reshape, sum } from tensor
import { with_grad } from autodiff
import { export_model } from onnx
import { get_env } from env

type P = { a: float[..], b: float[..], v: float[..] }

with <m: P>
func loss(x: float[..]): float {
    let p = m.a @ m.b      // [2, 2, 3] @ [2, 3, 2] -> [2, 2, 2]
    let q = m.a @ m.v      // [2, 2, 3] @ [3]       -> [2, 2]
    return float(sum(p * x)) + float(sum(q * q))
}

func step(m: P, x: float[..]): (float, P) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, vg.1)
}

func main(): int sync {
    let m = {
        a: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25, 0.125, -0.375, 0.625, -0.125, 0.875, -0.75], [2, 2, 3]),
        b: reshape([1.0, -1.0, 0.5, 0.25, -0.75, 0.125, 0.375, -0.5, 1.25, 0.75, -0.25, 0.5], [2, 3, 2]),
        v: reshape([0.1, -0.2, 0.3], [3])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5, 0.25, -0.75, 1.5, -0.5], [2, 2, 2])
    let r = step(m, x)
    println(r.0)
    println(r.1.a)
    println(r.1.b)
    println(r.1.v)
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(step, (m, x))
    println('exported')
    return 0
}