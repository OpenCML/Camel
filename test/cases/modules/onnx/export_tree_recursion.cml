/**
 * Refused: a function that calls itself twice on one path (tree recursion) with a depth that
 * depends on the model input. Unrolling doubles the graph with every level; the export says so
 * at the second recursive call instead of failing with an allocation error.
 */
import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func tree(h: float[..]): float[..] {
    return if float(sum(h)) < 1.0 then h else tree(h * 0.5) + tree(h * 0.25)
}

func main(): void! sync {
    let x = reshape<[2, 2]>([1.0, 2.0, 3.0, 4.0])
    export_model<out: get_env('ONNX_OUT') ?? ''>((x: float[..]): float[..] => tree(x), x)
}
