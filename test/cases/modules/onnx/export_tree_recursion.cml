/**
 * Refused: a function that calls itself twice on one path (tree recursion) with a depth that
 * depends on the model input. Unrolling doubles the graph with every level; the export says so
 * at the second recursive call instead of failing with an allocation error.
 */
module export_tree_recursion
import { Tensor, reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func tree(h: Tensor): Tensor {
    return if sum(h) < 1.0 then h else tree(h * 0.5) + tree(h * 0.25)
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    export_model((x: Tensor): Tensor => tree(x), x, get_env('ONNX_OUT'))
    println('exported')
    return 0
}
