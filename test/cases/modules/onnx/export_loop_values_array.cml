/**
 * Exported: a tail recursion whose depth depends on the model input returns, next to its state,
 * an int array built from the counter. `[k, k + 1]` is two elements on every round, so the shape
 * of what the Loop hands out does not change from one call to the next — the fact the ruling of
 * 2026-10-24-evening asks for (growable-array-vs-tensor-in-the-onnx-exporter) — and the model is
 * written. The last statement reads `ks[1]` out of the returned array, which is 7 at k = 6.
 */
module export_loop_values_array
import { Tensor, reshape, sum, tanh } from tensor
import { export_model } from onnx
import { get_env } from env

func walk(h: Tensor, k: int): (Tensor, int[]) {
    return if k >= 6 || sum(h * h) < 1.0 then (h, [k, k + 1]) else walk(tanh(h) * 0.3 + h * 0.6, k + 1)
}

func model(x: Tensor): (Tensor, int) {
    let (h, ks) = walk(x, 0)
    return (h, ks[1])
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    let r = model(x)
    println(r.1)
    export_model((x: Tensor): (Tensor, int) => model(x), (x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}
