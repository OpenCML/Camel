/**
 * The model cannot be written (a component of the path, package.json, is a file): the refusal is reported at the
 * export_model call (line 11).
 */
module bad_path

import { Tensor, reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    export_model((t: float[..]): float[..] => t * 2.0, reshape([1.0, 2.0], [2]), 'package.json/refusal_path.onnx')
    return 0
}
