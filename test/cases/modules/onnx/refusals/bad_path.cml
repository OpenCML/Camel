/**
 * The model cannot be written (a component of the path, package.json, is a file): the refusal is reported at the
 * export_model call (line 11).
 */

import { reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    let _ = export_model<out: 'package.json/refusal_path.onnx'>((t: float[..]): float[..] => t * 2.0, reshape([1.0, 2.0], [2]))
    return 0
}
