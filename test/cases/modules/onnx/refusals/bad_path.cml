/**
 * The model cannot be written (a component of the path, package.json, is a file): the refusal
 * is reported when the pass writes the file. The case used to name the exported function in an
 * export_model call; the thin stage form translates the program the command line hands it, so
 * the program itself is the model.
 */

import { reshape } from tensor

func main() => f32[2] sync {
    return reshape<[2]>([1.0, 2.0] as f32[])
}