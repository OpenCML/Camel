/**
 * Exported after inlining: the variable is passed to a call that assigns it, but the inliner
 * copies that call into the exported function first, so the variable becomes local to the
 * function and its content is no longer state outside the model. The refusal this case used
 * to exercise (a variable read or assigned outside the function that declares it) is still
 * covered by `var_outer.cml`, whose lambda reads a variable of the enclosing function.
 */
module var_param
import { Tensor, reshape } from tensor
import { export_model } from onnx
import { get_env } from env

sync func bump(var acc: Tensor): int sync {
    acc = acc + 1.0
    return 0
}

func forward(x: Tensor): Tensor sync {
    var acc = x * 2.0
    wait bump(acc)
    return acc
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 4.0], [2, 2])
    export_model((x: Tensor): Tensor => forward(x), x, get_env('ONNX_OUT'))
    println('exported')
    return 0
}