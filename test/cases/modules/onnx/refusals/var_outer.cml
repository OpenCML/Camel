/**
 * Refused: the exported function reads a variable of the enclosing function (state outside the model).
 */
import { reshape } from tensor
import { export_model } from onnx
import { get_env } from env

func main(): int sync {
    let x = reshape<[2, 2]>([1.0, -2.0, 3.0, 4.0])
    var state = reshape<[2, 2]>([10.0, 10.0, 10.0, 10.0])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((x: float[..]): float[..] => x + state, x)
    println('exported')
    return 0
}
