/**
 * A branch on a condition that depends on the model input whose arms yield functions: `build`
 * returns either a function that adds `h` or one that multiplies by it. A model has no function
 * values: the export is refused at the branch (line 14), saying so. It used to stop with "the
 * dtype of 'arm_out' is not known statically".
 *
 */
module function_branch

import { reshape, sum } from tensor
import { export_model } from onnx

func build(h: float[..]): (x: float[..]) => float[..] {
    return if float(sum(h * h)) < 1.0 then (x: float[..]): float[..] => x + h else (x: float[..]): float[..] => x * h
}

func twice(h: float[..], g: (x: float[..]) => float[..]): (x: float[..]) => float[..] {
    return (x: float[..]): float[..] => g(g(x)) * 0.5 + h
}

func model(x: float[..]): float[..] {
    let f = build(x)
    return f(x)
}

func main(): void! sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    export_model<out: 'tmp/test/onnx/refusal_function_branch.onnx'>((x: float[..]): float[..] => model(x), x)
}
