/**
 * The parameter out of onnx::export_model names one model file; a program with two export_model calls is refused by
 * onnx::export_model, at the second call (line 14).
 */

import { model, save } from onnx
import { reshape } from tensor

func main() => int sync {
    let x = reshape<[2]>([1.0, 2.0])
    let a = model(func (t: float[...]) => float[...] {
        t * 2.0
    }, x)->save<out: 'tmp/test/onnx/refusal_a.onnx'>
    println(1)
    let b = model(func (t: float[...]) => float[...] {
        t * 3.0
    }, x)->save<out: 'tmp/test/onnx/refusal_b.onnx'>
    match a {
        case error e => sync {
            println(e)
            0
        }
        case _ => 0
    }
    match b {
        case error e => sync {
            println(e)
            0
        }
        case _ => 0
    }
    return 0
}
