/**
 * The parameter out of onnx::export names one model file; a program with two export_model calls is refused by
 * onnx::export, at the second call (line 14).
 */
module two_calls

import { Tensor, reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    export_model((t: Tensor): Tensor => t * 2.0, x, 'tmp/test/onnx/refusal_a.onnx')
    println(1)
    export_model((t: Tensor): Tensor => t * 3.0, x, 'tmp/test/onnx/refusal_b.onnx')
    return 0
}
