/**
 * The parameter out of onnx::export names one model file; a program with two export_model calls is refused by
 * onnx::export, at the second call (line 14).
 */
module two_calls

import { reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let _ = export_model<out: 'tmp/test/onnx/refusal_a.onnx'>((t: float[..]): float[..] => t * 2.0, x)
    println(1)
    let _ = export_model<out: 'tmp/test/onnx/refusal_b.onnx'>((t: float[..]): float[..] => t * 3.0, x)
    return 0
}
