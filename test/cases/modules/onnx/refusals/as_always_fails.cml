/**
 * `as` on a value that depends on the model input, asserting a shape the exported inputs
 * contradict ([2, 3] where the conversion says [3, 2]): the export is refused at the
 * conversion (line 12); it was exported as if the conversion were not there.
 */
module as_always_fails

import { Tensor, reshape, tanh } from tensor
import { export_model } from onnx

func f(x: Tensor): Tensor {
    let y = tanh(x) as Tensor<f32, [3, 2]>
    return y * 2.0
}

func main(): int sync {
    let ex = reshape([1.0, -1.0, 0.5, 2.0, 3.0, -2.0] as f32[], [2, 3])
    export_model(f, ex, 'tmp/test/onnx/refusal_as_always_fails.onnx')
    return 0
}
