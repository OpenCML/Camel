/**
 * A dynamic axis out of range is an error about the pass's own parameter, not about a node of
 * the program: the pass reports it when it translates the program. The case used to name the
 * exported function in an export_model call; the thin stage form translates the program the
 * command line hands it (D-1127-213, form 乙).
 */

import { reshape } from tensor

func main() => f32[2] sync {
    return reshape<[2]>([1.0, 2.0] as f32[])
}