/**
 * A dynamic axis out of range is an error about the request, not about a node of the
 * function: onnx::export_model reports it at the export_model call (line 11).
 */

import { model, save } from onnx
import { reshape } from tensor

func main() => int sync {
    let r = model<dynamic_axes: [5]>(func (t: float[...]) => float[...] {
        t * 2.0
    }, reshape<[2]>([1.0, 2.0]))->save<out: 'tmp/test/onnx/refusal_axis.onnx'>
    return match r {
        case error e => sync {
            println(e)
            return 1
        }
        case _ => sync {
            println('exported')
            return 0
        }
    }
}
