/**
 * The same function measured in two splice shapes. `main` calls `combine`, and one pipeline
 * (std::opt::fold then devirtualize then inline) has spliced `combine` into `main` before the
 * inliner examines the call of `main`, while the other (std::opt, whose rewrite rounds run
 * between its folding stages) examines it first. The export refusal reports the size of `main`,
 * and the size is fixed to the compute nodes of the function being
 * inlined, so both pipelines must report the same one (before the change they reported 11 and
 * 15: the copy of `combine` that had been spliced in, two OPERs behind its own region, and the
 * three GATEs the splice adds for its arguments were counted).
 */

import { reshape } from tensor
import { export_model } from onnx
import { cpu_count } from process

func double(t: float[..]): float[..] {
    return t * 2.0
}

func combine(a: int, b: int, c: int): int {
    return a + b + c
}

func spin(n: int): int sync {
    println(n)
    return if n <= 0 then 0 else spin(n - 1)
}

func main(): int sync {
    let _ = export_model<out: 'tmp/test/onnx/compute_nodes_two_shapes.onnx'>(double, reshape<[2]>([1.0, 2.0]))
    let x = cpu_count()
    println(x)
    println('before')
    let v = combine(x, x, x)
    println(v)
    println(x)
    println(v)
    println(x)
    return spin(x)
}