/**
 * Two examples for a one-parameter function... the example tuple is one argument; a
 * two-parameter function given one example is refused at the export_model call (line 11).
 */

import { model, save } from onnx
import { reshape } from tensor

func main() => int sync {
    let r = model(func (a: float[...], b: float[...]) => float[...] {
        a + b
    }, reshape<[2]>([1.0, 2.0]))->save<out: 'tmp/test/onnx/refusal_arity.onnx'>
    return match r {
        case error e => sync {
            println(e)
            return 1
        }
        case _ => sync {
            println('exported')
            return 0
        }
    }
}
