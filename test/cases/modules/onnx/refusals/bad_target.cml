/**
 * An unknown export target is an error about the request: reported at the export_model call
 * (line 11).
 */

import { model, save } from onnx
import { reshape } from tensor

func main() => int sync {
    let r = model<dynamic_axes: [0], target: 'no_such_target'>(func (t: float[...]) => float[...] {
        t * 2.0
    }, reshape<[2]>([1.0, 2.0]))->save<out: 'tmp/test/onnx/refusal_target.onnx'>
    return match r {
        case error e => sync {
            println(e)
            return 1
        }
        case _ => sync {
            println('exported')
            return 0
        }
    }
}
