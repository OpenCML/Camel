import { export_model } from onnx

func main(): int sync {
    let _ = export_model<out: 'tmp/test/onnx/refusal_target.onnx', dynamic_axes: [0], target: 'no_such_target'>((t: float[..]): float[..] => t * 2.0, reshape([1.0, 2.0], [2]))
