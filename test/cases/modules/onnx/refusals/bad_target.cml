/**
 * An unknown export target is an error about the request: reported at the export_model call
 * (line 11).
 */
module bad_target

import { reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    export_model((t: float[..]): float[..] => t * 2.0, reshape([1.0, 2.0], [2]), 'tmp/test/onnx/refusal_target.onnx', [0], 'no_such_target')
    return 0
}
