/**
 * An unknown export target is an error about the request: reported at the export_model call
 * (line 11).
 */

import { reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    let r = export_model<out: 'tmp/test/onnx/refusal_target.onnx', dynamic_axes: [0], target: 'no_such_target'>((t: float[...]): float[...] => t * 2.0, reshape<[2]>([1.0, 2.0]))
    return match r {
        case error e => sync {
            println(e)
            return 1
        }
        case _ => sync {
            println('exported')
            return 0
        }
    }
}
