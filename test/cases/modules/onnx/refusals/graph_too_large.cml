/**
 * A function too large for one runtime graph once every call in it is inlined: `f13` calls
 * `f12` twice, which calls `f11` twice, and so on down to `f0`, about 2^13 copies of each of
 * three operators. A graph addresses its edges with 16 bits (65535 of them), and the export
 * inlines everything (ONNX has no calls). onnx::export refuses at the
 * export_model call (line 72) and names the graph, the quantity, the size reached and the
 * limit; it used to stop with the unlocated internal error "Draft runtime edge arena size
 * exceeds the target integral width".
 */
module graph_too_large

import { Tensor, reshape } from tensor
import { export_model } from onnx

func f0(t: Tensor): Tensor {
    return t + 1.0
}

func f1(t: Tensor): Tensor {
    return f0(t * 2.0) + f0(t * 3.0)
}

func f2(t: Tensor): Tensor {
    return f1(t * 2.0) + f1(t * 3.0)
}

func f3(t: Tensor): Tensor {
    return f2(t * 2.0) + f2(t * 3.0)
}

func f4(t: Tensor): Tensor {
    return f3(t * 2.0) + f3(t * 3.0)
}

func f5(t: Tensor): Tensor {
    return f4(t * 2.0) + f4(t * 3.0)
}

func f6(t: Tensor): Tensor {
    return f5(t * 2.0) + f5(t * 3.0)
}

func f7(t: Tensor): Tensor {
    return f6(t * 2.0) + f6(t * 3.0)
}

func f8(t: Tensor): Tensor {
    return f7(t * 2.0) + f7(t * 3.0)
}

func f9(t: Tensor): Tensor {
    return f8(t * 2.0) + f8(t * 3.0)
}

func f10(t: Tensor): Tensor {
    return f9(t * 2.0) + f9(t * 3.0)
}

func f11(t: Tensor): Tensor {
    return f10(t * 2.0) + f10(t * 3.0)
}

func f12(t: Tensor): Tensor {
    return f11(t * 2.0) + f11(t * 3.0)
}

func f13(t: Tensor): Tensor {
    return f12(t * 2.0) + f12(t * 3.0)
}

func main(): int sync {
    export_model(f13, reshape([1.0, 2.0], [2]), 'tmp/test/onnx/refusal_graph_too_large.onnx')
    return 0
}
