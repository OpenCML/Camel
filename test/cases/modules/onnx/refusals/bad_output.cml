/**
 * The result of an exported function must be a tensor or a number. A function returning a
 * string is refused at the export_model call (line 11).
 */

import { reshape } from tensor
import { export_model } from onnx

func main(): int sync {
    let _ = export_model<out: 'tmp/test/onnx/refusal_output.onnx'>((t: float[..]): string => 'text', reshape<[2]>([1.0, 2.0]))
    return 0
}
