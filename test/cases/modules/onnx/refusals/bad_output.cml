/**
 * The result of an exported function must be a tensor or a number. A function returning a
 * string is refused at the export_model call (line 11).
 */

import { model, save } from onnx
import { reshape } from tensor

func main() => int sync {
    let r = model(func (t: float[...]) => string {
        'text'
    }, reshape<[2]>([1.0, 2.0]))->save<out: 'tmp/test/onnx/refusal_output.onnx'>
    return match r {
        case error e => sync {
            println(e)
            return 1
        }
        case _ => sync {
            println('exported')
            return 0
        }
    }
}
