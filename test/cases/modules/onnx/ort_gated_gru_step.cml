/**
 * The training step of export_gated_gru_step.cml (the same functions, kept in step with it),
 * run natively: loads the weights from the directory PARAMS (one .npy per field) and the input
 * from X, and writes the loss to OUT/loss.npy and the updated weights to OUT/params.
 * Driven by ort_gated_gru_step.py.
 */
module ort_gated_gru_step

import { Tensor, sigmoid, tanh, slice, reshape, shape, zeros, mean, abs, load_npy, save_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env

type Gru = {
    w_ir: f32[..], w_iz: f32[..], w_in: f32[..],
    w_hr: f32[..], w_hz: f32[..], w_hn: f32[..],
    b_ir: f32[..], b_iz: f32[..], b_in: f32[..],
    b_hr: f32[..], b_hz: f32[..], b_hn: f32[..],
    fc_w: f32[..], fc_b: f32[..]
}

with <m: Gru>
func cell(xt: f32[..], h: f32[..]): f32[..] {
    let r = sigmoid(xt @ m.w_ir + m.b_ir + h @ m.w_hr + m.b_hr)
    let z = sigmoid(xt @ m.w_iz + m.b_iz + h @ m.w_hz + m.b_hz)
    let n = tanh(xt @ m.w_in + m.b_in + r * (h @ m.w_hn + m.b_hn))
    return (1.0 - z) * n + z * h
}

with <m: Gru, x: f32[..]>
func gated(t: int, h: f32[..]): f32[..] {
    let xt = reshape(slice(x, 1, t, t + 1), [shape(x)[0], shape(x)[2]])
    return if mean(abs(xt)) > 0.5 then cell<m>(xt, h) else h
}

with <m: Gru, x: f32[..]>
func run(t: int, steps: int, h: f32[..]): f32[..] {
    return if t >= steps then h else run<m, x>(t + 1, steps, gated<m, x>(t, h))
}

with <m: Gru>
func loss(x: f32[..]): float {
    let h = run<m, x>(0, shape(x)[1], zeros([shape(x)[0], shape(m.w_hr)[0]]))
    let y = h @ m.fc_w + m.fc_b
    return float(mean(y * y))
}

func step(m: Gru, x: f32[..]): (float, Gru) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func loaded(dir: string): Gru {
    return {
        w_ir: load_npy::<f32>(dir + '/w_ir.npy'), w_iz: load_npy::<f32>(dir + '/w_iz.npy'), w_in: load_npy::<f32>(dir + '/w_in.npy'),
        w_hr: load_npy::<f32>(dir + '/w_hr.npy'), w_hz: load_npy::<f32>(dir + '/w_hz.npy'), w_hn: load_npy::<f32>(dir + '/w_hn.npy'),
        b_ir: load_npy::<f32>(dir + '/b_ir.npy'), b_iz: load_npy::<f32>(dir + '/b_iz.npy'), b_in: load_npy::<f32>(dir + '/b_in.npy'),
        b_hr: load_npy::<f32>(dir + '/b_hr.npy'), b_hz: load_npy::<f32>(dir + '/b_hz.npy'), b_hn: load_npy::<f32>(dir + '/b_hn.npy'),
        fc_w: load_npy::<f32>(dir + '/fc_w.npy'), fc_b: load_npy::<f32>(dir + '/fc_b.npy')
    }
}

func main(): int sync {
    let r = step(loaded(get_env('PARAMS')), load_npy::<f32>(get_env('X')))
    save_npy(reshape([r.0], [1]), get_env('OUT') + '/loss.npy')
    save_params(r.1, get_env('OUT') + '/params')
    println('ran')
    return 0
}
