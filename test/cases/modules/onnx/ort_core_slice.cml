/**
 * The core's own slice exported to ONNX: `t[a:b:s]` is `:op/slice_sub`, the node the `[]` forms
 * build for any rank and any axis (design principles 5.4).
 *
 * The mask word of the node says which bounds the source wrote; the exporter reads it and never
 * writes it to the graph, and the step and the axis are words of the node too.
 *
 *   MODE=both    m[1:3]     both bounds constant on an axis whose extent is only known at run
 *                           time (a reshape to a data-dependent shape): the write site cannot
 *                           prove them, so the bounds are guarded and a run whose axis is
 *                           shorter than 3 fails where Camel faults.
 *   MODE=open    m[2:]      the end is not written: the mask says so and the end is the axis' own
 *                           extent, which ONNX reads from the value's shape.
 *   MODE=start   x[int(sum(x)) :]   the start depends on the model input: a position the axis has
 *                           or the axis' own extent, and the negative side is where ONNX would
 *                           read a position from the end where Camel faults.
 *   MODE=rank2   reshape(x, [2, 2])[1:2]   the sliced axis is not the only axis.
 *   MODE=known   reshape(x, [4])[1:3]      both bounds and the extent are constants: the raw
 *                           bounds go to the ONNX Slice with no guard.
 *   MODE=step    reshape(x, [4])[0:4:2]    a step of its own, still a subscript.
 *
 * Checked by ort_core_slice.py.
 */
module ort_core_slice
import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

/// A row count from the data: every input the checker gives sums to 1, 2 or 4, so the reshape
/// keeps its four elements and the extent of axis 0 is what the data says.
func rows(x: f32[..]): f32[..] {
    return reshape(x, [int(sum(x)), int(4.0 / sum(x))])
}

func both(x: f32[..]): f32[..] {
    return rows(x)[1:3]
}

func openEnd(x: f32[..]): f32[..] {
    return rows(x)[2:]
}

func runtimeStart(x: f32[..]): f32[..] {
    return x[int(sum(x)):]
}

func rank2(x: f32[..]): f32[..] {
    return reshape(x, [2, 2])[1:2]
}

func known(x: f32[..]): f32[..] {
    return reshape(x, [4])[1:3]
}

func stepped(x: f32[..]): f32[..] {
    return reshape(x, [4])[0:4:2]
}

func main(): int sync {
    let x = reshape([1.0, 1.0, 1.0, 1.0] as f32[], [4])
    let out = get_env('ONNX_OUT')
    let mode = get_env('MODE')
    if mode == 'open' then {
        export_model((x: f32[..]): f32[..] => openEnd(x), x, out)
    } else if mode == 'start' then {
        export_model((x: f32[..]): f32[..] => runtimeStart(x), x, out)
    } else if mode == 'rank2' then {
        export_model((x: f32[..]): f32[..] => rank2(x), x, out)
    } else if mode == 'known' then {
        export_model((x: f32[..]): f32[..] => known(x), x, out)
    } else if mode == 'step' then {
        export_model((x: f32[..]): f32[..] => stepped(x), x, out)
    } else {
        export_model((x: f32[..]): f32[..] => both(x), x, out)
    }
    println('exported')
    return 0
}