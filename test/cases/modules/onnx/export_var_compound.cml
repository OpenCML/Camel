/**
 * Local variables of scalar types with typed and compound assignments (`k += 2`, `s *= 2.0`):
 * each read is the value the chain of assignments gives; the integer one folds to a constant.
 * Camel prints tensor([[18, -18], [42, 54]]) for the example input; the exported model gives
 * x * ((0.5 + sum(x)) * 2 - 1) + 6 on ONNX Runtime (checked by hand for two inputs). The float
 * variable is f64 while the tensor is f32, so each scalar is converted to the tensor's element
 * type where it meets it -- `f32(s)`, `f32(k)` -- and the graph carries the Cast for it (P4: the
 * conversion is written, not assumed).
 */
import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func forward(x: f32[..]): f32[..] sync {
    var k = 1
    k += 2
    var s = 0.5
    s += float(sum(x))
    s *= 2.0
    k = k * 2
    s -= 1.0
    return x * f32(s) + f32(k)
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 4.0] as f32[], [2, 2])
    println(forward(x))
    export_model((x: f32[..]): f32[..] => forward(x), x, get_env('ONNX_OUT') ?? '')
    println('exported')
    return 0
}
