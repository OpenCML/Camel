/**
 * Local variables of scalar types with typed and compound assignments (`k += 2`, `s *= 2.0`):
 * each read is the value the chain of assignments gives; the integer one folds to a constant.
 * Camel prints tensor([[18, -18], [42, 54]]) for the example input; the exported model gives
 * x * ((0.5 + sum(x)) * 2 - 1) + 6 on ONNX Runtime (checked by hand for two inputs).
 */
module export_var_compound
import { Tensor, reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from sys

func forward(x: Tensor): Tensor sync {
    var k = 1
    k += 2
    var s = 0.5
    s += sum(x)
    s *= 2.0
    k = k * 2
    s -= 1.0
    return x * s + float(k)
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 4.0], [2, 2])
    println(forward(x))
    export_model((x: Tensor): Tensor => forward(x), x, get_env('ONNX_OUT'))
    println('exported')
    return 0
}
