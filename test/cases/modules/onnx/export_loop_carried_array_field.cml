/**
 * Refused for a reason of this exporter's own: a tail recursion whose depth depends on the model
 * input carries a struct with an `int[]` field the body appends to, and this exporter does not yet
 * carry an array whose length changes between rounds as an ONNX sequence -- it names the field, an
 * int array, says that, and writes no model file. The premise this refusal once rested on is
 * retracted; when the export turns positive this case turns over and asserts the exported model.
 */
import { get_env } from env
import { export_model } from onnx
import { reshape, sum } from tensor

type State = { xs: int[], k: int }

func walk(x: float[...], s: State) => float[...] {
    return if s.k >= 3 || float(sum(x * x)) < 1.0 then x * 2.0 else walk(x, { xs: s.xs->append<s.k>, k: s.k + 1 })
}

func main() => void! sync {
    let x = reshape<[2, 2]>([1.0, 2.0, 3.0, 4.0])
    println(len([0]))
    export_model<out: get_env('ONNX_OUT') ?? ''>(func (x: float[...]) => float[...] {
        walk(x, { xs: [0], k: 0 })
    }, (x))
}
