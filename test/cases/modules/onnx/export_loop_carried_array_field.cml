/**
 * Refused: a tail recursion whose depth depends on the model input and whose carried state is a
 * struct with an `int[]` field the body appends to. A Loop's state input has one shape for all its
 * rounds, and the ruling of 2026-10-24-evening (growable-array-vs-tensor-in-the-onnx-exporter) makes
 * that the criterion: the body appends to this value, so its length changes from one round to the
 * next — the diagnostic names the array field, an int array, and says so; no model file is written.
 */
module export_loop_carried_array_field
import { Tensor, reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

type State = { xs: int[], k: int }

func walk(x: float[..], s: State): float[..] {
    return if s.k >= 3 || float(sum(x * x)) < 1.0 then x * 2.0
        else walk(x, { xs: s.xs->append<s.k>, k: s.k + 1 })
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    println(len([0]))
    export_model((x: float[..]): float[..] => walk(x, { xs: [0], k: 0 }), (x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}