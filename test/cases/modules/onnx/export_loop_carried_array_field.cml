/**
 * Refused: a tail recursion whose depth depends on the model input and whose carried state is a
 * struct with an `int[]` field. The ruling of 2026-10-23 keeps this refusal —
 * 「(b) ONNX 导出对带数组字段的携带状态保持拒绝，等原生多维数组（H17 第 2、4 项）把形状的说法定下来
 * 再处理定长数组。」 — so the diagnostic names the array field and says what is missing, and no
 * model file is written.
 */
module export_loop_carried_array_field
import { Tensor, reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

type State = { xs: int[], k: int }

func walk(x: Tensor, s: State): Tensor {
    return if s.k >= 3 || sum(x * x) < 1.0 then x * 2.0
        else walk(x, { xs: s.xs->append<s.k>, k: s.k + 1 })
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    println(len([0]))
    export_model((x: Tensor): Tensor => walk(x, { xs: [0], k: 0 }), (x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}