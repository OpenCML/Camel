/**
 * A training step whose loss takes a data-dependent branch (the arm is chosen
 * by a runtime value computed from the input) exports as one ONNX graph:
 * with_grad differentiates through the branch, the per-arm pullbacks are
 * devirtualized across the JOIN, and the branch becomes standard If
 * operators. The parameters (a struct) and the input are graph inputs; the
 * loss and the SGD-updated parameters are graph outputs.
 */
module export_train_step_branch

import { relu, mean, reshape } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..] }

with <m: Mlp>
func loss(x: f32[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    let s = float(mean(y * y))
    return if s > 1.0 then s * 2.0 else s
}

func step(m: Mlp, x: f32[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25] as f32[], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1] as f32[], [3]),
        w2: reshape([1.0, -1.0, 0.5] as f32[], [3, 1]),
        b2: reshape([0.2] as f32[], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5] as f32[], [2, 2])
    export_model(step, (m, x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}
