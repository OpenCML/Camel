/**
 * Level-2 boundary (E13/T5): a training step whose loss takes a data-dependent
 * branch with TENSOR arms currently cannot be exported. Differentiating the
 * branch captures the input-dependent predicate in a pullback closure, and the
 * exporter folds input-dependent values only out of tuples/structs, not
 * closures — the fold failure is reported at the predicate's source position.
 * This case locks the boundary: when the gap is fixed, flip it to a positive
 * export case.
 */
module export_train_step_branch_tensor

import { Tensor, relu, mean, reshape } from tensor
import { value_and_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from sys

type Mlp = { w1: Tensor, b1: Tensor, w2: Tensor, b2: Tensor }

with <m: Mlp>
func loss(x: Tensor): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    let s = mean(y * y)
    let z = if s > 1.0 then y * 2.0 else y
    return mean(z * z)
}

func step(m: Mlp, x: Tensor): (float, Mlp) {
    let vg = value_and_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1], [3]),
        w2: reshape([1.0, -1.0, 0.5], [3, 1]),
        b2: reshape([0.2], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5], [2, 2])
    export_model(step, (m, x), get_env('ONNX_OUT'))
    println('unreachable')
    return 0
}
