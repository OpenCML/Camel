/**
 * Level-2 (E13/T5, fixed): a training step whose loss takes a data-dependent
 * branch with TENSOR arms exports. Differentiating the branch captures the
 * input-dependent arm value in a pullback closure, and the pullback is called
 * with a cotangent computed after the branch JOIN; the branched-call split
 * (export-only) calls each arm's closure with the original arguments and
 * lifts the captures to trailing parameters, producing one If for the branch
 * value and one for the pullback result.
 */
module export_train_step_branch_tensor

import { relu, mean, reshape } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: float[..], b1: float[..], w2: float[..], b2: float[..] }

with <m: Mlp>
func loss(x: float[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    let s = float(mean(y * y))
    let z = if s > 1.0 then y * 2.0 else y
    return float(mean(z * z))
}

func step(m: Mlp, x: float[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1], [3]),
        w2: reshape([1.0, -1.0, 0.5], [3, 1]),
        b2: reshape([0.2], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5], [2, 2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(step, (m, x))
    println('exported')
    return 0
}
