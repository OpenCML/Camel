/**
 * Tail recursion whose depth depends on the model input cannot be unrolled at
 * export time; it is exported as an ONNX Loop over the changing argument.
 */

import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func shrink(t: f32[..]): f32[..] {
    return if sum(t) > 1.0 then shrink(t * 0.5) else t
}

func main(): int sync {
    let x = reshape<[2, 2]>([1.0, 2.0, 3.0, 4.0] as f32[])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((t: f32[..]): f32[..] => shrink(t), x)
    println('exported')
    return 0
}
