/**
 * The export request that gives `out` and `dynamic_axes`: the batch extent of the input is not
 * baked in, so the model's first dimension is symbolic while `target` stays at its default.
 */

import { reshape } from tensor
import { export_model } from onnx
import { get_env } from env

func f(x: f32[2, 2]): f32[2, 2] {
    return x * 2.0
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0] as f32[], [2, 2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? '', dynamic_axes: [0]>(f, x)
    println('exported')
    return 0
}