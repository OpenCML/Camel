/**
 * The export request that gives `out` and `target` and skips the parameter between them: a
 * named argument jumps over a parameter that has a default (the `dynamic_axes` of the
 * declaration keeps its default, so no axis is left dynamic).
 */
module with_forms_only_target

import { reshape } from tensor
import { export_model } from onnx
import { get_env } from env

func f(x: f32[2, 2]): f32[2, 2] {
    return x * 2.0
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0] as f32[], [2, 2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? '', target: 'none'>(f, x)
    println('exported')
    return 0
}