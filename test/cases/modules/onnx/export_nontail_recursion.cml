/**
 * Refused: the recursive call is not in tail position (its result is used after it returns),
 * so the recursion is not a loop over its arguments.
 */
module export_nontail_recursion
import { Tensor, reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from sys

// Not a loop: the recursive call's result is used (added to) after it returns.
func pile(h: Tensor): Tensor {
    return if sum(h) < 1.0 then h else pile(h * 0.5) + h
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    export_model((x: Tensor): Tensor => pile(x), x, get_env('ONNX_OUT'))
    println('exported')
    return 0
}
