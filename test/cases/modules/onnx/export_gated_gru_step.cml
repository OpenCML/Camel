/**
 * Level-2 (E13/T5): the training step of a recurrent network whose cell update branches on the
 * step's input (a gated GRU, T = 3) is exported. Differentiating the unrolled loop builds a
 * decision tree of (value, pullback) branches: the model holds one If per gate decision and
 * per value that depends on it, nested (the forward alone is export_gated_gru_forward).
 *
 * ort_gated_gru_step.py runs the model on ONNX Runtime for every gate pattern and compares it
 * with the native run of the same step (ort_gated_gru_step.cml holds the same functions).
 */
module export_gated_gru_step

import { sigmoid, tanh, reshape, shape, zeros, mean, abs } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Gru = {
    w_ir: f32[..], w_iz: f32[..], w_in: f32[..],
    w_hr: f32[..], w_hz: f32[..], w_hn: f32[..],
    b_ir: f32[..], b_iz: f32[..], b_in: f32[..],
    b_hr: f32[..], b_hz: f32[..], b_hn: f32[..],
    fc_w: f32[..], fc_b: f32[..]
}

with <m: Gru>
func cell(xt: f32[..], h: f32[..]): f32[..] {
    let r = sigmoid(xt @ m.w_ir + m.b_ir + h @ m.w_hr + m.b_hr)
    let z = sigmoid(xt @ m.w_iz + m.b_iz + h @ m.w_hz + m.b_hz)
    let n = tanh(xt @ m.w_in + m.b_in + r * (h @ m.w_hn + m.b_hn))
    return (1.0 - z) * n + z * h
}

with <m: Gru, x: f32[..]>
func gated(t: int, h: f32[..]): f32[..] {
    let xt = reshape(slice(x, 1, t, t + 1), [shape(x)[0], shape(x)[2]])
    return if mean(abs(xt)) > 0.5 then cell<m>(xt, h) else h
}

with <m: Gru, x: f32[..]>
func run(t: int, steps: int, h: f32[..]): f32[..] {
    return if t >= steps then h else run<m, x>(t + 1, steps, gated<m, x>(t, h))
}

with <m: Gru>
func loss(x: f32[..]): float {
    let h = run<m, x>(0, shape(x)[1], zeros([shape(x)[0], shape(m.w_hr)[0]]))
    let y = h @ m.fc_w + m.fc_b
    return float(mean(y * y))
}

func step(m: Gru, x: f32[..]): (float, Gru) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w_ir: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25] as f32[], [2, 3]),
        w_iz: reshape([0.25, 0.5, -0.75, -0.5, 1.0, 0.5] as f32[], [2, 3]),
        w_in: reshape([0.75, -0.5, 0.5, 0.25, -1.0, 0.5] as f32[], [2, 3]),
        w_hr: reshape([0.5, 0.25, -0.25, -0.5, 0.75, 0.5, 0.25, -0.75, 1.0] as f32[], [3, 3]),
        w_hz: reshape([0.25, -0.5, 0.5, 0.75, 0.5, -1.0, 0.5, 0.25, -0.25] as f32[], [3, 3]),
        w_hn: reshape([-0.5, 0.5, 0.25, 0.5, -0.75, 1.0, 0.25, 0.5, -0.5] as f32[], [3, 3]),
        b_ir: reshape([0.1, 0.0, -0.1] as f32[], [3]),
        b_iz: reshape([0.0, 0.1, 0.2] as f32[], [3]),
        b_in: reshape([-0.1, 0.2, 0.0] as f32[], [3]),
        b_hr: reshape([0.1, 0.1, 0.0] as f32[], [3]),
        b_hz: reshape([0.0, -0.1, 0.1] as f32[], [3]),
        b_hn: reshape([0.2, 0.0, -0.2] as f32[], [3]),
        fc_w: reshape([0.5, -0.5, 1.0, 0.25, -0.75, 0.5] as f32[], [3, 2]),
        fc_b: reshape([0.3, -0.2] as f32[], [2])
    }
    let x = reshape(
        [1.0, -1.0, 0.25, -0.25, 0.75, 0.5, 0.5, -0.5, -0.25, 0.25, -0.5, 1.0] as f32[],
        [2, 3, 2]
    )
    export_model(step, (m, x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}
