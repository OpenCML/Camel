/**
 * A conv net training step exports as one ONNX graph: conv2d gradients become
 * ConvTranspose (input), Conv with swapped batch/channel roles (kernel) and
 * ReduceSum (bias), and max_pool2d's gradient becomes MaxPool-with-indices
 * feeding MaxUnpool — all standard opset-17 inference operators.
 */
module export_train_step_conv

import { cast, relu, mean, reshape, flatten, new } from tensor
import { with_grad } from autodiff
import { conv2d, max_pool2d, sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Cnn = {
    conv1_w: float[..], conv1_b: float[..],
    conv2_w: float[..], conv2_b: float[..],
    fc_w: float[..], fc_b: float[..]
}

with <m: Cnn>
func loss(x: float[..]): float {
    let c1 = relu(conv2d(x, m.conv1_w, m.conv1_b, 1, 1))
    let c2 = max_pool2d(relu(conv2d(c1, m.conv2_w, m.conv2_b)), 2)
    // conv2d, max_pool2d and relu answer in f32 while this model works in f64, so the value is
    // converted where it meets the model's weights (design principles 5.1: the element type is
    // exact, and a conversion is written).
    let y = cast(flatten(c2), 'float64') @ m.fc_w + m.fc_b
    return float(mean(y * y))
}

func step(m: Cnn, x: float[..]): (float, Cnn) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        conv1_w: reshape(new([
            0.3, -0.2, 0.1, 0.4, -0.5, 0.2, 0.1, 0.6, -0.3,
            -0.1, 0.2, 0.5, -0.4, 0.3, -0.2, 0.2, -0.6, 0.4]), [2, 1, 3, 3]),
        conv1_b: new([0.1, -0.1]),
        conv2_w: reshape(new([
            0.2, 0.1, -0.3, 0.5, -0.1, 0.4, -0.2, 0.3, 0.1,
            -0.4, 0.2, 0.6, 0.1, -0.5, 0.3, 0.2, -0.1, -0.2,
            0.1, -0.3, 0.2, -0.2, 0.4, -0.6, 0.5, 0.1, 0.3,
            -0.1, 0.5, -0.4, 0.2, 0.3, -0.2, 0.6, -0.3, 0.1]), [2, 2, 3, 3]),
        conv2_b: new([0.2, 0.0]),
        fc_w: reshape(new([0.5, -0.5, 0.25, -0.75]), [2, 2]),
        fc_b: new([0.1, -0.2])
    }
    let x = reshape(new([
        0.5, -0.3, 0.2, 0.7, -0.1,
        0.4, 0.1, -0.6, 0.3, 0.2,
        -0.2, 0.6, 0.5, -0.4, 0.1,
        0.3, -0.5, 0.4, 0.2, -0.7,
        0.1, 0.2, -0.1, 0.6, 0.4]), [1, 1, 5, 5])
    export_model(step, (m, x), get_env('ONNX_OUT') ?? '')
    println('exported')
    return 0
}
