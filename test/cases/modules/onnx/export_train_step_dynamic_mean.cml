/**
 * E14/T7: the canonical batch-mean loss mean(y * y) exports with a dynamic batch
 * axis. Its VJP divides by tensor:numel, which folds to a constant for a static
 * batch and is input-dependent once the batch is symbolic; the exporter lowers
 * it to the ONNX Size of the tensor. (This used to be a documented boundary:
 * tensor:numel had no ONNX lowering.)
 */

import { relu, mean, reshape } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: float[..], b1: float[..], w2: float[..], b2: float[..] }

with <m: Mlp>
func loss(x: float[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    return float(mean(y * y))
}

func step(m: Mlp, x: float[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1], [3]),
        w2: reshape([1.0, -1.0, 0.5], [3, 1]),
        b2: reshape([0.2], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5], [2, 2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? '', dynamic_axes: [0]>(step, (m, x))
    println('exported')
    return 0
}
