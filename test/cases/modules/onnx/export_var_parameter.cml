/**
 * State handed to a function as a `var` parameter: the exported function declares the variable,
 * a called function assigns it once, and the new value is returned ("state in, state out").
 * After inlining the variable is declared, read and assigned in one function, which the
 * exporter accepts. Both routes are used: the operator, and the pass on the simplified graph.
 */
module export_var_parameter

import { Tensor, reshape, tanh } from tensor
import { export_model } from onnx
import { get_env } from env

func step(x: Tensor, var acc: Tensor): Tensor sync {
    let y = tanh(x)
    acc = acc + y
    return y * 2.0
}

func main(): int sync {
    let ex = reshape([0.5, -1.0, 0.25] as f32[], [3])
    let es = reshape([0.0, 0.0, 0.0] as f32[], [3])
    let f = (x: Tensor, s: Tensor): (Tensor, Tensor) => sync {
        var acc = s
        let o = step(x, acc)
        return (o, acc)
    }
    export_model(f, (ex, es), get_env('EXPORT_VAR_PARAMETER_OUT'))
    println('exported')
    return 0
}
