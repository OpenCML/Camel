/**
 * Refused: `tensor::fuse safe_fp=true` records `tensor.kernel=canonical` on the product (design
 * principles 7.4: the canonical algorithm, bit for bit). An ONNX MatMul leaves the accumulation
 * order to the target's kernel, so the model could not keep that promise. The export refuses at
 * the recorded attribute and writes no model, instead of dropping the choice.
 */
module export_canonical_kernel
import { reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func net(x: f32[..]): f32[..] {
    let w = reshape([0.5, -1.0, 2.0, 1.0, -0.5, 0.25] as f32[], [3, 2])
    return x @ w
}

func main(): void! sync {
    let x = reshape([1.0, -2.0, 3.0, 0.5, -1.5, 2.5] as f32[], [2, 3])
    println(sum(net(x)))
    export_model<out: get_env('ONNX_OUT') ?? ''>((x: f32[..]): f32[..] => net(x), x)
}
