/**
 * An Adam training step exports as one ONNX graph: the optimizer state (the
 * two moment trees and the step count) becomes extra graph inputs
 * (adam_m_<path>, adam_v_<path>, adam_t) and outputs, and the bias-corrected
 * update is expressed with standard tensor operators only (Pow/Sub on t+1 for
 * the corrections, Mul/Div/Sqrt per leaf) — the same pure single-step pattern
 * as the SGD export (export_train_step.cml).
 */
module export_train_step_adam

import { Tensor, relu, mean, reshape } from tensor
import { with_grad } from autodiff
import { OptimizerState, adam, adam_state } from nn
import { export_model } from onnx
import { get_env } from env

type Mlp = { w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..] }

with <m: Mlp>
func loss(x: f32[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    return mean(y * y)
}

func step(m: Mlp, st: OptimizerState, x: f32[..]): (float, Mlp, OptimizerState) {
    let vg = with_grad(loss)<m>(x)
    let next = adam(m, vg.1, st, 0.001)
    return (vg.0, next.0, next.1)
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25] as f32[], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1] as f32[], [3]),
        w2: reshape([1.0, -1.0, 0.5] as f32[], [3, 1]),
        b2: reshape([0.2] as f32[], [1])
    }
    let st = adam_state(m)
    let x = reshape([1.0, 2.0, -1.0, 0.5] as f32[], [2, 2])
    export_model(step, (m, st, x), get_env('ONNX_OUT'))
    println('exported')
    return 0
}
