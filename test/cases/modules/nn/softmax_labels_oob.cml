/**
 * The integer-label form of softmax_cross_entropy faults on a label outside the class dimension
 * (design principles 3.9); a negative label is not the last class.
 */
module softmax_labels_oob

import { reshape } from tensor
import { softmax_cross_entropy } from nn

func main(): int sync {
    let logits = reshape([1.0, 2.0, 3.0, 0.5, -1.0, 0.0], [2, 3])
    let loss = softmax_cross_entropy(logits, [0, -1])
    return 0
}