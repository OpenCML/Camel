/**
 * Tiny valid-convolution CNN trained with autodiff through the conv2d pullback: value_and_grad
 * of the loss gives a TinyCnn-shaped gradient (kernel, bias and head), one sgd step lowers the
 * loss, and a recursive train loop repeats the step.
 */
module tiny_cnn

import { grad, value_and_grad } from autodiff
import { Tensor, reshape, shape, sum, tanh } from tensor
import { conv2d, sgd } from nn

type TinyCnn = {
    kernel: Tensor,
    bias: Tensor,
    head: Tensor
}

with <model: TinyCnn>
func features(x: Tensor): Tensor {
    return tanh(conv2d(x, model.kernel, model.bias))
}

with <model: TinyCnn>
func predict(x: Tensor): Tensor {
    let feat = x->features<model>
    let flat = reshape(feat, [1, 4])
    return flat @ model.head
}

func mse_loss(pred: Tensor, target: Tensor): float {
    let diff = pred - target
    return sum(diff * diff) / float(shape(pred)[0])
}

with <model: TinyCnn>
func model_loss(x: Tensor, target: Tensor): float {
    let pred = x->predict<model>
    return mse_loss(pred, target)
}

func init(): TinyCnn {
    return {
        kernel: reshape([0.05, 0.0, 0.0, 0.05], [1, 1, 2, 2]),
        bias: reshape([0.0], [1]),
        head: reshape([0.1, 0.1, 0.1, 0.1], [4, 1])
    }
}

func train(model: TinyCnn, x: Tensor, target: Tensor, steps: int): TinyCnn {
    return if steps == 0 then model else train(sgd(model, grad(model_loss)<model>(x, target), 0.2), x, target, steps - 1)
}

func main(): int sync {
    let model = init()
    let x = reshape([1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0], [1, 1, 3, 3])
    let target = reshape([1.0], [1, 1])

    let before = model_loss<model>(x, target)
    let vg = value_and_grad(model_loss)<model>(x, target)
    let stepped = sgd(model, vg.1, 0.2)
    let after = model_loss<stepped>(x, target)
    let trained = train(model, x, target, 10)
    let after_train = model_loss<trained>(x, target)

    'tiny_cnn metrics before={} step={} after={} train10={}'->format<before, vg.0, after, after_train>->println
    'tiny_cnn kernel={}'->format<stepped.kernel>->println
    'tiny_cnn bias={}'->format<stepped.bias>->println
    'tiny_cnn head={}'->format<stepped.head>->println
    'tiny_cnn kernel_grad={}'->format<vg.1.kernel>->println
    'tiny_cnn bias_grad={}'->format<vg.1.bias>->println
    'tiny_cnn head_grad={}'->format<vg.1.head>->println
    return 0
}
