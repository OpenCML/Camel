/**
 * The integer-label form of softmax_cross_entropy and its gradient agree with the one-hot form,
 * for labels as int[] and as a rank-1 int64 or int32 tensor.
 */
module softmax_labels

import { reshape, one_hot, sum, abs } from tensor
import { softmax_cross_entropy, softmax_cross_entropy_grad } from nn

func main(): int sync {
    let logits = reshape([1.0, 2.0, 3.0, 0.5, -1.0, 0.0], [2, 3])
    let labels = [1, 0]
    let hot = one_hot(labels, 3)

    let onehot_loss = softmax_cross_entropy(logits, hot)
    let array_loss = softmax_cross_entropy(logits, labels)
    let tensor_loss = softmax_cross_entropy(logits, int(labels))
    let int32_loss = softmax_cross_entropy(logits, i32(labels))
    let onehot_grad = softmax_cross_entropy_grad(logits, hot, 0.5)
    let array_grad = softmax_cross_entropy_grad(logits, labels, 0.5)
    let tensor_grad = softmax_cross_entropy_grad(logits, int(labels), 0.5)

    'softmax_labels loss={} {} {} {} grad_diff={}'->format<onehot_loss, array_loss, tensor_loss, int32_loss, sum(abs(array_grad - onehot_grad)) + sum(abs(tensor_grad - onehot_grad))>->println
    return 0
}