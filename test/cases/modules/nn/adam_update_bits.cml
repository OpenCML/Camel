/**
 * Pins the bits of one optimizer update.
 *
 * `adam` advances a tensor leaf with the fused pass in modules/tensor/kernels/update.cpp, which
 * keeps the arithmetic in double for every element and rounds once, on the store. The values below
 * are the ones the element-by-element double loop it replaced produced; they are printed with the
 * shortest decimal that names one float exactly (design principles 7.7), so the plan compares
 * that text exactly.
 *
 * The model has both kinds of trainable leaf: two tensors and a float.
 */

import { range } from tensor
import { adam, adam_state } from nn

type Model = {
    w: f32[..],
    b: f32[..],
    scale: float
}

func main(steps: int, lr: float): int sync {
    // Deterministic values with binary digits below the point: 0.0007 and 0.0011 are not
    // representable as float, so an f32 intermediate would move the result.
    let model = {
        w: f32(range(6)) * 0.0007 - 0.002,
        b: f32(range(2)) * 0.03 + 0.001,
        scale: 0.25
    }
    let gradient = {
        w: f32(range(6)) * 0.0011 - 0.003,
        b: f32(range(2)) * -0.02 + 0.005,
        scale: -0.5
    }
    let (trained, state, done) = loop m = model, s = adam_state(model), step = 0
        while step < steps
        do {
            let next = adam(m, gradient, s, lr)
            return (next.0, next.1, step + 1)
        }
    'adam_update_bits w0={} w3={} w5={} b1={} scale={}'
    ->format<trained.w[0], trained.w[3], trained.w[5], trained.b[1], trained.scale>
    ->println
    return 0
}