/**
 * Tiny single-head attention block trained with autodiff through the row-wise softmax pullback:
 * value_and_grad of the loss gives an AttentionModel-shaped gradient, one sgd step lowers the
 * loss, and a recursive train loop repeats the step.
 *
 * The model is the first normal parameter of the loss (9.9).
 */
module tiny_attention

import { grad, value_and_grad } from autodiff
import { Tensor, reshape, shape, softmax, sum, transpose } from tensor
import { sgd } from nn

type AttentionModel = {
    wq: Tensor,
    wk: Tensor,
    wv: Tensor,
    wo: Tensor
}

func linear(x: Tensor, weight: Tensor): Tensor {
    return x @ weight
}

func attend(model: AttentionModel, x: Tensor): Tensor {
    let q = linear(x, model.wq)
    let k = linear(x, model.wk)
    let v = linear(x, model.wv)
    let scores = (q @ transpose(k)) * 0.5
    let weights = softmax(scores)
    return weights @ v
}

func predict(model: AttentionModel, x: Tensor): Tensor {
    return attend(model, x) @ model.wo
}

func mse_loss(pred: Tensor, target: Tensor): float {
    let diff = pred - target
    return sum(diff * diff) / float(shape(pred)[0])
}

func model_loss(model: AttentionModel, x: Tensor, target: Tensor): float {
    let pred = predict(model, x)
    return mse_loss(pred, target)
}

func init(): AttentionModel {
    return {
        wq: reshape([0.2, 0.0, 0.0, 0.1], [2, 2]),
        wk: reshape([0.1, 0.0, 0.0, 0.3], [2, 2]),
        wv: reshape([0.2, 0.1, 0.0, 0.2], [2, 2]),
        wo: reshape([0.1, 0.2], [2, 1])
    }
}

func train(model: AttentionModel, x: Tensor, target: Tensor, steps: int): AttentionModel {
    return if steps == 0 then model else train(sgd(model, grad(model_loss)(model, x, target), 0.5), x, target, steps - 1)
}

func main(): int sync {
    let model = init()
    let x = reshape([1.0, 0.0, 0.0, 1.0], [2, 2])
    let target = reshape([1.0, 0.0], [2, 1])

    let before = model_loss(model, x, target)
    let vg = value_and_grad(model_loss)(model, x, target)
    let stepped = sgd(model, vg.1, 0.5)
    let after = model_loss(stepped, x, target)
    let trained = train(model, x, target, 10)
    let after_train = model_loss(trained, x, target)

    'tiny_attention metrics before={} step={} after={} train10={}'->format<before, vg.0, after, after_train>->println
    'tiny_attention wq={}'->format<stepped.wq>->println
    'tiny_attention wk={}'->format<stepped.wk>->println
    'tiny_attention wv={}'->format<stepped.wv>->println
    'tiny_attention wo={}'->format<stepped.wo>->println
    'tiny_attention wq_grad={}'->format<vg.1.wq>->println
    'tiny_attention wk_grad={}'->format<vg.1.wk>->println
    'tiny_attention wv_grad={}'->format<vg.1.wv>->println
    'tiny_attention wo_grad={}'->format<vg.1.wo>->println
    return 0
}
