/**
 * A pooling's transposed law is refused instead of answered, because the law reads a value the
 * transposed half is not handed: `max_pool2d_t`'s right side is `max_pool2d_grad<2, 2, 0>(x, ct)`,
 * and `transpose(loss_pool)(1.0)` carries the cotangent alone. The walk stops at the operator and
 * says which value is missing (`skip=law-reads-a-value uri=nn:max_pool2d position=0`,
 * `reason=the rule's right side reads a value the caller does not carry`).
 *
 * **The window is not what this refusal is about.** The window `3, 1, 0` is in the case because a
 * pooling written with a window is the program a reader meets; the law is *chosen* on the operands'
 * types (`transforms/transpose/rules.cpp#chooseTransposedRule` builds the instance from the
 * cotangent's element type and the node's operands, not from its `with` arguments), so every
 * window -- `<2, 2, 0>` included -- is refused here for this same reason. The two debts that would
 * widen a law's coverage are the two owed changes `docs/technical/25_tensor_stack_and_onnx_export.md`
 * states ("A law names one window"), and the window not being compared when a law is chosen is
 * recorded there beside them.
 */

import { max_pool2d } from nn
import rulesets.transpose
import { sum } from tensor
import { transpose } from transforms

func loss_pool(x: float[1, 1, 6, 6]) => float {
    return sum(max_pool2d<3, 1, 0>(x))
}

func main() => int sync {
    let back = transpose(loss_pool)(1.0)
    'pooling transpose should have been refused, and it answered {}'->format<back.0>->println
    return 0
}