/**
 * Demonstrates a with-context Linear model trained functionally: value_and_grad of a loss that
 * calls a with-context helper yields the loss plus a Linear-shaped gradient, and one sgd step
 * returns the updated Linear.
 */
module with_context_step_demo

import { value_and_grad } from autodiff
import { Tensor, ones, shape, sum, zeros } from tensor
import { sgd } from nn

type Linear = {
    weight: Tensor
}

with <layer: Linear>
func linear(x: Tensor): Tensor {
    return x @ layer.weight
}

with <layer: Linear>
func mse_loss(x: Tensor, y: Tensor): float {
    let pred = x->linear<layer>
    let errors = pred - y
    let squared = errors * errors
    return sum(squared) / float(shape(x)[0])
}

func init(): Linear {
    return { weight: zeros([2, 1]) }
}

func main(): int sync {
    let layer = init()
    let X = ones([4, 2])
    let y = ones([4, 1])

    let before = mse_loss<layer>(X, y)
    let vg = value_and_grad(mse_loss)<layer>(X, y)
    let gradient = vg.1
    let trained = sgd(layer, gradient, 0.01)
    let after = mse_loss<trained>(X, y)

    'with_context_step_demo metrics before={} step={} after={}'->format<before, vg.0, after>->println
    'with_context_step_demo weight={}'->format<trained.weight>->println
    'with_context_step_demo grad={}'->format<gradient.weight>->println
    return 0
}
