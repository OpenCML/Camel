/**
 * Demonstrates a Linear model trained functionally: value_and_grad of a loss that calls a
 * Linear-shaped helper yields the loss plus a Linear-shaped gradient, and one sgd step returns
 * the updated Linear.
 *
 * `grad` differentiates the first normal parameter (9.9), so the model `layer` is an ordinary
 * argument rather than a `with` parameter. The `with` parameter `scale` is configuration: it
 * does not take part in differentiation and survives as a `with` parameter of the gradient
 * function, supplied with `<scale>` at the call site.
 */
module with_context_step_demo

import { value_and_grad } from autodiff
import { Tensor, ones, shape, sum, zeros } from tensor
import { sgd } from nn

type Linear = {
    weight: Tensor
}

func linear(x: Tensor, layer: Linear): Tensor {
    return x @ layer.weight
}

with <scale: float>
func mse_loss(layer: Linear, x: Tensor, y: Tensor): float {
    let pred = linear(x, layer)
    let errors = pred - y
    let squared = errors * errors
    return scale * sum(squared) / float(shape(x)[0])
}

func init(): Linear {
    return { weight: zeros([2, 1]) }
}

func main(): int sync {
    let layer = init()
    let X = ones([4, 2])
    let y = ones([4, 1])
    let scale = 1.0

    let before = mse_loss<scale>(layer, X, y)
    let vg = value_and_grad(mse_loss)<scale>(layer, X, y)
    let gradient = vg.1
    let trained = sgd(layer, gradient, 0.01)
    let after = mse_loss<scale>(trained, X, y)

    'with_context_step_demo metrics before={} step={} after={}'->format<before, vg.0, after>->println
    'with_context_step_demo weight={}'->format<trained.weight>->println
    'with_context_step_demo grad={}'->format<gradient.weight>->println
    return 0
}
