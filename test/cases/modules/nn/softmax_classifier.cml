/**
 * Tiny helper-based classifier trained with fused softmax cross entropy: value_and_grad of the
 * loss differentiates through nested helpers into a Classifier-shaped gradient, one sgd step
 * lowers the loss, and a recursive train loop repeats the step.
 *
 * The model is the first normal parameter of `model_loss` (9.9); the helpers take the piece
 * they need as a normal parameter too.
 */
module softmax_classifier

import { grad, value_and_grad } from autodiff
import { Tensor, reshape, zeros } from tensor
import { sgd, softmax_cross_entropy } from nn

type Linear = {
    weight: Tensor,
    bias: Tensor
}

type Classifier = {
    head: Linear
}

func linear(x: Tensor, layer: Linear): Tensor {
    return (x @ layer.weight) + layer.bias
}

func logits(model: Classifier, x: Tensor): Tensor {
    return linear(x, model.head)
}

func classifier_loss(logits_value: Tensor, target: Tensor): float {
    return softmax_cross_entropy(logits_value, target)
}

func model_loss(model: Classifier, x: Tensor, target: Tensor): float {
    let pred = logits(model, x)
    return classifier_loss(pred, target)
}

func init(): Classifier {
    return {
        head: {
            weight: reshape([0.1, 0.1, 0.1, 0.1], [2, 2]),
            bias: zeros([2])
        }
    }
}

func train(model: Classifier, x: Tensor, target: Tensor, steps: int): Classifier {
    return if steps == 0 then model else train(sgd(model, grad(model_loss)(model, x, target), 0.5), x, target, steps - 1)
}

func main(): int sync {
    let model = init()
    let x = reshape([1.0, 0.0, 0.0, 1.0], [2, 2])
    let target = reshape([1.0, 0.0, 0.0, 1.0], [2, 2])

    let before = model_loss(model, x, target)
    let vg = value_and_grad(model_loss)(model, x, target)
    let stepped = sgd(model, vg.1, 0.5)
    let after = model_loss(stepped, x, target)
    let trained = train(model, x, target, 10)
    let after_train = model_loss(trained, x, target)

    'softmax_classifier metrics before={} step={} after={} train10={}'->format<before, vg.0, after, after_train>->println
    'softmax_classifier weight={}'->format<stepped.head.weight>->println
    'softmax_classifier bias={}'->format<stepped.head.bias>->println
    'softmax_classifier weight_grad={}'->format<vg.1.head.weight>->println
    'softmax_classifier bias_grad={}'->format<vg.1.head.bias>->println
    return 0
}
