/**
 * Tiny helper-based classifier trained with fused softmax cross entropy: with_grad of the
 * loss differentiates through nested with-context helpers into a Classifier-shaped gradient,
 * one sgd step lowers the loss, and a recursive train loop repeats the step.
 */
module softmax_classifier

import { grad, with_grad } from autodiff
import { reshape, zeros } from tensor
import { sgd, softmax_cross_entropy } from nn

type Linear = {
    weight: f32[..],
    bias: f32[..]
}

type Classifier = {
    head: Linear
}

with <layer: Linear>
func linear(x: f32[..]): f32[..] {
    return (x @ layer.weight) + layer.bias
}

with <model: Classifier>
func logits(x: f32[..]): f32[..] {
    return x->linear<model.head>
}

func classifier_loss(logits_value: f32[..], target: f32[..]): float {
    return softmax_cross_entropy(logits_value, target)
}

with <model: Classifier>
func model_loss(x: f32[..], target: f32[..]): float {
    let pred = x->logits<model>
    return classifier_loss(pred, target)
}

func init(): Classifier {
    return {
        head: {
            weight: reshape([0.1, 0.1, 0.1, 0.1] as f32[], [2, 2]),
            bias: zeros([2])
        }
    }
}

func train(model: Classifier, x: f32[..], target: f32[..], steps: int): Classifier {
    return if steps == 0 then model else train(sgd(model, grad(model_loss)<model>(x, target), 0.5), x, target, steps - 1)
}

func main(): int sync {
    let model = init()
    let x = reshape([1.0, 0.0, 0.0, 1.0] as f32[], [2, 2])
    let target = reshape([1.0, 0.0, 0.0, 1.0] as f32[], [2, 2])

    let before = model_loss<model>(x, target)
    let vg = with_grad(model_loss)<model>(x, target)
    let stepped = sgd(model, vg.1, 0.5)
    let after = model_loss<stepped>(x, target)
    let trained = train(model, x, target, 10)
    let after_train = model_loss<trained>(x, target)

    'softmax_classifier metrics before={} step={} after={} train10={}'->format<before, vg.0, after, after_train>->println
    'softmax_classifier weight={}'->format<stepped.head.weight>->println
    'softmax_classifier bias={}'->format<stepped.head.bias>->println
    'softmax_classifier weight_grad={}'->format<vg.1.head.weight>->println
    'softmax_classifier bias_grad={}'->format<vg.1.head.bias>->println
    return 0
}
