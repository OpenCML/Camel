/**
 * Fixed two-step tanh RNN trained with autodiff: value_and_grad of the unrolled sequence loss
 * gives a TinyRnn-shaped gradient (weights shared across both time steps accumulate), one sgd
 * step lowers the loss, and a recursive train loop repeats the step.
 */
module tiny_rnn

import { grad, value_and_grad } from autodiff
import { Tensor, full, shape, sum, tanh, zeros } from tensor
import { sgd } from nn

type TinyRnn = {
    wxh: Tensor,
    whh: Tensor,
    why: Tensor,
    b: Tensor,
    by: Tensor
}

with <model: TinyRnn>
func rnn_loss(x0: Tensor, x1: Tensor, target: Tensor): float {
    let h0 = zeros([1, 2])
    let h1 = tanh((x0 @ model.wxh) + (h0 @ model.whh) + model.b)
    let h2 = tanh((x1 @ model.wxh) + (h1 @ model.whh) + model.b)
    let pred = (h2 @ model.why) + model.by
    let errors = pred - target
    let squared = errors * errors
    return sum(squared) / float(shape(pred)[0])
}

func init(): TinyRnn {
    return {
        wxh: full([2, 2], 0.1),
        whh: full([2, 2], 0.1),
        why: full([2, 1], 0.1),
        b: zeros([2]),
        by: zeros([1])
    }
}

func train(model: TinyRnn, x0: Tensor, x1: Tensor, target: Tensor, steps: int): TinyRnn {
    return if steps == 0 then model else train(sgd(model, grad(rnn_loss)<model>(x0, x1, target), 0.05), x0, x1, target, steps - 1)
}

func main(): int sync {
    let model = init()
    let x0 = full([1, 2], 1.0)
    let x1 = full([1, 2], 0.5)
    let target = full([1, 1], 1.0)

    let before = rnn_loss<model>(x0, x1, target)
    let vg = value_and_grad(rnn_loss)<model>(x0, x1, target)
    let stepped = sgd(model, vg.1, 0.05)
    let after = rnn_loss<stepped>(x0, x1, target)
    let trained = train(model, x0, x1, target, 10)
    let after_train = rnn_loss<trained>(x0, x1, target)

    'tiny_rnn metrics before={} step={} after={} train10={}'->format<before, vg.0, after, after_train>->println
    'tiny_rnn wxh={}'->format<stepped.wxh>->println
    'tiny_rnn whh={}'->format<stepped.whh>->println
    'tiny_rnn why={}'->format<stepped.why>->println
    'tiny_rnn wxh_grad={}'->format<vg.1.wxh>->println
    'tiny_rnn whh_grad={}'->format<vg.1.whh>->println
    'tiny_rnn b_grad={}'->format<vg.1.b>->println
    return 0
}
