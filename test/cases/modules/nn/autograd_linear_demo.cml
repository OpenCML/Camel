/**
 * Demonstrates autodiff gradient descent for a linear MSE loss: the model is the loss's first
 * normal parameter, so `grad` returns one Linear-shaped gradient (not a tuple), which is fed to
 * sgd, and a recursive train loop repeats the step. The targets are data: the second normal
 * parameter is not differentiated.
 */
module autograd_linear_demo

import { grad } from autodiff
import { Tensor, ones, shape, sum, zeros } from tensor
import { sgd } from nn

type Linear = {
    weight: Tensor
}

func mse_loss(layer: Linear, X: Tensor, y: Tensor): float {
    let pred = X @ layer.weight
    let errors = pred - y
    let squared = errors * errors
    let m = shape(X)[0]
    return sum(squared) / float(m)
}

func init(): Linear {
    return { weight: zeros([2, 1]) }
}

func train(layer: Linear, X: Tensor, y: Tensor, steps: int): Linear {
    let gradient = grad(mse_loss)(layer, X, y)
    return if steps == 0 then layer else train(sgd(layer, gradient, 0.01), X, y, steps - 1)
}

func main(): int sync {
    let X = ones([4, 2])
    let y = ones([4, 1])
    let layer = init()

    let gradient = grad(mse_loss)(layer, X, y)
    let before = mse_loss(layer, X, y)
    let stepped = sgd(layer, gradient, 0.01)
    let after = mse_loss(stepped, X, y)
    let trained = train(layer, X, y, 10)
    let after_train = mse_loss(trained, X, y)

    'autograd_linear_demo metrics before={} after={} train10={}'->format<before, after, after_train>->println
    'autograd_linear_demo w0={}'->format<layer.weight>->println
    'autograd_linear_demo w1={}'->format<stepped.weight>->println
    'autograd_linear_demo weight_grad={}'->format<gradient.weight>->println
    return 0
}