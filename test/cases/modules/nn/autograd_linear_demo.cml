/**
 * Demonstrates autodiff gradient descent for a linear MSE loss whose with-context has two
 * parameters: grad returns a tuple of gradients (one per with-parameter), the Linear gradient
 * is taken from `.0` and fed to sgd, and a recursive train loop repeats the step.
 */
module autograd_linear_demo

import { grad } from autodiff
import { Tensor, ones, shape, sum, zeros } from tensor
import { sgd } from nn

type Linear = {
    weight: Tensor
}

with <layer: Linear, y: Tensor>
func mse_loss(X: Tensor): float {
    let pred = X @ layer.weight
    let errors = pred - y
    let squared = errors * errors
    let m = shape(X)[0]
    return sum(squared) / float(m)
}

func init(): Linear {
    return { weight: zeros([2, 1]) }
}

func train(layer: Linear, X: Tensor, y: Tensor, steps: int): Linear {
    let grads = grad(mse_loss)<layer, y>(X)
    return if steps == 0 then layer else train(sgd(layer, grads.0, 0.01), X, y, steps - 1)
}

func main(): int sync {
    let X = ones([4, 2])
    let y = ones([4, 1])
    let layer = init()

    let grads = grad(mse_loss)<layer, y>(X)
    let before = mse_loss<layer, y>(X)
    let stepped = sgd(layer, grads.0, 0.01)
    let after = mse_loss<stepped, y>(X)
    let trained = train(layer, X, y, 10)
    let after_train = mse_loss<trained, y>(X)

    'autograd_linear_demo metrics before={} after={} train10={}'->format<before, after, after_train>->println
    'autograd_linear_demo w0={}'->format<layer.weight>->println
    'autograd_linear_demo w1={}'->format<stepped.weight>->println
    'autograd_linear_demo weight_grad={}'->format<grads.0.weight>->println
    'autograd_linear_demo y_grad={}'->format<grads.1>->println
    return 0
}
