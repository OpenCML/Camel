/**
 * Demonstrates autodiff gradient descent for a linear MSE loss whose first `with` parameter is
 * the Linear model: grad returns one Linear-shaped gradient, fed to sgd; the targets are also
 * captured `with` data and stay constant. A recursive train loop repeats the step.
 */

import { grad } from autodiff
import { ones, shape, sum, zeros } from tensor
import { sgd } from nn

type Linear = {
    weight: f32[..]
}

with <layer: Linear, y: f32[..]>
func mse_loss(X: f32[..]): float {
    let pred = X @ layer.weight
    let errors = pred - y
    let squared = errors * errors
    let m = shape(X)[0]
    return float(sum(squared)) / float(m)
}

func init(): Linear {
    return { weight: zeros::<f32>([2, 1]) }
}

func train(layer: Linear, X: f32[..], y: f32[..], steps: int): Linear {
    let loss_grad = grad(mse_loss)
    let grads = loss_grad<layer, y>(X)
    return if steps == 0 then layer else train(sgd(layer, grads, 0.01), X, y, steps - 1)
}

func main(): int sync {
    let X = ones::<f32>([4, 2])
    let y = ones::<f32>([4, 1])
    let layer = init()

    let grads = grad(mse_loss)<layer, y>(X)
    let before = mse_loss<layer, y>(X)
    let stepped = sgd(layer, grads, 0.01)
    let after = mse_loss<stepped, y>(X)
    let trained = train(layer, X, y, 10)
    let after_train = mse_loss<trained, y>(X)

    'autograd_linear_demo metrics before={} after={} train10={}'->format<before, after, after_train>->println
    'autograd_linear_demo w0={}'->format<layer.weight>->println
    'autograd_linear_demo w1={}'->format<stepped.weight>->println
    'autograd_linear_demo weight_grad={}'->format<grads.weight>->println
    return 0
}
