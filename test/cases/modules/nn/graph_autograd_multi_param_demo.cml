/**
 * Exercises autodiff over a struct model with multiple tensor leaves and a broadcast bias:
 * value_and_grad returns the loss and a LinearBias-shaped gradient whose bias entry is reduced
 * back to the bias shape, and sgd applies one update to both leaves.
 */
module graph_autograd_multi_param_demo

import { value_and_grad } from autodiff
import { Tensor, ones, shape, sum, zeros } from tensor
import { sgd } from nn

type LinearBias = {
    weight: Tensor,
    bias: Tensor
}

with <model: LinearBias>
func mse_loss(x: Tensor, y: Tensor): float {
    let pred = (x @ model.weight) + model.bias
    let errors = pred - y
    let squared = errors * errors
    return sum(squared) / float(shape(x)[0])
}

func init(): LinearBias {
    return { weight: zeros([2, 1]), bias: zeros([1]) }
}

func main(): int sync {
    let model = init()
    let X = ones([4, 2])
    let y = ones([4, 1])

    let before = mse_loss<model>(X, y)
    let vg = value_and_grad(mse_loss)<model>(X, y)
    let trained = sgd(model, vg.1, 0.01)
    let after = mse_loss<trained>(X, y)

    'graph_autograd_multi_param_demo metrics before={} step={} after={}'->format<before, vg.0, after>->println
    'graph_autograd_multi_param_demo weight={}'->format<trained.weight>->println
    'graph_autograd_multi_param_demo bias={}'->format<trained.bias>->println
    'graph_autograd_multi_param_demo weight_grad={}'->format<vg.1.weight>->println
    'graph_autograd_multi_param_demo bias_grad={}'->format<vg.1.bias>->println
    return 0
}
