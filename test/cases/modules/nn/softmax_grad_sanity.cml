/**
 * Operator-level sanity check for row-wise softmax VJP.
 */

import {
    reshape, softmax, softmax_grad, sum
} from tensor

func main(): int sync {
    let logits = reshape<[1, 2]>([0.2, -0.1])
    let dy = reshape<[1, 2]>([1.0, -0.5])
    let plus = reshape<[1, 2]>([0.201, -0.1])
    let minus = reshape<[1, 2]>([0.199, -0.1])

    let probs = softmax(logits)
    let grad = softmax_grad(probs, dy)
    let grad0 = sum(grad * reshape<[1, 2]>([1.0, 0.0]))
    let score_plus = sum(softmax(plus) * dy)
    let score_minus = sum(softmax(minus) * dy)
    let finite = (score_plus - score_minus) / 0.002
    let prob_sum = sum(probs)

    'softmax_grad_sanity prob_sum={} grad0={} finite={}'->format<prob_sum, grad0, finite>->println
    return 0
}
