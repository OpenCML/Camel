module graph_kinds
import { name, nodes, kind, graphs_of } from graph
import { Graph, Node, NodeKind } from graph

func pick(a: int, b: int): int {
    return if a > b then a - b else b - a
}

func total(xs: int[]): int {
    return xs->map<(x: int): int => pick(x, 3)>->reduce<(acc: int, x: int): int => acc + x, 0>
}

func kinds(g: Graph): NodeKind[] {
    return nodes(g)->map<kind>
}

func main(): int sync {
    println(total([1, 5, 9]))
    let all = graphs_of(main)
    println(all->map<name>)
    println(all->map<kinds>)
    return 0
}
