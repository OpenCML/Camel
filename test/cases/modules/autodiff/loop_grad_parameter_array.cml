/**
 * The twin of `loop_grad_literal_array.cml`: the same loop body, but over an array built from the
 * parameter. The array depends on a differentiated value, so the reverse pass carries its
 * gradient -- a zero array and one scatter per round -- and both appear in the graph `std::jgir`
 * prints after `std::macro` as `:tangent/zeros_arr` and `:tangent/scatter_add_arr` (design
 * principles 9.9). f(w) is w + w * (w + 2w + 3w), so the gradient at 2 is 25.
 */

import { grad } from autodiff

with <w: float>
func f(): float {
    let xs = [w, w * 2.0, w * 3.0]
    return loop acc = w for x in xs do acc + x * w
}

func main(): int sync {
    'loop_grad_parameter_array d={}'->format<grad(f)<2.0>()>->println
    return 0
}