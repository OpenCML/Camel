/**
 * Checks the derivative rules of tensor operators against finite differences: for each function
 * f and a random direction v, sum(grad(f)(x) * v) must match (f(x + h v) - f(x - h v)) / 2h.
 * Each function reduces to a float through fixed, non-uniform weights so that every element of
 * the gradient matters.
 */

import { grad } from autodiff
import { random, seed, sum, mean, max, min, exp, log, sqrt, rsqrt, sigmoid, tanh, relu, gelu, erf, abs, neg, maximum, minimum, where, softmax, log_softmax, layer_norm, matmul, linear, transpose, reshape, unsqueeze, permute, concat, pow, dim } from tensor

func check(name: string, f: <x: f32[..]> () => float, df: <x: f32[..]> () => f32[..], x: f32[..], v: f32[..]): int sync {
    let h = 0.001
    let analytic = float(sum(df<x>() * v))
    let numeric = (f<x + v * h>() - f<x - v * h>()) / (2.0 * h)
    let err = analytic - numeric
    let scale = if numeric > 1.0 then numeric else if numeric < -1.0 then 0.0 - numeric else 1.0
    let rel = if err > 0.0 then err / scale else (0.0 - err) / scale
    let status = if rel < 0.02 then "ok" else "FAIL"
    '{} {} analytic={} numeric={}'->format<name, status, analytic, numeric>->println
    return 0
}

// ---- weights
func w34(): f32[..] { return [[0.3, -1.2, 0.5, 2.0], [1.1, 0.4, -0.7, 0.2], [-0.5, 0.9, 1.3, -0.1]] as f32[3, 4] }
func w4(): f32[..] { return [0.7, -0.3, 1.5, 0.2] as f32[] }
func w3(): f32[..] { return [1.0, -2.0, 0.5] as f32[] }
func w31(): f32[..] { return [[2.0], [3.0], [1.5]] as f32[3, 1] }
func w5(): f32[..] { return [0.4, -0.8, 1.2, 0.3, -0.6] as f32[] }
func w5b(): f32[..] { return [-0.2, 0.5, 0.9, -1.1, 0.7] as f32[] }
func w45(): f32[..] { return [[0.2, -0.1, 0.4, 0.3, -0.5], [0.6, 0.1, -0.2, 0.8, 0.3], [-0.3, 0.5, 0.2, -0.4, 0.9], [0.1, 0.7, -0.6, 0.2, 0.4]] as f32[4, 5] }

// ---- elementwise
with <x: f32[..]>
func arith(): float { return float(sum((x * x * 3.0 + x * w4() - x / w31() + 2.0 / (x * x + 1.0) - x) * w34())) }
with <x: f32[..]>
func bcast_rhs(): float { return float(sum(w34() * x + w34() / (x * x + 1.0) - x)) }
with <x: f32[..]>
func powers(): float { return float(sum(pow(exp(x), 2.5) * w34() + pow(2.0, x))) }
with <x: f32[..]>
func unary(): float { return float(sum((sigmoid(x) + tanh(x) * relu(x) + exp(x) / 4.0 + neg(x) * abs(x)) * w34())) }
with <x: f32[..]>
func roots(): float { return float(sum((sqrt(exp(x)) + rsqrt(exp(x)) + log(exp(x) + 1.0)) * w34())) }
with <x: f32[..]>
func smooth(): float { return float(sum((gelu(x) + erf(x)) * w34())) }
with <x: f32[..]>
func select(): float { return float(sum((maximum(x, x * 0.2) + minimum(x, w4()) + where(x > 0.0, x * x, x * 3.0)) * w34())) }

// ---- reductions
with <x: f32[..]>
func reduce_axes(): float { return float(sum(sum<1>(x) * w3())) + float(sum(sum<0, true>(x) * w4())) + float(mean(x)) * 3.0 + float(sum(mean<1>(x) * w3())) }
with <x: f32[..]>
func extrema(): float { return float(sum(max<1>(x) * w3())) + float(sum(min<0, true>(x) * w4())) }
with <x: f32[..]>
func soft(): float { return float(sum(softmax(x) * w34())) + float(sum(softmax<0>(x) * w34())) + float(sum(log_softmax(x) * w34())) }
with <x: f32[..]>
func norm_x(): float { return float(sum(layer_norm(x, w4() + 1.0, w4()) * w34())) }
with <g: f32[..]>
func norm_gamma(): float { return float(sum(layer_norm(w34(), g, w4()) * w34())) }
with <b: f32[..]>
func norm_beta(): float { return float(sum(layer_norm(w34(), w4() + 1.0, b) * w34())) }

// ---- linear algebra
with <x: f32[..]>
func mm_lhs(): float { return float(sum(matmul(x, w45()) * w5())) }
with <w: f32[..]>
func mm_rhs(): float { return float(sum(matmul(w34(), w) * matmul(w34(), w45()))) }
with <w: f32[..]>
func mm_batch_rhs(): float { return float(sum(matmul(reshape<[2, 3, 4]>(concat<0>(w34(), w34() * 2.0)), w))) }
with <x: f32[..]>
func mm_vec(): float { return float(sum(matmul(x, w45()) * w5b())) + float(sum(matmul(w34(), x) * w3())) }
with <x: f32[..]>
func lin(): float { return float(sum(linear(x, w45(), w5()) * matmul(w34(), w45()))) }
with <b: f32[..]>
func lin_bias(): float { return float(sum(tanh(linear(w34(), w45(), b)) * matmul(w34(), w45()))) }

// ---- layout
with <x: f32[..]>
func layout(): float {
    let t = transpose(x) * transpose(w34())
    let r = reshape<[2, 6]>(x) * reshape<[2, 6]>(w34())
    let u = unsqueeze<0>(x) * 2.0
    let p = permute<[2, 0, 1]>(reshape<[3, 2, 2]>(x)) * permute<[2, 0, 1]>(reshape<[3, 2, 2]>(w34()))
    return float(sum(t)) + float(sum(r)) + float(sum(reshape<[dim<0>(u), -1]>(u) * reshape<[1, 12]>(w34()))) + float(sum(p))
}
with <x: f32[..]>
func pieces(): float {
    let c = concat<0>(x, x * x) * concat<0>(w34(), w34())
    let d = concat<1>(x, w34())
    let s = slice(x, 1, 1, 4) * slice(w34(), 1, 0, 3)
    let e = slice(x, 0, 0, 3, 2)
    return float(sum(c)) + float(sum(d * d)) + float(sum(s)) + float(sum(e * e))
}

func main(): int sync {
    seed(5)
    let x = random([3, 4], -1.0, 1.0)
    let v = random([3, 4], -1.0, 1.0)
    let x4 = random([4], -1.0, 1.0)
    let v4 = random([4], -1.0, 1.0)
    let x45 = random([4, 5], -1.0, 1.0)
    let v45 = random([4, 5], -1.0, 1.0)
    let x5 = random([5], -1.0, 1.0)
    let v5 = random([5], -1.0, 1.0)
    check("arith", arith, grad(arith), x, v)
    check("bcast_rhs", bcast_rhs, grad(bcast_rhs), x4, v4)
    check("powers", powers, grad(powers), x, v)
    check("unary", unary, grad(unary), x, v)
    check("roots", roots, grad(roots), x, v)
    check("smooth", smooth, grad(smooth), x, v)
    check("select", select, grad(select), x, v)
    check("reduce_axes", reduce_axes, grad(reduce_axes), x, v)
    check("extrema", extrema, grad(extrema), x, v)
    check("soft", soft, grad(soft), x, v)
    check("norm_x", norm_x, grad(norm_x), x, v)
    check("norm_gamma", norm_gamma, grad(norm_gamma), x4, v4)
    check("norm_beta", norm_beta, grad(norm_beta), x4, v4)
    check("mm_lhs", mm_lhs, grad(mm_lhs), x, v)
    check("mm_rhs", mm_rhs, grad(mm_rhs), x45, v45)
    check("mm_batch_rhs", mm_batch_rhs, grad(mm_batch_rhs), x45, v45)
    check("mm_vec", mm_vec, grad(mm_vec), x4, v4)
    check("lin", lin, grad(lin), x, v)
    check("lin_bias", lin_bias, grad(lin_bias), x5, v5)
    check("layout", layout, grad(layout), x, v)
    check("pieces", pieces, grad(pieces), x, v)
    return 0
}
