/**
 * An `int` parameter is differentiable, and its gradient is the zero of its own type: `with <n:
 * int>` asks for the derivative with respect to `n`, and the gradient of a parameter is a value of
 * the parameter's own gradient type -- for a
 * number, itself, at zero.
 * `let g: int = ...` pins
 * that: the call's result type is `int`, not a refusal.
 *
 * Nothing depends on `n` here either -- the loss is `float(n) · 2 · x` -- so the printed gradient is
 * that zero, while a `string` or a function parameter is still refused (`grad_refuse_string`,
 * `grad_refuse_function`): they have no gradient type at all, which is a different statement from
 * "a value of this type carries no gradient through the tape" (the machinery's own question, which
 * is still answered `no` for an int).
 */
module grad_int_zero
import { grad } from autodiff

with <n: int>
func twice(x: float): float {
    return float(n) * 2.0 * x
}

func main(): int sync {
    let g: int = grad(twice)<3>(2.0)
    'grad_int_zero g={}'->format<g>->println
    return 0
}
