/**
 * The pullback of a function whose reduction takes its axis and its `keepdims` as ports.
 *
 * `mean_axis(xs, axis, keepdims)` has three ports: one data operand and two context arguments.
 * `mean_axis_t` names all three, because a rule's parameters are the operator's ports in port
 * order -- and only the first answers a cotangent, since `int` and `bool` have no tangent space.
 * The cotangent the law has to spread needs the *value* of `xs`, the array being reduced; that
 * value is what this file is about, and it is why the reading stops where it does.
 *
 * This is the third of the three readings, and the only one still marked. It was split out of a
 * single file with `reshape` and `softmax` so that their correct numbers are not reported as part
 * of this one's red: one program per reading.
 *
 * The number is derived by hand, not read off a run:
 *
 *   mean     f(x) = sum(mean_axis(x, 0, false) * [1, 2, 3]) on x = [[1, 2, 3], [4, 5, 6]]
 *            the lane means are [2.5, 3.5, 4.5], so f = 2.5 + 7.0 + 13.5 = 23.0; the cotangent of x
 *            at ct = 1.0 is w[k] / 2 in both rows, which sums to 2 * (0.5 + 1 + 1.5) = 6.0.
 */
import rulesets.transpose
import { transpose } from transforms
import { mean_axis, sum } from tensor

func loss_mean(x: float[..]): float {
    return float(sum(mean_axis(x, 0, false) * ([1.0, 2.0, 3.0] as float[])))
}

func main(): int sync {
    let back = transpose(loss_mean)(1.0)
    'rules_angle_args mean transpose={}'->format<float(sum(back.0))>->println
    return 0
}