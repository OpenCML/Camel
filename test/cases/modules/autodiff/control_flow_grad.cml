/**
 * Verifies gradients through data-dependent branches, branch arms reading different values, and
 * recursion (a pullback per call, chained by closures).
 *
 * The differentiated value is the first `with` parameter (9.9); the remaining parameters are
 * data and stay constant.
 */
module control_flow_grad

import { grad } from autodiff

with <x: float>
func leaky(): float {
    return if x > 0.0 then x * x else 0.5 * x
}

with <x: float>
func power(n: int): float {
    return if n == 0 then 1.0 else x * power<x>(n - 1)
}

// Differentiating `a`: `b` and `c` are data.
with <a: float>
func pick(b: float, c: bool): float {
    let s = a * b
    return if c then s * a else b + 1.0
}

// Nested branches inside recursion: sum of |x| * i for i in 1..n.
with <x: float>
func walk(n: int): float {
    let step = if x > 0.0 then x * float(n) else 0.0 - x * float(n)
    return if n == 0 then 0.0 else step + walk<x>(n - 1)
}

func main(): int sync {
    let a = grad(leaky)<3.0>()
    let b = grad(leaky)<-3.0>()
    let c = grad(power)<2.0>(5)
    let d = grad(pick)<2.0>(3.0, true)
    let e = grad(pick)<2.0>(3.0, false)
    let w = grad(walk)<-1.5>(4)
    'control_flow_grad a={} b={} c={} d={} e={} w={}'->format<a, b, c, d, e, w>->println
    return 0
}
