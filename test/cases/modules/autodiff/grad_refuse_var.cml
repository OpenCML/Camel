/** Refused: the first `with` parameter is a `var`; gradients do not flow through variables (3.5, 9.9). */
module grad_refuse_var
import { grad } from autodiff

with <var v: float>
sync func varred(x: float): float {
    return v * x
}

func main(): int sync {
    var v = 1.0
    let g = grad(varred)
    println(g<v>(2.0))
    return 0
}
