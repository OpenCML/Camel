/**
 * A composite loop state whose gradient depends on a value that is computed outside the loop and
 * read only inside its body. The aggregate value of the loop is read through a projection after
 * the loop; the projection's gradient must reach the loop's site, so the loop counts as active
 * when what its regions read from around it is active (design principles 9.9).
 *
 * `pair` keeps a two-value state and adds `s = w * 2` once per round: the value is 12 and the
 * gradient is 6. `table` keeps an array state grown by `append<a>`, with `a = w + 1` computed
 * outside the loop: the gradient of `xs[1] + xs[2]` is 2.
 */
module loop_grad_composite_read

import { grad, with_grad } from autodiff

with <w: float>
func pair(n: int): float {
    let s = w * 2.0
    let (i, acc) = loop i = 0, acc = 0.0 while i < n do (i + 1, acc + s)
    return acc
}

with <w: float>
func table(): float {
    let a  = w + 1.0
    let xs = loop xs = [0.0] while len(xs) < 3 do xs->append<a>
    return xs[1] + xs[2]
}

func main(): int sync {
    let vg = with_grad(pair)<2.0>(3)
    let d  = grad(table)<2.0>()
    'loop_grad_composite_read vg={} d={}'->format<vg, d>->println
    return 0
}