/**
 * Verifies the gradient of a loop that iterates over an array built from the differentiated
 * parameter: an array's tangent is the array of its elements' tangents, and the reverse of a read
 * by index is a scatter-add, so each round's element gradient goes back into the array at that
 * round's index (design principles 9.9). f(w) is the sum of [w, 2w, 3w], so its gradient is
 * 1 + 2 + 3 = 6 at w = 2 and the value is 12. This used to be refused as an array with no
 * per-round scatter.
 */

import { grad } from autodiff

with <w: float>
func f(): float {
    let xs = [w, w * 2.0, w * 3.0]
    return loop acc = 0.0 for x in xs do acc + x
}

func main(): int sync {
    'loop_grad_iterable v={} d={}'->format<f<2.0>(), grad(f)<2.0>()>->println
    return 0
}