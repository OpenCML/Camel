/**
 * A gradient handed to the accumulator is of the parameter's own element type (design principles
 * 9.9), and this is where the scalar path used to break that. `w * x` on an `f32` parameter runs
 * `tensor:multiply`, whose rule reduces the scalar operand's gradient with `tensor:sum` -- a
 * float64 operator. Stored as it was, the float64 node sat in the f32 parameter's tangent and was
 * read at f32's width: 6.0 is 0x4018000000000000, whose low half is 0x00000000, so the program
 * printed a gradient of 0.0 -- no error, a wrong number.
 *
 * The rules now convert the gradient to the value's width (`:op/dtof`) and the accumulator refuses
 * any gradient whose element type is still wrong, so both programs print the derivatives their
 * losses have: multiply = 6.0 (w = [1, 2, 3], x = 2), where = 1.0 (the one position w <= 0 gets
 * x's 0.5, the rest take w).
 *
 * What it pins: multiply_grad=6.0 and where_grad=1.0, not 0.0. Red if a gradient of another
 * element type is accepted again -- 6.0 and 1.0 are both integral, so read at f32's width they are
 * 0.0 -- and red if a rule stops converting and the accumulator refuses instead (the line is then
 * missing and the process exits 1).
 */
module grad_scalar_width

import { new, sum, where } from tensor
import { with_grad } from autodiff

with <x: f32>
func multiply_loss(w: f32[..]): f32 {
    return f32(sum(w * x))
}

with <x: f32>
func where_loss(w: f32[..]): f32 {
    return f32(sum(where(w > 0.0, w, x)))
}

func main(): int sync {
    let multiplied = new([[1.0, 2.0, 3.0]] as f32[][])
    let selected = new([[1.0, -2.0, 3.0]] as f32[][])
    let (v1, g1) = with_grad(multiply_loss)<f32(2.0)>(multiplied)
    let (v2, g2) = with_grad(where_loss)<f32(0.5)>(selected)
    'grad_scalar_width multiply=({:.1f},{:.1f}) where=({:.1f},{:.1f})'->format<v1, g1, v2, g2>->println
    return 0
}