/**
 * Run or inspect macro/opt without entry arguments. The random operator executes
 * only at runtime, so even a fixed seed cannot fold the gradient calculation.
 *   camel collapse_random.cml std::macro std::gir
 *   camel collapse_random.cml std::macro std::opt std::gir
 *   camel collapse_random.cml std::macro std::opt std::nvm
 */
module collapse_random

import { grad } from autodiff
import { seed, rand } from random

func sq(x: float): float { return x * x }
with <x: float>
func h(): float { return sq(x) + 3.0 * sq(x + 1.0) }

func main(): int sync {
    seed(42)
    let x = rand()
    'collapse_random x={} dh={}'->format<x, grad(h)<x>()>->println
    return 0
}
