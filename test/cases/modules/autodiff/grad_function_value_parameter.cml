module grad_function_value_parameter
import { Tensor, reshape, sum, tanh } from tensor
import { grad } from autodiff

// Refused: the function called is a parameter of the differentiated function itself, so no
// function is named or built for it anywhere grad can look. The first of the two calls (line 8)
// is the one reported.
func loss(f: (t: Tensor) => Tensor, p: Tensor): float {
    let a = f(p)
    return sum(f(a) * p)
}

func main(): int sync {
    let x = reshape([0.5, 0.25, -0.35], [3])
    println(grad(loss)((t: Tensor): Tensor => tanh(t), x))
    return 0
}
