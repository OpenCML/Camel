/**
 * Verifies the refusal of a loop whose body captures an array that depends on a differentiated
 * parameter: the loop's rounds would each need a gradient for the array it reads, and an array has
 * no cotangent, so the diagnostic names the loop and the array.
 */
module loop_grad_refuse_capture

import { grad } from autodiff

func f(w: float): float {
    let ys = [w, 2.0]
    return loop acc = 0.0 for k in [1, 2] do acc + ys[0]
}

func main(): int sync {
    let d = grad(f)(2.0)
    'loop_grad_refuse_capture d={}'->format<d>->println
    return 0
}