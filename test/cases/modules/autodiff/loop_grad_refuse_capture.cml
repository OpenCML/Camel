/**
 * Verifies the gradient of a loop whose body reads an element of a captured array that depends on
 * the differentiated parameter: the array's tangent is the array of its elements' tangents, and the
 * reverse of the read scatters the round's element gradient back into the capture. f(w) is
 * `ys[0] + ys[0]` with ys = [w, 2.0], so the gradient is 2.
 */

import { grad } from autodiff

with <w: float>
func f(): float {
    let ys = [w, 2.0]
    return loop acc = 0.0 for k in [1, 2] do acc + ys[0]
}

func main(): int sync {
    let d = grad(f)<2.0>()
    'loop_grad_refuse_capture d={}'->format<d>->println
    return 0
}
