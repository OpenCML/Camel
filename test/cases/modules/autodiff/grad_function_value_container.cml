module grad_function_value_container
import { reshape, sum, tanh } from tensor
import { grad } from autodiff

// Refused: the function called is read from a tuple.
with <p: f64[..]>
func loss(): float {
    let s = float(sum(p))
    let fs = ((t: f64[..]): f64[..] => tanh(t * s), (t: f64[..]): f64[..] => t * s)
    let f = fs.0
    return float(sum(f(p)))
}

func main(): int sync {
    println(grad(loss)<reshape([0.5, 0.25, -0.35], [3])>())
    return 0
}
