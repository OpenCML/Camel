// Scalar sqrt pullbacks, including a non-trainable integer input and a tensor coefficient.
// The differentiated value is the first `with` parameter; everything else is data.
import { sqrt } from math
import { grad, with_grad } from autodiff
import { reshape, sum } from tensor

with <x: float>
func root(): float { return sqrt(x) }
with <x: f32>
func root32(): f32 { return sqrt(x) }
with <x: float>
func repeated(): float { return sqrt(x) * sqrt(x) }
with <x: float>
func integer_root(n: int): float { return sqrt(float(n)) * x }
with <w: f32[..]>
func weighted(x: f32[..], variance: float): float { return float(sum(w * x * f32(sqrt(variance)))) }

func main(): int sync {
    println('sqrt64={}'->format<with_grad(root)<4.0>()>)
    println('sqrt32={}'->format<with_grad(root32)<f32(4.0)>()>)
    println('repeated={}'->format<grad(repeated)<9.0>()>)
    println('integer={}'->format<grad(integer_root)<3.0>(4)>)
    let w = reshape<[2]>([1.0, 2.0] as f32[])
    let x = reshape<[2]>([3.0, 4.0] as f32[])
    println('weighted={}'->format<with_grad(weighted)<w>(x, 4.0)>)
    return 0
}
