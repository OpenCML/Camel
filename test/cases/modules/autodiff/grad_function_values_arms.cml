/**
 * Gradients through calls of a closure made inside the arms of a branch, the closure being
 * built before the branch. An arm is a graph of its own that reads the closure as a value; it
 * is given the values the closure captured and builds the closure again, so that the call is
 * differentiated in the arm and the gradient reaches the captured value (which depends on the
 * parameter). loss1 takes its first arm at the input, loss2 its second. The printed gradients
 * were checked against central finite differences in float64
 * (grad_function_values_reference.py, suite "arms").
 */
module grad_function_values_arms
import { Tensor, reshape, sum, tanh } from tensor
import { grad } from autodiff

with <p: f32[..]>
func loss1(): float {
    let s = sum(p)
    let g = (t: f32[..]): f32[..] => tanh(t * f32(s))
    return if s > 0.0 then sum(g(p)) else sum(g(p * 2.0)) * 0.5
}

with <p: f32[..]>
func loss2(): float {
    let s = sum(p)
    let g = (t: f32[..]): f32[..] => tanh(t * f32(s))
    return if s < 0.0 then sum(g(p)) else sum(g(p * 2.0)) * 0.5
}

func main(): int sync {
    let x = reshape([0.5, 0.25, -0.35] as f32[], [3])
    println(grad(loss1)<x>())
    println(grad(loss2)<x>())
    return 0
}
