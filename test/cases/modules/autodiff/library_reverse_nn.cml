/**
 * The four model operators' reverse laws (`lib/rulesets/transpose.cml`: `conv2d_t`,
 * `max_pool2d_t`, `avg_pool2d_t`, `embedding_t`), read against the engine's own rules.
 *
 * All four were the parity check's `forward-only` column: `jvp_conv2d`, `jvp_max_pool2d`,
 * `jvp_avg_pool2d` and `jvp_embedding` were filed and the reverse law beside each was not. The
 * reverse law is the module's own gradient operator in every case -- there is no arithmetic to
 * write -- so the law is one call each: `(conv2d_input_grad, conv2d_kernel_grad,
 * conv2d_bias_grad)`, `max_pool2d_grad`, `avg_pool2d_grad`, `embedding_table_grad`, which are the
 * operators `src/stdlib/nn/tensor_ops.cpp` builds for the same keys.
 *
 * **Why the library's leg is not printed, measured rather than assumed.** A `vjp` through `conv2d`
 * is refused on this host with
 *
 *     TRANSPOSE function=split_of_jvp_of_conv_input_plain_backward skip=law-reads-a-value
 *     uri=nn:conv2d position=0 operand-types=f32[1, 2, 4, 4],f32[...],f32[...]
 *     reason=the rule's right side reads a value the caller does not carry
 *
 * -- the same sentence the mask laws of `library_reverse_elementwise.cml` and the adjoint of
 * `sum_to` are refused with, and here it is not avoidable by rewriting the law: a convolution's
 * adjoint is the kernel's gradient *at the other operand's values*, so any law for this key reads
 * one, and a transposed map is handed the cotangent and nothing else. `avg_pool2d` and `embedding`
 * are refused the same way; `max_pool2d` is not even reached, because `jvp_max_pool2d` writes its
 * linear half with `avg_pool2d`.
 *
 * So this case prints the engine's number for each operator -- the number the law is the adjoint
 * of -- and marks the library's leg `filed-not-walked`. The law is filed because the two halves of
 * the table must agree on the key, and the wall is upstream of it: the walk carries a tangent, not
 * a value. `avg_pool2d_t` and `embedding_t` are still worth having for the day that changes, and
 * `avg_pool2d_t` in particular is the key a `max_pool2d` gradient stops on today.
 *
 * The inputs are the ones `nn_grad_check.cml` uses for the same operators, so a reader can compare
 * the two cases line by line; `nn engine_answered=true` says the three engine legs produced a
 * non-zero array, which is the guard that this reading is not passing on three zeros.
 */

import { grad } from autodiff
import { avg_pool2d, conv2d, embedding, max_pool2d } from nn
import { abs, reshape, sum, tanh } from tensor

func image() => f32[...] {
    return reshape<[1, 2, 4, 4]>([0.1, -0.4, 0.8, 0.3, -0.9, 0.5, 0.2, -0.1, 0.7, -0.3, 0.6, 0.4, -0.2, 0.9, -0.6, 0.1, 0.3, -0.8, 0.5, 0.2, -0.4, 0.6, 0.1, -0.7, 0.8, -0.5, 0.3, 0.9, -0.1, 0.2, 0.4, -0.6] as f32[])
}
func kernel() => f32[...] {
    return reshape<[3, 2, 2, 2]>([0.5, -0.3, 0.2, 0.7, -0.4, 0.1, 0.6, -0.2, 0.3, 0.8, -0.5, 0.4, 0.2, -0.6, 0.9, 0.1, -0.7, 0.3, 0.5, 0.2, -0.1, 0.4, -0.3, 0.6] as f32[])
}
func bias() => f32[...] {
    return [0.1, -0.2, 0.3] as f32[]
}
func weights() => f32[...] {
    return reshape<[1, 3, 3, 3]>([0.3, -1.2, 0.5, 2.0, 1.1, 0.4, -0.7, 0.2, -0.5, 0.9, 1.3, -0.1, 0.8, -0.6, 0.2, 0.4, 1.0, -0.3, 0.6, 0.7, -0.9, 0.5, 0.1, -0.4, 0.3, 0.2, -0.8] as f32[])
}
func table() => f32[...] {
    return reshape<[4, 3]>([0.2, -0.7, 1.1, 0.5, 0.3, -0.4, -0.9, 0.8, 0.1, 0.6, -0.2, 0.7] as f32[])
}

with <x: f32[...]>
func conv_input() => float {
    return float(sum(tanh(conv2d(x, kernel(), bias())) * weights()))
}

with <x: f32[...]>
func pools() => float {
    return float(sum(tanh(max_pool2d(x, 2)))) + float(sum(tanh(avg_pool2d(x, 2, 1))))
}

with <t: f32[...]>
func embed() => float {
    return float(sum(tanh(embedding(t, int([1, 3, 1, 0] as int[])))))
}

func main() => int sync {
    let image_values = image() as f32[1, 2, 4, 4]
    let conv_engine = grad(conv_input)<image_values>()
    `conv2d engine={} library=filed-not-walked`->format<conv_engine>->println

    let pool_engine = grad(pools)<image_values>()
    `pools engine={} library=filed-not-walked`->format<pool_engine>->println

    let table_values = table() as f32[4, 3]
    let embed_engine = grad(embed)<table_values>()
    `embedding engine={} library=filed-not-walked`->format<embed_engine>->println

    let answered = sum(abs(conv_engine)) > 0.0 && sum(abs(pool_engine)) > 0.0 && sum(abs(embed_engine)) > 0.0
    `nn engine_answered={}`->format<answered>->println
    return 0
}