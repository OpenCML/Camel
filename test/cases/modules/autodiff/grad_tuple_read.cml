/**
 * The value `with_grad` gives is an ordinary tuple: element 0 is the value of the call and
 * element 1 the gradient. A program reads them the way it reads any tuple's elements: as
 * operands, through a second name, and a field of the gradient. A tuple a function returns is
 * read the same way.
 * Expected output:
 *   with_grad: value 1.0 grad 3.0 by name 1.0 grad by name 3.0
 *   pair: 3.0 2.0
 */
module grad_tuple_read
import { reshape, sum } from tensor
import { with_grad } from autodiff

type P = { p0: f64[] }

with <m: P>
func loss(x: f64[], var acc: f64[]): float sync {
    let a = acc * 1.0
    acc = a * 0.5 + x
    return sum(m.p0 * x) + sum(a)
}

func pair(x: float, y: float): (float, float) {
    return (x + y, x * y)
}

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let m = { p0: reshape([0.5, 0.25], [2]) }
    var acc = reshape([0.0, 0.0], [2])
    let vg = with_grad(loss)<m>(x, acc)
    let d = vg.1
    println(
        "with_grad: value {} grad {} by name {} grad by name {}"->format<
            vg.0,
            sum(vg.1.p0),
            vg.0,
            sum(d.p0)>)
    let p = pair(1.0, 2.0)
    println("pair: {} {}"->format<p.0, p.1>)
    return 0
}