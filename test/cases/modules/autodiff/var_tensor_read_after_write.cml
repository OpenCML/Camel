/**
 * Refused: the variable is read after the differentiated function assigned it a value that
 * depends on a differentiated parameter. Taking the read as a constant would drop the
 * gradient through `acc` (the true gradient of p0 is 2 * x) without any sign of it.
 */
module var_tensor_read_after_write
import { Tensor, reshape, sum } from tensor
import { with_grad } from autodiff

type P = { p0: Tensor }

with <m: P>
func loss(x: Tensor, var acc: Tensor): float sync {
    acc = m.p0 * x
    let b = acc * 1.0
    return sum(m.p0 * x) + sum(b)
}

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let m = { p0: reshape([0.5, 0.25], [2]) }
    var acc = reshape([0.0, 0.0], [2])
    let vg = with_grad(loss)<m>(x, acc)
    println("value {} grad {}"->format<vg.0, sum(vg.1.p0)>)
    return 0
}
