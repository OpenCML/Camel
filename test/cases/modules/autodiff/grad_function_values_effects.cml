/**
 * The structures of grad_function_values in code with effects: the functions print, so their
 * statements are ordered, and the function values reach their calls behind the gates that
 * keep that order. The gradients are those of the same losses without the prints, checked
 * against central finite differences in float64 (grad_function_values_reference.py, suite
 * "effects"), and every print must still happen once, in order, before the gradient is printed.
 */
import { reshape, sum, tanh } from tensor
import { grad } from autodiff

func make(s: float): (t: f32[..]) => f32[..] sync {
    println('make')
    return (t: f32[..]): f32[..] => tanh(t * f32(s))
}

func apply(f: (t: f32[..]) => f32[..], p: f32[..]): f32[..] sync {
    println('apply')
    let a = f(p)
    println('apply: first call done')
    return a + f(p * 0.5)
}

// 1. a closure passed to a function that prints and calls it twice
with <p: f32[..]>
func loss1(): float sync {
    println('loss1')
    let s = float(sum(p))
    let r = apply((t: f32[..]): f32[..] => tanh(t * f32(s)), p)
    println('loss1: applied')
    return float(sum(r))
}

// 2. a closure returned by a factory that prints, called twice
with <p: f32[..]>
func loss2(): float sync {
    println('loss2')
    let g = make(float(sum(p)))
    println('loss2: made')
    return float(sum(g(p) * g(p * 0.5)))
}

// 3. a closure called inside a second closure, built after a print
with <p: f32[..]>
func loss3(): float sync {
    let s = float(sum(p))
    let g = (t: f32[..]): f32[..] => tanh(t * f32(s))
    println('loss3')
    let h = (t: f32[..]): f32[..] => g(t) * 2.0 + g(t * 0.5)
    println('loss3: built')
    return float(sum(h(p)))
}

func main(): int sync {
    let x = reshape([0.5, 0.25, -0.35] as f32[], [3])
    println(grad(loss1)<x>())
    println(grad(loss2)<x>())
    println(grad(loss3)<x>())
    return 0
}
