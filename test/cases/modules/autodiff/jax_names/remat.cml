/**
 * `remat` is the name this tree gives the transform that trades memory for recomputation: the same
 * values, with the annotated section recomputed in the backward pass instead of kept. JAX spells it
 * `jax.checkpoint` and, by its own other name, `jax.remat`; in this tree "checkpoint" is the
 * persistence module `ckpt` (stdlib/ckpt.cml) and stays that, so the transform takes the other
 * word. That is the author's ruling of 2026-10-30, and there is no second name to keep compatible.
 *
 * This program was the pin of the name's absence; the name has arrived, and it is a transform of the
 * `transforms` module (stdlib/signatures/transforms.cml), so the import names that module. What the
 * call gives is a function whose graph is `square`'s graph with the recompute property set, and its
 * value at 2 is 4.0 -- the mark does not change what the body computes. The graph property and the
 * gradient through the same value are read by `modules.remat`.
 */

import { remat } from transforms

func square(x: float): float {
    return x * x
}

func main(): int sync {
    let g = remat(square)
    println('jax_remat g={}'->format<g(2.0)>)
    return 0
}