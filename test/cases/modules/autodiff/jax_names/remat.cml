/**
 * `remat` is the name this tree gives the transform that trades memory for recomputation: the same
 * values, with the annotated section recomputed in the backward pass instead of kept. JAX spells it
 * `jax.checkpoint` and, by its own other name, `jax.remat`; in this tree "checkpoint" is the
 * persistence module `ckpt` (stdlib/ckpt.cml) and stays that, so the transform takes the other
 * word. That is the author's ruling of 2026-10-30, and there is no second name to keep compatible.
 *
 * This program was the pin of the name's absence: an import of a name `autodiff` did not export,
 * refused with the diagnostic that names it. The name has arrived, so the same program now runs on
 * the other side of the pin: `remat` gives back the function it is handed, so `remat(square)` is
 * `square` and its value at 2 is 4.0. The gradient through the same wrapper is read by
 * `test/cases/modules/autodiff/remat_identity.cml`
 * (docs/handover/reviews/questions-2026-10-30-jax.md, J8).
 */

import { remat } from autodiff

func square(x: float): float {
    return x * x
}

func main(): int sync {
    let g = remat(square)
    println('jax_remat g={}'->format<g(2.0)>)
    return 0
}