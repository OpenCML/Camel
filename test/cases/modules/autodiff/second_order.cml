/**
 * Second-order gradients: grad of a function that itself calls grad. The inner gradient is a
 * graph like any other, so the outer transformation applies to it unchanged.
 *   scalar: f(x) = x^3, f'(x) = 3x^2, f''(x) = 6x          -> f''(2) = 12
 *   tensor: g(x) = sum(x^3), h(x) = sum(grad(g)(x)) = sum(3x^2), grad(h)(x) = 6x
 */
module second_order

import { Tensor, reshape, sum } from tensor
import { grad } from autodiff
import { get_env } from sys

func cube(x: float): float {
    return x * x * x
}

func dcube(x: float): float {
    return grad(cube)(x)
}

func g(x: Tensor): float {
    return sum(x * x * x)
}

func h(x: Tensor): float {
    return sum(grad(g)(x))
}

func main(): int sync {
    // Read at run time, so the gradient graphs stay general rather than folding to constants.
    let x = if get_env('SECOND_ORDER_X') == '' then 2.0 else 2.0
    'scalar d2={}'->format<grad(dcube)(x)>->println
    let t = reshape([1.0, -2.0, 0.5], [3])
    println(grad(h)(t))
    return 0
}
