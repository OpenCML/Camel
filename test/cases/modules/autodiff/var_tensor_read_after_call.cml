/**
 * Refused: the variable is read after a call of the differentiated function that receives it
 * and may write it (`push` stores a value that depends on the parameter).
 */
module var_tensor_read_after_call
import { Tensor, reshape, sum } from tensor
import { value_and_grad } from autodiff

type P = { p0: Tensor }

sync func push(v: Tensor, var acc: Tensor): int sync {
    acc = v
    return 0
}

sync func loss(m: P, x: Tensor, var acc: Tensor): float sync {
    wait push(m.p0 * x, acc)
    let b = acc * 1.0
    return sum(m.p0 * x) + sum(b)
}

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let m = { p0: reshape([0.5, 0.25], [2]) }
    var acc = reshape([0.0, 0.0], [2])
    let vg = wait value_and_grad(loss)(m, x, acc)
    println("value {} grad {}"->format<vg.0, sum(vg.1.p0)>)
    return 0
}
