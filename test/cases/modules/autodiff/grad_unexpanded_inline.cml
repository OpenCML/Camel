/**
 * grad left to run with the program (std::macro did not run, or ran after an
 * inlining pass) differentiates the graphs the passes left. Inlining must
 * leave the functions it will transform as compiled: branch arms as calls
 * (leaky), a recursive call not merged into its arm (power), and, when the
 * function only arrives as a parameter (of_param), every function.
 */
module grad_unexpanded_inline

import { grad } from autodiff

with <x: float>
func leaky(): float {
    return if x > 0.0 then x * x else 0.5 * x
}

with <x: float>
func power(n: int): float {
    return if n == 0 then 1.0 else x * power<x>(n - 1)
}

with <x: float>
func cube(): float {
    return if x > 0.0 then x * x * x else 0.0 - x
}

func of_param(f: <x: float> () => float, x: float): float {
    return grad(f)<x>()
}

func main(): int sync {
    println('before grad')
    let a = grad(leaky)<3.0>()
    let b = grad(power)<2.0>(5)
    let c = of_param(cube, 2.0)
    // The same functions called directly are still inlined and still agree.
    let d = leaky<3.0>() + power<2.0>(5) + cube<2.0>()
    'grad_unexpanded_inline a={} b={} c={} d={}'->format<a, b, c, d>->println
    return 0
}
