/**
 * A differentiated function that grows an array variable with `acc = acc->append<v>` (the
 * in-place `:op/assn_owned`, design principles 11.3) and reads it (`len(parts)`, a read that
 * leaves the variable's mark set). The array holds plain numbers: no gradient flows through
 * it, so the gradient is that of the tensor term only, and the values are those of the plain
 * call. Expected output:
 *   plain call: value 3.0
 *   with_grad: value 3.0 grad 3.0
 */
module var_array_append
import { Tensor, reshape, sum } from tensor
import { with_grad } from autodiff

type P = { p0: Tensor }

with <m: P>
func loss(x: Tensor): float sync {
    var parts: int[] = []
    parts = parts->append<1>
    parts = parts->append<2>
    let n = len(parts)
    return sum(m.p0 * x) + float(n)
}

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let m = { p0: reshape([0.5, 0.25], [2]) }
    println("plain call: value {}"->format<loss<m>(x)>)
    let vg = with_grad(loss)<m>(x)
    println("with_grad: value {} grad {}"->format<vg.0, sum(vg.1.p0)>)
    return 0
}
