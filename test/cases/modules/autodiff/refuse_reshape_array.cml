/**
 * A float array is a continuous value with a tangent (design principles 9.9). Reshaping one
 * into a tensor has a known adjoint — the elements in order — but the tensor module has no
 * operator that carries a tensor's gradient back into an array, so `reshape` refuses by name at
 * the operator instead of dropping the array's gradient and handing back zeros. The array below
 * is built from the differentiated parameter, so it is active: the gradient has to reach it.
 *
 * Red when the refusal is removed (the program then runs and exits 0, printing a gradient that
 * silently left the array out), when it stops naming the operator, or when it is no longer
 * located at the reshape call on line 18.
 */
module refuse_reshape_array

import { reshape, sum } from tensor
import { with_grad } from autodiff

type Model = { w: float }

with <m: Model>
func loss(): float {
    let a = [m.w * 2.0, m.w * 3.0]
    let t = reshape(a, [2])
    return sum(t)
}

func main(): int sync {
    let model = { w: 2.0 }
    let (v, g) = with_grad(loss)<model>()
    println('{} {}'->format<v, g>)
    return 0
}