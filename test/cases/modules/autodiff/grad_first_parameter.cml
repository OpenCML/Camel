/**
 * `grad(f)` and `value_and_grad(f)` differentiate the first normal parameter of `f` (9.9); every
 * other parameter is data and takes no part in the differentiation. `with` parameters are
 * configuration: they stay `with` parameters of the gradient function and are never
 * differentiated. Differentiating another parameter needs a lambda that reorders it to the
 * first position.
 *
 * The gradient has the shape of the first parameter: a scalar for a float, a struct of the same
 * shape for a struct, a tensor of the same shape for a tensor. `value_and_grad` returns
 * `(value, gradient)`.
 */
module grad_first_parameter

import { grad, value_and_grad } from autodiff
import { Tensor, reshape, sum } from tensor

// d/dx (x*y + x) = y + 1; d/dy = x.
func weighted(x: float, y: float): float {
    return x * y + x
}

type Point = { a: float, b: float }

// The gradient is a Point: (y, 1).
func point_loss(p: Point, y: float): float {
    return p.a * y + p.b
}

// The gradient is a tensor of the weight's shape: x.
func dot(w: Tensor, x: Tensor): float {
    return sum(w * x)
}

with <k: float>
func scaled(x: float, y: float): float {
    return k * x * y
}

func main(): int sync {
    let gx = grad(weighted)(3.0, 2.0)
    let vg = value_and_grad(weighted)(3.0, 2.0)

    // Differentiating the second parameter: reorder it to the front with a lambda.
    let gy = grad((y: float): float => weighted(3.0, y))(2.0)
    // A lambda is a function of its own; its first parameter is differentiated.
    let gl = grad((x: float): float => weighted(x, 2.0))(3.0)

    let p = { a: 2.0, b: 3.0 }
    let pg = grad(point_loss)(p, 4.0)
    let pvg = value_and_grad(point_loss)(p, 4.0)

    let w = reshape([1.0, 2.0, 3.0], [3])
    let x = reshape([4.0, 5.0, 6.0], [3])
    let wg = grad(dot)(w, x)
    let wvg = value_and_grad(dot)(w, x)

    // `k` is configuration, not a differentiated parameter.
    let sg = grad(scaled)<2.0>(3.0, 4.0)

    'grad_first_parameter gx={} vg={} gy={} gl={}'->format<gx, vg, gy, gl>->println
    'grad_first_parameter pg={} pvg={}'->format<pg, pvg>->println
    'grad_first_parameter wg={} wvg={}'->format<wg, wvg>->println
    'grad_first_parameter with_config={}'->format<sg>->println
    return 0
}