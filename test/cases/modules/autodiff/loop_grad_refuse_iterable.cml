/**
 * Verifies the refusal of a loop that iterates over an array which depends on a differentiated
 * parameter: the rounds would each have to carry the array's gradient, and an array has no
 * cotangent, so the diagnostic names the loop and the array rather than giving a wrong gradient.
 */
module loop_grad_refuse_iterable

import { grad } from autodiff

func f(w: float): float {
    let xs = [w, w * 2.0, w * 3.0]
    return loop acc = 0.0 for x in xs do acc + x
}

func main(): int sync {
    let d = grad(f)(2.0)
    'loop_grad_refuse_iterable d={}'->format<d>->println
    return 0
}