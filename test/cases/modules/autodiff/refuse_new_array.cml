/**
 * `new(xs)` converts a numeric array into a tensor, and an array's tangent is the array of its
 * elements' tangents (design principles 9.9): the gradient of the tensor's elements would have
 * to go back into an array of the same shape. The tensor module has no operator that carries a
 * gradient from a tensor back into an array, so the gradient of this call cannot be built (it
 * would be dropped silently). The refusal names the operator and the array's type, at the line
 * of the call, and says which shape of program does work instead. A constant array is not
 * refused: it starts no gradient flow, so the call that converts one is never visited.
 */
module new_array_refuse

import { new, sum } from tensor
import { grad } from autodiff

with <xs: float[]>
func loss(): float {
    let t = new(xs)
    return sum(t)
}

func main(): int sync {
    let xs = [1.0, 2.0]
    println(grad(loss)<xs>())
    return 0
}