/**
 * Refused: a variable of a differentiable type declared inside the differentiated function and
 * read there. Its content depends on a differentiated parameter; `let` is what carries a
 * gradient.
 */
import { reshape, sum } from tensor
import { with_grad } from autodiff

type P = { p0: f64[..] }

with <m: P>
func loss(x: f64[..]): float sync {
    var t = m.p0 * x
    t = t * 2.0
    return float(sum(t))
}

func main(): int sync {
    let x = reshape<[2]>([1.0, 2.0])
    let m = { p0: reshape<[2]>([0.5, 0.25]) }
    let vg = with_grad(loss)<m>(x)
    println("value {} grad {}"->format<vg.0, sum(vg.1.p0)>)
    return 0
}
