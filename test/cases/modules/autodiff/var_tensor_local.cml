/**
 * A variable of a differentiable type declared inside the differentiated function and read
 * there: the gradient flows, and it is the true one.
 *
 * The declaration is a same-region local `var`, so it is built as the value it was given rather
 * than as a cell, and a value carries a gradient where a variable read is taken as a constant.
 * This used to be refused -- "a variable of a differentiable type that is declared inside the
 * differentiated function is read there" -- and the repair that diagnostic named was to bind the
 * value with `let`, which is what the compiler now builds for this local.
 */
import { with_grad } from autodiff
import { reshape, sum } from tensor

type P = { p0: f64[...] }

with <m: P>
func loss(x: f64[...]) => float sync {
    var t = m.p0 * x
    t = t * 2.0
    return float(sum(t))
}

func main() => int sync {
    let x = reshape<[2]>([1.0, 2.0])
    let m = { p0: reshape<[2]>([0.5, 0.25]) }
    let vg = with_grad(loss)<m>(x)
    println('value {} grad {}'->format<vg.0, sum(vg.1.p0)>)
    return 0
}
