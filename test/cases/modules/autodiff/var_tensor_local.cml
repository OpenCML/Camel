/**
 * Refused: a variable of a differentiable type declared inside the differentiated function and
 * read there. Its content depends on a differentiated parameter; `let` is what carries a
 * gradient.
 */
module var_tensor_local
import { Tensor, reshape, sum } from tensor
import { value_and_grad } from autodiff

type P = { p0: Tensor }

with <m: P>
func loss(x: Tensor): float sync {
    var t = m.p0 * x
    t = t * 2.0
    return sum(t)
}

func main(): int sync {
    let x = reshape([1.0, 2.0], [2])
    let m = { p0: reshape([0.5, 0.25], [2]) }
    let vg = value_and_grad(loss)<m>(x)
    println("value {} grad {}"->format<vg.0, sum(vg.1.p0)>)
    return 0
}
