/**
 * `vjp` over a function whose result is a pair: the pullback takes the pair's cotangent and answers
 * the gradient of the first member, and the two seeds below are what separates it from a pullback that
 * never reached the weight at all.
 *
 * This case used to pin a refusal. `transpose` took only a result whose cotangent was one of the two
 * scalar float widths, so `vjp(loss)` for a pair-returning `loss` stopped inside the library with
 * "takes a function whose result has a cotangent" -- and that sentence was wrong: a pair has a
 * cotangent, the pair of the members' cotangents (design principles 9.9, author `f6ee4f5d0`). With the
 * law asking the result's tangent space instead of listing two type codes, the same call answers
 * numbers.
 *
 * Why two seeds and not one. `grad=0.0` is a legal gradient, so a single zero would not tell a walk
 * that never distributed the cotangent from a function whose derivative really is zero. Seeding
 * `(1.0, 0.0)` asks only the value half and must answer 6.0 (`d(x*x) = 2x` at 3); seeding
 * `(0.0, 1.0)` asks only the auxiliary half and must answer 1.0 (`d(x + 10) = 1`). A pullback that
 * handed back a zero for both, or that answered 6.0 twice, fails here rather than in a reader's head.
 */
import { vjp } from vjp

func loss(x: float): (float, float) {
    return (x * x, x + 10.0)
}

func main(): int sync {
    let (y, pullback) = vjp(loss)(3.0)
    let value = y.0
    let aux = y.1
    let first = pullback((1.0, 0.0))
    let second = pullback((0.0, 1.0))
    println('has_aux_vjp_pair')
    println('value={} aux={}'->format<value, aux>)
    println('seed_value grad={}'->format<first.0>)
    println('seed_aux grad={}'->format<second.0>)
    return 0
}