/**
 * The array refusals of the tensor module (`new`, `reshape` and `concat` make the same one) cover
 * `cast` too. `cast(xs, 'float32')` accepts a numeric array (`Tensor | number[]`) and returns a
 * tensor; an array's tangent is the array of its elements' tangents (design principles 9.9), so the
 * gradient of the tensor would have to go back into an array, which no operator of this module
 * builds from a tensor's gradient. The rule used to drop it and the pass materialized the array's
 * zero: the program printed `[0.0, 0.0, 0.0]` for a loss whose gradient is [1, 1, 1] -- the silent
 * zero this class of defect is about. It is refused by name at the cast call (line 18), naming the
 * operator and the array's type. A constant array is not refused: it starts no gradient flow.
 */
module refuse_cast_array

import { cast, sum } from tensor
import { grad } from autodiff

with <xs: float[]>
func loss(): float {
    let t = cast(xs, 'float32')
    return sum(t)
}

func main(): int sync {
    let xs = [1.0, 2.0, 3.0]
    println(grad(loss)<xs>())
    return 0
}