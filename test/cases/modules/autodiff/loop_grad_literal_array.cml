/**
 * A differentiated loop over an array literal. Nothing that can carry a gradient reaches the
 * array, so the reverse pass carries no array gradient for it: the graph `std::jgir` prints after
 * `std::macro` has no `:tangent/zeros_arr` and no `:tangent/scatter_add_arr` (design principles
 * 9.9). Its twin `loop_grad_parameter_array.cml` -- the same loop body over an array built from
 * the parameter -- has both. The gradient of w + w * (1 + 2 + 3) at 2 is 7.
 */

import { grad } from autodiff

with <w: float>
func f(): float {
    let xs = [1.0, 2.0, 3.0]
    return loop acc = w for x in xs do acc + x * w
}

func main(): int sync {
    'loop_grad_literal_array d={}'->format<grad(f)<2.0>()>->println
    return 0
}