/**
 * A differentiated loop over an array literal. Nothing that can carry a gradient reaches the
 * array, so the reverse pass carries no array gradient for it: no array site port, no zero array
 * and no per-round scatter (design principles 9.9). `std::stats` prints the node count this case
 * pins, and its twin `loop_grad_parameter_array.cml` -- the same loop body over an array built
 * from the parameter -- prints a larger one.
 */
module loop_grad_literal_array

import { grad } from autodiff

with <w: float>
func f(): float {
    let xs = [1.0, 2.0, 3.0]
    return loop acc = w for x in xs do acc + x * w
}

func main(): int sync {
    'loop_grad_literal_array d={}'->format<grad(f)<2.0>()>->println
    return 0
}