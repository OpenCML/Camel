/**
 * `new` converts a container to a tensor by flattening it, and a container that is not a numeric
 * array has no adjoint (design principles 9.9): the gradient would have to return as an array of
 * arrays, which no operator of this module builds from a tensor's gradient. The call is refused
 * by name while the container depends on a differentiated parameter, at the call and with the
 * container's type named -- `refuse_container_reshape.cml` is the same refusal for `reshape`.
 *
 * Without it the program got a run-time fault from the kernels that read the container as a tensor
 * ("Expected an array argument", with no place in the source), which is what makes this case worth
 * its own assertion. A numeric array is a tensor and is not refused: `adjoint_new_array.cml`
 * asserts its adjoint. A constant container is converted by the forward rule as usual and is never
 * visited here.
 */

import { new, sum } from tensor
import { grad } from autodiff

with <xs: float[][]>
func loss(): float {
    return float(sum(new(xs)))
}

func main(): int sync {
    let xs: float[][] = [[1.0, 2.0], [3.0, 4.0]]
    println('refuse_container_new g={}'->format<grad(loss)<xs>()>)
    return 0
}