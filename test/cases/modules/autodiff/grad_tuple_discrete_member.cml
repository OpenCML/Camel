/**
 * A tuple model keeps its discrete member in the gradient: `with <m: (f32[..], int)>` gets a
 * gradient of the same type, `(f32[..], int)`, and the `int` member's value is the zero of its own
 * type. The gradient of a parameter is what the user sees -- `grad of P`, and the value
 * `grad`/`with_grad` hand back -- and *that* is what tells the two answers apart, not whether the
 * parameter is a struct or a tuple (the rule of 2026-10-25 on
 * discrete-tuple-tangent-space-and-machinery-aggregates: "a model written as a tuple
 * `with <m: (f32[..], int)>` must get `(f32[..], int)` back too, with the `int` at zero").
 *
 * `let g: (f32[..], int) = gradient` pins the other half: the gradient is the model's own type, not
 * a tuple of some other shape, and the value printed for the discrete member is that member's zero.
 * Nothing flows through `k` -- the loss is `sum(p) * k`, so `k`'s own gradient is zero whatever the
 * program does -- while the tensor member's gradient is real: every element's is `k`, and the
 * printed sum is `3 * k`.
 */
module grad_tuple_discrete_member

import { reshape, sum } from tensor
import { with_grad } from autodiff

with <m: (f32[..], int)>
func loss(): float {
    let (p, k) = m
    return float(sum(p)) * float(k)
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    let model = (x, 2)
    let (value, gradient) = with_grad(loss)<model>()
    let g: (f32[..], int) = gradient
    let (gp, gk) = g
    'grad_tuple_discrete_member value={:.1f} grad_sum={:.1f} k={}'->format<
        value,
        sum(gp),
        gk>->println
    return 0
}