/**
 * Derivative rules of the patterns tensor::fuse marks as one group. The graph keeps matmul, add
 * and relu (design principles 9.6), so grad differentiates the program's own operators; run it
 * after tensor::fuse and without std::macro: the group attribute changes no operator to differentiate.
 * For each function f and direction v, sum(grad(f)(x) * v) must match
 * (f(x + h v) - f(x - h v)) / 2h; the weights and bias receive gradients through w_of and b_of.
 */
module fused_grad_check

import { grad } from autodiff
import { new, sum, relu } from tensor

func check(name: string, f: <x: f32[..]> () => float, df: <x: f32[..]> () => f32[..], x: f32[..], v: f32[..]): int sync {
    let h = 0.001
    let analytic = float(sum(df<x>() * v))
    let numeric = (f<x + v * h>() - f<x - v * h>()) / (2.0 * h)
    let err = analytic - numeric
    let scale = if numeric > 1.0 then numeric else if numeric < -1.0 then 0.0 - numeric else 1.0
    let rel = if err > 0.0 then err / scale else (0.0 - err) / scale
    let status = if rel < 0.02 then "ok" else "FAIL"
    '{} {} analytic={} numeric={}'->format<name, status, analytic, numeric>->println
    return 0
}

func x23(): f32[..] { return new([[0.3, -1.2, 0.5], [1.1, 0.4, -0.7]] as f32[][]) }
func w34(): f32[..] { return new([[0.3, -1.2, 0.5, 2.0], [1.1, 0.4, -0.7, 0.2], [-0.5, 0.9, 1.3, -0.1]] as f32[][]) }
func b4(): f32[..] { return new([0.7, -0.3, 1.5, 0.2] as f32[]) }
func out24(): f32[..] { return new([[1.0, -2.0, 0.5, 0.3], [0.4, 1.2, -0.6, 0.9]] as f32[][]) }

// matmul + bias (one fused group), in each operand
with <x: f32[..]>
func lin_x(): float { return float(sum((x @ w34() + b4()) * out24())) }
with <w: f32[..]>
func lin_w(): float { return float(sum((x23() @ w + b4()) * out24())) }
with <b: f32[..]>
func lin_b(): float { return float(sum((x23() @ w34() + b) * out24())) }
// matmul + bias + relu (one fused group)
with <x: f32[..]>
func mlp_x(): float { return float(sum(relu(x @ w34() + b4()) * out24())) }
with <w: f32[..]>
func mlp_w(): float { return float(sum(relu(x23() @ w + b4()) * out24())) }
with <b: f32[..]>
func mlp_b(): float { return float(sum(relu(x23() @ w34() + b) * out24())) }

func main(): int sync {
    let vx = new([[0.2, -0.4, 0.9], [-0.3, 0.8, 0.1]] as f32[][])
    let vw = new([[0.5, 0.1, -0.2, 0.3], [-0.6, 0.4, 0.2, -0.1], [0.3, -0.5, 0.7, 0.2]] as f32[][])
    let vb = new([0.3, -0.7, 0.2, 0.5] as f32[])
    check('linear.x', lin_x, grad(lin_x), x23(), vx)
    check('linear.w', lin_w, grad(lin_w), w34(), vw)
    check('linear.b', lin_b, grad(lin_b), b4(), vb)
    check('linear_relu.x', mlp_x, grad(mlp_x), x23(), vx)
    check('linear_relu.w', mlp_w, grad(mlp_w), w34(), vw)
    check('linear_relu.b', mlp_b, grad(mlp_b), b4(), vb)
    return 0
}
