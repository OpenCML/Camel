module grad_closure_unknown
import { Tensor, reshape, sum, tanh } from tensor
import { grad } from autodiff

// Refused: the function called is a parameter; which function it is is not evident at the call.
func apply(f: (t: Tensor) => Tensor, p: Tensor): Tensor {
    return f(p)
}

func loss(p: Tensor): float {
    let s = sum(p)
    return sum(apply((t: Tensor): Tensor => tanh(t * s), p))
}

func main(): int sync {
    println(sum(grad(loss)(reshape([0.5, 0.25], [2]))))
    return 0
}
