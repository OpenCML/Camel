/**
 * `grad(f)` and `with_grad(f)` differentiate the first `with` parameter of `f` (9.9); the
 * remaining `with` parameters are constants and the ordinary parameters are data. The gradient
 * has the shape of the first `with` parameter: a float, a struct of the same shape, or a tensor
 * of the same shape. `with_grad` returns `(value, gradient)`.
 *
 * Differentiating a value that is not the first `with` parameter needs a lambda that makes it
 * the first `with` parameter (an adversarial example, a target, a second weight).
 *
 * The criterion is per element, not a sum or a product (author's ruling of 2026-11-03 15:15: 判据
 * 分辨不了对错——不算判据). Every number this case prints is asserted by both plan entries, the
 * tensor gradient's three members included, and each group is here because a wrong law answers
 * something else:
 *
 *   - `dot`, w = [1, 2, 3], x = [4, 5, 6]: the gradient of `w` is `x`, member by member --
 *     [4.0, 5.0, 6.0]. The law that differentiates the ordinary parameter instead answers `w` =
 *     [1.0, 2.0, 3.0]; the law that hands the cotangent back unchanged (`pb(ct) = ct`) answers
 *     [1.0, 1.0, 1.0]. The sums of those three answers are 15, 6 and 3, so the array itself is
 *     the assertion -- a sum would have to be told which wrong answer it is looking at.
 *   - `scaled`, k = 2.0, x = 3.0: `sk` is d/dk = x * 2 = 6.0. A law that differentiated the
 *     *second* `with` parameter answers d/dx = k * 2 = 4.0, which is exactly what `sx` prints --
 *     so `sk` and `sx` on one line separate "first" from "second" by two different numbers, and
 *     the identity law answers 1.0 for `sk`.
 *   - `point_loss`, p = { a: 2.0, b: 3.0 }, y = 4.0: the gradient is the `Point`
 *     `{ a: 4.0, b: 1.0 }`. The ordinary-parameter law answers 2.0 -- a float where the gradient
 *     is a struct, so it is refused by type before it can print; the identity law answers
 *     `{ a: 1.0, b: 1.0 }`, the same shape with different data.
 *   - `weighted`, x = 3.0, y = 2.0: `vg`'s gradient is y + 1 = 3.0, and **this group alone cannot
 *     separate the two laws**: the ordinary-parameter law answers d/dy = x = 3.0, the very same
 *     number (the identity law answers 2.0). That is why the case carries the other three groups,
 *     and why a bare `3.0` printed on its own is the shape of criterion the ruling rejects.
 *
 * The library's `with_grad` would be the same transform written as the composition
 * `vjp((ww: float) => f<ww>(...))(w)` with the seed 1 read off the first member (design principles
 * 9.9), and it is not in `stdlib/vjp.cml` today: `3a2e8fc90` deleted the export that returned
 * `vjp(f)` under a declared type of `F`, and nothing has replaced it. So both plan entries measure
 * the engine's `with_grad` only. Writing the composition makes the differentiated lambda end in a
 * call to a `with`-parameterised function, and the cut refuses that graph in two places, measured:
 * `2026-11-03-when-a-lambda-ends-with-a-with-call-what-does-split-cut.cn.md`.
 */

import { grad, with_grad } from autodiff
import { reshape, sum } from tensor

// d/dx (x*y + x) = y + 1.
with <x: float>
func weighted(y: float): float {
    return x * y + x
}

type Point = { a: float, b: float }

// The gradient is a Point: (y, 1).
with <p: Point>
func point_loss(y: float): float {
    return p.a * y + p.b
}

// The gradient is a tensor of the weight's shape: x.
with <w: f64[...]>
func dot(x: f64[...]): float {
    return float(sum(w * x))
}

// `k` is the first `with` parameter and is differentiated; `x` is a second `with` parameter
// and stays constant.
with <k: float, x: float>
func scaled(): float {
    return k * x * 2.0
}

func main(): int sync {
    let gx = grad(weighted)<3.0>(2.0)
    let vg = with_grad(weighted)<3.0>(2.0)

    // Differentiating the data: reorder it to the first `with` parameter with a lambda.
    let gy = grad(<y: float> (x: float): float => x * y + x)<2.0>(3.0)
    // A lambda is a function of its own; its first `with` parameter is differentiated.
    let gl = grad(<z: float> (x: float): float => weighted<z>(x))<3.0>(2.0)

    let p = { a: 2.0, b: 3.0 }
    let pg = grad(point_loss)<p>(4.0)
    let pvg = with_grad(point_loss)<p>(4.0)

    let w = reshape<[3]>([1.0, 2.0, 3.0])
    let x = reshape<[3]>([4.0, 5.0, 6.0])
    let wg = grad(dot)<w>(x)
    let wvg = with_grad(dot)<w>(x)

    // `x` is the second `with` parameter: reorder it with a lambda to differentiate it.
    let sk = grad(scaled)<2.0, 3.0>()
    let sx = grad(<x: float> (k: float): float => scaled<k, x>())<3.0>(2.0)

    'grad_first_with_parameter gx={} vg={} gy={} gl={}'->format<gx, vg, gy, gl>->println
    'grad_first_with_parameter pg={} pvg={}'->format<pg, pvg>->println
    'grad_first_with_parameter wg={} wvg={}'->format<wg, wvg>->println
    'grad_first_with_parameter sk={} sx={}'->format<sk, sx>->println
    return 0
}
