module shape_inference_loaded_struct
import { Tensor, sum, ones, load_npy } from tensor
// Weights read from a file have no shape in their type; here one field of a struct.
type P = { w: Tensor<f32, [3]>, b: Tensor<f32, [3]> }
with <m: P>
func f(x: Tensor<f32, [3]>): float {
    return sum(m.w * x + m.b)
}
func main(): int sync {
    let p = { w: load_npy::<f32>('test/cases/modules/tensor/shape_types/x3.npy'), b: ones([3]) }
    println(f<p>(ones([3])))
    return 0
}
