module shape_inference_var_argument
import { Tensor, sum, ones } from tensor
// A variable has the widened type of its first value; no conversion applies to a variable.
func step(var s: Tensor<f32, [3]>, x: Tensor<f32, [3]>): float sync {
    s = s + x
    return float(sum(s))
}
func main(): int sync {
    var s = ones([3])
    println(step(s, ones([3])))
    return 0
}
