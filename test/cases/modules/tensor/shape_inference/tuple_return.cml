module shape_inference_tuple_return
import { tanh, sum, ones } from tensor
// Elements of a returned tuple: each one that is less exact than declared is named.
func g(x: f32[3]): (f32[..], f32[..]) {
    return (x, tanh(x))
}
func f(x: f32[3]): (f32[3], float, f32[3]) {
    let (a, b) = g(x)
    return (a, sum(x), b)
}
func main(): int sync {
    let r = f(ones([3]))
    println(r.1)
    return 0
}
