import { tanh, sum, ones } from tensor
func g(x: f32[3]): (f32[..], f32[..]) {
    return (x, tanh(x))
}
func f(x: f32[3]): (f32[3], float, f32[3]) {
    let (a, b) = g(x)
    return (a as f32[3], float(sum(x)), b as f32[3])
}
func main(): int sync {
    let r = f(ones::<f32>([3]))
    println(r.1)
    println(sum(r.0))
    return 0
}
