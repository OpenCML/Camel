/**
 * A cell whose element type is not numeric cannot be written by a `var f32[..]` parameter: the
 * declared numeric array only stands for numeric elements, so the widening that gives a cell its
 * parameter's type leaves this one alone and the call is refused. Expected: a compile-time
 * error at the argument.
 */
module var_argument_non_numeric
import { sum } from tensor

func step(var t: f64[], d: float): float sync {
    t = t + d
    return float(sum(t))
}

func main(): int sync {
    var xs = ['a', 'b']
    println(step(xs, 0.5))
    return 0
}