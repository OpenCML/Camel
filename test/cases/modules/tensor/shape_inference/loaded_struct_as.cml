module shape_inference_loaded_struct_as
import { Tensor, sum, ones, load_npy } from tensor
type P = { w: Tensor<f32, const [3]>, b: Tensor<f32, const [3]> }
with <m: P>
func f(x: Tensor<f32, const [3]>): float {
    return sum(m.w * x + m.b)
}
func main(): int sync {
    let p = { w: load_npy('test/cases/modules/tensor/shape_types/x3.npy') as Tensor<f32, const [3]>, b: ones([3]) }
    println(f<p>(ones([3])))
    return 0
}
