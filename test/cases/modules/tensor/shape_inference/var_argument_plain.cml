import { sum, ones } from tensor
// The var parameter declared with the variable's type; the value is converted where it is read.
func step(var s: f32[], x: f32[3]): float sync {
    s = (s as f32[3]) + x
    return float(sum(s))
}
func main(): int sync {
    var s = ones::<f32>([3])
    println(step(s, ones::<f32>([3])))
    return 0
}
