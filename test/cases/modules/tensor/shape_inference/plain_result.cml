import { tanh, sum, ones } from tensor
// A result declared `f32[..]` has no extents for the caller, whatever the body computes.
func g(x: f32[3]): f32[..] {
    return tanh(x)
}
func h(a: f32[3]): float {
    return float(sum(a))
}
func main(): int sync {
    let t = g(ones::<f32>([3]))
    println(h(t))
    return 0
}
