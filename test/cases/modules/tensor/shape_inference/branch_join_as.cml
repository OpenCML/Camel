module shape_inference_branch_join_as
import { Tensor, concat, slice, sum, ones } from tensor
func g(x: Tensor<f32, const [3]>, c: bool): Tensor<f32, const [-1]> {
    return if c then x else concat(x, x, 0)
}
func main(): int sync {
    println(sum(g(ones([3]), true) as Tensor<f32, const [3]>))
    return 0
}
