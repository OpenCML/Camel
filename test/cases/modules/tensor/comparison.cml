/**
 * The two comparisons of an array (design principles 4.2): `a === b` is the comparison of the
 * elements, an array of the same shape whose elements are `bool`; `a == b` is the whole
 * comparison, one `bool` that says the shapes are the same and the elements are equal
 * everywhere. Whether the element type is written in the type (`Tensor<f32>`) or left to the
 * value (`Tensor`) does not change either result, and neither does the operator's element type
 * decide which one a program gets: `==` is whole and `===` is elementwise for every array.
 *
 * The whole comparison follows the float rules of a scalar (design principles 7.3): an array
 * that holds a NaN does not equal itself and the two zeros are equal. A shape that an
 * elementwise operation cannot broadcast is an error, not `false`; `==` answers `false` there
 * because different shapes are not equal.
 */
module comparison

import { Tensor, new, cast, log, sum } from tensor

func bareEq(a: Tensor, b: Tensor): bool { return a == b }
func writtenEq(a: Tensor<f32>, b: Tensor<f32>): bool { return a == b }

func main(): int sync {
    // A scalar: `===` is `==`, and `!==` is `!=`.
    println('scalar', 1 === 1, 1 !== 2, 'a' === 'a')

    let a = new([1.0, 2.0, 3.0])
    let b = new([1.0, 2.0, 3.0])
    let e = new([1.0, 2.0, 4.0])
    println('a === b', a === b)
    println('a !== b', a !== b)
    println('a === e', a === e)
    println('a == b', a == b)
    println('a == e', a == e)
    println('a < e', a < e)

    // Different shapes: `==` is false, an elementwise comparison of them is an error.
    let c = new([1.0, 2.0])
    println('a == c', a == c)

    // The element type written or not: one answer either way.
    let w = cast([1.0, 2.0], 'float32')
    println('written', writtenEq(w, w), writtenEq(w, cast([1.0, 3.0], 'float32')))
    println('bare', bareEq(a, a), bareEq(a, e))

    // NaN and the two zeros, in both comparisons.
    let s = log(cast([-1.0, 2.0], 'float32'))
    println('nan', s == s, sum(s !== s))
    let z1: f32[] = [f32(0.0)]
    let z2: f32[] = [f32(-0.0)]
    println('zero', z1 == z2, z1 === z2)

    // A native numeric array: the same two comparisons.
    let f: f32[] = [f32(1.0), f32(2.0)]
    let g: f32[] = [f32(1.0), f32(3.0)]
    println('f32[]', f == g, f === g)
    return 0
}