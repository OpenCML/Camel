/**
 * The scalar side of a broadcasting operator.
 *
 * Every line is the same rule from a different producer of the scalar operand: a value bound with
 * the element type the tensor has, a literal written in place, and the round of `for v in x`,
 * which is one operand of `v * w`. Beside a tensor the scalar is read in the element type and the
 * rank the operator declares (design principles 5.1): nothing here converts the tensor, widens the
 * scalar to f64, or hands the operator a tensor where it asked for a value.
 */

import { new, sum, zeros } from tensor

/// A value whose type is its own, beside a tensor: `a * w` is the product of f32 values, and the
/// sum of `a * w + 0.5` is read as the f32 element type the tensor declares.
func scale(w: f32[..], a: f32): float {
    return float(sum(a * w + 0.5))
}

/// The round of a loop over a tensor is the scalar side of `v * w`. `x`'s shape is not fixed where
/// the body is compiled, so the operator has to read the round as the element type the enclosing
/// tensor declares - a value, not a tensor of its own.
func loss(w: f32[..], x: f32[..]): float {
    return loop s = 0.0 for v in x do s + float(sum(v * w + 0.5))
}

func main(): int sync {
    let w = new([0.5, 1.5, 2.5, 3.5] as f32[])
    let x = new([1.0, 2.0, 3.0, 4.0] as f32[])
    let a: f32 = 2.0
    let total = loop t = 0.0 for i in 0..3 do t + loss(w, x)
    'scalar param={}'->format<scale(w, a)>->println
    'scalar local={}'->format<sum(a * w + 0.5)>->println
    'round loss={}'->format<loss(w, x)>->println
    'round total={}'->format<total>->println
    'round left={}'->format<loop s = 0.0 for v in x do s + float(sum(v * w))>->println
    'round right={}'->format<loop s = 0.0 for v in x do s + float(sum(w * v))>->println
    'round zeros={}'->format<loop s = 0.0 for v in x do s + float(sum(v * zeros([4]) + 1.0))>->println
    'tensor tensor={}'->format<sum(x * w)>->println
    'tensor literal={}'->format<sum(x * 0.5)>->println
    'literal tensor={}'->format<sum(0.5 * x)>->println
    return 0
}
