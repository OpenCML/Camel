/**
 * `a === b` is the elementwise comparison, so its shape rule is the rule of every elementwise
 * operation (design principles 4.2): two shapes that do not broadcast are a runtime error, and
 * the error names the operator that could not broadcast them. `a == b` on the same two arrays
 * is `false` instead, because different shapes are simply not equal.
 */


import tensor

func main(): int sync {
    let a = [1.0, 2.0, 3.0] as float[]
    let c = [1.0, 2.0] as float[]
    println('{}', a === c)
    return 0
}