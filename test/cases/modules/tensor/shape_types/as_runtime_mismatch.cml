module shape_as_runtime_mismatch
import { Tensor, ones, sum, load_npy } from tensor
func f(b: Tensor<f32, [4]>): float {
    return float(sum(b))
}
func main(): int sync {
    println('ran')
    let t = load_npy::<f32>('test/cases/modules/tensor/shape_types/x3.npy')
    println(f(t as Tensor<f32, [4]>))
    return 0
}
