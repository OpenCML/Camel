module shape_unknown_extent
import { Tensor, zeros, ones, reshape, sum, tanh, load_npy } from tensor
func f(x: Tensor<const [-1, 3]>, w: Tensor<const [3, 2]>): Tensor<const [-1, 2]> {
    return tanh(x @ w)
}
func main(): int sync {
    println(f(ones([5, 3]), ones([3, 2])))
    println(f(ones([1, 3]), ones([3, 2])))
    return 0
}
