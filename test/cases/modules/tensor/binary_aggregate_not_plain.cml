/**
 * A struct with a field that is not pure data — a `string` holds a reference — has no compact
 * layout, so no run of bytes is its value and `to_bytes` has no payload to write. The element
 * type it asks for is `is_plain::<T>()`, which walks the fields and is false here, so the refusal
 * names the condition and the candidate it fails rather than faulting inside a kernel.
 */
import { to_bytes } from tensor

type Named = { name: string, n: int }

func main(): int sync {
    let ns: Named[] = [{ name: 'a', n: 1 }]
    println(to_bytes(ns))
    return 0
}