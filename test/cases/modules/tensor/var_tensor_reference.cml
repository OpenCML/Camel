/**
 * A tensor variable passed to a `var` parameter and captured by a lambda is one object: the
 * callee and the lambda replace the tensor the caller's variable holds. Expected output:
 *   2        w = zeros + 0.5, written by the callee
 *   10 10    forwarded twice to another var parameter; the callee's result and the caller's view
 *   20 20    doubled by a lambda that captured the variable
 */
module var_tensor_reference

import { zeros, sum } from tensor

func step(var w: f32[?, ?], d: f32) {
    w = w + d
}

func twice(var w: f32[?, ?]): float sync {
    step(w, 1.0)
    step(w, 1.0)
    return float(sum(w))
}

func main(): int sync {
    var w = zeros([2, 2])
    step(w, 0.5)
    println(sum(w))
    let s = twice(w)
    println('{} {}'->format<s, sum(w)>)
    let f = (): float => sync {
        w = w * 2.0
        return float(sum(w))
    }
    let r = f()
    println('{} {}'->format<r, sum(w)>)
    return 0
}
