/**
 * Shape diagnostic of `layer_norm`: statically known shapes conflict, so compilation fails at the
 * call with both shapes in the reason.
 */

import { zeros, ones, layer_norm } from tensor

func main(): int sync {
    let r = layer_norm(zeros::<f32>([2, 3]), ones::<f32>([4]), zeros::<f32>([4]))
    println('unreachable')
    return 0
}
