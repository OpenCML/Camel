/**
 * The axis of `slice`: the call names axis 3 of a rank-2 tensor, which the value does not have, so
 * the run faults with the core's own wording, naming the axes it does have (design principles 5.4).
 */

import { zeros } from tensor

func main(): int sync {
    let r = slice(zeros::<f32>([2, 3]), 3, 0, 1)
    println('unreachable')
    return 0
}
