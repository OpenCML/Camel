/**
 * Shape diagnostic of `conv2d`: statically known shapes conflict, so compilation fails at the
 * call with both shapes in the reason.
 */
module shape_diag_conv2d

import { zeros } from tensor
import { conv2d } from nn

func main(): int sync {
    let r = conv2d(zeros([1, 3, 8, 8]), zeros([4, 2, 3, 3]), zeros([4]))
    println('unreachable')
    return 0
}
