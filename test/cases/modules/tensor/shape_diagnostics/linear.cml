/**
 * Shape diagnostic of `linear`: statically known shapes conflict, so compilation fails at the
 * call with both shapes in the reason.
 */

import { zeros, linear } from tensor

func main(): int sync {
    let r = linear(zeros::<f32>([2, 3]), zeros::<f32>([4, 5]), zeros::<f32>([5]))
    println('unreachable')
    return 0
}
