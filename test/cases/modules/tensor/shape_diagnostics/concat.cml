/**
 * Shape diagnostic of `concat`: statically known shapes conflict, so compilation fails at the
 * call with both shapes in the reason.
 */
module shape_diag_concat

import { zeros, concat } from tensor

func main(): int sync {
    let r = concat(zeros([2, 3]), zeros([2, 4]), 0)
    println('unreachable')
    return 0
}
