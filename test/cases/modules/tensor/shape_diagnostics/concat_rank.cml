/**
 * Shape diagnostic of `concat_rank`: statically known shapes conflict, so compilation fails at the
 * call with both shapes in the reason.
 */

import { zeros, concat } from tensor

func main(): int sync {
    let r = concat(zeros::<f32>([2, 3]), zeros::<f32>([3]), 0)
    println('unreachable')
    return 0
}
