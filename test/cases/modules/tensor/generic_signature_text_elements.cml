/// The element type of an explicit-generic tensor signature is a numeric scalar, and the
/// signature states it: `func f::<T>(x: T[..]) when is_numeric::<T>()` applies exactly where `T` is
/// a number (design principles 4.1). An array of text fills neither arm of `shape`, so the call is
/// refused at the declaration rather than at a kernel.
module tensor_generic_signature_text_elements

import { shape } from tensor

func main(): int sync {
    let words: string[2] = ["a", "b"]
    println(shape(words))
    return 0
}