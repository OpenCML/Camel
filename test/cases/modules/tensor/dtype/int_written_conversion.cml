/**
 * The integer operand with its conversion written: `x * cast(k, "f32")` is the same multiplication
 * the promotion used to do silently, and the values are the ones the program asked for
 * (design principles 5.1).
 */

import { reshape, cast, sum } from tensor

func scaled(x: f32[3], k: int[3]): float {
    return float(sum(x * cast(k, "f32")))
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    let k = reshape([2, 3, 4] as int[], [3])
    println(scaled(x, k))
    return 0
}