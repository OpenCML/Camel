/**
 * The integer operand with its conversion written: `x * f32(k)` is the same multiplication
 * the promotion used to do silently, and the values are the ones the program asked for
 * (design principles 5.1).
 */

import { reshape, sum } from tensor

func scaled(x: f32[3], k: int[3]): float {
    return float(sum(x * f32(k)))
}

func main(): int sync {
    let x = reshape<[3]>([1.0, 2.0, 3.0] as f32[])
    let k = reshape<[3]>([2, 3, 4] as int[])
    println(scaled(x, k))
    return 0
}