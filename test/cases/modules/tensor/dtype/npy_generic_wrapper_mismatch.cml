// The element type a generic wrapper declares is the caller's all the way to the load: the
// wrapper's `T` is what `load_npy::<T>` reads the file at, so asking for f32 where the file holds
// int64 is the same fault at the same call as a direct `load_npy::<f32>`, never a conversion and
// never a silently erased element type (design principles 5.1, 5.5).
module tensor_dtype_npy_generic_wrapper_mismatch

import { load_npy } from tensor

func read_as::<T>(p: string): T[..] { return load_npy::<T>(p) }

func main(): int sync {
    let t = read_as::<f32>('test/cases/modules/nn/fixtures/checkpoint-v1/odd.npy')
    println(t)
    return 0
}