/**
 * The two writings a mask is read with, after the conversion has been written: `where(mask, x, 0.0)`
 * selects the value the mask keeps and answers zero where it does not, and `x * cast(mask, "f32")`
 * reads the mask as the number it stands for. Both compute in the tensor's element type - the
 * bytes each answer occupies say so, four an element and not eight - and both are the same numbers
 * the mask idiom always gave (design principles 5.1).
 */

import { reshape, cast, where, sum, to_bytes } from tensor
import { size } from bytes

func selected(x: f32[4], mask: bool[4]): float {
    return float(sum(where(mask, x, 0.0)))
}

func converted(x: f32[4], mask: bool[4]): float {
    return float(sum(x * cast(mask, "f32")))
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, -4.0] as f32[], [4])
    let mask = x > 0.0
    println(selected(x, mask))
    println(converted(x, mask))
    println(size(to_bytes(where(mask, x, 0.0))))
    println(size(to_bytes(x * cast(mask, "f32"))))
    return 0
}