/**
 * An integer is an element type like any other on the array side: `i64[..] * f32[..]` states two of
 * them and so matches no arm (design principles 5.1), whatever the values would fit. An integer
 * becoming a number is a conversion the program writes, and the report names it.
 */

import { reshape, sum } from tensor

func scaled(x: f32[3], k: int[3]): float {
    return float(sum((x * k)))
}

func main(): int sync {
    let x = reshape<[3]>([1.0, 2.0, 3.0] as f32[])
    let k = reshape<[3]>([2, 3, 4] as int[])
    println(scaled(x, k))
    return 0
}