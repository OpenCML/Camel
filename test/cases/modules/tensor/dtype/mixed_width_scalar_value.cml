/**
 * A scalar whose type is its own is refused beside a tensor of another element type, and a
 * conversion is such a value: `f32(2)` is an f32 whatever the context, so `x * s` with an f64 `x`
 * is the mixed call, not a literal to read at x's width. Only a *literal* takes its element type
 * from the context it is written in, which is why `x * 2.0` needs no conversion.
 */

import { reshape, sum } from tensor

func scale(x: f64[2], s: f32): float {
    return float(sum(x * s))
}

func run(x: f64[2], s: f32): float {
    return scale(x, s)
}

func main(): int sync {
    let x = reshape<[2]>([1.0, 2.0] as f64[])
    let s = f32(2)
    println(run(x, s))
    return 0
}