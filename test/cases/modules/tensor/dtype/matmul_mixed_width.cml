/**
 * A product is computed in the one element type its two arrays state, so `f64[..] @ f32[..]` is the
 * mixed pair that matches no arm (design principles 5.1), the same answer the arithmetic gives. The
 * conversion is written where the program wants the product; the shape rule is untouched by this.
 */

import { reshape, matmul, sum } from tensor

func product(x: f64[2, 2], w: f32[2, 2]): float {
    return float(sum(matmul(x, w)))
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0] as f64[], [2, 2])
    let w = reshape([1.0, 0.0, 0.0, 1.0] as f32[], [2, 2])
    println(product(x, w))
    return 0
}