/**
 * `#strict` makes the marked function use no permission at all (design principles 7.4), so it
 * revokes `change_precision` even where the function also carries the tag: the bf16 conversion is
 * refused exactly as it is without the tag.
 */
module tensor_dtype_bf16_strict_no_licence

import { Tensor, new, cast } from tensor

#[strict, change_precision]
func shrink(x: Tensor<f32>): Tensor<bf16> {
    return cast(x, 'bf16')
}

func main(): int sync {
    let values: f32[] = [0.1]
    let t = shrink(new(values))
    println('unreachable')
    return 0
}