/**
 * matmul's canonical algorithm (design principles 7.1): every element is one chain of fused
 * multiply-adds in ascending k from +0, so the product has the same bits in every GEMM unit
 * (run with and without CAMEL_TENSOR_ISA=generic) and, in safe mode, the fused forms of
 * `x @ w + b` give the bits of the unfused expression. K is beyond one cache block of the
 * blocked GEMM (256), and the shapes leave edge tiles. In default mode tensor::fuse may put the
 * product on a library GEMM (7.3); gemm_canonical.library pins the licence bound for that path.
 */

import { sum, abs, relu, linear } from tensor
import { next_key, seed, uniform } from random

func main(): int sync {
    seed(5)
    let a = (next_key()->uniform::<f32><shape: [33, 600]> * 2.0 - 1.0)
    let b = (next_key()->uniform::<f32><shape: [600, 29]> * 2.0 - 1.0)
    let bias = (next_key()->uniform::<f32><shape: [29]> * 2.0 - 1.0)
    let p = a @ b
    'gemm product_sum={}'->format<sum(p)>->println
    'gemm affine_sum={} relu_sum={}'->format<sum(a @ b + bias), sum(relu(a @ b + bias))>->println
    'gemm linear_diff={}'->format<sum(abs(linear(a, b, bias) - (p + bias)))>->println
    return 0
}
