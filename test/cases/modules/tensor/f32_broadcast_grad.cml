/**
 * The f32 reading of the broadcast gradient, pinned bit for bit beside the f64 case. Same loss
 * (`sum(x * p0)` with p0 broadcast over the rows of x, whose gradient reduction is
 * `tensor:sum_to`), the same shapes, and values that f32 cannot hold exactly: the point is that
 * the f32 arm keeps every addition at f32's width and rounds where the gradient is stored, so
 * the printed tensors are the f32 answers and not a widened f64 computation. When the f64 arm
 * of `sum_to` was added, this output did not move one bit.
 *
 *   p0 = [0.1, 0.3, 0.7], x = [[0.7, 0.2, 0.9], [0.4, 0.6, 0.1]]
 *   d/dx  = the rows of p0: [[0.1, 0.3, 0.7], [0.1, 0.3, 0.7]]
 *   d/dp0 = x column sums: [0.7 + 0.4, 0.2 + 0.6, 0.9 + 0.1] = [1.1, 0.8, 1.0]
 */
module f32_broadcast_grad

import { reshape, sum } from tensor
import { with_grad } from autodiff

type M = {
    p0: f32[3],
    x: f32[2, 3],
}

with <m: M>
func loss(): float sync {
    return float(sum(m.x * m.p0))
}

func main(): int sync {
    let m = {
        p0: reshape([0.1, 0.3, 0.7] as f32[], [3]),
        x: reshape([0.7, 0.2, 0.9, 0.4, 0.6, 0.1] as f32[], [2, 3]),
    }
    let vg = with_grad(loss)<m>()
    let g = vg.1
    println("gx {}"->format<g.x>)
    println("gp {}"->format<g.p0>)
    return 0
}