/**
 * Refined tensor types: var bindings widen at the same rank, branch joins unify, and seeded
 * random generation is reproducible.
 *
 * Two assignments of the original case need a word here, both of them readings of the terminal
 * state rather than choices of this case:
 *
 *  - `w = ones([5])` after `w` had widened to the rank-2 `f32[?, ?]` asked a `var` cell to change
 *    rank. Q5 of docs/design/arrays-memory/plan.cn.md keeps the rank when a cell widens, so that
 *    assignment is the diagnostic test/cases/compile/array_alias/err_var_rank.cml pins; the value
 *    keeps rank 2 and only its extents change. plan.cn.md:784 states this cost for this very case,
 *    and plan.cn.md:323 lists it for rewriting ("rewritten as two `var`s or an explicit `as`").
 *  - a call whose declared result is the bare `Tensor` (open rank, unstated element type) cannot
 *    enter a cell whose element type is written down: that is a narrowing assignment and is
 *    refused (`docs/handover/questions/var-cell-widening-and-the-bare-tensor-return.md`). The
 *    result therefore has a binding of its own, which is the other half of plan.cn.md:323's
 *    "two `var`s"; its value is read out below, which the original case never did.
 */
module static_types

import {
    Tensor, zeros, ones, random, seed, sum, shape
} from tensor

func grow(t: Tensor): Tensor {
    return t + 1.0
}

func pick(flag: bool): Tensor {
    return if flag then zeros([2, 2]) else ones([3, 2])
}

func main(): int sync {
    // The cell widens to f32[?, ?]: same rank, extents forgotten (Q5).
    var w = zeros([2, 1])
    w = ones([5, 1])
    // A bare `Tensor` result has a binding of its own, and is read (sum 10.0).
    var g = grow(w)
    seed(7)
    let r1 = random([4], 0.0, 1.0)
    seed(7)
    let r2 = random([4], 0.0, 1.0)
    'static_types w_sum={} pick={} same_seed={} g={}'->format<sum(w), shape(pick(false)), sum(r1) == sum(r2), sum(g)>->println
    return 0
}