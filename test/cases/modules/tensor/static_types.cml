/**
 * Refined tensor types: var bindings widen at the same rank, branch joins unify,
 * and seeded random generation is reproducible.
 *
 * The third assignment of the original case (`w = ones([5])` after `w` had widened to the rank-2
 * `f32[?, ?]`) asked a `var` cell to change rank. Q5 of docs/design/arrays-memory/plan.cn.md keeps
 * the rank when a cell widens, so that assignment is a diagnostic now
 * (test/cases/compile/array_alias/err_var_rank.cml). Following that file's rewrite list
 * (plan.cn.md:323, "rewritten as two `var`s or an explicit `as`"), the rank-1 tensor lands in a
 * binding of its own and the rank-2 cell still widens in place.
 */
module static_types

import {
    Tensor, zeros, ones, random, seed, sum, shape
} from tensor

func grow(t: Tensor): Tensor {
    return t + 1.0
}

func pick(flag: bool): Tensor {
    return if flag then zeros([2, 2]) else ones([3, 2])
}

func main(): int sync {
    var w = zeros([2, 1])
    // The cell widens to f32[?, ?]: same rank, extents forgotten (Q5).
    w = grow(w)
    // A rank-1 binding of its own, not a rank change of `w` (plan.cn.md:323).
    var v = ones([5])
    seed(7)
    let r1 = random([4], 0.0, 1.0)
    seed(7)
    let r2 = random([4], 0.0, 1.0)
    'static_types w_sum={} pick={} same_seed={}'->format<sum(v), shape(pick(false)), sum(r1) == sum(r2)>->println
    return 0
}
