/**
 * Refined tensor types: a `var` binding widens at the same rank, branch joins unify, and seeded
 * random generation is reproducible.
 *
 * The shapes this case pins, with the element type written down in every signature (a signature
 * that leaves it out is a type in transition, and its values cannot enter a cell whose element type
 * is known):
 *
 *  - a call whose result declares `f32[?, ?]` enters the cell `w`: the cell's element type is `f32`
 *    and so is the value's, and the extents are what widen, at the same rank;
 *  - the cell keeps its rank, so a value of another rank gets a binding of its own: `g` holds
 *    `ones([5])`, and this case reads it.
 */

import {
    zeros, ones, random, seed, sum, shape
} from tensor

func grow(t: f32[?, ?]): f32[?, ?] {
    return t + 1.0
}

func pick(flag: bool): f32[?, ?] {
    return if flag then zeros([2, 2]) else ones([3, 2])
}

func main(): int sync {
    var w = zeros([2, 1])
    w = grow(w)
    var g = ones([5])
    seed(7)
    let r1 = random([4], 0.0, 1.0)
    seed(7)
    let r2 = random([4], 0.0, 1.0)
    'static_types w_sum={} pick={} same_seed={} g={}'->format<sum(w), shape(pick(false)), sum(r1) == sum(r2), sum(g)>->println
    return 0
}