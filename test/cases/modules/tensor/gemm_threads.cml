/**
 * The thread count a matrix multiplication actually used: one pool, one thread for the library.
 *
 * `-t` names one number of threads for the run (or the hardware concurrency without it), and the
 * tensor pool spends it. The library's own pool is one thread (H303): a whole-work product is one
 * library call on one thread, and a product inside a batch region takes one thread per call
 * because the batch loop already spreads the budget over the pool. So `gemm_threads()` reports 1
 * for the library in both cases, and `num_threads()` keeps reporting the run's number. On a build
 * without a CBLAS the library path forwards to the canonical kernel, which is what splits over the
 * pool: `plain` is then the run's number, and the program asks `gemm_library()` which build it is.
 *
 * The batched product is four 1024x1024 matrices: each call is at the 2^30 shape threshold, so a
 * CBLAS build would run the library four times over — once per chunk — if each call also took the
 * whole budget. Without a library both products run the canonical kernel, which splits over the
 * same pool and runs serially inside a region.
 *
 * Exit 1 is a pool that does not report the run's number, 2 a product whose library call did not
 * get one thread, 3 a batched product whose calls took more than one thread.
 */
module gemm_threads

import { Tensor, gemm_library, gemm_threads, num_threads, sum, zeros } from tensor
import { cpu_count } from process

func main(expected: int): int sync {
    let want = if expected > 0 then expected else cpu_count()
    // The library path exists only with a CBLAS: without one, `sgemmLibrary` is `sgemm`.
    let library = gemm_library() == "cblas"
    let plain_want = if library then 1 else want

    // One product that is the whole work: one library call on one thread.
    let a = zeros([1024, 1024]) + 0.001
    let b = zeros([1024, 1024]) + 0.001
    let plain = sum(a @ b)
    let plain_threads = gemm_threads()

    // Four large products: the batch loop spends the budget, one thread per call.
    let batch_a = zeros([4, 1024, 1024]) + 0.001
    let batch_b = zeros([4, 1024, 1024]) + 0.001
    let batched = sum(batch_a @ batch_b)
    let batch_threads = gemm_threads()

    'gemm_threads pool={} plain={} batched={} expected={} library={}'->format<
        num_threads(), plain_threads, batch_threads, want, gemm_library()>->println
    return if num_threads() != want then 1 else if plain_threads != plain_want then 2 else if batch_threads != 1 then 3 else 0
}