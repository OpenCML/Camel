/**
 * A subscript slice of a tensor whose first extent is stated and whose step is not the constant 1
 * is a view with strides, which needs the multidimensional array representation of H17: the step
 * is refused where it is written, the zero step included (design principles 5.4). Both `[]` forms
 * are answered by the core alone, so nothing falls back to the module that owns tensors.
 */
module subscript_slice_step_zero
import { Tensor, reshape, shape } from tensor

func main(): int sync {
    let b = reshape([1.0, 2.0, 3.0, 4.0], [4])
    println(shape(b[0:4:0]))
    println('not reached')
    return 0
}