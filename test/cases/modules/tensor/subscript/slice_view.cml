/**
 * Slices of a subscript on a tensor (design principles 5.4): `t[a:b]`, `t[:b]`, `t[a:]`, `t[:]`
 * along the first axis, a view sharing the block of a tensor of rank 1. An end equal to the
 * extent is in range, an end before the start is the empty slice.
 */
import { reshape, shape, sum } from tensor

func main(): int sync {
    let b = reshape<[4]>([1.0, 2.0, 3.0, 4.0])
    println(shape(b[1:3]))
    println(sum(b[1:3]))
    println(shape(b[:2]))
    println(shape(b[2:]))
    println(shape(b[:]))
    println(shape(b[0:4]))
    println(shape(b[3:1]))
    return 0
}