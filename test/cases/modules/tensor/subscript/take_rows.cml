/**
 * `t[idx]` on a tensor is `take` (design principles 5.4): the rows the indices name, in that
 * order, with a repeated index repeating its row.
 */
module subscript_take_rows
import { Tensor, reshape, shape, sum } from tensor

func main(): int sync {
    let b = reshape([1.0, 2.0, 3.0, 4.0], [4])
    let idx = [3, 0, 3]
    let rows = b[idx]
    println(shape(rows))
    println(sum(rows))
    return 0
}