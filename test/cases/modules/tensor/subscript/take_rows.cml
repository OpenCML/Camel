/**
 * `t[idx]` on a tensor is `take` (design principles 5.4): the rows the indices name, in that
 * order, with a repeated index repeating its row.
 */
import { reshape, shape, sum } from tensor

func main(): int sync {
    let b = reshape<[4]>([1.0, 2.0, 3.0, 4.0])
    let idx = [3, 0, 3]
    let rows = b[idx]
    println(shape(rows))
    println(sum(rows))
    return 0
}