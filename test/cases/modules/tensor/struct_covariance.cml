/**
 * Aggregates of precisely typed tensors are accepted where the declared type
 * uses an open-rank array (`f64[..]`): struct fields, tuple elements, and array elements are
 * checked covariantly (they are immutable).
 */

import { reshape, sum } from tensor

type Layer = { w: f64[..], b: f64[..] }

with <l: Layer>
func apply(x: f64[..]): f64[..] {
    return x @ l.w + l.b
}

func total(ts: f64[..][]): float {
    return float(sum(ts[0])) + float(sum(ts[1]))
}

func first(pair: (f64[..], f64[..])): f64[..] {
    return pair.0
}

func main(): int sync {
    let l = { w: reshape<[2, 2]>([1.0, 0.0, 0.0, 1.0]), b: reshape<[2]>([1.0, 1.0]) }
    let x = reshape<[1, 2]>([1.0, 2.0])
    let y = apply<l>(x)
    'covariance struct={} array={} tuple={}'->format<sum(y), total([x, y]), sum(first((y, x)))>->println
    return 0
}
