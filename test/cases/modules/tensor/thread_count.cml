/**
 * The tensor pool reports the thread count of the run: the command line's `-t`, or without it
 * the hardware concurrency. The program checks the reported number itself and exits 1 when it
 * is not the expected one, so the exit code is the assertion and the printed line says what the
 * pool reported. `expected` is the number `-t` gave; 0 means "the run gave none".
 */

import { num_threads } from tensor
import { cpu_count } from process

func main(expected: int): int sync {
    let actual = num_threads()
    let want = if expected > 0 then expected else cpu_count()
    'threads={} expected={}'->format<actual, want>->println
    if actual != want then {
        return 1
    }
    return 0
}