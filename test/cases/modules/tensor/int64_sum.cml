// The sum of an int64 tensor accumulates exactly in int64 and wraps on overflow, as integer
// arithmetic does (design principles 5.1, 7.7); the full sum and the mean convert the exact
// sum to float once. Summed in f64, 2^53 + 1 + 1 would lose both ones.
import { reshape, sum, mean } from tensor

func main(): int sync {
    let big = reshape<[3]>([9007199254740993, 1, 1])
    let wrap = reshape<[2, 2]>([9223372036854775807, 1, 5, -5])
    println(sum(big))
    println(mean(big))
    println(sum<0>(big))
    println(sum<0>(wrap))
    println(sum(wrap))
    println(mean<0>(wrap))
    return 0
}
