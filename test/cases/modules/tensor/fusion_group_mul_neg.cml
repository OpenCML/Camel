/**
 * The `tensor.fusion = "vjp_mul_neg"` group (a division's VJP when the numerator is a parameter).
 *
 * `shared_chain` differentiates both operands: the divide's result is the numerator's gradient
 * and the gradient struct reads it, so the three-node `divide -> multiply -> neg` chain is not
 * private at its head and the bigger group declines. The multiply and the neg are still private,
 * so the VJP marks those two `vjp_mul_neg` and the node VM runs them as one pass at the neg, off
 * the divide's already-stored value.
 *
 * The pair keeps the two operators' bits (one multiply rounding, one sign flip), so the bytes of
 * the default chain and of the `#strict` chain are equal, and equal to the bytes `std::fvm`
 * prints when it runs the nodes one by one (it has no kernel for the group).
 */
module fusion_group_mul_neg

import { Tensor, reshape, sum, to_bytes } from tensor
import { with_grad } from autodiff
import { to_array } from bytes

type AB = { a: f32[..], w: f32[..] }

with <m: AB>
func shared_chain(): float {
    return sum(m.a / m.w)
}

with <m: AB>
func strict_shared_chain(): float {
    #strict {
        return sum(m.a / m.w)
    }
}

func main(): int sync {
    let a = reshape([1.5, -2.25, 3.0, 0.1, -7.0, 1e-8] as f32[], [2, 3])
    let w = reshape([3.0, 7.0, 0.1, -3.0, 1e-8, 1234567.0] as f32[], [2, 3])

    let h = with_grad(shared_chain)
    let (value, gradient) = h<{a: a, w: w}>()
    'shared value={} sum_w={} sum_a={}'
    ->format<value, sum(gradient.w), sum(gradient.a)>->println
    println(to_array(to_bytes(gradient.w)))

    let s = with_grad(strict_shared_chain)
    let (tight, tight_gradient) = s<{a: a, w: w}>()
    'strict value={} sum_w={} sum_a={}'
    ->format<tight, sum(tight_gradient.w), sum(tight_gradient.a)>->println
    println(to_array(to_bytes(tight_gradient.w)))
    return 0
}