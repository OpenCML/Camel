/**
 * Batched matmul with broadcasting, linear, layer_norm, permute, slice, flatten, unsqueeze.
 */

import { reshape, range, ones, zeros, matmul, linear, layer_norm, permute, slice, unsqueeze, transpose, shape, sum, dim } from tensor

func main(): int sync {
    let a = reshape<[2, 3, 4]>(f32(0..24))
    let b = ones::<f32>([4, 5])
    let c = a @ b
    let w = ones::<f32>([4, 2])
    let bias = f32(reshape<[2]>([0.5, -0.5]))
    let y = linear(a, w, bias)
    'linalg matmul_shape={} matmul_sum={} linear_shape={} linear_sum={}'->format<shape(c), sum(c), shape(y), sum(y)>->println
    let v = matmul(ones::<f32>([3, 4]), f32(reshape<[4]>([1.0, 2.0, 3.0, 4.0])))
    'linalg matvec_shape={} matvec_sum={}'->format<shape(v), sum(v)>->println
    let n = layer_norm(a, ones::<f32>([4]), zeros::<f32>([4]))
    'linalg layernorm_sum={}'->format<sum(n)>->println
    let p = permute<[2, 0, 1]>(a)
    let s = slice(a, 2, 1, 4, 2)
    let f = reshape<[dim<0>(a), -1]>(a)
    let u = unsqueeze<0>(transpose(a))
    'layout permute={} slice={} slice_sum={} flatten={} unsqueeze={}'->format<shape(p), shape(s), sum(s), shape(f), shape(u)>->println
    return 0
}
