import { ones, sum } from tensor
// Dimensions are linear forms: `n`, `n + 1`, `2 * n`, and `n + m` over two names. The names
// bind in any parameter, and every occurrence is held to the same value.
func affine(
    a: f32[n],
    b: f32[n + 1],
    c: f32[2 * n],
    d: f32[n + m],
    e: f32[m]
): float {
    return float(sum(a)) + float(sum(b)) + float(sum(c)) + float(sum(d)) + float(sum(e))
}
func main(): int sync {
    // n = 2, m = 3: n + 1 = 3, 2 * n = 4, n + m = 5.
    println(affine(ones::<f32>([2]), ones::<f32>([3]), ones::<f32>([4]), ones::<f32>([5]), ones::<f32>([3])))
    // Another call, other extents: one function, no new instance.
    println(affine(ones::<f32>([4]), ones::<f32>([5]), ones::<f32>([8]), ones::<f32>([7]), ones::<f32>([3])))
    return 0
}