module named_dims_with_param
import { ones, sum } from tensor
// A `with` parameter binds a name like a normal one, and the normal parameters write it.
with <w: f32[n]>
func scale(x: f32[n]): float {
    return float(sum(x)) + float(sum(w))
}
func main(): int sync {
    println(scale<ones([3])>(ones([3])))
    return 0
}