import { ones, sum } from tensor
// A product of two named dimensions is not linear: its value is unknown, so the third
// argument is accepted whatever its extent is (design principles 5.4).
func scaled(
    a: f32[n],
    b: f32[m],
    c: f32[n * m]
): float {
    return float(sum(a)) + float(sum(b)) + float(sum(c))
}
func main(): int sync {
    println(scaled(ones::<f32>([2]), ones::<f32>([3]), ones::<f32>([99])))
    return 0
}