import { ones, sum } from tensor
// `constas n` binds the extent where it first appears in a parameter type; the second
// parameter writes `n` and must have that same extent.
func weighted(x: f32[n], w: f32[n]): float {
    return float(sum(x)) + float(sum(w))
}
func main(): int sync {
    println(weighted(ones::<f32>([3]), ones::<f32>([3])))
    println(weighted(ones::<f32>([5]), ones::<f32>([5])))
    return 0
}