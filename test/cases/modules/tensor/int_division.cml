/**
 * Integer arrays divide as integers do: `int / int` is an `int`, truncated towards zero, and an
 * array quotient is the scalar rule element by element (design principles 5.1: one semantics for
 * scalars and arrays). Float arrays keep their quotient.
 */

import tensor

func main(): int sync {
    let a = [7, 8, -9] as int[]
    let b = [2, 3, 2] as int[]
    println(a / b)
    println(a / 2)
    println(20 / b)
    println([-9223372036854775807 - 1] / [-1] as int[])
    println([1.0, 2.0] as float[] / [2.0, 4.0] as float[])
    println(f32(7) / f32(2))
    println([7, 8, -9] as int[] % [2, 3, 2] as int[])
    return 0
}
