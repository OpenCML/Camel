module bounds_slice_untaken_branch
import { Tensor, reshape, slice, sum, shape, load_npy } from tensor
func f(b: Tensor<const [3]>, k: int): float {
    return if k > 100 then sum(slice(b, 0, 8, 9)) else b[0]
}
func main(): int sync {
    println('ran')
    println(f(reshape([1.0, 2.0, 3.0], [3]), 1))
    return 0
}
