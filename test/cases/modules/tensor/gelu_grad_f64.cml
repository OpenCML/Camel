/**
 * `gelu`'s gradient on an `f64[..]` input, element by element, beside the value it is the
 * derivative of.
 *
 * `gelu` here is the engine's tanh approximation, not the erf form: at x = 1 the forward is
 * 0.8411919906082768, where the erf form answers 0.8413447460685429. The gradient is therefore the
 * derivative of *that* value -- 0.5 (1 + t) + 0.5 v (1 - t^2) scale (1 + 3 cubic v^2), with
 * u = scale (v + cubic v^3) and t = tanh(u) -- and the three numbers below are the ones a central
 * difference of the printed forward agrees with, (f(x + h) - f(x - h)) / 2h at h = 1e-3:
 * [-0.08296396, 0.5, 1.08296396], within 1.3e-7 of them.
 *
 * What this case read before the operator was fixed: the kernel wrote its answer at f32 whatever
 * its input's element type was, while the operator's declared result is the arguments' own element
 * type (gradient_ops.cpp, `gradientLikeTyped`). On an `f64[..]` input the value was a 12-byte f32
 * array behind an `f64[..]` type, so each element read back was an f32 answer's bits in the low
 * half of a double: [0.0, 1.5769529523e-314, 0.0] at x = [-1.0, 0.0, 1.0] -- zero where the answer
 * was zero and a 1e-314-scale denormal where it was not, and the middle reading moved when the
 * input moved ([-1.0, 0.0, 1.0] gave 1.5769529523e-314 and [1.0, 0.0, -1.0] gave 5.30626085e-315).
 * Nothing refused it and nothing was uninitialized: the storage was too narrow for the number of
 * elements the type promised.
 *
 * The f32 line is the arm that was right all along, and it is the same gradient at f32's width: it
 * must keep these numbers (the f32 kernel's bits are pinned shape by shape in gelu_grad_bits.cml).
 */

import { gelu, sum } from tensor
import { grad } from autodiff

with <x: f64[..]>
func loss64(): float { return float(sum(gelu(x))) }

with <x: f32[..]>
func loss32(): float { return float(sum(gelu(x))) }

func main(): int sync {
    let x = [-1.0, 0.0, 1.0] as f64[]
    println('gelu_grad_f64 forward={}'->format<gelu(x)>)
    println('gelu_grad_f64 grad={}'->format<grad(loss64)<x>()>)
    let y = [-1.0, 0.0, 1.0] as f32[]
    println('gelu_grad_f32 grad={}'->format<grad(loss32)<y>()>)
    return 0
}