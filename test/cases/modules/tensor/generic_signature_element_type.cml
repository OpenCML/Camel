/// The array spelling of a tensor signature's parameter is an explicit type variable of the head
/// (design principles 4.1 and 5.5): `shape`, `numel`, `dim` and `to_bytes` take a native array of
/// any rank and any numeric element type, the call site's argument type fixes the element type,
/// and a function whose parameter is written `T[..]` sees that element type in its body (`t[0]`
/// is `T`, never a fixed `float`). The module `Tensor` spelling stands beside it, so the programs
/// that pass what the tensor operators return are unchanged.
///
/// The rank the argument carries is the rank the body sees: a `f32[3]` and a `f32[..]` bound to the
/// same open-rank parameter each read their own extent, and nothing here is specialised to one
/// rank. (A rank-2 native array has no producer yet — the module `Tensor` a tensor operator returns
/// is not the array alias until P4, and a nested literal is refused — so this case stays at the
/// ranks a program can make today.)
module tensor_generic_signature_element_type

import { Tensor, ones, shape, numel, dim, to_bytes } from tensor
import { is_numeric } from types
import { size } from bytes

/// The element type of the parameter, taken from the call site: `t[0]` is a `T`, so this compiles
/// for `f32` and for `int`, and the result is a value of that element type.
func firstElement::<T>(t: T[..]): T when is_numeric::<T>() {
    return t[0]
}

/// The rank of the argument decides what `len` reads, and nothing here is fixed to one rank.
func firstDim::<T>(t: T[..]): int when is_numeric::<T>() {
    return len(t)
}

func main(): int sync {
    let a: f32[3] = [1.0, 2.0, 3.0]
    let open: f32[..] = a
    let ints: int[3] = [10, 20, 30]

    // The extents, from a shaped array, from an open-rank array and from an int array.
    println(shape(a))
    println(shape(open))
    println(shape(ints))

    // The other operators of the same signature source.
    println(numel(a))
    println(dim(a, 0))
    println(size(to_bytes(a)))

    // The declaration's own parameter: `t[0]` is the element type the call bound.
    let first: f32 = firstElement(a)
    println(first)
    let firstInt: int = firstElement(ints)
    println(firstInt)
    println(firstDim(ints))

    // The tensor spelling still fills the same names, so no existing program changed.
    let t: Tensor = ones([2, 3])
    println(shape(t))
    return 0
}