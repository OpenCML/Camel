// argmax and argmin compare by IEEE 754-2019 maximum and minimum (design principles 7.7): with a
// NaN the position of the first NaN; on a tie the position of the first extreme, +0 above -0.
import { reshape, argmax, argmin } from tensor

func main(): int sync {
    let tie = reshape<[5]>([1.0, 3.0, 3.0, -2.0, -2.0])
    let z = reshape<[4]>([1.0, 0.0, 1.0, 0.0])
    let nan = reshape<[4]>([1.0, 5.0, 1.0, -9.0]) * (z / z + 1.0)
    let zeros = reshape<[4]>([-0.0, 0.0, -0.0, 0.0])
    let zeros2 = reshape<[3]>([0.0, -0.0, 0.0])
    let ints = reshape<[5]>([3, 7, 7, 1, 1])
    let rows = reshape<[2, 3]>([2.0, -0.0, 0.0, 2.0, 0.0, -0.0])
    println(argmax<0>(tie)); println(argmin<0>(tie))
    println(argmax<0>(nan)); println(argmin<0>(nan))
    println(argmax<0>(zeros)); println(argmin<0>(zeros))
    println(argmax<0>(zeros2)); println(argmin<0>(zeros2))
    println(argmax<0>(ints)); println(argmin<0>(ints))
    println(argmax<1>(rows)); println(argmin<1>(rows)); println(argmin<0, true>(rows))
    return 0
}
