/**
 * A row index that is only known at run time is a located IndexOutOfRange (design principles 3.9,
 * 5.4): no wrap-around for a negative index.
 */

import { reshape, range, cast, take } from tensor

func pick(t: i64[..], i: int): i64[..] {
    return take(t, cast([i], 'int64'))
}

func main(): int sync {
    let t = reshape(0..12, [4, 3])
    let ok = pick(t, 1)
    'take runtime ok={}'->format<ok>->println
    let bad = pick(t, -1)
    return 0
}