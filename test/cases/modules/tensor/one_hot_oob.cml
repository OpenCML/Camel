/**
 * A class label outside [0, classes) is a located IndexOutOfRange at the call (design principles
 * 3.9, 5.4): a negative label does not wrap around to the last class.
 */

import { one_hot } from tensor

func main(): int sync {
    let labels = int([0, 3])
    let bad = one_hot(labels, 3)
    return 0
}