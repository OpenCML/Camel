module binary_roundtrip
import { Tensor, new, from_bytes, to_bytes, sum, zeros } from tensor
import { from_array, to_array, size } from bytes
func decode_return(b: Bytes): Tensor<f32> { return from_bytes(b, [4]) }
func measure(t: Tensor<f32>): float { return sum(t) }
func main(): int sync {
    let source = new([1.0, -2.5, 0.0, -0.0] as f32[])
    let b = to_bytes(source)
    println(to_array(to_bytes(from_bytes::<f32>(b, [2, 2]))))
    let inferred: Tensor<f32> = from_bytes(b, [4])
    println(to_array(to_bytes(inferred)))
    println(to_array(to_bytes(decode_return(b))))
    println(measure(from_bytes(b, [4])))
    let ints = to_bytes(new([9007199254740993, -2]))
    println(to_array(to_bytes(from_bytes::<int>(ints, [2]))))
    println(to_array(to_bytes(from_bytes::<bool>(from_array([1, 0, 1]), [3]))))
    println(size(to_bytes(from_bytes::<f32>(to_bytes(zeros([0])), [2, 0]))))
    println(to_array(to_bytes(from_bytes::<f32>(from_array([1, 0, 128, 127, 1, 0, 192, 127, 0, 0, 128, 127, 1, 0, 0, 0]), [4]))))
    println(to_array(to_bytes(from_bytes::<f32>(from_array([0, 0, 128, 63]), range(0, 0)))))
    let decoder: (b: Bytes, shape: int[]) => Tensor<f32> = from_bytes::<f32>
    println(to_array(to_bytes(decoder(b, [4]))))
    return 0
}
