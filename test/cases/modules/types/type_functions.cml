/// The type functions of `types`, called where a type is written: `ElementOf`, `PayloadOf`, `KeyOf`
/// and `ValueOf` compute a type from a type when the instance is made, and the predicates of
/// `types` are asked of the computed type.
import { is_integer, is_float, is_string, is_array, ElementOf, PayloadOf, KeyOf, ValueOf } from types

func element_is_integer::<T>(): bool {
    return is_integer::<ElementOf<T>>()
}

func payload_is_float::<T>(): bool {
    return is_float::<PayloadOf<T>>()
}

func map_key_is_string::<T>(): bool {
    return is_string::<KeyOf<T>>()
}

func map_value_is_array::<T>(): bool {
    return is_array::<ValueOf<T>>()
}

// A call inside a call: the element of the element.
func inner_is_integer::<T>(): bool {
    return is_integer::<ElementOf<ElementOf<T>>>()
}

// A call as the type of a value: the first element of an array, typed by its own element type.
func first_or::<T>(xs: T, fallback: ElementOf<T>): ElementOf<T> {
    return if len(xs) > 0 then xs[0] else fallback
}

func main(): int sync {
    println(element_is_integer::<int[]>(), element_is_integer::<f32[]>(), element_is_integer::<Set<i32>>())
    println(payload_is_float::<float?>(), payload_is_float::<int!>(), payload_is_float::<f32?>())
    println(map_key_is_string::<Map<string, int>>(), map_key_is_string::<Map<int, int>>())
    println(map_value_is_array::<Map<string, int[]>>(), map_value_is_array::<Map<string, int>>())
    println(inner_is_integer::<int[][]>(), inner_is_integer::<f32[][]>())
    println(first_or([4, 5], 0), first_or(['a'], 'z'))
    return 0
}
