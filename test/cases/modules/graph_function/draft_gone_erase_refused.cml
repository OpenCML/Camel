// A node a draft answered stops naming a graph the moment the draft is over: `commit` ends the
// session, and an edit that still names one of its nodes has no draft to be applied to. The operator
// refuses with that state -- `the draft was committed or aborted already` -- instead of reading the
// graph the commit freed. The same state read through a handle rather than refused was a crash
// (`GraphDraft::alive` on a draft that was gone), which is why the refusal is pinned and not the
// absence of one. The node is read before the commit on purpose: the question is about the state the
// handle names, not about the node.

import { Node, Graph, graphs, nodes, open, commit, erase } from graph

func subject(x: int) => int {
    return x + 1
}

func main() sync {
    let d = open(subject)
    let g = graphs(d)[0]
    let n = nodes(g)[0]
    let f = commit(d) !! subject
    erase(n)
    println(f(1))
}