import { flat_map } from array
import { any } from array
import { starts_with } from str
import {
    Program, Graph, Node, Txn, graphs, nodes, inputs, constant,
    add_constant, open, commit, replace, op, op_name
} from graph

func allNodes(p: Program): Node[] {
    return graphs(p)->flat_map<(g: Graph): Node[] => nodes(g)>
}

func valueAt(n: Node): int {
    return constant(n, 0) ?? -1
}

func hasInt(n: Node): bool {
    return constant(n, 0) != null
}

func isIntAdd(n: Node): bool {
    return match op(n) {
        case null => false
        case o => op_name(o)->starts_with<':op/add'>
    }
}

/// Folds `a + b` of two int constants: makes the sum a static value of the graph (the new value
/// a transaction may create) and replaces the add by it.
func foldAdd(t: Txn, g: Graph, n: Node): bool sync {
    let ins = inputs(n)
    return if isIntAdd(n) && hasInt(ins[0]) && hasInt(ins[1]) then sync {
        let c = add_constant(t, g, valueAt(ins[0]) + valueAt(ins[1]))
        replace(t, n, c)
        true
    } else false
}

func churn(rounds: int): string {
    let (i, acc) = loop i = 0, acc = '' while i < rounds do (i + 1, acc + 'h36-churn-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx')
    return acc
}

func isGolden(n: Node): bool {
    return match constant(n, '') {
        case null => false
        case s => s == 'h36-golden'
    }
}

export func fold(p: Program): Program! sync {
    let t = open(p)
    graphs(p)->foreach<(g: Graph) => nodes(g)->foreach<(n: Node) => foldAdd(t, g, n)>>
    let g0 = graphs(p)[0]
    let golden = add_constant(t, g0, 'h36-golden')
    let junk = churn(200)
    let next = commit(t) !! p
    let left = len(allNodes(next)->filter<isIntAdd>)
    let ok = allNodes(next)->any<isGolden>
    if ok && left == 0 then { return next } else { throw error('FoldBroken', 'a constant did not survive the transaction') }
}
