import { Node, Graph, name, nodes, graphs, graphs_of, inputs, op, op_name, constant, type_of, type_name, open, replace, erase, commit, abort } from graph

func opText(n: Node) => string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func typeText(n: Node) => string {
    return match type_of(n) {
        case null => ''
        case t => type_name(t)
    }
}

func isZero(n: Node) => bool {
    return match constant::<int>(n) {
        case null => false
        case v => v == 0
    }
}

func isAddZero(n: Node) => bool spelling {
    let ins = inputs(n)
    return opText(n) == ':op/add_l' && len(ins) == 2 && isZero(ins[1])
}

func isAdd(n: Node) => bool spelling {
    return opText(n) == ':op/add_l'
}

func isString(n: Node) => bool spelling {
    return typeText(n) == 'string'
}

func mainNodes(d: Graph) => Node[] spelling {
    let found = graphs(d)->filter<func (g: Graph) => bool {
        name(g) == 'main'
    }>
    return nodes(found[0])
}

/// Replaces `x + 0` by `x`.
export func fold_zero_adds::<F>(p: F) => F! spelling sync {
    let d = open(p)
    let hits = mainNodes(d)->filter<isAddZero>
    hits->foreach<func (n: Node) {
        replace(n, inputs(n)[0])
    }>
    return commit(d)
}

export func count_adds::<F>(p: F) => F! spelling sync {
    let found = graphs_of(p)->filter<func (g: Graph) => bool {
        name(g) == 'main'
    }>
    println(len(nodes(found[0])->filter<isAdd>))
    return p
}

export func commit_twice::<F>(p: F) => F! sync {
    let d = open(p)
    let first = commit::<F>(d)
    let second = commit::<F>(d)
    println(match second {
        case error e => e.kind
        case v => 'ok'
    })
    return first
}

/// A string where an integer is read: the commit refuses.
export func break_types::<F>(p: F) => F! spelling sync {
    let d = open(p)
    let adds = mainNodes(d)->filter<isAddZero>
    let texts = mainNodes(d)->filter<isString>
    replace(adds[0], texts[0])
    return commit(d)
}

/// The value of the node is still read.
export func erase_read::<F>(p: F) => F! spelling sync {
    let d = open(p)
    let adds = mainNodes(d)->filter<isAddZero>
    erase(adds[0])
    return commit(d)
}

export func abort_unused::<F>(p: F) => F! sync {
    let d = open(p)
    abort(d)
    return p
}

/// Two transactions edit the same graph of one Program: each commit is a value of its own, so
/// both succeed (design principles 9.1), and the pass hands on the first.
export func conflict::<F>(p: F) => F! spelling sync {
    let first = open(p)
    let second = open(p)
    let firstAdds = mainNodes(first)->filter<isAddZero>
    let secondAdds = mainNodes(second)->filter<isAddZero>
    replace(firstAdds[0], inputs(firstAdds[0])[0])
    replace(secondAdds[0], inputs(secondAdds[0])[0])
    let kept = commit::<F>(first)
    println(match commit::<F>(second) {
        case error e => e.kind
        case v => 'ok'
    })
    return kept
}


