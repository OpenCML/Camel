module params
import { Program } from graph

func twice(x: int): int {
    return x * 2
}

/// The `with` parameters of the function are the pass's parameters: `params::report(n=21, ...)`.
/// `n` is read at a call site (`twice(n)`), captured by a lambda and printed with the others.
with <label: string, n: int, scale: f64, small: f32, flag: bool>
export func report(p: Program): Program! sync {
    println(label)
    println(n)
    println(twice(n))
    println([1, 2, 3]->map<(x: int): int => x * n>)
    println(scale)
    println(small)
    println(flag)
    return p
}
