// Creates a value of each type `add_constant` accepts (int, f64, bool, string), lets the draft live
// across a safepoint (`churn` makes the collector run), commits, and counts each value in the
// committed program. The draft's static slots are the roots that keep these values alive while the
// draft is open (item 3).
import { flat_map } from array
import { Graph, Node, nodes, constant, add_constant, open, commit, graphs, graphs_of } from graph

func allNodes::<F>(p: F) => Node[] {
    return graphs_of(p)->flat_map<func (g: Graph) => Node[] {
        nodes(g)
    }>
}

func churn(rounds: int) => string {
    let (i, acc) = loop i = 0, acc = '' while i < rounds do (i + 1, acc + 'h36b-churn-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx')
    return acc
}

func countInt(ns: Node[], v: int) => int {
    return ns->filter<func (n: Node) => bool {
        (constant::<int>(n) ?? -1) == v
    }>->len()
}

func countFloat(ns: Node[], v: f64) => int {
    return ns->filter<func (n: Node) => bool {
        (constant::<float>(n) ?? -1.0) == v
    }>->len()
}

func countBool(ns: Node[], v: bool) => int {
    return ns->filter<func (n: Node) => bool {
        (constant::<bool>(n) ?? false) == v
    }>->len()
}

func countString(ns: Node[], v: string) => int {
    return ns->filter<func (n: Node) => bool {
        (constant::<string>(n) ?? '') == v
    }>->len()
}

export func make::<F>(p: F) => F! sync {
    let d = open(p)
    let g = graphs(d)[0]
    let i = add_constant(g, 12345)
    let f = add_constant(g, 2.5)
    let b = add_constant(g, true)
    let s = add_constant(g, 'h36b-typed')
    let junk = churn(100)
    let next = commit::<F>(d) !! p
    let ns = allNodes(next)
    println(countInt(ns, 12345))
    println(countFloat(ns, 2.5))
    println(countBool(ns, true))
    println(countString(ns, 'h36b-typed'))
    return next
}
