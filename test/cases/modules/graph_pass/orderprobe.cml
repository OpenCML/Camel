// The probes `order` and `exit` are read by. A probe is a pass written in Camel: it reads the
// graph `main` of the program it is given and, for `order`, hands back the program the commit made.

import { Node, Graph, NodeKind, name, nodes, graphs, graphs_of, graph_of, inputs, kind, op, op_name, value_users, type_of, type_name, is_anchor, exit, order_inputs, open, order, params, commit } from graph

func opText(n: Node) => string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func typeText(n: Node) => string {
    return match type_of(n) {
        case null => ''
        case t => type_name(t)
    }
}

func isAdd(n: Node) => bool {
    return opText(n) == ':op/add_l'
}

func isPrint(n: Node) => bool {
    return opText(n) == ':io/println'
}

func isGate(n: Node) => bool {
    return kind(n) == NodeKind::Gate
}

/// An addition whose ordinary inputs are no addition: `a = seed() + 20`. Its value depends on no
/// other addition, so it is the node the cycle case orders *against*.
func isInnerAdd(n: Node) => bool {
    let ins = inputs(n)
    let adds = ins->filter<isAdd>
    return isAdd(n) && len(adds) == 0
}

/// An addition that reads another addition: `c = a + 1`. Ordering it before the addition it reads
/// is the cycle `order` refuses.
func readsAnAdd(n: Node) => bool {
    let ins = inputs(n)
    let adds = ins->filter<isAdd>
    return len(adds) > 0
}

func firstIsPrint(pres: Node[]) => bool {
    return if len(pres) == 1 then isPrint(pres[0]) else false
}

func mainGraph(d: Graph) => Graph spelling {
    let found = graphs(d)->filter<func (g: Graph) => bool {
        name(g) == 'main'
    }>
    return found[0]
}

func printOf(g: Graph) => Node {
    let prints = nodes(g)->filter<isPrint>
    return prints[1]
}

func gateOf(g: Graph) => Node {
    let gates = nodes(g)->filter<isGate>
    return gates[0]
}

func outerAddOf(g: Graph) => Node {
    let outers = nodes(g)->filter<readsAnAdd>
    return outers[0]
}

/// The shape of the node the graph hands its value out of, as one line: its kind, the type of the
/// value, whether it is an anchor, how many nodes read it, how many ordinary inputs it has, and how
/// many of those are additions.
func exitText(n: Node) => string {
    let ins = inputs(n)
    let reads = value_users(n)
    let adds = ins->filter<isAdd>
    return `${kind(n)} ${typeText(n)} ${is_anchor(n)} ${len(reads)} ${len(ins)} ${len(adds)}`
}

/// What `exit` answers on a pure body: the addition the function returns -- the one that reads
/// another addition, which is the node an independent search for that shape finds.
export func exit_shape::<F>(p: F) => F! spelling sync {
    let g = mainGraph(graph_of(p))
    println(match exit(g) {
        case null => 'no exit'
        case n => exitText(n)
    })
    println(match exit(g) {
        case null => false
        case n => n == outerAddOf(g)
    })
    return p
}

/// The parameter ports of a graph: `params` answers the nodes a function takes its arguments as, in
/// the order the declaration states them -- and they are nodes like any other, so `nodes` lists
/// them and `add_param` adds one beside them.
export func params_of::<F>(p: F) => F! spelling sync {
    let found = graphs_of(p)->filter<func (g: Graph) => bool {
        name(g) == 'inc'
    }>
    let g = found[0]
    let ports = params(g)
    println(`ports: ${len(ports)} ${typeText(ports[0])}`)
    println(`in nodes: ${len(nodes(g)->filter<func (n: Node) => bool n == ports[0]>)}`)
    return p
}

/// The order edges that reach the `GATE` the `sync` block of `main` hands its value through: none
/// before the edit, one after it, and the one it reaches is a `println`. (The second `println` is
/// not the node to read: the front end already writes an order edge from the first one to it, so
/// the count there is one before the edit and the operator would have nothing to add.)
export func order_read::<F>(p: F) => F! spelling sync {
    let g = mainGraph(graph_of(p))
    let gate = gateOf(g)
    let pres = order_inputs(gate)
    println(len(pres))
    println(firstIsPrint(pres))
    return p
}

/// Orders the end of `main`'s `sync` block after its second `println`. Both ends write or carry the
/// block's value, so the edge is one the encoder keeps (a node that arranges itself freely drops
/// it), and the value the program prints is the same.
export func order_add::<F>(p: F) => F! spelling sync {
    let d = open(p)
    let g = mainGraph(d)
    let print = printOf(g)
    let gate = gateOf(g)
    order(print, gate)
    return commit(d)
}

/// Orders an addition that reads another addition *before* the one it reads: the graph would have
/// to run `c` before `a` while `c` is computed from `a`, so the operator refuses, and it refuses
/// before the commit has anything to say about the graph.
export func order_cycle::<F>(p: F) => F! spelling sync {
    let d = open(p)
    let g = mainGraph(d)
    let outer = outerAddOf(g)
    let ins = inputs(outer)
    let adds = ins->filter<isAdd>
    order(outer, adds[0])
    return commit(d)
}
