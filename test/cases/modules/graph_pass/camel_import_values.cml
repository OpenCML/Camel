// A pass whose module imports a library written in Camel: the imported function's graph is
// declared and built by the pass program's builder, and its generic `flat_map` works there
// (task, item 1).
module camel_import_values
import { Program } from graph
import { flat_map } from array

func expanded(x: int): int[] {
    return [x, x + 1]
}

export func show(p: Program): Program! sync {
    println([1, 2, 3]->flat_map<expanded>)
    return p
}
