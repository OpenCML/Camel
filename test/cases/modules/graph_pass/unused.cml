import { flatten } from array
import { Node, Graph, NodeKind, nodes, graphs, kind, is_pure, is_constant, is_anchor, value_users, open, erase, abort, commit } from graph
import { is_function } from types

/// Whether the node is no more than its value: a constant, an access, a fill or a pure operation.
/// A conversion and a copy were kinds of their own once (`NodeKind::Cast`, `NodeKind::Copy`); they
/// are calls of `:op/cast` and `:op/copy` now, both declared pure, so `is_pure` answers for them
/// and no clause of their own is left to write.
func valueOnly(n: Node) => bool {
    let k = kind(n)
    return (k == NodeKind::Data && is_constant(n)) || k == NodeKind::Accs || k == NodeKind::Fill || is_pure(n)
}

func isUnused(n: Node) => bool {
    return valueOnly(n) && len(value_users(n)) == 0 && !is_anchor(n)
}

func allNodes(d: Graph) => Node[] {
    return flatten(graphs(d)->map<func (g: Graph) => Node[] {
        nodes(g)
    }>)
}

func eraseAll::<F>(d: Graph, hits: Node[]) => F! sync {
    hits->foreach<func (n: Node) {
        erase(n)
    }>
    return commit(d)
}

// A round that found nothing commits nothing: the draft is dropped and the function it started
// from is the answer.
func abandon::<F>(d: Graph, p: F) => F! sync {
    abort(d)
    return p
}

func settle::<F>(p: F) => F! when is_function::<F>() sync {
    let d = open(p)
    let hits = allNodes(d)->filter<isUnused>
    return if len(hits) == 0 then abandon(d, p) else eraseAll(d, hits)->settle
}

/// The constants and pure operations that no node reads, removed until none is left.
export func values::<F>(p: F) => F! {
    return settle(p)
}
