import { Graph, Node, Region, RegionKind, nodes, region_of, region_kind, region_parent, graphs_of } from graph

// Every node is in a region; the body of a graph is region 0 and its kind is Root, whether or
// not the graph has a region table.
func isBodyNode(n: Node): bool {
    return region_kind(region_of(n)) == RegionKind::Root
}

func isInlineRegion(r: Region): bool {
    return region_kind(r) == RegionKind::Inline
}

func isInlineNode(n: Node): bool {
    return isInlineRegion(region_of(n))
}

func parentOk(n: Node): bool {
    let r = region_of(n)
    return if isInlineRegion(r) then region_parent(r) != null else true
}

func reportGraph(g: Graph) sync {
    let ns = nodes(g)
    println(len(ns))
    println(len(ns->filter<isBodyNode>))
    println(len(ns->filter<isInlineNode>))
    println(len(ns->filter<parentOk>))
}

export func report::<F>(p: F): F! sync {
    graphs_of(p)->foreach<(g: Graph) => reportGraph(g)>
    return p
}
