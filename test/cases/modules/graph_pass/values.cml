// A pass written in Camel reads the values of its own module's top level: a literal, an
// expression of them, the result of a call, and a value a helper function reads. The values are
// computed before the pass runs, as a program computes its top-level values before `main`
// (design principles 10.1): the pass runs as the entry of a program of its own, not as a
// function graph encoded alone (task).
module values
import { Program } from graph

let two = 2
let four = two + two
func seven(): int {
    return 7
}
let computed = seven()
let total = two + four + computed

func scaled(x: int): int {
    return x * two
}

export func show(p: Program): Program! sync {
    println(two, four, computed, total)
    println(scaled(3))
    return p
}