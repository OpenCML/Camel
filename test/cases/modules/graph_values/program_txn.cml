/**
 * A draft over the running Program (`current`, `open`, `commit`): the committed Program drops the
 * `+ 1` from `target`. The Program the draft was opened on, and the code that is running, must
 * still see the original `target` (design principles 9.1).
 */
import { Graph, Node, commit, constant, graph_of, graphs, graphs_of, inputs, name, nodes, op, op_name, open, replace } from graph
import { ends_with } from str

func target(x: int) => int {
    return (x + 1) * 3
}

func opText(n: Node) => string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func isOne(n: Node) => bool {
    return match constant::<int>(n) {
        case null => false
        case v => v == 1
    }
}

/// The `x + 1` of `target`: an int addition whose second operand is the constant 1.
func isAddOne(n: Node) => bool spelling {
    let ins = inputs(n)
    return opText(n) == ':op/add_l' && len(ins) == 2 && isOne(ins[1])
}

/// How many `+ 1` nodes the graph of a function has.
func addOnes(g: Graph) => int {
    return len(nodes(g)->filter<isAddOne>)
}

/// The number of nodes of a function's graph.
func size(g: Graph) => int {
    return len(nodes(g))
}

func isTarget(g: Graph) => bool spelling {
    return name(g)->ends_with<'target'>
}

/// The `target` graph of a draft (the graph the draft is of, and the graphs it calls).
func targetInDraft(d: Graph) => Graph spelling {
    let found = graphs(d)->filter<isTarget>
    return found[0]
}

/// The `target` graph of the program a function value belongs to.
func targetOf::<F>(p: F) => Graph spelling {
    let found = graphs_of(p)->filter<isTarget>
    return found[0]
}

func main() => int spelling sync {
    let p = main
    let d = open(p)
    nodes(targetInDraft(d))->filter<isAddOne>->foreach<func (n: Node) {
        replace(n, inputs(n)[0])
    }>
    let q = commit::<() => int>(d) !! p
    println(`committed: ${addOnes(targetOf(q))}`)
    println(`opened on: ${addOnes(targetOf(p))}`)
    println(`running: ${target(5)} ${addOnes(graph_of(target))}`)
    let later = func (x: int) => int {
        target(x) + 1000
    }
    println(`made after: ${later(5)}`)
    println(`current: ${addOnes(targetOf(main))}`)
    return 0
}
