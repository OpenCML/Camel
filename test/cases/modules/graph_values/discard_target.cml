/**
 * The program `discard_pass::discard` runs over: `target(5)` is 18 as written. The pass tries a
 * rewrite that would drop the `+ 1` and returns the program it was given, so the run computes 18
 * and the running program, as `current()` names it, still has the `+ 1` (design principles 9.1).
 */
module discard_target
import { Graph, Node, Program, constant, current, graphs, inputs, name, nodes, op, op_name } from graph
import { ends_with } from str

func target(x: int): int {
    return (x + 1) * 3
}

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func isOne(n: Node): bool {
    return match constant(n, 0) {
        case null => false
        case v => v == 1
    }
}

/// The `x + 1` of `target`: an int addition whose second operand is the constant 1.
func isAddOne(n: Node): bool {
    let ins = inputs(n)
    return opText(n) == ':op/add_l' && len(ins) == 2 && isOne(ins[1])
}

/// How many `+ 1` nodes the graph of a function has.
func addOnes(g: Graph): int {
    return len(nodes(g)->filter<isAddOne>)
}

/// The number of nodes of a function's graph.
func size(g: Graph): int {
    return len(nodes(g))
}

func isTarget(g: Graph): bool {
    return name(g)->ends_with<'target'>
}

func targetIn(p: Program): Graph {
    let found = graphs(p)->filter<isTarget>
    return found[0]
}

func main(): int sync {
    println(`running: ${target(5)}`)
    println(`current: ${addOnes(targetIn(current()))}`)
    return 0
}
