/**
 * A transaction over one function (`open_function`, `to_function`): the new function drops the
 * `+ 1`, and `target` stays as it was for every other holder -- its own graph, a closure that
 * captured it before, and two callers that call it by name.
 */
import { Graph, Node, constant, graph_of, inputs, nodes, op, op_name, open_function, replace, to_function } from graph

func target(x: int): int {
    return (x + 1) * 3
}

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func isOne(n: Node): bool {
    return match constant(n, 0) {
        case null => false
        case v => v == 1
    }
}

/// The `x + 1` of `target`: an int addition whose second operand is the constant 1.
func isAddOne(n: Node): bool {
    let ins = inputs(n)
    return opText(n) == ':op/add_l' && len(ins) == 2 && isOne(ins[1])
}

/// How many `+ 1` nodes the graph of a function has.
func addOnes(g: Graph): int {
    return len(nodes(g)->filter<isAddOne>)
}

/// The number of nodes of a function's graph.
func size(g: Graph): int {
    return len(nodes(g))
}

func viaA(x: int): int {
    return target(x) + 100
}

func viaB(x: int): int {
    return target(x) * 2
}

func main(): int sync {
    let before = size(graph_of(target))
    let held = (x: int): int => target(x) + 1000
    let t = open_function(target)
    nodes(graph_of(target))->filter<isAddOne>->foreach<(n: Node) => replace(t, n, inputs(n)[0])>
    let g = to_function(t, target) !! target
    println(`new: ${g(5)} ${addOnes(graph_of(g))}`)
    println(`old: ${target(5)} ${addOnes(graph_of(target))} ${size(graph_of(target)) == before}`)
    println(`holders: ${held(5)} ${viaA(5)} ${viaB(5)}`)
    return 0
}
