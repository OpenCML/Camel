/**
 * A rule applied to a function that calls `target` through the rewrite engine
 * (`user->rewrite<rules>`): the result drops the `+ 1`; the function it was given and the running
 * `target` stay as they were (design principles 9.1).
 */
import { Graph, Node, constant, graph_of, inputs, name, nodes, op, op_name, graphs_of } from graph
import { Rule, rewrite } from rewrite
import { ends_with } from str

func target(x: int): int {
    return (x + 1) * 3
}

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func isOne(n: Node): bool {
    return match constant::<int>(n) {
        case null => false
        case v => v == 1
    }
}

/// The `x + 1` of `target`: an int addition whose second operand is the constant 1.
func isAddOne(n: Node): bool {
    let ins = inputs(n)
    return opText(n) == ':op/add_l' && len(ins) == 2 && isOne(ins[1])
}

/// How many `+ 1` nodes the graph of a function has.
func addOnes(g: Graph): int {
    return len(nodes(g)->filter<isAddOne>)
}

/// The number of nodes of a function's graph.
func size(g: Graph): int {
    return len(nodes(g))
}

rule drop_one(x: int) { x + 1 => x }

func isTarget(g: Graph): bool {
    return name(g)->ends_with<'target'>
}

func targetIn::<F>(p: F): Graph {
    let found = graphs_of(p)->filter<isTarget>
    return found[0]
}

/// The function the rule is applied to: it reaches `target`, so the rewrite reaches it too.
func user(): int {
    return target(5)
}

func main(): int sync {
    let p = user
    let rules: Rule[] = [drop_one]
    let q = p->rewrite<rules> !! p
    println(`rewritten: ${addOnes(targetIn(q))}`)
    println(`given: ${addOnes(targetIn(p))}`)
    println(`running: ${target(5)} ${addOnes(graph_of(target))}`)
    let later = (x: int): int => target(x) + 1000
    println(`made after: ${later(5)}`)
    println(`current: ${addOnes(targetIn(main))}`)
    return 0
}
