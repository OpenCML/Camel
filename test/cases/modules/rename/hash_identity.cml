/**
 * A stable sample for the `crypto` -> `hash` rename: the input is a literal and `std::jgir`
 * translates without hashing anything, so the graph is the same on every machine; the rename may
 * change only the module name in the two operator URIs.
 */
module hash_identity

import { sha256, sha256_rounds } from hash

func main(): int sync {
    let once = sha256('abc')
    let twice = sha256_rounds('abc', 2)
    println(once, twice)
    return 0
}