/**
 * `process` is the module of the process and the machine (which renamed `os`;
 * the terminal is `io`'s); this proves the new name imports and its operators run.
 */

import { user_name, sleep, cpu_count } from process

func main(): int sync {
    sleep(0.0)
    println((user_name() !! '')->len > 0)
    println(cpu_count() >= 1)
    return 0
}