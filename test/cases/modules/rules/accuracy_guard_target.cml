/**
 * The two forms the accuracy rules must not match: `log(exp(x) * 2)` is not a softmax, and
 * `log(exp(a) / sum(exp(b)))` normalizes one tensor with another's sum. The values are printed
 * before and after the pass, so a rule that fired here would change the text.
 */
module accuracy_guard_target

import { Tensor, reshape, exp, log, sum } from tensor

func multiplied(x: Tensor<f32>): Tensor<f32> {
    return log(exp(x) * 2.0)
}

func mismatched(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> {
    return log(exp(a) / sum(exp(b), -1, true))
}

func main(): int sync {
    let x = reshape([0.3, -1.2, 0.5, 2.0] as f32[], [2, 2])
    let y = reshape([2.0, 0.5, -1.0, 0.25] as f32[], [2, 2])
    println('multiplied sum', sum(multiplied(x)))
    println('mismatched sum', sum(mismatched(x, y)))
    return 0
}