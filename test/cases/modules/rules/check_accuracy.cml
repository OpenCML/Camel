/**
 * The check of the accuracy rules (rewrite design 2 (second version) 8.10). A rule that turns
 * `log(1 + x)` into `log1p(x)` improves the near-zero region and passes; the same law written in
 * the other direction is worse there and fails, and the failing sample is printed. The
 * log-of-softmax rule is checked on a vector, a matrix and a rank-3 tensor so that every axis it
 * needs is sampled: the tensor's rank follows the axis operand, and the axis cycles through 0, 1,
 * 2 and -1.
 */

import { check, check_text } from rewrite
import { log as scalar_log, log1p } from math
import { log, log_softmax, softmax } from tensor

#requires(refine_accuracy)
rule accurate_log1p(x: float) {
    scalar_log(1.0 + x) => log1p(x)
}

#requires(refine_accuracy)
rule worse_log1p(x: float) {
    log1p(x) => scalar_log(1.0 + x)
}

#requires(refine_accuracy)
rule softmax_vector(x: f32[3], const axis: int) {
    log(softmax(x, axis)) => log_softmax(x, axis)
}

#requires(refine_accuracy)
rule softmax_matrix(x: f32[2, 3], const axis: int) {
    log(softmax(x, axis)) => log_softmax(x, axis)
}

#requires(refine_accuracy)
rule softmax_axis2(x: f32[2, 2, 2], const axis: int) {
    log(softmax(x, axis)) => log_softmax(x, axis)
}

func main(): int sync {
    println(check_text([
        accurate_log1p,
        worse_log1p,
        softmax_vector,
        softmax_matrix,
        softmax_axis2
    ]->check<100, 7>))
    return 0
}