/**
 * A rule's `when` is Camel code of the scope the rule is declared in, and its names are resolved
 * there: a misspelled predicate is an unresolved name like any other, reported on the rule's line,
 * and the module does not load. It does not wait for an instance -- the rule here is generic and
 * never applied.
 *
 * The silent half of the older ruling is untouched: a condition that names a type for which the
 * predicate has no instance is not an error (the ruling of 2026-10-23 on
 * `generic-rule-instantiation-set-and-predicate`); `generic_law.cml` covers it.
 */
module err_when_unknown_name

import { is_integer } from types

rule add_zero::<T>(x: T) when is_integerr::<T>() { x + 0 => x }

func main(): int sync {
    println(1)
    return 0
}