/**
 * A program that interleaves a graph draft with a rewrite without going through a rule condition:
 * the draft commits (which replaces the program) and the rewrite of the program the draft started
 * from runs after it.
 */

import { open, commit, add_constant } from graph
import { rewrite } from rewrite

rule drop_one(x: int) when true { x * 1 => x }

func redex(x: int) => int {
    return x * 1 + 0
}

export func interfere::<F>(p: F) => F! sync {
    let d = open(p)
    add_constant(d, 1)
    let published = commit::<F>(d)
    return match published {
        case error e => sync {
            println('commit error value: ', e.kind)
            return published
        }
        case q => p->rewrite<[drop_one]>
    }
}

func main() => int sync {
    let p = redex
    return match interfere(p) {
        case error e => sync {
            println('outer error value: ', e.kind)
            return 1
        }
        case q => sync {
            println('interleaved ok')
            return 0
        }
    }
}
