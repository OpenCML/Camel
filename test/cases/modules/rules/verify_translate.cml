/**
 * What the translation layer makes of a rule (rewrite design 8.1: every rule of the
 * library is translated, and the verdict surface it publishes is the one the report
 * reads).
 *
 * The two sides of a rule are two graphs. The layer reads them into logic terms -- the integer
 * scalar fragment: the widths `int` and `i32`, the operators `+ - * / %` and unary `-`, integer
 * constants and the rule's own parameters -- and every row of the verdict table says what it made
 * of that rule in its `coverage` column:
 *
 *   * a rule of the fragment is `integer scalar <width>: <lhs> = <rhs>`, the proposition a decision
 *     procedure would be handed. With no solver in this build the row is still `sampled`: comparing
 *     samples is not establishing a proposition, and the layer does not publish `proved`;
 *   * a rule outside the fragment is `beyond translation coverage: <reason>`, and the reason names
 *     the class that stopped it -- a whole-tensor property, an element type the layer does not
 *     translate yet, an operator outside the fragment, a node kind it does not read. The layer
 *     refuses rather than guesses (design 8.1: 覆盖之外一律拒绝翻译，并给出原因), and a rule it
 *     refused is `sampled`, never `proved`;
 *   * a generic law's row is one per instance, and a law whose declaration carries a `when` is
 *     translated with `, no premise yet` written after the proposition: the condition is what makes
 *     the proposition conditional, and turning it into a premise is S4's work, not something this
 *     slice may assume away.
 *
 * `check_coverage_table` is the boundary itself as a value: which widths and operators the layer
 * covers, what it refuses, and that a condition is not a premise yet. A design section drifts from
 * the code; this table is what the code says, and the plan asserts it line by line.
 */
module verify_translate

import { check, check_text, coverage_table } from rewrite
import { int_add_zero, float_add_neg_zero, array_mul_one } from rules

/// A rule of the fragment: both sides are integer scalar terms.
rule twice(x: int) { x + x => x * 2 }

/// The same in the other width the fragment covers.
rule plus_zero(x: i32) { x + 0 => x }

/// Two sides the fragment would read if `^` were in it: `x ^ 2` and `x * x` are one integer
/// equality, and the layer still refuses the rule by the operator it does not translate.
rule squared(x: int) { x ^ 2 => x * x }

/// A floating width: declared in the coverage table, not translated yet (S3).
rule scaled(x: float) { x * 1.0 => x }

func main(): int sync {
    print(coverage_table)
    let mine = [twice, plus_zero, squared, scaled]->check<10, 7>
    println("rows", len(mine.rows))
    print(check_text(mine))
    println("0", mine.rows[0].coverage)
    println("1", mine.rows[1].coverage)
    println("2", mine.rows[2].coverage)
    println("3", mine.rows[3].coverage)
    // The library's own: a generic law whose declaration carries `when is_integer::<T>()`, so it has
    // one row per integer width and no premise yet, and a tensor law, whose property is over the
    // whole tensor at once.
    let library = [int_add_zero, array_mul_one]->check<10, 7>
    println("rows", len(library.rows))
    print(check_text(library))
    println("0", library.rows[0].coverage)
    println("1", library.rows[1].coverage)
    println("2", library.rows[2].coverage)
    // The floating family: the four widths the design lists beside the integer ones. Every one of
    // them is refused by its element type -- including the two the check cannot even make a value
    // for, whose coverage column is still read off the rule's own two sides.
    let floats = [float_add_neg_zero]->check<10, 7>
    println("rows", len(floats.rows))
    println("0", floats.rows[0].coverage)
    println("1", floats.rows[1].coverage)
    println("2", floats.rows[2].coverage)
    println("3", floats.rows[3].coverage)
    return 0
}
