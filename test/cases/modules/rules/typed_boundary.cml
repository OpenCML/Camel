/**
 * The boundaries a typed law must not cross. Each line prints what the program computes and what
 * the tempting wrong law would have produced; the two differ, so a rewrite that fired would
 * collapse the pair.
 */

func i32_mul_div(x: i32): i32 { return (x * 2) / 2 }
func f32_add_stable(x: f32): f32 { return (x + 1.0e30) - 1.0e30 }
func f32_mul_div(x: f32): f32 { return (x * 3.0) / 3.0 }
func f32_zero(x: f32): f32 { return x * 0.0 }
func f32_self(x: f32): f32 { return x / x }

func main(): int sync {
    let inf = f32(3.0e38) * 2.0
    println(i32_mul_div(2147483647), 2147483647)
    println(f32_add_stable(1.0), 1.0)
    println(f32_mul_div(7.7), 7.7)
    println(f32_zero(inf), 0.0)
    println(f32_self(inf), 1.0)
    return 0
}