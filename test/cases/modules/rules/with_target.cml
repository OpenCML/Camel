/**
 * The program the rules with `with` parameters are applied to (design principles 5.5). Two
 * functions hold the shape the condition-carrying rule matches, so the report of a run says
 * whether the value the rule was bound to let it fire, and one holds the shape of the rule whose
 * parameter has a default.
 */

/// x + 0: matched by the rule when the value bound to its `with` parameter is positive.
func left(x: int): int { return x + 0 }

/// x + y + 0: the same outer addition with an addend that is not a constant, so a report can tell
/// this function from the one above.
func right(x: int, y: int): int { return x + y + 0 }

/// x * 1: the shape of the rule whose `with` parameter has a default.
func folded(x: int): int { return x * 1 }

func main(): int sync {
    println(left(3), right(3, 4), folded(5))
    return 0
}
