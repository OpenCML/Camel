/**
 * Two sites of the same shape, one floating and one whole: the target of `generic_guard_law`, whose
 * rule is conditioned on a generic guard the integer type has no instance of. Each site writes its
 * coefficient as a literal, which is what a rule's `const` parameter matches (a coefficient the
 * program computes at run time is not a constant, and no law reads it).
 */
module generic_guard_target

func scal(x: float): float {
    return x * 1.5 + x
}

func whole(x: int): int {
    return x * 3 + x
}

func main(): int sync {
    println(scal(3.0), whole(4))
    return 0
}