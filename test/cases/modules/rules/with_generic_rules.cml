/**
 * The rule of the design draft 1 (rewrite design 2 (second version) 1): a type parameter and a
 * `with` parameter, through one instantiation channel. The value is the factor of the product: the
 * pattern matches it as a constant (`x * 2` when the rule is bound to 2) and the replacement is
 * built from it (`x + x * (tile - 1)`, the constant folded where the rule fires), so both sides
 * read it.
 *
 * What a rule value is bound to is half of the key its instance is made under (design principles
 * 5.4, 5.5): the one declaration bound to 2 and to 3 is two instances, the two sites of `x * 2` are
 * served by one, and the same rule bound to 0 is a third instance whose condition refuses. The
 * shape-carrying parameter types of the draft's `T[m, k]` come from the tensor module and are not
 * written here; what the case pins is the channel.
 */
module with_generic_rules

import { Graph, Node, name, nodes, op, op_name, graphs_of } from graph
import { Run, check, explain_all, rule_name, run, check_text } from rewrite

/// The draft's rule, over the types this branch writes: `x * tile` becomes `x + x * (tile - 1)`,
/// with the value read by the pattern and by the replacement.
with <tile: int>
rule tile_scale::<T>(x: T) when tile > 0 { x * tile => x + x * (tile - 1) }

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf::<F>(p: F, function: string): Node[] {
    let found = graphs_of(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf::<F>(p: F, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

/// One line per function: how many additions and how many products it holds. The pattern of the
/// rule bound to 2 matches the products of `wide` and `again` and not the one of `thrice`, and the
/// replacement it builds from the value adds an addition -- what the value was read for.
export func report::<F>(p: F): F! sync {
    println('wide', countOf(p, 'wide', ':op/add_l'), countOf(p, 'wide', ':op/mul_l'))
    println('again', countOf(p, 'again', ':op/add_l'), countOf(p, 'again', ':op/mul_l'))
    println('thrice', countOf(p, 'thrice', ':op/add_l'), countOf(p, 'thrice', ':op/mul_l'))
    println('zeroed', countOf(p, 'zeroed', ':op/add_l'), countOf(p, 'zeroed', ':op/mul_l'))
    return p
}

/// The rule bound to 2: the proof of the application, whose steps name the instance each rewrite
/// came from -- the one instance of the two sites, `tile_scale<int>(tile = 2)`.
export func counted_two::<F>(p: F): F! sync {
    let rules = [tile_scale<2>]
    return match p->run<rules, explain: true> {
        case error e => { return e }
        case r => sync {
            println('rewrites', r.rewrites, 'rule', rule_name(tile_scale<2>))
            return match explain_all(r) {
                case error e => { return e }
                case proof => sync {
                    println(proof)
                    return r.result
                }
            }
        }
    }
}

/// The same rule bound to 3: another instance of the one declaration, `tile_scale<int>(tile = 3)`,
/// which fires once.
export func counted_three::<F>(p: F): F! sync {
    let rules = [tile_scale<3>]
    return match p->run<rules, explain: true> {
        case error e => { return e }
        case r => sync {
            println('rewrites', r.rewrites, 'rule', rule_name(tile_scale<3>))
            return match explain_all(r) {
                case error e => { return e }
                case proof => sync {
                    println(proof)
                    return r.result
                }
            }
        }
    }
}

/// The same rule bound to 0: its pattern matches `x * 0`, its condition refuses, and nothing is
/// rewritten -- the third instance, and the value is what the run differs by.
export func counted_zero::<F>(p: F): F! sync {
    let rules = [tile_scale<0>]
    return match p->run<rules, explain: true> {
        case error e => { return e }
        case r => sync {
            println('rewrites', r.rewrites, 'rule', rule_name(tile_scale<0>))
            return match explain_all(r) {
                case error e => { return e }
                case proof => sync {
                    println(proof)
                    return r.result
                }
            }
        }
    }
}

/// What `check` says about the rule bound to 2: one row per instance, each named with the type it
/// was made at and the value it was bound to.
export func checked::<F>(p: F): F! sync {
    let rules = [tile_scale<2>]
    println(check_text(rules->check<100, 7>))
    return p
}
