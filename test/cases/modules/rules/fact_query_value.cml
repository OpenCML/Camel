/**
 * A fact of a generic head is read at a type argument that can be determined, and a value is not a
 * node: `depth(a)` hands the query the value `a` where the query takes the node of the value, so
 * the call is refused with the type the parameter takes and the type the argument has (language
 * reference 9). `depth::<int>(n)` on a bare `Node` is how a node whose value type the program did
 * not state is queried.
 */
module fact_query_value
import { Node, Graph, nodes, name } from graph
import { max } from math

fact depth::<T>(v: T): int match v {
    case const c => 1
    case x + y   => max(depth::<T>(x), depth::<T>(y)) + 1
    case _       => 0
} join max

func wrong(a: int): int {
    return depth(a)
}