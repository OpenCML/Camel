/**
 * A generic law: the rule value carries its template (rewrite design 2 (second version) 8.5; the
 * ruling of 2026-10-23 on generic-rule-instantiation). `add_zero` is written once and covers every
 * integer type: applied to `generic_target.cml` it makes one instance for `int` and one for `i32`,
 * and `explain` names the instance each rewrite came from. `add_minus_zero` is float's own law --
 * signed zero is not an integer's -- so `x + -0.0` is not folded into `x + 0`.
 *
 * The condition is resolved where the rule is declared, which is this module: a rule's `when` is
 * Camel code of its own declaration's scope, so `is_integer` is imported here and not by the
 * program the rule is applied to.
 */
module generic_law

import { Graph, Node, NodeKind, Program, graphs, kind, name, nodes } from graph
import { Run, explain_all, rule_name, run, why_not } from rewrite
import { is_float, is_integer } from types

rule add_zero::<T>(x: T) when is_integer::<T>() { x + 0 => x }
rule add_minus_zero::<T>(x: T) when is_float::<T>() { x + -0.0 => x }

/// The nodes of one function of the program, by the name of its graph.
func nodesOf(p: Program, function: string): Node[] {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

/// The parameter of a function: the value its body is, after the law was applied to it.
func portOf(p: Program, function: string): Node {
    let ports = nodesOf(p, function)->filter<(n: Node): bool => kind(n) == NodeKind::Port>
    return ports[0]
}

/// A value of a function that no law touched: what `why_not` answers about a type a law cannot be
/// written for is asked at one of these.
func valueOf(p: Program, function: string): Node {
    let values = nodesOf(p, function)->filter<(n: Node): bool => kind(n) == NodeKind::Data>
    return values[0]
}

/// Prints the proof of the run, so that every step names the instance that made it.
func proofOf(r: Run<Program>): Program! sync {
    return match explain_all(r) {
        case error e => { throw e }
        case proof => sync {
            println(proof)
            return r.result
        }
    }
}

/// The two laws applied once: what the application cost, the name the rule value carries, and the
/// proof. The value is the one the module wrote, not a part of any program.
export func counted(p: Program): Program! sync {
    return match p->run<[add_zero, add_minus_zero], explain: true> {
        case error e => { throw e }
        case r => sync {
            println('rewrites', r.rewrites, 'rule', rule_name(add_zero))
            return proofOf(r)
        }
    }
}

/// The instance the small addition was made by, read out of `why_not`: the integer law's `i32`
/// instance, named with its type.
export func why_i32(p: Program): Program! sync {
    return match p->run<[add_zero, add_minus_zero], explain: true> {
        case error e => { throw e }
        case r => sync {
            return match why_not(r, add_zero, portOf(r.result, 'i32_zero')) {
                case error e => sync { println(e); return r.result }
                case reason => sync { println(reason); return r.result }
            }
        }
    }
}

/// The other half of the read-out: at a value of a type the float law cannot be written for, the
/// answer is what was tried. A failed instantiation is silent where it happens -- nothing of it
/// reaches the program, and the tuple is remembered as one that did not come about -- so this is
/// the one place its reason is read (the ruling of 2026-10-23 on
/// `generic-rule-instantiation-set-and-predicate`, §3).
export func why_no_instance(p: Program): Program! sync {
    return match p->run<[add_zero, add_minus_zero], explain: true> {
        case error e => { throw e }
        case r => sync {
            return match why_not(r, add_minus_zero, valueOf(r.result, 'greet')) {
                case error e => sync { println(e); return r.result }
                case reason => sync { println(reason); return r.result }
            }
        }
    }
}

/// The other question: at the value the float law made, `why_not` for the integer law names the
/// instance that did fire there, `add_minus_zero<float>`, so a user asking the wrong law at the
/// right value is told which instance ran.
export func why_float(p: Program): Program! sync {
    return match p->run<[add_zero, add_minus_zero], explain: true> {
        case error e => { throw e }
        case r => sync {
            return match why_not(r, add_zero, portOf(r.result, 'f64_minus_zero')) {
                case error e => sync { println(e); return r.result }
                case reason => sync { println(reason); return r.result }
            }
        }
    }
}