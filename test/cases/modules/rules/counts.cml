/**
 * Prints how many additions and products the functions `coefficients` and `chain` have, then the
 * program goes on.
 */
module counts
import { Node, Graph, nodes, op, op_name, name, graphs_of } from graph

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf::<F>(p: F, function: string): Node[] {
    let found = graphs_of(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf::<F>(p: F, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

export func report::<F>(p: F): F! sync {
    println('coefficients', countOf(p, 'coefficients', ':op/add_l'), countOf(p, 'coefficients', ':op/mul_l'))
    println('chain', countOf(p, 'chain', ':op/add_l'), countOf(p, 'chain', ':op/mul_l'))
    return p
}

/// The products of `scaled` and `kept`, for the rules whose requirement is a permission.
export func report_requires::<F>(p: F): F! sync {
    println('scaled', countOf(p, 'scaled', ':op/mul_d'), 'kept', countOf(p, 'kept', ':op/mul_d'))
    return p
}
