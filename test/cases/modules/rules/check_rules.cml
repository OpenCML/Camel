/**
 * The check every rule passes before it enters a library (graph store decision 5): random
 * instances of the two sides must agree. `good` holds; `wrong` and `rounding` are rules that do
 * not.
 */
module check_rules
import { check } from rewrite

rule add_zero(x: int) { x + 0 => x }
rule mul_one(x: int) { x * 1 => x }
rule combine(x: int, const c1: int, const c2: int) { x * c1 + x * c2 => x * (c1 + c2) }
rule minus_zero(x: float) { x + -0.0 => x }
rule times_one(x: float) { x * 1.0 => x }
rule swap(a: int, b: int) { a + b <=> b + a }

rule wrong(x: int) { x * 2 => x + 2 }
rule sign(x: float) { x * -1.0 => x }
rule plus_zero(x: float) { x + 0.0 => x }

func main(): int sync {
    println(check([add_zero, mul_one, combine, swap, minus_zero, times_one], 100, 1))
    println(check([wrong, sign, plus_zero], 100, 1))
    return 0
}
