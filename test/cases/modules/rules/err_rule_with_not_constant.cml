/**
 * The value bound to a rule's `with` parameter is part of what selects the instance the rule's
 * sides are made at, so it is a value the compiler knows. A binding whose value is not known until
 * the program runs would need one instance for every value it could take, so it is refused where
 * the binding is written (design principles 5.4, 5.5; rewrite design 2 (second version) 1).
 */

import { rewrite } from rewrite

with <tile: int>
rule add_tile(x: int) when tile > 0 { x + tile => x }

/// The factor is a parameter of the function, so it is not known while the program is compiled.
func apply(p: () => int, tile: int): (() => int)! {
    return p->rewrite<[add_tile<tile>]>
}

func main(): int sync {
    return 0
}
