/**
 * `log(softmax(x, -1))`, which is how the showcase's loss is written when the softmax is bound
 * first: `let p = softmax(logits); log(p)`. `rules::accuracy` replaces it with
 * `log_softmax(x, -1)`. The gap `[-300, 0]` is the interesting one: the probability of the first
 * lane rounds to zero, so the naive log is -inf while the log-softmax value is -300.
 */

import { reshape, log, log_softmax, softmax, sum } from tensor

#[refine_accuracy]
func composed(x: f32[..]): f32[..] {
    return log(softmax<-1>(x))
}

func main(): int sync {
    let clean = reshape<[2, 4]>([0.3, -1.2, 0.5, 2.0, 1.1, 0.4, -0.7, 0.2] as f32[])
    let gap = reshape<[1, 2]>([-300.0, 0.0] as f32[])
    println('log of softmax clean', sum(composed(clean)), sum(log_softmax<-1>(clean)))
    println('log of softmax gap  ', sum(composed(gap)), sum(log_softmax<-1>(gap)))
    return 0
}