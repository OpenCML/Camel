/**
 * Every rule of the standard rules passes the check (rewrite design 5.2).
 *
 * The integer and floating laws are one generic law per fact since the fold (`when is_integer::<T>()`,
 * `when is_float::<T>()`), and `check` walks the instances of each of them (the ruling of 2026-10-24
 * on `generic-rule-check-surface-and-multi-parameter-instances`, §1: an optional `program` was asked
 * for, and with no program a generic rule is checked for every instance over "the types the operator
 * group registered" that satisfies its condition). Each instance is reported under its own name,
 * `law<type>`, and no rule of the two families is reported as a generic rule that was not checked:
 * the integer family is instantiable at `int` and `i32` and the floating family at `float`, `f32`,
 * `bf16` and `f16` (the condition `is_float::<T>()` holds for all four -- design principles 7.3).
 *
 * Two of the four floating instances are reported `unchecked` with their reason: `check`'s sampler
 * draws `int`, `i32`, `float`, `f32`, `bool` and tensors of them, and a `bf16`/`f16` instance needs
 * an element-epsilon tolerance this lane did not invent
 * (`docs/handover/questions/check-generic-instance-space.md`). The report is 74 instances of the 26
 * generic rules in this list (13 integer laws x 2 types, 11 floating laws x 4 types -- the two
 * accuracy laws are not in this list), 52 checked and 22 reported with a reason.
 *
 * The rules below that are not generic -- the tensor laws, `float_double`, `float32_double` -- are
 * checked as they were.
 */
module check_library
import { check } from rewrite
import {
        int_add_self, int_add_zero, int_combine, int_combine_one, int_distribute, int_div_one, int_fold, int_fold_add, int_mul_one, int_mul_zero, int_neg_neg, int_sub_self, int_sub_zero,
        float_add_minus_zero, float_add_self, float_combine, float_combine_mixed, float_combine_one, float_combine_one_mixed, float_div_one, float_double, float_fold, float_mul_one, float_neg_neg, float_sub_zero,
        float32_double,
        tensor_f32_add_minus_zero, tensor_f32_add_self, tensor_f32_combine, tensor_f32_combine_mixed, tensor_f32_combine_one, tensor_f32_combine_one_mixed, tensor_f32_div_one, tensor_f32_double, tensor_f32_fold, tensor_f32_mul_one, tensor_f32_neg_neg, tensor_f32_sub_zero, tensor_i64_distribute
} from rules

func main(): int sync {
    print(check([
        int_add_self, int_add_zero, int_combine, int_combine_one, int_distribute, int_div_one, int_fold, int_fold_add, int_mul_one, int_mul_zero, int_neg_neg, int_sub_self, int_sub_zero,
        float_add_minus_zero, float_add_self, float_combine, float_combine_mixed, float_combine_one, float_combine_one_mixed, float_div_one, float_double, float_fold, float_mul_one, float_neg_neg, float_sub_zero,
        float32_double,
        tensor_f32_add_minus_zero, tensor_f32_add_self, tensor_f32_combine, tensor_f32_combine_mixed, tensor_f32_combine_one, tensor_f32_combine_one_mixed, tensor_f32_div_one, tensor_f32_double, tensor_f32_fold, tensor_f32_mul_one, tensor_f32_neg_neg, tensor_f32_sub_zero, tensor_i64_distribute
    ], 200, 7))
    return 0
}