/**
 * Every rule of the standard rules passes the check (rewrite design 5.2). The integer and floating
 * laws are one generic law per fact since the fold (`when is_integer::<T>`, `when is_float::<T>`),
 * and `check` walks the instances of each of them (an optional `program` was asked for, and with no
 * program a generic rule is checked for every instance over "the types the operator group
 * registered" that satisfies its condition). Each instance is reported under its own name,
 * `law<type>`, and no rule of the two families is reported as a generic rule that was not checked:
 * the integer family is instantiable at `int` and `i32` and the floating family at `float`, `f32`,
 * `bf16` and `f16` (the condition `is_float::<T>` holds for all four -- design principles 7.3).
 * Every floating instance is checked, the two reduced-precision ones included: the sampler draws a
 * `bf16` and an `f16` as it draws an f32 -- the drawn value is rounded once into the element type,
 * a tensor of either type is two bytes per element -- and the comparison uses the element epsilon
 * of the type the instance is at (§check-generic-instance-space, 3, which opened this lane;
 * `check_reduced_element_type.cml` is the case that reads those rows one by one). The 39 rules of
 * this list are 70 instances of generic laws (13 integer laws x 2 types, 11 floating laws x 4 types
 * -- the two accuracy laws are not in this list) besides the 15 rules of it that are not generic,
 * so the report is 85 lines: 70 instances with a verdict and the 15 rules that are not generic. The
 * rules below that are not generic -- the tensor laws, `float_double`, `float32_double` -- are
 * checked as they were. That this list is the library's list is asserted by
 * `rules.every_exported_rule_enters_the_check` (`check_every_rule.cml` and its verify script), not
 * by this hand-written one, which is what drifted.
 */
module check_library
import { check } from rewrite
import {
        int_add_self, int_add_zero, int_combine, int_combine_one, int_distribute, int_div_one, int_fold, int_fold_add, int_mul_one, int_mul_zero, int_neg_neg, int_sub_self, int_sub_zero,
        float_add_minus_zero, float_add_self, float_combine, float_combine_mixed, float_combine_one, float_combine_one_mixed, float_div_one, float_double, float_fold, float_mul_one, float_neg_neg, float_sub_zero,
        float32_double,
        tensor_f32_add_minus_zero, tensor_f32_add_self, tensor_f32_combine, tensor_f32_combine_mixed, tensor_f32_combine_one, tensor_f32_combine_one_mixed, tensor_f32_div_one, tensor_f32_double, tensor_f32_fold, tensor_f32_mul_one, tensor_f32_neg_neg, tensor_f32_sub_zero, tensor_i64_distribute
} from rules

func main(): int sync {
    print(check([
        int_add_self, int_add_zero, int_combine, int_combine_one, int_distribute, int_div_one, int_fold, int_fold_add, int_mul_one, int_mul_zero, int_neg_neg, int_sub_self, int_sub_zero,
        float_add_minus_zero, float_add_self, float_combine, float_combine_mixed, float_combine_one, float_combine_one_mixed, float_div_one, float_double, float_fold, float_mul_one, float_neg_neg, float_sub_zero,
        float32_double,
        tensor_f32_add_minus_zero, tensor_f32_add_self, tensor_f32_combine, tensor_f32_combine_mixed, tensor_f32_combine_one, tensor_f32_combine_one_mixed, tensor_f32_div_one, tensor_f32_double, tensor_f32_fold, tensor_f32_mul_one, tensor_f32_neg_neg, tensor_f32_sub_zero, tensor_i64_distribute
    ], 200, 7))
    return 0
}