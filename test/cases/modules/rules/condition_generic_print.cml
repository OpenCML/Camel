/**
 * A generic rule whose condition calls a generic function: which candidate the call takes is
 * decided by the type arguments of the instance, so what the condition does is only known where
 * the instance is made. The candidate here prints, which is an effect of the condition.
 */

import { rewrite } from rewrite

rule add_zero::<T>(x: T) when announce(x) { x + 0 => x }

func announce::<T>(x: T): bool sync {
    println('announce ', x)
    return true
}

func redex(x: int): int {
    return x * 1 + 0
}

func main(): int sync {
    let p = redex
    return match p->rewrite<[add_zero]> {
        case error e => sync { println('outer error value: ', e.kind); return 1 }
        case q => sync { println('rewritten'); return 0 }
    }
}