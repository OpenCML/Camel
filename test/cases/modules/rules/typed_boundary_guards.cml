/**
 * The coefficient laws' value guards, each at the value the guard is about: an overflowing sum, a
 * product that underflows to zero, a product that overflows, and a mixed pair whose sum is zero.
 */
module typed_boundary_guards

func f32_combine_over(x: f32): f32 { return x * 3.0e38 + x * 3.0e38 }

#[no_infs]
func f32_fold_zero(x: f32): f32 { return (x * 1.0e-30) * 1.0e-30 }

#[no_infs]
func f32_fold_over(x: f32): f32 { return (x * 1.0e30) * 1.0e30 }

#[finite_math]
func f32_mixed_zero(x: f32): f32 { return x * 3.0 + x * -3.0 }

func main(): int sync {
    println(f32_combine_over(0.0))
    println(f32_fold_zero(1.0e30))
    println(f32_fold_over(1.0e-30))
    println(f32_mixed_zero(-1.0))
    return 0
}
