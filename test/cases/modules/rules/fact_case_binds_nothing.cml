/**
 * A case reads how a value was built out of its parts, and the parts are the variables its pattern
 * names (`case x + y` binds the two operands, rewrite design 7.5). The first case here names none.
 */
import { max } from math

fact one(v: int): int match v {
    case 1 => 1
    case _ => 0
} join max

func main(): int sync {
    return 0
}