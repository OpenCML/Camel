/** Counts of the four typed combines. */
module typed_cross_counts
import { Program, Node, Graph, graphs, nodes, op, op_name, name } from graph

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf(p: Program, function: string): Node[] {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf(p: Program, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

func show(p: Program, function: string, suffix: string) {
    println(function, countOf(p, function, ':op/add_' + suffix), countOf(p, function, ':op/mul_' + suffix))
}

export func report(p: Program): Program! sync {
    show(p, 'i32_c', 'i')
    show(p, 'i64_c', 'l')
    show(p, 'f32_c', 'f')
    show(p, 'f64_c', 'd')
    return p
}