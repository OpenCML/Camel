/**
 * The accuracy rules as values, applied one at a time, with the cost of the application printed.
 * The naive softmax and naive log-softmax are not in the library: the check rejects the first on
 * an f32 sample, so only the accepted log-of-softmax and scalar rules are here.
 */

import { Program } from graph
import { Rule, Run, run } from rewrite
import {
    float_expm1, float_log1p, tensor_log_softmax_of_softmax,
} from rules

func reported(label: string, r: Run<Program>): Program sync {
    println(label, 'rewrites', r.rewrites, 'rounds', r.rounds)
    return r.result
}

func one(label: string, p: Program, rules: Rule[]): Program! sync {
    return p->run<rules, rounds: 16, strict: false> ?-> sync (r: Run<Program>) => reported(label, r)
}

export func only_log_of_softmax(p: Program): Program! sync {
    return one('only_log_of_softmax', p, [tensor_log_softmax_of_softmax])
}

/// The accepted accuracy rules as one set; none of the guard functions is licensed, so this is
/// also the pass that must leave them alone. The scalar rules are one law each for the whole
/// floating family since the fold, so the f32 site is theirs through their `f32` instance.
export func all(p: Program): Program! sync {
    return one(
        'all', p,
        [tensor_log_softmax_of_softmax, float_log1p, float_expm1])
}

/// The scalar accuracy rules on their own (log1p), and of expm1.
export func only_log1p(p: Program): Program! sync {
    return one('only_log1p', p, [float_log1p])
}

export func only_expm1(p: Program): Program! sync {
    return one('only_expm1', p, [float_expm1])
}

export func all_scalar(p: Program): Program! sync {
    return one('all_scalar', p, [float_log1p, float_expm1])
}