/**
 * The numeric policy of the rewrite pass is the pass's own parameter (design principles 7.4, 7.5):
 * `rules::simplify` grants the default permissions, `rules::simplify_strict` grants none, as
 * `std::opt(safe_fp=true)` does. The reassociating coefficient law therefore does not fire under
 * the strict policy while the exact doubling law still does. The counts show which law fired.
 */
module strict_target

import { Program, Node, Graph, graphs, nodes, op, op_name, name } from graph

func combine(x: float): float { return x * 3.0 + x * 5.0 }
func double(x: float): float { return x * 3.0 + x * 3.0 }

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf(p: Program, function: string): Node[] {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf(p: Program, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

export func report(p: Program): Program! sync {
    println('combine', countOf(p, 'combine', ':op/add_d'), countOf(p, 'combine', ':op/mul_d'))
    println('double', countOf(p, 'double', ':op/add_d'), countOf(p, 'double', ':op/mul_d'))
    return p
}

func main(): int sync {
    println(combine(2.0), double(2.0))
    return 0
}