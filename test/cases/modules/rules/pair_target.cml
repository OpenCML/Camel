/**
 * The program a law of two type parameters rewrites: `(x + y) - y` on `int` and on `i32`, and a
 * string value no instance of such a law can hold.
 *
 * The rule is written once for two type parameters, so a site of it is a *pair* of types: the int
 * site is `(int, int)` and the small one `(i32, i32)`, and a law that is asked for one type per
 * parameter has no instance at either (the rule on generic-rule-instantiation
 * assumes one type per value).
 */
module pair_target

func i64_pair(x: int, y: int): int {
    return x + y - y
}

func i32_pair(x: i32, y: i32): i32 {
    return x + y - y
}

/// A value no instance of the pair law can hold: `-` takes no string.
func greet(): string {
    return 'pair law'
}

func main(): int sync {
    println(greet())
    println(i64_pair(3, 4), i32_pair(5, 6))
    return 0
}