/**
 * `analysis` over pattern variables (rewrite design 4): a declaration with parameters is queried
 * with the parts of a value. That is how a rule's condition reads the fact of the compound it is
 * rewriting — the language does not name the whole match.
 *
 * `mul_by_one(a, b)` is the fact of a product: the clause for `x * y` says it is "by one" when
 * `sign(y) == 1` (the same one-value analysis the other test uses). The rule
 * `mul_one_by_parts(x, y)` passes the two parts of the multiplication to it, so `one`
 * (`x * 1`) is rewritten and `two` (`x * 2`) is not: the false case must leave the product alone.
 * The parts are pattern variables, and so nodes of the draft: a `const` parameter of a rule is
 * the constant's *value* in a condition (rewrite design 2 (second version) 1;
 * reviews/stdlib-rules.md item 5), and reaching the node of one needs a `node_of` the language
 * does not have yet.
 *
 * A parts query reads the parts in the order the pattern binds them, so the pattern has to pin
 * that order: `isConst(y)` does it by shape, and it is what keeps the matcher's commuted pairing
 * of `x * y` (which two pattern variables also match) from asking the fact with the parts
 * exchanged, where no value has them.
 *
 * `report` prints the number of products before and after `apply`, and `main` the values, which
 * are the same before and after the rewrite.
 */
module analysis_parts
import { Program, Node, Graph, graphs, nodes, op, op_name, name, constant } from graph
import { max } from math
import { rewrite } from rewrite

analysis sign: int {
    initial => 0
    join(a, b) => max(a, b)
    on (const c: int) => c
}

analysis mul_by_one(a: Node, b: Node): bool {
    initial => false
    join(a, b) => a || b
    on (x * y) => sign(y) == 1
}

/// Whether a value is a constant; the rule below needs the second part to be one, so that the
/// parts reach the query in the order the product holds them.
func isConst(n: Node): bool {
    return match constant(n, 0) {
        case null => false
        case _ => true
    }
}

rule mul_one_by_parts(x: int, y: int) { x * y => x } when isConst(y) && mul_by_one(x, y)

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf(p: Program, function: string): Node[] {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func mulsOf(p: Program, function: string): int {
    let muls = nodesOf(p, function)->filter<(n: Node): bool => opText(n) == ':op/mul_l'>
    return loop total = 0 for n in muls do total + 1
}

func one(x: int): int {
    return x * 1
}

func two(x: int): int {
    return x * 2
}

export func apply(p: Program): Program! {
    return rewrite(p, [mul_one_by_parts])
}

export func report(p: Program): Program! sync {
    println('one', mulsOf(p, 'one'), 'two', mulsOf(p, 'two'))
    return p
}

func main(): int sync {
    println(one(7), two(7))
    return 0
}