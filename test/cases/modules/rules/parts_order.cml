/**
 * A fact query inside a condition, and the parts of a commutative operator. A rule whose condition
 * asks a parameterized analysis hands it the parts of the compound it matched (rule-language design
 * v2, section 1: a `const` parameter is the constant's value in a condition, and the node itself is
 * reached with `node_of(c)`; rewrite design 4.1-4.2: the query answers for the value whose parts
 * these are).
 *
 * `mul_by_one(a, b)` is the fact of a product: its `x * y` clause is "by one" when the *second*
 * operand is the constant 1. The rule `drop_by_one` declares its coefficient `const c: int`, so the
 * condition reaches the coefficient's *node* with `node_of(c)` and asks
 * `mul_by_one(x, node_of(c))`: the factor first, the coefficient second.
 *
 * `drop_by_one`'s condition hands the query the parts `(factor, coefficient)`, and `swapped` is
 * `a * 1`: the pattern `x * c` binds `c` to the constant only under the exchange of the product's
 * two operands, which the declaration of `*` carries (op-semantics 7.4: the exchange gives the same
 * value). The parts therefore reach the query in the order `(1, a)` while the product holds them
 * `(a, 1)`, the other order. Both orders name the same value, so the query answers either way, and
 * that is what this input detects: an engine that looked for the operands in exactly the order it
 * was given would answer no value for `swapped`, and the case would show the product kept.
 *
 * `kept` (`a * 2`) is the same query on a coefficient that is not one: the query answers false, so
 * the rule must not apply, the product and the value must stay, and the pass must not fail either.
 * `plain` (`a * 5.0`) has a guard on the value, which asks no question about parts: it loses its
 * product in the same pass, so a pass that quietly stopped doing its work would show up there.
 */
module parts_order

import { Program, Node, Graph, graphs, nodes, op, op_name, name } from graph
import { max } from math
import { rewrite } from rewrite

analysis sign: int {
    initial => 0
    join(a, b) => max(a, b)
    on (const c: int) => c
}

analysis mul_by_one(a: Node, b: Node): bool {
    initial => false
    join(a, b) => a || b
    on (x * y) => sign(y) == 1
}

func positive(c: float): bool {
    return c > 0.0
}

/// The coefficient is `const`, so its node is reached with `node_of`; the pattern writes the factor
/// first, and for `swapped` (`1 * a`) the exchange is the pairing that binds the constant to `c`,
/// so the parts reach the condition in the other order from the one the product holds them in.
rule drop_by_one(x: int, const c: int) when mul_by_one(x, node_of(c)) { x * c => x }

/// A guard on the value, which the value channel answers without any node.
rule drop_positive(x: float, const c: float) when positive(c) { x * c => x }

export func apply(p: Program): Program! {
    return rewrite(p, [drop_by_one, drop_positive])
}

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func countOf(p: Program, function: string, operator: string): int {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return len(nodes(found[0])->filter<(n: Node): bool => opText(n) == operator>)
}

export func report(p: Program): Program! sync {
    println('swapped', countOf(p, 'swapped', ':op/mul_l'))
    println('kept', countOf(p, 'kept', ':op/mul_l'))
    println('plain', countOf(p, 'plain', ':op/mul_d'))
    return p
}

func swapped(a: int): int { return a * 1 }

func kept(a: int): int { return a * 2 }

func plain(a: float): float { return a * 5.0 }

func main(): int sync {
    println(swapped(7), kept(7), plain(3.0))
    return 0
}