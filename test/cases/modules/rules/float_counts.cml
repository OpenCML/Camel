/**
 * Prints the add and product counts of the float target, so the test can see which permission
 * let a rule through: `combine` and `double` by default, `granted_mixed` and `granted_chain`
 * only where the node grants the permission they need.
 */
import { Node, Graph, nodes, op, op_name, name, graphs_of } from graph

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf::<F>(p: F, function: string): Node[] {
    let found = graphs_of(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf::<F>(p: F, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

export func report::<F>(p: F): F! sync {
    println('combine', countOf(p, 'combine', ':op/add_d'), countOf(p, 'combine', ':op/mul_d'))
    println('mixed', countOf(p, 'mixed', ':op/add_d'), countOf(p, 'mixed', ':op/mul_d'))
    println('chain', countOf(p, 'chain', ':op/add_d'), countOf(p, 'chain', ':op/mul_d'))
    println('double', countOf(p, 'double', ':op/add_d'), countOf(p, 'double', ':op/mul_d'))
    println('granted_mixed', countOf(p, 'granted_mixed', ':op/add_d'), countOf(p, 'granted_mixed', ':op/mul_d'))
    println('granted_chain', countOf(p, 'granted_chain', ':op/add_d'), countOf(p, 'granted_chain', ':op/mul_d'))
    return p
}