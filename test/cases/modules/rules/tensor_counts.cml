/**
 * Prints the tensor add and product counts of the tensor target, so the test can see which law
 * fired: `combine` and `double` by default, `fold_granted` and the mixed laws only where the
 * function grants the permission they need, and `inexact` too, because its coefficients are the
 * f32 values the source writes: a coefficient beside a tensor takes the element type.
 */

import { Node, Graph, nodes, op, op_name, name, graphs_of } from graph

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf::<F>(p: F, function: string): Node[] {
    let found = graphs_of(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf::<F>(p: F, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

func show::<F>(p: F, function: string) {
    println(function, countOf(p, function, 'tensor:add'), countOf(p, function, 'tensor:multiply'))
}

export func report::<F>(p: F): F! sync {
    show(p, 'combine')
    show(p, 'combine_mixed')
    show(p, 'combine_mixed_granted')
    show(p, 'fold')
    show(p, 'fold_granted')
    show(p, 'double')
    show(p, 'self')
    show(p, 'one')
    show(p, 'one_other')
    show(p, 'one_mixed')
    show(p, 'one_mixed_granted')
    show(p, 'neutral')
    show(p, 'inexact')
    show(p, 'inexact_one')
    show(p, 'i64_self')
    show(p, 'i64_distribute')
    return p
}