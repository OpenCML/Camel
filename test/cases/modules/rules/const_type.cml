/**
 * The matcher checks the declared type of a `const` parameter.
 * A coefficient is where this
 * shows: it is a literal beside the
 * value it multiplies, so it takes that value's type (design principles 5.1) - an f32 constant
 * under a `f32[3]`, an f64 one under a `float` - and only the rule declared for that
 * type reads it.
 *
 * Both rules replace the product by its first factor, so the sum the program prints says which of
 * them ran: 18.0 and 15.0 before the pass, 6.0 and 5.0 when a rule dropped the product. Each run
 * prints the tensor's sum first and the scalar's second, so it shows the rule firing on the
 * coefficient of its own type and leaving the other one alone.
 */
module const_type

import { reshape, sum } from tensor
import { Program } from graph
import { rewrite } from rewrite

type Vec = f32[3]

/// The coefficient of `scaled` is an f32 constant, so this rule reads it; the scalar below has an
/// f64 coefficient, which the declared f32 does not accept.
rule takes_f32(x: Vec, const c: f32) { x * c => x }

/// The same rule for the scalar `float` program, whose coefficient is an f64 constant: it reads
/// that one and not the tensor's, so the pair tells the two apart.
rule takes_f64(x: float, const c: float) { x * c => x }

export func by_f32(p: Program): Program! {
    return rewrite(p, [takes_f32])
}

export func by_f64(p: Program): Program! {
    return rewrite(p, [takes_f64])
}

/// `x * 3.0`: 18 in all, 6 when the coefficient's own rule drops the product.
func scaled(x: Vec): Vec { return x * 3.0 }

/// The scalar product: 15 in all, 5 when its own rule drops it.
func scaled_scalar(x: float): float { return x * 3.0 }

func main(): int sync {
    println(sum(scaled(reshape([1.0, 2.0, 3.0] as f32[], [3]))))
    println(scaled_scalar(5.0))
    return 0
}
