/**
 * The accuracy rules of `rules::simplify` need the numeric permission `refine_accuracy`
 * (rewrite design 2 (second version) 8.10). `plain` grants nothing, so its `log(1 + x)` keeps
 * its form; `licensed` grants the permission, so the rule replaces it with `log1p(x)`; `guarded`
 * grants the permission and is `#strict`, where no permission applies, so it keeps its form too.
 * The report counts the operator each function calls before and after the pass.
 */
module accuracy_licence_target

import { log } from math

func plain(x: float): float {
    return log(1.0 + x)
}

#[refine_accuracy]
func licensed(x: float): float {
    return log(1.0 + x)
}

#[strict, refine_accuracy]
func guarded(x: float): float {
    return log(1.0 + x)
}

func main(): int sync {
    println(plain(1e-30), licensed(1e-30), guarded(1e-30))
    return 0
}