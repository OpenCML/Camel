/**
 * A rule whose condition commits a graph transaction of its own: the commit replaces the program
 * the outer rewrite is still working on.
 */

import { Graph, Node, nodes, open, commit, add_constant, graph_of } from graph
import { rewrite } from rewrite

rule add_zero(x: int) when publish_now() { x + 0 => x }

func publish_now() => bool {
    let p = redex
    return match do_publish(p) {
        case error e => sync {
            println('inner error value: ', e.kind)
            return false
        }
        case q => sync {
            return true
        }
    }
}

func do_publish::<F>(p: F) => F! sync {
    let d = open(p)
    add_constant(d, 1)
    println('added node ', len(nodes(d)))
    return commit(d)
}

func redex(x: int) => int {
    return x * 1 + 0
}

func main() => int sync {
    let p = redex
    return match p->rewrite<[add_zero]> {
        case error e => sync {
            println('outer error value: ', e.kind)
            return 1
        }
        case q => sync {
            println('rewritten')
            return 0
        }
    }
}
