/**
 * A rule whose left side reads one of its `with` parameters.
 *
 * The left side is the pattern matched against the program, so it holds an operator, a constant
 * or one of the rule's parameters -- a value the caller gives is none of those, so the read is
 * refused where the parameter is written.
 */
module err_rule_with_left_read
import { Program } from graph

with <tile: int>
rule add_tiled(x: int) { x + tile => x }
