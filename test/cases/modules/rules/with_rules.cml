/**
 * Rules that declare `with` parameters (design principles 5.5, rewrite design 2 (second version)
 * 1), and the passes that use them.
 *
 * A rule's `with` parameters are written before the declaration, as a function writes its own,
 * with the same defaults and the same grammar. They are the rule's own values: the condition is a
 * function of them and reads them by name, `name<value>` binds them and gives the `Rule`, and a
 * rule whose parameters all have a default is a `Rule` by its name alone.
 */
import { Program, Node, Graph, graphs, nodes, op, op_name, name } from graph
import { rewrite } from rewrite

/// x + 0 => x, but only where the condition holds: the `when` reads the `with` parameter, which
/// is a value there, not a node of the draft (a rule parameter is the node).
with <tile: int>
rule add_zero_tiled(x: int) when tile > 0 { x + 0 => x }

/// x * 1 => x: the parameter has a default, so the name alone is a `Rule` value, and the
/// condition reads the value that default gives.
with <scale: int = 1>
rule mul_one_scaled(x: int) when scale > 0 { x * 1 => x }

/// The rules as `Rule` values: one bound where it is written, one by its default.
export func apply(p: Program): Program! {
    let rules = [add_zero_tiled<1>, mul_one_scaled]
    return rewrite(p, rules)
}

/// The same set with the tile rule bound to 0: its condition refuses and the additions stay.
export func apply_refusing(p: Program): Program! {
    return rewrite(p, [add_zero_tiled<0>, mul_one_scaled])
}

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func nodesOf(p: Program, function: string): Node[] {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

func countOf(p: Program, function: string, operator: string): int {
    return len(nodesOf(p, function)->filter<(n: Node): bool => opText(n) == operator>)
}

/// Prints the addition and product count of every function of the target, so the tests can see
/// which rule the binding let through and which one the condition of the rule refused.
export func report(p: Program): Program! sync {
    println('left', countOf(p, 'left', ':op/add_l'), countOf(p, 'left', ':op/mul_l'))
    println('right', countOf(p, 'right', ':op/add_l'), countOf(p, 'right', ':op/mul_l'))
    println('folded', countOf(p, 'folded', ':op/add_l'), countOf(p, 'folded', ':op/mul_l'))
    return p
}
