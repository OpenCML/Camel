/**
 * `check` has two forms (design principles 4.4): the rules alone, and the rules with `over`, the
 * function the check is about. `samples` and `seed` have defaults in both, so a call may leave
 * them out.
 *
 * A generic law's candidate set is the types the operator groups registered, and then the types
 * of the function `over` names: `sum_swap` has no instance at `Vec` unless the function names it,
 * which is what the two reports below differ in.
 */
import tensor
import { check, check_text } from rewrite


type Vec = f32[3]

rule add_zero(x: int) { x + 0 => x }
rule sum_swap::<T>(a: T, b: T) { a + b => b + a }

// The program's own type: no operator group registered `Vec`, so only a program that has it can
// add it to a law's candidate set.
func touch(x: Vec): Vec {
    return x + x
}

func main(): int sync {
    // `over` left out: the law is checked at the types the registered operator groups give.
    println(check_text([add_zero, sum_swap]->check<100, 1>))
    // `over` given: the program's own types join the candidate set.
    println(check_text([add_zero, sum_swap]->check<main, 100, 1>))
    // Every parameter but the rules left out.
    println(check_text([add_zero, sum_swap]->check))
    return 0
}