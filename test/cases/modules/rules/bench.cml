/**
 * Measures one whole application of a rule set on `bench_target.cml` (H226): the rewrites, the
 * rounds, the nodes visited, the nodes erased, whether it reached a fixpoint and the wall time,
 * for the application that rewrites and for a second one that finds the fixpoint at once.
 *
 * The pass is `sync` and so are the callbacks it hands to `?->`: printing is part of the pass's
 * execution, not a value left unapplied (`SemanticDiag::EffectNotExecuted`).
 */
module bench

import { Program } from graph
import { Rule, Run, run } from rewrite
import { int_add_zero, int_mul_one } from rules

func report(label: string, r: Run<Program>): void sync {
    println(label, 'rewrites', r.rewrites, 'rounds', r.rounds, 'visited', r.visited, 'erased',
        r.erased, 'fixpoint', r.fixpoint, 'seconds', r.seconds)
}

export func measure(p: Program): Program! sync {
    let rules: Rule[] = [int_add_zero, int_mul_one]
    return run(p, rules, 16, false) ?-> sync (first: Run<Program>) => sync {
        report('run_first', first)
        return run(first.result, rules, 16, false) ?-> sync (second: Run<Program>) => sync {
            report('run_again', second)
            return second.result
        }
    }
}