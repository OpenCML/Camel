/**
 * A requirement may name a group of permissions the program declares (design principles 6.2,
 * 7.2): `tag fast = [reassociate, contract]` is a tag like any other, and `#requires(fast)` is
 * the union of what its members grant. The rule is applied where the node grants any of them.
 */
module requires_group
import { rewrite } from rewrite

tag fast = [reassociate, contract]

#requires(fast)
rule mul_one(x: float) { x * 1.0 => x }

export func apply::<F>(p: F): F! {
    return p->rewrite<[mul_one]>
}