/**
 * The rule column and the instance column are two facts, not one (slice S0; the rule of
 * 2026-10-24 on `verification-verdict-surface`, 2: a `CheckReport` row carries `rule` and
 * `instance`).
 *
 * The engine names an instance of a generic law `int_add_zero<int>` -- one string, the type tuple
 * included. The row splits it: `rule` is the law's own name, `instance` is the type tuple the
 * instance was made at, and the rendering puts the two back together, so a reader of the report
 * still sees the name the engine, `explain` and the old report used. The integer family has an
 * instance at `int` and one at `i32` (the condition `is_integer::<T>()` holds for both), and each
 * row keeps the law's name in one column and its own tuple in the other, without repeating the
 * other column inside itself.
 */

import { check, check_row_count, check_rule, check_instance, check_verdict } from rewrite
import { int_add_zero } from rules

func main(): int sync {
    let r = check([int_add_zero], 50, 11)
    println("rows", check_row_count(r))
    println("row 0 |", check_rule(r, 0), "|", check_instance(r, 0), "|", check_verdict(r, 0))
    println("row 1 |", check_rule(r, 1), "|", check_instance(r, 1), "|", check_verdict(r, 1))
    return 0
}