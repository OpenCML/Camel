/**
 * A `fact` whose cases read a value of the module they are declared in: the case functions are
 * values of that module, and the value is one they captured where they were written. Every
 * value's fact is that value times a thousand, so a reader of the fact reads the capture and
 * nothing else can be mistaken for it.
 */

import { Node, Graph, nodes, name, graphs_of } from graph
import { max } from math

func base_of(): int {
    return 7
}

let base = base_of()

fact depth: int match v {
    case const c: int => base * 1000 + 1
    case _            => base * 1000
} join (a: int, b: int) => max(a, b)

func nodes_of::<F>(p: F, function: string): Node[] {
    let found = graphs_of(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

export func report::<F>(p: F): F! sync {
    let ns = nodes_of(p, 'sum')
    let total = loop running = 0 for n in ns do running + depth(n)
    println('depth ', total)
    return p
}