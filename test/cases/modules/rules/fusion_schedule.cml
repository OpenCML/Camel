/**
 * The fusion rule as a value, applied on its own with the cost of the application printed. The
 * cost line before it and after it is what shows four kernels becoming one; the values on either
 * side are the same bits.
 */

import { Program } from graph
import { Run, run } from rewrite
import { tensor_sigmoid_chain } from rules

func reported(label: string, r: Run<Program>): Program sync {
    println(label, 'rewrites', r.rewrites, 'rounds', r.rounds)
    return r.result
}

export func only_sigmoid(p: Program): Program! sync {
    return p->run<[tensor_sigmoid_chain], rounds: 16, strict: false>
        ?-> sync (r: Run<Program>) => reported('only_sigmoid', r)
}