/**
 * `eprintln` is in the prelude (the rule on question 2): a program writes it
 * without an import. It has the same declaration shape as `println` — it takes any arguments,
 * writes them separated by spaces and a line end, and gives back its first one — and it writes
 * the standard error stream, where diagnostics go, not standard output.
 */
module main

func main(): int sync {
    let first = eprintln('to stderr', 1)
    println('value:', first)
    return 0
}