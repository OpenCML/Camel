/**
 * The terminal reader: what the process's stdin holds is read through `io`'s declared operators
 * and written back out. `roundtrip.mjs` supplies the input through a pipe (not a terminal) and
 * checks what comes back, so the case needs no interactive terminal.
 */

import { set_terminal_raw_mode, has_input, get_char, get_chars } from io

func main(): int sync {
    println(has_input())
    let first = get_char() ?? ''
    let rest = get_chars(4)
    let _ = set_terminal_raw_mode(false)
    print(first)
    println(rest)
    return 0
}