/**
 * Values of the `math` functions that stand on a kernel, written as any program writes them
 * (`import math`): `sqrt` is exact (a square is exact, the square root of -0 is -0, of +inf is
 * +inf, of a negative number is NaN), and `shl` and `shr` take their count in angle brackets (the
 * shift into the sign bit, the arithmetic shift keeping the sign, count 0 and the largest count).
 * `inf` and `nan` are the values the C++ module registers.
 */
import { inf, nan, shl, shr, sqrt } from math

func main(): int sync {
    let zero = 0.0
    println(sqrt(9.0), sqrt(2.25), sqrt(zero), sqrt(-zero))
    println(sqrt(inf), sqrt(-4.0), nan == nan, inf > 1.0e308)
    let one = 1
    println(one->shl<4>, i32(one)->shl<31>, (-8)->shr<1>, 256->shr<4>, i32(-8)->shr<1>)
    println(one->shl<63>, 1->shl<0>, (-1)->shr<63>)
    return 0
}
