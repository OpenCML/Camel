/**
 * Exercises non-interactive process helpers such as identity lookup, zero-duration sleep, and CPU discovery.
 */

import { whoami, sleep, cpu_count } from process

func main(): int sync {
    println("=== Process Module Basic Tests ===")

    println("\n[1] whoami()")
    let user = whoami()
    println("  user =", user)

    println("\n[2] sleep(0)")
    sleep(0)
    println("  sleep(0) OK")

    println("\n[3] cpu_count()")
    println("  logical cpu count =", cpu_count())

    println("\n=== Process tests completed ===")
    return 0
}
