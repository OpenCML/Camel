/**
 * The process boundary of H9 item 3: the working directory, an environment variable's value and
 * every file this program names contain characters outside the process code page (an emoji is in
 * none of them; Chinese is only in some). Each line is printed bare, so that
 * test/cases/tools/unicode/unicode_paths.test.mjs compares the exact UTF-8 text.
 */
module env_paths

import { get_env, get_cwd } from env
import { write_text, read_text, exists, file_size } from fs

func main(): int sync {
    let cwd = get_cwd()
    'cwd={}'->format<cwd>->println
    'value={}'->format<get_env('CAMEL_H9_VALUE')>->println
    'named={}'->format<get_env('H9变量')>->println

    let text = '你好，世界 Ω 🐪'
    let file = cwd + '/数据 文件 🐪.txt'
    write_text(file, text)
    'exists={}'->format<exists(file)>->println
    'size={}'->format<file_size(file)>->println
    'text={}'->format<read_text(file)>->println

    // The parent directory does not exist yet: writing the leaf makes it (fs.write_text).
    let nested = cwd + '/子 目录/嵌套 文件.txt'
    write_text(nested, '嵌套内容')
    'nested={}'->format<read_text(nested)>->println

    'missing={}'->format<exists(cwd + '/不存在 文件 🐪.txt')>->println
    return 0
}