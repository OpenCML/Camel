/**
 * The negative side of the process boundary of item 3: a diagnostic about a file whose name
 * lies outside the process code page must still carry the name in UTF-8, not as '?'.
 */
module missing_file

import { read_text } from fs
import { get_cwd } from env

func main(): int sync {
    println(read_text(get_cwd() + '/不存在 文件 🐪.txt'))
    return 0
}