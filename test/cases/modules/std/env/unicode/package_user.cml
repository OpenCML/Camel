/**
 * A module found through CAMEL_PACKAGES, whose root has a name outside the process code page
 * (item 3): the search path comes from the environment as UTF-8. It also prints CAMEL_HOME,
 * so the test can check that the installation root it was started from is the one it sees.
 */
module package_user

import { twice } from helper
import { get_env } from env

func main(): int sync {
    'package={}'->format<twice(21)>->println
    'home={}'->format<get_env('CAMEL_HOME')>->println
    return 0
}