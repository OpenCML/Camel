/**
 * A variable that is not set is null; a variable set to the empty text is the empty text. The
 * two are different answers, so `??` can give a default only for the first.
 */

import { get_env } from env

func describe(value: string?): string {
    return match value {
        case null => 'unset'
        case v => 'set to ' + v
    }
}

func main(): int sync {
    println(describe(get_env('CAMEL_TEST_ENV_UNSET_ABC')))
    println(describe(get_env('CAMEL_TEST_ENV_SET')))
    println(get_env('CAMEL_TEST_ENV_UNSET_ABC') ?? 'default')
    return 0
}
