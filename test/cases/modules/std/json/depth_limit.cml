/**
 * The depth limit of a JSON document is a fixed constant, not an environment variable (the
 * author's ruling on H16 question 4; design principles 11.2). The constant is named once, as
 * `kJsonMaxDepth` in modules/json/operators.cpp, and this case pins its value from both sides:
 * a document of exactly 10000 levels decodes, and one of 10001 levels is the error value
 * JsonTooDeep at the bracket that goes too deep (line 1, column 10001). Raising the constant
 * would make the 10001-level document decode and fail this case; lowering it would make the
 * 10000-level one fail.
 */

import { decode } from json

func repeat(ch: string, n: int): string {
    let (s, chunk, k) = loop s = '', chunk = ch, k = n while k > 0 do (
        if k % 2 == 1 then s + chunk else s,
        chunk + chunk,
        k / 2)
    return s
}

func main(): int sync {
    let atLimit = repeat('[', 10000) + '1' + repeat(']', 10000)
    println(len(string(decode(atLimit))))

    let oneDeeper = repeat('[', 10001) + '1' + repeat(']', 10001)
    let deep = match (decode(oneDeeper)) {
        case error e => e
        case v => error('NoError', 'the document one level deeper decoded')
    }
    println(deep.kind, deep.location)
    println(deep.message)
    return 0
}