
import json

// json::decode_as: decoding to a given type. The type is that of the shape argument (its
// value is not read); the result is a `T!`, so text that is not JSON and JSON of another
// shape are error values to handle with `!!` or `match`, not faults.

type Point = { x: int, y: int }

func describe::<T>(r: T!): string {
    return match r {
        case error e => e.kind + ': ' + e.message
        case v => 'ok'
    }
}

func main(): int sync {
    let r = json::decode_as<[] as Map<string, int>>('{"b": 2, "a": 1}')
    println(r)
    let m = r !! ([] as Map<string, int>)
    println(m['a'] ?? 0, len(m), keys(m))

    println(json::decode_as('[3, 1, 2]', [0]))
    println(json::decode_as('[3, 1, 3]', [] as Set<int>))
    println(json::decode_as('{"a": [1, 2], "b": []}', [] as Map<string, int[]>))
    println(json::decode_as('{"k": {"x": 1, "y": 2}}', [] as Map<string, Map<string, int>>))
    println(json::decode_as('{"a": null, "b": 3}', [] as Map<string, int?>))
    println(json::decode_as('{"x": 1, "y": 2}', { x: 0, y: 0 }))
    println(json::decode_as('[1, "one"]', (0, '')))
    println(json::decode_as('[1.5, 2]', [0.0]))
    println(json::decode_as('"s"', ''), json::decode_as('true', false), json::decode_as('{}', [] as Map<string, int>))

    println(json::decode_as('{"a": 1, "b": "two"}', [] as Map<string, int>))
    println(json::decode_as('{"a": 1', [] as Map<string, int>))
    println(json::decode_as('[1, 2]', [] as Map<string, int>))
    println(json::decode_as('{"k": {"x": 1.5}}', [] as Map<string, Map<string, int>>))
    println(json::decode_as('{"x": 1}', { x: 0, y: 0 }))
    println(json::decode_as('{"x": 1, "y": 2, "z": 3}', { x: 0, y: 0 }))
    println(json::decode_as('[1, 2, 3]', (0, 0)))
    println(json::decode_as('null', 0))
    println(describe(json::decode_as('[1, "x"]', [0])), describe(json::decode_as('[1, 2]', [0])))
    let bad = json::decode_as('[1, "x"]', [0])
    println(match bad { case error e => e.location  case v => 'ok' })
    println(len(json::decode_as('nonsense', [] as Set<string>) !! (['fallback'] as Set<string>)))

    println(json::encode(m), json::encode([2, 1, 2] as Set<int>))
    println(json::encode([('k', [('x', 1.5)] as Map<string, float>)] as Map<string, Map<string, float>>))
    let round = json::decode_as(json::encode(m), [] as Map<string, int>) !! ([] as Map<string, int>)
    println(round == m)
    return 0
}
