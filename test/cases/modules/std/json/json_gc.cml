/**
 * A Json held across collections: its strings, arrays and objects are traced through the
 * types its kinds fix (modules/json/value.h), with both collectors and under forced collection
 * (docs/design/any-typing, defect D0: a decoded value used to sit in a slot typed `any` that no
 * collector traced). `n` strings are allocated between decoding and reading.
 */
module json_gc

import { Json, decode, get, as_string, as_array } from json

func churn(n: int): int {
    return len(range(0, n)->map<(i: int): string => 'item-' + string(i)>)
}

func keep(j: Json, n: int): Json {
    let c = churn(n)
    return if c >= 0 then j else j
}

func main(n: int): int sync {
    let d = decode('{"names": ["alpha", "beta", "gamma"], "nested": {"deep": ["x-' + string(n) + '"]}}')
    let c = churn(n)
    let kept = keep(d, n)
    let names = (kept->get<'names'>->as_array ?? [])->map<(x: Json): string => x->as_string ?? '?'>
    println(c, names, kept->get<'nested'>->get<'deep'>->get<0>->as_string ?? '?')
    let docs = range(0, 3)->map<(i: int): Json => decode('{"k": "v-' + string(i) + '"}')>
    let d2 = churn(n)
    println(d2, docs->map<(x: Json): string => x->get<'k'>->as_string ?? '?'>)
    return 0
}
