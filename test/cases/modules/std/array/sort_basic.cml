/**
 * Exercises the sorting functions of the `array` module: a new array (the argument is unchanged)
 * and deterministic merge behavior for sorted inputs.
 */
module main

import { sort, merge_sorted_arrays } from array

func main(): int sync {
    println("=== Array Sorting Tests ===")

    println("\n[1] sort")
    let arr = [3, 1, 2]
    let sorted_arr = sort(arr)
    println("  sort([3,1,2]) ->", sorted_arr, "unchanged:", arr)

    println("\n[2] merge_sorted_arrays")
    let a = [1, 3, 5]
    let b = [2, 4, 6]
    let merged = merge_sorted_arrays(a, b)
    println("  merge_sorted_arrays([1,3,5], [2,4,6]) ->", merged)

    println("\n=== Sorting tests completed ===")
    return 0
}

