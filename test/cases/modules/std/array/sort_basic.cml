/**
 * Exercises the sorting functions of the `array` module: a new array (the argument is unchanged)
 * and the merge of two sorted inputs written as a sort of their concatenation.
 */

import { sort } from array

func main(): int sync {
    println("=== Array Sorting Tests ===")

    println("\n[1] sort")
    let arr = [3, 1, 2]
    let sorted_arr = sort(arr)
    println("  sort([3,1,2]) ->", sorted_arr, "unchanged:", arr)

    println("\n[2] merge")
    let a = [1, 3, 5]
    let b = [2, 4, 6]
    let merged = sort(concat(a, b))
    println("  sort(concat([1,3,5], [2,4,6])) ->", merged)

    println("\n=== Sorting tests completed ===")
    return 0
}

