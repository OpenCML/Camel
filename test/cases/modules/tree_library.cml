// The tree split: `tree` is the Camel library (no `.cmo`), and the checkpoint operators and the
// one tree operation still native (`tree_leaves`) are in the native module `ckpt`. If a native
// `tree.cmo` still existed in the standard library, `import tree` would load it and this file
// would either fail (no `tree_paths` there) or, worse, silently use it instead of
// `stdlib/tree.cml`.
module tree_library_and_ckpt

import { tree_paths, tree_map } from tree
import { tree_leaves } from ckpt

func main(): int sync {
    let p = { w: 3.0, block: (4.0, 5.0) }
    println(tree_paths(p))
    println(tree_leaves(p))
    println(tree_map<(x: float): float => x + 1.0>(p))
    return 0
}