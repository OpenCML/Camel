module tiles_numeric_permissions
import { Tensor, reshape, sum } from tensor
import { source, inspect, run_preferred_resident, download } from tiles

func strict(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> { return a * b + c }
#[contract]
func allowed(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> { return a * b + c }
#[contract]
func reversed(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> { return c + a * b }
#[reassociate, approx_math, change_precision, finite_math]
func other_permissions(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> { return a * b + c }
#[contract]
func caller(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> { return strict(a,b,c) }
func add_only(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> {
    let product = a * b
    #[contract] { return product + c }
}
#[contract]
func multiply(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a * b }
func multiply_only(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> { return multiply(a,b) + c }
#[contract]
func shared_product(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): (Tensor<f32>, Tensor<f32>) {
    let product = a * b
    return (product, product + c)
}
func main(): int sync {
    let a = reshape([1.00000011920928955078125, 1.00000011920928955078125], [2,1])
    let b = reshape([0.99999988079071044921875, 0.99999988079071044921875, 0.99999988079071044921875], [1,3])
    let c = reshape([-1.0], [1,1])
    println(sum(download(run_preferred_resident<strict>((a,b,c)))))
    println(sum(download(run_preferred_resident<allowed>((a,b,c)))))
    println(sum(download(run_preferred_resident<reversed>((a,b,c)))))
    println(sum(download(run_preferred_resident<other_permissions>((a,b,c)))))
    println(sum(download(run_preferred_resident<caller>((a,b,c)))))
    println(sum(download(run_preferred_resident<add_only>((a,b,c)))))
    println(sum(download(run_preferred_resident<multiply_only>((a,b,c)))))
    println(sum(download(run_preferred_resident<shared_product>((a,b,c))).1))
    println(sum(download(run_preferred_resident<strict>((a,b,c)))))
    println(inspect<allowed>((a,b,c)))
    println(inspect<caller>((a,b,c)))
    println(inspect<add_only>((a,b,c)))
    println(inspect<multiply_only>((a,b,c)))
    println(source<allowed>((a,b,c)))
    return 0
}

