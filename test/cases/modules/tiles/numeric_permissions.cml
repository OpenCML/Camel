import { reshape, sum } from tensor
import { source, inspect, run_preferred_resident, download } from tiles

func strict(a: f32[..], b: f32[..], c: f32[..]): f32[..] { return a * b + c }
#[contract]
func allowed(a: f32[..], b: f32[..], c: f32[..]): f32[..] { return a * b + c }
#[contract]
func reversed(a: f32[..], b: f32[..], c: f32[..]): f32[..] { return c + a * b }
#[reassociate, approx_math, change_precision, finite_math]
func other_permissions(a: f32[..], b: f32[..], c: f32[..]): f32[..] { return a * b + c }
#[contract]
func caller(a: f32[..], b: f32[..], c: f32[..]): f32[..] { return strict(a,b,c) }
func add_only(a: f32[..], b: f32[..], c: f32[..]): f32[..] {
    let product = a * b
    #[contract] { return product + c }
}
#[contract]
func multiply(a: f32[..], b: f32[..]): f32[..] { return a * b }
func multiply_only(a: f32[..], b: f32[..], c: f32[..]): f32[..] { return multiply(a,b) + c }
#[contract]
func shared_product(a: f32[..], b: f32[..], c: f32[..]): (f32[..], f32[..]) {
    let product = a * b
    return (product, product + c)
}
func main(): int sync {
    let a = reshape([1.00000011920928955078125, 1.00000011920928955078125] as f32[], [2,1])
    let b = reshape([0.99999988079071044921875, 0.99999988079071044921875, 0.99999988079071044921875] as f32[], [1,3])
    let c = reshape([-1.0] as f32[], [1,1])
    // A whole-tensor reduction answers the operand's element type (design principles 7.3); the
    // python side compares the printed decimals against f64 expressions, so each call site writes
    // the f64 reading.
    println(float(sum(download(run_preferred_resident<strict>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<allowed>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<reversed>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<other_permissions>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<caller>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<add_only>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<multiply_only>((a,b,c))))))
    println(float(sum(download(run_preferred_resident<shared_product>((a,b,c))).1)))
    println(float(sum(download(run_preferred_resident<strict>((a,b,c))))))
    println(inspect<allowed>((a,b,c)))
    println(inspect<caller>((a,b,c)))
    println(inspect<add_only>((a,b,c)))
    println(inspect<multiply_only>((a,b,c)))
    println(source<allowed>((a,b,c)))
    return 0
}

