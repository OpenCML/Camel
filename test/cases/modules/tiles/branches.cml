module tiles_branches
import { Tensor, reshape, sum, abs } from tensor
import { run_preferred_resident, download } from tiles
func forbidden(x: Tensor<f32>): Tensor<f32> sync { println('unselected effect'); return x }
func check(flag: bool, x: Tensor<f32>): float {
    let choose = (a: Tensor<f32>): Tensor<f32> => if flag then a + 2.0 else a * 3.0
    return float(sum(abs(download(run_preferred_resident<choose>(x)) - choose(x))))
}
func prune(flag: bool, x: Tensor<f32>): float {
    let choose = (a: Tensor<f32>): Tensor<f32> => if flag then a + 2.0 else forbidden(a)
    return float(sum(abs(download(run_preferred_resident<choose>(x)) - (x + 2.0))))
}
func nested(flag: bool, x: Tensor<f32>): float {
    let choose = (a: Tensor<f32>): (Tensor<f32>, Tensor<f32>) =>
        if flag then (a + 1.0, a * 2.0) else (a - 1.0, a * 3.0)
    let actual = download(run_preferred_resident<choose>(x))
    let expected = choose(x)
    return float(sum(abs(actual.0 - expected.0))) + float(sum(abs(actual.1 - expected.1)))
}
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    println(check(true, x))
    println(check(false, x))
    println(check(true, x + 1.0))
    println(prune(true, x))
    println(nested(true, x))
    println(nested(false, x))
    return 0
}
