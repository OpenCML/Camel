import { sum, abs, transpose, reshape } from tensor
import { next_key, seed, uniform } from random
import { inspect, benchmark, run_preferred_resident, download } from tiles

func pipeline(a: f32[..], b: f32[..]): f32[..] {
    return reshape<[35]>(slice(transpose((a + 1.0) * (b + 2.0)), 0, 1, 10, 2))
}
func forked(x: f32[..]): f32[..] {
    let t = transpose(x + 1.0)
    return t + t
}
func main(): int sync {
    seed(91)
    let a = (next_key()->uniform::<f32><shape: [7, 11]> * 6.0 - 3.0)
    let b = (next_key()->uniform::<f32><shape: [1, 11]> * 2.0 - 1.0)
    println(inspect<pipeline>((a, b)))
    println(inspect<forked>(a))
    println(sum(abs(download(run_preferred_resident<pipeline>((a, b))) - pipeline(a, b))))
    println(sum(abs(download(run_preferred_resident<forked>(a)) - forked(a))))
    println(benchmark<pipeline>((a, b)))
    return 0
}
