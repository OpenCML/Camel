import { random, seed, exp, sum, mean, max, sqrt } from tensor
import { benchmark } from tiles
func softmax(x: f32[..]): f32[..] {
    let e = exp(x - max<1, true>(x))
    return e / sum<1, true>(e)
}
func layernorm(x: f32[..]): f32[..] {
    let c = x - mean<1, true>(x)
    return c / sqrt(mean<1, true>(c * c) + 0.00001)
}
func main(): int sync {
    seed(162)
    let x = random([128,257], -3.0, 3.0)
    let y = random([1024,1024], -3.0, 3.0)
    println(benchmark<softmax>(x))
    println(benchmark<softmax>(y))
    println(benchmark<layernorm>(x))
    println(benchmark<layernorm>(y))
    return 0
}
