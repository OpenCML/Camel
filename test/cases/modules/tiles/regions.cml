module tiles_regions
import { Tensor, sum } from tensor
import { regions } from tiles
func chain(x: Tensor<f32, [2, 3]>): Tensor<f32, [2,3]> {
    let y = x + x
    return y * y
}
func dynamic(x: Tensor<f32>): Tensor<f32> { return x + x }
func cpu(x: Tensor<f32, [2,3]>): Tensor<f32, [2,3]> { return x }
func detour(x: Tensor<f32, [2,3]>): Tensor<f32, [2,3]> {
    let y = x + x
    return y + cpu(y)
}
func ordered(x: Tensor<f32, [2,3]>): Tensor<f32, [2,3]> sync {
    let y = (x + x)
    return y + y
}
#[contract]
func shared_values(x: Tensor<f32, [2,3]>): (Tensor<f32, [2,3]>, Tensor<f32, [2,3]>) {
    let y = x + x
    return (y, y * y)
}
func constant_axis(x: Tensor<f32, [2,3]>): Tensor<f32, [2,1]> {
    return sum(x, 1, true)
}
func main(): int sync {
    println(regions<chain>())
    println(regions<dynamic>())
    println(regions<detour>())
    println(regions<ordered>())
    println(regions<shared_values>())
    println(regions<constant_axis>())
    return 0
}
