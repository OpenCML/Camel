module tiles_loop_empty_fault
import { Tensor, zeros, sum } from tensor
import { gpu } from tiles
@gpu
func divide(x: Tensor<f32, const [0]>, denominator: float): Tensor<f32, const [0]> {
    return loop s = x for k in [1, 2] do s + 1.0 / denominator
}
func main(): int sync {
    println('zero lanes before fault once')
    let x = zeros([0]) as Tensor<f32, const [0]>
    println(sum(divide(x, 0.0)))
    println('after fault')
    return 0
}
