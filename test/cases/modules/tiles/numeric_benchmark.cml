import tensor
import { next_key, seed, uniform } from random
import { benchmark } from tiles
func strict_chain(x: f32[..], w: f32[..], b: f32[..]): f32[..] {
    let a0 = x * w + b
    let a1 = a0 * w + b
    let a2 = a1 * w + b
    let a3 = a2 * w + b
    let a4 = a3 * w + b
    let a5 = a4 * w + b
    let a6 = a5 * w + b
    return a6 * w + b
}
#[contract]
func contracted_chain(x: f32[..], w: f32[..], b: f32[..]): f32[..] {
    let a0 = x * w + b
    let a1 = a0 * w + b
    let a2 = a1 * w + b
    let a3 = a2 * w + b
    let a4 = a3 * w + b
    let a5 = a4 * w + b
    let a6 = a5 * w + b
    return a6 * w + b
}
func main(): int sync {
    seed(731)
    let x = next_key()->uniform::<f32><shape: [1024, 1024]>
    let w = (next_key()->uniform::<f32><shape: [1, 1024]> * 0.5 + 0.25)
    let b = (next_key()->uniform::<f32><shape: [1, 1024]> * 0.1 + 0.1)
    println(benchmark<strict_chain>((x,w,b)))
    println(benchmark<contracted_chain>((x,w,b)))
    return 0
}
