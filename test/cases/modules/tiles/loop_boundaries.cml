module tiles_loop_boundaries
import { Tensor, reshape, sum } from tensor
func effect(x: Tensor<f32, [3]>): Tensor<f32, [3]> {
    let pre = x + x
    let y = loop s = pre for k in [1, 2] do sync {
        println('cpu round', k)
        s + pre
    }
    return y * y
}
func crosslane(x: Tensor<f32, [3]>): Tensor<f32, [3]> {
    let pre = x + x
    let y = loop s = pre for k in [1, 2] do s + sum(s)
    return y * y
}
func conditional(x: Tensor<f32, [3]>): Tensor<f32, [3]> {
    let pre = x + x
    let n = loop s = 0.0 while s < 3.0 do s + 1.0
    return pre * n
}
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0], [3]) as Tensor<f32, [3]>
    println(sum(effect(x)))
    println(sum(crosslane(x)))
    println(sum(conditional(x)))
    return 0
}
