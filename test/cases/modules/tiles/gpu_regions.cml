module tiles_gpu_regions
import { Tensor, reshape, sum } from tensor
import { gpu, regions } from tiles

func cpu(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> sync {
    println('cpu detour once')
    return x
}

// The decorator is applied to a value in main rather than with @gpu: regions<f> inspects the
// function f denotes, and std::macro rewrites a decorated name to the plain function it wraps.
// The explicit call keeps the inspected value the decorator's result under every pass list.
func mixed(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> {
    let y = x + x
    return cpu(y) * y
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0], [3]) as Tensor<f32, const [3]>
    let decorated = gpu(mixed)
    println(sum(decorated(x)))
    println(regions<decorated>())
    let captured = gpu((v: Tensor<f32, const [3]>): Tensor<f32, const [3]> => v + x)
    println(sum(captured(x)))
    return 0
}
