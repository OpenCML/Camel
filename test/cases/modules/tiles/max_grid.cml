import { max, sum, abs } from tensor
import { next_key, seed, uniform } from random
import { run_preferred_resident, download } from tiles
func maximum(x: f32[..]): f32[..] { return max<-1>(x) }
func main(): int sync {
    seed(71)
    let x = (next_key()->uniform::<f32><shape: [65537, 128]> * 2.0 - 1.0)
    let gpu = download(run_preferred_resident<maximum>(x))
    let cpu = maximum(x)
    println(sum(abs(gpu - cpu)))
    return 0
}
