module tiles_gpu_decorator
import { Tensor, reshape, sum } from tensor
import { gpu } from tiles

@gpu
func add(x: Tensor<f32>, y: Tensor<f32>): Tensor<f32> { return x + y }

@gpu
func square(x: Tensor<f32>): Tensor<f32> { return x * x }

@gpu
func nested(x: Tensor<f32>): Tensor<f32> { return add(x, x) * x }

@gpu
func pair(x: Tensor<f32>): (Tensor<f32>, Tensor<f32>) { return (x + x, x * x) }

@gpu
func strict(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> {
    return a * b + c
}

@gpu
#[contract]
func contracted(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> {
    return a * b + c
}

@gpu
#[contract]
func caller(a: Tensor<f32>, b: Tensor<f32>, c: Tensor<f32>): Tensor<f32> {
    return strict(a, b, c)
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0], [3])
    let y = reshape([10.0, 20.0, 30.0], [3])
    println(sum(add(x, y)))
    println(sum(square(x)))
    println(sum(nested(x)))
    let f = add
    println(sum(f(x, y)))
    let p = pair(x)
    println(sum(p.0), sum(p.1))
    let a = reshape([1.00000011920928955078125], [1])
    let b = reshape([0.99999988079071044921875], [1])
    let c = reshape([-1.0], [1])
    println(sum(strict(a, b, c)) == 0.0)
    println(sum(contracted(a, b, c)) == -0.000000000000014210854715202004)
    println(sum(caller(a, b, c)) == 0.0)
    let captured = gpu((v: Tensor<f32>): Tensor<f32> => v + x)
    println(sum(captured(y)))
    @gpu
    func local(v: Tensor<f32>): Tensor<f32> { return v + x }
    println(sum(local(y)))
    return 0
}
