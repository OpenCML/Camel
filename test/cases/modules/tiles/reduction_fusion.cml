import { reshape, sum, mean, transpose, save_npy } from tensor
import { get_env } from env
import { inspect, run_preferred_resident, download } from tiles

func sample(i: int): f32 { return f32(float(i % 17 - 8) * 0.125) }
func rows(x: f32[..], b: f32[..]): f32[..] {
    return sum((x + b) * 0.5, 1)
}
func columns(x: f32[..]): f32[..] {
    return mean(transpose(x) * 0.25, 0)
}
func middle(x: f32[..]): f32[..] { return sum(x * 0.5, 1) }
func epilogue(x: f32[..], b: f32[..]): f32[..] {
    return (sum(x * 0.5, 1) + b) * 0.25
}
func two_reductions(x: f32[..]): f32[..] { return sum(x * 0.5, 1) + mean(x, 1) }
func rounded(x: f32[..]): f32[..] { return sum(x, 1) - 16777216.0 }
func main(): int sync {
    let folder = get_env('TILES_TEST_OUT') ?? ''
    let x = reshape(0..(17 * 513)->map<sample>, [17, 513])
    let b = reshape(0..513->map<sample>, [1, 513])
    let y = reshape(0..(2 * 257 * 3)->map<sample>, [2, 257, 3])
    println(inspect<rows>((x, b)))
    save_npy(rows(x, b), folder + '/rows_cpu.npy')
    save_npy(download(run_preferred_resident<rows>((x, b))), folder + '/rows_gpu.npy')
    println(inspect<columns>(x))
    save_npy(columns(x), folder + '/columns_cpu.npy')
    save_npy(download(run_preferred_resident<columns>(x)), folder + '/columns_gpu.npy')
    println(inspect<middle>(y))
    save_npy(middle(y), folder + '/middle_cpu.npy')
    save_npy(download(run_preferred_resident<middle>(y)), folder + '/middle_gpu.npy')
    let cancellation = reshape([16777216.0, 1.0, -16777216.0] as f32[], [1, 3])
    let zeros = reshape([0.0, 0.0, 0.0] as f32[], [1, 3])
    save_npy(rows(cancellation, zeros), folder + '/ordered_cpu.npy')
    save_npy(download(run_preferred_resident<rows>((cancellation, zeros))), folder + '/ordered_gpu.npy')
    let empty = reshape(0..0->map<sample>, [5, 0])
    let empty_bias = reshape(0..0->map<sample>, [1, 0])
    save_npy(rows(empty, empty_bias), folder + '/empty_cpu.npy')
    save_npy(download(run_preferred_resident<rows>((empty, empty_bias))), folder + '/empty_gpu.npy')
    let no_rows = reshape(0..0->map<sample>, [0, 513])
    save_npy(rows(no_rows, b), folder + '/no_rows_cpu.npy')
    save_npy(download(run_preferred_resident<rows>((no_rows, b))), folder + '/no_rows_gpu.npy')
    let bias = reshape(0..17->map<sample>, [17])
    println(inspect<epilogue>((x, bias)))
    save_npy(epilogue(x, bias), folder + '/epilogue_cpu.npy')
    save_npy(download(run_preferred_resident<epilogue>((x, bias))), folder + '/epilogue_gpu.npy')
    println(inspect<two_reductions>(x))
    save_npy(two_reductions(x), folder + '/two_reductions_cpu.npy')
    save_npy(download(run_preferred_resident<two_reductions>(x)), folder + '/two_reductions_gpu.npy')
    let rounding = reshape([16777216.0, 1.0] as f32[], [1, 2])
    println(inspect<rounded>(rounding))
    save_npy(rounded(rounding), folder + '/rounding_cpu.npy')
    save_npy(download(run_preferred_resident<rounded>(rounding)), folder + '/rounding_gpu.npy')
    return 0
}
