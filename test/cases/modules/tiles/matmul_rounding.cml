module tiles_matmul_rounding
import { Tensor, reshape, sum } from tensor
import { run } from tiles

func product(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> {
    return a @ b
}

func main(): int sync {
    // (1 + 2^-23) * (1 - 2^-23) rounds to 1 in f32 before adding -1.
    // FMA instead retains the residual -2^-46, violating strict contraction rules.
    let a = reshape([-1.0, 1.00000011920928955078125], [1, 2])
    let b = reshape([1.0, 0.99999988079071044921875], [2, 1])
    println(sum(run<product>((a, b))))
    return 0
}
