module tiles_matmul_rounding
import { reshape, sum } from tensor
import { run_preferred_resident, download } from tiles

func product(a: f32[..], b: f32[..]): f32[..] {
    return a @ b
}

func ordered_term(i: int): f32 {
    return if i == 0 then 16777216.0 else if i == 16 then 1.0
        else if i == 32 then -16777216.0 else if i == 33 then 1.0 else 0.0
}
func one(i: int): f32 { return 1.0 }

func main(): int sync {
    // (1 + 2^-23) * (1 - 2^-23) rounds to 1 in f32 before adding -1.
    // The normative matmul FMA chain must retain the residual -2^-46, which rounds into the operand's
    // element type with no loss; the f64 reading the assertion names is the conversion written here
    // (design principles 7.3).
    let a = reshape([-1.0, 1.00000011920928955078125] as f32[], [1, 2])
    let b = reshape([1.0, 0.99999988079071044921875] as f32[], [2, 1])
    println(float(sum(download(run_preferred_resident<product>((a, b))))))
    // A continuous chain across two tile boundaries returns 1; independently
    // accumulated panels return 2. K=34 also exercises the masked final tile.
    let ordered = reshape(0..34->map<ordered_term>, [1, 34])
    let ones = reshape(0..34->map<one>, [34, 1])
    println(float(sum(download(run_preferred_resident<product>((ordered, ones))))))
    return 0
}
