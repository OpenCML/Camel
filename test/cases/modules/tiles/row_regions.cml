module tiles_row_regions
import { Tensor, random, seed, exp, sum, mean, max, sqrt, abs, reshape } from tensor
import { run, inspect } from tiles
func softmax(x: Tensor<f32>): Tensor<f32> {
    let e = exp(x - max(x, 1, true))
    return e / sum(e, 1, true)
}
func normalize(x: Tensor<f32>, scale: Tensor<f32>, bias: Tensor<f32>): Tensor<f32> {
    let centered = x - mean(x, 1, true)
    let variance = mean(centered * centered, 1, true)
    return centered / sqrt(variance + 0.00001) * scale + bias
}
func reused(x: Tensor<f32>): Tensor<f32> {
    let centered = x - mean(x, 1, true)
    return centered + centered * centered
}
func ordered_fallback(x: Tensor<f32>): Tensor<f32> {
    return x * 0.0 + sum(x, 1, true)
}
func main(): int sync {
    seed(161)
    let x = random([5, 257], -3.0, 3.0)
    let scale = random([1,257], 0.5, 1.5)
    let bias = random([257], -0.1, 0.1)
    println(inspect<softmax>(x))
    println(inspect<normalize>((x, scale, bias)))
    println(inspect<reused>(x))
    println(sum(abs(run<softmax>(x) - softmax(x))))
    println(sum(abs(run<normalize>((x,scale,bias)) - normalize(x,scale,bias))))
    println(sum(abs(run<reused>(x) - reused(x))))
    let small = random([1,3], -3.0, 3.0)
    println(sum(abs(run<softmax>(small) - softmax(small))))
    let tail = random([65537,2], -1.0, 1.0)
    println(sum(abs(run<reused>(tail) - reused(tail))))
    let narrow = random([3,1], -1.0, 1.0)
    println(sum(abs(run<softmax>(narrow) - softmax(narrow))))
    let wide = random([2,2049], -1.0, 1.0)
    println(sum(abs(run<reused>(wide) - reused(wide))))
    let cancellation = reshape([1267650600228229401496703205376.0, 1.0, -1267650600228229401496703205376.0, 1.0], [1,4])
    println(sum(run<ordered_fallback>(cancellation)))
    println(sum(abs(run<ordered_fallback>(cancellation) - ordered_fallback(cancellation))))
    return 0
}
