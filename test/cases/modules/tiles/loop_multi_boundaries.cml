// Unsupported loop bodies retain CPU execution between eligible regions.
module tiles_loop_multi_boundaries
import { Tensor, reshape, sum } from tensor
import { gpu, regions } from tiles

func mixed(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> {
    let pre = x + x
    let pair = loop a = pre, n = 0.0 for k in [1, 2] do (a + n, n + 1.0)
    return pair.0 * pair.0
}
func crosslane(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> {
    let pre = x + x
    let pair = loop a = pre, b = pre for k in [1, 2] do (b, a + sum(b))
    return pair.0 * pair.1
}
func differing(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> {
    let pre = x + x
    let short = reshape([1.0], [1]) as Tensor<f32, const [1]>
    let pair = loop a = pre, b = short for k in [1, 2] do (a + b, b)
    return pair.0 * pair.0
}
@gpu
func decorated(x: Tensor<f32, const [3]>): (Tensor<f32, const [3]>, Tensor<f32, const [3]>) {
    return loop a = x, b = x for k in [1, 2, 3] do (b, a + b)
}
@gpu
func decorated_mixed(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> { return mixed(x) }
@gpu
func decorated_crosslane(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> { return crosslane(x) }
@gpu
func decorated_differing(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> { return differing(x) }
func eligible(x: Tensor<f32, const [3]>): (Tensor<f32, const [3]>, Tensor<f32, const [3]>) {
    return loop a = x, b = x for k in [1, 2, 3] do (b, a + b)
}
func selected(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> {
    let pair = loop a = x, b = x for k in [1, 2, 3] do (b, a + b)
    return pair.0
}
@gpu
func decorated_selected(x: Tensor<f32, const [3]>): Tensor<f32, const [3]> {
    let pair = loop a = x, b = x for k in [1, 2, 3] do (b, a + b)
    return pair.0
}
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0], [3]) as Tensor<f32, const [3]>
    let p = eligible(x)
    let d = decorated(x)
    println(sum(p.0), sum(p.1), sum(d.0), sum(d.1))
    println(sum(mixed(x)), sum(decorated_mixed(x)))
    println(sum(crosslane(x)), sum(decorated_crosslane(x)))
    println(sum(selected(x)), sum(decorated_selected(x)))
    println(sum(differing(x)), sum(decorated_differing(x)))
    println(regions<decorated>())
    println(regions<decorated_selected>())
    return 0
}
