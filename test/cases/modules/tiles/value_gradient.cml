module tiles_value_gradient
import { reshape, sum, mean, abs, zeros } from tensor
import { with_grad } from autodiff
import { inspect, benchmark, run_preferred_resident, download } from tiles
with <x: f32[..]>
func loss(): float { return sum(x * x) }
func total(x: f32[..]): float { return sum(x) }
func average(x: f32[..]): float { return mean(x) }
func normalize(x: f32[..]): f32[..] { return x / f32(sum(x)) }
func mixed(x: f32[..]): (float, f32[..], float) { return (float(sum(x)), x + 1.0, 1.0000000000000002) }
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    let vg = (v: f32[..]): (float, f32[..]) => with_grad(loss)<v>()
    let cpu = vg(x)
    let gpu = download(run_preferred_resident<vg>(x))
    println(gpu.0 - cpu.0)
    println(sum(abs(gpu.1 - cpu.1)))
    let exact = reshape([16777216.0, 1.0] as f32[], [2])
    println(download(run_preferred_resident<total>(exact)) - 16777217.0)
    println(download(run_preferred_resident<average>(exact)) - 8388608.5)
    println(sum(abs(download(run_preferred_resident<normalize>(x)) - normalize(x))))
    let result = download(run_preferred_resident<mixed>(exact))
    println(result.0 - 16777217.0)
    println(sum(abs(result.1 - (exact + 1.0))))
    println(result.2 - 1.0000000000000002)
    println(download(run_preferred_resident<total>(zeros([0]))))
    println(inspect<mixed>(exact))
    println(benchmark<vg>(x))
    return 0
}
