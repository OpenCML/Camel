/**
 * The VJP of a conversion converts the gradient back with the core's conversion of the input's
 * element type; this derivative is the source-level witness of the compiler's handling of it. `f32(x)` on an f32 value is the documented
 * no-op, so the conversion and its gradient's conversion must alias their input: the plan of the derivative
 * below must equal, in every plan number and stage, the plan of the same derivative without the
 * cast, while its contract list still shows that the operator was seen. The printed value is
 * the f32 gradient of `sum(x)`.
 */
import { reshape, sum, abs } from tensor
import { grad } from autodiff
import { inspect } from tiles
with <x: f32[..]>
func with_cast(): float { return float(sum(f32(x))) }
with <x: f32[..]>
func without_cast(): float { return float(sum(x)) }
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    let cast_grad = (v: f32[..]): f32[..] => grad(with_cast)<v>()
    let plain_grad = (v: f32[..]): f32[..] => grad(without_cast)<v>()
    println(cast_grad(x))
    println(sum(abs(cast_grad(x) - reshape([1.0, 1.0, 1.0] as f32[], [3]))))
    println(inspect<cast_grad>(x))
    println(inspect<plain_grad>(x))
    return 0
}