import { load_npy, save_npy } from tensor
import { source, run_preferred_resident, download } from tiles
import { get_env } from env

func scalar(a: float, bias: float): float {
    return loop s = a for k in [2147483649, -2147483649, 9007199254740993, 9007199254740995] do s * 0.5 + float(k) + bias
}
func recurrence(a: f32[..], b: f32[..]): f32[..] {
    return loop s = a for k in [1, 2, 3] do s * b + a
}
func no_round(a: f32[..], b: f32[..]): f32[..] {
    let empty: int[] = []
    return loop s = a for k in empty do s * b + a
}
func rounding(a: f32[..], b: f32[..]): f32[..] {
    return loop s = a for k in [1, 2, 3] do s + b
}
func main(): int sync {
    let folder = get_env('TILES_TEST_OUT') ?? ''
    let a = load_npy::<f32>(folder + '/a.npy') as f32[..]
    let b = load_npy::<f32>(folder + '/b.npy') as f32[..]
    println(scalar(1.0, 0.25), download(run_preferred_resident<scalar>((1.0, 0.25))))
    println(scalar(3.0, -2.0), download(run_preferred_resident<scalar>((3.0, -2.0))))
    println(scalar(1.0, 0.25), download(run_preferred_resident<scalar>((1.0, 0.25))))
    save_npy(recurrence(a, b), folder + '/cpu0.npy')
    save_npy(download(run_preferred_resident<recurrence>((a, b))), folder + '/gpu0.npy')
    save_npy(recurrence(b, a), folder + '/cpu1.npy')
    save_npy(download(run_preferred_resident<recurrence>((b, a))), folder + '/gpu1.npy')
    save_npy(download(run_preferred_resident<recurrence>((a, b))), folder + '/gpu2.npy')
    save_npy(no_round(a, b), folder + '/cpu3.npy')
    save_npy(download(run_preferred_resident<no_round>((a, b))), folder + '/gpu3.npy')
    save_npy(download(run_preferred_resident<rounding>((a, b))), folder + '/gpu4.npy')
    println('LOOP_SOURCE')
    println(source<recurrence>((a, b)))
    return 0
}
