module tiles_runtime_scalars
import { Tensor, reshape, sum, abs } from tensor
import { run, run_device, download, source, inspect, benchmark } from tiles
func arithmetic(a: float, b: float): float { return (a + b) * 0.5 - a / b }
func identity(x: float): float { return x }
func scale(x: Tensor<f32>, k: float): Tensor<f32> { return x * k }
with <k: float>
func shifted(x: float): float { return x + k }
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0], [3])
    println(source<arithmetic>((1.0, 2.0)) == source<arithmetic>((16777217.0, 3.0)))
    println(source<scale>((x, 0.5)) == source<scale>((x, 1.25)))
    println(source<shifted<1.0>>(2.0) == source<shifted<3.0>>(4.0))
    println(run<arithmetic>((16777217.0, 3.0)) - arithmetic(16777217.0, 3.0))
    println(run<arithmetic>((2.0, 7.0)) - arithmetic(2.0, 7.0))
    println(run<identity>(1.0000000000000002) - 1.0000000000000002)
    println(download(run_device<identity>(1.0000000000000002)) - 1.0000000000000002)
    println(run<shifted<3.0>>(4.0) - 7.0)
    println(sum(abs(run<scale>((x, 1.25)) - x * 1.25)))
    println(inspect<scale>((x, 1.25)))
    println(benchmark<arithmetic>((5.0, 3.0)))
    println(benchmark<arithmetic>((11.0, 7.0)))
    return 0
}
