module tiles_benchmark
import { random, seed, exp, relu, sum, max } from tensor
import { benchmark } from tiles
func pipeline(x: f32[..], b: f32[..]): f32[..] {
    return exp(relu((x + b) * 0.5 - 0.25))
}
func normalize(x: f32[..]): f32[..] {
    let e = exp(x - max(x, 1, true))
    return e / sum(e, 1, true)
}
func product(x: f32[..], y: f32[..]): f32[..] { return x @ y }
func maximum(x: f32[..]): f32[..] { return max(x, -1) }
func main(): int sync {
    seed(61)
    let x = random([1024, 1024], -1.0, 1.0)
    let b = random([1, 1024], -1.0, 1.0)
    println(benchmark<pipeline>((x, b)))
    let rows = random([128, 257], -10.0, 10.0)
    println(benchmark<normalize>(rows))
    let a = random([127, 259], -1.0, 1.0)
    let w = random([259, 131], -1.0, 1.0)
    println(benchmark<product>((a, w)))
    let wide = random([128, 4097], -1.0, 1.0)
    println(benchmark<maximum>(wide))
    return 0
}
