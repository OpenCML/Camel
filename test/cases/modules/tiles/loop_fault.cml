module tiles_loop_fault
import { run_preferred_resident, download } from tiles
func divide(x: float): float {
    return loop s = 1.0 for k in [1, 2] do s / x
}
func main(): int sync {
    println('before fault once')
    println(download(run_preferred_resident<divide>(0.0)))
    println('after fault')
    return 0
}
