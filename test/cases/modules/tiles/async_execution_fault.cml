// No download observes this value: the public run_preferred_resident call itself must report its fault.
import { upload, run_preferred_resident } from tiles
func divide(a: float, b: float): float { return a / b }
func main(): int sync {
    let result = run_preferred_resident<divide>((upload(1.0), upload(-0.0)))
    println('UNREACHABLE_AFTER_DEVICE_FAULT')
    return 0
}
