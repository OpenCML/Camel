// No download observes this value: the public run_device call itself must report its fault.
module tiles_async_execution_fault
import { upload, run_device } from tiles
func divide(a: float, b: float): float { return a / b }
func main(): int sync {
    let result = run_device<divide>((upload(1.0), upload(-0.0)))
    println('UNREACHABLE_AFTER_DEVICE_FAULT')
    return 0
}
