import { reshape, sum, abs } from tensor
import { with_grad } from autodiff
import { upload, download, inspect, benchmark, run_preferred_resident } from tiles
with <x: f32[..]>
func loss(): float { return -(sum(x * x) + sum(x) * 2.0 - 1.0) / 3.0 }
func loss_value(x: f32[..]): float { return loss<x>() }
func arithmetic(a: float, b: float): float { return (a + b) * 2.0 - a / b }
func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    println(download(run_preferred_resident<loss_value>(x)) - loss<x>())
    let vg = (v: f32[..]): (float, f32[..]) => with_grad(loss)<v>()
    let cpu = vg(x)
    let gpu = run_preferred_resident<vg>(upload(x))
    println(download(gpu.0) - cpu.0)
    println(sum(abs(download(gpu.1) - cpu.1)))
    let a = upload(16777217.0)
    let b = upload(2.0)
    println(download(run_preferred_resident<arithmetic>((a, b))) - arithmetic(16777217.0, 2.0))
    println(download(run_preferred_resident<arithmetic>((a, b))) - arithmetic(16777217.0, 2.0))
    println(inspect<arithmetic>((a, b)))
    println(benchmark<arithmetic>((a, b)))
    return 0
}
