// Public device operations return completed values, including identities and empty views.
module tiles_async_execution
import { load_npy, save_npy, zeros } from tensor
import { Device, upload, download, run_preferred_resident } from tiles
import { get_env } from env
func step(x: f32[..]): f32[..] { return x * 2.0 + 1.0 }
func identity(x: f32[..]): f32[..] { return x }
func pair(x: f32[..]): (f32[..], f32[..], f32[..]) {
    let y = x * 2.0 + 1.0
    return (y, x, y)
}
func chain(x: Device<f32[..]>, n: int): Device<f32[..]> {
    return if n == 0 then x else chain(run_preferred_resident<step>(x), n - 1)
}
func main(): int sync {
    let folder = get_env('TILES_TEST_OUT')
    let x = load_npy::<f32>(folder + '/x.npy') as f32[..]
    let d = upload(x)
    let first = run_preferred_resident<step>(d)
    save_npy(download(chain(first, 3)), folder + '/chain.npy')
    save_npy(download(first), folder + '/first.npy')
    save_npy(download(d), folder + '/original.npy')
    let r = run_preferred_resident<pair>(d)
    save_npy(download(r.0), folder + '/pair0.npy')
    save_npy(download(r.1), folder + '/pair1.npy')
    save_npy(download(r.2), folder + '/pair2.npy')
    save_npy(download(run_preferred_resident<identity>(r.1)), folder + '/identity.npy')
    save_npy(download(run_preferred_resident<identity>(upload(zeros([0, 3])))), folder + '/empty.npy')
    println('ASYNC_PUBLIC_COMPLETE')
    return 0
}
