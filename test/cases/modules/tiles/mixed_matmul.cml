import { ones, reshape, sum, abs, randn, seed, set_num_threads } from tensor
import { inspect, run_preferred_resident, download } from tiles
import { exit } from process

#[reassociate, change_precision, finite_math]
func mixed(a: f32[..], b: f32[..]): f32[..] { return a @ b }
func strict(a: f32[..], b: f32[..]): f32[..] { return a @ b }
#[change_precision]
func incomplete(a: f32[..], b: f32[..]): f32[..] { return a @ b }

func main(run_gpu: bool): int sync {
    set_num_threads(1)
    let a = ones::<f32>([256, 256]) * 1.00390625
    let eye = reshape<[256, 256]>(0..65536->map<(i: int): f32 => if i / 256 == i % 256 then 1.0 else 0.0>)
    println(inspect<mixed>((a, eye)))
    println(inspect<incomplete>((a, eye)))
    println(inspect<strict>((a, eye)))
    if run_gpu then sync {
        let m = download(run_preferred_resident<mixed>((a, eye)))
        let f = download(run_preferred_resident<strict>((a, eye)))
        let mixed_error = sum(abs(m - 1.0))
        let strict_error = sum(abs(f - a))
        let difference = sum(abs(m - f))
        println('MIXED bf16_error={} fp32_error={} precision_difference={}'->format<mixed_error, strict_error, difference>)
        if mixed_error > 0.0001 || strict_error != 0.0 || difference < 1.0 then sync { exit(1) }
        seed(31415)
        let left = randn([2, 1, 3, 5])
        let right = randn([1, 4, 5, 7])
        let reference = strict(left, right)
        let relative = sum(abs(download(run_preferred_resident<mixed>((left, right))) - reference)) / sum(abs(reference))
        println('MIXED broadcast_relative_error={}'->format<relative>)
        if relative > 0.02 then sync { exit(1) }
    }
    println('MIXED CHECKS PASS')
    return 0
}
