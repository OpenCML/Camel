module mixed_checks
import { Tensor, ones, reshape, sum, abs, randn, seed, set_num_threads } from tensor
import { run, inspect } from tiles

#[reassociate, change_precision, finite_math]
func mixed(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a @ b }
func strict(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a @ b }
#[change_precision]
func incomplete(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a @ b }

func main(run_gpu: bool): int sync {
    set_num_threads(1)
    let a = ones([256, 256]) * 1.00390625
    let eye = reshape(range(0, 65536)->map<(i: int): float => if i / 256 == i % 256 then 1.0 else 0.0>, [256, 256])
    println(inspect<mixed>((a, eye)))
    println(inspect<incomplete>((a, eye)))
    println(inspect<strict>((a, eye)))
    if run_gpu then sync {
        let m = run<mixed>((a, eye))
        let f = run<strict>((a, eye))
        let mixed_error = sum(abs(m - 1.0))
        let strict_error = sum(abs(f - a))
        let difference = sum(abs(m - f))
        println('MIXED bf16_error={} fp32_error={} precision_difference={}'->format<mixed_error, strict_error, difference>)
        if mixed_error > 0.0001 || strict_error != 0.0 || difference < 1.0 then sync { exit(1) }
        seed(31415)
        let left = randn([2, 1, 3, 5])
        let right = randn([1, 4, 5, 7])
        let reference = strict(left, right)
        let relative = sum(abs(run<mixed>((left, right)) - reference)) / sum(abs(reference))
        println('MIXED broadcast_relative_error={}'->format<relative>)
        if relative > 0.02 then sync { exit(1) }
    }
    println('MIXED CHECKS PASS')
    return 0
}
