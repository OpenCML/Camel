import { reshape } from tensor
func chain(x: f32[3]): f32[3] {
    let doubled = x + x
    return doubled * doubled
}
func captured(w: f32[3]): f32[3] {
    let f = (x: f32[3]): f32[3] => x + w
    return f(w)
}
func main(): int sync {
    let a = reshape([1.0, 2.0, 3.0] as f32[], [3]) as f32[3]
    let b = reshape([4.0, 5.0, 6.0] as f32[], [3]) as f32[3]
    println(chain(a))
    println(captured(a))
    println(captured(b))
    println(chain(b))
    println(chain(a))
    return 0
}
