import { load_npy, save_npy, sqrt } from tensor
import { run_preferred_resident, download } from tiles
import { get_env } from env
func arithmetic(a: f32[..], b: f32[..]): (f32[..], f32[..], f32[..], f32[..], f32[..], f32[..]) {
    return (a + b, a - b, a * b, a / b, sqrt(a), a * b + a)
}
func main(): int sync {
    let folder = get_env('TILES_TEST_OUT')
    let a = load_npy::<f32>(folder + '/a.npy') as f32[..]
    let b = load_npy::<f32>(folder + '/b.npy') as f32[..]
    let cpu = arithmetic(a, b)
    let gpu = download(run_preferred_resident<arithmetic>((a, b)))
    save_npy(cpu.0, folder + '/cpu0.npy')
    save_npy(cpu.1, folder + '/cpu1.npy')
    save_npy(cpu.2, folder + '/cpu2.npy')
    save_npy(cpu.3, folder + '/cpu3.npy')
    save_npy(cpu.4, folder + '/cpu4.npy')
    save_npy(cpu.5, folder + '/cpu5.npy')
    save_npy(gpu.0, folder + '/gpu0.npy')
    save_npy(gpu.1, folder + '/gpu1.npy')
    save_npy(gpu.2, folder + '/gpu2.npy')
    save_npy(gpu.3, folder + '/gpu3.npy')
    save_npy(gpu.4, folder + '/gpu4.npy')
    save_npy(gpu.5, folder + '/gpu5.npy')
    return 0
}
