import { sum, abs, transpose, permute, dim, reshape, zeros } from tensor
import { next_key, seed, uniform } from random
import { run_preferred_resident, download } from tiles

func trans(x: f32[..]): f32[..] { return transpose(x) }
func axes(x: f32[..]): f32[..] { return permute<[-1, 0, 1]>(x) }
// The last axis, from its seventh-from-last position up to its last, every second one: the count
// from the end the rule deletes (`slice(x, -1, -6, -1, 2)`), written with the positive positions
// it stands for -- `dim(x, 2)` is the length of that axis (7 for the [2, 3, 7] input) and the end
// of a slice is one past the last position taken.
func crop(x: f32[..]): f32[..] {
    return slice(x, 2, dim<2>(x) - 6, dim<2>(x) - 1, 2)
}
func chain(x: f32[..]): f32[..] {
    return reshape<[6, 3]>(slice(permute<[2, 0, 1]>(x), 0, 1, 6, 2)) + 2.0
}
func empty(x: f32[..]): f32[..] { return slice(x, 2, 7, 7) }
func main(): int sync {
    seed(47)
    let x = (next_key()->uniform::<f32><shape: [2, 3, 7]> * 10.0 - 5.0)
    println(sum(abs(download(run_preferred_resident<trans>(x)) - trans(x))))
    println(sum(abs(download(run_preferred_resident<axes>(x)) - axes(x))))
    println(sum(abs(download(run_preferred_resident<crop>(x)) - crop(x))))
    println(sum(abs(download(run_preferred_resident<chain>(x)) - chain(x))))
    println(sum(download(run_preferred_resident<empty>(x))))
    println(sum(download(run_preferred_resident<trans>(zeros::<f32>([2, 0, 7])))))
    return 0
}
