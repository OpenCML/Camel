// Positional applicability is observable independently of arithmetic equality.
import { Node, Op, graph_of, nodes, is_anchor } from graph
import { max } from math
import { Rule, Run, rewrite, run, saturate, extract, why_not } from rewrite

fact height: int match v {
    case x + y => max(height(x), height(y)) + 1
    case _ => 0
}
join max
rule rotate(a: int, b: int, c: int) when height(a) > max(height(b), height(c)) { (a + b) + c => a + (b + c) }
rule nested(a: int, b: int) { (a + 0) * b => a * b }
rule repeated(a: int, b: int) { (a + b) - a => b }
rule combine(a: int) { (a + 0) + 1 => a + 1 }
rule commute(a: int, b: int) { a + b <=> b + a }
func guard_search(p: int, q: int, r: int, s: int): int {
    return (p + (q + r)) + s
}
func nested_target(x: int, y: int): int {
    return (0 + x) * y
}
func repeated_swapped(x: int, y: int): int {
    return (x + y) - y
}
func repeated_shared(x: int): int {
    return (x + x) - x
}
func repeated_distinct(x: int, y: int, z: int): int {
    return (x + y) - z
}
func chain(x: int, y: int): int {
    return (x + 1) + 0
}
func sum(x: int, y: int): int {
    return x + y
}
func graph_height::<F>(f: F): int {
    return nodes(graph_of(f))->map<(n: Node): int => height(n)>->reduce<max, 0>
}
func height_cost(o: Op, inputs: float[]): float {
    return 1.0 + inputs->reduce<max, 0.0>
}
with <ordered: bool>
func report::<F>(f: F, rules: Rule[], label: string): int sync {
    return match f->run<rules, rounds: 1, explain: true, ordered: ordered> {
        case error e => sync {
            println(e.message)
            return -1
        }
        case r => sync {
            println(label, r.rewrites, graph_height(r.result))
            return 0
        }
    }
}
func main(): int! sync {
    report<true>(guard_search, [rotate], 'guard ordered')
    report<false>(guard_search, [rotate], 'guard default')
    println(match guard_search->run<[rotate], rounds: 1> {
        case error e => e.message
        case r => format<r.rewrites, graph_height(r.result)>('guard omitted {} {}')
    })
    report<true>(nested_target, [nested], 'nested ordered')
    report<false>(nested_target, [nested], 'nested default')
    report<true>(repeated_swapped, [repeated], 'repeated swapped ordered')
    report<false>(repeated_swapped, [repeated], 'repeated swapped default')
    report<true>(repeated_shared, [repeated], 'repeated shared ordered')
    report<true>(repeated_distinct, [repeated], 'repeated distinct ordered')
    report<true>(chain, [combine], 'chain ordered')
    report<false>(chain, [combine], 'chain default')
    println(match guard_search->rewrite<[rotate], ordered: true> {
        case error e => e.message
        case f => format<graph_height(f), f(1, 2, 3, 4)>('rewrite ordered {} {}')
    })
    println(match guard_search->rewrite<[rotate]> {
        case error e => e.message
        case f => format<graph_height(f), f(1, 2, 3, 4)>('rewrite default {} {}')
    })
    println(match guard_search->saturate<[rotate], rounds: 1, ordered: true>->extract<height_cost> {
        case error e => e.message
        case f => format<graph_height(f), f(1, 2, 3, 4)>('saturate ordered {} {}')
    })
    println(match guard_search->saturate<[rotate], rounds: 1>->extract<height_cost> {
        case error e => e.message
        case f => format<graph_height(f), f(1, 2, 3, 4)>('saturate default {} {}')
    })
    println(match sum->saturate<[commute], rounds: 1, ordered: true> {
        case error e => e.message
        case f => format<len(nodes(graph_of(f))) > len(nodes(graph_of(sum)))>('explicit commute {}')
    })
    println(match sum->rewrite<[commute], ordered: true> {
        case error e => e.kind
        case f => 'unexpected success'
    })
    println(match sum->run<[commute], ordered: true> {
        case error e => e.kind
        case r => 'unexpected success'
    })
    return 0
}
