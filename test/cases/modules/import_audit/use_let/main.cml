/**
 * The other direction of the same ruling: naming the module's top-level `let` is a dependency,
 * and the value is evaluated (design principles 3.1: a module-level `let` is a root-graph node,
 * evaluated when depended on). The flag file is not asserted *before* the use — a root-graph node
 * has no ordering against the importing function's first effects (3.3 orders effects within one
 * function body; a value crossing the call is not an effect pair), so only the state after the
 * value is named is the contract. H222.
 *
 * The module it imports is `../lazy_let/lazy_let_writer.cml`; a copy named for this case keeps the
 * two programs independent.
 */
module use_let_main

import { get_env } from env
import { exists } from fs
import { wrote } from use_let_writer

func main(): int sync {
    let path = get_env('CAMEL_TEST_TMPDIR') + '/h222_use_let_flag.txt'
    wrote
    println("after use, flag exists =", exists(path))
    return 0
}