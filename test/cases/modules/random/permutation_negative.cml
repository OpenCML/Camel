/**
 * permutation with a negative length is a located InvalidArgument (design principles 3.9); the
 * length is a run-time value here, so the fault happens at the call.
 */
module permutation_negative

import { key, permutation } from random

func permute(n: int): int[] {
    return permutation(key(1), n)
}

func main(): int sync {
    let empty = permute(0)
    'permutation empty={}'->format<empty>->println
    let bad = permute(-1)
    return 0
}