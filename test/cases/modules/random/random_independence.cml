/**
 * keyed random does not touch the generator: the draws around a key/split/permutation are the
 * same as the draws alone, and seeding again repeats them.
 */
module random_independence

import { seed, rand, key, split, permutation } from random

func main(): int sync {
    seed(7)
    let first = rand()
    let k = key(42)
    let (a, b) = split(k)
    let order = permutation(k, 5)
    let second = rand()
    seed(7)
    let again = rand()
    'random_independence first={} second={} again={} same={} keyed={} {} {}'->format<first, second, again, first == again, k, a, b>->println
    'random_independence order={} repeat={}'->format<order, permutation(k, 5)>->println
    return 0
}