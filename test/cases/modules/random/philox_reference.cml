/**
 * The keyed draws against a reference written outside the compiler (the plan's verify script
 * computes Philox4x32-10 again from the published constants and checks it against the Random123
 * known answers first). One line per group:
 *   fold      the third key derived from key(42)
 *   uniform   a float, an f32, an f16 and a bf16 drawn from key(42)
 *   randint   two integers drawn from key(42), one on a wide range
 *   stream    after seed(7): two keys and a rand()
 *   normal    a float and an f32 drawn from the normal distribution of key(42)
 *   permutation  the permutation of 8, of 0 and of -3
 *   array     key(42)'s whole-array draw of shape [2, 3], then the scalar draws of the keys it folds
 */
module philox_reference

import {
    key, fold, uniform, normal, randint, permutation, seed, next_key, rand, uniform_array, normal_array
} from random

func main(): int sync {
    let k = key(42)
    println('fold', fold(k, 3))
    println('uniform', uniform::<float>(k), uniform::<f32>(k), uniform::<f16>(k), uniform::<bf16>(k))
    println('randint', k->randint<1, 7>, k->randint<0, 1000000007>)
    seed(7)
    let first = next_key()
    let second = next_key()
    println('stream', first, second, rand())
    println('normal', normal::<float>(k), normal::<f32>(k), k->normal_array::<float><shape: [3]>)
    println('permutation', permutation(k, 8), permutation(k, 0), permutation(k, -3))
    println('array', k->uniform_array::<f32><shape: [2, 3]>)
    println('scalars', uniform::<f32>(fold(k, 0)), uniform::<f32>(fold(k, 1)), uniform::<f32>(fold(k, 5)))
    return 0
}
