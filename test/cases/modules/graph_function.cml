import { Node, Graph, nodes, inputs, op, op_name, constant, open, commit, replace, graph_of, name } from graph

func target(x: int) => int {
    return (x + 0) * 3
}

func opText(n: Node) => string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func isZero(n: Node) => bool {
    return match constant::<int>(n) {
        case null => false
        case v => v == 0
    }
}

func isAddZero(n: Node) => bool spelling {
    let ins = inputs(n)
    return opText(n) == ':op/add_l' && len(ins) == 2 && isZero(ins[1])
}

func adds(f: (x: int) => int) => int {
    return len(nodes(graph_of(f))->filter<isAddZero>)
}

func main() => int spelling sync {
    println(name(graph_of(target)))
    println(adds(target))
    let d = open(target)
    nodes(d)->filter<isAddZero>->foreach<func (n: Node) {
        replace(n, inputs(n)[0])
    }>
    let g = commit::<(x: int) => int>(d) !! target
    println(adds(g))
    println(g(5))
    println(target(5))
    return 0
}
