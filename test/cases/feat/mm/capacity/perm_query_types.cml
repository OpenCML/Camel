/**
 * A program whose rewrite filled the permanent space (types and layouts) although neither the
 * program nor its graphs grew: under `std::opt::specialize std::opt` the rewrites ask, for every
 * user of every value and again after every inlined call, whether an argument is passed to a
 * var parameter; each question resolved the operator's overload, and each resolution left a
 * new function type in the permanent space, which never releases (1.4 million types, more than
 * 256 MB, where the run without passes takes 77 KB). The answers are kept per operator and
 * argument types now (camel::runtime::operatorOverloadType).
 * Generated by test/tools/progen (seed 3293, all features, generator version 1); the same
 * defect is archived reduced as progen finding F34.
 * Environment: PROGEN_I0=4 PROGEN_I1=5
 * Expected output:
 *   L3 (0, -21) (0, -21)
 *   L5 (6, -21) 4
 *   L6 [-2, -2, -2, -2, -2, -2] 4
 *   L7 5
 *   L8 (a, -21)
 */
module perm_query_types

import { get_env } from env

type P = { x: int, y: int }

type Q = { n: int, tag: string, w: float }

func r1(a2: int, a3: float): float {
    return if (a2 <= 0) then a3 else r1(a2 - 1, match a2 {
        case -1 => 4.75
        case 0 => 0.25
        case 5 => {
            let n4 = if true then 0.5 else 4.75;
            return n4;
        }
        case _ => 2.5
    });
}

func r5(a6: int, a7: float, a8: float): float {
    return if (a6 <= 1) then a8 else {
        let n9 = r5(a6 - 1, 0.25, a8);
        let n10 = r5(a6 - 2, r1(9, -4.75), a8);
        return [3, a6, 10]->reduce<(p11: float, p12: int): float => if false then n10 else n9, a8>;
    };
}

func f13(a14: int[], a15: (a0: bool, a1: float) => float): int {
    return (-7) * 3;
}

func e16(var c17: int[]): float sync {
    (if true then {
        let n18 = r5(2, 1.5, 2.0);
        return [3, 1, 12, 4];
    } else [4, 4, 3])->foreach<sync (p19: int) => sync {
        c17 = concat(c17, [f13([10, p19], (p20: bool, p21: float): float => r1(6, p21))]);
    }>;
    func g22(a23: int, a24: bool): int sync {
        println('L1 {}'->format<a24>);
        c17 = concat(c17, [c17[1] + (if (len(c17) > 1) then c17[1] else 4)]);
        return (if a24 then ['cd', 'yz'] else ['b'])->reduce<(p25: int, p26: string): int => [-0.5, 3.0]->reduce<(p27: int, p28: float): int => if a24 then 100 else p25, 31>, a23>;
    };
    return (0.0 * 0.25) / 2.0;
}

func w29(a30: int, var c31: int): int sync {
    return if (a30 <= 0) then sync {
        c31 = f13([a30, 7, 2], (p32: bool, p33: float): float => p33) % 1000;
        return match a30 {
            case 0 => -7
            case _ => a30
        };
    } else sync {
        c31 /= -2;
        println('L2 {} {} {}'->format<c31, a30, match a30 {
            case 10 => 1.0
            case _ => 2.5
        }>);
        let n34 = w29(a30 - 1, c31);
        c31 -= n34 * 3;
        return n34 + 0;
    };
}

func main(): int sync {
    let n35 = int(get_env('PROGEN_I0') ?? '');
    let n36 = int(get_env('PROGEN_I1') ?? '');
    let n38 = (if (if false then true else false) then concat([n36, 5, n36, n35], [n35]) else concat([n35, n36, -7, n36], [n35, n36]))->map<(p37: int): int => -2>;
    var v41 = (match n36 {
        case -1 => 4
        case _ => 0
    }, f13(n38, (p39: bool, p40: float): float => p40 - 4.75));
    if (!false) || (false || true) then sync {
        println('L3 {} {}'->format<v41, v41>);
        v41 = (len(n38), v41.1);
        null;
    } else sync {
        println('L4 {} {}'->format<n36, v41>);
        let h44 = (p42: int): int => sync {
            let n43 = { n: 100, tag: 'b' + 'm', w: 10.0 };
            return match n35 {
                case 1 => -1
                case _ => n36
            };
        };
        null;
    };
    println('L5 {} {}'->format<v41, n35>);
    v41 = (if false then v41 else (n36, 31));
    let n48 = match n35 {
        case 5 => if true then 7 else n35
        case _ => sync {
            let n47 = match n35 {
                case 1 => string(10)
                case _ => {
                    let n45 = true;
                    return ([false, true, n45]->map<(p46: bool): string => 'r:{},{:.1f}{},'->format<'pq', 0.5, n35>>)->join<''>;
                }
            };
            return n36 % 10;
        }
    };
    let n53 = if (n36 < 12) && (1.5 >= 2.5) then if false then ('b', -2) else {
        let n49 = if true then [{ x: n35, y: 0 }, { x: n35, y: n48 }] else [{ x: n48, y: 1 }, { x: n35, y: -7 }];
        let n50 = if true then (0.5, n38) else (1.0, [-2]);
        return if true then ('ab', n35) else ('cd', n35);
    } else (if true then 'a' else 'b', f13([n48, 5], (p51: bool, p52: float): float => p52));
    println('L6 {} {}'->format<n38, n35>);
    println('L7 {}'->format<n48>);
    println('L8 {}'->format<n53>);
    return 0;
}
