/**
 * Expressions the front end writes twice: test::writings finds that the two writings of
 * `a + 1` are one value, and what follows from merging two parameters.
 */
module congruence

func f(a: int, b: int): int {
    let p = a + 1
    let q = b + 1
    let r = a + 1
    return p * q + r
}

func main(): int sync {
    println(f(2, 3))
    return 0
}
