/**
 * Pacing of collections by large-object volume: one array of 40 MB stays alive while 200
 * temporary arrays of 0.8 MB each (160 MB in all) are allocated and dropped, one per call.
 * How often the allocator asks for a collection, and how much the large-object space holds at
 * most, depend only on the growth setting (CAMEL_GC_GROWTH_PERCENT); the plan reads both from
 * the statistics line (CAMEL_GC_STATS).
 */
module gc_large_pacing

func churn(keep: int[], i: int, acc: int): int sync {
    return if i <= 0 then acc + len(keep) else {
        let tmp = range(0, 100000)
        return churn(keep, i - 1, acc + len(tmp))
    }
}

func main(): int sync {
    let keep = range(0, 5000000)
    let total = churn(keep, 200, 0)
    'gc_large_pacing total={}'->format<total>->println
    return 0
}
