/**
 * Two `Context`s in one process, and the process-level state of the allocator (C24, MG/R1).
 *
 * The allocator is one per process; the object root set and the graph sweeper belong to one
 * `Context` each. `test::contexts` creates a second context beside the running one, collects the
 * heap while both are alive, destroys the second one and reads what the allocator holds again.
 * The program then has to run on to the back end and print its line: a collection that marked only
 * the second context's roots would have swept the static data this run reaches through its own
 * graphs.
 */

func label(i: int): string {
    return if i == 0 then 'contexts' else label(i - 1) + '-' + string(i)
}

func main(): int sync {
    println(label(3))
    return 0
}