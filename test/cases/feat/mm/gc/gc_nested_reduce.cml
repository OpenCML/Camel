/**
 * reduce nested with map both ways, with allocation in the element function, repeated `reps`
 * times (--arg reps=N); about 100 repetitions fill the elder space (32 MB) more than once.
 *   sums: a reduce inside a map element, over a row built there;
 *   shifted: a reduce whose accumulator is an array that every step rebuilds with map.
 * The innermost functions call a named function, so that every scheduler reaches a safepoint
 * while the arrays built in the element function are still in use.
 *
 * The seed of `shifted` is an array, because `reduce`'s accumulator is one: `to_array` is the one
 * conversion from the interval `0 .. n` (a Range) to the integers it names (design principles
 * 5.4). The interval rewrite wrote the seed as `0 .. n`, which is a Range and so names no
 * instance of `reduce`; the only plan that names this file is milestone-tier, so no routine run
 * compiled it and the mismatch stood.
 */

func add(a: int, b: int) => int {
    return a + b
}

func sums(n: int, k: int) => int[] {
    return (0 .. n)->map<func (i: int) => int {
        (0 .. n)->map<func (j: int) => int {
            i + j + k
        }>->reduce<func (acc: int, x: int) => int {
            add(acc, x)
        }, 0>
    }>
}

func shifted(n: int, k: int) => int[] {
    return (0 .. n)->reduce<func (acc: int[], i: int) => int[] {
        acc->map<func (x: int) => int {
            add(x, i + k)
        }>
    }, to_array(0 .. n)>
}

func total_of(xs: int[]) => int {
    return xs->reduce<func (acc: int, x: int) => int {
        acc + x
    }, 0>
}

func repeat(n: int, left: int, total: int) => int {
    return if left == 0 then total else repeat(n, left - 1, total + total_of(sums(n, left)) + total_of(shifted(n, left)))
}

func main(reps: int) => int sync {
    println('gc_nested_reduce total={}'->format<repeat(128, reps, 0)>)
    return 0
}
