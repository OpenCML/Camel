/**
 * reduce nested with map both ways, with allocation in the element function, repeated `reps`
 * times (--arg reps=N); about 100 repetitions fill the elder space (32 MB) more than once.
 *   sums: a reduce inside a map element, over a row built there;
 *   shifted: a reduce whose accumulator is an array that every step rebuilds with map.
 * The innermost functions call a named function, so that every scheduler reaches a safepoint
 * while the arrays built in the element function are still in use.
 */

func add(a: int, b: int): int {
    return a + b
}

func sums(n: int, k: int): int[] {
    return (0..n)->map<(i: int): int => (0..n)->map<(j: int): int => i + j + k>->reduce<(acc: int, x: int): int => add(acc, x), 0>>
}

func shifted(n: int, k: int): int[] {
    return (0..n)->reduce<(acc: int[], i: int): int[] => acc->map<(x: int): int => add(x, i + k)>, 0..n>
}

func total_of(xs: int[]): int {
    return xs->reduce<(acc: int, x: int): int => acc + x, 0>
}

func repeat(n: int, left: int, total: int): int {
    return if left == 0
        then total
        else repeat(n, left - 1, total + total_of(sums(n, left)) + total_of(shifted(n, left)))
}

func main(reps: int): int sync {
    println('gc_nested_reduce total={}'->format<repeat(128, reps, 0)>)
    return 0
}
