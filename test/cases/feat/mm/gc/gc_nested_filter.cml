/**
 * filter nested with map both ways, with allocation in the element function, repeated `reps`
 * times (--arg reps=N); about 100 repetitions fill the elder space (32 MB) more than once.
 *   rows: a filter inside a map element, over a row built there;
 *   kept: a filter whose predicate builds a row with map and sums it.
 * The innermost functions call a named function, so that every scheduler reaches a safepoint
 * while the arrays built in the element function are still in use.
 */
module gc_nested_filter

type Row = int[]

func is_even(x: int): bool {
    return x % 2 == 0
}

func total_of(xs: int[]): int {
    return xs->reduce<(acc: int, x: int): int => acc + x, 0>
}

func rows(n: int, k: int): Row[] {
    return range(0, n)->map<(i: int): int[] => range(0, n)->map<(j: int): int => i + j + k>->filter<(x: int): bool => is_even(x)>>
}

func probe_rows(t: Row[], n: int): int {
    return range(0, n)
        ->map<(i: int): int => len(t[i]) + t[i][0] + t[i][len(t[i]) - 1]>
        ->reduce<(acc: int, x: int): int => acc + x, 0>
}

func kept(n: int, k: int): int[] {
    return range(0, n)->filter<(i: int): bool => {
        let row = range(0, n)->map<(j: int): int => i + j + k>
        return total_of(row) % 3 == 0
    }>
}

func repeat(n: int, left: int, total: int): int {
    return if left == 0
        then total
        else repeat(n, left - 1, total + probe_rows(rows(n, left), n) + len(kept(n, left)) + total_of(kept(n, left)))
}

func main(reps: int): int sync {
    println('gc_nested_filter total={}'->format<repeat(128, reps, 0)>)
    return 0
}
