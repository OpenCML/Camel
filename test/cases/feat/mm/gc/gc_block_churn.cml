/**
 * Block churn with nothing kept: `steps` temporary arrays of `temp` elements each are allocated
 * and dropped, one per step, so every byte of block data is garbage as soon as the next step
 * starts. The collector has to release it: the high-water mark is one pacing window plus one
 * block (2.4 MB blocks, 3.6 MB window: 7.2 MB), not the volume the program allocates, and it does
 * not grow with the number of steps. `dropped` counts the samples in which the live block bytes
 * fell, that is, a collection released blocks.
 */

func main(steps: int, temp: int): int sync {
    let start = std::mem::blocks()
    let (iLeft, peak, low, prev, released, dropped, total) = loop i = steps, peak = 0, low = 1000000000000, prev = 0, released = 0, dropped = 0, total = 0 while i > 0 do {
        let tmp = 0..temp
        let now = std::mem::blocks()
        let bytes = now.bytes
        let n = len(tmp)
        (i - 1, if bytes > peak then bytes else peak, if bytes < low then bytes else low, bytes, now.frees - start.frees, if bytes < prev then dropped + 1 else dropped, total + n)
    }
    println('gc_block_churn base={} peak={} low={} dropped={} released={} total={}'->format<0, peak, low, dropped, released, total>)
    return 0
}