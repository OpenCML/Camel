/**
 * One block reached through two views is one block of pressure. `zeros` builds an array with a
 * data block; `reshape` returns a second array that shares that block. Both survive the minor
 * collections that promote them, so the promoted-block budget sees the block twice if it counts
 * per value instead of per block. The block is 3,000,000 bytes and the budget floor is 4 MB: if
 * it is counted once no major collection is asked for, if twice (6 MB) one is. The plan asserts
 * the collection count (`major=0`) rather than a timing.
 */

import { reshape, zeros, numel } from tensor

func main(steps: int, temp: int): int sync {
    let a = zeros([750000])
    let b = reshape(a, [750000])
    let (iLeft, peak, total, x, y) = loop i = steps, peak = 0, total = 0, x = a, y = b while i > 0 do {
        let tmp = 0..temp
        let now = std::mem::blocks()
        let bytes = now.bytes
        (i - 1, if bytes > peak then bytes else peak, total + len(tmp), x, y)
    }
    println('gc_block_views peak={} total={} keep={} {}'->format<peak, total, numel(x), numel(y)>)
    return 0
}