/**
 * Heap-heavy GC diagnostic workload covering arrays, structs, strings, closures, and mutation.
 *
 * The two arrays are built with `map` rather than with a `foreach` whose body appends to a captured
 * `var`: a closure may not assign an outer name (the rule, design principles 3.5).
 * `map` calls the element function once per element, in order, so the arrays are the same ones.
 */

type Box = {
    label: string,
    values: int[]
}

func score(box: Box) => int {
    return box.values[0] + box.values[1] + len(box.label)
}

with <fn: (x: int) => int>
func map_one(xs: int[]) => int[] sync {
    return xs->map<func (x: int) => int {
        fn(x)
    }>
}

func main() => int sync {
    let boxes = (0 .. 16)->map<func (i: int) => Box {
        let vals = [i, i + 1, i + 2]
        return { label: 'box{}'->format<i>, values: vals }
    }>
    
    let first = boxes[0]
    let last = boxes[15]
    let offset = score(first)
    let mapped = [1, 2, 3, 4]->map_one<func (x: int) => int {
        return x + offset
    }>
    let mapped3 = mapped[3]
    
    'gc_heap boxes={} first={} last={} mapped3={}'->format<len(boxes), score(first), score(last), mapped3>->println
    return 0
}
