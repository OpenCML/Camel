
import { abs, conj, exp, im, nan, re } from math

func negate(x: float): float { return -x }

// Complex numbers: imaginary literals, the two types, arithmetic, printing and the accessors
// (design principles 5.1 and 10.5).
func main(): int sync {
    // With no context an imaginary literal is a c128; both parts print.
    let a = 3 + 4i
    println(a)
    println(4.5i)
    println(-2i)
    println(a + 1i)
    println((1 + 2i) * (3 + 4i))
    println(1i * 1i)
    println(a == 3 + 4i)
    println(a == 3 + 5i)
    println(a != 3 + 5i)

    // A declared type decides the width: the literal becomes c64 exactly.
    let z: c64 = 1 + 2i
    println(z)
    println(z + z)
    println(z * z)
    println(z / z)
    println(-z)
    println(c64(2))
    println(c128(z))

    // An array of complex numbers is compact: each element is two parts, read back as a value.
    let xs = [1 + 2i, 3 + 4i]
    println(xs)
    println(xs[0] + xs[1])

    // A compact `c64` element is eight bytes and is not one slot, so the class an array loop
    // hoists is the slow one, which reads and writes the element through its bytes
    // (`rtdata/array.h`, elementRead/elementWrite): a loop that took the eight bytes for a slot
    // handed the complex operator the two f32 parts of 1 + 2i where a `Complex *` is due, and
    // stored a pointer into the element's bytes.
    let z0: c64 = 1 + 2i
    let z1: c64 = 3 + 4i
    let zs: c64[] = [z0, z1]
    println(zs->map<(w: c64) => w * z>)
    println(zs->map<(w: c64) => w + z0>)
    println(zs->filter<(w: c64) => re(w) > 1.0>)
    println(zs->reduce<(s: c64, w: c64) => s + w, c64(0)>)

    // A compact aggregate with a complex field: the tuple's bytes hold both parts, and the
    // array of tuples is one run of them.
    let ts = [(1 + 2i, 3), (3 + 4i, 5)]
    println(ts)

    // abs, re, im, conj and exp.
    println(abs(3 + 4i))
    println(re(3 + 4i))
    println(im(3 + 4i))
    println(conj(3 + 4i))
    println(exp(0 + 1i))

    // A NaN part has no sign in text (language reference 2.5.2, 2.5.3), with or without a
    // specification: a computed negative NaN in the real part, and one in the imaginary part.
    let bad = negate(nan)
    let mixed = c128(bad) + 4i
    println(mixed)
    println<'{:.2f}'>(mixed)
    println<'{:>12.2f}'>(mixed)
    let twisted = c128(bad) * 1i
    println(twisted)
    println<'{:.2f}'>(twisted)
    return 0
}