/**
 * The Camel side of the Python binding test: what a Python caller reaches through
 * `camel.load`.
 *
 * Three kinds of result are here on purpose. `identity` gives the array it was handed back
 * unchanged, so the capsule the caller gets has to name the caller's own memory: that is what
 * "no copy" means, and it is the only direction an address can prove. `scale` builds a new array,
 * so it is the copy the zero-copy one is measured against. `checked_scale` fails, so the Python
 * side has an error value to turn into an exception with a position.
 *
 * Nothing here imports a standard library module: the functions a Python project calls are the
 * ones it wrote, and a test of the binding should not also be a test of the module search path.
 */

/// The array it was given. The block is the caller's: nothing is allocated and nothing is copied,
/// which is what the caller asserts by comparing the two data pointers.
export func identity(xs: f32[]): f32[] {
    return xs
}

/// A new array: every element multiplied by `k`. A block of its own.
export func scale(xs: f32[], k: f32): f32[] {
    return xs->map<(v: f32): f32 => v * k>
}

/// A number rather than an array: the sum of the squares, accumulated in f64.
export func energy(xs: f32[]): float {
    return loop total = 0.0 for v in xs do total + float(v) * float(v)
}

/// An error value: a negative factor gives a Python exception whose file, line and column are
/// the position the error value records (design principles 3.9).
export func checked_scale(xs: f32[], k: f32): f32[]! {
    return if k < 0.0 then {
        return error('RangeError', 'the factor must not be negative')
    } else {
        return xs->map<(v: f32): f32 => v * k>
    }
}