/**
 * A `constas` value may be a string: the value is not read by a type, only by the body, and it
 * is part of the instance key. `label("w", 1)` and `label("h", 2)` are two instances,
 * `label<"w">` and `label<"h">`, each with one port (`n`) and no port for `k`.
 */
module constas_string

func label(constas k: string, n: int): string {
    return k
}

func main(): int sync {
    println(label("w", 1), label("h", 2), label("w", 3))
    return 0
}