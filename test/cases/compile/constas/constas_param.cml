/**
 * The `constas n: int` value of a call selects the instance of the declaration: `n = 3` and
 * `n = 5` are two instances, each with the parameter type the value writes.
 */
module constas_param
import { Tensor, ones, sum } from tensor

func total(constas n: int, x: Tensor<f32, [n]>): float {
    return sum(x)
}

func main(): int sync {
    println(total(3, ones([3])))
    println(total(5, ones([5])))
    println(total(3, ones([3])))
    return 0
}