/**
 * A declaration may take any number of `constas` parameters (rule, 2026-10-22), in any
 * position, and each value is its own part of the instance key: `mix(1, 2, 3)` and
 * `mix(2, 1, 3)` are two instances, so the two orders give different results.
 */
module constas_twice

func mix(constas a: int, x: int, constas b: int): int {
    return a * 100 + x * 10 + b
}

func main(): int sync {
    println(mix(1, 3, 2), mix(2, 3, 1))
    return 0
}