/**
 * A `constas` value is handed on, together with the rest parameter, to a declaration that takes
 * both: `columnOf("w", a, b)` is `column<"w">(a, b)`. This is the shape
 * the design's `tree_map` uses to reach `column(n, ts)` -- a wrapper that forwards the field name
 * it was given and the trees it was given.
 */
module constas_forward_rest

func column(constas n: string, ..ts): (int, int) {
    return ( static for j in indices ts => ts.[j].[n] )
}

func columnOf(constas n: string, ..ts): (int, int) {
    return column(n, ..ts)
}

func main(): int sync {
    let a = { w: 1, h: 2 }
    let b = { w: 3, h: 4 }
    println(columnOf("w", a, b))
    println(columnOf("h", a, b))
    return 0
}