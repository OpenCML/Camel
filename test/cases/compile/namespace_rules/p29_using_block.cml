// A `using namespace` in a namespace block applies to the declarations of that block only
// (N2): `twice` sees `inc`, `outside` does not.
import lib

namespace A {
    using namespace lib::Tools
    func twice(x: int): int { return inc(inc(x)) }
}

func outside(x: int): int {
    return inc(x)
}

func main(): int sync {
    println(A::twice(1), outside(1))
    return 0
}
