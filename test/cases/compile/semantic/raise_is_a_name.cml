/**
 * `raise` is not part of the language (design principles 2.10): it is an ordinary name. An
 * error value is returned with `throw`.
 */
module raise_is_a_name

func raise(amount: int): int {
    return amount + 1
}

func main(): int sync {
    let raised = raise(41)
    println(raised)
    return 0
}
