/**
 * `raise` is not part of the language (design principles 3.9): it is an ordinary name. An
 * error value is handed out by a `return` in a function declared `T!`.
 */

func raise(amount: int): int {
    return amount + 1
}

func main(): int sync {
    let raised = raise(41)
    println(raised)
    return 0
}
