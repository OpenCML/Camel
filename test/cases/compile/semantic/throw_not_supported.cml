/**
 * `throw` is in the grammar but exceptions are not implemented. It is a compile-time error at
 * the statement (line 10), not a `return`; nothing of the program runs.
 */
module throw_not_supported

func check(x: int): int {
    return if x > 0 then x else {
        println('never printed')
        throw x
    }
}

func main(): int sync {
    println('never printed either')
    println(check(1))
    return 0
}
