/**
 * `throw e` returns an error value (design principles 2.9), so the function around it must
 * declare a `T!`. Here it returns `int`: a compile-time error at the statement (line 10).
 */
module throw_outside_fallible

func check(x: int): int {
    return if x > 0 then x else {
        println('never printed')
        throw x
    }
}

func main(): int sync {
    println('never printed either')
    println(check(1))
    return 0
}
