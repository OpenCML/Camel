/**
 * `throw` is not a keyword and not a statement: it is an ordinary name, and nothing declares
 * it, so writing it is an unresolved reference (design principles 3.9). What used to be the
 * same shape is now an error value handed out where the declared type is not a `T!`
 * (err_error_outside_fallible.cml).
 */
module throw_is_a_name

func check(x: int): int {
    return if x > 0 then x else {
        println('never printed')
        throw x
    }
}

func main(): int sync {
    println('never printed either')
    println(check(1))
    return 0
}