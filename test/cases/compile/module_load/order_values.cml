// Top-level declarations do not depend on the order they are written in (design principles
// 2.12): a value uses values written after it, a function uses a value written after it, a
// function without a declared return type is called before it is written.
let area = pi * r * r
let pi = 3.14159
let r = 2.0

func main(): int sync {
    println(area, twice(), offset())
    return 0
}

func twice() {
    return k * 2
}

let k = 21

func offset(): int {
    return k + later
}

let later = 100
