/**
 * Helper module: a counter kept in a top-level `var`, read and written only through the
 * functions it exports (an exported `var` is not allowed, design principles 2.11).
 */
module counter

var cnt = 0
let step = 2

export sync func bump(): int sync {
    wait cnt += step
    return cnt
}

export func current(): int {
    return cnt
}
