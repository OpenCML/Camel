// Every way a function of another module reaches its module's top-level values: directly,
// through a function it calls, as a generic instance, as a function value, and through an
// element function of a higher-order operator.
import values_lib
import { bump } from values_lib

func twice(f: (x: int) => int, x: int): int {
    return f(f(x))
}

func main(): int sync {
    println(bump(1), values_lib::indirect(2), values_lib::biased('a'))
    println(twice(bump, 1), [1, 2]->map<bump>, values_lib::apply_all([5]))
    return 0
}
