/**
 * The same accumulation written two ways: a `var` written inside a loop body.
 *
 * This is one side of the pair `loop_var.cml` / `loop_let.cml`; the two files are one program in
 * two writings, and `std::jgir canonical=true` must print the same bytes for both (design
 * principles 3.5: a `var` is a name for values, and a write to an outer `var` in a loop body becomes
 * the loop's carried state).
 *
 * The accumulation is the loop's carried state: `total = total + 1` inside the body is the round's
 * next value, which the loop head hands to the next round and to the read after the loop, so the
 * `var` writing and the `let` writing that spells the same state out build one graph.
 *
 * Run: camel test/cases/compile/var/loop_var.cml
 */
func sum(n: int) => int sync {
    var total = 0
    let _ = loop i = 0 while i < n do {
        total = total + 1
        i + 1
    }
    return total
}

func main() => int sync {
    println(sum(3))
    return 0
}
