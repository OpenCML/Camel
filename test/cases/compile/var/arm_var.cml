/**
 * The same choice written two ways: a `var` written inside an arm of an `if`.
 *
 * This is one side of the pair `arm_var.cml` / `arm_let.cml`; the two files are one program in two
 * writings, and `std::jgir canonical=true` must print the same bytes for both (design principles
 * 3.5: a `var` is a resource and a unit is a representation).
 *
 * It is red today, and red for one reason: the arm's write keeps its `:var/get` (the value the arm
 * writes cannot be named by the fold, because an arm's write reaches the cell through the branch's
 * JOIN), so the `var` writing still builds a unit and its `if` is a statement. The `let` writing
 * makes the same choice the branch's value, and has no unit.
 *
 * Run: camel test/cases/compile/var/arm_var.cml
 */
func pick(c: bool): int sync {
    var x = 0
    if c then sync { x = 1 } else sync { x = 2 }
    return x
}

func main(): int sync {
    println(pick(true))
    return 0
}