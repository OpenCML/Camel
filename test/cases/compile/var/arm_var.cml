/**
 * The same choice written two ways: a `var` written inside an arm of an `if`.
 *
 * This is one side of the pair `arm_var.cml` / `arm_let.cml`; the two files are one program in two
 * writings, and `std::jgir canonical=true` must print the same bytes for both (design principles
 * 3.5: a `var` is a name for values, and an assignment inside an arm is the branch's result).
 *
 * The branch carries the write as its own value: the read after the branch takes the JOIN, and the
 * arm's result is the value it wrote. What the carry leaves unread -- `:var/new`, its stores, the
 * GATEs that handed the statement's value out and the value the cell was made with -- is dropped at
 * the end of the graph (Builder::dropCarriedVariableUnits), so the two writings print the same
 * bytes.
 *
 * Run: camel test/cases/compile/var/arm_var.cml
 */
func pick(c: bool) => int sync {
    var x = 0
    if c then sync {
        x = 1
    } else sync {
        x = 2
    }
    return x
}

func main() => int sync {
    println(pick(true))
    return 0
}
