/**
 * The arm that writes nothing hands out the value the name had before the branch -- the
 * initialiser 7. This is the whole of the phi's correctness: the join carries one value, and the
 * branch that did not write is given the value from before it, not the last arm's write.
 *
 * If this ever prints 1, the join is carrying the value of an arm that did not run. The pre-branch
 * value is taken while the arms are built, because `SsaEnv::rebind` changes the binding where it
 * stands and would otherwise leave the last arm's value behind for this arm to pick up.
 */
func main() => int {
    var x = 7
    let c = 0
    if c > 0 then {
        x = 1
    } else {}
    let shown = println(x)
    return 0
}
