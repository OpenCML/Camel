/**
 * The same accumulation written two ways: the loop's own carried value.
 *
 * This is one side of the pair `loop_var.cml` / `loop_let.cml`; the two files are one program in
 * two writings, and `std::jgir canonical=true` must print the same bytes for both (design
 * principles 3.5: a `var` is a resource and a unit is a representation).
 *
 * Nothing here is a unit: the accumulation is the state the LOOP carries from one turn to the
 * next -- `acc` -- which is exactly what `loop_var.cml`'s `var` must be lowered to. The loop hands
 * both states on, and only the accumulated one is used, so the other is discarded in the binding.
 *
 * Run: camel test/cases/compile/var/loop_let.cml
 */
func sum(n: int): int sync {
    let (_, total) = loop i = 0, acc = 0 while i < n do (i + 1, acc + 1)
    return total
}

func main(): int sync {
    println(sum(3))
    return 0
}
