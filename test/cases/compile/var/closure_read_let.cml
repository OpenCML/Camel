/**
 * The same program as `closure_read.cml`, written without `var`: the closure captures a `let`
 * binding, whose value is the number the closure reads.
 *
 * This is the reference writing for the canonical-graph comparison in
 * `test/plans/feat/compile/var.plan.toml`: the two writings must have one canonical graph
 * (`std::jgir canonical=true`, byte for byte). It prints `2`, the same as the `var` writing.
 *
 * Run: camel test/cases/compile/var/closure_read_let.cml std::nvm
 */
func main() => int sync {
    let x = 2
    let read = func () {
        x
    }
    println(read())
    return 0
}
