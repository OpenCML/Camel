/**
 * The same place makes a box again and again: one body, run once per element of a small range.
 *
 * Each element's box is dead when the element is done, and the reading says so: each block is
 * released or live and counted once, and at most the boxes of the last elements are still counted.
 * `--gc-check foreign` reads it at the return of the run and again at exit, and
 * `ref_boxes_loop_thousand.cml` is the same program over a range a hundred times longer: none of the
 * four back ends answers the ten with ten or the thousand with a thousand. Read at the return, fvm,
 * jit and prl have nothing left and nvm has three -- the last elements' boxes, whose handle died
 * with a frame no collection has looked at since. That is the open item: see
 * `docs/handover/questions/2026-11-15-is-a-handles-count-the-slots-or-the-wrappers.cn.md`.
 */

import state

func main(): int sync {
    let kept = state::ref(41)
    let total = [state::get(state::ref(i)) for i in 0..10]
    println(len(total), state::get(kept))
    return 0
}