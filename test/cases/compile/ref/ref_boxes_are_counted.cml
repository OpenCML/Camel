/**
 * A box is counted, and the count is read: `--gc-check foreign` prints the blocks that were made,
 * released and still live, once at the return of the run and once when the program stops.
 *
 * This program makes a thousand boxes through nested calls and keeps one, then allocates so that
 * the calls that made them are over before the program stops. What the lines say, and what this
 * case holds every back end to:
 *
 *   created >= 1001   every box the program made, and the one it kept, was counted;
 *   released == created, live == 0   none of them was still counted at the return.
 *
 * The moment a counted resource is reclaimed does not depend on which back end ran the program
 * (design principles 10.5): a box whose last handle died while the program ran is freed when the
 * run's frames are gone, and every back end reaches that point. `std::nvm` keeps a safepoint at
 * graph boundaries only, so it takes one collection at the return of its entry graph; that
 * collection is what frees a block whose last handle went with a frame, and it counts no slot -- a
 * handle two slots name, or one a closure captured, is left alone.
 */

import state

func drop_many(i: int, n: int): int {
    let r = state::ref(i)
    let v = state::get(r)
    return if i + 1 >= n then v else v + drop_many(i + 1, n)
}

func main(): int sync {
    let kept = state::ref(41)
    println(drop_many(0, 1000))
    // A tail that allocates real objects: a box is freed when the collector finds its last handle
    // gone, so the collections the allocations below cause are the ones that would notice a dead
    // one. (Probe: a range object is cheap, an array is not.)
    let tail = [i for i in 0..20000]
    println(len(tail))
    println(state::get(kept))
    return 0
}