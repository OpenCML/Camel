/**
 * A box is counted, and the count is read: `--gc-check foreign` prints one line when the program
 * stops, with the blocks that were made, released and still live.
 *
 * This program makes a thousand boxes through nested calls and keeps one, then allocates so that
 * the calls that made them are over before the program stops. What the line says, and what this
 * case holds every back end to:
 *
 *   created >= 1001   every box the program made, and the one it kept, was counted;
 *   released == created, live == 0   none of them outlived the run.
 *
 * The moment a counted resource is reclaimed does not depend on which back end ran the program
 * (design principles 10.5): a box whose last handle died while the program ran is freed by the
 * collection that closes the run, and every back end runs it. Two moments are read: the same line
 * once at the return of the run (`FOREIGN_RESOURCES_AT_RETURN`) and once at exit. At exit all four
 * back ends read 0; at the return fvm, jit and prl read 0 and nvm reads 1 -- a block whose last
 * handle died with a frame and which no collection has looked at yet. That one block is the open
 * handle-count question: see
 * `docs/handover/questions/2026-11-15-is-a-handles-count-the-slots-or-the-wrappers.cn.md`.
 */

import state

func drop_many(i: int, n: int): int {
    let r = state::ref(i)
    let v = state::get(r)
    return if i + 1 >= n then v else v + drop_many(i + 1, n)
}

func main(): int sync {
    let kept = state::ref(41)
    println(drop_many(0, 1000))
    // A tail that allocates real objects: a box is freed when the collector finds its last handle
    // gone, so the collections the allocations below cause are the ones that would notice a dead
    // one. (Probe: a range object is cheap, an array is not.)
    let tail = [i for i in 0..20000]
    println(len(tail))
    println(state::get(kept))
    return 0
}