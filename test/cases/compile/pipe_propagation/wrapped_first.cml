/**
 * The overloads of `f` are asked first with the value as it is, `when` conditions included
 * (design principles 3.9): a function that takes the `T?` itself, or a generic `T` its condition
 * allows to be a `T?`, is called with the wrapped value, and the pipe takes it apart only when none
 * does.
 */

func describe(x: int): string { return 'a number' }
func describe(x: int?): string { return 'maybe a number' }

func only_plain::<T>(x: T): T when is_plain::<T>() { return x }

func is_plain::<T>(): bool {
    return match type T {
        case int => true
        case _ => false
    }
}

func anything::<T>(x: T): T { return x }

func main(): int sync {
    let a: int? = 1
    let b: int? = null
    println(a->describe, b->describe, 3->describe)
    // `T = int?` fails the condition, so the pipe takes the value out: `T = int`.
    println(a->only_plain ?? -1, b->only_plain ?? -1)
    // No condition: the generic takes the `int?` whole and gives it back.
    println(a->anything ?? -1, b->anything ?? -1)
    return 0
}
