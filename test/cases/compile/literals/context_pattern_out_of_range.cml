/**
 * the pattern of a `match` case takes the type of the value matched, so a
 * pattern literal the type cannot hold is reported.
 */

func pick(x: i32): int {
    return match x {
        case 5000000000 => 1
        case _ => 0
    }
}

func main(): int sync {
    println(pick(1))
    return 0
}
