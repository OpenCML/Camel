/**
 *  Handover, item 6: a decimal literal where an integer is asked for is one diagnostic
 * (`LiteralNotRepresentable`) that says why: the value would be truncated. A variable is not
 * converted by this rule, and a literal is not cut to fit.
 */
module literal_context_truncated

func main(): int sync {
    let x: int = 1.9
    println(x)
    return 0
}
