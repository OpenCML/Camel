/**
 * A value that already has a type is not converted by the expected type of the position: the
 * expected type of a call moves a literal, never a value (design principles 5.1). The `float[]`
 * value here keeps its type, so `T` is `float[]` and the call is a `float[]`; the `f32[]`
 * declaration it is written in refuses it, exactly as it did before the expected type was carried
 * through the call. Nothing is converted on the way.
 */
module expected_type_typed_value_not_converted

func keep::<T>(xs: T[], n: int): T[] { return xs }

func main(): int sync {
    let v: float[] = [1.0, 2.0]
    let xs: f32[] = keep(v, 2)
    println(len(xs))
    return 0
}