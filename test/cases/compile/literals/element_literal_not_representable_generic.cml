/// The element type of a generic body is the one the instantiation fixes (design principles 5.5):
/// `half` is checked for `half::<int64[4]>`, whose `0.5` the element type cannot hold,
/// and the refusal names the instance. The parameter is the argument's own type, which is what a
/// `T[..]` parameter means once the tensor type carries its element type (P4); until then this
/// is the spelling a generic body over an open element type has.

import { reshape, cast, sum } from tensor

type Tens<T> = T

func half::<T>(x: Tens<T>): Tens<T> {
    return x * 0.5
}

func main(): int sync {
    let x = cast(reshape([1.0, 2.0, 3.0, 4.0] as f32[], [4]), "int64")
    println(sum(half(x)))
    return 0
}