/**
 * Handover, item 2: the fields of a struct literal take the expected type, but a field
 * written as a name is a variable: it is not converted, and the declared type is not met.
 */
module literal_context_struct_field_variable

type Point = { x: float, y: float }

func main(): int sync {
    let n: int = 1
    let p: Point = { x: n, y: 2.0 }
    println(p)
    return 0
}
