/// a literal operand beside a tensor takes the tensor's element type (design principles
/// 5.1), so `x * 1.0e40` with an `f32` tensor is a literal the element type cannot hold: an
/// error at the expression, not a product that silently reads as `inf`.

import { reshape, sum } from tensor

func scale(x: f32[3]): f32[3] {
    return x * 1.0e40
}

func main(): int sync {
    let x = reshape<[3]>([1.0, 2.0, 3.0] as f32[])
    println(sum(scale(x)))
    return 0
}