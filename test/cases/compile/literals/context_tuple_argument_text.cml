/**
 * A tuple literal written as an argument takes the parameter's type element by element:
 * a text element is the mismatch of that element, not a call that matches no overload.
 */

func pairSum(t: (float, float)): float { return t.0 + t.1 }

func main(): int sync {
    println(pairSum(('1.5', 2.0)))
    return 0
}