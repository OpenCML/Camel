/**
 * A list comprehension is not the empty array literal: `[e for x in s]` writes no element list
 * either, so a position that states an array type used to turn it into `[]` and drop every round
 * without a word -- `let xs: f32[] = [f32(i) for i in 0..n]` bound an empty array, and so did the
 * same comprehension under `as` and as an element of a tuple. A comprehension is a value of its
 * own, and the declared type reaches it as it reaches the same comprehension returned from a
 * function with that declared type (design principles 4.2, 5.1).
 */
module comprehension_in_position

func doubles(n: int): f32[] {
    // The declared return type: the position that always worked.
    return [f32(i) * 0.5 for i in 0..n]
}

func main(): int sync {
    let n = 4
    let declared: f32[] = [f32(i) for i in 0..n]
    let cast = [i + 1 for i in 0..n] as int[]
    let pair: (f32[], int) = ([f32(i) for i in 0..n], 7)
    println(declared, len(declared))
    println(cast, len(cast))
    println(len(pair.0), pair.1)
    println(doubles(n), len(doubles(n)))
    var bound: int[] = [i * i for i in 0..n]
    println(bound, len(bound))
    return 0
}