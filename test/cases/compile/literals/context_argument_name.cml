/**
 * Handover: a composite literal argument enters its parameter's type, but an element that
 * is a name is a value of its own type. `pick([n])` with `n: int` and `xs: f32[]` has no
 * matching function: the literal does not become an `f32[]` around a variable.
 */
module literal_context_argument_name

func pick(xs: f32[]): f32 { return xs[0] }

func main(): int sync {
    let n: int = 1
    println(pick([n]))
    return 0
}