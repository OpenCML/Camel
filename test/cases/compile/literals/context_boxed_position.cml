/**
 * Handover a position that takes a value by putting it into the form (`T?`, `T!`) takes the value
 * itself and the payload put into the form, so it does not determine which of the two the value
 * is (design principles 3.8, 5.2, `entersImplicitly`). A call standing in such a position has the
 * type its own arguments give it, and the form is put on at the position: `let v: int? = [1,
 * 2]->reduce<(a: int, b: int): int => a + b, 0>` is a reduction whose accumulator is an `int`, as
 * the written lambda and the initial value both say. Before this, the call's result type variable
 * was solved from the `int?` of the position, the deferred initial value was given the type
 * `int?` with it, and the call was refused as a whole with `SemanticDiag::NoMatchingFunction`
 * ("argument types: <(a: int, b: int) => int, int?> (int[])"). The generator's seeds 19 and 23
 * hit it in 82 cells of `opt.progen` (`reduce` over `string[]` and over `int[]`, in the arm of an
 * `if … else null` under a declared `T?` return). Every position a value enters by the form is
 * here: a declaration, the arm of an `if` under a declared `T?` return, a struct field, an
 * ordinary parameter of type `int?`; beside them the `with` parameter whose own type is the
 * concrete `int?` (there the position does give the type) and the literal `5` in an `int?`
 * declaration, which still takes the form.
 */
module literal_context_boxed_position

type Box = { count: int? }

// A `with` parameter of a concrete nullable type: the parameter is not a type variable, so the
// position itself gives the initial value its type and this keeps working unchanged.
with <init: int?>
func start(): int? {
    return init;
}

// The declared return type is `int?`, so the arm of the `if` stands in an `int?` position, and
// the reduction in that arm is what the position is asked for.
func maybeSum(xs: int[]): int? {
    return if len(xs) > 0 then xs->reduce<(a: int, b: int): int => a + b, 0> else null;
}

// The same over strings: the seed 19 shape (`reduce` over `string[]` in a `string?` position).
func maybeJoin(xs: string[]): string? {
    return if len(xs) > 0 then xs->reduce<(acc: string, item: string): string => acc + item, ''> else null;
}

// An ordinary parameter of nullable type: the argument is an `int` and the form is put on here.
func total(x: int?): int {
    return x ?? 0;
}

func main(): int sync {
    let xs: int[] = [1, 2, 3, 4];
    let ss: string[] = ['a', 'b', 'c'];
    // a declaration, a branch arm under a declared `T?` return, a struct field, a parameter
    let direct: int? = xs->reduce<(a: int, b: int): int => a + b, 0>;
    let field: Box = { count: xs->reduce<(a: int, b: int): int => a + b, 0> };
    println(direct ?? -1, field.count ?? -1, maybeSum(xs) ?? -1);
    println(maybeJoin(ss) ?? 'none', total(xs->reduce<(a: int, b: int): int => a + b, 0>));
    // a lambda whose parameter types are unwritten takes them at the call, and the position's
    // payload is what its accumulator is: `int` here, `f64` there (`0` takes the `f64`)
    let unwritten: int? = xs->reduce<(a, b) => a + b, 0>;
    let reals: f64? = [1.5, 2.5]->reduce<(a, b) => a + b, 0>;
    println(unwritten ?? -1, reals ?? -1.0);
    // a literal in an `int?` declaration still takes the form, and a `with` parameter of the
    // concrete type `int?` still takes the literal at its own position
    let boxed: int? = 5;
    println(boxed ?? -1, start<0>() ?? -1);
    return 0;
}