/**
 * An error value is handed out by a function that declares `T!`: here the function returns
 * `int`, so the arm that hands the error out does not join with the arm that gives an `int`
 * (design principles 3.9).
 */
module err_error_outside_fallible

func check(x: int): int {
    if x > 0 then { return x } else {
        return error('Negative', 'x is not positive')
    }
}

func main(): int sync {
    println('never printed')
    println(check(1))
    return 0
}