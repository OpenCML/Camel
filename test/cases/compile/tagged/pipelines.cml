/**
 * One program over both tagged forms, run through every backend and through the optimisation
 * pipelines: the branches they are lowered to are ordinary branches.
 */

func positive(x: int): int? {
    if x > 0 then { return x } else { return null }
}

func safe_div(a: int, b: int): int! {
    if b == 0 then {
        return error('DivByZero', 'the divisor is zero')
    } else {
        return a / b
    }
}

func inc(x: int): int { return x + 1 }

func label(r: int!): string {
    return match r {
        case error e => e.kind
        case v => format<v>('{}')
    }
}

func sum_to(n: int, acc: int): int {
    return if n == 0 then acc else sum_to(n - 1, acc + (positive(n - 3) ?? 0))
}

func main(): int sync {
    println(positive(4) ?? 0)
    println(positive(-4) ?? 0)
    println(safe_div(9, 3) !! -1)
    println(safe_div(9, 0) !! -1)
    println(label(safe_div(8, 2) -> inc))
    println(label(safe_div(8, 0) -> inc))
    println(parse_int('12') !! 0)
    println(parse_int('twelve') !! 0)
    println(sum_to(10, 0))
    return 0
}
