/**
 * `throw` in a function that does not declare a `T!`: ThrowOutsideFallible at the statement.
 */

func check(x: int): int {
    if x > 0 then { return x } else {
        throw error('Negative', 'x is not positive')
    }
}

func main(): int sync {
    println('never printed')
    println(check(1))
    return 0
}
