/**
 * The patterns that bind are the fixed forms of `T?` / `T!` (design principles 3.8):
 * `case error e` reads the error out of a `T!`, and over an `int` there is no mark to take
 * apart. A `match` over the value reads it with a literal pattern or `_` instead.
 */

func f(n: int): int {
    return match n {
        case error e => 1
        case _ => 0
    }
}

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}
