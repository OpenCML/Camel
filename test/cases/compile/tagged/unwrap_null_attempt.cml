/**
 * The checked unwrap refuses even inside `attempt`: a defect of the compiler is not a fault of the
 * program, so no boundary turns it into an error value.
 */

func unwrap_it(slot: int?): int {
    return __unwrap__(slot)
}

func main(): int sync {
    let slot: int? = null
    println(attempt(unwrap_it)(slot) !! -12345)
    return 0
}
