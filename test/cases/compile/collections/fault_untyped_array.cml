module main

// An array without an element type (`[]`) converts only while it is empty: this one was
// appended to, so the conversion is a fault with its position, on every back end.

func main(): int sync {
    var xs = []
    xs->append<1>
    println("before")
    let s = xs as Set<int>
    println(s)
    println("never printed")
    return 0
}
