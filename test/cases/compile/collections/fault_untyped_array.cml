// An empty literal (`[]`) takes its element type from where it stands: appended to, it is an
// array of the appended value's type, so it converts to a set like any other array of that type.
// (It used to stay an array without an element type and fault on the conversion.)

func main(): int sync {
    println("before")
    let s = ([]->append<1>) as Set<int>
    println(s)
    println("after")
    return 0
}
