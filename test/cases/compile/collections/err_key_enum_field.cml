module main

// An enum is a key when every field of every variant is one: a float field is not (NaN is
// not equal to itself, and 0.0 equals -0.0). The diagnostic names the field and points at
// the place its type is written.

type Boxed = enum { Empty, Weight(float) }

func main(): int sync {
    let m = [(Boxed::Empty, 1)] as Map<Boxed, int>
    println("never printed")
    return 0
}
