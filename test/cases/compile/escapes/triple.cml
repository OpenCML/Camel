/**
 * probes: the escape table of a triple-quoted string ('''...''').
 *
 * The triple-quoted form is the one that takes no escaped quote, but it still shares the one
 * escape table: every valid probe of plain.cml is written here again.
 */

func main(): int sync {
    println('0', len('''\0'''))
    println('x41', len('''\x41'''), '''\x41''')
    println('u', len('''\u{1F600}'''))
    println('n', len('''\n'''))
    println('0x', len('''\0x'''))
    return 0
}