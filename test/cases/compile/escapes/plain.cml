/**
 * probes: the escape table of a plain string ('...' / "...").
 *
 * Each line prints the length and, where the result is printable, the text the escape produced.
 * Every pair written here is a valid one; the unknown pairs are in unknown.cml, which no longer
 * compiles.
 */

func main(): int sync {
    println('0', len('\0'))
    println('x41', len('\x41'), '\x41')
    println('u', len('\u{1F600}'))
    println('n', len('\n'))
    println('0x', len('\0x'))
    return 0
}