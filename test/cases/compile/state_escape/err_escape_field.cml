/**
 * Escape route two, "written into a place that is not part of this evaluation" (design principles
 * 3.5, 197): the closure made in `fill` captures `acc`, a `var` of `fill`'s call, and stores it
 * into `b.f`, a field of the caller's own variable. Storing it there is not a fault -- a closure
 * holds the value, and a value that outlives the scope that made it is a value nobody has to own
 * (the author's ruling of 2026-11-16, which withdrew the state rule of 2026-11-14).
 *
 * The assignment inside the closure is the fault: `acc = acc + x` writes nothing the closure can
 * see. Refused by `ClosureAssignsCapturedName` (0x03000213).
 */

type Box = { f: (x: int) => int, n: int }

func fill(var b: Box) {
    var acc = 0
    sync {
        b.f = func (x: int) => int sync {
            acc = acc + x
            acc
        }
    }
}

func main() => int sync {
    var box: Box = { f: func (x: int) => int {
        x
    }, n: 0 }
    fill(box)
    println(box.f(1))
    return 0
}
