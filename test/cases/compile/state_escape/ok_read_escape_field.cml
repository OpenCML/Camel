/**
 * Route two, a field of the caller's own variable, with a closure that only reads (design
 * principles 3.5, 197): `fill` binds `acc` to `base * 3` and stores a closure that reads it into
 * `b.f`. The store outlives the call, and that is legal now -- a closure captures the value the
 * name had where it was made, so the closure holds a value and
 * what is left behind holds that value. Nothing is reported, and the program prints 21 + 1 = 22.
 *
 * As in `ok_read_escape_return`, the single binding means the reading cannot separate a value port
 * from a shared cell; the two-binding shape is legal too and is measured in the plan's header
 * (`acc` first 0, then `base * 3`, prints 1 on this tree because the capture port takes the first
 * binding). The refusing counterpart of this shape is `err_escape_field`, whose closure assigns
 * `acc`.
 */

type Box = { f: (x: int) => int, n: int }

func fill(var b: Box, base: int) {
    var acc = base * 3
    sync {
        b.f = func (x: int) => int {
            acc + x
        }
    }
}

func main() => int sync {
    var box: Box = { f: func (x: int) => int {
        x
    }, n: 0 }
    fill(box, 7)
    println(box.f(1))
    return 0
}
