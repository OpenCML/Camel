/**
 * Escape route three, "handed to a function that stores it" (design principles 3.5, 197): `keep`
 * takes a function value and returns a pair that holds it, so the value handed to it is kept past
 * the call, and `make` hands it a closure over `acc`, a `var` of its own call. A call keeping what
 * it is given is not a fault of its own now (the rule, which withdrew the
 * state rule of 2026-11-14).
 *
 * The assignment inside the closure is the fault: `acc = acc + x` writes nothing the closure can
 * see. Refused by `ClosureAssignsCapturedName` (0x03000213).
 */

func keep(f: (x: int) => int) => ((x: int) => int, int) {
    return (f, 0)
}

func make() => int sync {
    var acc = 0
    let add = func (x: int) => int sync {
        acc = acc + x
        acc
    }
    let (kept, n) = keep(add)
    return kept(n)
}

func main() => int sync {
    println(make())
    return 0
}
