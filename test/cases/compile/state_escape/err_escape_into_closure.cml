/**
 * Escape route three read through a second closure (design principles 3.5, 197): `inner` captures
 * `acc`, a `var` of `make`'s call, and `outer` captures `inner`. Returning `outer` hands the value
 * out inside a value whose type cannot show what it holds -- the capture travels one level down, so
 * anything that has to follow a captured value has to follow it into the closure it is. That is
 * legal now (the rule: a closure captures a value).
 *
 * The assignment `inner` makes is the fault: `acc = acc + x` writes nothing the closure can see.
 * Refused by `ClosureAssignsCapturedName` (0x03000213).
 */

func make() => (y: int) => int {
    var acc = 0
    let inner = func (x: int) => int sync {
        acc = acc + x
        acc
    }
    return func (y: int) => int {
        inner(y) + 1
    }
}

func main() => int sync {
    let g = make()
    println(g(1))
    return 0
}
