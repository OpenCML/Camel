/**
 * The positive side of the module top level (design principles 3.5, rule two, with 10.1): a
 * top-level `let` is a value of the module, computed once and read by the functions that name it,
 * and a top-level function value is handed out as an ordinary value. Neither declares a mutable
 * cell, so there is no evaluation for a closure to carry one out of.
 */

let base = 10

func twice(x: int): int {
    return x * 2
}

let double = twice

func add_base(x: int): int {
    return base + x
}

func main(): int sync {
    println(add_base(1))
    println(double(add_base(1)))
    return 0
}