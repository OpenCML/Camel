/**
 * Escape route two again, as an element of the caller's array (design principles 3.5, 197): `fill`
 * makes a closure over `acc`, a `var` of its own call, and writes it into `out[0]`, an array that
 * belongs to the caller. The array outliving the call is not a fault of its own any more -- a
 * closure holds the value (the author's ruling of 2026-11-16, which withdrew the state rule of
 * 2026-11-14).
 *
 * The assignment inside the closure is the fault: `acc = acc + x` writes nothing the closure can
 * see. Refused by `ClosureAssignsCapturedName` (0x03000213).
 */

func fill(var out: ((x: int) => int)[]) {
    var acc = 0
    sync {
        out[0] = func (x: int) => int sync {
            acc = acc + x
            acc
        }
    }
}

func main() => int sync {
    var fs: ((x: int) => int)[] = [func (x: int) => int {
        x
    }]
    fill(fs)
    println(fs[0](1))
    return 0
}
