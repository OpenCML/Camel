// The other half of Q5: the widening keeps the rank, so a rank-1 value does not enter the
// rank-2 binding a `var` established, and the program is refused where it is written.

import { ones } from tensor

func main(): int sync {
    var w = ones::<f32>([2, 3])
    w = ones::<f32>([5])
    println(len(w))
    return 0
}