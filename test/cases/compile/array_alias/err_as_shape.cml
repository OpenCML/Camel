// The shape is checked when the conversion runs: an array whose type fixes no rank enters a
// shaped position through `as`, and a value that turns out not to have the declared shape stops
// the program at the conversion (plan section 5.1), where the message names the shape the value
// has. It is a runtime refusal, not a dynamic cast refused at compile time.
module array_alias_err_as_shape

import { ones } from tensor

func main(): int sync {
    let t: f32[..] = ones([2, 3])
    let a = t as f32[3, 2]
    println(len(a))
    return 0
}