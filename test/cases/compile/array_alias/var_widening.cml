// `var` widening keeps the rank (plan Q5): a rank-2 tensor binding widens to rank 2 with its
// extents forgotten, so it still fills a rank-2 parameter after a second assignment.
module array_alias_var_widening

import { ones } from tensor

func rows2(t: f32[?, ?]): int {
    return len(t)
}

func main(): int sync {
    var w = ones([2, 3])
    w = ones([4, 5])
    println(rows2(w))
    return 0
}