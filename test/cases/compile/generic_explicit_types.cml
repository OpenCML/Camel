module generic_explicit_types
func id::<T>(x: T): T { return x }
with <n: int>
func repeat::<T>(x: T): T[] { return 0..n->map<(i: int): T => x> }
func empty::<T>(): T[] { let xs: T[] = []; return xs }
func returned(): int[] { return empty() }
func length(xs: int[]): int { return len(xs) }
with <xs: int[]>
func context_length(): int { return len(xs) }
func main(): int sync {
    println(id::<int>(7))
    println(id::<string>('typed'))
    println(repeat::<int><3>(5))
    let f = id::<int>
    println(f(9))
    let xs: int[] = empty()
    println(len(xs))
    println(len(empty::<string>()))
    println(len(returned()))
    println(length(empty()))
    println(context_length<empty()>())
    println(generic_explicit_types::id::<(int, string)>((4, 'pair')))
    return 0
}
