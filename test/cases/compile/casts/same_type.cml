// Converting a value to its own type is legal and does nothing (design principles 5.1, Q11 of
// docs/design/graph-model): `xs as int[]` for `xs: int[]` passes exactly as a conversion
// through an alias does — for a primitive, a text, a complex number, an array, a tuple and a
// struct, literals included; a cast that would convert something is still refused.
type A = int[]
type S = { a: int, b: string }

func through(p: A): A { return p as A }

func main(): int sync {
    let xs = [1, 2]
    let ys = xs as int[]
    let t = (1, "x")
    let u = t as (int, string)
    let s: S = { a: 3, b: "y" }
    let r = s as S
    println(ys)
    println(u)
    println(r.a, r.b)
    println(through([4]))
    println([5, 6] as int[])
    println(len(ys as A))
    println('x' as string)
    let text: string = 'y'
    println(text as string)
    let n: int = 3
    println(n as int)
    let b: bool = true
    println(b as bool)
    let f: float = 1.5
    println(f as float)
    let z: c128 = 1+2i
    println(z as c128)
    let w: c64 = 1-2i
    println(w as c64)
    println(3 as int)
    println(1.5 as float)
    return 0
}