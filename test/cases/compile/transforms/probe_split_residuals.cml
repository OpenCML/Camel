// The probe of test/tools/have-split-residuals.mjs: the lifted `g(x) = x*x`, split into its halves,
// and nothing else. The question the gate asks is whether the forward half hands values on as
// residuals -- `split` prints how many it handed on (`REINTERP split function=... residuals=N`), so
// the answer is read from the build's own reading and not guessed from this file.
//
// It fails today: the backward half of this function reads the value of `x`, which is a residual, and
// carrying residuals between the two halves is the step after the plumbing. The gate skips the plan's
// 9 / r0 = 3 / 6 / 12 / 0 entries while that is so, and opens them when the probe starts answering.
import rulesets.jvp
import { jvp, split } from transforms

func g(x: float): float {
    return x * x
}

func main(): int sync {
    let f = jvp(g)
    let (_fwd, _lin) = split(f)
    return 0
}