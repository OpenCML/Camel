// The two cotangent laws a bare `transpose` reads -- `abs_t` and `log_t` -- and the wall behind the
// numbers they answer.
//
// `transpose` of a function that is not a `split` has the **cotangent only**: the parameter's value
// is not among its arguments, so a law that reads an operand is handed a zero carrier there. Both
// readings below are that carrier, and they say which number it is:
//   - `log_t` is `ct / x`, and the answer is `inf` at every element -- `1.0 / 0.0`, so the carrier
//     is zero and not, say, the cotangent.
//   - `abs_t` is `where(x >= 0.0, ct, -ct)`, and `0.0 >= 0.0` is true, so every element answers
//     `ct`. At x = [1, -2, 3] the right cotangent is [1, -1, 1].
//   - The third reading tells the two carrier hypotheses apart: at cotangent -3.0 `abs_t` answers
//     [-3, -3, -3], which is `x` reading as non-negative. A law handed the cotangent as `x` would
//     read -3, take the other arm, and answer [3, 3, 3].
//
// So this case does not check the two laws' **numbers**, and it does not pretend to: the numbers are
// the carrier's. What it checks is that the laws are *read* -- the `rhs=` lines name `abs_t` and
// `log_t`, and deleting or changing either one makes this case red (the first by refusing, the
// second by moving a number). The day the walk learns to carry an operand into a bare `transpose`,
// these three lines change to [1, -1, 1], [1, 0.5, 0.3333333333333333] and [-3, 3, -3] -- the values
// the comments name -- and that change is the point of the case.
//
//     camel test/cases/compile/transforms/transpose_laws_of_abs_and_log.cml
import rulesets.transpose
import { transpose } from transforms
import { abs, sum, log } from tensor

/// `x ↦ Σ|x|`: linear-ish in the sense a transpose can be asked about, and its cotangent law is the
/// mask `abs_t` reads.
func f_abs(x: float[3]): float {
    return float(sum(abs(x)))
}

/// `x ↦ Σ log(x)`: one operand, one reciprocal, nothing recomputed -- `log_t`'s own shape.
func f_log(x: float[3]): float {
    return float(sum(log(x)))
}

func main(): int sync {
    let absCotangent = transpose(f_abs)(1.0)
    `abs  ct=1.0  {}  right=[1.0, -1.0, 1.0]`->format<absCotangent>->println
    let absFlipped = transpose(f_abs)(0.0 - 3.0)
    `abs  ct=-3.0 {}  right=[-3.0, 3.0, -3.0]`->format<absFlipped>->println
    let logCotangent = transpose(f_log)(1.0)
    `log  ct=1.0  {}  right=[1.0, 0.5, 0.3333333333333333]`->format<logCotangent>->println
    return 0
}