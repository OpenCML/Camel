// The derivative as a library, asked for the first time: `vjp(f)` is written here as
// `transpose(split(reinterp<jvp>(f)))`, and the last step is not implemented. What this case reads
// is *which* step stopped it and *where*: the diagnostic has to name the operator and stand on the
// line of `stdlib/vjp.cml` that composes it, not on this file, and it may not say anything of the
// form "not implemented yet". The composition builds -- the pair `split` hands back is taken and
// the forward half is called -- and the refusal comes from the walk `transpose` runs, so the case
// calls the pullback: printing the function alone would read as a pass.
import rulesets.jvp
import { vjp } from vjp

func f(x: float): float {
    return x * x * x
}

func main(): int sync {
    let reading = vjp(f)
    let (value, backward) = reading(3.0)
    println(value)
    println(backward(1.0))
    return 0
}