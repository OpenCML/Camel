// `^` was the one written operator with a float result that the key table did not list, so before
// `pow` joined it a lifted function containing `x ^ 2.0` was refused by name
// (`skip=rule uri=:op/pow_d reason=the operator has no forward rule bound at all`) -- an ordinary
// power of an ordinary float, undifferentiable. The key is derived now (`pow` is a written
// operation), and the rule is `jvp_pow`, whose tangent `w * x^(w-1) * dx + x^w * log(x) * dw` is
// written out in `autodiff::pow_tangent`.
//
// Two values are pinned, and the second is the one that matters:
//   - `p(3.0) = 9.0` and `d(x^2) = 2x dx = 6.0` at `x = 3` with `dx = 1`.
//   - `p(-3.0) = 9.0` and `2x dx = -6.0` at `x = -3`. The exponent is a constant, so its tangent is
//     zero and the term `x^w * log(x) * dw` is exactly zero -- but `log(-3.0)` is NaN and
//     `0 * NaN` is NaN, so an unguarded rule would answer NaN here. The guard is what keeps an
//     ordinary `(-3.0) ^ 2.0` at -6.0, and this line is the reading that holds it.
//
// The exponent is written `2` in `q`: an integer literal needs no conversion node, so the lift sees
// one operator (`rules=jvp_pow`, with no `jvp_ltod` in the list) and the same 6.0.
import rulesets.jvp
import { jvp } from transforms

func p(x: float): float {
    return x ^ 2.0
}

func q(x: float): float {
    return x ^ 2
}

func main(): int sync {
    let (value, tangent) = jvp(p)(3.0, 1.0)
    println(value)
    println(tangent)
    let (negValue, negTangent) = jvp(p)(0.0 - 3.0, 1.0)
    println(negValue)
    println(negTangent)
    let (intPower, intTangent) = jvp(q)(3.0, 1.0)
    println(intPower)
    println(intTangent)
    return 0
}