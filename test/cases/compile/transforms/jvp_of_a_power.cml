// `^` was the one written operator with a float result that the key table did not list, so before
// `pow` joined it a lifted function containing `x ^ 2.0` was refused by name
// (`skip=rule uri=:op/pow_d reason=the operator has no forward rule bound at all`) -- an ordinary
// power of an ordinary float, undifferentiable. The key is derived now (`pow` is a written
// operation), and the rule is `jvp_pow`, whose tangent `w * x^(w-1) * dx + x^w * log(x) * dw` is
// written out in `pow_tangent`, in the same file as the rule.
//
// What is pinned, in order:
//   - `p(3.0) = 9.0` and `d(x^2) = 2x dx = 6.0` at `x = 3` with `dx = 1`.
//   - `p(-3.0) = 9.0` and `2x dx = -6.0` at `x = -3`. The exponent is a constant, and a constant's
//     tangent is a zero constant (`jvp.cpp`'s `zeroConstantFor`), so the exponent's term is
//     arithmetically nothing -- it is not asked for, and `log(-3.0)` is never evaluated. An
//     ordinary `(-3.0) ^ 2.0` answers -6.0, not NaN.
//   - The exponent written as the integer literal `2` in `q` needs no conversion node, so the lift
//     sees one operator (`rules=jvp_pow`, with no `jvp_ltod` in the list) and the same 6.0.
//   - `s` is the same operator with the exponent **varying**, and it is where the rule has to be
//     honest. At `x = 3` the tangent is `x^x (ln x + 1) = 56.66253179403897`. At `x = -3` the value
//     is real (-1/27 -- an integer exponent is defined at a negative base) but the derivative in the
//     exponent is not: `log(-3.0)` has no real value and the tangent comes back `nan`. An undefined
//     derivative says so; it is not written down as a zero.
import rulesets.jvp
import { jvp } from transforms

func p(x: float): float {
    return x ^ 2.0
}

func q(x: float): float {
    return x ^ 2
}

func s(x: float): float {
    return x ^ x
}

func main(): int sync {
    let (value, tangent) = jvp(p)(3.0, 1.0)
    println(value)
    println(tangent)
    let (negValue, negTangent) = jvp(p)(0.0 - 3.0, 1.0)
    println(negValue)
    println(negTangent)
    let (intPower, intTangent) = jvp(q)(3.0, 1.0)
    println(intPower)
    println(intTangent)
    let (expValue, expTangent) = jvp(s)(3.0, 1.0)
    println(expValue)
    println(expTangent)
    let (negExpValue, negExpTangent) = jvp(s)(0.0 - 3.0, 1.0)
    println(negExpValue)
    println(negExpTangent)
    return 0
}