// The control the naming case needs: `extent_of_names_the_open_position.cml` says which position
// is open, and this program fills exactly that position -- and the call answers.
//
//   `float[?]`   refused with "position 0 is open: it has no number written in it"
//                -> `extent_of::<float[3]>()` answers `[3]`
//   `float[...]` refused with "position 0 is open: `..` states no dimension there, so no position
//                has a length to read" -> `extent_of::<float[2, 3]>()` answers `[2, 3]`
//
// Measured 2026-11-05 on `f08951def` (host `88zjwei`): both refusals exit 1 with those sentences,
// and these two calls exit 0 with these two lists. A sentence that named a position which is not
// the one holding the missing number would still satisfy the text pin in the negative entry -- the
// entry pins the words -- and it could not make the number come back here. That is what makes the
// named position the repairing one and not a decoration.

func the_open_extent_filled(): int[] {
    return extent_of::<float[3]>()
}

func the_open_rank_filled(): int[] {
    return extent_of::<float[2, 3]>()
}

func main(): int sync {
    println(the_open_extent_filled())
    println(the_open_rank_filled())
    return 0
}