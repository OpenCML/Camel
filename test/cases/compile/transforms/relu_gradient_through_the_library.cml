// `relu`'s gradient through the library's own rules: the first operator given one, and the same mask
// as the engine.
//
// The deletion audit asks that every operator the engine can differentiate carry a rule of the
// library's own, and `relu` is the first one filled: `stdlib/rulesets/jvp.cml#jvp_relu`
// `stdlib/rulesets/transpose.cml#relu_t`. Before them this program stopped where the lift looks a
// forward rule up, and said so:
//
//     REINTERP jvp function=total skip=rule uri=tensor:relu reason=the operator has no forward rule bound at all
//     transforms: jvp has no forward rule for `tensor:relu` (the operator has ...)
//
// With them the same program runs and the reading names them instead:
//
//     REINTERP jvp function=total graph=... rules=jvp_relu,jvp_sum
//     REINTERP split function=jvp_of_total forward=... backward=... residuals=2
//     TRANSPOSE function=split_of_jvp_of_total_backward contribution=0 node=6 type=bool[...] space=none from=7
//     TRANSPOSE function=split_of_jvp_of_total_backward graph=... type=(float) => (float[],) nodes=13 arms=0 rhs=sum_stated_t,mul_stated_t
//
// The two `TRANSPOSE` lines are what makes the rules work, and they are the reason the forward rule
// is written `mul_stated(where(x > 0, 1, 0), dx, shape(x), shape(x))` rather than
// `where(x > 0, dx, 0)`: the mask depends on `x` alone, so `split` computes it in the forward half
// (the `contribution=0 node=6 type=bool[...]` line is the comparison being carried as a value, not
// transposed), and the linear half is one `mul_stated`. The product is stated and not bare because
// its second operand is the tangent: `float[]` states no extents, so `mul_tensor_t` cannot read the
// shape of the position it answers for, and the walk refused exactly that step by name
// (`skip=parameter-shape uri=tensor:multiply`). The three-operand form puts `where` itself in the
// linear half, and the walk refuses any node with three normal operands before it looks a rule up
// (`skip=arity uri=tensor:where operands=3`, measured).
//
// The number is the engine's, element for element (`relu_gradient_through_the_engine.cml`):
//
//     x = [-2.0, 0.0, 3.0, -0.5]   ->   d/dx = [0.0, 0.0, 1.0, 0.0]
//
// The boundary is the point of keeping both cases: the library's mask is `x > 0` and the engine's is
// `y > 0`, which are the same set, so the input zero has slope zero on both sides -- measured, not
// argued.
//
// ---- how the walk turns the product round ----
//
// The `sum` step turns around because its forward rule states the extents (`jvp_sum` calls
// `sum_stated(dxs, shape(xs))`) and the walk applies `sum_stated_t`, which reads that list and
// nothing of `dxs`. The product turns around the same way, and that is what `mul_stated` is for:
// `mul_stated_t` reads the two lists the forward rule wrote -- `shape(x)` twice here -- and reduces
// each cotangent to its own operand's shape with `sum_to`, so neither answer has to ask a position
// that has no value on this side for its shape. The mask is a value the backward half reads off the
// close-over `x`, and the closure-member rules answer that step: a closed-over member takes no
// cotangent, so the walk does not ask the product's law for the mask's **own** cotangent and only
// the tangent's comes back.
//
//     camel test/cases/compile/transforms/relu_gradient_through_the_library.cml
import { vjp } from vjp
import { relu, sum } from tensor

/// The library's spelling: the differentiated value is an ordinary parameter (design principles 9.9).
func total(x: float[]): float {
    return sum(relu(x))
}

func main(): int sync {
    let (value, pullback) = vjp(total)([-2.0, 0.0, 3.0, -0.5] as float[])
    let cotangents = pullback(1.0)
    let d = cotangents.0
    `relu library value={} dL/dx={}`->format<value, d>->println
    return 0
}