// A function that calls another one: `f` calls `g` twice, and `g` is a function of its own.
//   g(x) = x * x
//   f(x) = g(x) + g(x)          ==   2 * x*x
//   f(3) = 18,  f'(3) = 4x = 12
// `jvp` has to lift `g` as well -- a call carries `(value, tangent)` in and out -- and it has to
// lift it *once*: `g` is called twice here, and two calls of one function are one graph.
import rulesets.jvp
import { jvp } from transforms

func g(x: float): float {
    return x * x
}

func f(x: float): float {
    return g(x) + g(x)
}

func main(): int sync {
    let (value, tangent) = jvp(f)(3.0, 1.0)
    println(value)
    println(tangent)
    return 0
}