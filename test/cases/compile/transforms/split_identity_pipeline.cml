// The identity graph, as a case: the forward transform of `f(x) = x` is two parameter ports and one
// tuple fill (the value and its tangent, in and out), so `split` of it has nothing to move -- and
// that is exactly what makes it the first readout. The forward half must give the value the caller
// passed (3.0) and no residuals at all, and the backward half must give the tangent back (1.0). A
// residual here would mean a value was carried across the cut that the backward half does not need,
// which is the defect this case exists for.
//
// The spelling is `jvp(g)` -- `reinterp<jvp>(f)` as a call, which is what the operator half of
// modules/transforms is (jvp_operator.h) -- because `transforms::reinterp::<jvp>(g)`, the spelling
// the design writes for the eventual pass, has no kernel behind it yet (stdlib/transforms.cml
// declares it and no module registers it). The readings do not change with the spelling: they are
// about the graph the transform hands back.
//
// Gated the same way as the other three (test/tools/have-split.mjs): while `split` does not exist
// the plan skips, so this case is not red for a reason that is not a defect.
import rulesets.jvp
import { jvp, split } from transforms

func g(x: float): float {
    return x
}

/// How many values the residuals tuple holds, counted where the program is compiled: `indices` walks
/// a tuple's positions, and the empty tuple has none. (There is no `len` for a tuple, and a count
/// taken from the value is what the reading is about.)
func residual_count::<R>(r: R): int {
    return static loop acc = 0 for j in indices r do acc + 1
}

func main(): int sync {
    let f = jvp(g)
    let (fwd, lin) = split(f)
    let (y, r0) = fwd(3.0)
    println("identity y=", y)
    println("residual count=", residual_count(r0))
    let dy = lin(r0, 1.0)
    println("identity dx1=", dy)
    return 0
}