/**
 * A weight the program holds as an ordinary parameter of a lambda keeps its direction when the
 * lifted body calls a function that reads that weight through a `with` parameter.
 *
 * `vjp` differentiates the ordinary parameters only, so a weight that is a `with` value is moved
 * onto one -- `f = (ww) => weighted<ww>(2.0)` -- and the library's composition is
 * `transpose(split(jvp(f)))`. The lift of `f` then meets a *call* of `weighted` whose `with`
 * argument is the lambda's own parameter, which is a value the lifted body carries a direction for.
 * Before 2026-11-04 the lifted call handed `jvp_of_weighted` the value of `ww` and the zero the
 * lifted signature leaves a `with` parameter's tangent to be (`jvpSignature`: "the pair is not
 * written for a `with` parameter at all"), so `weighted`'s lifted chain was constant in the weight,
 * its `lin` was the zero map, and the composition answered `value=9.0 grad=0.0` where the engine
 * answers 3.0 -- a wrong number on the library's leg of the parity table, not a refusal, which is
 * why it is pinned here rather than described.
 *
 * The second line puts the same call's other member on an ordinary parameter, so the two sources of
 * derivative are told apart by their numbers: `weighted<3.0>(t)` is `3t + 3`, whose cotangent is
 * `6.0` for the weight (`t + 1`) and `3.0` for `t` (the weight). A dropped weight direction shows
 * as one wrong member, not as a line that is wrong as a whole.
 *
 * The third line is the other half of the same argument list. A lifted call's arguments are
 * `(...values, ...their tangents)` (`jvpSignature`, author 2026-11-03), and the lift used to write
 * each value beside its own tangent as it walked the call's inputs: `(v1, d1, v2, d2)` into a callee
 * that reads `(v1, v2, d1, d2)`. One parameter hid it -- the two orders agree -- and two did not:
 * `split` reads the seam at `count / 2` and refused with "the value half reads the tangent of
 * parameter 0, which the forward half does not take". `mulxy` has two parameters and no `with`
 * value, so it pins the order alone: `mulxy(3.0, 2.0) = 6.0`, `d/dx = y = 2.0`, `d/dy = x = 3.0`.
 */

import { grad } from autodiff
import { vjp } from vjp

// `d/dy (x*y + x) = x`, so the engine answers 3.0 at a weight of 3.0.
with <x: float>
func weighted(y: float): float {
    return x * y + x
}

func mulxy(x: float, y: float): float {
    return x * y
}

func main(): int sync {
    // The engine's leg, for the number the library's leg has to match.
    let engine = grad(weighted)<3.0>(2.0)

    // The library's leg: the weight on an ordinary parameter of a lambda.
    let (value, pullback) = vjp((ww: float): float => weighted<ww>(2.0))(3.0)
    let library = pullback(1.0).0
    'weighted engine={} value={} grad={}'->format<engine, value, library>->println

    // The same call with the number on an ordinary parameter too: one member per source of
    // derivative, and the two members differ.
    let (both, bothPullback) = vjp((ww: float, t: float): float => weighted<ww>(t))(3.0, 5.0)
    'both value={} pullback={}'->format<both, bothPullback(1.0)>->println

    // A call of a two-parameter function inside a lifted body.
    let (twoValue, twoPullback) = vjp((rr: float, ss: float): float => mulxy(rr, ss))(3.0, 2.0)
    'twoparam value={} pullback={}'->format<twoValue, twoPullback(1.0)>->println
    return 0
}
