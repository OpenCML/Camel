/**
 * The whole-tensor `argmax` and `argmin`, batched: their answer is the position counted in row-major
 * order over the whole row, and no fold of axis positions produces that number -- a fold of a row's
 * axes hands back a position per axis (`argmax` of a `float[2, 3]` row is 5, not `[1, 2]`). What does
 * produce it is the row's own elements laid on one line: `reshape<[shape(xs)[0], -1]>(xs)` reads the
 * batch as `[rows, -1]`, so its *last* axis counts exactly one row's elements and a position along it
 * is the position over that row. The rule is therefore a reshape and a reduction of the last axis,
 * with no fold at all (`stdlib/rulesets/vmap.cml`, `vmap_argmax`).
 *
 * Each batched answer is printed beside the row-by-row `array.vmap` of the same function, so what a
 * reader sees is a comparison and not a promise: three rows `[1, 2, 3]`, `[4, 9, 6]` and `[7, 8, 5]`
 * answer `[2, 1, 1]` for the maximum and `[0, 0, 2]` for the minimum, and a row of two axes is read
 * as one line too -- `[[1, 5], [3, 2]]` puts its maximum at position 1, `[9, 1]` at 0.
 *
 * The reading adds the rule's name and the element the rule's instance was made at:
 * `asked=1 found=1 missing=0 rules=vmap_rule_argmax elements=float`. It was `asked=1 found=0
 * missing=1` while the operator had no key, and the fault named it.
 */
import rulesets.vmap
import { vmap as row_vmap } from array
import { argmax, argmin } from tensor
import { vmap } from transforms

func row_argmax(x: float[3]): int {
    return argmax(x)
}

func row_argmin(x: float[3]): int {
    return argmin(x)
}

// A row of two axes: its position is counted over the row as one line, not per axis.
func plane_argmax(x: float[2, 2]): int {
    return argmax(x)
}

func main(): int sync {
    let xs: float[3, 3] = [[1.0, 2.0, 3.0], [4.0, 9.0, 6.0], [7.0, 8.0, 5.0]]
    println(vmap(row_argmax)(xs))
    println(row_vmap(row_argmax)(xs))
    println(vmap(row_argmin)(xs))
    println(row_vmap(row_argmin)(xs))

    let planes: float[2, 2, 2] = [[[1.0, 5.0], [3.0, 2.0]], [[9.0, 1.0], [2.0, 3.0]]]
    println(vmap(plane_argmax)(planes))
    println(row_vmap(plane_argmax)(planes))
    return 0
}