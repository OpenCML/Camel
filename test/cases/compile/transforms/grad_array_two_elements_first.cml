// two elements, one read: xs[0] over [3.0, 2.0]
import rulesets.jvp
import rulesets.transpose
import { vjp } from vjp

func g(xs: float[]): float {
    return xs[0]
}

func main(): int sync {
    let (value, pullback) = vjp(g)([3.0, 2.0])
    println(value)
    let cotangents = pullback(1.0)
    println(cotangents.0)
    return 0
}
