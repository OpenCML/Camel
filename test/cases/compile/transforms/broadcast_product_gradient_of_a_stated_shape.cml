// A **broadcasting** product's gradient, with both shapes written into the types: the clock for the
// one spelling of `mul_tensor_t` that would answer a wrong shape.
//
// `tensor:multiply` is element-wise, but its two operands need not have the same shape -- the engine
// broadcasts, so `x: float[3]` times `w: float[1]` is a `float[3]`. The adjoint of a broadcast is a
// reduction (`sum_to`), and the shape it reduces to is **each operand's own**:
// `modules/tensor/ops/vjp.cpp#accumulateOperand` hands `sum_to` the operand itself, which it can do
// because the pullback holds the primal value.
//
// Hand first: `x = [1.0, 2.0, 3.0]`, `w = [2.0]`, product `[2.0, 4.0, 6.0]`, `value = 12.0`.
// `sum`'s adjoint is one for every lane, so the cotangent arriving at the product is
// `[1.0, 1.0, 1.0]`, and
//
//     d/dx = broadcast(w) = [2.0, 2.0, 2.0]   (numel 3, x's shape)
//     d/dw = sum(ct * x)  = [6.0]             (numel 1, w's shape)
//
// **This case is the clock for a plausible wrong fix.** `mul_tensor_t` could be written to read the
// operand each side is *not* answering for -- `sum_to(ct * w, w)` for `x` -- which is right exactly
// while the two shapes are equal and is what a reader reaching for "read a value the caller carries"
// will try. Measured 2026-11-04 on a broadcasting product, that spelling answers
//
//     d/dx numel=1 d/dx=[6.0]            d/dw numel=3 d/dw=[1.0, 2.0, 3.0]
//
// which is this case's numbers transposed and both shapes wrong, and no case in `test/plans/`
// covered a broadcasting product before this one. `sum_to`'s second argument is the *target shape*,
// so only the operand whose cotangent is being built can be it; and "the two shapes are equal" is
// invisible on an open rank, which is why the open-rank twin
// (`broadcast_product_gradient_of_an_open_rank.cml`) still refuses by name.
//
// Both legs are printed and pinned: the engine's (`grad`) and the library's (`vjp`).
//
//     engine d/dx numel=3 d/dx=[2.0, 2.0, 2.0]
//     engine d/dw numel=1 d/dw=[6.0]
//     library value=12.0 d/dx numel=3 d/dx=[2.0, 2.0, 2.0] d/dw numel=1 d/dw=[6.0]
//
//     camel test/cases/compile/transforms/broadcast_product_gradient_of_a_stated_shape.cml
import { grad } from autodiff
import { numel, sum } from tensor
import { vjp } from vjp

/// The engine's route for `d/dx`: the differentiated value is the `with` parameter.
with <x: float[3]>
func total_x(): float {
    return sum(x * ([2.0] as float[1]))
}

/// The engine's route for `d/dw`: the same function with the other operand differentiated.
with <w: float[1]>
func total_w(): float {
    return sum(([1.0, 2.0, 3.0] as float[3]) * w)
}

/// The library's route: both operands are parameters, so one `vjp` answers both cotangents.
func total(x: float[3], w: float[1]): float {
    return sum(x * w)
}

func main(): int sync {
    let gx = grad(total_x)
    let ex = gx<[1.0, 2.0, 3.0] as float[3]>()
    `engine d/dx numel={} d/dx={}`->format<numel(ex), ex>->println
    let gw = grad(total_w)
    let ew = gw<[2.0] as float[1]>()
    `engine d/dw numel={} d/dw={}`->format<numel(ew), ew>->println
    let (value, pullback) = vjp(total)([1.0, 2.0, 3.0] as float[3], [2.0] as float[1])
    let (dx, dw) = pullback(1.0)
    `library value={} d/dx numel={} d/dx={} d/dw numel={} d/dw={}`->format<value, numel(dx), dx, numel(dw), dw>->println
    return 0
}