// A vector on the left of a product: `v · w`, and the cotangent of both operands.
//
// `matmul` reads a rank-one left operand as a row and drops that axis from the answer
// (`modules/tensor/kernels/gemm.cpp#planMatmul`), so the product here is (n) and the cotangent that
// comes back is a row. The cotangent of `v` is then `ct · wᵀ` -- the same product again, at `v`'s
// rank -- while the cotangent of `w` is the outer product `v ⊗ ct`, which is what `sum_to` builds in
// the lanes `wᵀ` already has (`stdlib/rulesets/transpose.cml#ct_of_b`).
//
// The literals are exact in binary, so every number below is exact:
//
//     v = [1, 2],  w = [[0.5, 0.25], [0.125, 1.0]]
//     v · w = [1·0.5 + 2·0.125, 1·0.25 + 2·1.0] = [0.75, 2.25]        sum = 3.0
//     dL/dv = ct · wᵀ = [w[0][0] + w[0][1], w[1][0] + w[1][1]] = [0.75, 1.125]
//     dL/dw = v ⊗ ct = [[1, 1], [2, 2]]
//
// (`dL/dv` reads `w` by its *first* index, which is why it is the row sums of `w` and not the column
// sums: `matmul` contracts a row operand's extent against the matrix's first axis. The engine's own
// pullback answers the same three numbers, and `max_abs_diff` below says so to twelve places.)
//
//     camel test/cases/compile/transforms/matmul_transpose_vector_lhs.cml
import { matmul, sum } from tensor
import { vjp } from vjp
import { with_grad } from autodiff
import { abs, max } from math

/// The product under a sum, both operands ordinary parameters.
func sum_of_product(v: float[], w: float[2, 2]): float {
    return sum(matmul(v, w))
}

/// The same for the engine's pullback over `w`.
with <w: float[2, 2]>
func product_with_w(v: float[]): float {
    return sum(matmul(v, w))
}

/// And once over `v`, which is the rank-one half of the same law.
with <v: float[]>
func product_with_v(w: float[2, 2]): float {
    return sum(matmul(v, w))
}

func main(): int sync {
    let v = [1.0, 2.0]
    let w = [[0.5, 0.25], [0.125, 1.0]] as float[2, 2]

    let (value, pullback) = vjp(sum_of_product)(v, w)
    let (dv, dw) = pullback(1.0)
    `matmul_t vector_lhs value={} dL/dv={} dL/dw={}`->format<value, dv, dw>->println

    let (engine_value_w, engine_w) =
        with_grad(product_with_w)<[[0.5, 0.25], [0.125, 1.0]] as float[2, 2]>(v)
    let (engine_value_v, engine_v) = with_grad(product_with_v)<[1.0, 2.0]>(w)
    `matmul_t vector_lhs engine value={} dL/dw={} dL/dv={}`
        ->format<engine_value_w, engine_w, engine_v>->println
    `matmul_t vector_lhs engine_v value={}`->format<engine_value_v>->println

    let dvalue = abs(value - engine_value_w)
    let dv0 = abs(dv[0] - engine_v[0])
    let dv1 = abs(dv[1] - engine_v[1])
    let dw00 = abs(dw[0][0] - engine_w[0][0])
    let dw01 = abs(dw[0][1] - engine_w[0][1])
    let dw10 = abs(dw[1][0] - engine_w[1][0])
    let dw11 = abs(dw[1][1] - engine_w[1][1])
    let dw_diff = max(max(dw00, dw01), max(dw10, dw11))
    `matmul_t vector_lhs max_abs_diff_library_vs_engine v={:.12e} w={:.12e} value={:.12e}`
        ->format<max(dv0, dv1), dw_diff, dvalue>->println
    return 0
}