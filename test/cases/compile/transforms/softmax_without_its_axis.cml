/**
 * `softmax` whose axis is left to the declaration's default has no forward law, and it must say so
 * rather than answer the last axis.
 *
 * `softmax(t, axis?: int)` defaults the axis to `-1`, so a call that writes none carries one port --
 * the tensor -- while `softmax<2>(x)` carries two, the tensor and the axis. A rule's parameters are
 * the operator's ports, so no single law can name both spellings: one that writes `softmax<1>` needs
 * the port to compare its constant against, and one that names `axis` needs a port to bind. The law
 * names the axis (`stdlib/rulesets/jvp.cml#jvp_softmax`), so the spelling with the axis omitted is
 * refused at the port count.
 *
 * The refusal is the point. Design principles 9.9: a missing rule must refuse at compile time and
 * name the operator; running and answering the last axis because that is what the default is would
 * be a belief about a configuration the graph does not state.
 *
 * The number this program would answer if it were lifted is not pinned, because the run stops before
 * the first number: `y = softmax(x)` is `[[0.25, 0.25], [0.25, 0.25]]` on the operand below, and the
 * tangent along `dx` would be `y * (dx - sum<1, true>(y * dx))`.
 */
import rulesets.jvp
import { softmax, sum } from tensor
import { jvp } from transforms

func loss_softmax_default(x: float[...]) => float {
    return sum(softmax(x) * ([[1.0, 2.0], [3.0, 4.0]] as float[2, 2]))
}

func main() => int sync {
    let (value, tangent) = jvp(loss_softmax_default)(
        [[1.0, 1.0], [1.0, 1.0]] as float[2, 2],
        [[1.0, 0.0], [0.0, 0.0]] as float[2, 2]
    )
    'softmax-no-axis value={} tangent={}'->format<value, tangent>->println
    return 0
}
