// A boolean in the middle of a differentiable graph: `f(x) = let b = x > 0.0; if b then x*x else 0.5x`.
//
// On paper the branch picks `x*x` at a positive `x`, so `f(2) = 4` and the pullback of 1.0 is `2x = 4`.
// The claim this case is here to check is narrower than the number: the condition is a `bool`, a
// boolean is not a differentiable value, and the reading must say so rather than stay silent about it.
// `b` contributes nothing to the derivative -- not because the branch is skipped, but because a
// comparison's result is a choice, not a magnitude.
//
// The reading that is expected names it: `contribution=0 ... type=bool space=none`, beside the `arms=2`
// the branch already prints. A transposed graph that answered 0 here, or refused, would both be wrong:
// 0 because the arm that ran is a real chain, and a refusal because a condition is a value the
// transform copies rather than differentiates.
//
// The transpose is asked twice, at cotangent 1 and at cotangent 2, so the answer has to be 4 then 8 --
// proportional to the cotangent, and 8 is a number no forward line prints.
import { transpose } from transforms
import rulesets.transpose

func f(x: float): float {
    let b = x > 0.0
    if b then {
        return x * x
    } else {
        return 0.5 * x
    }
}

func main(): int sync {
    println(f(2.0))
    let back = transpose(f)
    println(back(2.0, 1.0))
    println(back(2.0, 2.0))
    return 0
}