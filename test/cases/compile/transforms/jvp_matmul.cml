// The forward rule of `matmul`: `d(a · b) = da · b + a · db`. Every number below can be done by hand.
//
//   A = [[1, 2], [3, 4]]      x = (1, 2)      dx = (1, 0) then (0, 1)
//
//   A · x  = (1·1 + 2·2, 3·1 + 4·2) = (5, 11)      -> value 5
//   A · dx = (1, 3) with dx = (1, 0)               -> tangent 1
//   A · dx = (2, 4) with dx = (0, 1)               -> tangent 2
//
// Both readings move the second operand, whose rule term is `a · db`; the first operand here is the
// constant `A`, so its term is zero. The reading that would separate `da · b` cannot be taken
// through `jvp` yet, and the wall is no longer the constant's tangent: the lift writes the zero of
// an array type now, so `A`'s `float[2, 2]` zero is a node and the walk goes on past `matmul`. What
// stops it is the index that reads one element of the product -- `matmul(A, x)[0]`, where the value
// is a `float[..]` and `jvp_idx_arr` is written for a rank-one `T[]`, so `jvp` refuses
// `:op/idx_arr` by naming the two port lists. The rule is written with both terms anyway, so that
// the day the lift carries an array operand's tangent the rule is right; this case locks the half
// that can be read today.
import { matmul } from tensor
import rulesets.jvp
import { jvp } from transforms

func quadratic(x: float[..]): float {
    return matmul([[1.0, 2.0], [3.0, 4.0]] as float[2, 2], x)[0]
}

func main(): int sync {
    let x = [1.0, 2.0] as float[]
    let e0 = [1.0, 0.0] as float[]
    let e1 = [0.0, 1.0] as float[]
    let (v0, d0) = jvp(quadratic)(x, e0)
    let (v1, d1) = jvp(quadratic)(x, e1)
    `jvp matmul dx=(1,0) value=${v0:.4f} tangent=${d0:.4f}`->println
    `jvp matmul dx=(0,1) value=${v1:.4f} tangent=${d1:.4f}`->println
    return 0
}