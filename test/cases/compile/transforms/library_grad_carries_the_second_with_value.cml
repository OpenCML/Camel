/**
 * The library's `grad` and the engine's `grad` on the one shape that tells them apart: a function
 * with **two** `with` values, differentiated once, with the two numbers compared as text.
 *
 * `stdlib/vjp.cml#grad` is a composition -- `vjp` read at the seed 1 -- and it takes the first
 * `with` value as its weight while the rest of the list travels on the derivative
 * (`GradientOf<F>`, `stdlib/types.cml`). A function with one `with` value cannot show that the rest
 * is carried, because there is no rest: this case has the two values the case study's loss has, one
 * that is the weight (`w`) and one the body reads and nothing differentiates (`scale`), plus one
 * ordinary parameter for the data.
 *
 * Written down before the run:
 *
 *   loss(data) = (w * data) * scale     at w = 2, data = 4, scale = 3
 *   d/dw = data * scale = 12
 *
 * The engine reads the two `with` values in declaration order and the ordinary parameters after
 * them (`grad(loss)<2.0, 3.0>(4.0)`); the library reads the weight as its first ordinary parameter
 * and keeps the second `with` value in the angle brackets (`grad(loss)<3.0>(2.0, 4.0)`). Both lines
 * print 12.0, and the third line prints the subtraction of the two -- 0.0, not "close to zero" --
 * because the point of the pair is that the two gradients are the same number and not two
 * neighbouring ones. An implementation that carried `scale` at another value, or that
 * differentiated `scale` instead of `w` (`d/dscale = w * data = 8`, and `d/dw` with `scale` at 1
 * would be 4), or that read the weight's value as the answer (2), prints a different line.
 *
 * Nothing here needs `std::macro`: the library's side is written in the library and reaches the
 * engine's operators, so the four back ends are asked for the same program unchanged.
 */

import { grad as engine_grad } from autodiff
import { grad as library_grad } from vjp

with <w: float, scale: float>
func loss(data: float): float {
    return (w * data) * scale
}

func main(): int sync {
    // d/dw = data * scale = 12, the engine's reading: both `with` values in declaration order.
    let engine = engine_grad(loss)<2.0, 3.0>(4.0)
    // The same 12 off the library's composition: the weight first, the second `with` value carried.
    let library = library_grad(loss)<3.0>(2.0, 4.0)
    let difference = engine - library
    println(`engine   d/dw = ${engine:.1f}`)
    println(`library  d/dw = ${library:.1f}`)
    println(`analytic d/dw = 12.0`)
    println(`engine - library = ${difference:.1f}`)
    return 0
}