// The gradient of a `take` through the library's own rules.
//
// `jvp_take` states the indices and the operand's extents in one list (`[n, i0, ..., d0, ...]`), and
// `take_stated_t` scatters each row's cotangent back where `at`'s indices say it came from, in an
// array of `at`'s extents -- a shape no operand of the linear call carries.
//
// The rows read are positions 0 and 2, so their gradient is one and the row nobody read is zero:
//
//     x = [1.0, 2.0, 3.0, 4.0]   ->   value 4.0, dL/dx = [1.0, 0.0, 1.0, 0.0]
//
//     camel test/cases/compile/transforms/stated_take_gradient.cml
import { vjp } from vjp
import { sum, take } from tensor

func total(x: float[]): float {
    return sum(take(x, [0, 2]))
}

func main(): int sync {
    let (value, pullback) = vjp(total)([1.0, 2.0, 3.0, 4.0] as float[])
    let d = pullback(1.0).0
    `stated take value={} dL/dx={}`->format<value, d>->println
    return 0
}