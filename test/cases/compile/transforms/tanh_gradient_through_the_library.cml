// The same function through the library's `vjp`, element for element against the engine's answer.
//
// Before `jvp_tanh` and `tanh_t`, this program stopped at the lift -- the library had no forward rule
// for the operator at all:
//
//     REINTERP jvp function=total skip=rule uri=tensor:tanh reason=the operator has no forward rule bound at all
//     error: transforms: jvp has no forward rule for `tensor:tanh` (the operator has no forward rule bound at all).
//
// With them it runs, and the backward half needs `tanh(x)`, a value no line of this file computes:
// the two rules recompute it from `x` alone, so the cut carries it as a residue -- the shape `exp`
// measured. The case therefore pins the numbers, the rule names, and that no `skip=` line remains.
//
// The wrong laws and the readings they would print are written out in the neighbouring engine case,
// `tanh_gradient_through_the_engine.cml`; here the criterion is that the library prints the engine's
// numbers component for component --
//
//     value = tanh(0.5) + tanh(-1.0) = -0.2994769986957551
//     d     = [0.7864477329659274, 0.41997434161402614]
//
// -- and not an aggregate, and not the value of the function it differentiates.
//
//     camel test/cases/compile/transforms/tanh_gradient_through_the_library.cml
import { vjp } from vjp
import { sum, tanh } from tensor

/// The same function as the engine case, with the differentiated value as an ordinary parameter.
func total(x: float[...]): float {
    return sum(tanh(x))
}

func main(): int sync {
    let (value, pullback) = vjp(total)([0.5, -1.0] as float[])
    let d = pullback(1.0).0
    `tanh library value={} d={}`->format<value, d>->println
    return 0
}