// `divide`'s gradient through the engine and through the library, in one program.
//
// `d(x / w)` needs both operands: `dx` is `ct / w` and `dw` is `-(ct / w) * (x / w)`. **Both are
// measured**, and this is the member of the tranche where that matters most: the second cotangent is
// where the two ways of writing the quotient rule part company. The law writes the engine's grouping
// (`divideVjp`, `modules/tensor/ops/elementwise_ops.cpp`: `dlhs = ct / w`, then `dlhs * (x / w)`,
// then the negation) and not the algebraically equal `-(ct * x) / (w * w)`, which rounds
// differently; the forward rule (`stdlib/rulesets/jvp.cml#jvp_divide`) is written so that its
// transpose produces exactly these two expressions.
//
// Both operands have the same shape here, so each answer is `sum_to(..., operand)`, the identity for
// equal shapes.
//
//     camel test/cases/compile/transforms/divide_gradient_both_legs.cml
import { grad } from autodiff
import { vjp } from vjp
import { abs, sum } from tensor

/// The engine's spelling of `d/dx`: the differentiated value is the `with` parameter.
with <x: float[...]>
func total_x(w: float[]): float {
    return sum(x / w)
}

/// The same for `d/dw`: the divisor is the `with` parameter.
with <w: float[...]>
func total_w(x: float[]): float {
    return sum(x / w)
}

/// The library's spelling: both operands are ordinary parameters.
func total_plain(x: float[], w: float[]): float {
    return sum(x / w)
}

func main(): int sync {
    let xa = [6.0, -3.0, 1.0] as float[]
    let wa = [2.0, 4.0, 8.0] as float[]
    let engine_dx = grad(total_x)<[6.0, -3.0, 1.0] as float[]>([2.0, 4.0, 8.0] as float[])
    let engine_dw = grad(total_w)<[2.0, 4.0, 8.0] as float[]>([6.0, -3.0, 1.0] as float[])
    `divide engine dx={} dw={}`->format<engine_dx, engine_dw>->println
    let (_, pullback) = vjp(total_plain)(xa, wa)
    let (library_dx, library_dw) = pullback(1.0)
    let same_x = sum(abs(engine_dx - library_dx)) == 0.0
    let same_w = sum(abs(engine_dw - library_dw)) == 0.0
    `divide: engine={} library={} same={}`->format<engine_dx, library_dx, same_x>->println
    `divide dw: engine={} library={} same={}`->format<engine_dw, library_dw, same_w>->println
    return 0
}
