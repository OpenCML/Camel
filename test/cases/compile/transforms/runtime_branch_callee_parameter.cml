// A shape the compile-time lift does not answer yet: `jvp(g)` where `g` is a *parameter*. A parameter
// is a function value only at run time, so there is no body to build from at the call, and the call
// takes the run-time path (`lifted-at=run`) exactly as it did before the lift moved.
//
// The author's ruling of 2026-11-01 makes this a compile error at the call instead of a run-time
// lift (the argument of a transform has to be a function known at build time), so this program is
// the one that will be *refused* the day that lands -- it is not a shape to write code for. Until
// then it runs and stays correct: 4.0 and 4.0, the square and its derivative at 2.
import rulesets.jvp
import { jvp } from transforms

func square(x: float): float {
    return x * x
}

func lift(g: (x: float) => float, x: float): (float, float) {
    return jvp(g)(x, 1.0)
}

func main(): int sync {
    let (value, tangent) = lift(square, 2.0)
    println("value=", value, " tangent=", tangent)
    return 0
}