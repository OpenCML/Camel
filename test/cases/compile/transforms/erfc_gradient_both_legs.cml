// `erfc`'s gradient through the engine and through the library, in one program.
//
// `d(erfc(x)) = -2/sqrt(pi) * exp(-x*x) * dx`: the same slope as `erf` with the sign flipped, which
// is exactly how the engine writes it -- `erfcVjp` (`modules/tensor/ops/elementwise_ops.cpp`) is
// `erf_grad(x, neg(dy))`, so its answer is `((-dy) * kScale) * exp(-x*x)`.
//
// **The sign is applied in the multiplication, not to the answer**, and the two are the same bits:
// `(-a) * b` and `-(a * b)` differ in no bit, because a float's sign is its own bit and the
// magnitude is the same product. The law therefore writes `(ct * -kScale) * exp(...)` -- the
// engine's grouping with its negation folded into the constant -- and not `-(ct * kScale) * exp(...)`,
// which would answer the same numbers through a different graph (`stdlib/rulesets/transpose.cml#erfc_t`).
//
// The input goes through zero, where `erfc`'s slope is at its largest, and the sign of every lane
// separates this law from `erf`'s.
//
// **The shape is stated, and that is not decoration.** The library half of this program takes
// `float[4]`: `mul_tensor_t`'s answer reduces the cotangent to its operand's shape with `sum_to`,
// and a shape is a value the transposed function only has when the parameter's *type* states it.
// Measured on this tree with `float[..]` instead: the engine leg prints its array and the library
// leg stops at
//
//     skip=cotangent-needs-a-value uri=tensor:multiply position=0 reason=the rule's right side reads a value the caller does not carry
//
// -- the same wall `exp`, `sigmoid`, `tanh` and `relu` meet on this tree today
// (`exp_gradient_through_the_library` and its three neighbours pin it, and the reason is the same in
// all four: a slope the tangent multiplies by is a value the backward half has to be handed). A
// parameter whose shape the type states is answered from the type, so the law is the whole law.
//
//     camel test/cases/compile/transforms/erfc_gradient_both_legs.cml
import { grad } from autodiff
import { vjp } from vjp
import { abs, erfc, sum } from tensor

/// The engine's spelling: the differentiated value is the `with` parameter (design principles 9.9).
with <x: float[..]>
func total(): float {
    return sum(erfc(x))
}

/// The library's spelling: the same function with the value as an ordinary parameter.
func total_plain(x: float[4]): float {
    return sum(erfc(x))
}

func main(): int sync {
    let engine = grad(total)<[0.5, 0.0, -1.25, -2.0] as float[]>()
    `erfc engine={}`->format<engine>->println
    let (_, pullback) = vjp(total_plain)([0.5, 0.0, -1.25, -2.0] as float[4])
    let library = pullback(1.0).0
    let same = sum(abs(engine - library)) == 0.0
    `erfc: engine={} library={} same={}`->format<engine, library, same>->println
    return 0
}