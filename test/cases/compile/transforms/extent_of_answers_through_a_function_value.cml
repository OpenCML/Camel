// A value of `extent_of::<A>` answers too. The type argument is in hand where the value is made,
// so the function the value stands for returns the constant: a call of it answers what the call it
// was made from would have answered.
//
// Three spellings, and each one used to be the kernel's own case (an OPER node with no type
// argument left in it): the value with its type written out, the value called twice -- the type
// argument belongs to the value, not to one call of it -- and the operator handed to a function
// that takes it as a parameter.
func counts(g: () => int[]): int {
    return len(g())
}

func main(): int sync {
    let stated: () => int[] = extent_of::<float[3]>
    println(stated())
    let twice = extent_of::<float[2, 3]>
    println(twice())
    println(twice())
    println(counts(extent_of::<float[4]>))
    return 0
}