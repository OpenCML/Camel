// The gradient, the day the library is written: `f(x) = x*x*x`, so `f(3) = 27` and `f'(3) = 27`.
// `vjp(f)(3.0, 1.0)` is the pair `(27.0, 27.0)` and `grad(f)(3.0)` is `27.0`, both from the
// library's own composition -- `transpose(split(reinterp<jvp>(f)))` -- and not from the C++
// autodiff. Skipped while `split` has no implementation (the plan's `skip_unless`).
import { grad, vjp } from vjp

func f(x: float): float {
    return x * x * x
}

func main(): int sync {
    let (value, tangent) = vjp(f)(3.0, 1.0)
    println(value)
    println(tangent)
    println(grad(f)(3.0))
    return 0
}