// A broadcasting product's gradient with the shapes left **open**: the refusal that says why the
// library cannot answer it, and the case that would catch the plausible wrong fix.
//
// Same program as `broadcast_product_gradient_of_a_stated_shape.cml` with `float[..]` in place of
// `float[3]` and `float[1]`. Hand, exactly as there: `x = [1.0, 2.0, 3.0]`, `w = [2.0]`,
//
//     value = 12.0
//     d/dx  = broadcast(w) = [2.0, 2.0, 2.0]   (numel 3, x's shape)
//     d/dw  = sum(ct * x)  = [6.0]             (numel 1, w's shape)
//
// The engine answers both of those today (`accumulateOperand` hands `sum_to` the operand itself,
// which it can do because its pullback holds the primal values). The library cannot: the walk asks
// `stdlib/rulesets/transpose.cml#mul_tensor_t` for the tangent's cotangent, the law's `sum_to` reads
// that operand for its shape, the operand is a tangent, and `float[..]` states no extents --
// `shapeCarrierOf` answers only a stated type (author, 2026-11-03 16:15). Measured 2026-11-04:
//
//     TRANSPOSE function=split_of_jvp_of_total_backward skip=cotangent-needs-a-value uri=tensor:multiply position=0 reason=the rule's right side reads a value the caller does not carry
//     transforms: transpose has no transpose for this function: a parameter holds no cotangent: nothing uses its value.
//
// Why this case exists and must stay: the `known_fail` above is the honest reading, but the tempting
// "fix" is to make each side of the law read the operand it is **not** answering for
// (`sum_to(ct * w, w)`), which removes the refusal and answers a wrong shape on exactly this program
// -- measured 2026-11-04, that spelling answers `d/dx numel=1 d/dx=[6.0]` and
// `d/dw numel=3 d/dw=[1.0, 2.0, 3.0]` here. `sum_to`'s second argument is the *target shape*, so it
// can only be the operand whose cotangent is being built; and "the two shapes are equal" is
// invisible on an open rank, so no spelling is safe for both. This case is the clock: it goes green
// only when the library can answer a broadcast adjoint, and it goes to the wrong numbers if the law
// is bent instead.
//
//     camel test/cases/compile/transforms/broadcast_product_gradient_of_an_open_rank.cml
import { numel, sum } from tensor
import { vjp } from vjp

func total(x: float[..], w: float[..]): float {
    return sum(x * w)
}

func main(): int sync {
    let (value, pullback) = vjp(total)([1.0, 2.0, 3.0] as float[..], [2.0] as float[..])
    let (dx, dw) = pullback(1.0)
    `open value={} d/dx numel={} d/dx={} d/dw numel={} d/dw={}`->format<value, numel(dx), dx, numel(dw), dw>->println
    return 0
}