// `erf`'s gradient through the engine and through the library, in one program.
//
// `d(erf(x)) = 2/sqrt(pi) * exp(-x*x) * dx`. The slope depends on `x` alone, so the library's law
// names a **recomputed** forward value and nothing of the operator's own output: `erf`'s tangent
// recomputes `exp(-x*x)` (`stdlib/rulesets/jvp.cml#jvp_erf`), and the cut carries it into the
// backward half the way it carries `exp`'s own recomputation.
//
// **The grouping is the engine's, because the two legs are compared bit for bit.** The engine's
// `erfGrad` (`modules/tensor/kernels/gradient.cpp#erfGradArm`, f64 arm) writes
//
//     po[i] = pg[i] * kScale * std::exp(-px[i] * px[i]);
//
// with `kScale = 1.1283791670955126`, which is `(dy * kScale) * exp(...)`. A law that wrote the
// mathematically equal `ct * (kScale * exp(...))` would round in a different place and disagree in
// the last place, so the forward rule chains the two products in the order whose **transpose** is
// the engine's: `(dx * exp(...)) * kScale` transposes to `(ct * kScale) * exp(...)`. `-x*x` and
// `(x*x) * -1.0` are the same bits -- negation is exact -- so the exponential's argument is the
// kernel's.
//
// Three lanes, all of them with a slope a reader can separate from the two likeliest wrong laws:
// the identity (`ct`, answering `[1.0, 1.0, 1.0]`) and the slope at the wrong point (`ct * x`).
//
// **The shape is stated, and that is not decoration.** The library half of this program takes
// `float[4]`: `mul_tensor_t`'s answer reduces the cotangent to its operand's shape with `sum_to`,
// and a shape is a value the transposed function only has when the parameter's *type* states it.
// Measured on this tree with `float[..]` instead: the engine leg prints its array and the library
// leg stops at
//
//     skip=cotangent-needs-a-value uri=tensor:multiply position=0 reason=the rule's right side reads a value the caller does not carry
//
// -- the same wall `exp`, `sigmoid`, `tanh` and `relu` meet on this tree today
// (`exp_gradient_through_the_library` and its three neighbours pin it, and the reason is the same in
// all four: a slope the tangent multiplies by is a value the backward half has to be handed). A
// parameter whose shape the type states is answered from the type, so the law is the whole law.
//
//     camel test/cases/compile/transforms/erf_gradient_both_legs.cml
import { grad } from autodiff
import { vjp } from vjp
import { abs, erf, sum } from tensor

/// The engine's spelling: the differentiated value is the `with` parameter (design principles 9.9).
with <x: float[..]>
func total(): float {
    return sum(erf(x))
}

/// The library's spelling: the same function with the value as an ordinary parameter.
func total_plain(x: float[4]): float {
    return sum(erf(x))
}

func main(): int sync {
    let engine = grad(total)<[0.5, 1.0, -0.75, 2.0] as float[]>()
    `erf engine={}`->format<engine>->println
    let (_, pullback) = vjp(total_plain)([0.5, 1.0, -0.75, 2.0] as float[4])
    let library = pullback(1.0).0
    let same = sum(abs(engine - library)) == 0.0
    `erf: engine={} library={} same={}`->format<engine, library, same>->println
    return 0
}