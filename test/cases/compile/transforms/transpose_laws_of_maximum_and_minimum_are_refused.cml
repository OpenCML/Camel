// The two cotangent laws a bare `transpose` never gets to read: `maximum_t` and `minimum_t`.
//
// Neither law can be read today, at any rank a program can spell, and this case is the measurement
// rather than a cover for it:
//
//   - At the ranks a program actually writes (`x` and `w` both `float[3]`) the walk finds the law
//     and the law's own cotangent refuses to instantiate: `skip=rule-ranks uri=tensor:maximum
//     rule=maximum_t node=2 position=0 ranks=(1, 1) operands=2 reason=No matching function found for
//     argument types: <> (bool[3], float[3][..], float)`.
//   - What `float[3][..]` is, is the blocker: the law writes its cotangent as `ct: T[..]`, and the
//     instance binds `T` to the **operand's whole type**, so `ct` is an open-rank array *of
//     `float[3]`* rather than `float[..]`. Three spellings of the zero arm prove it, all measured on
//     2026-11-04: `zeros_like(ct)` reports `No matching function found for argument types: <>
//     (float[3][..])`; `shape(ct)` reports `No candidate of 'shape' applies to (<> (float[3][..])):
//     every candidate's 'when' condition is false. Candidates: (t: T[..]) => int[] — when
//     is_numeric::<T>()` -- `is_numeric::<float[3]>` is false, which is the binding seen from the
//     other side; and `ct - ct` reports `operator '-' is not defined for these operand types`. The
//     written form `where(x >= w, ct, 0.0)` is the scalar one (`where(bool, T, T)`), so the array
//     `float` mask and the scalar `0.0` are two more reasons, not the reason.
//   - The rank the law *is* written for is not reachable either: `tensor:maximum` has no scalar
//     spelling a program can write (`maximum(x, 1.0)` does not type-check -- the tensor module's
//     overloads take arrays), so there is no rank at which the array/scalar mismatch would go away.
//   - A `split` graph does not reach these laws at all: `jvp_maximum` answers the tangent with the
//     mask, so the linear half of `vjp(f_max)` is `add_tensor_t, mul_tensor_t` (measured:
//     `value=7.0 ct=[0.0, 1.0, 1.0]` for x = [0, 2, 4] -- the right number, from other laws).
//
// So both are **unverified** in `test/plans/feat/compile/transforms.plan.toml`: there is no rank at
// which the law instantiates, so no case can tell a right `maximum_t` from a wrong one. The blocker
// is `stdlib/rulesets/transpose.cml#maximum_t` (its `ct: T[..]` does not bind `T` to the element at a
// three-parameter instantiation) and `#minimum_t` behind it, and behind them the missing scalar
// spelling of `maximum`/`minimum`. This case pins the refusal on both streams: the day the law
// instantiates, it fails and names the number that replaced it.
//
//     camel test/cases/compile/transforms/transpose_laws_of_maximum_and_minimum_are_refused.cml
import rulesets.transpose
import { transpose } from transforms
import { maximum, minimum, sum } from tensor

/// `x ↦ Σ max(x, [1, 2, 3])` at x = [0, 2, 4]: the right cotangent is [0, 1, 1].
func f_max(x: float[3]): float {
    return float(sum(maximum(x, [1.0, 2.0, 3.0])))
}

/// The mirror: at the same x the right cotangent is [1, 1, 0].
func f_min(x: float[3]): float {
    return float(sum(minimum(x, [1.0, 2.0, 3.0])))
}

func main(): int sync {
    let maxAnswer = attempt(() => transpose(f_max)(1.0))()
    println(match maxAnswer {
        case error e => 'max  refused  ' + e.kind
        case _ => 'max  answered'
    })
    let minAnswer = attempt(() => transpose(f_min)(1.0))()
    println(match minAnswer {
        case error e => 'min  refused  ' + e.kind
        case _ => 'min  answered'
    })
    return 0
}