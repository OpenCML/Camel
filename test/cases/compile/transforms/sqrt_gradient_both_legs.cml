// `sqrt`'s gradient through the engine and through the library, in one program -- and its behaviour
// where the derivative is not finite, which is part of the law.
//
// `d(sqrt(x)) = dx / (2 * sqrt(x))`. The slope needs `sqrt(x)`, and `sqrt(x)` is a function of the
// operand alone, so the law recomputes it -- the same channel `exp_t` uses -- and the operand is the
// one value the cut has to carry.
//
// The order of the two roundings is the engine's, not an equivalent: `sqrtVjp`
// (`modules/tensor/ops/elementwise_ops.cpp`) multiplies the cotangent by `0.5` and then divides by
// the output, so the law writes `(ct * 0.5) / sqrt(x)` and not `ct / (2.0 * sqrt(x))`. The two are
// equal in real arithmetic and differ in the last bit for some inputs, which is why the engine's
// order is the one written down.
//
// **The domain boundary is a reading, not a claim.** `sqrt` is not differentiable at `0` (the slope
// is infinite) and is not real below it, and neither this operator nor the engine refuses either
// input: the cotangent is computed from the same square root the value was, so it answers `+inf` at
// `0.0` and `nan` below it, on both legs (measured `sqrt boundary engine=[inf, nan]
// library=[inf, nan]`). The boundary line prints the two legs on `[0.0, -1.0]` so that a law which
// special-cased the boundary -- refused it, clamped it, or wrote a zero -- would be visibly different
// from the engine.
//
// `[4.0, 2.25, 0.25]` keeps the three finite lanes distinct (`0.25`, `0.3333333333333333`, `1.0`), so
// a law that read one lane's answer three times would show:
//
//   * `sqrt_t` written as `ct * 0.5` (the division dropped) -> [0.5, 0.5, 0.5];
//   * the correct `(ct * 0.5) / sqrt(x)`                    -> [0.25, 0.3333333333333333, 1.0].
//
//     camel test/cases/compile/transforms/sqrt_gradient_both_legs.cml
import { grad } from autodiff
import { vjp } from vjp
import { abs, sqrt, sum } from tensor

/// The engine's spelling: the differentiated value is the `with` parameter (design principles 9.9).
with <x: float[...]>
func total(): float {
    return sum(sqrt(x))
}

/// The library's spelling: the same function with the value as an ordinary parameter.
func total_plain(x: float[]): float {
    return sum(sqrt(x))
}

func main(): int sync {
    let engine = grad(total)<[4.0, 2.25, 0.25] as float[]>()
    `sqrt engine={}`->format<engine>->println
    let (_, pullback) = vjp(total_plain)([4.0, 2.25, 0.25] as float[])
    let library = pullback(1.0).0
    let same = sum(abs(engine - library)) == 0.0
    `sqrt: engine={} library={} same={}`->format<engine, library, same>->println
    // The boundary: `sqrt` has an infinite slope at 0 and none below it, and neither leg refuses.
    let edge = grad(total)<[0.0, -1.0] as float[]>()
    let (_, edge_pullback) = vjp(total_plain)([0.0, -1.0] as float[])
    let edge_library = edge_pullback(1.0).0
    `sqrt boundary engine={} library={}`->format<edge, edge_library>->println
    return 0
}
