// The same walk as `transpose_call_first_argument_is_a_call.cml`, with the argument that used to name
// it carrying a **function value**: `f(x) = h(mk(x), 2.0)` with `mk(x) = (y) => x * y` and
// `h = (a, b) => a(b) * x`.
//
// On paper `f(x) = mk(x)(2.0) * x = 2x * x = 2x^2`, so `f(3) = 18` and the derivative at 3 is `12`.
//
// The GIR is the one the sibling case prints, one node kind further on: the callee is the FILL closure
// `h`, and the first ordinary input is the FUNC node `mk`. `GCGraph::calleeIdOf` answers for a FUNC
// node, so while the walk still asked its operands for a callee this program was read as a call of
// `mk` -- the callee of the *first argument*, not of this call -- and refused with
// `TRANSPOSE function=mk skip=signature` and `TRANSPOSE function=f skip=call-no-transpose node=5
// callee=mk`: the right verdict (exit 1) said with the wrong name and for the wrong reason.
//
// Fixed 2026-11-04 by deleting that question. The reading is now the one the closure asks for:
//
//     TRANSPOSE function=f skip=call-no-transpose node=5 callee=none value=3:10 with=2:4 reason=function-closure
//
// exit 1, after the forward line `18.0`. That is the reading the phrase `a function value written in
// the call's first argument position` most literally asks about, and the answer is that the value in
// the argument position is an **operand**: it is what the call is applied to, and the callee is the
// closure in the `with` input, which names no graph here.
//
// Making the first argument a *bare function name* instead of a call is what
// `transpose_call_of_a_body_closure_with_a_bare_name.cml` writes: there the node named no graph even
// while the question existed, which is how this case and that one are the two halves of one question.
import rulesets.transpose
import { transpose } from transforms

func mk(x: float): (y: float) => float {
    return (y: float) => x * y
}

func f(x: float): float {
    let h = (a: (y: float) => float, b: float) => a(b) * x
    return h(mk(x), 2.0)
}

func main(): int sync {
    println(f(3.0))
    // The paper answer: (12.0,). No forward line prints 12, so the claim is about the transpose.
    println(transpose(f)(1.0))
    return 0
}