// f(xs, n) = xs[n] * xs[0] at ([3.0, 2.0], 1) answers 6.0 and the gradient of `xs`, [2.0, 3.0], with
// `0` beside it for the `int`: the gradient of a discrete parameter is the zero of its own type, so
// the pullback answers `(float[], int)` and the `int` member is a zero, not an empty slot. It once
// answered `(float[],)` -- one member short -- and then `(float[], ())`, the empty slot the older
// reading of a discrete tangent wrote.
import { vjp } from vjp

func mixed(xs: float[], n: int) => float {
    return xs[n] * xs[0]
}

func main() sync {
    let (value, pullback) = vjp(mixed)([3.0, 2.0], 1)
    let cotangents = pullback(1.0)
    println(value)
    println(cotangents)
}
