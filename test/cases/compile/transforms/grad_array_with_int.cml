// The author's reading of 2026-11-02 18:50, as a case: f(xs, n) = xs[n] * xs[0] at ([3.0, 2.0], 1)
// answers 6.0 and the gradient of `xs`, [2.0, 3.0], with `()` beside it for the `int` -- an empty
// member of the answer, because the pullback answers one slot per parameter and `Tangent<int>` is
// `()`; the `int` itself is a value the caller still passes and takes no answer slot of its own.
// It read a `split` refusal until 2026-11-03, then stopped on the answer's shape: the pullback
// answered `(float[],)` where `Vjp<F>` declares `(float[], ())`.
import { vjp } from vjp

func mixed(xs: float[], n: int): float {
    return xs[n] * xs[0]
}

func main(): int sync {
    let (value, pullback) = vjp(mixed)([3.0, 2.0], 1)
    let cotangents = pullback(1.0)
    println(value)
    println(cotangents)
    return 0
}