// A library-level `with_grad` as the composition of `vjp` (design principles 9.9, author's ruling of
// 2026-11-03 09:50): `vjp` differentiates ordinary parameters only, so the weight is moved to one by
// a lambda -- `(ww) => loss_with<ww, b>(x, t)` -- and the seed 1 read off the pullback is its
// gradient.
//
// The composition builds up to the `vjp` call and stops inside it, and this case pins where: the
// differentiated function is a lambda whose body *ends in a call to a `with`-parameterised
// function*, so the lifted graph answers with that call's pair instead of building a two-member
// tuple fill of its own, and `split` cuts only a graph whose exit is such a fill. The reading
// wanted here is the one `library_grad_is_the_composition.cml` pins on the engine's own
// `with_grad` -- `(0.125, -0.75)` for `x = 1.5, t = 2.0, w = 0.5, b = 0.75` -- and this case says
// that the composition route answers it as soon as `split` can cut that exit.
//
// The wall is stated by the tools rather than by this comment: `skip=exit` and the reason line come
// from `split`, and the message names what it wanted ("a two-member tuple fill"). When that exit
// becomes cuttable, this case turns green, the numbers appear, and the library function can be
// written back into `stdlib/vjp.cml` with the same body.
import { vjp } from vjp

with <w: float, b: float>
func loss_with(x: float, t: float): float {
    let err = x * w + b - t
    return 0.5 * err * err
}

with <w: float, b: float>
func step(x: float, t: float): (float, float) {
    let (value, pullback) = vjp((ww: float) => loss_with<ww, b>(x, t))(w)
    return (value, pullback(1.0).0)
}

func main(): int sync {
    let (value, weight_gradient) = step<0.5, 0.75>(1.5, 2.0)
    println(`value={:.17f} w={:.17f}`->format<value, weight_gradient>)
    return 0
}