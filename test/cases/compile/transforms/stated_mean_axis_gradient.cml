// The gradient of a lane mean through the library's own rules.
//
// `jvp_mean_axis` states the axis, the flag and the extents in one list, and `mean_axis_stated_t`
// spreads each lane's cotangent back over the lane it was averaged from: the lane length is
// `numel(t) / numel(ct)`, read off the stated extents and the cotangent, and the shape it spreads
// into is the stated one.
//
// A mean of four elements divides by four, so every position gets a quarter:
//
//     x = [1.0, 2.0, 3.0, 4.0]   ->   value 2.5, dL/dx = [0.25, 0.25, 0.25, 0.25]
//
// The mean keeps its axis (`keepdims`), so the reduction's answer is a rank-1 tensor of extent 1
// and `sum` reduces that: the cotangent the reverse law works from is an array, which is the shape
// the law declares. Reducing the only axis of a rank-1 operand without `keepdims` answers the
// element itself (a rank-zero array *is* its element, design principles 5.4), and
// `stdlib/rulesets/transpose.cml#mean_axis_stated_t` declares its cotangent `float[..]` -- a
// double read by that law is a pointer, and the run stops on a SIGSEGV inside
// `modules/tensor/ops/gradient_ops.cpp#numelKernel`. That is the law's port to widen, not this
// case's to hide: see docs/handover/questions/2026-11-04-axis-reductions-state-their-extents.cn.md.
//
//     camel test/cases/compile/transforms/stated_mean_axis_gradient.cml
import { vjp } from vjp
import { mean_axis, sum } from tensor

func total(x: float[]): float {
    return sum(mean_axis(x, 0, true))
}

func main(): int sync {
    let (value, pullback) = vjp(total)([1.0, 2.0, 3.0, 4.0] as float[])
    let d = pullback(1.0).0
    `stated mean value={} dL/dx={}`->format<value, d>->println
    return 0
}