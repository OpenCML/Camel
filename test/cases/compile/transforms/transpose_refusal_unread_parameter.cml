// A function whose second parameter is never read: the transpose has nothing to answer for it, so
// the refusal must say *that*, not the shape's other causes. The case asserts the sentence and its
// half, never a number -- the capability is missing today and the red is the evidence of it.
import { transpose } from transforms
import rulesets.transpose

func f(x: float, y: float): float {
    return x * 2.0
}

func main(): int sync {
    let back = transpose(f)
    println(back(1.0))
    return 0
}
