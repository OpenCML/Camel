// The library keeps its own promise: a program that imports `vjp` and nothing else gets a
// derivative. `vjp` is `transpose(split(jvp(f)))`, so it needs the forward rules
// (`rulesets.jvp`) and the backward ones (`rulesets.transpose`), and `stdlib/vjp.cml` imports both
// -- a library that makes its callers know its insides is not a library, which is the same reading
// as a pass's precondition: it is the library's job, and it diagnoses what it cannot do.
//
// That is the property this case holds, and its only import is `vjp`. Take either ruleset import
// out of `stdlib/vjp.cml` and this goes red at the library's own line -- `transpose has no
// transpose for this function`, or `jvp has no forward rule for :op/mul_d` -- on the call
// `stdlib/vjp.cml` composes, never in this file and never in a sentence of the form "not
// implemented yet".
//
// The point is `x = 2`, and it is chosen so that **the value and the gradient differ**: `f(2) = 8`
// and `3*x*x = 12`, with the cotangent `(12.0)` -- one member, because a pullback answers one
// cotangent per parameter and `f` has one. At `x = 3` all three numbers are 27, and an assertion
// that only asked whether `27.0` appears could not tell a wrong gradient from the value it
// differentiates: it stayed green with the gradient computed as the value (see P2-22 of
// docs/handover/reports/). Each line below is pinned whole for that reason, and the plan also
// refuses the old point's `27.0` outright.
import { grad, vjp } from vjp

func f(x: float): float {
    return x * x * x
}

// `grad` differentiates the first `with` parameter (design principles 9.9), so its leg is read
// through one; the rulesets it needs are the ones above, and this file still imports only `vjp`.
with <x: float>
func f_at(): float {
    return f(x)
}

func main(): int sync {
    let (value, backward) = vjp(f)(2.0)
    let cotangents = backward(1.0)
    println('vjp_ruleset value={}'->format<value>)
    println(cotangents)
    println('vjp_ruleset cotangent={}'->format<cotangents.0>)
    println('vjp_ruleset grad={}'->format<grad(f_at)(2.0)>)
    return 0
}