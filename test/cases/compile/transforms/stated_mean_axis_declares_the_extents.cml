// The signature of a stated reduction is the one its three stated values name.
//
// `mean_axis_stated(t, axis, keepdims, extents)` takes the axis, the flag and the operand's extents
// as parameters of their own, so a call that states all three has stated the result's extents. Here
// the axis is 0, there is no `keepdims`, and the operand is a rank-1 tensor of four elements: one
// lane, so the answer is the element itself (design principles 5.4) and the value is the mean, 2.5.
//
// The reading this case pins is the *type*, not the number: the operator is computed rather than
// declared (`modules/tensor/ops/reduction_ops.cpp#meanAxisStatedInfer`), so the node's type is
// `float` and the `return` that asks for `float` needs no conversion. While the name was declared
// `T[...]` the node read `float[...]` and a `CAST` stood between it and the return -- which is the
// same conversion that made `vjp` refuse a program whose only reduction was this one.
//
//     camel test/cases/compile/transforms/stated_mean_axis_declares_the_extents.cml std::gir
import { mean_axis_stated } from tensor

func lane_mean(x: float[]): float {
    return mean_axis_stated(x, 0, false, [4])
}

func main(): int sync {
    let value = lane_mean([1.0, 2.0, 3.0, 4.0] as float[])
    `stated lane mean={}`->format<value>->println
    return 0
}