// One straight-line lift taken through the cut: `f(x) = x*x*x`, `split(jvp(f))`, read at 2. This is
// the shape the cut answers while the caller is built -- the halved graphs are made there, and the
// run-time kernel is not entered -- so it is the `compile` row of the counter, and the row that has
// to move back to `run` if build-time cutting is ever taken out.
//
// The numbers are the chain's: `f(2) = 8` and `f'(2) = 3x^2 = 12`, read through the halves.
import rulesets.jvp
import { jvp, split } from transforms

func f(x: float): float {
    return x * x * x
}

func main(): int sync {
    let (forward, backward) = split(jvp(f))
    let (value, residuals)  = forward(2.0)
    println("value=", value, " tangent=", backward(residuals, 1.0))
    return 0
}