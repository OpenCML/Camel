/**
 * A function that captures a value, batched: the batched body reads the captured value, not the
 * batch element.
 *
 * `make(3.0)` answers `(x) => x + c` with `c` in the value's closure, so `vmap(make(3.0))` copies a
 * body whose second operand is a capture. A capture is part of the *function value*, and the
 * transform copies it into the batched graph as a constant (lifted the way a constant written in the
 * body is lifted: the batch of one row), in the order the source graph captured it. Until
 * 2026-11-02 the walk answered every port of the body with the batch parameter, so `x + c` was
 * `x + x`: with `xs = [1, 2, 3]` and `c = 3` that printed `[2.0, 4.0, 6.0]` instead of `[4.0, 5.0,
 * 6.0]`, in silence (author's review, high-2).
 *
 * The numbers are hand-computed: `1+3, 2+3, 3+3` is `[4, 5, 6]`, and `make2(2, 1)` answers
 * `(x) => x * a + b`, so `1*2+1, 2*2+1, 3*2+1` is `[3, 5, 7]` -- the second line is what says the
 * two captures are read in their own order and not both folded into the batch.
 */
import rulesets.vmap
import { vmap } from transforms

func make(c: float): (x: float) => float {
    return (x: float) => x + c
}

func make2(a: float, b: float): (x: float) => float {
    return (x: float) => x * a + b
}

func main(): int sync {
    let xs: float[3] = [1.0, 2.0, 3.0]
    println(vmap(make(3.0))(xs))
    'two captures={}'->format<vmap(make2(2.0, 1.0))(xs)>->println
    return 0
}