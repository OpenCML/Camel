// The third shape: the body reads two different values from outside, and one of them is not the
// parameter but a product computed before the loop (`k = x*x`). So the values an escape can land on
// are of two kinds -- a `Port` and an `Oper` -- and the refusal has to name both, `captures=2`. A
// step that assumed every escape lands on a parameter port would build one accumulator and lose the
// other; this is the reading that says there are two and which they are.
//
// `read_outer(x) = let k = x*x; loop s = x for i in 0..3 do 2.0*s + k + x` is `s = 2s + k + x` three
// times, `8x + 7k + 7x = 15x + 7x*x` on paper, so `transpose(read_outer)(1, 1)` owes 15 + 14 = 29:
// 15 through `x` and 14 through `k`, which is `2x` at x = 1 with the loop's factor 7.
import { transpose } from transforms
import rulesets.transpose

func read_outer(x: float): float {
    let k = x * x
    return loop s = x for i in 0..3 do 2.0 * s + k + x
}

func main(): int sync {
    let back = transpose(read_outer)
    println(back(1.0, 1.0))
    return 0
}