/**
 * A `T` enters a `T?` on assignment exactly as it does on binding and argument passing (design
 * principles 3.8; one relation, entersImplicitly): the variable itself, a field of a struct
 * variable, an element of an array variable, and a variable written from a function that captures
 * it. Assigning `acc.best = hi` used to store the bare float into the `float?` slot.
 *
 * The fourth form writes a module `var` and not a `var` of `main`: a closure captures a value, so
 * it cannot assign a name of the call that made it (design principles 3.5, 197; the author's
 * ruling of 2026-11-16). A module `var` is a name of the module, and the conversion into a `T?`
 * is the same assignment either way -- what this case is about is where the conversion lands.
 */

type Acc = { best: float?, count: int }

var seen: float? = null

func main(): int sync {
    var best: float? = null
    let hi = 2.5
    best = hi
    var acc: Acc = { best: null, count: 0 }
    acc.best = hi
    var xs: (float?)[] = [null, null]
    xs[0] = hi
    var count: int? = null
    let step = 3
    count = step
    println(best, acc.best, xs, count)

    let note = func (v: float) => void sync { seen = v }
    note(4.5)
    println(seen)
    [1.0, 2.0]->foreach<func (x: float) => void sync { seen = x }>
    println(seen)
    return 0
}