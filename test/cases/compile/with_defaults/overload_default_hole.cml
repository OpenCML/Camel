/**
 * A parameter a call leaves out between named ones takes the default of the declaration the call
 * means, for the two lists alike: `rounds` has a default in both declarations of `show`, and
 * `show<label: 'p'>(3)` reaches the one whose ordinary parameter takes the 3 (design principles 4.4).
 */

with <rounds: int = 8, label: string = 'x'>
func show(a: int): int {
    return a * rounds
}

with <rounds: int = 8, label: string = 'x'>
func show(a: string): int {
    return rounds
}

func main(): int sync {
    return show<label: 'p'>(3)
}
