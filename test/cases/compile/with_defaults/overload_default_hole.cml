/**
 * A call of several declarations fills no default, and the rule is one rule for the two lists:
 * `rounds` has a default in both declarations of `show`, but a default is written by one
 * declaration, and `show<label: 'p'>` does not say which one it means (design principles 4.4,
 *  handover).
 */
module with_overload_default_hole

with <rounds: int = 8, label: string = 'x'>
func show(a: int): int {
    return a * rounds
}

with <rounds: int = 8, label: string = 'x'>
func show(a: string): int {
    return rounds
}

func main(): int sync {
    return show<label: 'p'>(3)
}