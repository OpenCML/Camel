/**
 * A native operator takes the names and the defaults of its parameters from its declaration, a
 * generic one too: `with_probe::<T>` is declared `with <base: int, step: int = 10, mode: int = 0>`,
 * so a call may leave `step` and `mode` out, give them by name, and skip `step` to give `mode`
 * (design principles 4.4, 6.4). The name is declared twice, for a value and for an array, and each
 * declaration gives the defaults it registers.
 */
module with_defaults_native_generic

import { with_probe } from test_support

func main(): int sync {
    println(with_probe<1>(0), with_probe<1, 2>(0), with_probe<1, 2, 3>(0))
    println(with_probe<base: 1>('a'), with_probe<mode: 7, base: 1>(0), with_probe<base: 1, mode: 7>(0))
    println(with_probe<1>([5, 6]), with_probe<base: 2, mode: 1>([7]), with_probe<1, 2, 3>([5, 6, 7]))
    return 0
}
