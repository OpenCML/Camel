/**
 * Two generic functions of one name whose parameter types cannot be told apart are one signature:
 * the second is a redeclaration, reported where it is declared, as for two ordinary functions.
 */
module generic_same_signature

func g::<T>(x: T): string {
    return 'first'
}

func g::<U>(y: U): string {
    return 'second'
}

func main(): int sync {
    println(g(1))
    println('never printed')
    return 0
}