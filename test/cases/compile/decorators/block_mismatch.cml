/**
 * A decorator is called with the block's function, of no parameters: one that takes another
 * function type does not accept it, an ordinary error of the call (language reference 7.6).
 */

func twice(f: (x: int) => int): (x: int) => int {
    return (x: int) => f(f(x))
}

func d(x: float): float {
    @twice
    {
        return x * 2.0
    }
}

func main(): int sync {
    return 0
}
