/**
 * Two equal expressions are not merged when they have different node attributes (std::opt::cse;
 * design principles 2.17); equal expressions with equal attributes are.
 */
module cse
import { mark } from test_attrs

func twice(a: float, b: float): float {
    let p = a * b
    let q = a * b
    @mark
    {
        let s = a * b
        let t = a * b
        return p + q + s + t
    }
}

func main(): int sync {
    println(twice(1.5, 3.0))
    return 0
}
