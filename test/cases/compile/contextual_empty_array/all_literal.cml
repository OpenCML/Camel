// The all-literal spellings of the same positions keep compiling, and says what they print: the
// empty array takes the element type of the field it stands in, and a literal that has elements
// keeps the join of them (design principles 5.1). This is the case the fix must not disturb.

type Tree = { value: int, children: Tree[] }
type Move = { value: int, moves: int[], children: Move[] }

func count(tree: Tree): int {
    return len(tree.children)
}

func main(): int sync {
    let tree: Tree = { value: 4, children: [] }
    let move: Move = { value: 1, moves: [1, 2], children: [] }
    let nested: Tree = { value: 2, children: [] }
    println(count(tree))
    println(len(move.moves))
    println(count(nested))
    println(move.value + tree.value + nested.value)
    return 0
}