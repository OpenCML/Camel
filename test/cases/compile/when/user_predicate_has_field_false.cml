/**
 * The same folded predicate where the field is absent: no candidate applies, and the call site
 * names the condition with the argument that made it false.
 */

type Point = { w: int, h: int }

func has_field::<T>(name: string): bool {
    return match type T {
        case struct => static loop found = false for n, F in fields T do found || n == name
        case _ => false
    }
}

func width(x: Point): int when has_field::<Point>('d') {
    return x.w
}

func main(): int sync {
    println(width({ w: 3, h: 4 }))
    return 0
}