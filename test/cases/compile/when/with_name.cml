/**
 * A `when` that reads a `with` parameter is not answered by a runtime value: the condition is
 * reported as not constant, never assumed true (design principles 4.4).
 */
module when_with_name

with <on: bool>
func add(x: int): int when on {
    return x + 1
}

func caller(on: bool): int {
    return add<on>(41)
}

func main(): int sync {
    return caller(true)
}