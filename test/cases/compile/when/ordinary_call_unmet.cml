/**
 * The same ordinary call where it does not hold: `is_positive(0)` is folded to false, so the
 * only candidate is inapplicable and the call site lists the condition it wrote.
 */
module when_ordinary_call_unmet

func is_positive(x: int): bool {
    return x > 0
}

func drop(x: int): int when is_positive(0) {
    return x - 1
}

func main(): int sync {
    return drop(1)
}