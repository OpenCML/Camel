/**
 * A generic declaration's `when` condition is answered where the declaration is written, for the
 * half that does not depend on the type parameter: `is_integerr` is not a name this module can
 * see, so it is reported there, and `only_int` is called nowhere -- nothing had to instantiate it
 * (design principles 4.4: a name the declaration cannot see is refused where the
 * declaration is written). Whether a well-formed condition *holds* is
 * still the instance's question: cases/compile/when/open_type.cml.
 */

import { is_integer } from types

func only_int::<T>(x: T): T when is_integerr::<T>() {
    return x
}

func main(): int sync {
    println(1)
    return 0
}
