/**
 * A `when` calls an ordinary function of this module with a compile-time constant: the
 * condition is evaluated where the declaration is written, so `is_positive(1)` holds and the
 * declaration applies (design principles 5.5: a type function is an ordinary function that runs
 * at compile time).
 */
module when_ordinary_call

func is_positive(x: int): bool {
    return x > 0
}

func bump(x: int): int when is_positive(1) {
    return x + 1
}

func main(): int sync {
    println(bump(41))
    return 0
}