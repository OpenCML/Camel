/**
 * An overloaded predicate in a condition goes through the ordinary choice of an overload by its
 * arguments: `pick('s')` is the `string` one, which holds. The first declaration of the name is
 * not the answer to every call (design principles 4.3).
 */

func pick::<T>(a: int): bool {
    return false
}

func pick::<T>(a: string): bool {
    return true
}

func only::<T>(x: T): T when pick::<T>('s') {
    return x
}

func main(): int sync {
    println(only(5))
    return 0
}
