/**
 * A predicate that folds a value argument at compile time: `has_field` walks the field names of
 * T and compares them with the constant the condition writes, so `when has_field::<Point>('w')`
 * is answered without a body being built for the point.
 */
module when_user_predicate_has_field

type Point = { w: int, h: int }

func has_field::<T>(name: string): bool {
    return match type T {
        case struct => static loop found = false for (n, F) in fields T do found || n == name
        case _ => false
    }
}

func width(x: Point): int when has_field::<Point>('w') {
    return x.w
}

func main(): int sync {
    println(width({ w: 3, h: 4 }))
    return 0
}