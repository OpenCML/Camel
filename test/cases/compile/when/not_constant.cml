/**
 * A `when` that calls an ordinary function is not a compile-time predicate: it is reported,
 * never taken as true (design principles 5.13).
 */
module when_not_constant

func is_positive(x: int): bool {
    return x > 0
}

func bad(x: int): int when is_positive(1) {
    return x
}

func main(): int sync {
    return bad(1)
}