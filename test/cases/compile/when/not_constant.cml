/**
 * A `when` that reads a run-time value is not a compile-time predicate: the condition calls a
 * function whose body reads a module-level `var`, so its value only exists once the program
 * runs and the declaration is reported, never taken as true (design principles 5.13).
 */
module when_not_constant

var counter = 0

func bump(): bool sync {
    counter = counter + 1
    return counter > 0
}

func bad(x: int): int when bump() {
    return x
}

func main(): int sync {
    return bad(1)
}