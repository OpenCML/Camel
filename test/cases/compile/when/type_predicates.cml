/**
 * Every standard type predicate, used as a `when` condition in both directions.
 *
 * The bodies are the ones `stdlib/types.cml` ships, written locally because a `when` condition
 * resolves the generic functions of its own module only. Each predicate guards two declarations:
 * one that fires when the predicate holds, one that fires when it does not, so a wrong answer on
 * either side changes the output.
 */


type Point = { x: int }

func is_numeric::<T>(): bool {
    return match type T {
        case int | i32 | float | f32 | c64 | c128 => true
        case _ => false
    }
}

func is_integer::<T>(): bool {
    return match type T {
        case int | i32 => true
        case _ => false
    }
}

func is_float::<T>(): bool {
    return match type T {
        case float | f32 => true
        case _ => false
    }
}

func is_ordered::<T>(): bool {
    return match type T {
        case int | i32 | float | f32 | string | bool => true
        case _ => false
    }
}

func is_function::<T>(): bool {
    return match type T {
        case func => true
        case _ => false
    }
}

func is_string::<T>(): bool {
    return match type T {
        case string => true
        case _ => false
    }
}

func is_bool::<T>(): bool {
    return match type T {
        case bool => true
        case _ => false
    }
}

func numeric::<T>(x: T): string when is_numeric::<T>() {
    return "numeric"
}

func not_numeric::<T>(x: T): string when !is_numeric::<T>() {
    return "not numeric"
}

func integer::<T>(x: T): string when is_integer::<T>() {
    return "integer"
}

func not_integer::<T>(x: T): string when !is_integer::<T>() {
    return "not integer"
}

func real::<T>(x: T): string when is_float::<T>() {
    return "float"
}

func not_real::<T>(x: T): string when !is_float::<T>() {
    return "not float"
}

func ordered::<T>(x: T): string when is_ordered::<T>() {
    return "ordered"
}

func not_ordered::<T>(x: T): string when !is_ordered::<T>() {
    return "not ordered"
}

func function::<T>(f: T): string when is_function::<T>() {
    return "function"
}

func not_function::<T>(x: T): string when !is_function::<T>() {
    return "not function"
}

func text::<T>(x: T): string when is_string::<T>() {
    return "string"
}

func not_text::<T>(x: T): string when !is_string::<T>() {
    return "not string"
}

func boolean::<T>(x: T): string when is_bool::<T>() {
    return "bool"
}

func not_boolean::<T>(x: T): string when !is_bool::<T>() {
    return "not bool"
}

func main(): int sync {
    let p: Point = { x: 1 }
    let f: (x: int) => int = (x) => x
    println(numeric(1))
    println(not_numeric("s"))
    println(integer(1))
    println(not_integer(1.0))
    println(real(1.0))
    println(not_real(1))
    println(ordered("s"))
    println(not_ordered(p))
    println(function(f))
    println(not_function(1))
    println(text("s"))
    println(not_text(1))
    println(boolean(true))
    println(not_boolean(1))
    return 0
}