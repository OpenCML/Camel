/**
 * `is_function::<F>()`: a pass-shaped declaration applies only where its function parameter F
 * really is a function.
 *
 * The predicate is a user predicate written with `match type`; `case func` is the shape of every
 * function type.
 */

func is_function::<T>(): bool {
    return match type T {
        case func => true
        case _ => false
    }
}

func apply::<F>(f: F, x: int): int when is_function::<F>() {
    return f(x)
}

func inc(x: int): int {
    return x + 1
}

func main(): int sync {
    println(apply(inc, 41))
    return 0
}