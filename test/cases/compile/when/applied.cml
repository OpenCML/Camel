/**
 * A `when` condition that holds: the declaration applies.
 *
 * `double` asks about a written type, `twice` about its own type parameter T, which the call
 * binds (int and float here). The condition is evaluated when the declaration is instantiated,
 * before its body is built (design principles 5.13).
 *
 * The predicates are written here as any user predicate is; the standard ones with these names
 * live in the standard module `types`.
 */
module when_applied

func is_integer::<T>(): bool {
    return match type T {
        case int | i32 => true
        case _ => false
    }
}

func is_numeric::<T>(): bool {
    return match type T {
        case int | i32 | float | f32 | c64 | c128 => true
        case _ => false
    }
}

/// `is_integer::<int>()` is true: `double` is selectable.
func double(x: int): int when is_integer::<int>() {
    return x * 2
}

/// The condition uses the declaration's own type parameter T.
func twice::<T>(x: T): T when is_numeric::<T>() {
    return x + x
}

func main(): int sync {
    println(double(21))
    println(twice(4))
    println(twice(1.5))
    return 0
}