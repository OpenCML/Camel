// A pinned reading of the language, measured while choosing how a yielded element is delivered:
// the postfix `!` is the take of design principles 3.9 -- `x!` takes the value out of a `T?` (the
// fault `NullValue` where it is null) -- so a value of a nullable type is unwrapped with it, and
// `??` stays the form that gives a replacement. The reading here is the value that is there.

func main() => int sync {
    let x: int? = 5
    println(x!)
    return 0
}