// `f..g` is the composition `(x) => g(f(x))` (design principles 4.2): `(f..g)(x)` is `g(f(x))`,
// so this prints `dbl(inc(3))` = 8, not `inc(dbl(3))` = 7.
module h405_composition

func inc(x: int): int { return x + 1 }
func dbl(x: int): int { return x * 2 }

func main(): int sync {
    let g = inc..dbl
    println(g(3))
    return 0
}