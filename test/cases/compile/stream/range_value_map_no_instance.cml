// A range is not an array and not a stream: `map` over it is the prelude's own declaration of the
// name, sitting beside the array rule as an overload of it. One name, one overload set, and the
// value's type is what chooses -- the integers `1 .. 5` walked and doubled, in order.
//
// The file keeps the name it was written under: it pinned the no-match this overload replaces, and
// a parse snapshot records the path, so renaming it is a snapshot re-record of its own.

func dbl(x: int) => int {
    return x * 2
}

func main() => int sync {
    println(map<dbl>(1 .. 5))
    return 0
}