// `range(a, b, step)` is the integers `a`, `a + step`, ... below `b`, and above `b` when the step
// is negative (design principles 4.2; the rule on
// the rule). It is the array form of `a..b` with a step: `a..b` stays the one
// spelling of unit step, and the stepped sequence is this call.

func main(): int sync {
    // A positive step: a, a + step, ... below b, and the last element is the last one below b.
    println(range(0, 10, 3))
    println(range(0, 9, 3))
    println(range(1, 2, 5))

    // A negative step: a, a + step, ... above b.
    println(range(10, 0, -3))
    println(range(10, 1, -3))

    // No element at all: the step has carried the start past the end, or the end is on the side
    // the step does not go to.
    println(range(0, 10, -1))
    println(range(10, 0, 1))
    println(range(3, 3, 1))
    println(range(3, 3, -1))

    // The step is an expression, and it is the run's step: the same call with a step the compiler
    // does not know builds the same array.
    let k = 4
    println(range(0, 20, k))
    println(range(20, 0, -k))

    // The unit step is still the interval: `range(a, b, 1)` and `a..b` are the same integers.
    println(range(0, 5, 1))
    println(0..5)

    // The bounds are the call's own arguments, so an expression is written as it is anywhere.
    let n = 3
    println(range(n - 1, n + 7, 2))
    return 0
}