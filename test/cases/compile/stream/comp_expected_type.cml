// `f..g` is the lambda `(x) => g(f(x))` (design principles 4.2), so the type the position expects
// is the type that lambda would have: it gives the composition's input and its output, and it
// instantiates a generic operand where that operand stands, as the lambda's calls do
// (`ident(ident(x))` with `x: int` is `ident::<int>`). `let h: (x: int) => int = (x) =>
// ident(ident(x))` passes, so this must too (the rule is generic-operands-of-composition).
module h428_comp_expected_type

func ident::<T>(x: T): T {
    return x
}

func main(): int sync {
    let h: (x: int) => int = ident..ident
    println(h(4))
    return 0
}