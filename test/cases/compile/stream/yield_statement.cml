/**
 * The syntax of `yield` (design principles 5.4: a function whose body writes `yield` produces a
 * stream, and its head writes the stream type). The keyword is read, and the statement is the
 * third alternative of `retStmt`, so it builds the exit node the AST has always had for it
 * (`ExitStmt: yield`). the rule that fixes what a generator means is
 * the rule: several `yield`s a round, the resume point
 * at the `yield`, any nesting, a `match` arm and a `sync` block as well. The author's sketch of
 * the slice is docs/design/io-concurrency-streams/plan.cn.md:290 (`pairs`), and the acceptance
 * asks for one `yield` in a `loop` and one in an `if`.
 *
 * The bodies below are only read here (`camel check -s`, `camel inspect --ast`), so this file
 * holds the shape of the statement and not what the stream it produces is: `pairs` carries one
 * value across its `yield` in a `while` loop and `sign` yields from both arms of an `if`, and both
 * are lowered now -- cases/compile/stream/generators_loop.cml and generators.cml are what pin what
 * they hand out. It also compiles: the one shape the compiler still refuses by name is a loop that
 * carries two values (cases/compile/stream/yield_lowering.cml), which neither function writes.
 */
func pairs(n: int): (int, int).. {
    loop i = 0 while i < n do {
        yield (i, i + 1)
        i + 1
    }
}

func sign(x: int): int.. {
    if x >= 0 then {
        yield 1
    } else {
        yield -1
    }
}

func main(): int sync {
    println(1)
    return 0
}