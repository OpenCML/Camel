/**
 * The initial value of a generator `loop` is evaluated where the loop stands, once, before the
 * first condition -- so it may be computed there or read from a local, not only written as a
 * literal. The three shapes below read the same stream: a literal, a value held in a local, and a
 * call. The first round starts from that value, and the body ends with the next state value.
 */

func f(): int {
    return 5
}

func fromLocal(): int.. sync {
    var start = 3
    loop i = start while i < 5 do {
        yield i
        i + 1
    }
}

func fromCall(): int.. sync {
    loop i = f() while i < 7 do {
        yield i
        i + 1
    }
}

func main(): int sync {
    loop acc = 0 for v in fromLocal() do sync { println(v); acc + 1 }
    loop acc = 0 for v in fromCall() do sync { println(v); acc + 1 }
    return 0
}