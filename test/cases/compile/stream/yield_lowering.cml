/**
 * A `yield` in a body whose head the builder does not read as a stream is refused at the `yield`,
 * and the report names the head: a body that yields is a generator, and its head writes the stream
 * type it hands out (SemanticDiag::YieldRequiresStreamHead). What this case reaches is the head
 * check itself -- the head writes `(int, int)..`, and a stream whose element type is a tuple is not
 * read as a stream type yet, while a head of `int..` with the same body lowers. The `yield` is on
 * line 13.
 */
func running(n: int): (int, int).. {
    loop i = 0, s = 0 while i < n do {
        yield (i, s)
        (i + 1, s + i)
    }
}

func main(): int sync {
    let s = running(3)
    println(1)
    return 0
}
