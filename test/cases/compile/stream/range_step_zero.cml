// `range(a, b, 0)` names no sequence at all: the step never moves, so no integers are the
// sequence and no sequence is the array (design principles 4.2). The step is a constant here, so
// the refusal is at the
// call, under the step the program wrote, and says both ways to write what it meant.

func main(): int sync {
    let xs = range(0, 10, 0)
    println(xs)
    return 0
}