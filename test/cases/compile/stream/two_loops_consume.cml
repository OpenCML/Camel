/**
 * A stream is consumed once on each execution path (design principles 5.4): two `for`s over one
 * stream are two consumers. One `for` is one consumer however many edges the machine it builds
 * reads the value on -- the sequence it is handed and the slot of its state that holds it back are
 * one read -- but two of them pull the same stream twice, and the second is refused.
 */
module stream_two_loops_consume

func count(n: int): int.. {
    return step(n)
}

func step(n: int): () => (int, int..)? {
    return () => if n > 0 then (n, step(n - 1)) else null
}

func twice(s: int..): int {
    let first = loop acc = 0 for x in s do acc + x
    let second = loop acc = 0 for x in s do acc + x
    return first + second
}

func main(): int sync {
    println(twice(count(3)))
    return 0
}