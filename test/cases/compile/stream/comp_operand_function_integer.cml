// `..` is the interval - two integers and nothing else - and a function with an integer is not
// that, so the construct is refused: the operands are named by their types, and neither of them is
// generic or unsettled.

func inc(x: int) => int {
    return x + 1
}

func main() => int sync {
    let composed = inc .. 3
    println(composed)
    return 0
}
