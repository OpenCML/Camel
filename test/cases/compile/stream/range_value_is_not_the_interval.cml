// The interval `a..b` is still an array and `Range` is not one, so the declaration below is
// refused: the new type grew beside the old construction instead of replacing it. Nothing writes
// `1..5 as Range`, and there is no conversion from an array to a range on purpose.

import { Range } from prelude

func main() => int sync {
    let r: Range = 1 .. 5
    return 0
}
