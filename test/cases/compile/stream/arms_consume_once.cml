/**
 * One stream, two arms: only one arm of a branch runs, so each arm consuming the stream once is one
 * consumer on each execution path, not two (design principles 5.4). Both ways of consuming a stream
 * are here -- a pull and a `for` over it -- and the arms of either function are the pair that would
 * be refused if they stood on one path.
 */
module stream_arms

func count(n: int): int.. {
    return step(n)
}

func step(n: int): () => (int, int..)? {
    return () => if n > 0 then (n, step(n - 1)) else null
}

func firstOf(p: (int, int..)?): int {
    return match p {
        case null => -1
        case v => v.0
    }
}

func pullOrPull(flag: bool, s: int..): int {
    let p = if flag then s() else s()
    return firstOf(p)
}

func pullOrLoop(flag: bool, s: int..): int {
    if flag then {
        return firstOf(s())
    } else {
        return loop acc = 0 for x in s while acc < 2 do acc + x
    }
}

func main(): int sync {
    println(pullOrPull(true, count(3)))
    println(pullOrPull(false, count(3)))
    println(pullOrLoop(true, count(3)))
    println(pullOrLoop(false, count(3)))
    return 0
}