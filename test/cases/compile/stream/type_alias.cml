/**
 * One element type, one object: `type Ints = int..` names the same interned type the suffix
 * writes, so a signature that names the alias and one that writes the suffix are the same
 * signature, and both print as `int..` (std::gir prints value_type="int.." for both
 * parameters). That identity is what makes type comparison, overload selection, `#impl`
 * agreement and the printed forms of `std::gir` and the diagnostics agree with each other (the
 * rule).
 *
 * The same rule seen from the other side: `int`, `int..` and `int[]` are three types, so the
 * three overloads of `pick` are three different signatures (and the next case shows that two
 * spellings of one stream type are one).
 */
module stream_type_alias

type Ints = int..

func take(s: Ints): int {
    return 0
}

func give(s: int..): int {
    return 0
}

func pick(x: int): int {
    return 0
}

func pick(x: int..): int {
    return 1
}

func pick(x: int[]): int {
    return 2
}

func main(): int sync {
    println(2)
    return 0
}