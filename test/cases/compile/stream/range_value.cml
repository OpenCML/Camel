// A range is a value of the library's named type `Range`, not an array (design principles 5.4):
// `to_range(a, b, s)` writes its three numbers down, `to_array` is the conversion from it to the
// integers it names, and `is_empty` asks whether it names any.
//
// Nothing is imported. The prelude is the built-in module's declaration file, and what it exports
// comes along with the built-in rules it declares (design principles 10.2, the last layer), so the
// type `Range` and these three functions are written here as they are.

func main() => int sync {
    let r: Range = to_range(1, 5, 1)
    println(r->to_array())
    println(r->is_empty())

    // `for` walks a range through its own `__iter__` (design principles 5.4), whatever its step:
    // down for a negative step, and the end takes no round.
    println(loop n = 0 for i in to_range(10, 0, -3) do { println(i); n + 1 })

    // A range that names no integer runs no round.
    println(loop n = 0 for i in to_range(3, 3, 1) do n + 1)
    return 0
}