/**
 * The streams a `tee` gives are streams like any other (design principles 5.4): a `tee` makes two
 * streams, one for each reader, and each of them is still read once. Reading one side twice is
 * two consumers of that side, so it is refused exactly as reading any other stream twice is.
 */

import stream

func count(n: int): int.. {
    return step(n)
}

func step(n: int): () => (int, int..)? {
    return () => if n > 0 then (n, step(n - 1)) else null
}

func total(s: int..): int {
    return loop acc = 0 for x in s do acc + x
}

func main(): int sync {
    let (left, right) = stream::tee(count(3), 2)
    println(total(left))
    println(total(left))
    println(total(right))
    return 0
}