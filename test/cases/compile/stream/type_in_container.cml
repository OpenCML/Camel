/**
 * A stream is linear: it is consumed once, and the elements of an array are read more than once
 * (design principles 5.4)[3]`). The dimension is read against the stream and the array is
 * refused by name (SemanticDiag::StreamInContainer) - never built, never silently read as
 * `int..` of `[3]`.
 */
module stream_type_in_container

func main(): int sync {
    let s: int..[3] = [1, 2, 3]
    println(0)
    return 0
}