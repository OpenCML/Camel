// A pinned reading of the language, measured while choosing how the generator lowering carries
// its state: a `var` whose first value is `null` does not take a type from a later assignment --
// it stays `void`, and `v ?? 0` is refused ("its left side has type 'void', which is not a
// 'T?'"). State that has to be typed is therefore not carried in a `null`-valued `var`.

func main(): int sync {
    var v = null
    v = 5
    println(v ?? 0)
    return 0
}