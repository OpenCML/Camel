// A name imported by name is the name the program means: `import { range } from tensor` makes
// `range` tensor's, and the built-in of the same spelling is the prelude, the lowest layer, so it
// does not answer for the name while the import is in force (design principles 6.x, "local > this
// module > imported by name > using > built-in"; the author's ruling of 2026-10-24 on the name
// lookup order). A readout of the graph says which entity answered: the call is tensor's OPER, not
// the built-in's.
module h426_range_import_wins

import tensor
import { range } from tensor

func main(): int sync {
    println(range(5))
    println(range(0, 6, 2))
    return 0
}