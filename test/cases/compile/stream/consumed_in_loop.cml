/**
 * A stream written outside a loop and pulled in its body is consumed once per round (design
 * principles 5.4): every round sees the same stream, because a stream is a value, so the second
 * round reads an element the first round already read. The value a round may consume is the
 * loop's own state, which the round takes from its port and hands back as the next state; the
 * diagnostic names that spelling and `for x in s`, and this program is refused.
 */
module stream_consumed_in_loop

func count(n: int): int.. {
    return step(n)
}

func step(n: int): () => (int, int..)? {
    return () => if n > 0 then (n, step(n - 1)) else null
}

func firstOf(p: (int, int..)?): int {
    return match p {
        case null => 0
        case v => v.0
    }
}

func twice(s: int..): int {
    return loop acc = 0 while acc < 2 do acc + firstOf(s())
}

func main(): int sync {
    return twice(count(3))
}