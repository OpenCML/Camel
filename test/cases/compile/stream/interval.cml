// `a..b` is the interval [a, b) (design principles 4.2, the ruling of 2026-10-24): integers
// only, left-closed and right-open like the slice `t[a:b]`, and the `int[]` the two-parameter
// `range(a, b)` gives.
module h405_interval

func main(): int sync {
    let xs = 1..5
    println(xs)
    let n = 3
    println(0..n)
    return 0
}