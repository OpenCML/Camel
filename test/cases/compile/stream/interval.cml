//  `a..b` is the interval [a, b) (design principles 4.2): integers
// only, left-closed and right-open like the slice `t[a:b]`, and the `int[]` of the integers
// from `a` to `b - 1`. It is the one spelling: the two-parameter `range(a, b)` is gone.
module h405_interval

func main(): int sync {
    let xs = 1..5
    println(xs)
    let n = 3
    println(0..n)
    return 0
}