// `using namespace tensor` is layer 4, above the built-in (layer 5): while it is in force `range`
// is the namespace's, so `range(5)` is tensor's one-argument call (design principles 6.x, "local >
// this module > imported by name > using > built-in"). Before the order was fixed the name was
// answered by the merged layer the built-in takes part in, which has no one-argument rule and
// refused this program; the built-in is still reached when no layer above has the name.
module h426_range_using_wins

import tensor
using namespace tensor

func main(): int sync {
    println(range(5))
    return 0
}