/**
 * The overloads of one name have to name the parameter at a position the same way: the second
 * parameter of `f` is `b` in one declaration and `c` in the other, so the call's `b` names no one
 * parameter of `f` (design principles 4.4).
 */

func f(a: int, b: int): int {
    return a * 10 + b
}

func f(a: int, c: string): int {
    return a * 10
}

func main(): int sync {
    return f(a: 1, b: 2)
}