/**
 * `null` is a compile-time constant of the nullable type it stands in (design principles 4.4,
 * 5.1): a `T?` parameter may take it as its default. The default is evaluated where the
 * declaration is -- once -- and every call that leaves the parameter out reads that one value.
 */
module param_default_nullable

// The default of a nullable parameter: the null of `int?`.
func pick(p: int? = null, fallback: int = 7): int {
    return match p {
        case null => fallback
        case v => v
    }
}

// A nullable parameter after the defaulted one, so a call can give the value to `p` instead.
func only(p: int? = null): string {
    return match p {
        case null => 'none'
        case v => format<v>('some {}')
    }
}

func main(): int sync {
    // Left out: the declaration's null.
    println(pick())
    // The default overridden by a value, and by a value the call computes.
    println(pick(3))
    // The parameter after a defaulted one is still given by name.
    println(pick(fallback: 9))
    println(only())
    println(only(5))
    return 0
}