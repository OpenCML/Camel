/**
 * `null` has a nullable type and no other (design principles 3.8, 4.4): a parameter of a type
 * with no `?` has no null to default to, and the declaration says so instead of taking `null`
 * as some universal "no value".
 */

func f(p: int = null): int {
    return p
}

func main(): int sync {
    return f()
}