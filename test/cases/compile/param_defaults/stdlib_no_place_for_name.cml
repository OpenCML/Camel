/**
 * A rule whose parameter count follows its arguments is not one a name can mark a position in:
 * `println` takes a rest list, so which position an argument lands in is decided by the call. The
 * call is refused for the signature it cannot settle where the call is written, not bound to a
 * guessed position: ParamArgumentCallee, at the argument.
 */

func main(): int sync {
    println(fn: 'printf')
    return 0
}