/**
 * A default is evaluated once, where the declaration is; a call does not evaluate it again.
 * The two calls below both leave `label` out, and the graph of `main` holds one constant node
 * for the string, which both calls read (design principles 4.4).
 * `std::gir` prints the graph instead of running it.
 */
module param_default_one_constant

func tag(x: int, label: string = "once"): string {
    return label + string(x)
}

func main(): int sync {
    println(tag(1))
    println(tag(2))
    return 0
}