/**
 * A name the call writes has to be a parameter of the declarations it may reach: `z` is a
 * parameter of neither declaration of `f`, so it names nothing there (design principles 4.4).
 */

func f(a: int): int {
    return a
}

func f(a: int, b: int): int {
    return a + b
}

func main(): int sync {
    return f(a: 1, z: 2)
}