/**
 * A named argument needs a callee whose signature is one declaration: with two overloads of
 * `f`, the name does not say whose parameter it means (design principles 4.4, handover H276).
 */
module param_argument_callee

func f(x: int): int {
    return x
}

func f(x: int, y: int): int {
    return x + y
}

func main(): int sync {
    return f(1, y: 2)
}