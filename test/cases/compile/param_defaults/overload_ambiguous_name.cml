/**
 * Two declarations give the same name to two parameters: in one, `a` is the first parameter and in
 * the other it is the second, so `a` names no one parameter of `f` and the call is refused
 * (design principles 4.4).
 */

func f(a: int, b: int): int {
    return a * 10 + b
}

func f(b: float, a: float): int {
    return a * 10 + b
}

func main(): int sync {
    return f(a: 1, b: 2)
}