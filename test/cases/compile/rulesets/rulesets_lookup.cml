/**
 * A program that imports both rulesets and computes nothing: the case next to it asks the index
 * questions (`CAMEL_RULESET_LOOKUP`), so the program's only job is to build both families.
 */
import { lift } from rulesets.jvp
import rulesets.transpose

func main(): int sync {
    println(lift(1.0).0)
    return 0
}