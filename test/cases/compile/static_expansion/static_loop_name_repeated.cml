/**
 * The field name `n` and the state names are one set: a state named like the field would make
 * `t.[n]` read the state instead of the field. The names of the head may not repeat.
 */
module static_loop_name_repeated

func bad(t: {a: int}): int {
    return static loop n = 0 for (n, F) in fields {a: int} do n + 1
}

func main(): int {
    return bad({a: 1})
}