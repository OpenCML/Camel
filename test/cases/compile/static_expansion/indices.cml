/**
 * `indices`. `static for (j) in indices ts` and `static loop... for j in
 * indices ts` walk the positions of a tuple value when the function is instantiated. `j` is an
 * ordinary `int` value and a compile-time key, the trip count is the tuple's arity, and a tuple
 * held by a type parameter gives a count known only at instantiation.
 */
module indices

func sum(t: (int, int, int)): int {
    return static loop acc = 0 for j in indices t do acc + t.[j]
}

func positions(t: (int, string)): (int, int) {
    return ( static for (j) in indices t => j )
}

func count::<T>(t: T): int {
    return static loop acc = 0 for j in indices t do acc + 1
}

func empty(t: ()): int {
    return static loop acc = 7 for j in indices t do acc + 1
}

/* `j` takes part in the arithmetic, not only as the key. */
func weighted(t: (int, int, int)): int {
    return static loop acc = 0 for j in indices t do acc + t.[j] * (j + 1)
}

/* An `indices` generator inside a `fields` body: the inner tuple is a local value. */
func nested(t: {p: (int, int)}): int {
    var sum = 0
    sync {
        static for (n, F) in fields {p: (int, int)} => {
            let sub = t.[n]
            sum = sum + (static loop acc = 0 for j in indices sub do acc + sub.[j])
        }
    }
    return sum
}

func main(): int sync {
    println(sum((1, 2, 3)))
    let (a, b) = positions((10, 'x'))
    println(a, b)
    println(count((1, 2, 3)))
    println(count((true, false)))
    println(empty(()))
    println(weighted((1, 2, 3)))
    println(nested({p: (5, 6)}))
    return 0
}