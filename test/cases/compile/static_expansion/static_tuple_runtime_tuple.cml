/**
 *  A runtime tuple value is not a build-time tuple.: its arity is not known when the
 * call is compiled, so `..t` is refused. Only a rest parameter's `ts`, a tuple comprehension or
 * a tuple literal can be spread.
 */
module static_tuple_runtime_tuple

func sum3(a: int, b: int, c: int): int {
    return a + b + c
}

func viaTuple(t: (int, int, int)): int {
    return sum3(..t)
}

func main(): int sync {
    return viaTuple((1, 2, 3))
}