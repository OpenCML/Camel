/**
 * The build-time tuple of a rest parameter (H51 step 6): `ts` is not a value, so `indices ts`
 * reads only its type and `ts.[j]` reads the argument node directly. The graph of `main` is the
 * hand-written sum of the three arguments: no FILL for `ts` and no ACCS for its elements.
 */
module static_tuple_graph

func sum(..ts): int {
    return static loop acc = 0 for j in indices ts do acc + ts.[j]
}

func main(): int sync {
    println(sum(1, 2, 3))
    return 0
}