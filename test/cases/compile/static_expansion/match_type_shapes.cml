/**
 * `match type` selects by the shape of a type at instantiation (design principles 5.5, R3).
 * Structures and ordinary tuples are the two inner shapes; `T?`, arrays and scalars are
 * leaves. Only the selected case is built: the `tuple` case of `selected` contains a type
 * error that must not be reported while the case is not selected.
 */
module match_type_shapes

func shape::<T>(t: T): string {
    return match type T {
        case struct => 'struct'
        case tuple => 'tuple'
        case #leaf => 'leaf'
    }
}

func composite::<T>(t: T) {
    return match type T {
        case struct | tuple => true
        case #leaf => false
    }
}

func fallback::<T>(t: T) {
    return match type T {
        case struct => 1
        case _ => 0
    }
}

func selected::<T>(t: T): int {
    return match type T {
        case struct => 1
        case tuple => len(1)
        case #leaf => 3
    }
}

func main(): int sync {
    println(shape({a: 1, b: 2.0}))
    println(shape((1, 2.0)))
    println(shape(42))
    let maybe: int? = 5
    println(shape(maybe))
    println(shape([1, 2, 3]))
    println(composite({a: 1}))
    println(composite((1, 2)))
    println(composite(3))
    println(fallback({a: 1}))
    println(fallback(3))
    println(selected({a: 1}))
    println(selected(2))
    return 0
}