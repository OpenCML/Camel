/**
 * The same walk read as a value use: `for x in ts` walks a compile-time tuple by element, and
 * each round's `x` is the *type* at that position (the ruling of 2026-10-25, H475), so `acc + x`
 * asks a type to be a value and the name is refused where it stands. This is the program the
 * h471 measurement wrote for the tuple form; the form itself now walks, and the value reading is
 * what it does not have -- an ordinary `loop` is the one whose variable is the element's value.
 */
module static_loop_sequence_tuple_value

func f(..ts): int {
    return static loop acc = 0 for x in ts do acc + x
}

func main(): int sync {
    println(f(1, 2, 3))
    return 0
}