/**
 * `for x in ts` walks a compile-time tuple by element, and each round's `x` is the *value* at
 * that position, `ts.[i]`: `acc + x` adds it. This is the
 * program the measurement wrote for the tuple form, and it is a *positive* case now -- the
 * reading that `x` is a type was wrong, and the type of `x` (one position's type) is asked for
 * with `typeof(x)` where it is needed.
 */

func f(..ts): int {
    return static loop acc = 0 for x in ts do acc + x
}

func main(): int sync {
    println(f(1, 2, 3))
    return 0
}