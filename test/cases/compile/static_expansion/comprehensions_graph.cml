/**
 * The graph of a comprehension. the rounds are straight-line ACCS nodes in
 * declaration order and the values are packed by one FILL per struct or tuple; the
 * comprehension leaves no node of its own. `t.[n].[m]` reads its parent once and both inner
 * fields project the same node, as the C++ expansion of `tree_map` does.
 */
module comprehensions_graph

func pairUp(t: {p: (int, int)}): {p: (int, int)} {
    return { static for (n, F) in fields {p: (int, int)} => (
        static for (m, G) in fields F => t.[n].[m] * 10
    ) }
}

func sum(r: {p: (int, int)}): int {
    return r.p.0 + r.p.1
}

func main(): int sync {
    let r = pairUp({p: (1, 2)})
    println(sum(r))
    return 0
}