/**
 * The type of a comprehension's fields comes from the round's value, not from `F` (H79
 * ruling 2). `widen` walks a nested struct/tuple with `match type` and gives every leaf a
 * `float`; the field type `F` at the leaves is `int`, so the result is the same shape with
 * every leaf a `float`. This is the shape `tree_map` has when its callback changes the leaves'
 * type, and the recursive rebuild is written with comprehensions only.
 */
module comprehension_value_type

func widen::<T>(t: T) {
    return match type T {
        case struct => { static for (n, F) in fields T => widen(t.[n]) }
        case tuple => ( static for (n, F) in fields T => widen(t.[n]) )
        case _ => float(t)
    }
}

func half(x: float): float { return x * 0.5 }

func main(): int sync {
    let t = {p: {x: 1, y: 2}, q: (3, 4)}
    let w = widen(t)
    // Each argument binds to the `float` parameter: the fields hold the values' types.
    println(half(w.p.x), half(w.p.y), half(w.q.0), half(w.q.1))
    println(half(widen(5)))
    return 0
}