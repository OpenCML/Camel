/**
 * `fields` and `match type` are followed by a type position (H79 ruling 1): a `(` there is
 * always the start of a type, so `()` is the empty tuple type in both. No named alias such as
 * `type EmptyTuple = ()` is needed, and the empty tuple type prints and hashes exactly as the
 * one an alias would name.
 */
module type_position_empty_tuple

/** The subject of `match type` is the empty tuple type; `case tuple` selects it. */
func describeEmpty(): string {
    return match type () {
        case tuple => 'empty tuple'
        case struct => 'struct'
        case _ => 'leaf'
    }
}

func describeTuple(e: ()): string {
    return 'empty tuple value'
}

/** A comprehension over the empty tuple type has no round: the result is the empty tuple. */
func noElements(): () {
    return ( static for (n, F) in fields () => 0 )
}

/** The statement form expands `fields ()` zero times. */
func zeroFields(): int {
    var rounds = 0
    static for (n, F) in fields () => {
        rounds = rounds + 1
    }
    return rounds
}

func main(): int sync {
    println(describeEmpty())
    println(zeroFields())
    let e: () = noElements()
    println(describeTuple(e))
    return 0
}