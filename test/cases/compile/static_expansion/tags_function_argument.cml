/**
 * A tag parameter declared `func` carries a function of the program as its graph reference: an
 * internal number, not a value the language has. A `static` head that reads such a field's tags
 * is refused here, rather than handed that number as a string; the tags of the other fields of
 * the same type are read as usual.
 */
module tags_function_argument

tag rule<f: func> on field
tag width<w: int> on field

func twice(x: int): int {
    return x + x
}

type Box = {
    #rule<twice> scaled: int,
    #width<8> plain: int,
}

func read(b: Box): int {
    return static loop acc = 0 for n, F, tags in fields Box do
        acc + (match type typeof(tags) {
            case { width: { w: int } } => tags.width.w
            case _ => 0
        })
}

func main(): int sync {
    println(read({scaled: 1, plain: 2}))
    return 0
}