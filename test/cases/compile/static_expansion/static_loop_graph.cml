/**
 * The graph of a `static loop` (step 5) is the hand-written unfolded fold: one ACCS per
 * field in declaration order, one addition per round, and no SLOOP, LOOP, SFOR or SACC node.
 */
module static_loop_graph

func loopSum(t: {a: int, b: int, c: int}): int {
    return static loop acc = 0
        for n, F in fields {a: int, b: int, c: int} do acc + t.[n]
}

func unrolled(t: {a: int, b: int, c: int}): int {
    return ((0 + t.a) + t.b) + t.c
}

func main(): int {
    return loopSum({a: 1, b: 2, c: 3}) - unrolled({a: 1, b: 2, c: 3})
}