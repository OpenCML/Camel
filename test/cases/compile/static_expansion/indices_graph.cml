/**
 * The graph of an `indices` generator. is the hand-written expansion: one ACCS per
 * position, in order, and no SFOR, SLOOP, SACC or LOOP node. (A tuple comprehension of `j` is
 * covered by its value in `indices.cml`; its graph is the FILL of the positions.)
 */

func loopSum(t: (int, int, int)): int {
    return static loop acc = 0 for j in indices t do acc + t.[j]
}

func unrolled(t: (int, int, int)): int {
    return ((0 + t.0) + t.1) + t.2
}

func positions(t: (int, string)): (int, int) {
    return ( static for j in indices t => j )
}

func main(): int {
    let p = positions((1, 'x'))
    return loopSum((1, 2, 3)) - unrolled((1, 2, 3)) + p.0
}