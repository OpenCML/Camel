/**
 * The sequence of a `static loop` must be known when the function is compiled (the ruling of
 * 2026-10-24, H462). A bound that is a parameter has no fixed number of rounds: the loop is
 * unrolled where it stands, so nothing of it can be built, and the compiler says which sequence
 * it could not work out rather than reporting the message of a missing tuple.
 */
module static_loop_sequence_unknown

func sumTo(n: int): int {
    return static loop acc = 0 for i in 0..n do acc + i
}