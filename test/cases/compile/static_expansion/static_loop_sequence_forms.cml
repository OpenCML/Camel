/**
 * The sequence of a `static loop` is decided by one rule, not by a list of accepted spellings
 * (the ruling of 2026-10-25, H475): an expression built only from compile-time constants through
 * operations that are pure and cannot fail is worked out when the function is compiled and then
 * unrolled. So `range(a, b, step)` with constant arguments walks `a, a + step, ...` (design
 * principles 4.2) and an array -- a literal, or a name bound once to one -- walks by element,
 * exactly as the constant interval `a..b` does.
 */
module static_loop_sequence_forms

func inRange(): int {
    return static loop acc = 0 for i in range(0, 10, 3) do acc + i
}

/* A negative step walks downwards, as it does everywhere `range` is written. */
func backwards(): int {
    return static loop acc = 0 for i in range(5, 0, -2) do acc + i
}

/* An array literal is a sequence of its elements. */
func inLiteral(): int {
    return static loop acc = 0 for x in [1, 2, 3] do acc + x
}

/* A `let` bound once to an array is a sequence the compiler knows (a `var` is not: it can be
 * assigned another array before the loop). */
func inBoundArray(): int {
    let xs = [4, 5, 6]
    return static loop acc = 0 for x in xs do acc + x
}

/* The elements need not be integers: each round is a compile-time constant of the array's
 * element type, and `t.[s]` reads it back by its own text. */
func byName(t: {a: int, b: int}): int {
    return static loop acc = 0 for s in ["a", "b"] do acc + t.[s]
}

func main(): int sync {
    println(inRange())
    println(backwards())
    println(inLiteral())
    println(inBoundArray())
    println(byName({a: 10, b: 20}))
    return 0
}