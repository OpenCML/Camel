/**
 * The element of `fields T` has three parts (name, type, tags), so a head may name three; a
 * fourth name has nothing to be and is refused by name (item 4).
 * Any number of names is read by the parser: how many fit is a question about the element, so the
 * count is checked where the walked shape is known.
 */

type Box = { low: int, high: int }

func bad(b: Box): int {
    return static loop acc = 0 for n, F, tags, extra in fields Box do acc + 1
}

func main(): int {
    return bad({low: 1, high: 2})
}