/**
 * The key of `t.[k]` may be a name bound once to a compile-time constant: `first` below is a
 * `let`, so it cannot be assigned another key before the access, and the compiler folds it the
 * way it folds the expression itself. This is what `first_leaf` in the tree library uses to
 * read the first field's name once and use it on both trees.
 */
module static_access_named_constant

func first_of::<T>(t: T) {
    let first = ( static for (n, _) in fields T => n ).[0]
    return t.[first]
}

func main(): int sync {
    println(first_of({a: 1, b: 2}))
    println(first_of((3, 4)))
    return 0
}