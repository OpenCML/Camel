/**
 * `for x in ts` walks a compile-time tuple -- here the rest parameter of the expansion being
 * built -- by element, and each round's `x` is the *type* at that position (the ruling of
 * 2026-10-25, H475). That is what tells a `static loop` from an ordinary `loop`, whose variable
 * is the element's value; `indices ts` walks the same positions and gives an ordinary `int`
 * (6.8.4). So `x` is used where a type is needed, as `load_at::<F>` uses `F`.
 */
module static_loop_sequence_tuple

func tag::<T>(): int {
    return match type T {
        case int => 1
        case float => 2
        case string => 3
        case _ => 0
    }
}

func tags(..ts): int {
    return static loop acc = 0 for x in ts do acc + tag::<x>()
}

func main(): int sync {
    println(tags(1, 2.5, "a"))
    println(tags())
    return 0
}