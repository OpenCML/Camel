/**
 * Two tags of one field written with the same name -- `#width(1)` of this module and
 * `#tags_second_width::width(2)` of the imported one -- would be a single field of the `tags`
 * struct, because `tags` names a field by the tag alone. The reading therefore reports both
 * qualified names rather than keeping the first one and dropping the second.
 */
module tags_field_name_conflict

import tags_second_width

tag width(w: int) on field

type Box = {
    #width(1) #tags_second_width::width(2) marked: int,
}

func read(b: Box): int {
    return static loop acc = 0 for n, F, tags in fields Box do
        acc + 1
}

func main(): int sync {
    println(read({marked: 3}))
    return 0
}