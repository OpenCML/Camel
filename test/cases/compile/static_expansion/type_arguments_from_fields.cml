/**
 * A `static for` binds each field's type, and the bound type can be written as an explicit type
 * argument of a recursive call: the tree walk the checkpoint design needs (design/generic-structure
 * 3.1.3) is an ordinary generic function. The leaf produces an `int` for every leaf type, so the
 * walk is shown on a type whose leaves are all `int`; producing the leaf's own value needs a
 * native operator for the leaf type (handover H103).
 */
module type_arguments_from_fields

func leaf::<L>(depth: int): L { return depth }

func load_at::<T>(depth: int): T {
    return match type T {
        case struct => { static for (n, F) in fields T => load_at::<F>(depth + 1) }
        case tuple => ( static for (n, F) in fields T => load_at::<F>(depth + 1) )
        case _ => leaf::<T>(depth)
    }
}

func main(): int sync {
    let tree: { a: int, b: (int, { c: int }) } = load_at(0)
    println(tree.a)
    println(tree.b.0)
    println(tree.b.1.c)
    return 0
}