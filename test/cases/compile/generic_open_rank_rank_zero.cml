// `T[..]` includes rank 0, and a rank-zero array is that element (design principles 5.4): a value
// of the element type is a value of the open rank, the same value and the same printing. So a
// generic function's open-rank parameter takes a number, binds its element type from it, and the
// call answers the number.
//
// The array itself still enters the same parameter at every rank the value has: `float[3]` and
// `float[]` are what the other two calls give, and they were accepted before this edge existed.
import { sum_to } from tensor

func main(): int sync {
    let xs = [1.0, 2.0, 3.0] as float[..]
    let fixed = [1.0, 2.0, 3.0]
    println(`sum_to(6.0, xs) = ${sum_to(6.0, xs):.1f}`)
    println(`sum_to(xs, 6.0) = ${sum_to(xs, 6.0):.1f}`)
    println(`sum_to(fixed, 6.0) = ${sum_to(fixed, 6.0):.1f}`)
    return 0
}