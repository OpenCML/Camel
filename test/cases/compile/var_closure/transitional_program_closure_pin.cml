/**
 * The other half of the same pin, in one program: the generator below writes its own `var` between
 * two `yield`s (a closure the compiler makes, not checked -- see the `ok_` case beside this one),
 * and `bad` writes a `var` it captured from a closure the program wrote, which is checked and
 * refused where the write is. The diagnostic names `total` and never `i`: one file proves both
 * that the rule still sees a program's closure and that it leaves the compiler's own alone.
 */

func count(): int.. sync {
    var i = 0
    yield i
    i = 5
    yield i
}

func bad(x: int): int {
    var total = x
    let add = (k: int): int => sync {
        total = total + k
        total
    }
    add(1)
}

func main(): int sync {
    println(loop acc = 0 for v in count() do acc * 10 + v)
    println(bad(1))
    return 0
}
