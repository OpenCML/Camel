/**
 * The other end of the stretch: the closure's value is put into ANOTHER VALUE -- the array `many` --
 * and `c`, the name the closure read, is assigned after it. Design principles 3.5 (198) gives that
 * shape an end without a source offset: "the closure's value put into another value runs to the rest
 * of the scope", so the write stands inside the stretch and is
 * `CapturedVarWrittenAfterTheClosure` (the rule, item 3).
 *
 * This is the array sibling of the tuple shape `test/cases/opt/effects/dead_write_dropped_closure.cml`
 * reads, and the scan reaches both the same way: the block that binds `h` never names it again --
 * `many[1]()` names `many` and not `h` -- so the placement behind the binding is the only thing the
 * graph could say about the end.
 *
 * The write is refused at the assignment. Before the scan implemented that sentence the write was
 * built and then erased at the end of the graph for having no reader left, so the program ran and
 * printed a value that no longer depended on it and said nothing (f92e5246f).
 */

func probe() => int {
    var c = 0
    let h = func () => int {
        c
    }
    let many = [h, func () => int {
        1
    }]
    c = 41
    return many[1]()
}

func main() => int sync {
    println(probe())
    return 0
}
