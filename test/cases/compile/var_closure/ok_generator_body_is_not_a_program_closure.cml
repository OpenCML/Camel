/**
 * The rule of a captured value is about a closure the PROGRAM writes. A generator body is one the
 * compiler makes: `visitGeneratorBody` (src/compile/gct/builder.cpp) cuts the body at its `yield`s
 * and hands the rest to a step closure of its own, so the write of `i` between the two pulls is
 * that closure writing the body's cell -- not a name the program captured (design principles 3.5,
 * the ruling of 2026-11-15). The mark that says so is written where the body is synthesised and
 * read by `visitFuncNode`; this case is what keeps that mark visible.
 *
 * The reading is the stream flattened the way `generators.cml` flattens it: `5` (0 then 5).
 */

func count() => int.. sync {
    var i = 0
    yield i
    i = 5
    yield i
}

func main() => int sync {
    println(loop acc = 0 for v in count() do acc * 10 + v)
    return 0
}
