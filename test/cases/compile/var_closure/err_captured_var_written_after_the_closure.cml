/**
 * `x`, a `var` a closure mentions, is assigned after the closure is made and before the closure is
 * used again: a compile error (design principles 3.5, the author's ruling of 2026-11-15, 198). The
 * closure holds the value `x` had when it was made, so the write would not reach it -- `g()` would
 * print 1 and not 2 -- and the rule does not leave that to the writer to notice.
 *
 * The closure is bound to a name here, which is what makes its last use knowable: the name's last
 * use in the block that binds it. The report names the closure and the assignment.
 */

func main() => int sync {
    var x = 1
    let g = func () {
        x
    }
    x = 2
    println(g())
    return 0
}
