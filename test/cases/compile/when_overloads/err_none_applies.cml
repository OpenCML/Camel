module when_overloads_err_none_applies

import { is_float, is_complex } from types

func kind::<T>(x: T): string when is_float::<T>() {
    return 'float'
}

func kind::<T>(x: T): string when is_complex::<T>() {
    return 'complex'
}

func main(): int sync {
    println(kind('text'))
    return 0
}
