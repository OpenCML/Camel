/**
 * The same rule in a body that is not `sync`: a `return` gives the block's value wherever the
 * block is written, so the expression after it is never reached -- and it is not a second
 * diagnostic about an unused pure value either, because it is not built at all.
 */

func g(x: int): int {
    let y = x + 1
    return y
    y * 2
}

func main(): int sync {
    println(g(1))
    return 0
}