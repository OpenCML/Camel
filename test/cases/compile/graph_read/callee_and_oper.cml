// What the read face of a build-time draft is checked against: a program whose graphs have one of
// everything the face answers. `main` calls `twice` (a FUNC node with a callee), adds a number to
// the result (an OPER node with an operator), and answers the sum (a cast, a port, an exit); the
// front end also leaves the placeholders (`Dref`) a draft holds and an encoded graph does not, so
// the check is asked of a graph where the two numberings differ.
func twice(x: float): float {
    return x + x
}

func main(): int sync {
    let doubled = twice(2.0)
    println(doubled + 1.0)
    return 0
}