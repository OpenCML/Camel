// One warning, one source file and nothing else: a warning is rendered with the source line it is
// about, its note and its help, and a snapshot pins that rendering. The warning is an external read
// nothing depends on -- demand-driven, so it does not run (design principles 3.1) -- and not the
// `println('never printed')` it used to hold: a write to a resource outside the program is used by
// the region it is written in (the author's ruling of 2026-11-15), so it runs and reports nothing.
import { get_env } from env

func main(): int {
    get_env("CAMEL_DIAG_RENDER_NO_SUCH_VARIABLE")
    return 0
}