/// the same library as `main_deep.cml`, with a module root that holds `lib.cml`. A
/// library's import resolves through the `-I` roots and never through the entry directory, so
/// this prints `helper+root1`; under the old order the entry directory came first and printed
/// `helper+root`.

import deep.helper

func main(): int sync {
    println(helper::name())
    return 0
}