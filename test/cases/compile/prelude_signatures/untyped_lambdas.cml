// The signatures of the built-in functions are declared in the prelude, so a lambda written for
// one of them leaves its parameter types out and takes them from the declaration.
func main() => int sync {
    let xs = [1, 2, 3, 4]
    println(xs->filter<func (x) {
        x % 2 == 0
    }>)
    println(xs->map<func (x) {
        x * 10
    }>)
    xs->foreach<func (x) {
        println(x)
    }>
    let total: int = xs->reduce<func (a, x) {
        a + x
    }, 0>
    println(total)
    let words = ['a', 'bb', 'ccc']
    println(words->filter<func (w) {
        len(w) > 1
    }>)
    println([1.5, 2.5]->map<func (v) {
        v * 2.0
    }>)
    return 0
}
