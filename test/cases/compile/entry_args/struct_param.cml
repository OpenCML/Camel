/**
 * A struct parameter (a model's weights) is given as a directory holding one file per leaf,
 * named by its path in the struct (`fc.w.npy`), the layout nn.save_params writes. The scale is
 * an f32 like the tensor it multiplies: a `float` one is a type error, not a conversion
 * (design principles 5.1).
 */

import { tanh } from tensor

type Linear = { w: f32[3, 4], b: f32[4] }
type Model = { fc: Linear }

with <p: Model>
func main(x: f32[2, 3], scale: f32): (f32[..], f32[..]) {
    let h = tanh(x @ p.fc.w + p.fc.b)
    return (h, h * scale)
}
