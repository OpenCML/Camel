/**
 * `with` parameters of `main` are context parameters, the natural place of a model's
 * weights; ordinary parameters are the data. A layer is called as `layer<w, b>(x)` or, to
 * chain layers, as `x->layer<w, b>`. Both kinds get their values the same way when the
 * program is run.
 */

import { tanh } from tensor

with <w: f32[3, 4], b: f32[4]>
func layer(x: f32[..]): f32[..] {
    return tanh(x @ w + b)
}

with <w: f32[3, 4], b: f32[4]>
func main(x: f32[?, 3]): int sync {
    println(layer<w, b>(x))
    println(x->layer<w, b>)
    return 0
}
