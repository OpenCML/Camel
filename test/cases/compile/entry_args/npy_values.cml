// A parameter bound from a .npy file reads the file's own shape: what the loader produces is a
// static value of the entry graph, and the clone that puts it there keeps every dimension
// (src/runtime/draft_session.cpp, cloneStaticSlot).
module entry_npy_values

import { numel, shape } from tensor

func main(x: f32[2, 3], w: f32[3, 4]): int sync {
    println(shape(x), numel(x), shape(w), numel(w))
    return 0
}
