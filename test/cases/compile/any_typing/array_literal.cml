module array_literal

import { decode } from json

// An `any` element next to an `int` one is an element type mismatch. The literal used to take
// the type of the later element, so the decoded string's address became an `int` that could
// be added to (docs/design/any-typing, defect D2).
func main(): int sync {
    let xs = [decode('"ab"'), 5]
    println(xs[0] + xs[1] > 1000)
    return 0
}
