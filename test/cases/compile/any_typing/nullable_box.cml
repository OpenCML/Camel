module nullable_box

import { decode } from json

// An `any` value entering `any?` is boxed like every other payload, so `??` opens a real box.
// It used to be passed on unboxed and `??` read the integer 7 as the address of a box
// (segmentation fault; docs/design/any-typing, defect D1). `decode` is the one operator that
// gives an `any`; a branch with a `null` arm puts it into `any?`.
func main(): int sync {
    let n = len('ab')
    let a = if n > 0 then decode('7') else null
    let v = a ?? decode('0')
    println(v)
    return 0
}
