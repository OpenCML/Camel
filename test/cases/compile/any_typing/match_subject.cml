module match_subject

// An `any` value as the subject of a `match` is refused: it used to be compared bit for bit
// with the cases, a string by address, so `'ab'` fell to `case _` (docs/design/any-typing,
// defect D5).
func wrap_s(x: string): any { return x }
func main(): int sync {
    let v = wrap_s('a' + 'b')
    let r = match v {
        case 1 => 'one'
        case 'ab' => 'ab'
        case _ => 'other'
    }
    println(r)
    return 0
}
