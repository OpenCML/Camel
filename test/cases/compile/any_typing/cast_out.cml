module cast_out

// `as T` out of `any` is refused: the slot does not record what entered it. Reading 12345 back
// as a string followed it as an address (segmentation fault; docs/design/any-typing, t03).
func main(): int sync {
    let n = 12345
    let a = n as any
    let s = a as string
    println(s)
    return 0
}
