/**
 * `!=` on the two element types whose comparison the fastvm compiler can fuse: a loop over integers
 * and a comparison of two `f64`. The graph holds `:op/not` over `:op/eq_i` / `:op/eq_d` (the front
 * end builds `!=` as `!(==)`), and the back end emits one `LNE` / `DNE` for each. Nothing runs this
 * program under `std::bc`: the pass prints the bytecode and yields an empty graph.
 */

func count_to(n: int): int sync {
    var total = 0
    let _ = loop i = 0 while i != n do sync {
        total += i
        i + 1
    }
    return total
}

func float_ne(a: f64, b: f64): bool { return a != b }

func main(): int sync {
    println('fused={} float={}'->format<count_to(8), float_ne(1.5, 2.5)>)
    return 0
}