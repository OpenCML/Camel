// Two `i32` values that carry the same number are equal whatever route each one took to its
// slot: a value that came through a wider one keeps its sign in the high half of the slot, a
// value that came out of `i32` arithmetic leaves zeros there, and the number is the low half in
// both cases. Comparing the whole slot word compares the encoding instead, and a value stops
// being equal to itself.
//
// The other types that are narrower than a slot are here beside it: `f32`, `bf16`/`f16` compare
// the number their bits name, and `bool` is one byte, written one way; `i64` fills the slot, so
// its word is its value. `i8`/`i16` do not exist in the language.

func main() => int {
    let m: i32 = -3
    let z: i32 = 0
    let low: i32 = -2147483647 - 1
    println(m == m + z, m + z == m, m == m + i32(0))
    println(low == low + z, low + z == low)
    println(m == i32(-3), i32(-3) == m)
    println(m < m + z, m > m + z, low < low + z, low > low + z)
    let wide: i64 = -3
    println(wide == wide + 0, wide == wide + i64(0))
    let narrow: i32 = i32(wide)
    println(narrow == m, narrow + z == m)
    let f: f32 = 1.5
    let g: f32 = f32(3) / f32(2)
    println(f == g, f == f32(1.5), f < g, f > g)
    let flag: bool = true
    let flags: bool[] = [true]
    println(flag == (1 < 2), flags[0] == flag, (!false) == flag)
    let sum: float = 0.1 + 0.2
    println(sum == 0.30000000000000004, sum < 0.30000000000000004)
    let bench: i64 = -3
    let computed: i64 = i64(0) - i64(3)
    println(bench == computed, bench == bench + 0, bench < computed, bench > computed)
    return 0
}