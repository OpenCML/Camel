/**
 * The same operator as `gen.cml` uses, but this module imports `models` itself (here only
 * for the type): the overload is found through the import and through the type's declaration.
 * It must stay one candidate, not two (design principles 5.7).
 */
module gen_imports

import { Box } from models

export func keep(b: Box): Box {
    return b
}

export func twice(x: typeas T): T {
    return x + x
}