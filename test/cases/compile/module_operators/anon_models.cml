/**
 * An operator for an anonymous struct type. The type is declared in no module, so there is no
 * declaring module to look the operator up in; a use from another module cannot reach it
 * through the type (design principles 5.7).
 */

export func operator +(a: { v: int }, b: { v: int }): { v: int } {
    return { v: a.v + b.v }
}