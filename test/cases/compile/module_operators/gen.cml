/**
 * A generic function whose body uses its type argument's operators. The body is built in this
 * module, which does not import `models`: the operator is looked for in the module that
 * declares the type as well (design principles 5.7), not only among the imports written here.
 */
module gen

export func twice(x: typeas T): T {
    return x + x
}

export func same(a: typeas T, b: T): bool {
    return a == b
}

export func differs(a: typeas T, b: T): bool {
    return a != b
}

/**
 * `+=` follows its plain operator (`+`, design principles 4.3), which is the declaring
 * module's one here as well (5.7). Sync because the rebinding writes a variable.
 */
export func bump(x: typeas T, y: T): T sync {
    var acc = x
    acc += y
    return acc
}