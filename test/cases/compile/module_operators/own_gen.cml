/**
 * The expression's own module declares `+` for `Box` (which it imports for the type). Two
 * other modules offer `+` for `Box` too, but only in the caller's imports: they are not
 * candidates here (design principles 5.7), so the module's own operator is the one.
 */

import { Box } from two_models

func operator +(a: Box, b: Box): Box {
    return { v: 300 }
}

export func twice::<T>(x: T): T {
    return x + x
}