/**
 * The empty pack selects no case that writes its first member (design principles 5.6): a pack with
 * nothing in it has no first member to give the name the case writes, so the case does not select
 * it, and the type computed from that pack is refused where the program uses it. The refusal names
 * the pack that was empty.
 *
 * The pattern is the program's own here -- it imports `WithOf<F>`, which computes the pack, and
 * nothing that takes one apart -- so what the refusal states is the rule of the case and not a rule
 * of a library name.
 */
import { WithOf } from types

type Head<P> = match type P { case (W, ...Rest) => W }

// A function with no `with` parameter: the pack of `with` parameters is the empty one.
type Plain = (x: float) => float

func main(): int sync {
    let head: Head<WithOf<Plain>> = 1.0
    return 0
}