/// A function with a body takes a pack the same way a declaration without one does: the rest
/// parameter `..xs: ..A` binds `A` to the types of the arguments it takes, the result type is
/// written over the pack, and `when ..is_array::<A>()` asks every member.
import { ElementOf, is_array } from types

func firsts::<..A>(..xs: ..A): (..ElementOf<A>) when ..is_array::<A>() {
    return ( static for j in indices xs => xs.[j][0] )
}

func main(): int sync {
    let a = [1, 2, 3]
    let b = ['x', 'y']
    let t: (int, string) = firsts(a, b)
    println(t)
    return 0
}
