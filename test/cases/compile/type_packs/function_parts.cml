/// `ParamsOf<F>` and `WithOf<F>` are the parameters of a function type as a type pack, and `..`
/// writes them where a list of types is: the elements of a tuple. `ResultOf<F>` is its result.
import { is_same, ParamsOf, WithOf, ResultOf } from types

type Binary = (a: int, b: string) => bool
type Weighted = <w: float, k: int> (a: int) => bool
type Unary = (a: int) => string

func main(): int sync {
    println(is_same::<(..ParamsOf<Binary>), (int, string)>())
    println(is_same::<(..WithOf<Weighted>), (float, int)>())
    println(is_same::<ResultOf<Unary>, string>())
    println(is_same::<(..ParamsOf<Weighted>), (int)>())
    return 0
}
