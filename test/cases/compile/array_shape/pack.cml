// A trailing pack stands for the dimensions the type does not name: `..` anonymously, `..rest`
// with a name a call may bind. A rank-2 array is written `T[3, 4]`, never `T[][]`.
module array_shape_pack

func rankAtLeastTwo(x: float[3, ..rest]): int {
    return 0
}

func anyRank(x: f32[..]): int {
    return len(x)
}

func main(): int sync {
    println(anyRank([1.0, 2.0, 3.0]))
    return 0
}