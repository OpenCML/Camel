// `?` is a size nobody named, not a name: two parameters that write `?` say nothing about each
// other, so one call may give them different lengths. Both arguments state their extent, and the
// call relates neither.

func total(a: f32[?], b: f32[?]): int {
    return len(a) + len(b)
}

func main(): int sync {
    let v: f32[] = [1.0, 2.0, 3.0]
    let w: f32[] = [4.0, 5.0]
    let a = v as f32[3]
    let b = w as f32[2]
    println(total(a, b))
    return 0
}