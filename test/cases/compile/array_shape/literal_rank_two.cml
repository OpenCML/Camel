// A position that states a rank of its own (`f32[2, 2]`) takes the nested literal as one array of
// that shape (design principles 5.1, 5.4): the extent reads two rows of two, and the array holds
// four elements, not two rows.

import { shape, numel, dim } from tensor

func main(): int sync {
    let b: f32[2, 2] = [[1.0, 2.0], [3.0, 4.0]]
    println(shape(b))
    println(numel(b))
    println(dim<0>(b))
    println(dim<1>(b))
    return 0
}