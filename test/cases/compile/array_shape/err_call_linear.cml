// A linear form is exact, not a guess: `n` is 2 from the first argument, so the second argument
// must have exactly `2 + 1` elements, not merely a length the name could be moved to.
module array_shape_err_call_linear

func pair(a: f32[n], b: f32[n + 1]): int {
    return len(a) + len(b)
}

func main(): int sync {
    let v: f32[] = [1.0, 2.0]
    let w: f32[] = [3.0, 4.0]
    let a = v as f32[2]
    let b = w as f32[2]
    println(pair(a, b))
    return 0
}