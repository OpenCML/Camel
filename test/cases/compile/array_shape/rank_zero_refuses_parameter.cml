// Rank zero is the element itself (design principles 5.4), so a value of the element type is a
// value of `T[..]` -- but a *slot* of type `T[..]` has no rank at run time. An array-typed slot
// holds an array; a scalar put in it is read as one, and `show(2.5)` printing `v` crashed the
// process (exit 139). Until a rank-zero value has a representation of its own, the parameter slot
// takes the arrays it can hold and refuses the element at compile time -- this is not a missing
// representation to be filled in later at the type level, it is a slot that cannot hold the value
// yet. A name declared `f32[..]` still takes the element as itself (`open_rank_element.cml`): a
// declaration makes a name, not a slot, and the name is the element.

func show(v: f32[..]) {
    println(v)
}

func main(): int sync {
    let s: f32 = 2.5
    show(s)
    return 0
}