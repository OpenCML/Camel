// An array whose elements are `f32[..]`: the element slot, both writings. `[1.0, 2.5]` is two
// elements written where the element type is an open rank, so each element is the rank-zero value
// of the number (design principles 5.4), and `[one, two]` is the same two elements computed.
//
// What this case pins: the element type of an array literal is converted per element -- the data
// side for literal elements, the FILL side for computed ones -- so an array of an open rank's
// elements holds values a program can read, and both writings read the same.

func main(): int sync {
    let one: f32 = 1.0
    let two: f32 = 2.5
    let written: f32[..][2] = [1.0, 2.5]
    println(written[0])
    println(written[1])
    let computed: f32[..][2] = [one, two]
    println(computed[0])
    println(computed[1])
    return 0
}
