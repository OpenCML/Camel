// The ranks a *declaration* written `f32[..]` takes: every rank, the zero rank included, because
// rank zero is the element itself (design principles 5.4). A value of type `f32` is that element,
// so a name declared `f32[..]` and given it is the number itself, not an array holding it -- it
// prints as one, because a rank-zero array is not a separate type. A rank-1 and a rank-2 array are
// the arrays they are.
//
// A parameter slot is not a declaration: it holds an array at run time and has no rank of its own,
// so it takes the arrays and refuses the element (`rank_zero_refuses_parameter.cml`).

func rank(v: f32[..]): int {
    return 1
}

func main(): int sync {
    let row: f32[3] = [1.0, 2.0, 3.0]
    println(rank(row))
    let grid = [[1.0, 2.0], [3.0, 4.0]] as f32[2, 2]
    println(rank(grid))
    let scalar: f32 = 2.5
    let open: f32[..] = scalar
    println(open)
    let cast = scalar as f32[..]
    println(cast)
    return 0
}
