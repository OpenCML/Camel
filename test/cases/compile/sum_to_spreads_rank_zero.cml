// `sum_to(t, like)` is the adjoint of broadcasting read off the shape, and the adjoint runs both
// ways (design principles 5.4: `T[..]` includes rank 0, and a rank-zero array is that element). A
// `like` of higher rank states lanes `t` never had, so `t` is spread out over them instead of being
// summed back: a rank-zero `t` -- the element itself -- spreads as that value.
//
// The reduction direction is unchanged: `sum_to(xs, 6.0)` still totals `xs` into the element.
import { sum_to } from tensor

func main(): int sync {
    let xs = [1.0, 2.0, 3.0] as float[..]
    println(`sum_to(6.0, xs) = ${sum_to(6.0, xs):.1f}`)
    println(`sum_to(xs, 6.0) = ${sum_to(xs, 6.0):.1f}`)
    println(`sum_to(xs, xs) = ${sum_to(xs, xs):.1f}`)
    return 0
}