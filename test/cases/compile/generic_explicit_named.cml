module generic_explicit_named
// Type arguments by position (the order of first appearance in the signature) or by name,
// not mixed (design principles 5.9).
func pair::<B, A>(b: B, a: A): (A, B) { return (a, b) }
func second::<T>(x: T): T { return x }
func main(): int sync {
    println(pair::<string, int>('s', 1))
    println(pair::<A = int, B = string>('s', 1))
    println(pair::<B = string, A = int>('s', 1))
    let f = second::<T = float>
    println(f(2.5))
    return 0
}
