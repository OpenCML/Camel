// The position a member read names is a compile-time parameter of the call: a value only a run
// knows cannot select the member the read names.
func at(x: (int, int), i: int) => int {
    return access::<(int, int), int><i>(x)
}

func main() => int sync {
    println(at((10, 20), 1))
    return 0
}