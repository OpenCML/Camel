/**
 * `stdout` is a resource the program does not own: a clause that names it writes it, so the entry
 * is written with `var` (design principles 3.3). Without the word the clause is refused, and the
 * repair is that one word -- the name it belongs to is already written, so the report carries it.
 */

func tick(): int uses stdout sync {
    println('x')
    return 1
}

func main(): int sync {
    return tick()
}