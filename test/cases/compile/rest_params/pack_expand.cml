/**
 * A pack (design principles 5.6): `..` at the head of a declaration declares a pack parameter,
 * `..xs: ..A` is a rest parameter that gives the pack its members, and a type written `..A` is
 * one type per member. Each call binds the pack to the types of the arguments it leaves over —
 * one member per argument, in order — so the members take the types the arguments have, and the
 * result type written `..A` is those types as the tuple they make.
 */

func both::<..A>(..xs: ..A): ..A {
    return (xs.[0], xs.[1])
}

// The result type is the pack: a call whose members are (string, int) enters (string, int), and
// one whose members are (int, string) would not. The order of the members is the order of the
// arguments, so the types are not one type written twice.
func counted(): (string, int) {
    return both('y', 2)
}

func main(): int sync {
    let (a, b) = both(1, 'x')
    println(a, b)
    let (c, d) = counted()
    println(c, d)
    return 0
}