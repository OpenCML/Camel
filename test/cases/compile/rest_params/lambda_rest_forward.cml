// The rest parameter of a lambda is a value in its body: `xs` is the tuple of the parameters the
// position's function type gave the lambda. `..xs` at a call then spreads that tuple by the rule the
// language already has for spreading a compile-time tuple.
//
// TEMP: this is the hand case for the lowering -- it is expected to be red until the binding lands.

func forward(f: (a: float, b: float) => (float, float)): (float, float) {
    return f(1.0, 2.0)
}

func apply(f: (a: float, b: float) => (float, float)): (float, float) {
    return forward((..xs) => forward(..xs))
}

func main(): int sync {
    let (x, y) = apply((a: float, b: float) => (a + b, a * b))
    return 0
}