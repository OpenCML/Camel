// The boundary this step leaves: an argument of the pack's own element type is still not carried
// into the body (that is the step that binds the pack in the body), so the call is reported as one
// with no matching function. When that step lands this case must change with it.
with <..ws: int>
func g(x: float): float {
    return x
}

func main(): int sync {
    println(g<1>(2.5))
    return 0
}