// A lambda's rest parameter takes the parameters of the function type the position gives it. Here
// the position is an argument to a parameter of function type: `apply` takes
// `(a: float, b: float) => float`, so `...xs` stands for both parameters, in their types, and
// `(...ys: float[...])` gets one.

func apply(f: (a: float, b: float) => float): float {
    return f(1.0, 2.0)
}

func apply_one(f: (x: float) => float): float {
    return f(3.0)
}

func main(): int sync {
    let sum = apply((...xs) => 0.0)
    let one = apply_one((...ys: float[...]) => 1.0)
    return 0
}