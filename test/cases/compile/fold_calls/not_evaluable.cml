/**
 * A call whose body is built from a construct the build-time evaluator does not read is not
 * folded: `first_of_list` holds a function literal, and that is not one of the constructs a `when`
 * condition's evaluator handles. A place that needs a constant refuses the call by name
 * (FoldCallNotEvaluable) with the construct it stopped at, rather than guessing a value.
 */
module fold_call_not_evaluable

func first_of_list(): int {
    let step = (n: int): int => n + 1
    return step(1)
}

func main(): int {
    let t = (10, 20, 30)
    return t.[first_of_list()]
}