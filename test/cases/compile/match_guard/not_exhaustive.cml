/**
 * A guarded case does not count towards the exhaustiveness of a `match`: `case 1 when c` is
 * taken only where `c` holds, so the values it does not take have no case at all (and Rust
 * is the same).
 *
 * The match below has one case and it carries a guard: the report is the one a match with no
 * `case _` gets, rather than the syntax error the case was before the guard was part of a
 * case (`case 1 when n > 0` read `when` as the second word of the pattern).
 */

func a(n: int): int {
    return match n {
        case 1 when n > 0 => 10
    }
}

func main(): int sync {
    return a(1)
}