/**
 * A guarded case whose value cannot be compared with the value matched is the same report an
 * unguarded one gives: `case 1` on a `string` is MatchCaseTypeMismatch, naming the two types,
 * rather than a report about `==` having no overload — the guard must not change which
 * diagnostic a case of the wrong type gets.
 */

func f(s: string): int {
    return match s {
        case 1 when true => 1
        case _ => 0
    }
}

func main(): int sync {
    return f('a')
}