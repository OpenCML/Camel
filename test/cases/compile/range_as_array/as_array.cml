/**
 * A range is a value of its own type (design principles 5.4), and the array of its integers is
 * what a position that expects one materializes: a typed `let`, a `return` under `int[]`, an
 * argument written for a parameter of `int[]`, and an argument for a parameter of `T[]`, whose
 * variable takes the element the range's array has. Elsewhere the range stays the value it is, so
 * the same three numbers still answer `len` as a range does.
 */

func count(xs: int[]) => int {
    return len(xs)
}

func count_all::<T>(xs: T[]) => int {
    return len(xs)
}

func first_four() => int[] {
    return 1 .. 5
}

func main() => int sync {
    let xs: int[] = 0 .. 3
    let ys = count(2 .. 6)
    let zs = first_four()
    let ws = count_all(1 .. 6)
    let r = 0 .. 3
    'xs={} ys={} zs={} ws={} r_len={}'->format<len(xs), ys, len(zs), ws, len(r)>->println
    return 0
}