/**
 * The shape that still does not run: a branch whose value *is* taken by nobody (design principles 3.1,
 * 3.7). `let unused = if ...` gives the branch a name nobody reads, so the branch's value is a value
 * nobody wants, the branch is not a statement of the body, and the write in the arm it would take does
 * not run with it. Nothing is printed and nothing is reported: the diagnostic that used to name the
 * branch went with the region roots (the author's ruling of 2026-11-17), and this is still the
 * reading the author's `R2` asks for: no arm is executed because the branch is not in the execution,
 * and the arm the branch does not take is never executed either.
 *
 * The other half of the judgement lives next to this one: `branch_statement.cml` is the same `if`
 * written as a statement, whose value nobody wants because it has none, and that one runs with its
 * body. What tells the two apart is the value the branch joins (design principles 3.7): a branch that
 * joins no value is a statement of its region; a branch that joins one nobody reads is not.
 *
 * Nothing is printed.
 */

func quiet(x: int): int {
    return x + 1
}

func value_dropped(): int {
    let unused = if quiet(0) > 0 then { println("a") } else { println("b") }
    return 0
}

func main(): int sync {
    value_dropped()
    return 0
}