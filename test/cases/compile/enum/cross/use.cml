module use

import { Shape, Option, area, unwrapOr } from shapes
import shapes

func main(): int sync {
    let a = Shape::Circle(1.0)
    let b = Shape::Rect { w: 2.0, h: 3.0 }
    let c = Shape::Empty
    println(area(a), area(b), area(c))
    let some: Option<int> = Option::Some(7)
    let none: Option<int> = Option::None
    println(unwrapOr(some, -1), unwrapOr(none, -1))
    println(shapes::area(Shape::Circle(2.0)))
    println(a, b, c)
    return 0
}