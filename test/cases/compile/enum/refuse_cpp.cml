// `std::cpp` translates numbers, bool, string, arrays, tuples, structs, T?, T! and functions
// of these: an enum is refused, and the refusal names the parameter it cannot translate.

type Shape = enum {
    Circle(float),
    Empty,
}

func area(s: Shape): float {
    return match s {
        case Shape::Circle(r) => r * r
        case Shape::Empty => 0.0
    }
}

func main(s: Shape): float {
    return area(s)
}
