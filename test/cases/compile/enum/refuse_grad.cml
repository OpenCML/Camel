// autodiff: a value that depends on the differentiated parameter cannot be put into an enum
// (its operators have no derivative rule); `grad` refuses where the value is built rather than
// returning a wrong zero.

import { grad } from autodiff

type Shape = enum {
    Circle(float),
    Empty,
}

func area(s: Shape): float {
    return match s {
        case Shape::Circle(r) => r * r
        case Shape::Empty => 0.0
    }
}

func through_enum(x: float): float {
    return area(Shape::Circle(x))
}

func main(): int sync {
    println(grad(through_enum)(3.0))
    return 0
}
