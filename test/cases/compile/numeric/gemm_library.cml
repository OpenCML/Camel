/**
 * The library GEMM and the canonical GEMM are two implementations of one operator (design
 * principles 9.6). The default policy lets the plain product use the library (7.3's
 * `reassociate`); `#strict` withholds every permission, so its product runs the canonical
 * algorithm (7.4). The program prints the two sums and the largest per-element difference,
 * together with the bound the licence gives for it: `gamma_K * sum |a_k b_k|`, at most
 * `K^2 * eps * max|a| * max|b|` for an output of K products. The shape is 1024^3, above the
 * library's measured size threshold (gemm.cpp), so a CBLAS build really runs both
 * implementations; a build without one runs the canonical kernel twice (diff 0). The test
 * asserts the difference is inside that bound; a library whose results left the licence's bound
 * would fail it.
 */

import { abs, max, sum } from tensor
import { next_key, normal, seed } from random
import { is_numeric } from types

#strict
func exact::<T>(a: T[..], b: T[..]): T[..] when is_numeric::<T>() {
    return a @ b
}

func fast::<T>(a: T[..], b: T[..]): T[..] when is_numeric::<T>() {
    return a @ b
}

func max_abs(t: f32[..]): float {
    return float(sum(max<0>(max<0>(abs(t)))))
}

func main(): int sync {
    seed(20261023)
    let a = next_key()->normal::<f32><shape: [1024, 1024]>
    let b = next_key()->normal::<f32><shape: [1024, 1024]>
    let library = fast(a, b)
    let canonical = exact(a, b)
    let difference = max_abs(library - canonical)
    let bound = 1024.0 * 1024.0 * 5.9604645e-8 * max_abs(a) * max_abs(b)
    'gemm_library sums={} {} diff={} bound={}'->format<
        sum(library), sum(canonical), difference, bound>->println
    return 0
}