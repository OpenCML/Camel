/**
 * Annotations that are not accepted: an unknown permission, an annotation other than
 * @numeric with names in parentheses, and an empty @numeric(). (A decorator on a block is
 * accepted since language reference 7.6: compile/decorators.)
 */
module invalid

@numeric(reassociate, fast)
func a(x: float): float { return x * 2.0 }

@kernelish(reassociate)
func b(x: float): float { return x * 2.0 }

@numeric()
func c(x: float): float { return x * 2.0 }

func main(): int sync {
    return 0
}
