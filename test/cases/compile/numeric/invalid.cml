/**
 * The removed `@name(args)` spelling of the numeric-permission annotation: any annotation with
 * names in parentheses is reported at the annotation, and the message names the tag form that
 * replaced it (design principles 7.2: numeric permissions are tags).
 */

@kernelish(reassociate)
func b(x: float): float { return x * 2.0 }

@numeric()
func c(x: float): float { return x * 2.0 }

func main(): int sync {
    return 0
}