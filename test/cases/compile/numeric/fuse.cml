/**
 * tensor::fuse records how each matmul runs (`tensor.kernel`) and which nodes form one group
 * (`tensor.fusion`); it never changes an operator (design principles 9.6).
 *
 * Default mode grants `reassociate` (7.3), so a plain matmul may use the library GEMM; `#strict`
 * withholds the defaults (7.4), so the matmul inside its block runs the canonical algorithm.
 * Both `matmul`+`add` patterns are still recorded as groups: identity is preserved, so the nodes
 * of one group need not agree on permissions. Safe mode (`tensor::fuse safe_fp=true`) makes
 * every matmul canonical.
 */
module fuse

import { reshape, sum } from tensor

func pair(x: f32[..], w: f32[..], b: f32[..]): (f32[..], f32[..]) {
    let loose = x @ w + b
    #strict {
        let tight = x @ w + b
        return (loose, tight)
    }
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 0.5, -1.5, 2.5] as f32[], [2, 3])
    let w = reshape([0.5, -1.0, 2.0, 1.0, -0.5, 0.25] as f32[], [3, 2])
    let b = reshape([0.1, -0.2] as f32[], [2])
    let (loose, tight) = pair(x, w, b)
    'fuse split={} tight={}'->format<sum(loose), sum(tight)>->println
    return 0
}