/**
 * `change_precision` governs a computation the compiler moves to a lower precision, and that is
 * still gated after the rule (design principles 7.2-7.3; the rule in : "编译器自行引入的低精度计算（例如把 f32
 * 的矩阵乘换成 bf16 计算）仍然要 change_precision"): the tiles scheduler takes the cuBLAS BF16 matrix product
 * for an f32 matmul only where the node carries `reassociate`, `change_precision` and
 * `finite_math` together (modules/tiles/src/schedule.cpp), and `#strict` revokes every
 * permission, that one included (7.4). The three functions below are the same f32 matrix product
 * written three ways, and the plan each one gets is printed: `granted` writes the three
 * permissions and gets `cublas_bf16`, `revoked` writes them and is marked `#strict`, so the
 * permission an other arm of the compiler reads is gone and it gets the canonical f32 kernel, and
 * `canonical` writes nothing. A conversion the program writes is a different thing and is not
 * gated at all: see test/cases/modules/tensor/dtype/bf16_cast_no_permission.cml.
 */
module compile_bf16_permission_gate

import { Tensor, ones } from tensor
import { inspect } from tiles

#[reassociate, change_precision, finite_math]
func granted(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a @ b }

#[strict, reassociate, change_precision, finite_math]
func revoked(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a @ b }

func canonical(a: Tensor<f32>, b: Tensor<f32>): Tensor<f32> { return a @ b }

func main(): int sync {
    let left = ones([8, 8]) * 1.00390625
    let right = ones([8, 8])
    let grantedPlan = inspect<granted>((left, right))
    let revokedPlan = inspect<revoked>((left, right))
    let canonicalPlan = inspect<canonical>((left, right))
    println('granted')
    println(grantedPlan)
    println('revoked')
    println(revokedPlan)
    println('canonical')
    println(canonicalPlan)
    return 0
}