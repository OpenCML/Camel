/**
 * A matmul's implementation choice is the node attribute `tensor.kernel`, never another
 * operator (design principles 9.6). Per 7.3 the CPU library GEMM is available by default, so in
 * default mode all three matmuls record "library" (the `#[reassociate, change_precision]` tag is
 * no longer needed: a library order is an accumulation change, which `reassociate` covers).
 * `tensor::fuse safe_fp=true` records "canonical" for every one of them (7.4), and in a build
 * without CAMEL_TENSOR_BLAS the library name resolves to the canonical kernel, so the three
 * results are the canonical ones either way.
 */
module library_gemm

import { Tensor, reshape, sum } from tensor
import { is_numeric } from types

func plain::<T>(x: T[..], w: T[..]): T[..] when is_numeric::<T>() {
    return x @ w
}

#[reassociate]
func reordered::<T>(x: T[..], w: T[..]): T[..] when is_numeric::<T>() {
    return x @ w
}

#[reassociate, change_precision]
func relaxed::<T>(x: T[..], w: T[..]): T[..] when is_numeric::<T>() {
    return x @ w
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 0.5, -1.5, 2.5], [2, 3])
    let w = reshape([0.5, -1.0, 2.0, 1.0, -0.5, 0.25], [3, 2])
    'gemm plain={} reordered={} relaxed={}'->format<sum(plain(x, w)), sum(reordered(x, w)), sum(relaxed(x, w))>->println
    return 0
}