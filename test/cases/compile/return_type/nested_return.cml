/**
 * A `return` whose operand holds a `return`, 20 deep. The operand of a `return` used to be
 * lowered twice (the first result was dropped), so each level doubled the work: this file took
 * 45 s to compile, and 2 s at depth 16. It compiles in milliseconds.
 */
module nested_return

func f(x: int): int {
    return if x > 19 then sync {
        return if x > 18 then sync {
            return if x > 17 then sync {
                return if x > 16 then sync {
                    return if x > 15 then sync {
                        return if x > 14 then sync {
                            return if x > 13 then sync {
                                return if x > 12 then sync {
                                    return if x > 11 then sync {
                                        return if x > 10 then sync {
                                            return if x > 9 then sync {
                                                return if x > 8 then sync {
                                                    return if x > 7 then sync {
                                                        return if x > 6 then sync {
                                                            return if x > 5 then sync {
                                                                return if x > 4 then sync {
                                                                    return if x > 3 then sync {
                                                                        return if x > 2 then sync {
                                                                            return if x > 1 then sync {
                                                                                return if x > 0 then sync {
                                                                                    return 0
                                                                                } else 0
                                                                            } else 1
                                                                        } else 2
                                                                    } else 3
                                                                } else 4
                                                            } else 5
                                                        } else 6
                                                    } else 7
                                                } else 8
                                            } else 9
                                        } else 10
                                    } else 11
                                } else 12
                            } else 13
                        } else 14
                    } else 15
                } else 16
            } else 17
        } else 18
    } else 19
}

func main(): int sync {
    println(f(3), f(100))
    return 0
}
