// What stays accepted: the declared type itself, an undeclared return type, and a function
// declared void whose body ends in a value. (A nullable of the type, `int?`, used to be listed
// here: it was compiled as `int`. `int?` is now a type of its own, and `return x` under it
// puts `x` into that form, see compile/tagged/nullable.cml. A return type of `any` used to be
// listed too; `any` is not a type a program can write any more, see
// compile/any_typing/written_return.cml.)
func a(x: int): int {
    return x
}
func c(x: int) {
    return x + 1
}
func d(x: int): void {
    return x + 1
}
func main(): int sync {
    println(a(2))
    println(c(2))
    d(2)
    return 0
}
