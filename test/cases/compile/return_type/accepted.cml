module return_accepted
// What stays accepted: the declared type itself, `any`, an undeclared return type, and a
// function declared void whose body ends in a value. (A nullable of the type, `int?`, used to
// be listed here: it was compiled as `int`. `int?` is now a type of its own, and `return x`
// under it puts `x` into that form, see compile/tagged/nullable.cml.)
func a(x: int): any {
    return x
}
func c(x: int) {
    return x + 1
}
func d(x: int): void {
    return x + 1
}
func main(): int sync {
    println(a(2))
    println(c(2))
    d(2)
    return 0
}
