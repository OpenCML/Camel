// An import never resolves to the importing module itself (design principles 10.2): this file is
// the entry module and imports its own name, in both forms, and no other location holds a module
// of that name.
module self_entry

import self_entry
import { twice } from self_entry

func twice(x: int): int { return x * 2 }

func main(): int sync {
    println(twice(4))
    return 0
}
