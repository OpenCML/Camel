// A module's import never resolves to itself (design principles 10.1): the lookup passes over the
// importing module's own file and goes on through the search order. This file is the entry module
// and imports its own file name in both forms; nothing else is named `self_entry`, so neither is found.

import self_entry
import { twice } from self_entry

func twice(x: int): int { return x * 2 }

func main(): int sync {
    println(twice(4), self_entry::twice(5))
    return 0
}
