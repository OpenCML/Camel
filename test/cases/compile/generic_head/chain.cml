/**
 * A generic function calls generic functions: the instance of each is fixed by the types the
 * chain gives it, so `chained` instantiates `first` and `pair` for its own type parameter
 * (design principles 5.5). Every declaration says `::<...>` at its head.
 */

func id::<T>(x: T): T {
    return x
}

func pair::<U>(x: U): (U, U) {
    return (id(x), x)
}

func first::<V>(p: (V, V)): V {
    return p.0
}

func chained::<W>(x: W): W {
    return first(pair(x))
}

func main(): int sync {
    println(chained(7))
    println(first(pair('s')))
    return 0
}