/**
 * Type parameters are declared at the head (design principles 5.5): a name written there is a
 * type variable of the signature, in an ordinary parameter, in a `with` parameter, in a
 * function type written inside either, and in the result type. A second occurrence refers to
 * the same variable.
 */

// `A` appears in both parameters and in the result.
func pair::<A>(x: A, y: A): (A, A) {
    return (x, y)
}

// The type of the `with` parameter uses `T` and `U`; the result type uses `U`.
with <f: (x: T) => U>
func turn::<T, U>(x: T): U {
    return f(x)
}

// A function type written in an ordinary parameter type uses the head names too.
func feed::<T, U>(f: (x: T) => U, x: T): U {
    return f(x)
}

func main(): int sync {
    let p = pair(1, 2)
    println(p.0)
    println(p.1)
    println(turn::<int, int><(x: int) => x + 1>(41))
    println(feed((x: int) => x * 3, 7))
    return 0
}