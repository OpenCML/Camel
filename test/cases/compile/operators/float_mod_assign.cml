/**
 * Rejected when compiled, at the operator: `%=` is for integers, as `%` is. A combination of operator and type without an
 * implementation used to compile and then do nothing, or fault, when run.
 */

func main(): int sync {
    var x = 1.5
    x %= 2.0
    println(x)
    println('never printed')
    return 0
}
