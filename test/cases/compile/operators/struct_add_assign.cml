/**
 * `a += b` on a type of the program follows its own `operator +` (design principles 4.2, 4.3):
 * `a = a + b`, whoever declared the type.
 */
module struct_add_assign

type P = { v: int }

func operator +(a: P, b: P): P {
    return { v: a.v + b.v }
}

func main(): int sync {
    var a: P = { v: 1 }
    let b: P = { v: 2 }
    a += b
    println(a.v)
    return 0
}