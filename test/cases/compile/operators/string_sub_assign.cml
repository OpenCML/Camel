/**
 * Rejected when compiled, at the operator: `-=` has no meaning on strings. A combination of operator and type without an
 * implementation used to compile and then do nothing, or fault, when run.
 */
module string_sub_assign

func main(): int sync {
    var s = 'a'
    s -= 'b'
    println(s)
    println('never printed')
    return 0
}
