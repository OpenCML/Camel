/**
 * Rejected when compiled, at the operator: `+=` is not defined for arrays. A combination of operator and type without an
 * implementation used to compile and then do nothing, or fault, when run.
 */
module array_add_assign

func main(): int sync {
    var xs = [1]
    xs += [2]
    println(xs)
    println('never printed')
    return 0
}
