/**
 * The imported predicate where it does not hold: the call site lists the condition the
 * candidate wrote, through the module prefix, and no candidate applies.
 */
module when_import_qualified_false

import predicates

func describe::<T>(x: T): string when predicates::is_compound::<T>() {
    return 'compound'
}

func main(): int sync {
    println(describe(3))
    return 0
}