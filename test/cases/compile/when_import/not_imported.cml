/**
 * The entry imports both the module that declares the predicate and the module whose `when`
 * uses it without importing it. The condition of `when_import_unimported_user` resolves in that
 * module, which does not see `predicates`, so the call is reported as not imported.
 */

import predicates
import unimported_user

func main(): int sync {
    println(unimported_user::describe((1, 2)))
    return 0
}