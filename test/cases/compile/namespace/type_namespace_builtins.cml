/**
 * Checks built-in type-qualified constructor aliases for Tensor and Parameter.
 */
module type_namespace_builtins

import {
    Tensor
} from tensor

import {
    Parameter
} from nn

func main(): int sync {
    let a = Tensor::ones([2, 2])
    let b = Tensor::new([[1.0, 2.0], [3.0, 4.0]])
    let p = Parameter::new(Tensor::zeros([2, 2]))
    let v = Parameter::value(p)

    let a0 = Tensor::shape(a)[0]
    let b1 = Tensor::shape(b)[1]
    let v0 = Tensor::shape(v)[0]
    'type_namespace_builtins shape={} {} {}'->format<a0, b1, v0>->println

    if a0 != 2 then {
        return 1
    } else if b1 != 2 then {
        return 2
    } else if v0 != 2 then {
        return 3
    } else {
        return 0
    }
}
