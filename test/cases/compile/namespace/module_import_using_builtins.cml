/**
 * Checks using namespace over built-in module imports restores direct exported symbols.
 */
module module_import_using_builtins

import tensor
using namespace tensor

func main(): int sync {
    let a = Tensor::ones([2, 2])
    let b = ones([2, 2])
    let a0 = shape(a)[0]
    let b1 = Tensor::shape(b)[1]
    'module_import_using_builtins shape={} {}'->format<a0, b1>->println
    return 0
}
