/**
 * Checks bare built-in module imports expose symbols through module:: references.
 */

import tensor
import nn

func main(): int sync {
    let a = tensor::ones::<f32>([2, 2])
    let b = tensor::new([[1.0, 2.0], [3.0, 4.0]])
    let v = nn::sgd(tensor::zeros::<f32>([2, 2]), tensor::ones::<f32>([2, 2]), 0.5)

    let a0 = tensor::shape(a)[0]
    let b1 = tensor::shape(b)[1]
    let v0 = tensor::shape(v)[0]
    'module_import_builtins shape={} {} {}'->format<a0, b1, v0>->println

    if a0 != 2 then {
        return 1
    } else if b1 != 2 then {
        return 2
    } else if v0 != 2 then {
        return 3
    } else {
        return 0
    }
}
