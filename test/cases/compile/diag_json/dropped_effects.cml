/**
 * Which effects run is design principles 3.1: a write to a resource outside the program is used by
 * the region it is written in, so a bare `println` here runs (the ruling of 2026-11-15); a call
 * stands on a read of its value or a place in a sync chain, so the ones nothing depends on do not
 * run and each gets SemanticDiag::EffectNotExecuted, and line 35 is UnusedAssignedValue. Line 37
 * runs with its body (the ruling of 2026-11-16); `branch_value_dropped` still reports that branch.
 * Output: `operator`, `noisy`, `4`, `arm`, `kept 1`, `0 5`.
 */

func noisy(x: int): int sync {
    println('noisy')
    return x
}

func modify(var x: int): int sync {
    x += 1
    return 0
}

func declared(x: int): int {
    return x
}

func quiet(x: int): int {
    return x + 1
}

func dropped(): int {
    var i = 5
    var j = 5
    println('operator')              // RUNS line 31: a write of stdout, and this region runs
    noisy(1)                         // WARNED line 32: a call the program never needs
    let unused = noisy(2)            // WARNED line 33: bound to a name nothing reads
    modify(i)                        // WARNED line 34: a write nothing reads afterwards
    j = 7                            // WARNED line 35: an assignment nothing reads afterwards
    println(noisy(4))                // RUNS line 36: the write runs, and reads its argument
    if quiet(0) > 0 then sync {      // RUNS line 37: a branch statement, and the arm it takes
        println('arm')
    } else sync {
        println('other arm')
    }
    quiet(1)                         // pure: no warning
    let also_unused = quiet(2) + 1   // pure: no warning
    return 0
}

func kept(): int sync {
    var i = 5
    println('kept {}'->format<noisy_free(1)>)
    modify(i)
    declared(3)
    return i
}

func noisy_free(x: int): int {
    return x
}

func main(): int sync {
    let a = dropped()
    let b = kept()
    println('{} {}'->format<a, b - 1>)
    return 0
}
