/**
 * Outside a sync block an effectful expression whose result nothing uses does not run
 * (docs/design-principles.cn.md 3.1). That is legal; the compiler warns about each one
 * (SemanticDiag::EffectNotExecuted) and the program runs as written. Lines marked DROPPED get
 * the warning; nothing in a sync block does, nor does a pure expression.
 * Output: `kept 1` and `0 5`.
 */
module dropped_effects

func noisy(x: int): int sync {
    println('noisy')
    return x
}

sync func modify(var x: int): int sync {
    wait x += 1
    return 0
}

sync func declared(x: int): int {
    return x
}

func quiet(x: int): int {
    return x + 1
}

func dropped(): int {
    var i = 5
    var j = 5
    println('operator')              // DROPPED line 31: an impure operator
    noisy(1)                         // DROPPED line 32: a function whose sync body prints
    let unused = noisy(2)            // DROPPED line 33: bound to a name nothing reads
    wait modify(i)                   // DROPPED line 34: a write nothing reads afterwards
    wait j = 7                       // DROPPED line 35: an assignment nothing reads afterwards
    declared(3)                      // DROPPED line 36: a function declared `sync func`
    println(noisy(4))                // DROPPED line 37: one warning, for the outer call
    if quiet(0) > 0 then sync {      // DROPPED line 38: a branch with an effectful arm
        println('arm')
    } else sync {
        println('other arm')
    }
    quiet(1)                         // pure: no warning
    let also_unused = quiet(2) + 1   // pure: no warning
    return 0
}

func kept(): int sync {
    var i = 5
    println('kept {}'->format<noisy_free(1)>)
    wait modify(i)
    declared(3)
    return i
}

func noisy_free(x: int): int {
    return x
}

func main(): int sync {
    let a = dropped()
    let b = kept()
    println('{} {}'->format<a, b - 1>)
    return 0
}
