/**
 * Which effects run is design principles 3.1, and a call is one of the nodes the author's ruling of
 * 2026-11-17 names ("算子、调用、分支、循环一样"): a call to a callee that writes a resource outside
 * the program is one of its region's writes, and the region's `GATE` reads it -- so `noisy(1)` and
 * `noisy(2)` run, and so does the bare `println` (the ruling of 2026-11-15). A call whose callee
 * writes only a `var` cell writes no resource outside the program (design principles 3.3), so
 * `modify(i)` at line 34 is still reported; line 35 is UnusedAssignedValue; line 37 runs with its
 * body (the ruling of 2026-11-16), and `branch_value_dropped` still reports that branch.
 * Output: `operator`, `noisy` three times (lines 32, 33 and 36), `4`, `arm`, `kept 1`, `0 5`.
 */

func noisy(x: int) => int sync {
    println('noisy')
    return x
}

func modify(var x: int) => int sync {
    x += 1
    return 0
}

func declared(x: int) => int {
    return x
}

func quiet(x: int) => int {
    return x + 1
}

func dropped() => int {
    var i = 5
    var j = 5
    println('operator') // RUNS line 33: a write of stdout, and this region runs
    noisy(1) // RUNS line 34: a call whose callee writes stdout
    let unused = noisy(2) // RUNS line 35: the same call, bound to a name nothing reads
    modify(i) // WARNED line 36: writes a `var` cell, which is not outside
    j = 7 // WARNED line 37: an assignment nothing reads afterwards
    println(noisy(4)) // RUNS line 38: the write runs, and reads its argument
    if quiet(0) > 0 then sync {
        // RUNS line 39: a branch statement, and the arm it takes
        println('arm')
    } else sync {
        println('other arm')
    }
    quiet(1) // pure: no warning
    let also_unused = quiet(2) + 1 // pure: no warning
    return 0
}

func kept() => int sync {
    var i = 5
    println('kept {}'->format<noisy_free(1)>)
    modify(i)
    declared(3)
    return i
}

func noisy_free(x: int) => int {
    return x
}

func main() => int sync {
    let a = dropped()
    let b = kept()
    println('{} {}'->format<a, b - 1>)
    return 0
}
