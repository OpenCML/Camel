/**
 * Which effects run is decided by design principles 3.1: a write to a resource outside the program
 * is used by the region it is written in, so a bare `println` here runs (the author's ruling of
 * 2026-11-15, "区域的根"); a call, an assignment and a branch stand on a read of their value or a
 * place in a sync chain, so the ones nothing depends on do not run and each gets the warning
 * SemanticDiag::EffectNotExecuted. Nothing in a sync block does, nor does a pure expression.
 * Output: `operator`, `noisy`, `4`, `kept 1`, `0 5`.
 */

func noisy(x: int): int sync {
    println('noisy')
    return x
}

func modify(var x: int): int sync {
    x += 1
    return 0
}

func declared(x: int): int {
    return x
}

func quiet(x: int): int {
    return x + 1
}

func dropped(): int {
    var i = 5
    var j = 5
    println('operator')              // RUNS line 31: a write of stdout, and this region runs
    noisy(1)                         // WARNED line 32: a call the program never needs
    let unused = noisy(2)            // WARNED line 33: bound to a name nothing reads
    modify(i)                        // WARNED line 34: a write nothing reads afterwards
    j = 7                            // WARNED line 35: an assignment nothing reads afterwards
    println(noisy(4))                // RUNS line 36: the write runs, and reads its argument
    if quiet(0) > 0 then sync {      // WARNED line 37: a branch the program never needs
        println('arm')
    } else sync {
        println('other arm')
    }
    quiet(1)                         // pure: no warning
    let also_unused = quiet(2) + 1   // pure: no warning
    return 0
}

func kept(): int sync {
    var i = 5
    println('kept {}'->format<noisy_free(1)>)
    modify(i)
    declared(3)
    return i
}

func noisy_free(x: int): int {
    return x
}

func main(): int sync {
    let a = dropped()
    let b = kept()
    println('{} {}'->format<a, b - 1>)
    return 0
}
