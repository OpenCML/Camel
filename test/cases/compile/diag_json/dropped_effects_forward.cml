/**
 * The order two functions are written in does not decide whether their writes run: `later` and
 * `earlier_dropped` are written after `caller`, and both of them print, because a call written as a
 * statement is one of its body's writes when its callee writes (design principles 3.1, the author's
 * ruling of 2026-11-17: "算子、调用、分支、循环一样") and the body's `GATE` reads it.
 *
 * It used to be the `EffectNotExecuted` half of the same rule -- "a dropped call is reported whether
 * its callee is written before or after the caller" -- and what the case pins now is that the order
 * of definitions does not decide which writes run: `later`, `earlier_dropped`, then the value
 * `caller` hands on.
 */

func caller(x: int): int {
    later(x)
    earlier_dropped(x)
    return x + 1
}

func later(x: int): int sync {
    println('later')
    return x
}

func earlier_dropped(x: int): int sync {
    println('earlier_dropped')
    return x
}

func main(): int sync {
    println(caller(1))
    return 0
}
