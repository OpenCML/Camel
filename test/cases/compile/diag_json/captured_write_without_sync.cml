/**
 * The prefix `sync` of a function declares that it has side effects. A function that writes a
 * variable it captured (a module-level one included), itself or through a function it calls
 * directly, is expected to carry it; without it the compiler warns
 * (SemanticDiag::CapturedWriteInAsyncFunction). The modifier is a declaration only: the
 * program runs the same with and without it. Expected warnings, by line:
 *   18  bump     writes `total`
 *   32  via      calls bump
 *   44  lambda   writes the local `seen` of main
 *   42  main     calls via, declared_via and bump
 * No warning: declared (sync func), declared_via (sync func), peek (only reads).
 * Output: 3 1
 */
module captured_write_without_sync

var total = 0

func bump(): int sync {
    wait total += 1
    return 0
}

sync func declared(): int sync {
    wait total += 1
    return 0
}

func peek(): int {
    return total
}

func via(): int sync {
    bump()
    return 0
}

sync func declared_via(): int sync {
    declared()
    return 0
}

func main(): int sync {
    var seen = 0
    let note = (): int => sync {
        wait seen += 1
        return 0
    }
    via()
    declared_via()
    bump()
    note()
    println('{} {}'->format<peek(), seen>)
    return 0
}
