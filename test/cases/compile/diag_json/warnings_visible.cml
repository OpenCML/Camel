/**
 * A program that compiles without an error and has two warnings. They are printed on
 * stderr before the program runs; stdout carries only what the program prints (11).
 *   line 17: IgnoredSideEffect         a call with a var argument, outside a sync block
 *   line 18: IgnoredSideEffect         a branch whose arm writes the captured `c`
 */

// Line numbers below are asserted by the plan.
func inc(var x: int): int sync {
    x += 1
    return 0
}

func main(): int {
    var c = 0
    inc(c)
    let r = if c > 0 then sync {
        c += 10
        return 0
    } else 0
    return println(c + r)
}