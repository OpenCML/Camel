/**
 * A program that used to have one warning and now has none: a branch arm writes the captured
 * `c`, and a write to a `var` is a value the branch hands on, not an effect (design principles
 * 3.1, 3.5; the ruling of 2026-11-16). stdout carries only what the program prints (11), and
 * the value the arm wrote still reaches it: the plan asserts both, and that stderr is empty.
 */

// Line numbers below are asserted by the plan.
func inc(var x: int) => int sync {
    x += 1
    return 0
}

func main() => int {
    var c = 0
    inc(c)
    let r = if c > 0 then sync {
        c += 10
        return 0
    } else 0
    return println(c + r)
}
