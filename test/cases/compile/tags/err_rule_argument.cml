/// The shape `docs/design/program-transforms/README.cn.md` section 3 writes: a tag whose argument is
/// a `rule`. A rule is a declaration, and whether a tag parameter may carry one is open
/// (`questions-2026-10-29-transforms.md` question 1), so it is refused -- and the refusal says the
/// argument is a declaration of the program that is no function, not that the name is unknown.

tag jvp::<F>(rule: F) on func when is_function::<F>()

rule mul_rule(x: float, w: float) {
    x * w => (dx: float, dw: float) => dx * w + x * dw
}

#jvp(mul_rule)
func mul(x: float, w: float): float { return x * w }

func main(): int sync { return 0 }