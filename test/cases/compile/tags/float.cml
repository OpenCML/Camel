/**
 * A real-valued tag argument: the parameter is declared `float`, the value is written as a real
 * and carried as a real attribute (`camel inspect --tags` prints it as written).
 */

export tag ratio(r: float) on type, field

#ratio(1.5)
type T = { x: int }

#ratio(0.25)
type U = { y: int }

func main(): int { return 0 }