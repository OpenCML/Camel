/// A user function declares that its elements are independent (design principles 3.6): the
/// standard tag `#independent` on the declaration. The fact reaches the runtime graph (the
/// function's exit node) and the runtime query `tag::declaresIndependentElements`; a function
/// without the tag does not carry it.

#independent
func twice(x: int): int {
    return x * 2
}

func plain(x: int): int {
    return x + 1
}

func main(): int {
    return twice(3) + plain(4)
}