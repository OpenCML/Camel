/// An imported tag beside a function of the same name declared here. The tag is imported from the
/// module that exports it and reached through `#`, exactly as the function is reached by its name;
/// neither takes the other's space (design principles 6.2, the author's ruling of 2026-10-30).

import { jvp } from prelude

func jvp(x: int): int { return x + 1 }

func jvp_rule(x: int, dx: int): int { return dx }

#jvp(jvp_rule)
func tagged(x: int): int { return x }

func main(): int sync {
    println(tagged(1), jvp(1))
    return 0
}