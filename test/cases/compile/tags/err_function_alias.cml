/// `function` is not a name of a tag parameter's kind: the one name is `func` (design principles
/// 6.2), so a parameter declared `function` is a kind a tag cannot carry and is reported where the
/// tag is written.
module tags_err_function_alias

tag callback<f: function> on field

func twice(x: int): int { return x + x }

type Box = {
    #callback<twice> scaled: int,
}

func main(): int { return 0 }