/// A tag and a function of one name in one module: each keeps its own name (design principles 6.2,
/// the author's ruling of 2026-10-30). `#label(7)` reads the tag, `label(1)` calls the function.

tag label(x: int) on func

func label(x: int): int { return x + 1 }

#label(7)
func tagged(x: int): int { return x }

func main(): int sync {
    println(tagged(1), label(1))
    return 0
}