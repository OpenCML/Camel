/// A parameter declared as a concrete function type (design principles 6.2): the signature is
/// fixed by the declaration, and the tag is pasted with a function that has it.

tag rule(f: (x: int) => int) on field

func twice(x: int): int { return x + x }

type Box = {
    #rule(twice) scaled: int,
    plain: int,
}

func main(): int sync {
    println({scaled: 3, plain: 5}.plain)
    return 0
}