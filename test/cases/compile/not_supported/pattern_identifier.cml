/**
 * An identifier pattern binds the value taken out of a `T?` / `T!`, and over any other type
 * there is no mark to take apart (design principles 3.8): a compile-time error at the case
 * itself, not an internal error. The value is read with a literal pattern or `_`.
 */
module pattern_identifier

func f(n: int): int {
    return match n {
        case other => 1
        case _ => 0
    }
}

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}
