/**
 * An identifier pattern binds the value taken out of a `T?` / `T!`; over any other type it is
 * not decided: a compile-time error at the case (line 9), not an internal error.
 */
module pattern_identifier

func f(n: int): int {
    return match n {
        case other => 1
        case _ => 0
    }
}

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}
