/**
 * An identifier pattern is in the grammar but binding in a `case` is not implemented: a
 * compile-time error at the pattern (line 9), not an internal error without a position.
 */
module pattern_identifier

func f(n: int): int {
    return match n {
        case other => 1
        case _ => 0
    }
}

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}
