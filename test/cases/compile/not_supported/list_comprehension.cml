/**
 * A list comprehension is `filter` then `map` (design principles 4.2). It used to be refused
 * as not implemented, and before that compiled as the empty array.
 */

func main(): int sync {
    let xs = [1, 2, 3]
    let ys = [x * 2 for x in xs if x > 1]
    println('reached')
    println(ys)
    return 0
}
