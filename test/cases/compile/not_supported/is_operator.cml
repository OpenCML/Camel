/**
 * `is` is in the grammar but there is no run-time type test: a compile-time error at the
 * operator (line 9, column 15). It used to be a warning, and `a is string` was compiled as `a`.
 */
module is_operator

func main(): int sync {
    let a = 1
    let b = a is string
    println('never printed')
    println(b)
    return 0
}
