/**
 * `wait` where the mark used to be dropped without a word: before a block, a name, a literal,
 * a unary operator and a lambda. Each is reported (one per function here, since an error ends
 * the lowering of its function); `wait` before a call, an assignment and an operator
 * expression is implemented and is not.
 */
module wait_ignored

sync func bump(var i: int): int sync {
    i = i + 1
    return i
}

func implemented(): int sync {
    var i = 0
    wait bump(i)
    wait i = i + 1
    wait i + bump(i)
    return i
}

func before_block(): int sync {
    var i = 0
    wait { bump(i) }
    return i
}

func before_name(): int sync {
    var i = 0
    wait i
    return i
}

func before_literal(): int sync {
    wait 1
    return 0
}

func before_unary(): int sync {
    var i = 0
    wait -bump(i)
    return i
}

func before_lambda(): int sync {
    wait (x: int) => x
    return 0
}

func main(): int sync {
    println('never printed')
    return 0
}
