/**
 * `T?` is in the grammar but nullable types are not implemented: a compile-time error at the
 * type (line 7, column 11). It used to be compiled as `T`, silently.
 */
module nullable_type

func f(x: int?): int { return 1 }

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}
