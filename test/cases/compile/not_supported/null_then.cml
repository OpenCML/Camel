/**
 * `??` is in the grammar but nullable values are not implemented: a compile-time error at the
 * operator (line 9, column 15). It used to be a warning, and `a ?? 7` was compiled as `a`.
 */
module null_then

func main(): int sync {
    let a = 1
    let b = a ?? 7
    println('never printed')
    println(b)
    return 0
}
