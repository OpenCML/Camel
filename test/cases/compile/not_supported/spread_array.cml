/**
 * `...xs` in an array literal is in the grammar but spreading is not implemented: a
 * compile-time error at the marker (line 10, column 15). The marker used to be dropped and the
 * program printed an address.
 */
module spread_array

func main(): int sync {
    let xs = [1, 2, 3]
    let ys = [...xs, 4]
    println('never printed')
    println(ys)
    return 0
}
