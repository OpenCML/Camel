/**
 * `?->` is in the grammar but not implemented: a compile-time error at the operator (line 11,
 * column 14). It used to be a warning, and `a?->inc` was compiled as `a->inc`.
 */
module optional_link

func inc(x: int): int { return x + 1 }

func main(): int sync {
    let a = 1
    let b = a?->inc
    println('never printed')
    println(b)
    return 0
}
