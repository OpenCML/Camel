/**
 * A module may declare only its own operators: `#op<'bytes:size'>` names an operator of `bytes`,
 * and the declaration is refused where it is written (design principles 10.1). The exceptional
 * binding gives a name to an operator of this module, it does not make one module the author of
 * another's signature.
 */
module bytes_tag

import bytes

#op<'bytes:size'>
export func size(content: Bytes): int