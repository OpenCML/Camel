/**
 * A module may declare only its own operators: `#op('bytes:to_array')` names an operator of `bytes`,
 * and the declaration is refused where it is written (design principles 10.1,
 * rule 5). The exceptional binding gives a name to an operator of this module, it does not
 * make one module the author of another's signature.
 */
module bytes_tag

import bytes

#op('bytes:to_array')
export func to_array(content: Bytes): int[]