/**
 * The result type of `tiles:available` is the declaration's `bool`, not a type the C++ resolver
 * decides per call: binding it to an `int` is refused with the value's type taken from the
 * declaration (handover H19, step 10; H156). With no ordinary parameter this is the type case a
 * zero-argument declaration can have.
 */
module tiles_result_type

import { available } from tiles

func main(): int sync {
    let count: int = available()
    println(count)
    return 0
}