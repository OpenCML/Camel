/**
 * A direct call of an `#impl` function is one call of its kernel operator: `add` is the
 * semantics, `add_kernel` (a body-less declaration of this module, not exported) is the
 * operator that runs it. The ordinary pipeline shows one OPER of `:op/add_l` and none of the
 * body's nodes (`:op/sub_l`, `:op/neg_l`), which are in the semantic body graph.
 */

#op(':op/add_l')
func add_kernel(a: int, b: int): int

#impl(add_kernel)
export func add(a: int, b: int): int {
    return a - (0 - b)
}

func main(): int sync {
    let sum = add(19, 23)
    'impl_ordinary add={}'->format<sum>->println
    return 0
}