/**
 * `#impl(at)` names a body-less declaration of another module (generic_module): a kernel is the
 * implementation detail of the function that keeps it, so the tag is refused
 * (ImplKernelForeign) rather than reaching into that module's operator.
 */

import { at } from generic_module

#impl(at)
func first(xs: int[], i: int): int {
    return xs[i]
}

func main(): int sync {
    return first([1, 2, 3], 0)
}