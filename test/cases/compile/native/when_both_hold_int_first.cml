/**
 * The twin of `when_both_hold_i32_first.cml`: the same program with the two declarations of
 * `dual_kernel` written in the other order. Both conditions hold for the call
 * `dual_kernel(x, y)` (`T` is `i32`, `U` is `int`), so the call is ambiguous and which
 * declaration is written first cannot decide it (the language author's ruling of 2026-10-23 on
 * `two-when-conditions-hold`, `docs/handover/reviews/questions-2026-10-23.md`). This file must
 * therefore report exactly the diagnostic its twin reports.
 */
module when_both_hold_int_first

/// Holds for `int` alone: the second arm's own element type.
func is_second_int::<U>(): bool {
    return match type U {
        case int => true
        case _ => false
    }
}

/// Holds for `i32` alone: the first arm's own element type.
func is_first_i32::<T>(): bool {
    return match type T {
        case i32 => true
        case _ => false
    }
}

#op<':op/add_l'>
func dual_kernel::<T, U>(a: T, b: U): T when is_second_int::<U>()

#op<':op/sub_i'>
func dual_kernel::<T, U>(a: T, b: U): T when is_first_i32::<T>()

func main(): int sync {
    let x: i32 = 19
    let y: int = 23
    // The same call as the twin's: both conditions hold, whichever declaration comes first.
    'r={}'->format<dual_kernel(x, y)>->println
    return 0
}