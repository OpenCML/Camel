/**
 * The declarations of `tensor` are what an importer sees: the extents, the element count, the
 * extent of one axis, the binary form and the module's state are read from `stdlib/tensor.cml`,
 * and the calls reach the operators the C++ module runs. A computed signature (`reshape`, whose
 * shape follows its argument; `from_bytes` and `load_npy`, whose element type is a type argument
 * or the result's position) stays in C++ and is imported the same way.
 */
module tensor_declaration_import

import {
    Tensor,
    new,
    reshape,
    shape,
    numel,
    dim,
    to_bytes,
    from_bytes,
    load_npy,
    save_npy,
    seed,
    set_num_threads,
    num_threads
} from tensor

// The file operators still type-check (this function is not called): `load_npy` writes the
// element type the file holds, and the file's own element type is checked against it when the
// call runs.
func round_trip(t: Tensor, path: string): Tensor sync {
    save_npy(t, path)
    return load_npy::<f32>(path)
}

func main(): int sync {
    let t = new([[1.0, 2.0], [3.0, 4.0]] as f32[][])
    let extents = shape(t)
    println(extents[0] * 10 + extents[1])
    println(numel(t))
    println(dim(t, 1))
    println(dim(t, i32(0)))
    println(shape(reshape(t, [4]))[0])
    let encoded = to_bytes(new([1.0] as f32[]))
    println(shape(from_bytes::<f32>(encoded, [1]))[0])
    set_num_threads(2)
    println(num_threads())
    seed(42)
    println(Tensor::numel(t))
    return 0
}