/**
 * The wrong-kernel observation for the fusion case: `chain` still says `1/(1+exp(-x))`, but the
 * tag names `tensor:tanh`, so the direct call is one OPER of `tensor:tanh` while the call through
 * the function value is the body. With `rules::fusion` in front of the scheduler the body is
 * rewritten into `tensor:sigmoid` — the rule fires on the body a function value exposes — and the
 * kernel path stays the one operator the rule's left side does not spell.
 *
 * The two paths must disagree (a tanh is not a sigmoid: tanh(1.0)+tanh(-0.5) = 0.299477 against
 * 1.108599), which is what the agreement case's `diff=0` is measured against.
 *
 * This module writes `module tensor` (as `declaration_per_result_type.cml` does) so that it may
 * declare the kernel its function is tagged with.
 */
module tensor

import { Tensor } from tensor


#op<'tensor:tanh'>
func tanh_kernel(x: Tensor): Tensor

#impl<tanh_kernel>
func chain(x: Tensor): Tensor {
    return 1.0 / (1.0 + exp(-x))
}

func main(): int sync {
    let x = reshape([1.0, -0.5] as f32[], [2])
    let by_body = chain

    let k = chain(x)
    let b = by_body(x)
    'fusion kernel_sum={} body_sum={} diff={}'->format<sum(k), sum(b), sum(k - b)>->println
    return 0
}