/**
 * The declarations of `fs` are what an importer sees: `try_read_text` returns `string!`, the
 * reads give `Bytes`, the removals `void!`, and the arguments are the declaration's (a path, then
 * the content). Every call reaches the operator the C++ module runs; `stdlib/fs.cml` is the one
 * source of the signatures.
 */
module fs_declaration_import

import {
    exists,
    is_file,
    is_dir,
    mkdirs,
    write_text,
    write_bytes,
    replace,
    try_read_text,
    file_size,
    read_chunk,
    read_bytes,
    remove,
    remove_dir,
} from fs
import { decode, encode } from bytes
import { get_env } from env

/// The kind of a `void!`, or ok.
func verdict(r: void!): string {
    return match r {
        case error e => e.kind
        case _ => 'ok'
    }
}

func main(): int sync {
    let root = get_env('CAMEL_TEST_TMPDIR') ?? ''
    let dir = if root == '' then 'test/tmp/fs_declaration' else root + '/fs_declaration'
    let path = dir + '/notes.txt'
    let binary = dir + '/notes.bin'
    let content = 'hello from the declaration'
    println(mkdirs(dir))
    println(exists(path))
    write_text(path, content)
    write_bytes(binary, encode(content))
    replace(binary, encode(content))
    println(is_file(path))
    println(is_dir(dir))
    println(file_size(path))
    println(try_read_text(path) !! 'bad')
    println(decode(read_chunk(path, 0, 5)) !! '')
    println(decode(read_bytes(path)) !! '')
    println(verdict(remove(path)))
    println(verdict(remove(path)))
    println(verdict(remove(binary)))
    println(verdict(remove_dir(dir)))
    println(exists(dir))
    return 0
}