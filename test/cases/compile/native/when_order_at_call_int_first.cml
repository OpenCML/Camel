/**
 * The twin of `when_order_at_call_i32_first.cml`: the same program, with the two declarations of
 * `arms_kernel` written in the other order. The order of two same-named declarations whose `when`
 * conditions exclude each other says nothing about which one a call means (design principles 4.4;
 *  the rule on `impl-declaration-arms`,
 * `docs/handover/reviews/questions-2026-10-23.md`), so this file must print exactly what its twin
 * prints: the `i32` call is the subtraction and the `int` call is the addition.
 */
module when_order_at_call_int_first

/// The element type of the `int` arm: `int` alone.
func is_arm_int::<T>(): bool {
    return match type T {
        case int => true
        case _ => false
    }
}

/// The element type of the `i32` arm: `i32` alone.
func is_arm_i32::<T>(): bool {
    return match type T {
        case i32 => true
        case _ => false
    }
}

#op<':op/add_l'>
func arms_kernel::<T>(a: T, b: T): T when is_arm_int::<T>()

#op<':op/sub_i'>
func arms_kernel::<T>(a: T, b: T): T when is_arm_i32::<T>()

func main(): int sync {
    let x: i32 = 19
    let y: i32 = 23
    // `i32`: only the subtraction's condition holds, whichever declaration is written first.
    'i32={}'->format<arms_kernel(x, y)>->println
    // `int`: only the addition's condition holds, whichever declaration is written first.
    'int={}'->format<arms_kernel(19, 23)>->println
    return 0
}