/**
 * The declarations of `process` are what an importer sees: `sleep` takes the declared `float`
 * (seconds) and answers nothing, `user_name` answers the declared `string!`, and `cpu_count` the
 * declared `int`. Every call reaches the C++ operator.
 */
module process_declaration_import

import { sleep, user_name, cpu_count } from process

func main(): int sync {
    let user: string = user_name() !! ''
    let cores: int = cpu_count()
    sleep(0.001)
    println(user != '')
    println(cores > 0)
    return 0
}