/**
 * Two declarations of one kernel name whose `when` conditions are not mutually exclusive, refused
 * where the second one is written (design principles 4.3, 4.4, 5.1): "对已登记的类型逐个求两条 `when`，有类型同时
 * 满足两条即报重叠（诊断指出那个类型与两条声明）". `is_small_int` covers `i32`; `is_number` covers `int`, `i32`, `float`
 * and `f32`. The pair is therefore separable for `int` (only the second condition holds there) but
 * not for `i32`, and no order of the declarations could decide a call with `i32` arguments. The
 * report names the type both conditions hold for and both declarations, each by its signature and
 * its condition: the type it names is the one that satisfies both, not the first type the compiler
 * asks about.
 */
module when_arms_overlap

func is_small_int::<T>(): bool {
    return match type T {
        case i32 => true
        case _ => false
    }
}

func is_number::<T>(): bool {
    return match type T {
        case int | i32 | float | f32 => true
        case _ => false
    }
}

#op<':op/add_i'>
func arms_kernel::<T>(a: T, b: T): T when is_small_int::<T>()

#op<':op/sub_i'>
func arms_kernel::<T>(a: T, b: T): T when is_number::<T>()

#impl<arms_kernel>
func combine::<T>(a: T, b: T): T {
    return a * b
}

func main(): int sync {
    let x: i32 = 19
    let y: i32 = 23
    println(combine(x, y))
    return 0
}