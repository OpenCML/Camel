/**
 * `graph:constant` is declared with one argument, the node, and the type of the answer as a type
 * argument: a second argument is refused at the call, and the candidate the message lists is the
 * declaration's.
 */
module graph_constant_arity

import { nodes, constant, graph_of } from graph

func main(): int sync {
    let ns = nodes(graph_of(main))
    println(constant::<int>(ns[0], 1))
    return 0
}
