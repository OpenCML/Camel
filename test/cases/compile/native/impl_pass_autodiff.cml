/**
 * The autodiff macro meets a tagged function and meets the kernel, not the body: `std::macro`
 * expands `grad` over the call's graph, where the direct call of `curve` is one OPER of
 * `:op/div_d`, so the kernel's own registered derivative rule runs (1/b = 0.5 at (4.0, 2.0)). The
 * same Camel body reached through the function value is `a * b`, whose gradient is 2.0.
 *
 * The two gradients differ by 1.5 and the two bodies are different functions, so the number the
 * reverse pass produced identifies the path it read. Design principles 10.4 says differentiation
 * expands the body on demand; today it does not — `modules/autodiff/pullback.cpp:3486` looks the
 * operator's URI up in the derivative registry — and this case is the observable form of that.
 */
module impl_pass_autodiff

import { grad } from autodiff

#op<':op/div_d'>
with <a: float, b: float>
func div_kernel(): float

#impl<div_kernel>
with <a: float, b: float>
func curve(): float {
    return a * b
}

with <a: float, b: float>
func via_body(): float {
    return a * b
}

func main(): int sync {
    let d_kernel = grad(curve)<4.0, 2.0>()
    let d_body = grad(via_body)<4.0, 2.0>()
    'grad kernel={} body={} diff={}'->format<d_kernel, d_body, d_kernel - d_body>->println
    return 0
}