/**
 * The declarations of `graph:constant` are per sample type: an importer reads a node with an
 * `i32`, an `int`, an `f32`, a `float`, a `bool` and a `string` sample, and each call reaches the
 * C++ operator of the same URI (bucket 1). The sample's value is not read, so
 * the first node of the root graph is a node of no constant type and every answer is null.
 */
module graph_constant_import

import { nodes, constant, graph_of } from graph

func main(): int sync {
    let ns = nodes(graph_of(main))
    println(constant::<i32>(ns[0]) == null)
    println(constant::<int>(ns[0]) == null)
    println(constant::<f32>(ns[0]) == null)
    println(constant::<float>(ns[0]) == null)
    println(constant::<bool>(ns[0]) == null)
    println(constant::<string>(ns[0]) == null)
    return 0
}
