/**
 * The empty literal states no element type, so the type variable of the parameter it stands at
 * cannot be inferred from it: `show([])` is refused at the call as the type argument of `show`
 * that nobody can infer, and the message says which argument left it open (design principles 5.1,
 * 5.2). The C++ `TensorLike` resolver accepted it and left the kernel to fault; the refusal is
 * now at the inference, where `T := Void` is not a type a call can be made at, and the kernel
 * never meets such a value (docs/stdlib-conventions.cn.md 第 8 节).
 */
module tensor_show_empty_array

import { show } from tensor

func main(): int sync {
    show([])
    return 0
}