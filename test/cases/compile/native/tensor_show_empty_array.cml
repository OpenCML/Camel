/**
 * The boundary of the umbrella parameter: `show([])` holds an empty array, whose element type is
 * `void` and binds no type variable, so no candidate of the declaration applies and the call is
 * refused when the program is compiled.
 *
 * The C++ `TensorLike` resolver accepted it and the kernel then faulted ("Unsupported Tensor
 * dtype."); the declaration refuses it earlier and names the candidate it could not match, which is
 * the answer this case pins (docs/stdlib-conventions.cn.md 第 8 节).
 */
module tensor_show_empty_array

import { show } from tensor

func main(): int sync {
    show([])
    return 0
}