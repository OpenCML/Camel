/**
 * The declarations of `time` are what an importer sees: `now` gives a float, `strftime` takes a
 * timestamp, with the format as its with-argument, and gives a string, `strptime` takes a text and
 * gives a float or an error. Every call reaches the C++ operator.
 */

import { now, strftime, strptime } from time

func main(): int sync {
    let t: float = now()
    println(t > 0.0)
    let text: string = 0.0->strftime<'%Y-%m-%d'>
    println(text)
    let parsed: float = '1970-01-02'->strptime<'%Y-%m-%d'> !! 0.0
    println(parsed > 0.0)
    return 0
}