/**
 * `rewrite`'s declarations are what an importer sees: the engines take a function and an array of
 * `Rule` values in angle brackets, with and without `strict` and `rounds`, `extract` takes a cost
 * function, every engine answers the function it was given, `F!`, and `check` answers the verdict
 * table `CheckReport` from `stdlib/rewrite.cml`.
 * Checked, not run: the engines need a compiled program, and the rules plans run them.
 */
module rewrite_declaration_import

import { rewrite, saturate, extract, check, check_text } from rewrite
import { nodes as sizeCost } from rules

export rule int_add_zero(x: int) { x + 0 => x }

/// The function the engines are applied to: the program itself would be a recursive reference.
func target(): int {
    return 0
}

func main(): int sync {
    let p = target
    let rules = [int_add_zero]
    let a = p->rewrite<rules>
    let b = p->rewrite<rules, strict: true>
    let c = p->saturate<rules, rounds: 20>
    let d = p->saturate<rules, rounds: 20, strict: true>
    let e = p->extract<sizeCost>
    let report = rules->check<10, 7>
    let written: string = check_text(report)
    return 0
}