/**
 * The declarations of `python`, read from `stdlib/python.cml`: `exec`, `eval`, `run_file`,
 * `import_module`, `attr`, `call` and `to_string` have fixed signatures and are declared;
 * `py_wrap` and `py_unwrap` stay computed in C++.
 * The calls are type-checked and never run: this case stays compile-only.
 */

import { exec, eval, run_file, import_module, attr, call, to_string, py_wrap } from python

func fixed_signatures(): void sync {
    let _ = exec("x = 1")
    let _ = eval("1 + 2")
    let _ = run_file("script.py")
    let math = import_module("math") !! py_wrap(0)
    let sqrt = math->attr<"sqrt"> !! py_wrap(0)
    let _ = [py_wrap(16)]->call<sqrt>
    let _ = to_string(sqrt)
}

func main(): int {
    return 0
}