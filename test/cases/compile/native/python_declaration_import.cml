/**
 * The declarations of `python`, read from `stdlib/python.cml`: `py_exec`, `py_eval`, `py_run`,
 * `py_attr`, `py_import` and `py_dispose` have fixed signatures and are declared; `py_call`,
 * `py_print`, `py_println`, `py_wrap` and `py_unwrap` stay computed in C++.
 * The calls are type-checked and never run: this case stays compile-only.
 */

import { py_exec, py_eval, py_run, py_attr, py_import, py_dispose, py_wrap } from python

func fixed_signatures(): void sync {
    let _ = py_exec("x = 1")
    let _ = py_eval("1 + 2")
    let _ = py_run("script.py")
    let math = py_import("math") !! py_wrap(0)
    let sqrt = py_attr(math, "sqrt") !! py_wrap(0)
    py_dispose(sqrt)
}

func main(): int {
    return 0
}