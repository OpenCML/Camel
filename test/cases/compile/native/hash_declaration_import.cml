/**
 * The declarations of `hash` are what an importer sees: `sha256` accepts a `string` and a `Bytes`
 * value (a text is encoded first, then one operator, `hash:sha256_bytes`, digests the bytes). Every
 * call reaches the C++ operator.
 */

import { sha256 } from hash
import { encode } from bytes

// SHA-256 applied `rounds` times, each to the hexadecimal text of the one before.
func sha256_rounds(s: string, rounds: int): string {
    let (digest, done) = loop digest = s, done = 0 while done < rounds do (sha256(digest), done + 1)
    return digest
}

func main(): int sync {
    let expected = 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'
    let text: string = sha256('abc')
    let binary: string = sha256(encode('abc'))
    println(text == expected)
    println(binary == expected)
    println(sha256_rounds('abc', 0) == 'abc')
    println(sha256_rounds('abc', 1) == expected)
    return 0
}