/**
 * The declaration of `nn:save_params` is what an importer sees: the first parameter is a type
 * variable (any value), the second is the declaration's `string` directory, and the
 * result is `void`. Every call reaches the C++ operator, which writes each tensor leaf of the
 * tree as a `.npy` file (step 10).
 */

import { save_params } from nn
import { new } from tensor
import { exists } from fs
import { get_env } from env

func main(): int sync {
    let root = get_env('CAMEL_TEST_TMPDIR')
    let dir = if root == '' then 'test/tmp/nn_declaration' else root + '/nn_declaration'
    let params = { w: new([1.0, 2.0]), b: new([0.0]) }
    save_params(params, dir)
    println(exists(dir + '/w.npy'))
    println(exists(dir + '/b.npy'))
    // A parameter tree is not required: the type variable accepts any value, and the operator
    // ignores leaves that are not tensors.
    save_params('not a tree', dir)
    return 0
}