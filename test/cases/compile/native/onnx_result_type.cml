/**
 * The result type of `onnx:supported_operators` is the declaration's `string[]`, not a type the
 * C++ resolver decides per call: binding it to an `int` is refused with the value's type taken
 * from the declaration (handover H179). With no ordinary parameter this is the type case a
 * zero-argument declaration can have.
 */
module onnx_result_type

import { supported_operators } from onnx

func main(): int {
    let count: int = supported_operators()
    return count
}