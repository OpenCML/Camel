/**
 * The fusion pass meets the same tagged function twice. `chain`'s kernel is `tensor:sigmoid` and
 * its Camel body is the `1/(1+exp(-x))` form the `rules::fusion` library rewrites into `sigmoid`.
 *
 * `main` prints the two paths — the direct call, which is one OPER of the kernel, and the call
 * through the function value, which is the body's four operators — summed and subtracted one from
 * the other, in the same program. Run with `rules::fusion` in front of the scheduler, the body is
 * rewritten into the operator the kernel already is and the difference stays zero; run without the
 * pass, the body is the chain in the file. `impl_pass_fusion_wrong.cml` is the same comparison
 * with a kernel that is not the body's meaning, so a zero here is not the only thing it can say.
 *
 * This module writes `module tensor` (as `declaration_per_result_type.cml` does) so that it may
 * declare the kernel its function is tagged with.
 */
module tensor

import { Tensor } from tensor


#op<'tensor:sigmoid'>
func sigmoid_kernel(x: Tensor): Tensor

#impl<sigmoid_kernel>
func chain(x: Tensor): Tensor {
    return 1.0 / (1.0 + exp(-x))
}

func main(): int sync {
    let x = reshape([1.0, -0.5] as f32[], [2])
    let by_body = chain

    let k = chain(x)
    let b = by_body(x)
    'fusion kernel_sum={} body_sum={} diff={}'->format<sum(k), sum(b), sum(k - b)>->println
    return 0
}