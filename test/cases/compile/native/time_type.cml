/**
 * An integer where the declaration says `string`: the call is refused at the declaration's type,
 * and the message prints the declaration's own parameter names (`text`, and `format` among the with-parameters); the one
 source is `stdlib/time.cml`, not the C++ module.
 */

import { strptime } from time

func main(): int sync {
    println(strptime<'%Y'>(42))
    return 0
}