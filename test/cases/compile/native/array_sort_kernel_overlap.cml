/**
 * The spelling the sorting family must not be written in, refused where the second declaration is
 * written (design principles 4.3, 4.4, 5.1; the language author's ruling of 2026-10-24 on the
 * declaration arms, `docs/handover/reviews/questions-2026-10-23.md`): two same-named body-less
 * declarations whose `when` conditions are not mutually exclusive.
 *
 * `is_integer::<T>()` holds for `i32` and `int`, and `is_ordered::<T>()` holds for those and for
 * the floating-point types, the two ordered non-numeric types and the complex ones, so `i32`
 * satisfies both conditions and no order of the two declarations could decide a call with an
 * `i32[]`: the pair is an overlap, and the report names the type both conditions hold for and both
 * declarations.
 *
 * `stdlib/array.cml` does not write the sorts this way. It names one element type per declaration
 * and takes that element type in the signature (`(xs: i32[]) => i32[]`), because a `when` on a
 * body-less declaration is checked for overlap but is not what a call is resolved by: the operator
 * group takes the first rule whose parameter types accept the arguments, `when` or not
 * (src/core/operator_group: resolveForCall; probe in
 * docs/handover/reviews/questions-2026-10-23.md §sorts-per-element-type).
 */
module array_sort_kernel_overlap

import { is_integer, is_ordered } from types

#op<':op/add_i'>
func sort_kernel::<T>(xs: T[]): T[] when is_integer::<T>()

#op<':op/add_l'>
func sort_kernel::<T>(xs: T[]): T[] when is_ordered::<T>()

#impl<sort_kernel>
func sort_camel::<T>(xs: T[]): T[] {
    return xs
}

func main(): int sync {
    let small: i32[] = [1, 2, 3]
    println(sort_camel(small))
    return 0
}