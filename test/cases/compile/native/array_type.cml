/**
 * An `int` where the declarations of `array:argsort` take an array of keys: the call is refused
 * at the declaration's type, and the signatures in the message have the declarations' own
 *  parameter name (`keys`) — the one source is `stdlib/array.cml`, not the C++ (
 *  step 10).
 */
module array_type

import { argsort } from array

func main(): int sync {
    println(argsort(42))
    return 0
}
