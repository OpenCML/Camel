/**
 * Which operator a call of a body-less declaration reaches is decided by the call's argument
 * types and the declaration's `when`, never by the order the declarations are written in
 * (design principles 4.4: a `when` condition is evaluated at instantiation, an overload whose
 * condition does not hold does not apply, and a call no candidate applies to is reported with each
 * candidate's unmet condition).
 *
 * Two declarations of one name, one generic signature, conditions that exclude each other: the
 * `i32` rule is the subtraction and the `int` rule is the addition, so the two results say which
 * operator each call reached. This file writes the `i32` rule first, its twin
 * `when_order_at_call_int_first.cml` writes the other one first; the two files hold the same
 * program and must print the same two lines.
 */
module when_order_at_call_i32_first

/// The element type of the first arm: `i32` alone.
func is_arm_i32::<T>(): bool {
    return match type T {
        case i32 => true
        case _ => false
    }
}

/// The element type of the second arm: `int` alone.
func is_arm_int::<T>(): bool {
    return match type T {
        case int => true
        case _ => false
    }
}

#op(':op/sub_i')
func arms_kernel::<T>(a: T, b: T): T when is_arm_i32::<T>()

#op(':op/add_l')
func arms_kernel::<T>(a: T, b: T): T when is_arm_int::<T>()

func main(): int sync {
    let x: i32 = 19
    let y: i32 = 23
    // `i32`: only the first rule's condition holds, so the call is the subtraction (19 - 23).
    'i32={}'->format<arms_kernel(x, y)>->println
    // `int`: only the second rule's condition holds, so the call is the addition (19 + 23).
    'int={}'->format<arms_kernel(19, 23)>->println
    return 0
}