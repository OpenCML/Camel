/**
 * The declaration of `numel` takes one ordinary argument: a second one is refused at the call,
 * and the overload the message lists is the declaration's — the one source is
 * `stdlib/tensor.cml`, not the C++ module.
 */
module tensor_arity

import { new, numel } from tensor

func main(): int sync {
    let t = new([[1.0, 2.0]] as f32[][])
    println(numel(t, 2))
    return 0
}