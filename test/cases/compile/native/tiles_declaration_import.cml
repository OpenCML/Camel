/**
 * The declarations of `tiles:available` and `tiles:device` are what an importer sees, read from
 * `stdlib/tiles.cml`: no parameters, a `bool` and a `string` result, and the call reaches the C++
 * operator (step 10). `available` runs here; `device` is only type-checked,
 * because asking for a device without one is a fault and this case has to run without a GPU.
 */

import { available, device } from tiles

func description(): string {
    let text: string = device()
    return text
}

func main(): int sync {
    let possible: bool = available()
    println(possible)
    return 0
}