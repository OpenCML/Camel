/**
 * The declarations of `tiles:available` and `tiles:device` are what an importer sees, read from
 * `stdlib/tiles.cml`: no parameters, a `bool` and a `string!` result, and the call reaches the C++
 * operator (step 10). Both run here: `available` answers `false` in a run without a device, and
 * `device` reaches the C++ operator and answers the error value of kind `DeviceUnavailable`, which
 * the `!!` below stands for, so this case needs no GPU.
 */

import { available, device } from tiles

func description(): string {
    let text: string = device() !! 'no device'
    return text
}

func main(): int sync {
    let possible: bool = available()
    println(possible)
    println(description())
    return 0
}