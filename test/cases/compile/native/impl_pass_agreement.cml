/**
 * The agreement case over kernels a test module may declare. A body-less declaration stands for
 * an operator of the module it is written in, and a test module writes no other module's protocol,
 * so the kernels here are the core's own scalar operators: `:op/add_l`, `:op/add_d` and
 * `:op/mul_d`. Each tagged function keeps a Camel body that computes the same value by a
 * different expression, so the two paths of the same function run different operators and must
 * still agree.
 *
 * `main` takes every pair both ways: a direct call (one OPER of the kernel) and a call through the
 * function value (the Camel body graph). `impl_pass_disagreement.cml` is the same shape with the
 * tag naming the wrong kernel, so a `diff` of zero here is not something the comparison hands out
 * for free.
 */
module impl_pass_agreement

#op<':op/add_l'>
func add_kernel(a: int, b: int): int

#impl<add_kernel>
export func plus(a: int, b: int): int {
    return a - (0 - b)
}

#op<':op/add_d'>
func add_f_kernel(a: float, b: float): float

#impl<add_f_kernel>
export func ratio(a: float, b: float): float {
    return (a / b) * b
}

#op<':op/mul_d'>
func mul_kernel(a: float, b: float): float

#impl<mul_kernel>
export func scaled(a: float, b: float): float {
    return (a * b * 2.0) / 2.0
}

func main(): int sync {
    let by_body_plus = plus
    let by_body_ratio = ratio
    let by_body_scaled = scaled

    let kp = plus(19, 23)
    let bp = by_body_plus(19, 23)
    let kr = ratio(4.0, 2.0)
    let br = by_body_ratio(4.0, 2.0)
    let ks = scaled(3.0, 4.0)
    let bs = by_body_scaled(3.0, 4.0)

    'plus kernel={} body={} diff={}'->format<kp, bp, kp - bp>->println
    'ratio kernel={} body={} diff={}'->format<kr, br, kr - br>->println
    'scaled kernel={} body={} diff={}'->format<ks, bs, ks - bs>->println
    return 0
}