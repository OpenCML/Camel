/**
 * The agreement case over real kernels. This module writes `module tensor` (the way
 * `declaration_per_result_type.cml` does) so that it may declare the kernels its functions are
 * tagged with: a body-less declaration stands for an operator of the module it is written in, and
 * only that module may declare it. The kernels here are the tensor module's own
 * (`tensor:sum`, `tensor:mean`, `tensor:sigmoid`) and the core's (`:op/mul_d`), and each tagged
 * function keeps a Camel body that is a different expression over the same input.
 *
 * Every pair is taken both ways by `main`: a direct call (one OPER of the kernel) and a call
 * through the function value (the Camel body graph). The values must agree; the graphs must not.
 */
module tensor

import { Tensor } from tensor


#op<'tensor:sum'>
func sum_kernel(t: Tensor): Tensor

#impl<sum_kernel>
export func total(t: Tensor): Tensor {
    return reshape(t, [4])
}

#op<'tensor:mean'>
func mean_kernel(t: Tensor): Tensor

#impl<mean_kernel>
export func average(t: Tensor): Tensor {
    return mean(t)
}

#op<':op/mul_d'>
func mul_kernel(a: float, b: float): float

#impl<mul_kernel>
export func scale(a: float, b: float): float {
    return (a * 2.0) / 2.0
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0] as f32[], [2, 2])

    let by_body_total = total
    let by_body_average = average
    let by_body_scale = scale

    let kt = total(x)
    let bt = by_body_total(x)
    let ka = average(x)
    let ba = by_body_average(x)
    let ks = scale(2.0, 3.0)
    let bs = by_body_scale(2.0, 3.0)

    'total kernel={} body={} diff={}'->format<sum(kt), sum(bt), sum(kt - bt)>->println
    'average kernel={} body={} diff={}'->format<sum(ka), sum(ba), sum(ka - ba)>->println
    'scale kernel={} body={} diff={}'->format<ks, bs, ks - bs>->println
    return 0
}