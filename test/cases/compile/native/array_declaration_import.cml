/**
 * The declarations of `array` are what an importer sees: `argsort` has its eight declared key
 * element types and gives `int[]`; `sort` is a generic Camel function over `argsort` whose kernel
 * has one declaration per element type, each naming its own operator and taking that element type;
 * and `flatten` and `unique` are generic Camel functions of `stdlib/array.cml`.
 */
module array_declaration_import

import { sort, argsort, flatten, unique } from array

func main(): int sync {
    println(argsort([30, 10, 20]))
    println(argsort([2.5, 1.5, 3.5]))
    println(argsort(['pear', 'fig', 'apple']))
    println(sort([3, 1, 2]))
    println(flatten([[1, 2], [3]]))
    println(unique([3, 1, 3, 2, 1]))
    return 0
}
