/**
 * A string where the declaration says `int`: the call is refused at the declaration's type, and
 * the message prints the declaration's own parameter names (`parties`, `timeout_ms`) — the one
 *  source is `stdlib/para.cml`, not the C++ module (step 10).
 */
module para_type

import { rendezvous } from para

func main(): int sync {
    println(rendezvous('a', 0))
    return 0
}