/**
 * The declaration of `rewrite:rewrite` takes two ordinary arguments at least: one is refused at
 * the call, and the overloads the message lists are the declaration's `(p: Program, rules:
 * Rule[]) => Program!` and `(p: Program, rules: Rule[], strict: bool) => Program!` —
 * `stdlib/rewrite.cml`, not the C++ module.
 */
module rewrite_arity

import { rewrite } from rewrite
import { Program, current } from graph

func main(): int sync {
    let p: Program = current()
    let q = rewrite(p)
    return 0
}