/**
 * An integer where the declaration says `string`: the call is refused at the declaration's type,
 * and the message prints the declaration's own parameter names (`pattern`, `text`) — the one
 * source is `stdlib/re.cml`, not the C++ module (handover H19, step 10).
 */
module re_type

import { test } from re

func main(): int sync {
    println(test(42, 'abc'))
    return 0
}