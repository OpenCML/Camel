/**
 * The generic declaration is instantiated by the type of the arguments: `at` on `int[]` gives an
 * `int`, on `string[]` a `string`, and the same declaration serves both (handover H19, step 1).
 */
import { at, second } from generic_module

func main(): int sync {
    let ints = [3, 5, 7]
    println(at(ints, 1))
    println(second(ints))
    let words = ['alpha', 'beta', 'gamma']
    println(at(words, 2))
    println(second(words))
    return 0
}