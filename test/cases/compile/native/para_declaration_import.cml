/**
 * The declarations of `para` are what an importer sees: the fixed one of `rendezvous` and the two
 * that take the element type of their array argument (`unordered_foreach` has a callback whose
 * result type is free, `unordered_reduce` a callback from the element to itself). Every call
 * reaches the operator the module runs (handover H19, step 10; H146; H202).
 */
module para_declaration_import

import { rendezvous, unordered_foreach, unordered_reduce } from para

func main(): int sync {
    let met: int = rendezvous(1, 0)
    println(met)
    println(unordered_reduce<(acc: int, item: int): int => acc + item, 0>(1..5))
    unordered_foreach<(item: int) => item>(0..3)
    println('done')
    return 0
}
