/**
 * The declaration of `para:rendezvous` is what an importer sees; the two unordered higher-order
 * operators still answer from the C++ resolver, and every call reaches the operator the module
 * runs (handover H19, step 10; H146).
 */
module para_declaration_import

import { rendezvous, unordered_foreach, unordered_reduce } from para

func main(): int sync {
    let met: int = rendezvous(1, 0)
    println(met)
    println(unordered_reduce<(acc: int, item: int): int => acc + item, 0>(range(1, 5)))
    unordered_foreach<(item: int) => item>(range(0, 3))
    println('done')
    return 0
}