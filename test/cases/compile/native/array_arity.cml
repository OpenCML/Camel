/**
 * The declarations of `array:argsort` take one array argument: a second one is refused at the
 * call, and the overloads the message lists are the declarations' (step 10;
 * 
 */
module array_arity

import { argsort } from array

func main(): int sync {
    println(argsort([1, 2], 3))
    return 0
}
