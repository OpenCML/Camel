/**
 * The second parameter of `rewrite:extract` is the declaration's `string`: an `int` there is
 * refused at the call, and the overload the message lists is the declaration's
 * `(p: Program, cost: string) => Program!` —
 * `stdlib/rewrite.cml`, not the C++ module.
 */
module rewrite_type

import { extract } from rewrite
import { Program, current } from graph

func main(): int sync {
    let p: Program = current()
    let q = extract(p, 1)
    return 0
}
