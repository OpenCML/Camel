/**
 * The with parameter of `rewrite:extract` is the declaration's cost function: an `int` there is
 * refused at the call, and the candidate the message lists is the declaration's
 * `(f: F): F!` with `cost: (o: Op, inputs: float[]) => float` — `stdlib/rewrite.cml`, not the C++
 * module.
 */
module rewrite_type

import { extract } from rewrite

func target(): int {
    return 0
}

func main(): int sync {
    let q = target->extract<1>
    return 0
}
