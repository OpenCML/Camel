/**
 *  `#impl` on a generic function ("泛型函数可以带 `#impl`").
 * The kernel is a body-less declaration of the same module, and which executor an instance gets
 *  is decided when the instance is made (: one operator, per-type executors).
 *
 * `at` declares its kernel with the function's own type parameters, so every instance of it has
 * an executor: `at([7, 8, 9], 0)` is one OPER of `:op/idx_arr`.
 *
 * `add` declares a kernel with one fixed rule, `(int, int) => int`, so only `add<int>` has an
 * executor: that call is one OPER of `:op/add_l`, and no node of the body runs. `add<i32>` has
 * no executor (the rule does not accept `i32`), so that instance runs the body — which is the
 * semantics, and gives the same value — through `:op/sub_i` and `:op/neg_i`. `std::profile`
 * counts the two paths apart: one `:op/add_l`, no `:op/sub_l` at all, and the `i32` body's own
 * operators.
 */
module impl_generic

#op<':op/idx_arr'>
func idx_kernel::<T>(xs: T[], i: int): T

#impl<idx_kernel>
func at::<T>(xs: T[], i: int): T {
    return xs[i]
}

#op<':op/add_l'>
func add_kernel(a: int, b: int): int

#impl<add_kernel>
func add::<T>(a: T, b: T): T {
    return a - (0 - b)
}

func main(): int sync {
    let first = at([7, 8, 9], 0)
    let throughKernel = add(19, 23)
    let x: i32 = 19
    let y: i32 = 23
    let throughBody = add(x, y)
    'at={} kernel={} body={}'->format<first, throughKernel, throughBody>->println
    return 0
}