/**
 * `onnx`'s declaration is what an importer sees: `supported_operators` takes no ordinary
 * argument and answers `string[]`, read from `stdlib/onnx.cml`, and the call reaches the C++
 * operator. The case is checked, not run: the
 * onnx declaration cases are compile-only.
 */

import { supported_operators } from onnx

func count(): int {
    let uris: string[] = supported_operators()
    return len(uris)
}

func main(): int {
    return count()
}
