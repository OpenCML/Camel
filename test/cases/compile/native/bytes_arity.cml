/**
 * The declaration of `bytes:size` is the signature a call is checked against: two arguments are
 * refused at the call, where the overload is written as the declaration wrote it (handover H19,
 * step 1).
 */
import bytes

func main(): int sync {
    let b = bytes::from_array([1, 2, 3])
    return bytes::size(b, b)
}