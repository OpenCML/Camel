/**
 * The declarations of `random` are what an importer sees: `seed` and `next_key` are the two
 * operators of the global stream, `key` gives the module's `Key`, and `choice`, `sample` and
 * `shuffle` are generic declarations of the element type of their array, with the key a
 * configuration (`stdlib/random.cml`). The keyed draws are pure; every call reaches its
 * operator or its Camel definition.
 */
module random_declaration_import

import {
    Key, seed, next_key, rand, randn, key, split, fold, randint, choice, sample, shuffle,
    permutation, uniform
} from random

func main(): int sync {
    seed(42)
    let r = rand()
    let n = randn()
    let k: Key = next_key()
    println(r >= 0.0 && r < 1.0)
    println(n > -10.0 && n < 10.0)
    println(k->randint<3, 4>)
    println(['solo']->choice<k>)
    println(len([1, 2, 3]->sample<k, 2>))
    println([7]->shuffle<k>)
    let (a, b) = split(key(42))
    'key={} a={} b={} folded={}'->format<key(42), a, b, fold(key(42), 1)>->println
    let p: int[] = permutation(key(42), 4)
    println(p)
    println(uniform::<f32>(key(42)) < f32(1.0))
    return 0
}
