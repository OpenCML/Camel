/**
 * The declarations of `graph` are what an importer sees: `Graph` and `Node` and the result types
 * of `graph_of`, `nodes`, `id` and `type_of` come from `stdlib/graph.cml`, and every call reaches
 * the operator the C++ module runs.
 */
module graph_declaration_import

import { name, nodes, id, type_of, type_name, graph_of } from graph
import { Graph, Node } from graph

func main(): int sync {
    let g: Graph = graph_of(main)
    println(name(g))
    let ns = nodes(g)
    println(len(ns) > 0)
    let n: Node = ns[0]
    println(id(n) == id(n))
    println(match type_of(n) {
        case null => 'none'
        case t => type_name(t)
    })
    return 0
}
