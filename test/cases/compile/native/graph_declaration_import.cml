/**
 * The declarations of `graph` are what an importer sees: `Program`, `Graph` and `Node` and the
 * result types of `current`, `root`, `nodes`, `id` and `type_of` come from `stdlib/graph.cml`,
 * the two comparison declarations are the operators of the handle types, and every call reaches
 * the operator the C++ module runs (step 10).
 */

import { current, root, name, nodes, id, type_of, type_name } from graph
import { Program, Graph, Node } from graph

func main(): int sync {
    let p: Program = current()
    println(p == current())
    println(p != current())
    let g: Graph = root(p)
    println(name(g))
    let ns = nodes(g)
    println(len(ns) > 0)
    let n: Node = ns[0]
    println(id(n) == id(n))
    println(match type_of(n) {
        case null => 'none'
        case t => type_name(t)
    })
    return 0
}