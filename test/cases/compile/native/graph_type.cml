/**
 * An integer where the declaration says `Program`: the call is refused at the declaration's
 * type, and the message prints the declaration's own parameter name (`p`) — the one source is
 *  `stdlib/graph.cml`, not the C++ module (step 10).
 */
module graph_type

import { root } from graph

func main(): int sync {
    println(root(42))
    return 0
}