/**
 * An integer where the declaration says a function: the call is refused, because the declaration's
 * `when` condition (`is_function::<F>()`) is false for it, and the message prints the declaration's
 * own parameter name (`f`): the one source is `stdlib/graph.cml`, not the C++ module.
 */
module graph_type

import { graph_of } from graph

func main(): int sync {
    println(graph_of(42))
    return 0
}
