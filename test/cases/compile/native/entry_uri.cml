/**
 * A declaration in the entry module stands for an operator of the module it writes itself to be:
 * its URI's prefix is the declared name `bytes`, not the runtime name `main` the entry file has
 * (design principles 10.1).
 */
module bytes

import { encode } from bytes

export func size(content: Bytes): int

func main(): int sync {
    println(size(encode('abc')))
    return 0
}