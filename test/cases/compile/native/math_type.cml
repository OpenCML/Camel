/**
 * A string where the declarations of `abs` take a number: the call is refused at the
 * declarations' type, and the message prints their own parameter name (`x`) — the one source
 *  is `stdlib/math.cml`, not the C++ module.
 */
module math_type

import { abs } from math

func main(): int sync {
    println(abs('x'))
    return 0
}