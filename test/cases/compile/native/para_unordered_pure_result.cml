/**
 * The element function of `unordered_foreach` is written for its effects, as the one of `foreach`
 * is: the result of a call that runs for nothing is the error UnusedPureResult, and the
 * declaration `with <f: (item: T) => void>` says what such a function is for rather than letting
 * its result type look like part of the contract.
 */

import { abs } from math
import { unordered_foreach } from para

func main(): int sync {
    unordered_foreach<(item: int) => abs(item)>([-1, 2])
    return 0
}