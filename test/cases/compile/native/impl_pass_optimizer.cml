/**
 * The optimizer meets the same tagged function twice: `std::opt` (inline, devirtualize,
 * specialize, fold, algebra, cse, dce, ctrl) runs over a program that calls `plus` both ways. A
 * direct call is one OPER of its kernel `:op/add_l`, so there is no call for the optimizer to
 * inline and nothing it may look inside. A call through the function value is a CALL of the body
 * graph `a - (0 - b)`: that call is what the optimizer may inline, and `diff` shows that inlining
 * it did not change the answer.
 *
 * What the case pins is the pair of values and their agreement on every back end. A `std::gir`
 * dump of the optimized program is where the graph side of that statement lives; the two graphs it
 * prints (the kernel operator in `main`, the body's `:op/sub_l` nodes in the graph of `plus`) are
 * read by inspection there, not asserted here, because the case is about what the two paths
 * compute once a production pass has been through the program.
 */
module impl_pass_optimizer

#op(':op/add_l')
func add_kernel(a: int, b: int): int

#impl(add_kernel)
export func plus(a: int, b: int): int {
    return a - (0 - b)
}

func main(): int sync {
    let by_body = plus
    let k = plus(19, 23)
    let b = by_body(19, 23)
    'opt kernel={} body={} diff={}'->format<k, b, k - b>->println
    return 0
}