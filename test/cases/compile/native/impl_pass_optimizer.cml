/**
 * The optimizer meets the same tagged function twice: `std::opt` (inline, devirtualize,
 * specialize, fold, algebra, cse, dce, ctrl) is applied to the program and the two graphs are then
 * dumped. A direct call of `plus` is one OPER of its kernel `:op/add_l`, so the optimizer has
 * nothing to inline and must leave it as the kernel operator — the body `a - (0 - b)` is not a
 * function it can see at all. A call through the function value is a CALL of the body graph: the
 * call is what an optimizer may inline, and `diff` shows that inlining it did not change the
 * answer.
 *
 * `std::gir` after the pass prints both graphs, so the two paths are comparable on the same
 * program: the kernel path is one operator, the body path is the body graph's nodes inlined into
 * `main`, and neither is the other.
 */
module impl_pass_optimizer

#op<':op/add_l'>
func add_kernel(a: int, b: int): int

#impl<add_kernel>
export func plus(a: int, b: int): int {
    return a - (0 - b)
}

func main(): int sync {
    let by_body = plus
    let k = plus(19, 23)
    let b = by_body(19, 23)
    'opt kernel={} body={} diff={}'->format<k, b, k - b>->println
    return 0
}