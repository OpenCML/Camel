/**
 * The same shape as `impl_pass_agreement.cml`, with each tag naming a deliberately wrong kernel:
 * `wrong` says `a + b` and names `:op/sub_l`, `mix` says `a * b` and names `:op/div_d`.
 *
 * A direct call takes the kernel and a call through the function value takes the body, so the two
 * integer paths disagree by 39 (3 against 42), and the reverse pass disagrees by 1.5 for the
 * floats: at (4.0, 2.0) the kernel `a/b` has 1/b = 0.5 while the body `a*b` has 2.0. This is the
 * observation that makes the agreement case a check rather than a tautology — a compiler that ran
 * the body for a direct call would print equal pairs here.
 */
module impl_pass_disagreement

import { grad } from autodiff

#op<':op/sub_l'>
func sub_kernel(a: int, b: int): int

#impl<sub_kernel>
func wrong(a: int, b: int): int {
    return a + b
}

#op<':op/div_d'>
func div_kernel(a: float, b: float): float

#impl<div_kernel>
with <a: float, b: float>
func mix(): float {
    return a * b
}

with <a: float, b: float>
func via_body(): float {
    return a * b
}

func main(): int sync {
    let by_body_wrong = wrong
    let k = wrong(19, 23)
    let b = by_body_wrong(19, 23)

    // The reverse pass reaches both paths of a tagged function: the direct call of `mix` is the
    // `:op/div_d` operator, whose registered rule is used, while the same body reached through the
    // function value is `a * b`. Two different functions, two different gradients.
    let d_kernel = grad(mix)<4.0, 2.0>()
    let d_body = grad(via_body)<4.0, 2.0>()

    'wrong kernel={} body={} diff={}'->format<k, b, k - b>->println
    'grad kernel={} body={} diff={}'->format<d_kernel, d_body, d_kernel - d_body>->println
    return 0
}