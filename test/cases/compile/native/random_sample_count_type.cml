/**
 * `random:sample` declares its count as `int`: a `float` count is refused at the call, so the
 * old C++ resolver's unchecked count is not reachable through the declaration. The
 * declaration's own signature is what the message lists.
 */
module random_sample_count_type

import { sample } from random

func main(): int sync {
    let xs: int[] = sample([1, 2, 3], 2.0)
    return len(xs)
}