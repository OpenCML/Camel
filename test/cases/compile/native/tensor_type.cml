/**
 * A string where the declaration of `to_bytes` takes a tensor: the call is refused at the
 * declaration's type, and the message prints its own parameter name (`t`) — the one source is
 * `stdlib/tensor.cml`, not the C++ module.
 */
module tensor_type

import { to_bytes } from tensor

func main(): int sync {
    println(to_bytes('x'))
    return 0
}