/**
 * The functions of `math` are what an importer sees: `abs`, `min`, `clamp`, `sqrt` and the two
 * shifts (the count in angle brackets) are read from `stdlib/math.cml`, and a call at a type with a
 * kernel reaches the operator the C++ module runs. The constant `pi` is a value of the module.
 */
module math_declaration_import

import { abs, clamp, min, sqrt, shl, shr, pi } from math

func main(): int sync {
    println(abs(-3))
    println(abs(f32(-2.5)))
    println(min(3, 5))
    println(clamp(15, 0, 10))
    println(sqrt(9.0))
    println(1->shl<4>)
    println(256->shr<4>)
    println(pi)
    return 0
}
