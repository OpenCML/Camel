/**
 * Type variables bind where they first appear in a parameter type (design principles 5.5):
 * an ordinary parameter, a `with` parameter, and a function type written inside either.
 * A name used again refers to the binding, which is what makes the function generic.
 */
module parameters

// `A` appears twice: the second parameter and the result type refer to the binding.
func pair(x: A, y: A): (A, A) {
    return (x, y)
}

// The type of the `with` parameter binds `T` and `U`; the result type uses `U`.
with <f: (x: T) => U>
func turn(x: T): U {
    return f(x)
}

// A function type written in an ordinary parameter type binds its variables too.
func feed(f: (x: T) => U, x: T): U {
    return f(x)
}

func main(): int sync {
    let p = pair(1, 2)
    println(p.0)
    println(p.1)
    println(turn<(x: int) => x + 1>(41))
    println(feed((x: int) => x * 3, 7))
    return 0
}