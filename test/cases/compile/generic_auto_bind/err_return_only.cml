/**
 * A plain name written only in the return type binds nothing: there is no argument to take a
 * type from, so it is an error rather than a type variable (design principles 5.5). A
 * return-only variable that the expected result determines is declared with `typeas`.
 */
module err_return_only

func make(x: int): T {
    return x
}

func main(): int sync {
    println(make(1))
    return 0
}