/**
 * A type variable bound automatically and written only once is most likely a misspelt type
 * name, so the signature compiles and the compiler warns (design principles 5.5). `T` is
 * bound by the parameter and used nowhere else; `U` is written twice and is not reported.
 */
module warn_used_once

func show(x: T): string {
    return 'x'
}

func twice(x: U): U {
    return x
}

func main(): int sync {
    println(show(1))
    println(twice(2))
    return 0
}