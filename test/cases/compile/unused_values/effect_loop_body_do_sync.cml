/**
 * The remedy the help gives for a loop body: the body declares itself a sync block with
 * `do sync { ... }`, so the call written there runs each round and the loop's state and value are
 * the same as in `effect_loop_body_dropped.cml` -- only the one word differs.
 */

func main(): int sync {
    let total = loop i = 0 while i < 3 do sync {
        println(i)
        i + 1
    }
    'total={}'->format<total>->println
    return 0
}