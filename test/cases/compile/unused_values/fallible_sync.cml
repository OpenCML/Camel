/**
 * A statement whose value has type `T!` and that nothing uses: the error it may hold is lost. In
 * a `sync` body the statement runs, and the warning is UnusedFallibleValue (design principles
 * 3.9) -- the plain call is the one statement, and it is the only diagnostic.
 */

func check_same(a: int, b: int): bool! {
    return if a == b then true else error('Mismatch', 'not the same')
}

func main(): int sync {
    check_same(1, 2)
    println('done')
    return 0
}