/**
 * A `sync { ... }` block written as a statement in a loop body: the block is not a region the
 * program chooses to run or not -- it is a block, and a block runs with the region around it -- so
 * the write it holds is a root of the loop body (design principles 3.1), and it runs each round.
 * Only a region whose owner runs nothing keeps its writes out of the execution.
 *
 * This case used to measure the opposite, under the reading that a block whose value nothing takes
 * does not run. 3.1's rule is about the *region*, and a block is not one.
 */

func main(): int sync {
    let total = loop i = 0 while i < 3 do {
        sync {
            println(i)
        }
        i + 1
    }
    'total={}'->format<total>->println
    return 0
}