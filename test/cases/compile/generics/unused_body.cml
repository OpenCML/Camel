/**
 * The body of a generic function is *type-checked* when it is instantiated. One that is never
 * called is never instantiated, so a check that needs the type a type parameter stands for --
 * whether `+` applies to it, whether a field is there -- is not made for it.
 *
 * The names are not such a check: they are resolved where the declaration is written, and a
 * misspelling there is reported whether
 * or not an instance is ever made.
 * `err_decl_name.cml` is the case that pins that half.
 */
module unused_body

func never_called::<T>(x: T): T {
    return x + x
}

func main(): int sync {
    println('ok')
    return 0
}
