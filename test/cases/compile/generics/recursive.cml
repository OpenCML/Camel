/**
 * Recursive generic functions. A recursive call with the same types is a call of the
 * instance being built; one instance exists per set of types, however often it is called.
 */
module recursive

func count::<T>(xs: T[], i: int): int {
    return if i >= len(xs) then 0 else 1 + count(xs, i + 1)
}

func last_of::<T>(xs: T[], i: int): T {
    return if i + 1 >= len(xs) then xs[i] else last_of(xs, i + 1)
}

func is_even::<T>(xs: T[], i: int): bool {
    return if i >= len(xs) then true else is_odd(xs, i + 1)
}

func is_odd::<T>(xs: T[], i: int): bool {
    return if i >= len(xs) then false else is_even(xs, i + 1)
}

func main(): int sync {
    println(count([1, 2, 3], 0))
    println(count(['a', 'b'], 0))
    println(count([4, 5, 6, 7], 0))
    println(last_of([1, 2, 3], 0))
    println(last_of(['x', 'y'], 0))
    println(is_even([1, 2], 0))
    println(is_even(['a', 'b', 'c'], 0))
    return 0
}
