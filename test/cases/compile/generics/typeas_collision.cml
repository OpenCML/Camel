module typeas_collision

// `T` is a declared type, so a plain `T` in a parameter type would refer to it. `typeas T`
// states that a new type variable of that name is bound for this signature instead, which is
// what the explicit form is for (design principles 5.5).
type T = int

func id(a: typeas T): T {
    return a
}

func main(): int sync {
    println(id(1))
    return 0
}