// A type parameter the signature never mentions (design principles 5.5): `T` is declared at the
// head, so every call has to take one for it, and nothing in the parameter or result types can use
// it -- the declaration relates nothing and can never be specialized on it. Still a warning: the
// program compiles and runs, and the repair is to write `T` in a type or remove it from `::<...>`.

func f::<T>(x: int): int {
    return x
}

func main(): int sync {
    println(f::<int>(1))
    return 0
}