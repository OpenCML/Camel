/**
 * The calling form the standard library keeps: the value worked on is the ordinary argument,
 * the rest are with-arguments, written before the parentheses or after an arrow; operations
 * on two operands of equal standing take both as ordinary arguments.
 */

func main(): int sync {
    let m = [('a', 1), ('b', 2)] as Map<string, int>
    let s = [3, 1, 2] as Set<int>
    // before the parentheses
    let m1 = put<'c', 3>(m)
    let v1 = get<'a'>(m)
    let d1 = get_or<'z', 9>(m)
    let h1 = has<'a'>(m)
    let r1 = remove<'a'>(m)
    let s1 = add<9>(s)
    let c1 = contains<2>(s)
    println(m1, v1 ?? 0, d1, h1, r1, s1, c1)
    // after an arrow
    println(m->put<'c', 3>, m->get<'z'> ?? 0, m->get_or<'a', 9>, m->has<'z'>, m->remove<'z'>)
    println(s->add<1>, s->contains<7>, s->contains<3>, s->remove<3>, s->remove<8>)
    println(m->put<'c', 3>->put<'d', 4>->remove<'a'>->has<'d'>)
    // two operands of equal standing: both ordinary
    println(merge(m, [('b', 20), ('d', 4)] as Map<string, int>))
    println(union(s, [9] as Set<int>), intersect(s, [1, 9] as Set<int>), difference(s, [1] as Set<int>), is_subset([1] as Set<int>, s))
    return 0
}
