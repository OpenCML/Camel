// The unary minus is an operator of its own level: looser than `^`, tighter than `->` and the
// other binary operators, the same before a literal and before a name.
func inc(x: int): int {
    return x + 1
}

func main(): int sync {
    let x = 2
    println(-2 ^ 2, -x ^ 2, (-2) ^ 2, 2.0 ^ -1.0 ^ 2.0)
    println(-2->inc, -x->inc, -x * 3, 5 - -x, 5-1, x - 1)
    println(-9223372036854775808, -2.5, [-1, 2], - 3)
    let b: i32 = -2147483648
    println(b)
    return 0
}
