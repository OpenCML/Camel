/**
 * The right side of `as` is a type: `..` after a type there is the stream suffix. A number
 * written directly after the `..` is the interval reading in a place where a type stands, and
 * it is reported by name - SyntaxDiag::AsRightSideIsType, at the `..`, saying how to write the
 * interval instead (`(a..b)`).
 */
module stream_type_as_interval

func main(): int sync {
    let n = 3
    let r = n as int..5
    println(r)
    return 0
}