// The three forms of the provisional `loop` expression (design principles 2.10). The syntax and
// the AST are in place; the graph is not, so the compiler stops at the first loop.
func main(): int sync {
    let n = 4
    let xs = [1, 2, 3]
    let (i, acc) = loop (i, acc) = (1, 0) while i <= n { (i + 1, acc + i) }
    let total = loop acc = 0 for x in xs { acc + x * x }
    loop found = -1 for x in xs while found < 0 {
        if x > 9 then x else found
    }
    return 0
}
