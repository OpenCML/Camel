/// The square of a number.
/// Negative numbers are fine.
func square(x: int): int {
    return x * x
}

// An ordinary comment is not documentation.
func plain(x: int): int {
    return x
}

/// The answer.
let answer = 42

//// Four slashes: an ordinary comment.
type Pair = (int, int)

/// Exported and documented.
export let common = 1

func main(): int sync {
    println(square(answer) + plain(common))
    return 0
}
