// Counting until a condition holds, which is the writing the author's ruling of 2026-11-16 sends
// the open interval `a..` to (design principles 4.2): a counter stops at the first square that is
// not below 1000, and two counters stop when the running sum passes 100 (their value is the tuple
// of both). Neither asks for a range whose end is a condition.
func main(): int sync {
    let i = loop i = 0 while i * i < 1000 do i + 1
    let (n, total) = loop n = 0, total = 0 while total <= 100 do (n + 1, total + n + 1)
    println(i, n, total)
    return 0
}