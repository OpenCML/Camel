/**
 * The rest parameter and the rest argument as syntax: `..ts` is the last parameter of a
 * signature, and `..(a, b)` / `..ts` is the last argument of a call.
 */

func total(..ts): int {
    return static loop acc = 0 for j in indices ts do acc + ts.[j]
}

func forward(..ts): int {
    return total(..ts)
}

func main(): int sync {
    println(total(1, 2, 3))
    println(total(..(4, 5)))
    println(forward(6, 7))
    return 0
}