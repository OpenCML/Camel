/**
 * A `constas n: int` value parameter of a function declaration: the value is known at each
 * call and is written as an extent of the parameter type, not passed as a runtime argument.
 */
import { ones, sum } from tensor

func total(constas n: int, x: f32[n]): float {
    return float(sum(x))
}

func main(): int sync {
    println(total(3, ones([3])))
    println(total(5, ones([5])))
    return 0
}