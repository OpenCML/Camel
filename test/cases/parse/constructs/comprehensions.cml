/**
 *  Comprehensions.: a `static for` written where a value is needed. `{... }` builds a
 * struct with the fields of the type it walks, `( ... )` a tuple with its elements; the block of
 * a round keeps its value, and the empty struct has no round.
 */

func doubled(t: {a: int, b: int}): {a: int, b: int} {
    return { static for n, F in fields {a: int, b: int} => t.[n] * 2 }
}

func shifted(t: (int, int)): (int, int) {
    return ( static for n, F in fields (int, int) => t.[n] + 1 )
}

func incremented(t: {a: int, b: int}): {a: int, b: int} {
    return { static for n, F in fields {a: int, b: int} => {
        let v: F = t.[n]
        v + 1
    } }
}

func no_fields(): {} {
    return { static for n, F in fields {} => 0 }
}

func main(): int sync {
    let d = doubled({a: 1, b: 2})
    println(d.a, d.b)
    let s = shifted((3, 4))
    println(s.0, s.1)
    let i = incremented({a: 10, b: 20})
    println(i.a, i.b)
    let e = no_fields()
    return 0
}