/**
 * `static loop`. `static loop <state> for (n, F) in fields <type> do <body>` walks
 * the fields of the type at instantiation and advances the state once per field; the trip count
 * is the arity, so a `T` that comes from an enclosing generic counts only at instantiation. The
 * value is the last state, and two states are a tuple.
 */

func sum_of::<T>(t: T): int {
    return static loop acc = 0 for n, F in fields T do acc + t.[n]
}

func total_and_max(t: {a: int, b: int, c: int}): (int, int) {
    return static loop total = 0, best = 0
        for n, F in fields {a: int, b: int, c: int} do {
            let v: F = t.[n]
            (total + v, if best < v then v else best)
        }
}

func sum_tuple(t: (int, int)): int {
    return static loop acc = 0 for n, F in fields (int, int) do acc + t.[n]
}

func empty(t: {}): int {
    return static loop acc = 7 for n, F in fields {} do acc + 1
}

func main(): int sync {
    println(sum_of({a: 1, b: 2, c: 3}))
    let (total, best) = total_and_max({a: 3, b: 9, c: 4})
    println(total, best)
    println(sum_tuple((4, 5)))
    println(empty({}))
    return 0
}