/**
 * Format strings (the `FSTRING` token): `${...}` interpolates an expression, `${x:spec}` gives it
 * a format specification, braces outside an interpolation are literal, and the token may span
 * lines. `\${`, `\`` and `\u{...}` are escapes; a format string nests another one.
 */
module parse_constructs_fstring

func main(): int sync {
    let name = 'Camel'
    let n = 42
    let pi = 3.5
    println(`hello, ${name}!`)
    println(`n = ${n}, twice = ${n * 2}`)
    println(`pi = ${pi:.2f}`)
    println(`expr: ${(1 + 2) * 3}`)
    println(`nested: ${'<' + `inner ${n}` + '>'}`)
    println(`braces { } are literal; \${not} interpolated`)
    println(`a backtick \` and a brace { stay`)
    println(`first line
second line: ${n}
third line`)
    return 0
}