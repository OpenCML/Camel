/**
 * A type expression has no operators: `A & B` is not a type, so the `&` is refused where the
 * declaration expects its `=` (line 10, column 14). `&` is the expression's operator (the one that
 * evaluates both sides). The type operators the grammar reserved left the language in the item-5
 * clearance.
 */
module no_type_inter

func f(x: int): int {
    let a: A & B = x
    return a
}

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}