/**
 * A pattern is a constant, and an interpolation is not one: a formatted string where a pattern is
 * read is an ordinary syntax error (line 10, column 14) at the backtick. It was a
 * `ConstructNotSupported` while the grammar's `literal` took a formatted string in a pattern.
 */
module no_formatted_string_pattern

func f(s: string): int {
    return match s {
        case `x` => 1
        case _ => 0
    }
}

func main(): int sync {
    println('never printed')
    println(f('x'))
    return 0
}