/**
 * `...s` in a struct literal is refused at the marker (line 10, column 15) as an ordinary syntax
 * error: a spread is not in the language. It used to crash the compiler, and afterwards it was a
 * `ConstructNotSupported` while the form was still in the grammar.
 */
module syntax_no_spread_in_struct_literal

func main(): int sync {
    let s = { x: 1 }
    let t = { ...s, y: 2 }
    println('never printed')
    println(t)
    return 0
}