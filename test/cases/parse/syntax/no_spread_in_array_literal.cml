/**
 * A spread is not in the language: `...xs` in an array literal is refused at the marker
 * (line 11, column 15) as an ordinary syntax error. It was a `ConstructNotSupported` while the
 * form was still in the grammar; before that the marker was dropped and the program printed an
 * address.
 */

func main(): int sync {
    let xs = [1, 2, 3]
    let ys = [...xs, 4]
    println('never printed')
    println(ys)
    return 0
}