/**
 * The backslash is not a token of the language any more: the type difference `A \ B` was the only
 * place it was read, so a `\` is now an unknown character (line 10, column 14) and the lexer says
 * so before the parser sees a type at all. The type operators left the language in the item-5
 * clearance, and the token went with them because nothing produced it.
 */
module no_type_diff

func f(x: int): int {
    let a: A \ B = x
    return a
}

func main(): int sync {
    println('never printed')
    println(f(1))
    return 0
}