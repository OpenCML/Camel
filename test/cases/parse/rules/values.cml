/**
 * A rule is a function (rewrite design 2.1): `rule name(params) { left => right }` is the pair of
 * functions name__lhs and name__rhs and the function name() that makes the Rule from them. The
 * module `rewrite` reads the rule back.
 */
module values
import { rule_name, rule_two_way, rule_consts } from rewrite

export rule mul_one(x: int) { x * 1 => x }
rule swap(a: int, const c: int) { a * c <=> c * a }

func main(): int sync {
    println(rule_name(mul_one()), rule_two_way(mul_one()), rule_consts(mul_one()))
    println(rule_name(swap()), rule_two_way(swap()), rule_consts(swap()))
    println(mul_one__lhs(7), mul_one__rhs(7))
    return 0
}
