/**
 * A rule is a value (rewrite design 2 (second version) 8.5): `rule name(params) { left => right }`
 * is the pair of functions name__lhs and name__rhs and the value `name` of type Rule made from
 * them. The module `rewrite` reads the rule back.
 */
module values
import { rule_name, rule_two_way, rule_consts } from rewrite

export rule mul_one(x: int) { x * 1 => x }
rule swap(a: int, const c: int) { a * c <=> c * a }
/// A rule with a condition: the value takes the fourth function, name__when, whose parameters are
/// nodes of the draft being rewritten (H38).
rule guarded(x: int) { x + 0 => x } when true

func main(): int sync {
    println(rule_name(mul_one), rule_two_way(mul_one), rule_consts(mul_one))
    println(rule_name(swap), rule_two_way(swap), rule_consts(swap))
    println(rule_name(guarded), rule_two_way(guarded), rule_consts(guarded))
    println(mul_one__lhs(7), mul_one__rhs(7))
    return 0
}
