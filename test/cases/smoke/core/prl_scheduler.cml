/**
 * Minimal parallel workload used to prove the PRL scheduler can issue waits and join independent tasks correctly.
 */
module prl_scheduler

func work(n: int): int {
    return n * n
}

func main(): int sync {
    let a = work(5)
    let b = work(6)
    let c = a + b
    'prl_scheduler a={} b={} sum={}'->format<a, b, c>->println
    return 0
}

