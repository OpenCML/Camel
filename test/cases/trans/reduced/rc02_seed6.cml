// Reduced from the e9 corpus (author list, item A4c): `std::opt std::fvm` aborted on
// "Guarantee: brchTargetMap.empty() ... BRCH nodes have unmatched control outputs without
// corresponding JOIN nodes". On 2026-11-02 it runs with no output and exit 0; this case keeps it so.
func r6(a7: int, a8: int): int {
    return if a7 <= 0 then 1 else r6(0, (match a8 {
        case 5 => int(0.25)
        case _ => -a8
    }) % 97);
}

func main(): int sync {
    var v65 = (0, 0).0;
    var v67 = r6(8, v65);
    return 0;
}
