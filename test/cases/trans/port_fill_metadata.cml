// Named with/normal parameters, captured values in zero-argument functions, and aggregate FILLs.
with <offset: int>
func assemble(items: int[]): int[] {
    let count = len(items)
    let make = (): int[] => [offset, count]
    let pair = (offset, count)
    let record = { value: offset, size: count }
    let other = (): int[] => [pair.0, record.size]
    return if count > 0 then make() else other()
}
func main(): int[] { return assemble<3>([1, 2]) }
