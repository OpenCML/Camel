/** The canonical dump keeps names out: this program and `cml_canon_name_b.cml` differ only in
 * names (module, functions, `let`s). Both functions have the same parameter name, so the front
 * end interns their signatures into one type object; the other file does not, and the canonical
 * type table must still be the same. */

func bump(x: int): int {
    let step = x + 1
    return step
}

func bump2(x: int): int {
    let step = x * 2
    return step
}

func main(): int sync {
    println(bump(1), bump2(2))
    return 0
}