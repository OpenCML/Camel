/**
 * The refusal that names the values, not just the operator: a slice of a value of two dimensions
 * is not the one slice this back end has -- it keeps no shape, so `m[0:1]` of `float[2, 3]` is not
 * a run of a block here -- and the message says the types it was given instead of "on values",
 * because the shape is what the reader has to know.
 *
 * The value arrives as the parameter of `main`, not as a literal of several dimensions: a literal
 * of that type is refused earlier and with its own message (refuse_literal_rank.cml), and this case
 * is about the slice.
 */

func main(m: float[2, 3]): int sync {
    println(m[0:1])
    return 0
}