/**
 * std::cpp translates scalar and string values only. The pass refuses at the operator use that
 * needs a tensor -- `tensor:ones` in `main`, line 16 -- and names the operator and the type of its
 * argument, instead of stopping with an internal error that names a node number; the array-returning
 * `scale` is never reached.
 */
module refuse_tensor

import { ones } from tensor

func scale(x: f32[..], k: f32): f32[..] {
    return x * k
}

func main(): int sync {
    println(scale(ones([2, 3]), 2.0))
    return 0
}
