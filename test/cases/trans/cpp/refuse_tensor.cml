/**
 * `tensor:ones` crosses the bridge: a tensor is a value the runtime owns, and the program holds a
 * counted handle to it (rt::Foreign), so what a tensor is is written once, in the runtime module,
 * and the program prints it as the interpreter does.
 *
 * `tensor:zeros` builds one the same way and has no rule in the table yet. The refusal names that
 * operator and the work not done -- not the shape array it takes (an `int[]` is translated) and not
 * the type of its result (the bridge carries a tensor now).
 */

import { zeros } from tensor

func main(): int sync {
    println(zeros::<f32>([2, 3]))
    return 0
}