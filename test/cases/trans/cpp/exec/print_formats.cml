// `print` and `println` with a format write what they write without one: `print` no line end,
// `println` one (design principles 2.13: the extra empty line of `println<fmt>` and the extra
// line end of `print<fmt>` were defects of the interpreter, which the generated C++ copied).
func main(): int sync {
    print<'{}-{}'>(3, 4)
    print('|')
    println<'{}+{}'>(1, 2)
    println('next')
    print<'[{}]'>(5)
    print<'[{}]'>('a')
    println('')
    println<'{:.2f}'>(0.5)
    return 0
}
