/// `var` variables: assigned in a function (a C++ local) and passed as `var` arguments.
///
/// What is no longer here: a closure that captured a `var` and wrote it (a shared cell). A closure
/// may not assign an outer name (the ruling of 2026-11-15, design principles 3.5); the writes below
/// are the function's own, and the three values printed are the three it printed before.

func bump(var x: int) {
    x += 1
}

func count(n: int): int sync {
    var total = 0
    var i = 0
    total = total + n * 2
    total += 5
    i = total * 2
    return i + total
}

func main(): int sync {
    var c = 10
    bump(c)
    bump(c)
    println(c, count(3))
    var s = 'a'
    s = s + 'b'
    s += 'c'
    println(s)
    var acc = 0
    acc += 5
    let after5 = acc
    acc += 7
    println(after5, acc, acc)
    return 0
}
