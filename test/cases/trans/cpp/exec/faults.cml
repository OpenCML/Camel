/// A fault ends the program with the report the interpreters print, source excerpt included,
/// after the output written before it (design principles 10.6).
module faults

func quot(a: int, b: int): int {
    return a / b
}

func main(): int sync {
    print('pending ')
    println(quot(7, 2))
    println(quot(7, 0))
    println('not reached')
    return 0
}
