/// Scalars in the program std::cpp writes: integer arithmetic that wraps around, division and
/// remainder of negative numbers, i32, floats and their text, conversions, comparisons.
module scalars

import { sqrt, abs, floor } from math

func wrap(x: int): int {
    return x * 1000000007 * 1000000007
}

func main(): int sync {
    println(9223372036854775807 + 1, -9223372036854775807 - 2)
    println(wrap(123456789))
    println(7 / 2, -7 / 2, 7 % -2, -7 % 2, 7 % -1)
    println(2 ^ 10, 2.0 ^ 0.5)
    println(i32(40000) * i32(60000))
    println(1.0e-7 * 3.0, 3.141592653589793, 0.1 + 0.2, 1e16, 1e15, 100.0, -0.0)
    println(1.0 / 3.0, float(1) / 3.0, int(2.9), int(-2.9), float('1.5') * 2.0)
    println(f32(0.1), f32(1) / f32(3))
    println(3 < 4, 3.0 >= 4.0, true == false, !true, -(-5), 5 != 5)
    println(sqrt(2.0), abs(-3), abs(-2.5), floor(-1.5))
    println(string(42), string(2.5), string(true), int('-17') + 1)
    return 0
}
