/// The module random in a compiled program: seeded, it draws the numbers the interpreter draws
/// (both run Philox4x32-10 from camel/utils/philox.h). The keyed draws that sit on arrays
/// (`shuffle`, `sample`, `permutation`) are not translated yet.
import { seed, next_key, rand, key, split, uniform } from random

func main(): int sync {
    seed(7)
    println(rand(), rand(), next_key())
    let (a, b) = split(key(7))
    println(a, b, uniform::<float>(a), uniform::<f32>(b))
    // the same seed gives the same draws again
    seed(7)
    println(rand())
    return 0
}
