/// Branches are statements: the value of a branch used twice runs its arm once (it ran twice,
/// design principles 10.6), and the effects of a sync block keep their order
/// around a branch (D5). Nested branches, `match` on numbers.

func twice(flag: bool): int sync {
    let r = if flag then println(1) else println(2)
    return r + r
}

func ordered(flag: bool): int sync {
    println('before')
    let r = if flag then println(10) else println(20)
    println('after')
    return r
}

func grade(n: int): string {
    return if n >= 90 then 'A' else if n >= 80 then 'B' else if n >= 70 then 'C' else 'D'
}

func digit(n: int): string {
    return match n {
        case 0 => 'zero'
        case 1 => 'one'
        case _ => 'many'
    }
}

func main(): int sync {
    println(twice(true))
    println(ordered(false))
    println(grade(95), grade(85), grade(75), grade(5))
    println(digit(0), digit(1), digit(7))
    return 0
}
