// An empty literal (`[]`) has no element type of its own: `[]->append<1>` is the element type the
// position gives it, as the interpreter reads it. The generated code used to write `[]` at its own
// type (`void[]`), and the C++ compiler rejected the call -- `rt::Array<void>` is not an array any
// operator takes.
//
// Run: camel test/cases/trans/cpp/empty_literal_takes_the_position.cml std::cpp

func main(): int sync {
    let xs = []->append<1>
    println(len(xs), xs->contains<1>, xs->contains<2>)
    return 0
}