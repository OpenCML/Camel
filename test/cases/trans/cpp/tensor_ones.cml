/**
 * `tensor:ones` crosses the bridge. A tensor is not a value std::cpp writes: it lives in the
 * runtime's tensor module, and the program holds a counted handle to it (rt::Foreign). So the
 * program prints the runtime's own text for the value, and the one line below is std::fvm's, byte
 * for byte -- there is no second implementation of what a tensor is that could drift from it.
 *
 * The shape crosses as the `int[]` it is, and the program links the runtime: `agree_with_fvm` builds
 * and runs it against std::fvm, and the plan's `tensor_ones` case pins the handle in the writer's
 * output.
 */

import { ones } from tensor

func main(): int sync {
    println(ones::<f32>([2, 2]))
    return 0
}