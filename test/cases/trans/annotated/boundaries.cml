/**
 * One of each boundary role for the annotated dump (std::agir, std::argir):
 * `t[0]` and `t[1] * 2.0` cross between tensors and host numbers (scalar
 * boundary), the if-then-else joins two arms of one type (branch contract),
 * `println` is an effect, and `format` has no ONNX lowering (export capability).
 *
 * `gate` is written with its element type and shape (`f32[4]`), the terminal spelling: a parameter
 * that writes no element type leaves it unstated, so `t[0]` had no type for `t[0] > 0.5`.
 */

import { reshape, relu } from tensor
import { export_model } from onnx

func gate(t: f32[4]): f32[4] {
    return if t[0] > 0.5 then relu(t) else t * (t[1] * 2.0)
}

func main(): int sync {
    let y = gate(reshape<[4]>([1.0, -2.0, 3.0, 0.5] as f32[]))
    'gate={}'->format<y[0]>->println
    return 0
}