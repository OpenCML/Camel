// `if` statements and expressions, `match` over literals and booleans, nested branches, and a
// `return` that gives the value of the arm it is written in.
func classify(n: int): int {
    return match n {
        case 1 => 10
        case 2 => 20
        case _ => 0
    }
}

func sign(x: int): int {
    return if x < 0 then -1 else if x > 0 then 1 else 0
}

func denom(x: int): int {
    if x < 0 then { return 0 } else { return x + 1 }
}

func main(): int sync {
    let a = 3
    let b = if a > 2 then a + 1 else a - 1
    let c = classify(2)
    let d = match true {
        case true => 1
        case false => 0
    }
    let e = if a > 0 then (if a > 10 then 1 else 2) else 3
    let f = sign(-4) + sign(0) + sign(9)
    let g = denom(-1) + denom(4)
    if b > 0 then { println('positive', b) }
    if c > 0 then { println('c', c) } else { println('no c') }
    println(a, b, c, d, e, f, g)
    return 0
}