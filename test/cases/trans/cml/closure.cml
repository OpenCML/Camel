// A lambda as a value, one with a block body, one that captures a source name, and one returned
// from a function. A closure over a mutable cell that leaves the call that declared it is refused
// (design principles 3.5, rule two; test/cases/compile/state_escape/err_escape_return.cml), so the
// counter this file used to round-trip is gone.
func make_adder(base: int): (x: int) => int {
    return (x: int) => x + base
}

func main(): int sync {
    let offset = 10
    let add = (x: int) => x + offset
    let twice = (x: int) => {
        let y = x * 2
        y
    }
    let plus3 = make_adder(3)
    println(add(5), twice(4), plus3(7))
    return 0
}