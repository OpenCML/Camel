// The interval `a..b` in a value position (design principles 4.2): the library's range value --
// the three numbers that name the integers -- and not the array of the integers themselves. A
// printed program has to spell the interval again, `a..b`, rather than the `to_range` call the
// graph holds, so the round trip stays a round trip.
//
// What the integers are is `to_array`'s to answer, and a loop over a range is a stream walk since
// the same ruling, which `std::cml` does not print yet: the loop and the printer's refusal are
// pinned in `feat.compile.stream` (`interval_loop`, `interval_loop_cml`).

import { Range } from prelude

func step_of(n: int) => int {
    let span: Range = 1 .. (n + 1)
    return span.step
}

func main() => int sync {
    println(step_of(3), step_of(0))
    return 0
}