// `for`, `while` and `for ... while` loops, one state and two, a struct state, an arm in the
// body, and a body that runs effects before it gives the next state.
func sum(xs: int[]): int {
    return loop acc = 0 for x in xs do acc + x
}

func count_to(n: int): (int, int) {
    return loop i = 1, acc = 0 while i <= n do (i + 1, acc + i)
}

func find(xs: int[]): int {
    return loop hit = -1 for x in xs while hit < 0 do if x > 9 then x else hit
}

func announce(xs: int[]): int sync {
    let total = loop acc = 0 for x in xs do sync {
        println('step', x)
        acc + x
    }
    println('total', total)
    return total
}

func main(): int sync {
    let xs = [1, 2, 3]
    let total = sum(xs)
    let (i, acc) = count_to(3)
    let found = find([3, 12, 7])
    let none = find([1, 2])
    let p = loop p = { x: 0 } for d in [5, 6] do { x: p.x + d }
    let announced = announce([4, 5])
    println(total, i, acc, found, none, p.x, announced)
    return 0
}