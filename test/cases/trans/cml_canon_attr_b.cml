/** `cml_canon_attr_a.cml` plus `#strict` on the block: the nodes of the block carry the tag
 * (`#strict` is a node attribute, plan 1.5 p21) and lose the default permissions. Nothing else
 * about the program changes. */

func quad(x: float): float {
    #strict {
        return x * 1.0 + 2.0
    }
}

func main(): int sync {
    println(quad(3.0))
    return 0
}