
// A loop evaluated ahead of time runs at most --max-macro-rounds rounds (design principles 8).
// With the default limit the loop finishes; a small limit makes the evaluation fail, and the
// failure is a run-time fault of the std::macro pass at the call.

#macro func triangle(n: int): int {
    return (loop s = 0, i = 1 while i <= n do (s + i, i + 1)).0
}

func main(): int sync {
    println(triangle(1000))
    return 0
}