//  measurement workload: N function graphs of built-in integer arithmetic, one loop each,
// in a module that imports nothing. No operator here comes from a module a lazy load could
// declare, so the only declaration change in the measured pipeline is `std::opt`'s algebra
// stage loading the rules library (and through it math and tensor). The function graphs are
// left alone by `std::opt` (their revisions do not change), so the only reason their facts go
// stale is the declaration epoch.
module cost_many_builtin

func f00(n: int): int {
    return loop i = 0 while i < n do i + 1
}

