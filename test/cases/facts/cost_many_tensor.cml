// measurement workload: N groups of three tensor function graphs (a matmul, a loop and a
// reduction) plus main. Tensor operators give shape, instance, reorder and resource facts; the
// loops give loopDomain facts. `std::opt`'s algebra stage loads the rules library (and math)
// after these facts exist when the pipeline seeds them first.
module cost_many_tensor
import { Tensor, reshape, sum, matmul } from tensor

func mm00(x: Tensor<f32, [2, 3]>, w: Tensor<f32, [3, 2]>): Tensor<f32, [2, 2]> {
    return matmul(x, w)
}

func lp00(a: Tensor<f32>): Tensor<f32> {
    return loop y = a for k in [1, 2] do y + a
}

func sm00(x: Tensor<f32, [2, 2]>): float {
    return float(sum(x))
}

func mm01(x: Tensor<f32, [2, 3]>, w: Tensor<f32, [3, 2]>): Tensor<f32, [2, 2]> {
