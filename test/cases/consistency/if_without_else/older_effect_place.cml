/**
 * The effect of a statement's argument runs where the statement is, not at the head of the block:
 * a call whose body has an effect, written in an expression of a later statement, is ordered after
 * the statements written before it (docs/design/effects/edges.cn.md 4.6, 5.7).
 *
 * Minimal form of `if_without_else.statement`: both `std::nvm` and `std::opt` print `before /
 * older / 1 1 / after`. The scale is what makes it useful -- two statements, one branch.
 */

func older(c: bool): int sync {
    if c then sync { println('older'); null }
    return 1
}

func main(): int sync {
    println('before')
    println(older(true), older(false))
    println('after')
    return 0
}
