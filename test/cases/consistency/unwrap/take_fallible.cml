/**
 * `x!` takes the value out of a `T!`, and the failure it carries becomes a fault (design
 * principles 3.9): the fault is the error's own -- the name it was made with and its message --
 * and it is reported where the `!` stands. The take of the value that succeeds is the value.
 */

func parse(n: int) => int! {
    return if n == 12 then n else error('NotANumber', 'the number is not 12')
}

func main() sync {
    let good = parse(12)!
    println(format<good>('take={}'))
    let bad = parse(7)!
    println('not reached')
}