/**
 * Arms that are put into `T?` at their exit, under a condition a pass can decide: once the
 * branch is pruned, what read the join reads the arm. (The arm's node kept the slot of the
 * plain value; std::opt::fold then printed a box as a float. progen finding F42.)
 */
module arms_folded

func main(): int sync {
    let a: float? = if false then null else 1.0
    let b = if true then 7 else null
    let c = if true then 2.5 else (3.5 as float?)
    let d = if false then 'x' else null
    println(a, b, c, d)
    println(a ?? 0.0, b ?? 0, c ?? 0.0, d ?? '-')
    return 0
}
