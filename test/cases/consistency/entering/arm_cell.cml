/**
 * A cell is not a value (the ruling of 2026-10-26 on the arm of a branch): a position that
 * takes a value reads the cell out before the arms are joined, so an arm of `var T` joins as
 * its `T` and an arm without a value joins as `null`; the branch is a `T?`, and the cell's
 * type never reaches the join. The value of a write is the cell it wrote into, which is why
 * an assignment is one of these arms. The write arms stand in a `sync` block, so the write is
 * ordered and no ignored-side-effect warning is part of what this case measures.
 */
module arm_cell

func from_name(var x: int, c: bool): int? {
    return if c then x else null
}

func from_write(var x: int, c: bool): int? sync {
    return if c then sync { x = x + 1 } else null
}

func from_either(var x: int, c: bool): int? sync {
    return if c then x else sync { x = x - 1 }
}

// A position whose type is the cell's own content type: `int` takes the `int` the variable
// holds, never the cell, so the arm joins as `int` and the branch as a whole is an `int`.
func same_type(c: bool, a: int): int {
    var x: int = a
    return if c then x else 0
}

// Only an `int?` enters this position: a cell with a null slot does not, so these calls
// compile only if the cell was read out of the join.
func only_nullable(v: int?): int {
    return v ?? -1
}

func main(): int sync {
    var x: int = 0
    println(only_nullable(from_name(x, true)))
    println(only_nullable(from_name(x, false)))
    println(only_nullable(from_write(x, true)))
    println(x)
    println(only_nullable(from_write(x, false)))
    println(x)
    println(only_nullable(from_either(x, true)))
    println(x)
    println(only_nullable(from_either(x, false)))
    println(x)
    // A binding with no written type: what the arms join is what an `int?` takes.
    let z = if x > 0 then x else null
    println(only_nullable(z))
    // The same, with an arm that is a write: no position types the branch, so the arm merge
    // itself is what reads the cell out; a `(var int)?` would not enter `only_nullable`.
    let w = if x >= 0 then sync { x = x + 1 } else null
    println(only_nullable(w))
    println(x)
    println(same_type(true, 7))
    println(same_type(false, 7))
    return 0
}