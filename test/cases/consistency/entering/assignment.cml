/**
 * A value enters a `T?` / `T!` position by itself wherever the target type is known (design
 * principles 3.8). An assignment to a `var` of the form is one of those positions: the place's
 * declared type is known, so `best = hi` with `best: float?` and `hi: float` puts `hi` into the
 * form, `slot = x` writes a `T` into a `T!`, a literal takes the place's type, and `gone = null`
 * writes the null slot. On the graph each is the CAST node a program would write with `as`. The
 * reverse never enters: see `err_assignment_reverse` and `err_assignment_other_payload`.
 */

// A `var` of the form written twice in its own function: `gone = null` writes the null slot. The
// writes are of this call and read in it, which is what the ruling of 2026-11-15 calls a name for
// values -- no cell leaves the call, and no closure captures one (design principles 3.5).
func clear() => int? sync {
    var gone: int? = 7
    gone = null
    gone
}

// A literal takes the place's type, as a literal takes the type of any other position.
func five() => int? sync {
    var n: int? = 0
    n = 5
    n
}

// The fallible form.
func lifted(x: int) => int! sync {
    var slot: int! = 0
    slot = x
    slot
}

func show(r: int!) => string {
    return match r {
        case error e => 'error ' + e.kind
        case v => 'ok ' + string(v)
    }
}

// A running maximum: the helper takes the value the place holds and gives the new one back, so each
// `best = ...` is an entering assignment and the next call reads the value the line before wrote.
// The shape this case used to carry -- a closure capturing `best` and writing it -- is refused by
// the ruling of 2026-11-15 (design principles 3.5, "a closure may not assign an outer name").
func improve(best: float?, x: float) => float {
    let m = best ?? x
    return if x > m then x else m
}

func main() => int sync {
    var best: float? = null
    let r1 = improve(best, 2.0)
    best = r1
    let r2 = improve(best, -1.0)
    best = r2
    let r3 = improve(best, 1.5)
    best = r3
    let r4 = improve(best, 3.0)
    best = r4
    println(r1, r2, r3, r4)
    println(clear() ?? -1)
    println(five() ?? -1)
    println(show(lifted(7)))
    return 0
}
