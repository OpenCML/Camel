/**
 * Two rulings of 2026-10-13 (design principles log 2.11) that were already implemented:
 * an arm without a value (`void`) and an arm of type `T` make the branch a `T?`, the arm
 * without a value giving `null`; and `xs->slice<2, 1>`, whose start is after its end, is
 * the empty array (not a fault).
 */
module void_arm

func nothing(): void {
}

func pick(c: bool): int? {
    // the else arm is a call that returns nothing
    return if c then 7 else nothing()
}

func pick_block(c: bool): string? {
    return if c then {} else 'b'
}

func main(): int sync {
    println(pick(true) ?? -1, pick(false) ?? -1)
    println(pick_block(true) ?? 'none', pick_block(false) ?? 'none')
    let xs = [1, 2, 3]
    println(xs->slice<2, 1>, len(xs->slice<3, 0>), xs->slice<1, 1>, xs->slice<0, 2>)
    return 0
}
