/**
 * Two overloads of the program accept the operands and neither is more specific: two generic
 * ones (design principles 2.13 prefers only an overload whose parameter types are exactly the
 * operands). The call is ambiguous.
 */
module ambiguous_generic

func operator +(a: (typeas T)[], b: T[]): T[] { return a->extend<b> }
func operator +(a: (typeas T)[], b: (typeas U)[]): T[] { return a }

func main(): int sync {
    println(['x'] + ['y'])
    return 0
}
