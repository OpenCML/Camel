/**
 * Two overloads of the program accept the operands, a generic one and a plain one: the call is
 * ambiguous (design principles 2.12 does not rank them).
 */
module ambiguous_generic

func operator +(a: (typeas T)[], b: T): T[] { return a->append<b> }
func operator +(a: string[], b: string): string[] { return [b] }

func main(): int sync {
    println(['x'] + 'y')
    return 0
}
