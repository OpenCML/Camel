/**
 * Two overloads of the program accept the operands and neither is more specific: two generic
 * ones (design principles 4.3 prefers only an overload whose parameter types are exactly the
 * operands). The call is ambiguous.
 */

func operator +::<T>(a: T[], b: T[]): T[] { return a->extend<b> }
func operator +::<T, U>(a: T[], b: U[]): T[] { return a }

func main(): int sync {
    println(['x'] + ['y'])
    return 0
}
