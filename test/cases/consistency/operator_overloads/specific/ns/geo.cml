// An operator declared in a namespace block belongs to the module (design principles 2.13):
// importing the module brings it, as one declared at the top level.
module geo

namespace Geo {
    export type P = { x: int, y: int }
    export func p(x: int, y: int): P { return { x: x, y: y } }
    export func operator +(a: P, b: P): P { return { x: a.x + b.x, y: a.y + b.y } }
}
