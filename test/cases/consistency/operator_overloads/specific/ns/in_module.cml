// The operator of a namespace block is used in the module itself, outside the block.
module in_module

namespace Geo {
    export type P = { x: int }
    export func operator +(a: P, b: P): P { return { x: a.x + b.x } }
}

func main(): int sync {
    let a: Geo::P = { x: 1 }
    println((a + a).x)
    return 0
}
