/**
 * A generic overload and one whose parameter types are exactly the operands both take the
 * operands: the exact one is more specific and is called (design principles 4.3). Operands
 * the exact one does not take go to the generic one.
 */
module generic_and_exact

func operator +(a: (typeas T)[], b: T): T[] { return a->append<b> }
func operator +(a: string[], b: string): string[] { return [b] }

func main(): int sync {
    println(['x'] + 'y', [1] + 2)
    return 0
}
