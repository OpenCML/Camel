/**
 * A match over a bool that lists only `true` is not complete: it is warned about, and
 * `false` is the fault.
 */
module one_bool_case

func only_true(b: bool): int {
    return match b {
        case true => 1
    }
}

func main(): int sync {
    println(only_true(true))
    println(only_true(false))
    println('not reached')
    return 0
}
