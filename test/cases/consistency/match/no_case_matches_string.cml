/**
 * A `match` without `case _` is a compile-time error (design principles 2.10): the compiler
 * adds no arm of its own, so a value no case lists would have nowhere to go.
 */
module no_case_matches_string

func f(s: string): int {
    return match s {
        case 'a' => 1
        case 'b' => 2
    }
}

func main(): int sync {
    println(f('a'), f('b'))
    return 0
}
