/**
 * `fail('Kind')` with the message left out: the report is the fault of the kind the program
 * wrote, and its message is the empty string. Nothing is invented in its place -- not the kind
 * name, not a sentence about the fault.
 */

func boom() => never {
    return fail('NoPremise')
}

func main() sync {
    println('before')
    boom()
}