/**
 * `exit` gives no value either: its result type is `never` (design principles 3.9), so a
 * function whose declared result type is an int may end with it, and the code it is given is the
 * code the program leaves with.
 */

// `exit` is declared by the `process` module (stdlib/process.cml), like `sleep`: the standard
// library's declarations are read from signature files, so a program names the module it takes
// it from.
import { exit } from process

func main(): int sync {
    println('before')
    exit(7)
}