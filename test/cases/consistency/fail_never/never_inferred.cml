/**
 * `never` is a type the compiler reasons with (design principles 3.9): the argument of a generic
 * call gives no value, so the parameter is inferred as `never`, and the call's result stands
 * where an int is declared. Everything here is settled on the types, so the module is checked
 * rather than run: the program never reaches a value.
 */
module never_inferred

func pick::<T>(x: T): T { return x }

func stop(m: string): never {
    return fail<'Stopped'>(m)
}

func main(): int sync {
    return pick(stop('no value'))
}