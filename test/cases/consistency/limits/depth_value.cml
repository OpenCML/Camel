/**
 * Non-tail recursion through a function value, to the depth given by the environment variable
 * N. Every level is two open calls: step calls via, and via calls step through the value.
 */

import { get_env } from env

func via(f: (n: int) => int, n: int): int {
    return if n == 0 then 0 else 1 + f(n - 1)
}

func step(n: int): int { return 0 + via(step, n) }

func main(): int sync {
    let n = int(get_env('N'))
    println('start')
    println(step(n))
    println('done')
    return 0
}
