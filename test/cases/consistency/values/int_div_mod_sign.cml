/**
 * Integer division and modulo with negative operands.
 */

func div(a: int, b: int): int { return a / b }
func rem(a: int, b: int): int { return a % b }

func main(): int sync {
    println(div(7, 2))
    println(div(-7, 2))
    println(div(7, -2))
    println(div(-7, -2))
    println(rem(7, 2))
    println(rem(-7, 2))
    println(rem(7, -2))
    println(rem(-7, -2))
    println(div(-1, 2))
    println(rem(-1, 2))
    return 0
}
