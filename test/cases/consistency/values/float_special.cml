/**
 * Floating point: infinities, NaN, negative zero and how they print and compare.
 */
module float_special

func mul(a: float, b: float): float { return a * b }
func sub(a: float, b: float): float { return a - b }
func div(a: float, b: float): float { return a / b }

func main(): int sync {
    let inf = mul(1.0e308, 10.0)
    let ninf = mul(-1.0e308, 10.0)
    let nan = sub(inf, inf)
    println(inf)
    println(ninf)
    println(nan)
    println(mul(inf, 0.0))
    println(div(1.0, ninf))
    println(mul(-1.0, 0.0))
    println(nan == nan)
    println(nan != nan)
    println(nan < 1.0)
    println(nan > 1.0)
    println(inf > 1.0e308)
    println(ninf < inf)
    println(0.1 + 0.2)
    println(div(1.0, 3.0))
    println(1.0e21)
    println(1.0e-7)
    println(100.0)
    println(mul(2.5, 2.0))
    println(mul(1.0e-200, 1.0e-200))
    return 0
}
