/**
 * Conversion of a float to an int: truncation toward zero inside the range.
 */
module float_to_int

func conv(x: float): int { return int(x) }

func main(): int sync {
    println(conv(2.9))
    println(conv(-2.9))
    println(conv(0.5))
    println(conv(-0.5))
    println(conv(9007199254740992.0))
    return 0
}
