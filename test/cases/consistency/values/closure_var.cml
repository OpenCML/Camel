/**
 * A running sum written as a value: the helper takes the sum and gives the new one back, so the
 * caller sees every step and no closure captures anything.
 *
 * The shape this case used to pin -- two nested closures capturing one `var` and each writing it,
 * so that both saw every write -- is refused by the ruling of 2026-11-15 (design principles 3.5).
 * The three lines printed are the same: 3, 24, 249.
 */

func add(total: int, x: int): int sync {
    return total + x + x + 1
}

func main(): int sync {
    var total = 0
    total = add(total, 1)
    println(total)
    total = add(total, 10)
    println(total)
    total = total * 2
    total = add(total, 100)
    println(total)
    return 0
}