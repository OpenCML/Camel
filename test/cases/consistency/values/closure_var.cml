/**
 * Nested closures that capture a var: the capture is a reference, so both closures and the
 * function that declared the variable see every write.
 */
module closure_var

func main(): int sync {
    var total = 0
    let add = sync (x: int) => sync {
        let twice = sync (y: int) => sync {
            total = total + y + y
        }
        twice(x)
        total = total + 1
    }
    add(1)
    println(total)
    add(10)
    println(total)
    total = total * 2
    add(100)
    println(total)
    return 0
}
