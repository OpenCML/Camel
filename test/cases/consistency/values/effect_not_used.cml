/**
 * A write to a resource outside the program is a root of the region it is written in (design
 * principles 3.1): `log`'s body is a region, the `println` in it writes `stdout`, so every call of
 * `log` prints -- `log` is called twice, so two lines print before the value of the second call
 * does, on every back end.
 *
 * What 3.1 keeps demand-driven is the *read*: a call whose result nobody uses and that writes
 * nothing outside does not run.
 */

func log(x: int) => int {
    println(x)
    return x + 1
}

func main() => int sync {
    let a = log(1)
    let b = log(a)
    println(b)
    return 0
}
