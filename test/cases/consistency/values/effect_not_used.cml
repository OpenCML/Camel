/**
 * Outside a sync block a call with an effect whose result nobody uses does not run (design
 * principles 3.1, 3.2): log prints nothing, on every back end.
 */

func log(x: int): int {
    println(x)
    return x + 1
}

func main(): int sync {
    let a = log(1)
    let b = log(a)
    println(b)
    return 0
}
