/**
 * Text to number: the whole string must be one number (design principles 2.10). `int(s)` and
 * `float(s)` fault on anything else, blanks included; `parse_int` and `parse_float` read by
 * the same rule and give an error value instead. The faults are shown through `attempt`.
 */
module number_text

func to_int(s: string): int { return int(s) }
func to_i32(s: string): i32 { return i32(s) }
func to_float(s: string): float { return float(s) }

func main(): int sync {
    let texts = ['12', '-12', '+12', ' 7', '7 ', '12abc', '', '1.5', '1e3', '0x10', '1_000', '3000000000', '99999999999999999999', '.5', 'inf', '-inf', 'nan', 'Infinity', '1e999']
    texts->foreach<(s: string) => sync {
        println('[' + s + ']')
        println(attempt(to_int, s))
        println(attempt(to_i32, s))
        println(attempt(to_float, s))
        println(parse_int(s))
        println(parse_float(s))
    }>
    return 0
}
