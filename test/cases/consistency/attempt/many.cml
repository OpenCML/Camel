/**
 * The program goes on for a long time after faults were isolated: N rounds (the environment
 * variable N) of "fault and isolate", one isolated fault a round, alternately three calls deep
 * and in a closure, then N / 100 rounds with the fault in a map element, in tail-recursive
 * loops. Frames, the call depth and the scheduler's state
 * must be exactly what they were after every round, or the loop does not reach its end. The
 * same count of normal calls runs in between.
 */
module many

import { get_env } from env

func leaf(d: int): int { return 100 / d }
func mid(d: int): int { return leaf(d) + 1 }
func top(d: int): int { return mid(d) * 2 }
func inv(x: int): int { return 60 / (x - 2) }

func round(i: int): int {
    // Exactly one of the first two faults in every round.
    let d = i % 2
    let a = attempt(top, d) !! -1
    let b = attempt((x: int): int => 7 / (x - 1), d) !! -2
    let c = attempt(leaf, d + 1) !! -3
    return a + b + c
}

func rounds(i: int, n: int, acc: int): int {
    return if i == n then acc else rounds(i + 1, n, acc + round(i))
}

func map_round(i: int): int {
    let ys = attempt(() => 0..4->map<inv>) !! [i]
    return ys[0]
}

func map_rounds(i: int, n: int, acc: int): int {
    return if i == n then acc else map_rounds(i + 1, n, acc + map_round(i))
}

func main(): int sync {
    let n = int(get_env('N') ?? '')
    println(rounds(0, n, 0))
    println(map_rounds(0, n / 100, 0))
    println(top(5))
    println('end')
    return 0
}
