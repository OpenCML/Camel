/**
 * A macro function whose body uses `attempt`. Without std::macro in the pipeline it is an
 * ordinary function (design principles 8). With std::macro, a call whose arguments are all
 * constants is evaluated ahead of time; the macro evaluator does not run the operators the
 * schedulers run themselves (`map`, `filter`, ..., and `attempt`), so the evaluation fails, and
 * a failed evaluation is a run-time fault of std::macro (8). The same is true of a macro that uses
 * `map`; it is a limit of the evaluator, not of `attempt`.
 */

#macro func table(n: int): int {
    return attempt((d: int): int => 100 / d, n) !! -1
}

func main(): int sync {
    println(table(0))
    println(table(4))
    return 0
}
