/**
 * `attempt` around calls of library functions written in Camel (the `array` module: generic
 * functions built on `map`, so the fault is raised in an element function inside an instance of
 * a library function inside the boundary) and around library operators written in C++ that
 * fault (`zip` of arrays of different lengths, `int` of a text that is no number).
 * With no fault the library call gives its value; with one, the `attempt` gives the error
 * value and the next call of the same library function works.
 */
module library

import { find, any, all, count, flat_map, sort_by, zip_with, sum, take } from array

func inv(x: int): int { return 60 / (x - 3) }
func big(x: int): bool { return 60 / (x - 3) > 10 }

func kind(r: int!): string {
    return match r {
        case error e => e.kind + ' at ' + e.location
        case v => format<v>('{}')
    }
}

func kind_b(r: bool!): string {
    return match r {
        case error e => e.kind + ' at ' + e.location
        case v => format<v>('{}')
    }
}

func main(): int sync {
    let good = [4, 5, 6, 8]
    let bad = [1, 2, 3, 4]

    println(kind(attempt(() => good->find<big> ?? -1)()))
    println(kind(attempt(() => bad->find<big> ?? -1)()))
    println(kind_b(attempt(() => good->any<big>)()))
    println(kind_b(attempt(() => bad->any<big>)()))
    println(kind_b(attempt(() => bad->all<big>)()))
    println(kind(attempt(() => good->count<big>)()))
    println(kind(attempt(() => bad->count<big>)()))

    println(attempt(() => good->flat_map<(x: int) => [x, inv(x)]>)() !! [-1])
    println(attempt(() => bad->flat_map<(x: int) => [x, inv(x)]>)() !! [-1])
    println(attempt(() => good->sort_by<inv>)() !! [-2])
    println(attempt(() => bad->sort_by<inv>)() !! [-2])
    println(kind(attempt(() => sum(zip_with<(a: int, b: int) => a / b>(good, [1, 2, 3, 4])))()))
    println(kind(attempt(() => sum(zip_with<(a: int, b: int) => a / b>(good, [1, 0, 3, 4])))()))

    // Operators written in C++ that fault.
    println(kind(attempt(() => sum(zip_with<(a: int, b: int) => a + b>(good, [1, 2])))()))
    println(kind(attempt(() => sum(['1', '2', 'x']->map<(s: string) => int(s)>))()))
    println(kind(attempt(() => sum(take<2>(good)))()))

    // The library functions are as they were.
    println(good->find<big> ?? -1, good->count<big>, sum(good->sort_by<inv>))
    println('end')
    return 0
}
