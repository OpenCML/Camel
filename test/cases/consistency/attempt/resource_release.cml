/**
 * External resources and the ways a program ends (design principles 2.9: before termination,
 * output is flushed and external resources are released). A Python object that announces its
 * release stands for an external resource. The environment variable END selects the ending:
 *
 *   isolated   the holder faults inside a boundary; the program goes on and returns normally
 *   normal     nothing faults
 *   fault      a fault outside every boundary ends the program
 *   exit       exit(5)
 *
 * In every case each resource is released exactly once, before the process ends, and never
 * while it is still in use: 'release a' and 'release b' both appear, after the 'use' lines.
 */
module resource_release

import { py_call, py_exec, py_eval, py_wrap, py_attr, PyObject } from python
import { get_env } from sys

func open_resource(name: string): PyObject sync {
    return py_call('Resource', py_wrap(name))
}

func hold_and_fault(d: int): int sync {
    let b = open_resource('b')
    py_call('print', py_wrap('use b'))
    let q = 100 / d
    py_call(py_attr(b, 'touch'))
    return q
}

func main(): int sync {
    py_exec('class Resource:\n    def __init__(self, name):\n        self.name = name\n        print("acquire", name, flush=True)\n    def touch(self):\n        print("touch", self.name, flush=True)\n    def __del__(self):\n        print("release", self.name, flush=True)\n')
    let end = get_env('END')
    let a = open_resource('a')
    py_call('print', py_wrap('use a'))
    if end == 'isolated' then sync {
        println(attempt(hold_and_fault, 0) !! -1)
    } else sync {
        println(attempt(hold_and_fault, 4) !! -1)
    }
    py_call(py_attr(a, 'touch'))
    let z = if end == 'fault' then 0 else 1
    println(1 / z)
    if end == 'exit' then sync { exit(5) }
    println('last line of main')
    return 0
}
