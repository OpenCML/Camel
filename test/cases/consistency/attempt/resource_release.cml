/**
 * External resources and the ways a program ends (design principles 3.9: before termination,
 * output is flushed and external resources are released). A Python object that announces its
 * release stands for an external resource. The environment variable END selects the ending:
 *
 *   isolated   the holder faults inside a boundary; the program goes on and returns normally
 *   normal     nothing faults
 *   fault      a fault outside every boundary ends the program
 *   exit       exit(5)
 *
 * In every case each resource is released exactly once, before the process ends, and never
 * while it is still in use: 'release a' and 'release b' both appear, after the 'use' lines.
 */

import { exec, import_module, attr, call, py_wrap, PyObject } from python
import { get_env } from env
import { exit } from process

// A Python call is an error value; these programs expect every call to succeed.
func must(r: PyObject!): PyObject {
    return r !! py_wrap('python failed')
}

// A name of the program's `__main__`, or of `builtins`.
func main_name(name: string): PyObject sync {
    return must(import_module('__main__')->attr<name>)
}

func builtin(name: string): PyObject sync {
    return must(import_module('builtins')->attr<name>)
}

func say(text: string): void sync {
    let print = builtin('print')
    let _ = [py_wrap(text)]->call<print>
}

func touch(resource: PyObject): void sync {
    let method = must(resource->attr<'touch'>)
    let none: PyObject[] = []
    let _ = none->call<method>
}

func open_resource(name: string): PyObject sync {
    let resource = main_name('Resource')
    return must([py_wrap(name)]->call<resource>)
}

func hold_and_fault(d: int): int sync {
    let b = open_resource('b')
    say('use b')
    let q = 100 / d
    touch(b)
    return q
}

func main(): int sync {
    let _ = exec('class Resource:\n    def __init__(self, name):\n        self.name = name\n        print("acquire", name, flush=True)\n    def touch(self):\n        print("touch", self.name, flush=True)\n    def __del__(self):\n        print("release", self.name, flush=True)\n')
    let end = get_env('END') ?? ''
    let a = open_resource('a')
    say('use a')
    if end == 'isolated' then sync {
        println(attempt(hold_and_fault)(0) !! -1)
    } else sync {
        println(attempt(hold_and_fault)(4) !! -1)
    }
    touch(a)
    let z = if end == 'fault' then 0 else 1
    println(1 / z)
    if end == 'exit' then sync { exit(5) }
    println('last line of main')
    return 0
}
