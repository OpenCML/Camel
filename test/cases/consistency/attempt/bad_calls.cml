/**
 * Calls of `attempt` the type rule refuses: no function, a function with a `with` parameter, and
 * the deleted `attempt(f, x)` spelling, whose arguments are counted against the transform
 * (which takes one): writing it is a plain argument count mismatch, no diagnostic of its own.
 */

func risky(d: int): int { return 100 / d }
with <k: int>
func scaled(d: int): int { return k / d }

func main(): int sync {
    println(attempt(5) !! -1)
    println(attempt(scaled) !! -1)
    println(attempt(risky, 1) !! -1)
    println(attempt(risky, 'one') !! -1)
    println(attempt(risky, 1, 2) !! -1)
    return 0
}