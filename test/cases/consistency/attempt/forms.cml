/**
 * The forms of the operator and of its result: a function that already returns `U!` gives `U!`
 * (its own errors are handed on unchanged, a fault becomes an error of the same type); a
 * function that returns `U?` gives `U?!`. The result is handled with `!!`, `?->` and
 * `match ... case error e`, and can be stored, passed and printed like any `T!`.
 *
 * DESIGN-QUESTION(attempt-fallible-target): `attempt` of a function that returns `U!` has the
 * type `U!`, not `U!!`.
 */
module forms

func half(x: int): int { return 100 / x }

func checked(x: int): int! {
    if x < 0 then {
        throw error('Negative', 'the argument is negative')
    } else {
        return 100 / x
    }
}

func maybe(x: int): int? {
    let r: int? = if x > 50 then null as int? else (100 / x) as int?
    return r
}

func plus_one(x: int): int { return x + 1 }

func describe(r: int!): string {
    return match r {
        case error e => 'error ' + e.kind
        case v => format<v>('value {}')
    }
}

func main(): int sync {
    // !!
    println(attempt(half, 4) !! -1)
    println(attempt(half, 0) !! -1)
    // ?->
    println(describe(attempt(half, 4) ?-> plus_one))
    println(describe(attempt(half, 0) ?-> plus_one))
    // match
    println(describe(attempt(half, 0)))
    // printing an error value
    println(attempt(half, 0))
    println(attempt(half, 5))
    // U! stays U!
    println(describe(attempt(checked, 4)))
    println(describe(attempt(checked, -4)))
    println(describe(attempt(checked, 0)))
    // U? gives U?!
    let m = attempt(maybe, 0)
    let text = match m {
        case error e => 'error ' + e.kind
        case v => 'value ' + format<v ?? -5>('{}')
    }
    println(text)
    let n = attempt(maybe, 80)
    let text2 = match n {
        case error e => 'error ' + e.kind
        case v => 'value ' + format<v ?? -5>('{}')
    }
    println(text2)
    println('end')
    return 0
}
