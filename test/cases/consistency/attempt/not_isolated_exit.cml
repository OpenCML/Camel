/**
 * exit(n) is not a fault: called inside a boundary it ends the program with its code, and the
 * `!!` fallback is not taken.
 */

func leave(x: int): int sync {
    println('leaving')
    if x == 3 then sync { exit(7) }
    return x
}

func main(): int sync {
    println('before')
    let a = attempt(leave, 1) !! -1
    println(a)
    let b = attempt(leave, 3) !! -1
    println(b)
    println('not reached')
    return 0
}
