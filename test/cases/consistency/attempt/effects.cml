/**
 * What happened inside the boundary before the fault stays. Lines printed before the fault are
 * printed, in order; a var written before the fault keeps the value written (a var is a shared
 * cell: nothing is rolled back); what would have run after the fault did not run. Outside the
 * boundary nothing is disturbed: the nodes after the `attempt` run as after any call.
 */
module effects

func main(): int sync {
    var total = 1
    // A function with a var parameter cannot be handed to an operator; the closure captures
    // the variable instead (by reference, design principles 3.5).
    let work = (d: int): int => sync {
        println('work begins')
        total = total + 10
        println(format<total>('total is {}'))
        let q = 100 / d
        total = total + 1000
        println('work ends')
        return q
    }
    println('before')
    let a = attempt(work, 4) !! -1
    println(a)
    println(total)
    let b = attempt(work, 0) !! -1
    println(b)
    println(total)
    var seen = 0
    let c = attempt(() => sync {
        0..6->foreach<(x: int) => sync {
            seen = seen + 12 / (3 - x)
            println(seen)
        }>
        return seen
    }) !! -1
    println(c)
    println(seen)
    println('after')
    return 0
}
