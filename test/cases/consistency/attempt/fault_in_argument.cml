/**
 * The arguments of `attempt` are nodes of the enclosing graph: a fault raised while one of them
 * is evaluated is outside the boundary and ends the program.
 */
module fault_in_argument

func risky(d: int): int { return 100 / d }

func main(): int sync {
    let z = 0
    println(attempt(risky, 5) !! -1)
    println(attempt(risky, 10 / z) !! -1)
    println('not reached')
    return 0
}
