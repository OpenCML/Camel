/**
 * Isolated faults under allocation pressure: every round builds arrays and strings inside the
 * boundary, faults with them half built, and builds more from the error value afterwards. Run
 * with heap verification and with the collector's stress mode
 * (docs/technical/24_gc_verification_guide.md): what the boundary dropped must be collectable,
 * and what is used after it must have survived.
 */
module collector

import { get_env } from env

func build(i: int, d: int): string[] {
    let xs = 0..20->map<(x: int): string => format<x + i>('item {}')>
    let n = 100 / d
    return xs->map<(s: string): string => s + format<n>(' / {}')>
}

func round(i: int): int {
    let r = attempt(build, i, i % 3)
    let text = match r {
        case error e => [e.kind, e.message, e.location]
        case v => v
    }
    return len(text) + len(text[0])
}

func rounds(i: int, n: int, acc: int): int {
    return if i == n then acc else rounds(i + 1, n, acc + round(i))
}

func main(): int sync {
    let n = int(get_env('N'))
    println(rounds(0, n, 0))
    println(attempt(build, 1, 0))
    println((attempt(build, 1, 5) !! ['none'])[19])
    println('end')
    return 0
}
