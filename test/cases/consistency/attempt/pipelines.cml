/**
 * One program for the optimisation pipelines (std::opt::inline, std::opt, std::opt, ...):
 * small functions that an inliner would copy into their callers, constant arguments a
 * specialiser would propagate, a constant division by zero inside the callee, two identical
 * `attempt` calls, and one whose result is not used. The boundary must stay where it is: the
 * output is the same with and without the passes.
 */
module pipelines

func risky(d: int): int { return 100 / d }
func twice(d: int): int { return risky(d) + risky(d) }
func always(): int { return 1 / 0 }
func add(a: int, b: int): int { return a + b }

func through(d: int): int {
    // The callee is small and called once: inlining it here would move the fault out of the
    // boundary of the attempt below, were the boundary not kept.
    return attempt(twice)(d) !! -1
}

func kind(r: int!): string {
    return match r {
        case error e => e.kind + ' at ' + e.location
        case v => format<v>('{}')
    }
}

func main(): int sync {
    println(kind(attempt(risky)(0)))
    println(kind(attempt(risky)(5)))
    println(kind(attempt(always)()))
    println(through(0), through(10))
    println(kind(attempt(add)(2, 3)))
    let a = attempt(risky)(0) !! 1
    let b = attempt(risky)(0) !! 2
    println(a + b)
    let unused = attempt(risky)(0)
    println(kind(attempt(() => add(risky(0), 1))()))
    println(kind(attempt(() => add(risky(4), 1))()))
    println('end')
    return 0
}
