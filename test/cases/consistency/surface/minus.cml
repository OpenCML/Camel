/**
 * `-` and `+` between two operands are the binary operators whatever the spacing. The lexer
 * used to take the sign into a number that follows, so `a-1` was `a` followed by the literal
 * -1: `let b = a-1` bound `b` to `a` and dropped the -1 without a diagnostic.
 */
func fib(n: int): int {
    return if n <= 1 then n else fib(n-1) + fib(n -2)
}

func neg(x: int): int { return 0 - x }

func main(): int sync {
    let a = 3
    let b = a-1
    println(b)
    println(a -1, a- 1, a - 1, 3-1, 3 -1, a+1, a +1, 3+1)
    println(a - -1, a--1, a-(-1), a+-1, a*-2, 2*-3)
    println(fib(10), fib(a+2), fib(a-1))
    // A sign directly before a number is the sign of the literal.
    println(-1, +1, - 1, -a, -1.5, +2.5, -0x10, -0b11, -010)
    println([-1, +2, a-1], (a, -1), { k: -1 })
    println(-9223372036854775808, 9223372036854775807, -9223372036854775807-1)
    println(1.5e-2, 2.5e+3, 1e3, 1.0e-2-1.0e-2)
    println(1-2-3, 1 - 2 - 3, 10-2*3, (10-2)*3, 2.5-0.5)
    // The literal -2 is one operand: `-2->neg` passes -2; `-a->neg` negates the result.
    println(-2->neg, -a->neg, -2 ^ 2, -a ^ 2)
    let xs = [10, 20, 30]
    println(xs[a-1], xs[a-3], xs[-1+a], len(xs)-1)
    var v = 5
    v -= 1
    println(v)
    v=-1
    println(v, v-1, v>-2, v<-2, v==-1, v!=-1)
    let m = match v {
        case -1 => 'minus one'
        case 1 => 'one'
        case _ => 'other'
    }
    println(m)
    let f = (x: int): int => x-1
    println(f(1), f(-1), [1, 2, 3]->map<(x: int): int => x-1>)
    return 0
}
