/**
 * int(nan): NaN is not a number an integer can hold.
 */
module float_nan_to_int

func conv(x: float): int { return int(x) }
func mul(a: float, b: float): float { return a * b }

func main(): int sync {
    let inf = mul(1.0e308, 10.0)
    println(conv(2.5))
    println(conv(inf - inf))
    println('not reached')
    return 0
}
