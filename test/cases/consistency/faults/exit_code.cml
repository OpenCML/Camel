/**
 * exit(3) in a function, after output: the output is there, nothing after it runs, the process
 * exit code is 3.
 */
module exit_code

import { exit } from process

func stop(code: int): int sync {
    println('stopping')
    exit(code)
    println('not reached in stop')
    return 0
}

func main(): int sync {
    println('before')
    stop(3)
    println('not reached')
    return 0
}
