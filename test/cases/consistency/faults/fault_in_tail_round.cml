/**
 * A fault in round 501 of a tail-recursive loop: DivisionByZero at the division, whatever the
 * back end does to run the loop.
 */

func spin(i: int, n: int, acc: int): int {
    return if i > n then acc else spin(i + 1, n, acc + 1000 / (500 - i))
}

func main(): int sync {
    println(spin(0, 400, 0))
    println(spin(0, 1000, 0))
    println('not reached')
    return 0
}
