/**
 * A slice whose end is past the end of the array, the bounds not known at compile time.
 */
module slice_out_of_range

func head(xs: int[], n: int): int[] { return xs[0:n] }

func main(): int sync {
    let xs = [10, 20, 30]
    println(head(xs, 2))
    println(head(xs, 7))
    println('not reached')
    return 0
}
