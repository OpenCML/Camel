/**
 * A foreach whose closure writes a captured var and faults at the fourth element: the three
 * writes before it are visible in what was printed.
 */

func main(): int sync {
    var total = 0
    0..8->foreach<sync (x: int) => sync {
        total = total + 12 / (3 - x)
        println(total)
    }>
    println('not reached')
    return 0
}
