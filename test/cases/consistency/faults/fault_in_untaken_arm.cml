/**
 * A faulting expression in the arm that is not taken never runs, also when both arms are
 * written with constants.
 */
module fault_in_untaken_arm

func safe(a: int, b: int): int {
    return if b == 0 then 0 else a / b
}

func main(): int sync {
    println(safe(10, 0))
    println(safe(10, 5))
    println(range(0, 4)->map<(b: int): int => safe(12, b)>)
    return 0
}
