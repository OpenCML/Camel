/**
 * Output written by a foreach and by sync calls before a fault in a later map: every line
 * written before the fault is on standard output, complete and in order.
 */

func inv(x: int): int { return 60 / (x - 5) }

func main(): int sync {
    (0..20)->foreach<(i: int) => sync { println('line', i) }>
    println('before the map')
    let ys = (0..8)->map<inv>
    println(ys)
    println('not reached')
    return 0
}
