/**
 * A file written before a fault is complete on disk after the program has stopped. The path
 * comes from the environment so that every back end writes its own file.
 */

import { write_text, read_text, mkdirs } from fs
import { get_env } from env

func main(): int sync {
    let dir = get_env('CAMEL_TEST_DIR') ?? ''
    let _ = dir->mkdirs
    let path = dir + '/' + (get_env('CAMEL_TEST_FILE') ?? '')
    let _ = 'first version'->write_text<path>
    let _ = 'complete content, 28 bytes.\n'->write_text<path>
    println(len(path->read_text !! ''))
    let z = 0
    println(1 / z)
    let _ = 'not reached'->write_text<path>
    return 0
}
