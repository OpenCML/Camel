/**
 * exit(0) from a nested call: a successful end, with what was printed before it and nothing
 * after it, whatever main would have returned.
 */

import { exit } from process

func deep(n: int): int sync {
    if n == 0 then sync { exit(0) }
    println('level', n)
    return deep(n - 1) + 1
}

func main(): int sync {
    println(deep(3))
    println('not reached')
    return 7
}
