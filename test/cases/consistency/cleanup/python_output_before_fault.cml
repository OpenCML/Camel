/**
 * Output printed by Python through the bridge before a fault of the program: Python buffers
 * its standard output, and the interpreter must be shut down (and flush it) on the way out.
 */

import { import_module, attr, call, eval, to_py, PyObject } from python

// A Python call is an error value; these programs expect every call to succeed.
func must(r: PyObject!): PyObject {
    return match r {
        case error e => fail<'InvalidArgument'>(e.message)
        case v => v
    }
}

func wrap::<T>(x: T): PyObject {
    return must(to_py(x))
}

func say(text: string): void sync {
    let print = must(import_module('builtins')->attr<'print'>)
    let _ = [wrap(text)]->call<print>
}

func main(): int sync {
    println('camel 1')
    say('python 1')
    let held = eval('[1, 2, 3]') !! wrap(0)
    println('camel 2')
    say('python 2')
    let z = 0
    println(1 / z)
    println('not reached')
    return 0
}
