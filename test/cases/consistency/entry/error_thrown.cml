/**
 * An error value made by `throw` reaches the exit of `main` without being handled: it is
 * reported on standard error, at the place it was made, and the exit code is not zero.
 */
module error_thrown

func check(x: int): int! {
    if x < 0 then {
        throw error('Negative', 'the argument is negative')
    } else {
        return x
    }
}

func main(): int! sync {
    println('before')
    return check(-1)
}
