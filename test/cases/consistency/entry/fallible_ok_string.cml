/**
 * `main` declared `string!` that returns a value: the value is the result, printed like a
 * `string` result.
 */

func greet(name: string): string! {
    if name == '' then {
        return error('Empty', 'no name')
    } else {
        return 'hello ' + name
    }
}

func main(): string! sync {
    return greet('camel')
}
