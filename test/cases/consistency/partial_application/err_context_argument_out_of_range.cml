/**
 * an element of a composite literal bound as a context argument is a position
 * with an expected type too: `at<[1.0, 1e40]>` with `with <xs: f32[]>` is refused at the
 * element, quoting it as written (`1e40`), not at the whole literal and not as `NoMatching`.
 */

with <xs: f32[]>
func at(i: int): f32 { return xs[i] }

func main(): int sync {
    let a = at<[1.0, 1e40]>
    println(a(0))
    return 0
}