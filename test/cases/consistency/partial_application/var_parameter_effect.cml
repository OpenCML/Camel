/**
 * Both helpers bind a `var` context parameter with `add<t>`, and a partial application cannot bind
 * one (design principles 3.5, the author's ruling of 2026-11-15) -- the function value has no call
 * of its own to write the value back to. Refused at each binding, `guarded`'s and `ignored`'s; the
 * cell is the `var t` of the body that binds it, which is the shape a local cell takes.
 *
 * This source used to pin what a value that captured the cell did: `g(1)` recorded as a write of
 * `t`, the call running inside a sync block, the never-executed warning outside one. That reading is
 * retired with the binding it needed; the source stays as the refusal's own example.
 */

with <var total: int>
func add(x: int): int sync {
    total = total + x
    return total
}

/// 1: `t` is 0 before the call and 1 after it.
func guarded(): int sync {
    var t = 0
    let g = add<t>
    let before = t
    g(1)
    let after = t
    return before * 10 + after
}

/// 0: the call is outside a sync block and its result is taken by nothing.
func ignored(): int {
    var t = 0
    let g = add<t>
    g(1)
    return t
}

func main(): int sync {
    println(guarded(), ignored())
    return 0
}