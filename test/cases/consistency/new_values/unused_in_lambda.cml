/**
 * The old way of filling a captured variable in a foreach: the statement `out->append<i>`
 * inside the element function is the error, with the rebinding as the fix.
 */
module unused_in_lambda

func main(): int sync {
    var out: int[] = []
    range(0, 3)->foreach<(i: int) => sync {
        out->append<i>
        return null
    }>
    println(out)
    return 0
}
