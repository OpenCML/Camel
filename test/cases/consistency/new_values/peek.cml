/**
 * Reads of an array variable between appends (design principles 11.3; Builder::
 * markNonRetainingReads). A read whose value only goes to an operation that cannot keep the
 * array (`len`, an element of an int[], `==`, `format`) leaves the variable's mark set, so the
 * next `acc = acc->append<v>` appends in place; a read that can keep it (bound to a name, an
 * element that is itself an array, an argument of a call) clears the mark, and what it gave
 * stays as it was. Expected output:
 *   1 2 [1, 2] [1, 2, 3] 2
 *   1 [1, 2, 3, 4] 4 true
 *   [1] [[1], [2], [3]]
 *   [5, 6] 2 [5, 6, 7]
 */

func size_of(xs: int[]): int { return len(xs) }

func main(): int sync {
    var acc: int[] = []
    acc = acc->append<1>
    let n0 = len(acc)                 // cannot keep the array
    acc = acc->append<2>
    let n1 = len(acc)
    let s = acc                       // bound: keeps it
    acc = acc->append<3>
    println(n0, n1, s, acc, len(s))
    let e = acc[0]                    // an int: cannot keep it
    acc = acc->append<4>
    let same = acc == [1, 2, 3, 4]
    println(e, acc, '{}'->format<len(acc)>, same)

    var grid: int[][] = [[1]]
    grid = grid->append<[2]>
    let row = grid[0]                 // an array: kept
    grid = grid->append<[3]>
    println(row, grid)

    var xs: int[] = [5]
    xs = xs->append<6>
    let k = size_of(xs)               // a call: kept
    let before = xs
    xs = xs->append<7>
    println(before, k, xs)
    return 0
}
