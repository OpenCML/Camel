/**
 * The element function of `foreach`, written in place, gives values `foreach` drops: its
 * body's last statement `out->append<i>` is the error UnusedPureResult (block body and
 * expression body).
 */
module dropped_foreach_lambda

func main(): int sync {
    var out: int[] = []
    0..3->foreach<(i: int) => sync {
        out->append<i>
    }>
    0..3->foreach<(i: int) => out->append<i>>
    println(out)
    return 0
}
