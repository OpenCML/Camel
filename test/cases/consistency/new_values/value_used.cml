/**
 * A block whose value is used is not reported: the body of a function that returns the last
 * statement's value, a `map` element function, an arm of an `if` with `else`.
 * Expected output: [1, 2] [[0], [1]] [3]
 */
module value_used

func plus_two(xs: int[]): int[] {
    xs->append<2>
}

func main(): int sync {
    let rows = range(0, 2)->map<(i: int): int[] => [i]>
    let picked = if len(rows) > 5 then [9] else rows[1]->append<2>->slice<1, 2>->append<3>->slice<1, 2>
    println(plus_two([1]), rows, picked)
    return 0
}
