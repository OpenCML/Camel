/**
 * The exporting half of `decorated_overloads_export`: a name declared as a decorated function
 * and as a plain function of the same name, exported. The name stands for both, so the module
 * that imports it receives both.
 */
module lib

export func twice(f: (x: int) => int): (x: int) => int {
    return (x: int): int => {
        return f(f(x))
    }
}

@twice
export func bump(x: int): int { return x + 1 }

export func bump(x: float): float { return x + 0.5 }