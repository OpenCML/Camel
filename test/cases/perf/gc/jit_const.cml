/**
 * Worst case of what the generational collector costs under std::jit: a hot self-recursive
 * function whose graph holds an object constant (the string it returns). After std::opt::inline it is
 * one graph; std::jit compiles it with mark-sweep and leaves it to the interpreter when objects
 * move, because compiled code would contain the address of the constant. No allocation.
 */
module jit_const

func pick(n: int, a: string): string {
    return if n < 2 then 'leaf' else pick(n - 1, pick(n - 2, a))
}

func main(n: int): int sync {
    println(pick(n, 'x'))
    return 0
}
