/// A `bf16` and an `f16` tensor in a `#gpu` scope: the type gate reads the element type and its two
/// bytes, so the plan no longer reports `unresolved_type` for it -- and what the device path has no
/// kernel for is a two-byte element, which the plan says as `device_element_kernel_missing`. The
/// reason names the device because the host half does compute it: the core's own values, and the host
/// serial executor that runs the same kernel body one element at a time. So the same program reads
/// two ways: a run without a device (`--devices cpu`) keeps the scope and prints the values, and a
/// run with one refuses the scope and says the device has no kernel for the element. The reading
/// separates "the device cannot read the type" from "the device has no kernel for it", which are two
/// different repairs.

import { sum } from tensor
import { regions } from tiles

#gpu
func double_bf16(x: bf16[3]): bf16[3] {
    return x * 2.0
}

#gpu
func double_f16(x: f16[3]): f16[3] {
    return x * 2.0
}

func main(): int sync {
    println(regions<double_bf16>())
    println(regions<double_f16>())
    let halves: bf16[3] = [0.5, -1.5, 2.0]
    let narrows: f16[3] = [0.5, -1.5, 2.0]
    println(sum(double_bf16(halves)), sum(double_f16(narrows)))
    return 0
}