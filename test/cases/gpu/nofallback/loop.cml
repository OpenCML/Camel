/// (g) A loop written in a `#gpu` scope is a segment too (GPU design 2.5): the LOOP node keeps
/// its condition and its body, so the rounds run where the loop runs instead of falling to the
/// host because the loop is a statement. `repeat_host` is the same program without the tag.
module gpu_nofallback_loop

import { reshape, sum } from tensor
import { regions } from tiles

#gpu
func repeat(x: f32[3]): f32[3] sync {
    let y = loop a = x for k in [1, 2] do a * 2.0
    return y
}

func repeat_host(x: f32[3]): f32[3] sync {
    let y = loop a = x for k in [1, 2] do a * 2.0
    return y
}

func main(): int sync {
    println(regions<repeat>())
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    println(sum(repeat(x)))
    println(sum(repeat_host(x)))
    return 0
}