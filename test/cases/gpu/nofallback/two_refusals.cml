/// (h) A scope is one promise, and the compiler answers for it once (GPU design 2.4): the two
/// operators this scope cannot run are reported together, each with its own reason. `step` is
/// tagged, so the untagged `helper` it calls is reached by the scope and both of its operators
/// join the device unit -- `tanh` has no device implementation in any module, and the matrix
/// product has one that refuses this shape.

import { reshape, sum, tanh } from tensor

#gpu
func step(a: f32[2, 2], b: f32[2]): f32[2] {
    helper(a, b)
}

func helper(a: f32[2, 2], b: f32[2]): f32[2] {
    tanh(a @ b)
}

func main(): int sync {
    let a = reshape([1.0, 2.0, 3.0, 4.0] as f32[], [2, 2])
    let b = reshape([1.0, 2.0] as f32[], [2])
    println(sum(step(a, b)))
    return 0
}
