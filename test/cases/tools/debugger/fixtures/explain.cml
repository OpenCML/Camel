// A run whose record the debugger is asked to read, made by the program itself so both the
// library and the debugger answer about the same record. `f` and `g` are the only functions a
// rule can match: no other function here holds `x + 0` or `x * 0`, so the proof counts the
// program's own code and not this module's (the same rule explain_pass.cml follows).

import { Graph, Node, NodeKind, Program, current, graphs, kind, name, nodes } from graph
import { Rule, Run, explain, why_not, run } from rewrite

rule zero_to_one(x: int) { x + 0 => x + 1 }
rule mul_zero(x: int) { x * 0 => 0 }

func f(x: int): int {
    return x + 0
}

/// A function no rule matches: the value `why_not` is asked about, so its answer is the rule's
/// own reason and not "another rule fired here".
func g(x: int): int {
    return x + 1
}

func nodesOf(p: Program, function: string): Node[] {
    let found = graphs(p)->filter<(g: Graph): bool => name(g) == function>
    return nodes(found[0])
}

/// The one operation of `function`: the value a chain starts from or reaches, and the value
/// `why_not` reads for a rule that cannot match it.
func operOf(p: Program, function: string): Node {
    let ops = nodesOf(p, function)->filter<(n: Node): bool => kind(n) == NodeKind::Oper>
    return ops[0]
}

/// The run, the value it started from and the values it produced are parameters here, so every
/// one of them is a name of this frame when the program stops inside it.
func show(r: Run<Program>, before: Node, failing: Rule): int sync {
    let after = operOf(r.result, 'f')
    let other = operOf(r.result, 'g')
    let chain = match explain(r, before, after) {
        case error e => sync { println(e); 0 }
        case proof => sync { println(proof); 0 }
    }
    let reason = match why_not(r, failing, other) {
        case error e => sync { println(e); 0 }
        case text => sync { println(text); 0 }
    }
    println(f(5))                       // mark:stop
    return chain + reason
}

func main(): int sync {
    let p = current()
    let before = operOf(p, 'f')
    let outcome = p->run<[zero_to_one], explain: true>
    return match outcome {
        case error e => sync {
            println(e)
            1
        }
        case r => show(r, before, mul_zero)
    }
}