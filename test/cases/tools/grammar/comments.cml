#!/usr/bin/env camel
/**
 * Documentation block comment
 * with 'quotes' and // slashes inside.
 */

// line comment with "a string" and /* a block opener
let a = 1 // trailing comment
/* block comment on one line */
let b = /* inline */ 2
/*
 * multi-line block comment
 * let c = 3
 */
let s = '// not a comment'
let t = "/* not a comment */"
let d = 4 // trailing comment; '#' now opens a tag, not a comment
/**/
let e = 5
