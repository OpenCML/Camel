// Every keyword of the lexer in a position the parser accepts it in, where there is one.
module keywords

import { now } from time
import os
import math_tools from .local.tools
import os as system
export { helper }
using namespace std::io

let immutable = 1
var mutable = 2
export let shared_value = 3

type Alias = int
inner type Handle = 'handle'
outer type Raw = string

func plain(x: int): int {
    return if x > 0 then x else 0 - x
}

sync func effect(var target: int) {
    wait target += 1
}

macro func early(n: int): int {
    return n * 2
}

atomic shared func marked(): void {
    return null
}

inner func builtin_impl(x: int): int {
    return x
}

func control(dir: string, xs: int[]): int! {
    let picked = match dir {
        case 'w' => 1
        case 'a' | 'd' => 2
        case _ => 0
    }
    let squares = [x * x for x in xs if x > 1]
    let checked = picked as float
    let same = picked is int
    let kind: typeof picked = 4
    try {
        throw 'failed'
    } catch e: Error {
        throw e
    } finally {
        return picked
    }
}

func generic(x: typeas T, y: tag of T, z: Tensor<f32, const [constas n, 4]>): T {
    return x
}

// reserved by the lexer, used by no parser rule (a syntax error)
enum keyof
