// Every keyword of the lexer in a position the parser accepts it in, where there is one.
// `inner`, `outer`, `atomic`, `shared`, `is`, `of`, `keyof`, `try`, `catch` and `finally` are
// not keywords: they are ordinary names, so they appear
// below as values.

import { now } from time
import os
import math_tools from .local.tools
import os as system
export { helper }
using namespace std::io

let immutable = 1
var mutable = 2
export let shared_value = 3

type Alias = int
type Handle = 'handle'
type Raw = string
type Shape = enum { Circle(float), Rect { w: float, h: float }, Empty }

let inner = 4
let outer = 5
let atomic = 6
let shared = 7

func plain(x: int): int {
    return if x > 0 then x else 0 - x
}

func effect(var target: int) {
    target += 1
}

func control(dir: string, xs: int[]): int! {
    let picked = match dir {
        case 'w' => 1
        case 'a' | 'd' => 2
        case _ => 0
    }
    let squares = [x * x for x in xs if x > 1]
    let checked = picked as float
    let kind: typeof picked = 4
    let is = 8
    let of = 9
    let keyof = 10
    let try = 11
    let catch = 12
    let finally = 13
    throw 'failed'
}

func generic::<T>(x: T, y: T, z: f32[..]): T {
    return x
}