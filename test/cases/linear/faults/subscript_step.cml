/**
 *  A subscript slice with a step other than 1 takes every step-th element. Until the strided
 * views the result is a copy, but the elements are the same on every back end (design principles
 * 5.4). A negative step runs backwards; an omitted start is the last element and an omitted end
 * the position before the first.
 */
module subscript_step

func every(xs: int[], a: int, b: int, s: int): int[] {
    return xs[a:b:s]
}

func main(): int sync {
    let xs = [1, 2, 3, 4, 5]
    println(every(xs, 0, 5, 2))
    println(every(xs, 4, 0, -2))
    println(xs[:: -1])
    return 0
}
