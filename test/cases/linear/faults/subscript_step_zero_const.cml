/**
 * A subscript slice whose step is the constant 0 takes no element at all, so it is refused where
 * the step is written (design principles 5.4), as the step of a range is (4.2).
 */

func main(): int sync {
    let xs = [1, 2, 3, 4, 5, 6]
    println(xs[0:6:0])
    println('not reached')
    return 0
}