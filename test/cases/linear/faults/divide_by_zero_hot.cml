/**
 * Integer division by zero in a function the JIT compiles (pure arithmetic and self-recursion,
 * already run once with a nonzero divisor): the located DivisionByZero of the interpreters at
 * the division (line 9, column 28), not a hardware exception.
 */

func f(a: int, b: int): int {
    return if a < 2 then a / b else f(a - 1, b) + a / b
}

func main(): int sync {
    println(f(30, 3))
    let z = 0
    println(f(30, z))
    println('not reached')
    return 0
}
