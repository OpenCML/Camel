/**
 * The smallest integer divided by -1: the quotient does not fit, and the machine's division
 * traps on it. Every back end gives the negation with wraparound (the smallest integer again)
 * and 0 for the remainder, not SIGFPE; `f` is what the JIT compiles after std::inline.
 */
module divide_min_by_minus_one

func f(a: int, b: int, n: int): int {
    return if n <= 0 then a / b else f(a, b, n - 1)
}

func main(): int sync {
    let h = 4611686018427387904
    let m = (0 - h) * 2
    let d = 0 - 1
    println('quotient {} {}'->format<f(m, 1, 3), f(m, d, 3)>)
    println('remainder {}'->format<m % d>)
    println('after')
    return 0
}
