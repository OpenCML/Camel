/**
 * An array index past the end is IndexOutOfRange at the index expression (line 7, column 44), with the
 * index and the length in the message, on every back end.
 */

func at(xs: int[], i: int): int { return xs[i] }

func main(): int sync {
    let xs = [1, 2, 3]
    println(at(xs, 1))
    println(at(xs, 5))
    println('not reached')
    return 0
}
