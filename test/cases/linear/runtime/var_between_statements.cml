/**
 * A `var` declared and read inside a `sync` body is not a statement of the chain: the effect
 * statements around it all run, in the order they are written.
 */
module var_between_statements

func read_twice(): int sync {
    var a: int = 1
    println(a)
    println(a + 1)
    return 0
}

func declared_first(): int sync {
    var x = 0
    println(1)
    x = 1
    println(2)
    println(x)
    return 0
}

func declared_last(): int sync {
    println(1)
    println(2)
    var y = 5
    y = y + 1
    println(y)
    return 0
}

func three(): int sync {
    var a: int = 1
    println(a)
    println(a + 1)
    println(a + 2)
    return 0
}

func nested(): int sync {
    var a: int = 1
    println(a)
    sync {
        println(a + 1)
        println(a + 2)
    }
    return 0
}

func main(): int sync {
    read_twice()
    declared_first()
    declared_last()
    three()
    nested()
    return 0
}
