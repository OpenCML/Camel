
// Non-tail recursion is limited to 1000 open calls by default on every back end. depth(200) fits;
// depth(1200) stops with MaxRecursionDepthExceeded at the recursive call, after what ran before it.
func depth(n: int): int {
    return if n == 0 then 0 else 1 + depth(n - 1)
}

func main(): int sync {
    println(depth(200))
    println(depth(1200))
    println('not reached')
    return 0
}
