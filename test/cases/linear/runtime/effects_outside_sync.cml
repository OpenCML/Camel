module effects_outside_sync

// Effectful calls outside a `sync` block (docs/design-principles.cn.md 3.1;
// docs/technical/18_sync_control_semantics.md section 2.2). Only the lines marked KEPT are
// printed, on every scheduler. All cases are the language rule except `nested`, which is an
// open question (section 2.5 there) whose current behaviour is recorded here.

// A statement whose result is unused, in a function whose body is not a `sync` block: the call
// is not connected to the function's exit and is not in the graph. A `wait` on the call and a
//  prefix `sync func` used to be recorded beside this case; both are retired (item 5), and a
// body that is not a sync block is what is left.
func plain(x: int): int {
    println('DROPPED plain')
    return x + 1
}

// Open question: a nested `sync` block orders its statements among themselves, but its tail
// is not connected to the exit of the enclosing non-sync body either.
func nested(x: int): int {
    sync {
        println('DROPPED nested 1')
        println('DROPPED nested 2')
    }
    return x + 1
}

// Suffix spelling: the body is a `sync` block.
func suffix(x: int): int sync {
    println('KEPT suffix')
    return x + 1
}

// An effect whose result is the function's result is on the data path.
func returned(x: int): void {
    println('DROPPED returned first')
    return println('KEPT returned')
}

func main(): int sync {
    println('KEPT main start')
    let a = plain(1) + nested(1) + suffix(1)
    returned(1)
    println(a)
    println('KEPT main end')
    return 0
}