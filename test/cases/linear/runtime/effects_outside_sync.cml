// Effectful calls outside a `sync` block (docs/design-principles.cn.md 3.1; the author's ruling of
// 2026-11-15). Every line of this case prints now, on every scheduler: a write to a resource
// outside the program is used by the region it is written in, so a call whose result nobody takes
// still runs, `sync` body or not.
//
// The nested `sync` block used to be an open question (docs/technical/18_sync_control_semantics.md
// section 2.5), recorded as "its tail is dropped with the enclosing non-sync body". A block is not
// a region the program chooses to run or not, so it is no longer a question: 3.1 answers it.

// A statement whose result is unused, in a function whose body is not a `sync` block.
func plain(x: int): int {
    println('plain')
    return x + 1
}

// A nested `sync` block: it orders its own statements, and its writes run with the body.
func nested(x: int): int {
    sync {
        println('nested 1')
        println('nested 2')
    }
    return x + 1
}

// Suffix spelling: the body is a `sync` block.
func suffix(x: int): int sync {
    println('suffix')
    return x + 1
}

// An effect whose result is the function's result is on the data path.
func returned(x: int): void {
    println('returned first')
    return println('returned')
}

func main(): int sync {
    println('main start')
    let a = plain(1) + nested(1) + suffix(1)
    returned(1)
    println(a)
    println('main end')
    return 0
}