/**
 * A read of a variable stays before later writes made by a callee, also when the only thing
 * that ordered the call after the read is an argument the callee does not use.
 * `snapshot` is read after the first write; `ignores` takes a value computed from the
 * snapshot, ignores it, and writes the variable. After inlining, the write inside `ignores`
 * used to be free to run before the read (std::opt: the snapshot came out as the
 * final value of the variable).
 */
module var_read_before_callee_write
import { Tensor, reshape, sum } from tensor

func ignores(x: Tensor, var c: int): int sync {
    c += 5
    return 1
}

func steps(i: int, n: int, x: Tensor, var c: int): Tensor sync {
    return if i >= n then x else sync {
        c += 1
        let fresh = reshape([0.5, 0.5], [2])
        let r = steps(i + 1, n, fresh, c)
        r
    }
}

func f(var c: int): int sync {
    c += 1
    let snapshot = c + 0
    let t = reshape([1.0, 2.0], [2])
    let r = ignores(t, c)
    return snapshot * 100 + r
}

func g(var c: int): float sync {
    c += 1
    let snapshot = c + 0
    let t = reshape([1.0, 2.0], [2])
    let y = steps(0, 3, t, c)
    return sum(y) + float(snapshot % 4) * 100.0
}

func main(): int sync {
    var a = 0
    let x = f(a)
    println('f: {} counter {}'->format<x, a>)
    var b = 0
    let y = g(b)
    println('g: {} counter {}'->format<y, b>)
    return 0
}
