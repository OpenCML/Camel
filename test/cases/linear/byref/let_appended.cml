/**
 * An in-place operator (`append`) applied to a `let` array.
 * Rejected at compile time (docs/design-principles.cn.md 2.5, 2.6: a side effect
 * must be declared, and only a `var` can be changed).
 */
module let_appended

func main(): int sync {
    let xs = [1, 2]
    xs->append<3>
    println(xs)
    return 0
}
