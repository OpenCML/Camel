/**
 * `append` written as a statement on a `let` array. `append` returns a new array and changes
 * nothing (docs/design-principles.cn.md 2.12), so the statement does nothing: a compile-time
 * error (UnusedPureResult). It used to be refused because `append` changed its argument in
 * place and `xs` is not a `var` (2.5, 2.6).
 */
module let_appended

func main(): int sync {
    let xs = [1, 2]
    xs->append<3>
    println(xs)
    return 0
}
