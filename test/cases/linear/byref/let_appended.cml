/**
 * `append` written as a statement on a `let` array. `append` returns a new array and changes
 * nothing (docs/design-principles.cn.md 11.3), so the statement does nothing: a compile-time
 * error (UnusedPureResult). It used to be refused because `append` changed its argument in
 * place and `xs` is not a `var` (3.5).
 */

func main(): int sync {
    let xs = [1, 2]
    xs->append<3>
    println(xs)
    return 0
}
