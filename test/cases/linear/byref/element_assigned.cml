/**
 * A store into an element of a `var` array: the whole variable is rebound to the array with
 * that element changed (docs/design-principles.cn.md 3.5, 6.11). Whether the update reuses the
 * storage of the array is decided for the update node when the execution plan is built, which
 * asks the array's own count where it cannot prove the old value has no other observer; what
 * the program sees is the array with that element changed.
 */
module element_assigned

func main(): int sync {
    var arr = [1, 2, 3]
    arr[0] = 9
    println(arr)
    return 0
}