/**
 * A store into an element of a `var` array: the whole variable is rebound to the array with
 * that element changed (docs/design-principles.cn.md 3.5, 6.11). An array that is not shared
 * is changed in place; `arr` itself is not copied.
 */
module element_assigned

func main(): int sync {
    var arr = [1, 2, 3]
    arr[0] = 9
    println(arr)
    return 0
}