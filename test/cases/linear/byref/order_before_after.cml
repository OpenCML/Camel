/**
 * `A(i); modify(i); B(i)` in a sync body (docs/language/04_execution_model.md 4.4): the
 * compiler orders A -> modify -> B by the writing order of the body. A observes the old value
 * of i, B the new one, and A has completed before modify starts. Expected output:
 *   A 1
 *   modify
 *   B 2
 *   10020    a * 1000 + b with a = 10 * 1, b = 10 * 2
 * Any other order prints something else: A after modify gives `A 2` and 20020, B before modify
 * gives `B 1` and 10010, and the three lines change places.
 */

func before(x: int): int sync {
    println('A {}'->format<x>)
    return x * 10
}

func after(x: int): int sync {
    println('B {}'->format<x>)
    return x * 10
}

func modify(var x: int): int sync {
    println('modify')
    x += 1
    return 0
}

// A sync body: the three calls are ordered by the writing order of its statements.
func run(): int sync {
    var i = 1
    let a = before(i)
    modify(i)
    let b = after(i)
    return a * 1000 + b
}

func main(): int sync {
    println(run())
    return 0
}
