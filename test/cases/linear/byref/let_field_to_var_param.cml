/**
 * A field of a `let` struct passed to a `var` parameter.
 * Rejected at compile time: only a name bound by `var` denotes a mutable object
 * (docs/design-principles.cn.md 3.5).
 */

func bump(var x: int) {
    x += 1
}

func main(): int sync {
    let s = { x: 1, y: 2 }
    bump(s.x)
    println(s.x)
    return 0
}
