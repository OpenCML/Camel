/**
 * A `let` name passed to a `var` with-parameter.
 * Rejected at compile time: only a name bound by `var` denotes a mutable object
 * (docs/design-principles.cn.md 3.5).
 */
module let_to_var_with_param

with <var acc: int>
sync func add(n: int): int sync {
    wait acc += n
    return acc
}

func main(): int sync {
    let total = 0
    let r = add<total>(5)
    println(total)
    return 0
}
