// A `var` parameter read by a statement of the same `sync` block: the read is the place the block's
// chain has for that statement, so the statement follows it, and the write the block makes next
// follows the statements written before it (docs/design/effects/edges.cn.md 5.3, 5.5). The caller
// sees the write the block made.

func tally(var x: int): int sync {
    println("tally", x)
    x = x + 1
    println("after", x)
    return x
}

func main(): int sync {
    var n = 4
    println(tally(n))
    println(n)
    return 0
}