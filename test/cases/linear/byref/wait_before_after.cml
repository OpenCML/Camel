/**
 * `A(i); wait modify(i); B(i)` outside a sync block (docs/design-principles.cn.md 2.6): the
 * compiler orders A -> modify -> B. A observes the old value of i, B the new one, and A has
 * completed before modify starts. Expected output:
 *   A 1
 *   modify
 *   B 2
 *   10020    a * 1000 + b with a = 10 * 1, b = 10 * 2
 * Any other order prints something else: A after modify gives `A 2` and 20020, B before modify
 * gives `B 1` and 10010, and the three lines change places.
 */
module wait_before_after

func before(x: int): int sync {
    println('A {}'->format<x>)
    return x * 10
}

func after(x: int): int sync {
    println('B {}'->format<x>)
    return x * 10
}

func modify(var x: int): int sync {
    println('modify')
    wait x += 1
    return 0
}

// Not a sync block: only `wait` orders the three calls.
func run(): int {
    var i = 1
    let a = before(i)
    wait modify(i)
    let b = after(i)
    return a * 1000 + b
}

func main(): int sync {
    println(run())
    return 0
}
