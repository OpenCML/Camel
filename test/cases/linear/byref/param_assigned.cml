/**
 * Assignment to a parameter declared without `var`.
 * Rejected at compile time (docs/design-principles.cn.md 3.5: a side effect
 * must be declared, and only a `var` can be changed).
 */
module param_assigned

func f(x: int): int sync {
    x = 5
    return x
}

func main(): int sync {
    println(f(1))
    return 0
}
