/**
 * A `let` name bound from a `var` is immutable: it cannot be passed to a `var` parameter.
 * Rejected at compile time (docs/design-principles.cn.md 3.5: a side effect
 * must be declared, and only a `var` can be changed).
 */

func bump(var x: int) {
    x += 1
}

func main(): int sync {
    var c = 0
    let a = c
    bump(a)
    println(c)
    return 0
}
