/**
 * `wait` orders by the use of the variable, not by position (docs/design-principles.cn.md
 * 2.6): in `A(i + 1); wait modify(i)` the node that directly uses the value of `i` is `+`, so
 * `modify` is ordered after `+`. It is not ordered after `A`: A never touches `i`.
 *
 * run() is not a sync block. The value is the same whichever of `before` and `modify` runs
 * first, because `+` has read `i` before `modify` writes it:
 *   a = before(1 + 1) = 2, b = i after modify = 11, result 2011
 * The plan checks the two control edges on the graph dump (wait_direct_user.graph): `+ ->
 * modify` is present, `before -> modify` is absent.
 */
module wait_direct_user

func before(x: int): int {
    return x
}

sync func modify(var x: int): int sync {
    wait x += 10
    return 0
}

func run(): int {
    var i = 1
    let a = before(i + 1)
    wait modify(i)
    let b = i
    return a * 1000 + b
}

func main(): int sync {
    println(run())
    return 0
}
