/**
 * A function with a `var` parameter passed where a function type without `var` is expected.
 * Rejected at compile time (docs/design-principles.cn.md 3.5: a side effect
 * must be declared, and only a `var` can be changed).
 */
module var_function_as_value_function

sync func bump(var x: int) {
    wait x += 1
}

func call(f: (x: int) => void, v: int): int sync {
    f(v)
    return v
}

func main(): int sync {
    println(call(bump, 1))
    return 0
}
