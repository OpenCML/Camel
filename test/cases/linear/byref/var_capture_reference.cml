/**
 * The shapes this case used to pin as legal -- a closure that writes a name of the body around it,
 * so the write goes through to the outer variable -- are refused now: a closure holds the value the
 * name had when the closure was made, not the name (docs/design-principles.cn.md 3.5). A write
 * inside the closure has nowhere to go, and the compiler reports
 * `SemanticDiag::ClosureAssignsCapturedName` (0x03000213) at the written name.
 *
 * The case is the counter-example of that diagnostic: a nested `func`, a lambda that writes a `var`
 * parameter of the function around it, and a `foreach` element function, each writing a name of the
 * enclosing body. The three ways out the diagnostic names are: return the new value as the
 * closure's result and let the caller bind it; write the state as a loop's carried state
 * (`loop state = init while ... do step(state, ...)`) or a `fold`; or hold the state in a `Ref`
 * (`let r = ref(0)`, `get(r)`, `set(r, v)`) and let the closure capture the handle, which is a value.
 *
 * What is not here any more, and why:
 *
 *   - An `if` arm writing a `var` of the surrounding function is still legal (the arm is not a
 *     closure; the branch hands the new value on) and is pinned by `captured_write_order.cml`
 *     (`arm_then_read`, `arm_call_then_read`, `write_then_arm_read`, `arm_read_then_write`) and by
 *     `captured_write_graph.cml` (`arms`).
 *
 *   - A closure that only *reads* a local `var` is still legal, and it sees the value the name had
 *     when the closure was made. This file used to pin that shape twice -- `base` in the `map`
 *     lambda, `v` in `nested` -- but both closures also assigned the name, so the shape left with
 *     them. **No case pins it now.** `captured_write_graph.cml`'s `look()` reads a `var`, but a
 *     top-level one, which is the exempt class, not this one; `var_alias_captured.cml` has a
 *     closure that only reads, but it reads a `let`. Named here so that the next reader does not
 *     take this file for complete coverage of the legal half.
 */

func nested(): int sync {
    var v = 3
    func lift(by: int): int sync {
        v += by
        return v
    }
    let r = lift(5)
    return v
}

func through(var out: int): int sync {
    let add = func (x: int) => int sync {
        out += x
        return out
    }
    let a = add(1)
    let b = add(20)
    return b
}

func counted(): int sync {
    var total = 0
    [1, 2, 3]->foreach<func (x: int) sync {
        total += x
    }>
    return total
}

func main(): int sync {
    var o = 0
    println(nested())
    println(through(o))
    println(counted())
    println(o)
    return 0
}
