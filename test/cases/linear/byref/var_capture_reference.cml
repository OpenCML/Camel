/**
 * The shapes this case used to pin as legal -- a closure that writes a name of the body around it,
 * so the write goes through to the outer variable -- are refused now: a closure holds the value the
 * name had when the closure was made, not the name (docs/design-principles.cn.md 3.5). A write
 * inside the closure has nowhere to go, and the compiler reports
 * `SemanticDiag::ClosureAssignsCapturedName` (0x03000213) at the written name.
 *
 * The case is the counter-example of that diagnostic: a nested `func`, a lambda that writes a `var`
 * parameter of the function around it, and a `foreach` element function, each writing a name of the
 * enclosing body. The three ways out the diagnostic names are: return the new value as the
 * closure's result and let the caller bind it; write the state as a loop's carried state
 * (`loop state = init while ... do step(state, ...)`) or a `fold`; or hold the state in a `Ref`
 * (`let r = ref(0)`, `get(r)`, `set(r, v)`) and let the closure capture the handle, which is a value.
 *
 * What is not here any more, and why: an `if` arm writing a `var` of the surrounding function is
 * still legal (the arm is not a closure, the branch hands the new value on) and is pinned by
 * `captured_write_order.cml`; a closure that only reads a `var` is still legal -- it sees the value
 * the name had when it was made -- and is pinned by `var_alias_captured.cml` and
 * `captured_write_graph.cml`.
 */

func nested(): int sync {
    var v = 3
    func lift(by: int): int sync {
        v += by
        return v
    }
    let r = lift(5)
    return v
}

func through(var out: int): int sync {
    let add = (x: int): int => sync {
        out += x
        return out
    }
    let a = add(1)
    let b = add(20)
    return b
}

func counted(): int sync {
    var total = 0
    [1, 2, 3]->foreach<(x: int) => sync {
        total += x
    }>
    return total
}

func main(): int sync {
    var o = 0
    println(nested())
    println(through(o))
    println(counted())
    println(o)
    return 0
}
