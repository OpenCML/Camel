/**
 * A variable captured by an `if` arm or a lambda is captured by reference
 * (docs/design-principles.cn.md 3.5): a write inside goes through to the outer variable, and
 * the lambda sees later writes from outside. Expected output:
 *   5 1      written in an `if` arm; the arm's value
 *   0 0      the other arm leaves it alone
 *   1 1      a lambda called later writes the captured variable
 *   12 12    a write from outside is seen by the lambda, and its write outside again
 *   6        a lambda passed to foreach writes it once per element
 *   [11, 12, 13]  a lambda passed to map reads the variable as it is at the call. (It does not
 *                 write it: `map` may run its elements in parallel, and writes to one variable
 *                 from several of them are not ordered.)
 *   1 2 3    a lambda that outlives the function declaring the variable keeps it
 *   1 1      ... and each call of that function declares a new variable
 *   8        a nested function writes a variable of the enclosing function
 *   21       a captured var parameter: the write reaches the caller's variable
 */
module var_capture_reference

func pick(k: int): int sync {
    var c = 0
    let r = if k > 0 then sync {
        wait c += 5
        return 1
    } else 0
    println('{} {}'->format<c, r>)
    return r
}

func counter(): () => int sync {
    var n = 0
    return (): int => sync {
        wait n += 1
        return n
    }
}

func nested(): int sync {
    var v = 3
    sync func lift(by: int): int sync {
        wait v += by
        return v
    }
    let r = lift(5)
    return v
}

func through(var out: int): int sync {
    let add = (x: int): int => sync {
        wait out += x
        return out
    }
    let a = add(1)
    let b = add(20)
    return b
}

func main(): int sync {
    let a = pick(1)
    let b = pick(0)

    var c = 0
    let f = (): int => sync {
        wait c += 1
        return c
    }
    let r1 = f()
    println('{} {}'->format<r1, c>)
    wait c += 10
    let r2 = f()
    println('{} {}'->format<r2, c>)

    var total = 0
    [1, 2, 3]->foreach<(x: int) => sync {
        wait total += x
    }>
    println(total)

    var base = 0
    wait base += 10
    let shifted = [1, 2, 3]->map<(x: int): int => x + base>
    println(shifted)

    let next = counter()
    let n1 = next()
    let n2 = next()
    let n3 = next()
    println('{} {} {}'->format<n1, n2, n3>)
    let other = counter()
    let m1 = other()
    let fresh = counter()
    let m2 = fresh()
    println('{} {}'->format<m1, m2>)

    println(nested())

    var o = 0
    let r3 = through(o)
    println(o)
    return 0
}
