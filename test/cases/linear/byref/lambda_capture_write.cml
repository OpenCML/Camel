/**
 * A lambda bound to a name in the same function: the call site can see its body, so `f()` is
 * recorded as a write of the captured `c`, and the read written after it runs that write.
 *
 * The author's ruling of 2026-11-04 narrows the language reference's sentence about calls through
 * a function value (4.4): only a value whose body the call site cannot see -- passed as an
 * argument, obtained as a return value, stored in a container or in a structure and taken out
 * again -- recognises its side effects by its type alone. This case pins the other side of that
 * line: a `let`-bound lambda in the same function is tracked, and `c` is 1 (the author measured
 * `c=1` on v0.2.43). Plan linear.captured_writes, tests lambda_capture_write.*.
 */
func positive(): int {
    var c = 0
    let f = (): void => sync { c += 1 }
    f()
    return c
}

func main(): int sync {
    println(positive())
    return 0
}