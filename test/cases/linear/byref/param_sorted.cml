/**
 * An in-place operator (`sort`) applied to a parameter declared without `var`.
 * Rejected at compile time (docs/design-principles.cn.md 2.5, 2.6: a side effect
 * must be declared, and only a `var` can be changed).
 */
module param_sorted

import { sort } from algo

func f(xs: int[]): int[] sync {
    wait sort(xs)
    return xs
}

func main(): int sync {
    println(f([2, 1]))
    return 0
}
