/**
 * `sort` written as a statement on a parameter. `sort` returns a new array and changes
 * nothing (docs/design-principles.cn.md 11.3), so the statement does nothing: a compile-time
 * error (UnusedPureResult). It used to be refused because `sort` changed its argument in place
 * and `xs` is not declared `var` (3.5).
 */

import { sort } from array

func f(xs: int[]): int[] sync {
    sort(xs)
    return xs
}

func main(): int sync {
    println(f([2, 1]))
    return 0
}
