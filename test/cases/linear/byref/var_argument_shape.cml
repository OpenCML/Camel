/**
 * A `var` argument whose type the parameter does not accept both ways: `w` is declared
 * `f32[..]`, so the callee may write an array of any shape into the variable, and the variable
 * the call passes holds an `f32[]`, which cannot hold every shape. The call is refused where the
 * argument is written; a variable declared with the parameter's type is the repair
 * (docs/design-principles.cn.md 3.5, 5.1).
 */

func count(var w: f32[..], v: f32): int {
    return len(w)
}

func main(): int sync {
    var a: f32[] = [1.0, 2.0, 3.0]
    println(count(a, 0.0))
    return 0
}