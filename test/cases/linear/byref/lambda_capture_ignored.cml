/**
 * The same lambda with nothing written after the call that reads `c`: the write is not executed.
 *
 * The body writes `c` and then prints it, so a body that ran would print `1`; the program prints
 * only the `0` of `main`, which is how this case proves the write did not happen instead of only
 * asserting that a warning was reported. That report no longer exists: on the build this lane
 * measured the call runs and the body prints `1`, so this case and its plan entries are red and are
 * reported to the author rather than rewritten here. Plan linear.captured_writes, tests
 * lambda_capture_ignored.*.
 *
 * The state is a `Ref`: a closure cannot assign a name of the body around it (design principles
 * 3.5), while a handle is a value it may capture.
 */

import state

func ignored(): int {
    let c = state::ref(0)
    let f = (): void => sync {
        state::set(c, state::get(c) + 1)
        println(state::get(c))
    }
    f()
    return 0
}

func main(): int sync {
    println(ignored())
    return 0
}
