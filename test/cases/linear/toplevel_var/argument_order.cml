/**
 * Two uses of one resource in one expression happen in written order, arguments and operands from
 * left to right (design principles 3.3): a read of the variable written before a call that writes
 * it sees the value from before the call, whatever the variable is.
 *   100 110    a read, then the call that writes the top-level variable
 *   120 120    the call, then a read
 *   250        operands of +: the read, then the call
 *   1 2        a reference a closure writes
 *   10 11      a local variable passed to a var parameter
 *   1 2        a value read before a call through a function value, and a read after it
 *   [1, 2, 2]  the elements of an array literal, left to right
 *   (2, 3, 3)  a tuple literal
 *   3 4 4      the fields of a struct literal
 *
 * The two sub-cases a closure writes hold their state in a `Ref`: a closure cannot assign a name of
 * the body around it (design principles 3.5), while a handle is a value it may capture.
 */

import state

var cnt: int = 100
var lit: int = 1

func lit_step() => int sync {
    lit += 1
    return lit
}

func bump() => int sync {
    cnt += 10
    return cnt
}

func inc(var x: int) => int sync {
    x += 1
    return x
}

func main() => int sync {
    println(cnt, bump())
    println(bump(), cnt)
    println(cnt + bump())
    let c = state::ref(1)
    let step = func () => int sync {
        state::set(c, state::get(c) + 1)
        state::get(c)
    }
    println(state::get(c), step())
    var d = 10
    println(d, inc(d))
    let e = state::ref(1)
    let write_e = func () => int sync {
        state::set(e, state::get(e) + 1)
        state::get(e)
    }
    let before = state::get(e)
    write_e()
    println(before, state::get(e))
    println([lit, lit_step(), lit])
    println((lit, lit_step(), lit))
    let fields = { a: lit, b: lit_step(), c: lit }
    println(fields.a, fields.b, fields.c)
    return 0
}
