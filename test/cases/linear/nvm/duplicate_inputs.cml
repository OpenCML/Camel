/**
 * Verifies repeated use of the same SSA value across tuples, arrays, and calls does not alias or drop inputs during scheduling.
 */
module duplicate_inputs

func pair(x: int): (int, int) {
    return (x, x)
}

func double(x: int): int {
    return x + x
}

func main(): int sync {
    let x = 7
    let (a, b) = pair(x)
    let arr = [x, x]
    let y = double(x)
    'duplicate_inputs a={} b={} arr0={} arr1={} y={}'->format<a, b, arr[0], arr[1], y>->println
    return 0
}

