/**
 * Verifies a single decorator can wrap a function, capture a constant, and adjust the returned value at runtime.
 */
module decorator_single

with <delta: int>
func add_n(f: (x: int) => int): (x: int) => int {
    return (x: int): int => {
        return f(x) + delta
    }
}

@add_n<2>
func base(x: int): int {
    return x
}

func main(): int sync {
    let v = base(40)
    return if v == 42 then 0 else 1
}

