/**
 * Verifies builtin operators feeding branch conditions and arithmetic remain correctly ordered after JIT lowering.
 */

func pick(xs: int[]): int {
    let n = len(xs)
    let first = xs[0]
    return if n > 3 then first + n else first - n
}

func main(): int sync {
    let a = pick([4, 5, 6, 7])
    let b = pick([4, 5])
    'operator_branch_mix a={} b={}'->format<a, b>->println
    return 0
}

