/**
 * Verifies match-driven struct reconstruction on JIT, including field reads and rebuilt record values.
 */
module jit_struct_match

type Point = {
    x: int,
    y: int
}

func move(p: Point, dir: string): Point {
    return match dir {
        case 'up' => { x: p.x, y: p.y - 1 }
        case 'left' => { x: p.x - 1, y: p.y }
        case 'right' => { x: p.x + 1, y: p.y }
        case _ => { x: p.x, y: p.y + 1 }
    }
}

func main(): int sync {
    let p0 = { x: 4, y: 5 }
    let p1 = move(p0, 'up')
    let p2 = move(p1, 'right')
    let p3 = move(p2, 'down')
    'struct_match p1y={} p2x={} p3y={}'->format<p1.y, p2.x, p3.y>->println
    return 0
}

