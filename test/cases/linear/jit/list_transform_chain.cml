/**
 * Regression for chained map/slice/concat pipelines so JIT execution preserves list values through the full transform chain.
 */
module jit_list_transform

func main(): int sync {
    let xs = range(0, 8)
    let ys = xs->map<(x: int): int => {
        return x * x
    }>
    let zs = concat([100], ys->slice<2, 6>)
    'list_transform_chain ys_len={} ys3={} ys7={} zs_len={} zs0={} zs4={}'->format<len(ys), ys[3], ys[7], len(zs), zs[0], zs[4]>->println
    return 0
}

