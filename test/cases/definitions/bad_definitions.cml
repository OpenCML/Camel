// Definitions the core must refuse when it builds them (test::definitions, src/passes/test/
// definitions.h): each is declared there as the definition of a tensor operator.

import { softmax, abs } from tensor

/// Declared for tensor:exp: softmax's definition uses exp, so the two form a cycle.
export func exp_through_softmax(x: f32[..]): f32[..] {
    return softmax<-1>(x) + x
}

/// Declared for tensor:abs: reaches its own operator.
export func abs_itself(x: f32[..]): f32[..] {
    return abs(x)
}

/// Declared for tensor:neg, which has one operand.
export func two(x: f32[..], y: f32[..]): f32[..] {
    return x + y
}

/// Declared for tensor:sqrt, which is pure: this prints.
export func noisy(x: f32[..]): f32[..] sync {
    println(1)
    return x
}

/// Declared for tensor:log: generic, so not one graph.
export func generic::<T>(x: T): T {
    return x
}

let first_axis = 1

/// Declared for tensor:matmul: it reads a value of the module's top level, so its graph takes
/// its parameter and a capture, not exactly the declared parameters (task).
export func captured(x: f32[..]): f32[..] {
    return softmax<first_axis - 1>(x)
}

func default_axis(): int {
    return 1
}

/// The same shape with a value computed by a call (task): the capture is a top-level node
/// however the value is written, and a definition library has no root graph that could run it.
let call_axis = default_axis()

/// Declared for tensor:pow: it reads a module-level value computed by a call.
export func call_captured(x: f32[..], y: f32[..]): f32[..] {
    return (x ^ y) + softmax<call_axis - 1>(x)
}
