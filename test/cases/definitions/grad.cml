// The gradient of an operator (its own derivative rule, tensor's VJP) against the gradient
// autodiff takes through the operator's definition (tensor_definitions::<op>, the library imported
// directly; expanding the operator gives the same graph). They are different algorithms, so
// they agree within a tolerance, not bit for bit: each line says whether the relative
// difference sum(|g_op - g_def|) / sum(|g_op|) is below 1e-5.
import { grad } from autodiff
import { Tensor, new, sum, abs, softmax, log_softmax, mean, relu, sigmoid } from tensor
import tensor_definitions

func w(): Tensor<f32> { return new([[0.3, -1.2, 0.5, 2.0], [1.1, 0.4, -0.7, 0.2], [-0.5, 0.9, 1.3, -0.1]]) }

func op_softmax(x: Tensor<f32>): float { return sum(softmax(x, 1) * w()) }
func def_softmax(x: Tensor<f32>): float { return sum(tensor_definitions::softmax(x, 1) * w()) }
func op_softmax0(x: Tensor<f32>): float { return sum(softmax(x, 0) * w()) }
func def_softmax0(x: Tensor<f32>): float { return sum(tensor_definitions::softmax(x, 0) * w()) }
func op_log_softmax(x: Tensor<f32>): float { return sum(log_softmax(x, 1) * w()) }
func def_log_softmax(x: Tensor<f32>): float { return sum(tensor_definitions::log_softmax(x, 1) * w()) }
func op_mean(x: Tensor<f32>): float { return mean(x * w()) }
func def_mean(x: Tensor<f32>): float { return tensor_definitions::mean(x * w()) }
func op_relu(x: Tensor<f32>): float { return sum(relu(x) * w()) }
func def_relu(x: Tensor<f32>): float { return sum(tensor_definitions::relu(x) * w()) }
func op_sigmoid(x: Tensor<f32>): float { return sum(sigmoid(x) * w()) }
func def_sigmoid(x: Tensor<f32>): float { return sum(tensor_definitions::sigmoid(x) * w()) }

func compare(name: string, da: (x: Tensor<f32>) => Tensor, db: (x: Tensor<f32>) => Tensor, x: Tensor<f32>): int sync {
    let a = da(x)
    let b = db(x)
    let rel = sum(abs(a - b)) / sum(abs(a))
    println(format<name, if rel < 0.00001 then "ok" else "FAIL", rel>("{} {} {}"))
    return 0
}

func main(): int sync {
    let x: Tensor<f32> = new([[0.5, -1.0, 2.0, 0.25], [1.5, -0.75, 0.1, 3.0], [-2.0, 0.6, 1.2, -0.3]])
    compare("softmax", grad(op_softmax), grad(def_softmax), x)
    compare("softmax 0", grad(op_softmax0), grad(def_softmax0), x)
    compare("log_softmax", grad(op_log_softmax), grad(def_log_softmax), x)
    compare("mean", grad(op_mean), grad(def_mean), x)
    compare("relu", grad(op_relu), grad(def_relu), x)
    compare("sigmoid", grad(op_sigmoid), grad(def_sigmoid), x)
    return 0
}
