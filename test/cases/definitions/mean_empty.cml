// mean of a tensor without elements: the kernel and its expanded definition
// (sum and division in f64, one rounding into the element type, stdlib/tensor_definitions.cml)
// fault the same way, with DivisionByZero (design principles 7.1: a kernel agrees with its
// definition, faults included).
import { zeros, mean } from tensor

func main(): int sync {
    println(mean(zeros([2, 2])))
    println(mean(zeros([0, 4])))
    return 0
}
