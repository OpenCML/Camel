// `#remat` on a function is the same request as calling `remat(f)`: "I require this to appear" --
// recompute it where it is needed instead of carrying it there as a value. `g` carries the tag and `h`
// does not; both are cubics, so both lifts have one non-parameter residual (`x*x`) that only the mark
// can remove. The two readings differ in exactly that: `residuals=1 recompute=1` against
// `residuals=2`. The values are equal (27.0), which is the definition of "store less, compute again".
import rulesets.jvp
import { jvp, split } from transforms

#remat
func g(x: float): float {
    return x * x * x
}

func h(x: float): float {
    return x * x * x
}

func main(): int sync {
    let (fwd, lin) = split(jvp(g))
    let (fwd2, lin2) = split(jvp(h))
    let (_y, r0) = fwd(3.0)
    let (_y2, r1) = fwd2(3.0)
    println("tagged dx=", lin(r0, 1.0))
    println("plain dx=", lin2(r1, 1.0))
    return 0
}