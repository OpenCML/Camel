// `#remat` on a function is the same request as calling `remat(f)`: "I require this to appear" --
// recompute it where it is needed instead of carrying it there as a value. `g` carries the tag and `h`
// does not; both are cubics, so both lifts have one non-parameter residual (`x*x`) that only the mark
// can remove. The values are equal (27.0), which is the definition of "store less, compute again".
//
// The cut is asked with the closure ABI (author, 2026-11-02): `split(jvp(g))` **is** the forward
// function, and the pair `fwd(3.0)` answers is `(y, lin)` -- the linear map closes over the residuals
// itself, so no program names them. The earlier spelling destructured `split(jvp(g))` into `(fwd,
// lin)` and called `lin(residuals, seed)`, which was the binary-tuple ABI and read a function as a
// pair; `test/cases/transforms/split/split_forward_half.cml` is the author's own sample of the shape
// used here.
import rulesets.jvp
import { jvp, split } from transforms

#remat
func g(x: float): float {
    return x * x * x
}

func h(x: float): float {
    return x * x * x
}

func main(): int sync {
    let fwd = split(jvp(g))
    let fwd2 = split(jvp(h))
    let (_y, lin) = fwd(3.0)
    let (_y2, lin2) = fwd2(3.0)
    println("tagged dx=", lin(1.0))
    println("plain dx=", lin2(1.0))
    return 0
}