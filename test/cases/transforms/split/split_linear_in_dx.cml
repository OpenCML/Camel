// The backward half of split(reinterp<jvp>(g)) is LINEAR in the tangent direction, and that is what
// this case asserts: g(x) = x*x at x = 3 is the linear function dx -> 6·dx, so doubling the input
// doubles the output (dx = 2 gives 12) and zero gives zero (dx = 0 gives 0). Linearity is exactly
// "the input doubles, the output doubles"; a case that only reads dx = 1 cannot tell 6 + 6 from
// 2·6 + 1.
//
// The linear map is what the forward half hands back, closed over the residuals: it takes the
// direction alone (`lin(1.0)`, `lin(2.0)`, `lin(0.0)`). Before the closure ABI those three calls
// passed the residual value as a first argument; the three answers are the same.
import rulesets.jvp
import { jvp, split } from transforms

func g(x: float): float {
    return x * x
}

func main(): int sync {
    let fwd = split(jvp(g))
    let (_y, lin) = fwd(3.0)
    let once = lin(1.0)
    let twice = lin(2.0)
    let none = lin(0.0)
    println("dx1=", once)
    println("dx2=", twice)
    println("dx0=", none)
    println("doubles=", twice == once + once)
    return 0
}
