// A struct parameter whose member the body **names**: `g(qq: Point) = qq.a * 4.0 + qq.b` at
// qq = (2.0, 3.0). `jvp` alone answers 11.0 and 4.0 -- the lift is right -- and the cut is what used
// to lose the graph: a struct's member is read by name (`GCAccsKind::StructKey`) and the halves copy
// a member read by place, so the copy indexed a `Struct` as a `Tuple` at run time and the VM stopped
// at `idx < t->size()` ("Tuple index out of bounds", nodevm.cpp).
//
// The reading is the refusal, word for word: the construct (`a field of a struct, read by name
// (`.a`)`), the reason, and the position the program writes the body at. Nothing here is an internal
// error: the two halves number a tuple's places, a struct's member is named, and this is a shape the
// cut says it does not carry. `split_struct_port` is the same program without the field read, and it
// is cut.
import rulesets.jvp
import { jvp, split } from transforms

type Point = { a: float, b: float }

func g(qq: Point): float {
    return qq.a * 4.0 + qq.b
}

func main(): int sync {
    let p = { a: 2.0, b: 3.0 }
    let lifted = jvp(g)
    let (v, t) = lifted(p, { a: 1.0, b: 0.0 })
    println("lift value=", v, " tangent=", t)
    let fwd = split(lifted)
    let (value, lin) = fwd(p)
    println("forward y=", value)
    println("lin dp=", lin({ a: 1.0, b: 0.0 }))
    return 0
}