// The same function as split_forward_half, with only the backward half read out: g(x) = x*x,
// f = reinterp<jvp>(g), x = 3, dx = 1. The backward half is the linear map the forward half hands
// back, closed over the residuals it collected (r0 = 3), so it takes the tangent direction alone and
// gives the tangent: 2x·dx = 6.
//
// Before the closure ABI this case asserted the binary-tuple split: `lin(r0, 1.0)` took the residual
// value and the direction as two arguments. The number did not move; the residual is no longer the
// caller's to hold.
import rulesets.jvp
import { jvp, split } from transforms

func g(x: float): float {
    return x * x
}

func main(): int sync {
    let fwd = split(jvp(g))
    let (_y, lin) = fwd(3.0)
    println("tangent dx1=", lin(1.0))
    return 0
}
