/**
 * The precondition's own program: it only asks whether the library-level transforms are there.
 *
 * `test/tools/have-transforms-library.mjs` runs this and skips the M6 cases when it fails; none of
 * the numbers live here, so this file can be rewritten when the API's spelling is settled without
 * touching an expected value. It names all four entry points the M6 combinations need -- `grad`,
 * `jvp`, `vjp` (library) and `vmap` (transform) -- and nothing else, so it compiles exactly when
 * they exist.
 *
 * It must fail for nothing *except* a missing entry point: `f` therefore has a `with` parameter,
 * so that `grad(f)` is a legal call even today (grad differentiates the first `with` parameter)
 * and the probe's only remaining reason to fail is the three names that are not in the tree yet.
 */

import { grad, jvp, vjp } from autodiff
import { vmap } from transforms

with <w: f32>
func f(x: f32): f32 {
    return w * x
}

func main(): int {
    let a = grad(f)
    let b = jvp(f)
    let c = vjp(f)
    let d = vmap(f)
    return 0
}