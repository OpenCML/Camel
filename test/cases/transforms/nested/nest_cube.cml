// 判据 ②: the same nest for f(x)=x^3.  f'(2)=12, f''(2)=12
import { grad } from vjp

with <x: float>
func cube(): float {
    return x * x * x
}

func main(): int sync {
    let d1 = grad(cube)<2.0>()
    let d2 = grad(grad(cube))<2.0>()
    'nested_cube x=2.0 d1={} d2={}'->format<d1, d2>->println
    return 0
}