// The nest through a NAMED function: `dcube` has a `with` parameter of its own, so the outer `grad`
// moves it and then has to differentiate a body whose inner transform is a call through a function
// value (`grad(cube)`), which is section 乙's item 1 -- the transform recursing into the closure
// the inner cut answered.
//
//   f(x) = x^3,  f'(x) = 3x^2,  f''(x) = 6x,  at x = 2:  f' = 12 and f'' = 12
import { grad } from vjp

with <x: float>
func cube(): float {
    return x * x * x
}

with <x: float>
func dcube(): float {
    return grad(cube)<x>()
}

func main(): int sync {
    let d1 = dcube<2.0>()
    let d2 = grad(dcube)<2.0>()
    'nest_named x=2.0 d1={} d2={}'->format<d1, d2>->println
    return 0
}