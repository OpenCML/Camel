/**
 * A branch whose arms answer `f32`: the join the transposed arms flow into is typed by the cotangent
 * it carries, not by a `float` written where it is created.
 *
 * `f(x) = if x > 0 then x*x else 3*x`, so
 *
 *     x =  2 -> value 4,  dfdx = 2x  = 4
 *     x = -2 -> value -6, dfdx = 3   = 3
 *
 * The two arms are built in regions of their own and a `join` picks the one that ran, so the join
 * holds whichever arm's cotangent came back -- an `f32` here. The node is created before the arms run
 * and its value type is the cotangent's type; the answer tuple's member type is read from the value
 * the join stands for. A join created as `float` and a tuple member named from a ref that belongs to
 * the new graph rather than the source graph both answer `float` here, and then the `f32` cotangent
 * of the arm is a value read at the wrong width.
 */
import { vjp } from vjp

func f(x: f32): f32 {
    return if x > 0.0 then x * x else 3.0 * x
}

func main(): int sync {
    let (y, pullback) = vjp(f)(2.0)
    'branch f32 value={} dfdx={}'->format<y, pullback(1.0).0>->println
    let (z, pullbackNeg) = vjp(f)(-2.0)
    'branch f32 value={} dfdx={}'->format<z, pullbackNeg(1.0).0>->println
    return 0
}