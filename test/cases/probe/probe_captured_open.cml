// PROBE (wall 1): a captured array operand whose type leaves the extent OPEN (`float[]`).
// Same capture, same law (`index_into` over a rank-one `T[]`, which exists), so the only thing
// that differs from probe_captured_stated.cml is that the zero of the captured value's type has
// no extent to be built with. S2's own parameter tree is written `f32[..]`, so this is the shape
// the demo actually uses.
import { matmul } from tensor
import rulesets.jvp
import { jvp } from transforms

func main(): int sync {
    let a = [1.0, 2.0] as float[]
    let x = [10.0, 20.0] as float[]
    let g = (t: float[]): float => a[0] * t[0] + a[1] * t[1]
    let (v0, d0) = jvp(g)(x, [1.0, 0.0] as float[])
    `probe open value=${v0} tangent=${d0}`->println
    return 0
}