// A discrete result's cotangent, in both directions.
//
// A comparison answers a `bool`, and a `bool`'s gradient is its own type with the value zero
// (design principles 9.9): the forward lift hands back the pair the lifted signature promises --
// `(true, false)` here -- and the reverse transform takes a `bool` cotangent and answers the
// parameter's gradient, which is `0.0` whatever the cotangent said. The two readings are one
// statement: a value whose derivative is zero by definition carries that zero, of its own type, in
// the place the user's gradient keeps it.
//
// `camel test/cases/probe/t301/vjp_bool.cml`
import rulesets.jvp
import { jvp } from transforms
import { vjp } from vjp

func gt(a: float) => bool {
    return a > 0.0
}

func main() => int sync {
    let (value, tangent) = jvp(gt)(2.0, 1.0)
    println(value)
    println(tangent)
    let (answer, pullback) = vjp(gt)(2.0)
    println(answer)
    println(pullback(true).0)
    return 0
}