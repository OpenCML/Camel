// The reverse transform of a discrete result, through `grad`.
//
// `side` compares its `with` weight against its parameter and answers a `bool`, so its derivative is
// zero everywhere it is defined and `grad` answers the zero of the weight's type. The point of the
// case is the *shape*, not the number: the pullback takes the cotangent of a `bool` -- the zero of
// its own type, principle 9.9 -- and answers a `float` cotangent for the weight, exactly the members
// the declared `Gradient<F>` names.
//
// `camel test/cases/probe/t301/grad_bool.cml`
import rulesets.jvp
import { grad } from autodiff

with <w: float>
func side(a: float) => bool {
    return w > a
}

func main() => int sync {
    println(grad(side)<2.0>(1.0))
    return 0
}