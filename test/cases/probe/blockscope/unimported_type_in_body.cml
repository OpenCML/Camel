// The counter-proof: the same block body, and the file does not import the module that declares
// `Node`. The name must stay unresolved there -- a block's body reads what its own file imports,
// not every module the compiler knows.
func inc(x: int) => int {
    return x + 1
}

func family(f: (x: int) => int) => int sync {
    let g = edit d = f {
        let pick = func (n: Node) => Node { n }
        pick
    }
    return match g {
        case error e => -1
        case h => h(5)
    }
}

func main() => int sync {
    println('answer=', family(inc))
    return 0
}