// The claim `src/stdlib/rulesets/transpose.cml:1506` makes -- that `avg_pool2d_t` is "the one [law]
// a `grad` reaches today" -- read against the six `filed-not-walked` markers, which say it is not
// reached. One loss per operator, and the library's number against the engine's, so a law that is
// reached is also a law that answers the right thing.

import { grad } from autodiff
import { avg_pool2d, max_pool2d } from nn
import { abs, reshape, sum, tanh } from tensor
import { vjp } from vjp

func image() => f32[...] {
    return reshape<[1, 2, 4, 4]>([0.1, -0.4, 0.8, 0.3, -0.9, 0.5, 0.2, -0.1, 0.7, -0.3, 0.6, 0.4, -0.2, 0.9, -0.6, 0.1, 0.3, -0.8, 0.5, 0.2, -0.4, 0.6, 0.1, -0.7, 0.8, -0.5, 0.3, 0.9, -0.1, 0.2, 0.4, -0.6] as f32[])
}

func max_total(x: f32[1, 2, 4, 4]) => float {
    return float(sum(tanh(max_pool2d(x, 2))))
}

with <x: f32[1, 2, 4, 4]>
func max_engine() => float {
    return float(sum(tanh(max_pool2d(x, 2))))
}

func avg_total(x: f32[1, 2, 4, 4]) => float {
    return float(sum(tanh(avg_pool2d(x, 2))))
}

with <x: f32[1, 2, 4, 4]>
func avg_engine() => float {
    return float(sum(tanh(avg_pool2d(x, 2))))
}

func main() => int sync {
    let x = image() as f32[1, 2, 4, 4]
    let (_, pullbackMax) = vjp(max_total)(x)
    let maxDiff = float(sum(abs(pullbackMax(1.0).0 - grad(max_engine)<x>())))
    let (_, pullbackAvg) = vjp(avg_total)(x)
    let avgDiff = float(sum(abs(pullbackAvg(1.0).0 - grad(avg_engine)<x>())))
    `probe pools max_diff={} avg_diff={}`->format<maxDiff, avgDiff>->println
    return 0
}