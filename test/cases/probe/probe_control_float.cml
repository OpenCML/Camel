// PROBE (control B): a captured FLOAT, not an array. Same closure shape as probe_captured_open.
// If this refuses too, the refusal is the capture and not the array's tangent pair.
import rulesets.jvp
import { jvp } from transforms

func main(): int sync {
    let k = 2.0
    let t0 = 10.0
    let g = (t: float[]): float => k * t[0]
    let (v, d) = jvp(g)([7.0, 0.0] as float[], [1.0, 0.0] as float[])
    `probe control float capture value=${v} tangent=${d}`->println
    let _ = t0
    return 0
}