import { softmax_cross_entropy, softmax_cross_entropy_grad } from nn
import { reshape, sum } from tensor

func main() sync {
    let logits = reshape<[1, 2]>([0.2, -0.1])
    let target = reshape<[1, 2]>([1.0, 0.0])
    let loss = softmax_cross_entropy(logits, target)
    let grad = softmax_cross_entropy_grad(logits, target, 1.0)
    let grad0 = sum(f64(grad) * reshape<[1, 2]>([1.0, 0.0]))
    'sce_float loss={} grad0={}'->format<loss, grad0>->println
}
