/// A read on the second dimension of a 2-D value, differentiated twice: by the library's forward
/// transform (`jvp`) and by the engine (`with_grad`). `x[.., 0]` reads column 0, so the derivative
/// with respect to `x[0][0]` is 1 and to `x[1][0]` is 1; every other position is 0.
import { with_grad } from autodiff
import { jvp } from transforms
import rulesets.jvp

with <w: float[2, 2]>
func read_second(x: float[2, 2]) => float {
    let col = w[.., 0]
    return col[0] + col[1]
}

func main() => int sync {
    let x = [[1.0, 2.0], [3.0, 4.0]] as float[2, 2]
    let step = func (ww: float[2, 2]) => float {
        let col = ww[.., 0]
        return col[0] + col[1]
    }
    let (value, d00) = jvp(step)(x, [[1.0, 0.0], [0.0, 0.0]] as float[2, 2])
    let (engine_value, g) = with_grad(read_second)<[[1.0, 0.0], [0.0, 0.0]] as float[2, 2]>(x)
    `value={} d00={} engine_value={} g00={}`->format<value, d00, engine_value, g.0.0>->println
    return 0
}