// PROBE (control A): a captured array operand is NOT in the body at all -- the function is a plain
// named function of one array. The rank-one `index_into` law exists, so if this passes, arrays
// themselves lift and the refusal in the other two probes is about the capture.
import rulesets.jvp
import { jvp } from transforms

func h(t: float[]): float {
    return t[0] * t[1]
}

func main(): int sync {
    let (v, d) = jvp(h)([3.0, 5.0] as float[], [1.0, 0.0] as float[])
    `probe control array value=${v} tangent=${d}`->println
    return 0
}