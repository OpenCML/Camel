// Design `docs/design/graph-editing/README.cn.md` section 2, example 1, verbatim.
// 改一个函数：块的值是改好的函数，或一个错误值
export func fold_zero_adds::<F>(f: F) => F! when is_function::<F>() {
    return edit d = f {
        nodes(d)->filter<is_add_zero>->foreach<func (n: Node) { replace(n, inputs(n)[0]) }>
    }
}

// The page assumes the reader has these; their bodies are not what the example is about.
func is_add_zero(n: Node) => bool {
    return false
}