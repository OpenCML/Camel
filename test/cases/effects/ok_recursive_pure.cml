// A recursive function that touches nothing keeps its `pure`: the fixed point starts from the
// empty set and nothing is ever added. Two functions that only call each other, and a recursion that
// writes no clause stay accepted.
module ok_recursive_pure

func fact(n: int): int pure {
    return if n <= 1 then 1 else n * fact(n - 1)
}

func even(n: int): bool pure {
    return if n == 0 then true else odd(n - 1)
}

func odd(n: int): bool pure {
    return if n == 0 then false else even(n - 1)
}

func plain(n: int): int sync {
    println(n)
    return if n <= 0 then 0 else plain(n - 1)
}

func main(): int sync {
    println(fact(5), even(10), odd(7))
    println(plain(1))
    return 0
}
