// The other half of the pair: an entry with `var` writes its resource and nothing else, so a body
// that also prints reaches past the promise, and the signature the report quotes carries `var` on
// the entry -- a reader of the message tells the two clauses apart (design principles 3.3).

func shout(): int uses var stderr sync {
    println('x')
    return 1
}

func main(): int sync {
    println(shout())
    return 0
}