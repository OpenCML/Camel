/**
 * The same program as `../with/reading.cml`, with the declaration nothing reaches (`bump`) deleted:
 * every other function's measured resources are byte for byte the same, because a function's set is
 * what its own body was measured to reach (the ruling of 2026-11-15).
 */

var counter = 0

func apply(x: int) => int sync {
    var local = x
    local = local + counter
    return local
}

func main() => int sync {
    println(apply(1))
    return 0
}
