/**
 * A body-less declaration whose clause is not the signature of the operator it declares: the tag
 * names `fs:exists`, which reads the file system, so a `pure` declaration promises what the
 * operator does not keep. Refused where it is written (NativeResourceMismatch).
 */

import { read_text } from fs

#op('fs:exists')
export func exists(path: string): bool pure

func main(): int sync {
    println(exists("no/such/file"))
    return 0
}