// A resource another module exports is named through that module in a clause (design principles
// 10.2): `test_support::rendezvous_point` is one resource, whether a clause writes it bare in the
// module that declares it or through the module here. A module that writes the module prefix needs
// nothing else of that module's names.

import test_support

/// The body touches nothing; a call to it touches the meeting point `test_support` declares.
func meet(): int uses test_support::rendezvous_point {
    return 0
}

func main(): int sync {
    println(meet())
    return 0
}