// A function declared inside another one reaches the state around it, and the `pure` it wrote is
// refused at its clause: it writes `n`, and a body that writes anything has resources.
//
// `n` is a module `var` here, not a `var` of `main`. The shape this case used to pin -- `bump`
// assigning a `var` of the function that declares it -- is refused earlier now, by
// `ClosureAssignsCapturedName` (0x03000213, design principles 3.5, 197; the author's ruling of
// 2026-11-16), so the write could no longer reach this rule at all. The declaration inside a body
// and the refusal of the clause are the two things this case is about, and both are unchanged.
// What is lost with the old shape is the "the capture cannot be placed" reading: that path is
// pinned by `err.wide_parameters` and `err.many_parameters_pure`, which reach it through a
// parameter index rather than through a captured `var`.

var n = 0

func main(): int sync {
    func bump(x: int): int pure sync {
        n = n + x
        return n
    }
    println(bump(2))
    return 0
}