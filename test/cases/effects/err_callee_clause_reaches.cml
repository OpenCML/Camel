/**
 * A call reads the signature of the function it calls: a function that wrote a clause publishes
 * that clause, whether or not its body still reaches everything in it, so a caller of it has
 * reached those resources too and has to name them (design principles 3.3). The contract is what
 * lets a callee change its body within the clause later without touching its callers.
 */

resource db
resource cache

func fill(): int uses cache {
    return 1
}

func stamp(): int uses db {
    return fill()
}

func main(): int sync {
    println(stamp())
    return 0
}