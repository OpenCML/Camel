/**
 * The other side of the same rule: a parameter that writes `pure` promises the empty set, so a
 * call through it is not an effect and a result nothing depends on is dropped without a warning
 * (the promise is what the caller was told). A pure function stands at the parameter.
 */

func usePure(f: (x: int) => int pure): int {
    f(1)
    return 0
}

func twice(x: int): int {
    return x * 2
}

func main(): int sync {
    println(usePure(twice))
    return 0
}