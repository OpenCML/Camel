/**
 * The same rule read from the type: `total` writes no resource, so its inferred set is empty and
 * the value it stands for fits a parameter that asks for `pure` (design principles 3.3). The name
 * it writes is its own frame's, and the closure it makes only reads that name.
 *
 * The write used to be made from that closure, and that shape is refused now (design principles
 * 3.5, 197: a closure captures a value, so it cannot assign the name it captured). What this case
 * pins is the effect half, which the shape change does not touch: a closure over one of the body's
 * own names adds no resource to its measurement.
 */

func total(x: int): int {
    var acc = 0
    acc = x * (x - 1) / 2
    let read = (): int => acc
    read()
}

func main(): int sync {
    let f: (x: int) => int pure = total
    println(f(3))
    return 0
}