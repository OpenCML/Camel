/**
 * Two references write one mutable object: `counter` is written here, and written again by the
 * function value `f` the caller hands over -- at this level `f` is only a parameter, so which
 * variable it writes is not visible. Both writes happen; the read written after the call takes the
 * value the second write made (design principles 3.1, 3.5), so this prints `3`.
 *
 * The writer set is the one the call site cannot name: a variable written by some function in the
 * program counts as a possible write of a call through a function value. That is conservative --
 * a call with such a write has to run, and the reads after it are ordered after it -- and the
 * result is the one the program reads.
 */

var counter = 0

func twice(f: (x: int) => void, v: int): int sync {
    counter = 1     // The first reference: recorded in the writer table.
    f(v)            // The second reference: `f` captured `counter`, not visible here.
    return counter  // Whichever write the read takes.
}

func main(): int sync {
    println(twice((y: int) => { counter = y }, 3))
    return 0
}