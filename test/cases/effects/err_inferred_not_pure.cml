/**
 * A function that writes no clause about resources promises what its body was measured to reach:
 * `noisy` prints, so the type of the value it is known by says `uses stdout`, and a position that
 * asks for `pure` does not take it (design principles 3.3, effects plan 5). The refusal is at the
 * call, where the position and the value meet, and it names the signature that would have matched.
 */
module err_inferred_not_pure

func apply(f: (x: int) => int pure, x: int): int {
    return f(x)
}

func noisy(x: int): int sync {
    println(x)
    return x * 2
}

func main(): int sync {
    println(apply(noisy, 4))
    return 0
}