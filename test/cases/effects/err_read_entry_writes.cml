// A clause is an upper bound on what a body may touch, and an entry says how much of its resource
// the body may use (design principles 3.3): `uses env` reads the environment, so `grow` reaches
// past its promise when it prints. The report quotes the signature as it stands, entry without
// `var`.

func grow(): int uses env sync {
    println('x')
    return 1
}

func main(): int sync {
    println(grow())
    return 0
}