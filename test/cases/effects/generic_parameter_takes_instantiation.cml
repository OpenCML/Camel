/**
 * A function-typed parameter that writes no resource clause is resource-generic: it is
 * determined per instantiation, so it takes the resources of the function the argument
 * instantiates it with (design principles 3.3, effects plan 5). `apply` says nothing about what
 * `f` touches, so `noisy`, whose body prints, is a value it takes; what the call through `f`
 * reaches is what `apply` itself leaves undetermined. The program prints what it always did.
 */
module generic_parameter_takes_instantiation

func apply(f: (x: int) => int, x: int): int {
    return f(x)
}

func noisy(x: int): int sync {
    println(x)
    return x * 2
}

func main(): int sync {
    println(apply(noisy, 4))
    return 0
}