module duplicate_inputs

func pair(x: int): (int, int) {
    return (x, x)
}

func double(x: int): int {
    return x + x
}

func main(): int sync {
    let x = 7
    let (a, b) = pair(x)
    let arr = [x, x]
    let y = double(x)

    if a != 7 then {
        return 1
    } else {
        if b != 7 then {
            return 2
        } else {
            if arr[0] != 7 then {
                return 3
            } else {
                if arr[1] != 7 then {
                    return 4
                } else {
                    if y != 14 then {
                        return 5
                    } else {
                        'duplicate inputs ok'->println
                        return 0
                    }
                }
            }
        }
    }
}
