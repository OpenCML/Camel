/**
 * A `main` that reaches a recursion (through `spin`) and whose own computation is exactly the
 * limit of "small": eight compute nodes. The inliner copies it into the entry graph, so the
 * call of `main` does not survive; `compute_node_size_over_limit.cml` is the same program with
 * one statement more. How small a function is counts its own compute nodes only: its OPERs, the
 * calls it makes and its structural nodes; a constant, a parameter, a GATE and what an inline
 * splice adds are not counted.
 */

import { reshape } from tensor
import { export_model } from onnx
import { cpu_count } from process

func double(t: f32[..]): f32[..] {
    return t * 2.0
}

func spin(n: int): int sync {
    println(n)
    return if n <= 0 then 0 else spin(n - 1)
}

func main(): int sync {
    let _ = export_model<out: 'tmp/test/onnx/compute_node_size_at_limit.onnx'>(double, reshape<[2]>([1.0, 2.0]))
    let x = cpu_count()
    println(x)
    println(x)
    println(x)
    println(x)
    return spin(x)
}