/**
 * Verifies the inliner tolerates tiny callees whose entry node has no meaningful outgoing targets after simplification.
 */
module inline_empty_entry_targets_fallback

func literal(): int {
    return 42
}

func main(): int sync {
    let v = literal()
    if v != 42 then {
        return 1
    } else sync {
        'inline_empty_entry_targets_fallback ok'->println
        return 0
    }
}


