module body_chain_verbatim

//  The corpus of 5.7 (docs/design/effects/edges.cn.md): the body of an inlined `sync`
// function brings a chain of its own, and those statements are the statements of the body's own
// block, not of the caller's. The caller prints 1, the body prints 101 and 102, the caller prints
// the result the body returned (4) and then 2, and every one of those effects must run in that
// order whether or not the call was inlined.
//
// Beside the chain the splice writes 5.7's order edges: each effect (and may-fault) node of the
// body is ordered after the statement written before the call and before the one written after it.
// The corpus is built so that the two directions are told apart: the statement before the call
// prints a constant of its own (1), which makes the node an order edge starts from findable.

func inner(x: int): int sync {
    println(101)
    println(102)
    return x + 1
}

func main(): int sync {
    println(1)
    println(inner(3))
    println(2)
    return 0
}