/**
 * Verifies zero-argument callees can be inlined even when the rewritten graph has to reconnect from the return root backward.
 */
module inline_no_param_reverse_root

func calc(): int {
    let base = 20
    let y = base + 22
    return y
}

func main(): int sync {
    let out = calc()
    if out != 42 then {
        return 1
    } else sync {
        'inline_no_param_reverse_root ok'->println
        return 0
    }
}


