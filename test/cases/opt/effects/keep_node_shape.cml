// A program whose graph the draft-level readings act on: a call that must run, a node above it that
// reads its value and nothing else, and a print the pass can reroute. `test::keep_node` replaces
// that node, and what happens to this print is the reading (design principles 3.3, 9.7);
// `test::keep_node_pure` makes the removals that must get no keeper at all.
import { println } from std

func side(): int sync {
    println("side")
    return 1
}

func main(): int sync {
    let v = side() + 1
    println(v)
    return 0
}