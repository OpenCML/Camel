// The shape a guard needs: a two-member aggregate whose first member is not a constant, so the
// aggregate cannot fold away, and whose second member is a closure nothing reads. `x` is a parameter
// rather than a literal for that reason: the point is to reach the judgement, not to fold past it.
//
// The cell is the module's since 2026-11-16. A local `var` written after the closure that reads it is
// `CapturedVarWrittenAfterTheClosure` when the closure's value is put into another value -- the
// aggregate here (design principles 3.5, 198, the author's ruling of that day) -- and this case is
// about the aggregate's shape, not about that refusal. The module's cell is a place the graph names,
// so the write stays legal and the aggregate still has two members.

var c: int = 0

func probe(x: int): int sync {
    let h = (): int => sync {
        println(c)
        return c
    }
    let w = (c = 41) * 0
    let p = (x, h)
    return w + p.0
}

func main(): int sync {
    println(probe(7))
    return 0
}