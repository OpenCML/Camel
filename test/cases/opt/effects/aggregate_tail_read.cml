// A reader of the last member keeps it. `p.1` is the last component of the tuple, so the aggregate
// may not stop filling it however little the rest of the program reads: `tail-component-read`.
//
// A `var` cell is read here rather than a parameter so the tuple cannot be folded away before the
// judgement is reached (`readsNoWrittenSlot` refuses the projection, and the aggregate survives).

func probe(x: int): int sync {
    var c = 0
    let w = (c = 41) * 0
    let p = (x, c)
    return w + p.1
}

func main(): int sync {
    println(probe(1))
    return 0
}