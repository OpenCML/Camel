// The last member nothing reads, and the last member this one fills: `p.0` is read, `p.1` -- `x + c`
// -- is read by nobody. The sweep stops filling it, and the arithmetic that filled it loses its last
// reader and goes with it (`SWEEP oper=1`; the case printed `oper=0` while the screen refused every
// graph of this shape). The program still prints the 7 it printed before.
//
// The `var` is what keeps the aggregate reachable for the judgement: the projection `p.0` reads a
// slot a write produced, so the fold leaves the tuple alone.

func probe(x: int): int sync {
    var c = 0
    let w = (c = 41) * 0
    let p = (x, x + c)
    return w + p.0
}

func main(): int sync {
    println(probe(7))
    return 0
}