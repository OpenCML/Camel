// A guard: the aggregate escapes. `print_first` is handed the whole tuple, so the aggregate's only
// reader is a call -- not an access to a member that stays -- and its last member cannot be dropped:
// the callee may read any member, and nothing here can say which.

func print_first(p: (int, () => int)): int {
    return p.0
}

func probe(): int sync {
    var c = 0
    let h = (): int => sync {
        println(c)
        return c
    }
    let w = (c = 41) * 0
    let p = (1, h)
    return w + print_first(p)
}

func main(): int sync {
    println(probe())
    return 0
}
