// The shape `:op/keep` is for has to be written here and not added by the pass: a pass may not
// give a program an effect it did not have (the pass boundary check refuses one that does). The
// print is written in a function that is no `sync` block, so nothing in its graph has a sync edge
// -- that is the shape the block's chain cannot keep -- and `test::keepshape` then removes the node
// that reads the print, which is what takes the print's last read.
func shape(): int {
    return println(1) + 40
}

func main(): int sync {
    return shape()
}