// A guard: the aggregate is a root. `probe` returns the tuple itself, so whoever runs the graph reads
// every member of it -- including the closure -- and nothing may be dropped. The closure captures
// nothing, because a value that carries a captured cell out of the call that declares it is refused
// before it reaches this judgement.

func probe(): (int, () => int) sync {
    var c = 0
    let h = (): int => sync { return 7 }
    let w = (c = 41) * 0
    println(w)
    return (1, h)
}

func main(): int sync {
    let p = probe()
    println(p.0 + p.1())
    return 0
}