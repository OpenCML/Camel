// A guard: the last member is read. `p.1` takes it, so dropping it would take a value the program
// uses; the aggregate keeps both members and the write stays what it was.

func probe(): int sync {
    var c = 0
    let h = (): int => sync {
        println(c)
        return c
    }
    let w = (c = 41) * 0
    let p = (1, h)
    let u = p.1
    return w + p.0 + u()
}

func main(): int sync {
    println(probe())
    return 0
}