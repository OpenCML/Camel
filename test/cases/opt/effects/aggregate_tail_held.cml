// The aggregate is what the function hands on: `return p` makes the FILL the graph's returned value,
// so the graph itself names it and the members are the program's answer, not an internal step. The
// reading says `held-by-the-graph`.

func probe(x: int): (int, int) sync {
    var c = 0
    let w = (c = 41) * 0
    let p = (x, c)
    return p
}

func main(): int sync {
    println(probe(3).1)
    return 0
}