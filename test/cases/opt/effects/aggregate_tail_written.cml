// The cell the aggregate fills is written more than once: `var t = (c, x)` then `t = (c, y)`. The FILL
// is read by `:var/new`, which is not a projection of one of its members -- the aggregate is placed in
// a cell a later write replaces, so "nothing reads this member" is a statement about one writing and
// not about the value. The reading says `read-as-a-whole`.

func probe(x: int, y: int): int sync {
    var c = 0
    let w = (c = 41) * 0
    var t = (c, x)
    t = (c, y)
    return w + t.0
}

func main(): int sync {
    println(probe(4, 5))
    return 0
}