/**
 * The shape `exemplars/05_effect_order` has: a recursion whose body calls a function value that
 * prints, twice per call. Every print the recursion's arms hold runs once, in call order, whether
 * or not the optimizer unrolls the recursion and dissolves the constant branches it unrolls into.
 */

func visit(items: int[], i: int, cb: (x: int) => int): int {
    return if i >= len(items) then 0 else sync {
        let r = cb(items[i])
        return visit(items, i + 1, cb) + r
    }
}

func main(): int sync {
    let total = visit([1, 2], 0, (x: int): int => sync {
        println('visit {}'->format<x>)
        println('twice {}'->format<x>)
        return x * 10
    })
    println('total {}'->format<total>)
    return 0
}