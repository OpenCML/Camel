// The corpus of the common-subexpression comparison: the same value written twice, an
// expression over two separately written literals, one name whose value changes between two
// products written alike, and a function that shares nothing.
//
//   shared     `x * 7` written twice: identical once the two 7 literals are one value
//   literals   `3 + 4` written twice: the two sums are one expression once the literals are one
//   written    `cell * 3` written twice with `cell = cell + 1` between them: the second `cell` is
//              another value, so the two products are two computations and must stay two nodes,
//              whatever the 3 literals do
//   apart      `x + 1` and `x + 2`: two constants of different value, no expression to merge
//
// Every name here is a value, not a cell: a `var` whose every use stays in the region that
// declared it is bound to the value and an assignment rebinds it. So `written` asks the sweep a
// value question -- the text `cell * 3` is written twice and is computed twice, because the name
// between the two is another value, while the `3` written twice is one value after the sweep.
// The number is the source's own: `written(4)` is `4 * 3 + 5 * 3 = 27`.

func shared(x: int) => int {
    let a = x * 7
    let b = x * 7
    return a + b
}

func literals() => int {
    let a = 3 + 4
    let b = 3 + 4
    return a * b
}

func written(x: int) => int sync {
    var cell = x
    let a = cell * 3
    cell = cell + 1
    let b = cell * 3
    return a + b
}

func apart(x: int) => int {
    return (x + 1) * (x + 2)
}

func main() => int sync {
    println(shared(3))
    println(literals())
    println(written(4))
    println(apart(5))
    return 0
}
