/**
 * One application of a rule is all or nothing (docs/design/graph-editing/README.cn.md 16.1, 16.3):
 * an application the engine abandons leaves nothing of what it had already built in the draft.
 *
 * `leaks` has a right side whose second constant term faults when the rule is applied: `1 / 0` is a
 * `DivisionByZero` at the application, and the engine reads a right side whose constant does not
 * evaluate as "this application does not happen" (`RuleSkipped`, src/runtime/rules.cpp, caught by
 * both drivers, src/runtime/writings_driver.cpp) and goes on to the next match. The *first* constant
 * term of the same right side, `2 * 3`, is one the engine can make, and it makes the constants it
 * needs on the way: `2`, `3` and their product before the fault, `0` on the way into the fault.
 *
 * So an application that leaves those nodes in the draft is visible as a node count: `leak_probe`
 * keeps its product (`a * 1`) and gains nodes that nothing reads, and the difference between the
 * readings below is what the abandonment left behind. The number is the reading, not a shape.
 *
 * `drops` is the control: the same engine, the same left side, a right side with no faulting term.
 * It applies -- `drop_probe` loses its product and its constant -- so a run that shows the count
 * above unchanged shows it because the application was taken back, not because the engine stopped
 * rewriting.
 */

import { Graph, nodes, graphs_of, name } from graph
import { rewrite } from rewrite

/// Its right side cannot be built: `2 * 3` is a node the engine makes, and the constant `1 / 0`
/// after it is one that faults.
rule leaks(x: int) { x * 1 => (2 * 3) + (1 / 0) }

/// The control: a left side of its own, a right side the engine can build.
rule drops(x: int) { x + 0 => x }

export func apply_leaks::<F>(p: F): F! {
    return p->rewrite<[leaks]>
}

export func apply_drops::<F>(p: F): F! {
    return p->rewrite<[drops]>
}

func countOf::<F>(p: F, function: string): int spelling {
    let found = graphs_of(p)->filter<func (g: Graph) => bool { name(g) == function }>
    return len(nodes(found[0]))
}

/// The node count of both functions, so the same reading can be taken before and after each pass.
export func report::<F>(p: F): F! spelling sync {
    println('leak', countOf(p, 'leak_probe'), 'drop', countOf(p, 'drop_probe'))
    return p
}

func leak_probe(a: int): int {
    return a * 1
}

func drop_probe(a: int): int {
    return a + 0
}

func main(): int spelling sync {
    println(leak_probe(7), drop_probe(7))
    return 0
}