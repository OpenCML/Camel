// A call through a value: the type at the call site is the parameter's, and a parameter written
// `(x: int) => int` carries no resource clause at all -- a Generic signature, which promises nothing
// and therefore breaks nothing. The body behind the value prints, so the footprint is wider than
// `pure`; that is not a violation, because there was no promise. This is the difference between "a
// type that says nothing" (no violation) and "a reading the checker cannot name" (a decline), and
// the two must not be one line of code.

func apply(g: (x: int) => int, x: int): int {
    return g(x)
}

func loud(x: int): int sync {
    println(x)
    return x
}

func main(): int sync {
    return apply(loud, 3)
}