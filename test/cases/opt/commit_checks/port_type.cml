// Three called functions of one shape. `takes_int` and `mirror_int` take an `int`, and `takes_float`
// takes a `float` and hands on an `int` -- so a draft that republishes `takes_int` under
// `takes_float`'s signature writes a signature whose *parameter* type is another one and whose exit
// type is the same. That is what keeps the two halves of the promise apart: the value a graph hands
// on is already checked against the signature (`EdgeChecker::checkReturnValueType`, whose refusal is
// `RuntimeDiag::ExitTypeMismatch`), so a signature with another exit type would be refused for that
// reason and the port would never be the question. Here only the port can be.
//
// `mirror_int`'s signature has the same parameter types, so the same replacement under it is the
// positive half: a signature replacement that has nothing to disagree about.
//
// All three are called, and `main` returns a number the plan compares, so a commit that published one
// of these graphs would have to have published a program that still runs.

func takes_int(n: int) => int {
    return n + 1
}

func mirror_int(n: int) => int {
    return n * 2
}

func takes_float(x: float) => int {
    return if x > 0.0 then 7 else 0
}

func main() => int {
    let a = takes_int(41)
    let b = mirror_int(21)
    let f = takes_float(1.5)
    return a + b - b + f - 7
}
