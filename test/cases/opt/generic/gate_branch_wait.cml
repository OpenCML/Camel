/** Branch-local waits must not become unconditional dependencies of JOIN. */

import { seed, rand } from random

func held_value(x: float, label: string): float sync {
    println(label)
    return x
}

func main(k: int): int sync {
    seed(k)
    let x = rand()
    let value = if x > 0.5 then held_value(x, 'left') else held_value(x, 'right')
    println(value)
    return 0
}
