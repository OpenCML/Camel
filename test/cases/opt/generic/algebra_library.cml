/**
 * The laws the rules library has beyond the old C++ pass: x * 0, x - x, x / 1 and -(-x) for the
 * integer element types, and x / 1.0 and -(-x) for an element-wise tensor. `std::opt::algebra`
 * is the library's pass now, so these are the observables that say so: each function's graph
 * keeps no operator for the law that fired, while the printed values stay what the source says.
 */
module algebra_library
import tensor


type Vec = f32[3]

func int_zero(x: int): int {
    return x * 0
}

func int_sub_self(x: int): int {
    return x - x
}

func div_one(x: int): int {
    return x / 1
}

func neg_neg(x: int): int {
    return -(-x)
}

func int_combine(x: int): int {
    return x * 3 + x * 5
}

func array_div_one(x: Vec): Vec {
    return x / 1.0
}

func array_neg_neg(x: Vec): Vec {
    return -(-x)
}

func main(): int sync {
    println(int_zero(7), int_sub_self(7), div_one(7), neg_neg(7), int_combine(2))
    return 0
}