/**
 * The algebra laws fire on a product that carries a control input, and the writing that replaces
 *  it waits for the same things the product waited for (design principles 3.3, 3.4).
 *
 * `scaled` is called twice in one argument list: inlining gives the second body's entry product a
 * control input from the first call's effect, so the two products are ordered. The law
 * `t + t => t * 2` is about the data alone, so it applies to a product that waits, and the new
 * writing has to keep the order: the graph test checks the control edge, the run tests check that
 * the effects still happen in program order on every back end.
 *
 *   camel algebra_order.cml std::opt::inline std::opt::algebra std::jgir
 */
module algebra_order

func scaled(x: float): float {
    let t = x * 0.1
    return t + t
}

func main(): int sync {
    let x = 2.0
    'first'->println
    'scaled {} {}'->format<scaled(x), scaled(x)>->println
    'last'->println
    return 0
}