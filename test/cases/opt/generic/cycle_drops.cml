/**
 * Inputs for the reading that says no rewrite session was dropped for closing a cycle:
 * after `std::opt`, `std::stats` reports `"cycle_dropped_sessions": 0`, and the two
 * prints come out in the order they are written.
 *
 * The program is ordinary work for the rewrites -- a duplicate expression, a branch, a
 * call that inlines, and a product with no user inside a sync chain -- so on a rule set
 * that composed a cycle the session would have been dropped and the count would be 1.
 */

import { get_env } from env

func twice(x: int): int {
    return x + x
}

func main(): int sync {
    let n = len(get_env('CAMEL_TEST_SURELY_UNSET_VARIABLE') ?? '')
    let p = n * 7 + 1
    let q = n * 7 + 1
    println('before')
    let unused = n * 100
    let d = twice(p + q)
    let r = if n > 0 then d else d + 2
    'cycle p={} q={} d={} r={}'->format<p, q, d, r>->println
    return 0
}