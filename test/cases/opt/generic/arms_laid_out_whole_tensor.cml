/**
 * The tensor program on which the defect of arms_laid_out_whole.cml was found: `loop(0, 2, x)`
 * unrolled inside the arm of a run-time `if`. Under std::opt FastVM and the JIT left
 * the unrolled arm after its first multiplication and the JOIN read a slot never written
 * ("reduce: RuntimeError" at the `sum`). The first arm is empty here, so NodeVM and Taskflow
 * were right by accident.
 *
 * The loaded fixture and the accumulator are written with their element type (`f32[..]`: an
 * f32 array of unstated rank), the terminal spelling for a value whose element type a bare array
 * parameter leaves unstated: `x[0]` is then an `f32` and `x[0] + 2.6` finds its overload.
 *
 * Expected: "r 0.4375" (the four elements of the fixture sum to 1.75; two halvings).
 */

import { load_npy, sum } from tensor

func spin(i: int, n: int, acc: f32[..]): f32[..] {
    return if i >= n then acc else {
        let a2 = acc * 0.5
        spin(i + 1, n, a2)
    }
}

func main(): int sync {
let x = load_npy::<f32>('test/cases/opt/generic/arms_laid_out_whole_v4.npy')
    let n = int(x[0] + 2.6)
    let r = if n > 2 then {
        let a = spin(0, 2, x)
        a
    } else x
    println('r {}'->format<sum<0, true>(r)[0]>)
    return 0
}