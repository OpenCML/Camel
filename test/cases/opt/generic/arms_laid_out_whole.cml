/**
 * The arms of a branch are laid out one after the other, each as one piece. Here `loop(0, 2, x)`
 * is unrolled inside the arm of a run-time `if`; the innermost test (`2 >= 2`) is known and its
 * branch is replaced by the taken arm, which leaves the JOIN of the enclosing branch (`0 >= 2`)
 * waiting on nodes inside its second arm. The execution order used to visit those first: the
 * first half of the second arm, then the whole first arm, then the rest of the second arm. Under
 * std::opt::simplify the second arm then ran into the first one: "base" was printed twice on
 * NodeVM and Taskflow (exit 0), and FastVM and the JIT left the arm before its value was computed
 * (a located RuntimeError, or the wrong number).
 *
 * `n` is 3 but only known when the program runs (`now()`), so the outer `if` stays.
 * Expected: "base" once, then "r 126" ((40 + 1 + 1) * 3).
 */
module arms_laid_out_whole

import { now } from time

func tap(a: int): int sync {
    println('base')
    return a * 3
}

func spin(i: int, n: int, acc: int): int {
    return if i >= n then tap(acc) else {
        let a2 = acc + 1
        spin(i + 1, n, a2)
    }
}

func main(): int sync {
    let n = int(now() * 0.0) + 3
    let x = n + 37
    let r = if n > 2 then {
        let a = spin(0, 2, x)
        a
    } else x
    println('r {}'->format<r>)
    return 0
}
