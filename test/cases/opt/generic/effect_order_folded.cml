/**
 * Effects around code that std::opt evaluates away. The recursion
 * builds a constant, so simplify inlines and folds it; the println before it
 * must still run first, the arm that reads a value computed before its branch
 * (`items`) must enter after the branch, not at the start of main, and the tail
 * call through nested branches must not grow the stack.
 */

import { reshape, concat, zeros, show } from tensor

// The accumulator the nested `visit` writes is a module `var`, a cell a closure may still write: a
// closure holds the value a name had when it was made, not the name (design
// principles 3.5, the author's ruling of 2026-11-16, items 197 and 198), so a closure that writes a
// `var` of the body around it is refused (`SemanticDiag::ClosureAssignsCapturedName`, 0x03000213).
// This case's subject is the order of the effects around folded code, not the way the accumulator
// is held, so the accumulator moved to the top level rather than the case keeping a shape the rule
// retired; `test/cases/effects/callback_write_through_parameter.cml#counter` holds one the same way.
var seen: int[] = []

func count_down(i: int, acc: int) => int sync {
    return if i <= 0 then acc else step(i, acc)
}

// Inlined into count_down's arm, its branch nests inside count_down's: both recursive calls
// are still tail calls.
func step(i: int, acc: int) => int sync {
    return if i % 2 == 0 then count_down(i - 1, acc + 2) else count_down(i - 1, acc + 1)
}

func main() => int sync {
    println('start')
    let labels = [3, 1, 4]
    let n = 3
    func one_hot(i: int, acc: f32[...]) => f32[...] {
        return if i >= n then acc else sync {
            let row = reshape<[1, 10]>((0 .. 10 === labels[i]) * 1.0)
            let next = if i == 0 then row else concat<0>(acc, row)
            return one_hot(i + 1, next)
        }
    }
    let y = one_hot(0, zeros::<f32>([1, 10]))
    show(y)
    let items: int[] = [7, 8, 9]
    func visit(i: int) => void {
        return if i >= len(items) then null else sync {
            seen = seen->append<items[i]>
            return visit(i + 1)
        }
    }
    visit(0)
    println('seen {}'->format<seen>)
    println('count {}'->format<count_down(5000, 0)>)
    return 0
}
