/** Strict float32 doubling, including subnormal, signed zero and overflow inputs. */

func positive(x: f32): f32 { let t = x * f32(3.0); return t + t }
func fractional(x: f32): f32 { let t = x * f32(0.1); return t + t }

func main(x: f32): int sync {
    println(positive(x))
    println(fractional(x))
    return 0
}
