/**
 * A constant expression that can only fault is not folded (design principles 3.9), also when the
 * run reaches it: the division by zero is reported with its position when the program runs,
 * after "before" was printed, exactly as without passes. std::opt::fold and std::opt
 * add one warning at the same position before the run.
 */

func main(): int sync {
    println('before')
    let a = 1 / 0
    println(a)
    return 0
}
