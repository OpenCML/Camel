/**
 * Local algebra on elementwise tensor operators (design principles 7.3): the operators
 * declare the laws it uses (OperatorSemantics::binary), so a tensor expression is rewritten as the
 * scalar one is, under the same policy. A coefficient is a literal beside the tensor, so it takes
 * the tensor's element type (5.1) and is a value the element type holds exactly; a scalar of
 * another type is refused at the call rather than narrowed, and `rounded_coefficients` writes the
 * ones f32 rounds to show that the law reads them as the f32 values they are.
 */
module algebra_tensor

import { Tensor, reshape } from tensor

type Vec = Tensor<f32, [3]>

func merged(x: Vec): Vec {
    return x * 3.0 + x * 5.0
}

#[reassociate]
func merged_explicit(x: Vec): Vec {
    return x * 3.0 + x * 5.0
}

func chain(x: Vec): Vec {
    return (x * 3.0) * 2.0
}

func rounded_coefficients(x: Vec): Vec {
    return x * 0.1 + x * 0.2
}

func shared_product(x: Vec): Vec sync {
    let t = x * 3.0
    println(t)
    return t + t
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0] as f32[], [3])
    println(merged(x))
    println(merged_explicit(x))
    println(chain(x))
    println(rounded_coefficients(x))
    println(shared_product(x))
    return 0
}
