// The element-wise tensor forms of the same laws. The deleted C++ law table applied its laws to
// elementwise operators through the same `simplify<T>` (`elementwise` families in
// `e8c290554:algebra.cpp`), and the rules library states the f32 element laws
// (`tensor_combine`, `tensor_fold`, `tensor_add_self`, the neutrals). What the library
// does not state is the `t * 0` family: an f32 zero tensor of the matched shape cannot be written
// by a rule, and the deleted table had no tensor zero law either — `tensor_zero` is where the gap is
// measured, and the difference is a language feature, not a missing rule.

import { reshape } from tensor

type Vec = f32[3]

func tensor_combine(x: Vec): Vec sync {
    let a = x * 3.0 + x * 5.0
    println(a)
    return x
}

func tensor_fold(x: Vec): Vec sync {
    let a = (x * 3.0) * 2.0
    println(a)
    return x
}

func tensor_double(x: Vec): Vec sync {
    let a = x + x
    println(a)
    return x
}

func tensor_zero(x: Vec): Vec sync {
    let a = x * 0.0
    println(a)
    return x
}

func main(): int sync {
    let v = reshape([1.0, 2.0, 3.0] as f32[], [3])
    println(tensor_combine(v))
    println(tensor_fold(v))
    println(tensor_double(v))
    println(tensor_zero(v))
    return 0
}