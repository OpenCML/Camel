module divergence

// The forms the legacy C++ algebraic pass and the rule library do not answer the same way (H160).
// Each one is a graph the measurement reports as a difference rather than normalises away: the two
// sides are put through the same pass list and the tables are compared line by line.
//
//   anchor_add     `x + 0` as the value the function returns. The add is the graph's named node
//                  (`exit`/`output`/`return`); the C++ pass's `isReplaceable` refuses to rewrite
//                  it, the rule engine retargets the anchor onto the port.
//   anchor_mul32   `x * 1` at i32, in the same position: the same difference on the other integer
//                  type, so the difference is the position and not the type.
//   effect_mul_zero  `println(5) * 0`. The legacy C++ law table has no `x * 0` law, so neither the
//                  deleted table nor the reference mode touches it; the rules library has
//                  `int_mul_zero`, so the library replaces the product by the constant 0 and the
//                  effect the product read is left without a user. Design principles 9.7 forbids
//                  that rewrite, and this corpus is where it is measured.

func anchor_add(x: int): int {
    return x + 0
}

func anchor_mul32(x: i32): i32 {
    return x * 1
}

func effect_mul_zero(): int sync {
    let a = println(5) * 0
    println(a)
    return 0
}

func main(): int sync {
    println(anchor_add(7))
    println(anchor_mul32(9))
    println(effect_mul_zero())
    return 0
}