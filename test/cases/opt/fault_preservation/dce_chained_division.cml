/**
 * In a `sync` block a statement that may fault is on the chain: it runs where it is written even
 * when nothing reads its value, so dead-code elimination keeps it (design principles 3.4).
 */
module dce_chained_division

func check(z: int): int sync {
    let r = 5 / z
    println('after')
    return 0
}

func main(): int sync {
    println('before')
    return check(0)
}
