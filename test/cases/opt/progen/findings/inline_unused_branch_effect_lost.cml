/**
 * progen finding F10 (branch arm). `std::opt::inline` drops the `println` of the taken arm of a branch
 *   whose value is not used and whose test calls a function.
 * Pipeline: std::opt::inline std::nvm
 * Expected output: (empty line)
 * Actual: (nothing)
 * Reduced by test/tools/progen (an early batch, before the seed stream was versioned).
 */

func f1(a2: bool): bool {
    let n5 = if true then if a2 then '' else '' else {
        return '';
    };
    return (match n5 {
        case 'x' => -1
        case _ => -1
    }) < int(-1.5);
}

func main(): int sync {
    let n63 = if (if false then true else f1(false)) then sync {
        return '';
    } else sync {
        println('');
        return '';
    };
    return 0;
}
