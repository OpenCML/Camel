/**
 * progen finding F13 (branch arm). `std::opt::inline std::opt::dce` changes the value of a branch whose
 * taken arm is a sync block that declares a variable it does not use: the program prints 0 instead
 * of 1 (exit 0, no diagnostic). Without passes, and with either pass alone, it prints 1.
 * Expected output: 1
 */
module inline_dce_arm_value

func main(): int sync {
    let n = if true then sync {
        var v = [int(2.5)]
        return int(1.0)
    } else 0
    println(n)
    return 0
}
