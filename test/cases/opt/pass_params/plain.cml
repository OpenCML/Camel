/**
 * A program for the tests of pass parameters (test/plans/feat/opt/pass_params.plan.toml): it
 * imports the tensor module, which registers its own passes, and prints one line. Importing it
 * adds no pass to the pipeline: the module's passes run only where the command line writes them.
 */
module plain

import { Tensor } from tensor

func main(): int sync {
    println("camel-ran-marker")
    return 0
}
