/**
 * After std::opt the first round of `step` is inlined into the caller, behind a branch: the arm
 * reads `b2` and `w0`, computed outside the branch, through GATE nodes that execute nothing.
 * A scheduler that runs unordered nodes concurrently must make the branch wait for the nodes
 * behind those GATEs; otherwise the arm reads slots not yet written (the second line was 7
 * instead of 9). Two calls, so that the top level is not a single chain.
 * Expected output: 1010, then 9.
 */
module arm_reads_outer_value

func train(base: int, epochs: int, k: int): int sync {
    let b2 = base + 1
    let w0 = k * 2

    func step(epoch: int, w: int): int sync {
        if (epoch >= epochs) then {
            return w
        } else sync {
            let p = b2 * w
            let q = p + epoch
            let r = q - b2 * w + 1
            let nw = w + r - epoch
            return step(epoch + 1, nw)
        }
    }

    return step(0, w0)
}

func main(): int sync {
    println(train(3, 1000, 5))
    println(train(4, 7, 1))
    return 0
}
