/**
 * A non-tail recursion far deeper than a native stack holds, run with the limit raised to
 * 1000000 (the plan passes --max-recursion-depth). On the bytecode interpreter (std::fvm, and
 * std::prl, which hands these serial functions to it) direct calls do not nest on the native
 * stack and depth(400000) completes. Where every call nests on the native stack (the parallel
 * scheduler's own evaluator, std::prl(bytecode=false)) it stops with MaxRecursionDepthExceeded
 * when the stack of the thread is nearly full instead of a segmentation fault; depth(2000)
 * fits there.
 */
module recursion_too_deep

func depth(n: int): int {
    return if n == 0 then 0 else 1 + depth(n - 1)
}

func main(): int sync {
    println(depth(2000))
    println(depth(400000))
    println('done')
    return 0
}
