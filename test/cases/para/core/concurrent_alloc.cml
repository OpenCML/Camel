/**
 * Concurrent calls that allocate, for runs with the collector forced at every safepoint and
 * every few allocations (see the test plan): a value a worker has just produced (the result of
 * a call on its way into the caller's frame, an array being filled by a map) must survive a
 * collection started by another worker, and must be found again after the collector moved it.
 * The program sorts by a recursive merge sort whose two halves run concurrently, inside the
 * elements of a map, and folds the results with reduce and filter.
 */

import { seed, shuffle, next_key } from random
import { sort, merge_sorted } from array

func mergesort(arr: int[]): int[] {
    return if len(arr) <= 4 then sort(arr) else {
        let mid = len(arr) / 2
        let lhs = arr[0:mid]->mergesort
        let rhs = arr[mid:len(arr)]->mergesort
        return merge_sorted(lhs, rhs)
    }
}

func checksum(arr: int[]): int {
    return 0..len(arr)->map<(i: int): int => arr[i] * (i + 1)>->reduce<(a: int, b: int): int => a + b, 0>
}

func main(): int sync {
    seed(7)
    let data = 0..96->shuffle<next_key()>
    let sums = 0..12->map<(k: int): int => {
        let part = data[k * 8:96]
        return checksum(mergesort(part))
    }>
    sums->println
    sums->filter<(s: int): bool => s > 100000>->println
    mergesort(data)->println
    return 0
}
