/**
 * Parallel bootstrap workload used to stress repeated sampling plus concurrent sort-heavy reductions.
 */
module bootstrap_medians

import { now } from time
import { seed, shuffle, sample, next_key } from random
import { sort, mean } from array
import { stdev } from statistics

func main(): int sync {
    let source_size = 200000
    let sample_size = 40000
    let replicas = 8
    let s = 20260309

    seed(s)
    'Generating {} source values...'->format<source_size>->println
    let source = 0..source_size->shuffle<next_key()>

    println('Preparing bootstrap samples sequentially...')
    let prep_start = now()
    let b0 = source->sample<next_key(), sample_size>
    let b1 = source->sample<next_key(), sample_size>
    let b2 = source->sample<next_key(), sample_size>
    let b3 = source->sample<next_key(), sample_size>
    let b4 = source->sample<next_key(), sample_size>
    let b5 = source->sample<next_key(), sample_size>
    let b6 = source->sample<next_key(), sample_size>
    let b7 = source->sample<next_key(), sample_size>
    let prep_duration = now() - prep_start

    'Sorting {} sampled arrays in parallel...'->format<replicas>->println
    let sort_start = now()
    let medians = [b0, b1, b2, b3, b4, b5, b6, b7]->map<(arr: int[]): int => {
        let sarr = sort(arr)
        return sarr[len(sarr) / 2]
    }>
    let sort_duration = now() - sort_start

    let wide = medians->map<(m: int): float => float(m)>
    'medians = {}'->format<medians>->println
    'mean = {:.2f}'->format<mean(wide)>->println
    'stdev = {:.2f}'->format<stdev(wide)>->println
    'sample preparation took {:.2f} seconds'->format<prep_duration>->println
    'parallel sorting stage took {:.2f} seconds'->format<sort_duration>->println
    return 0
}

