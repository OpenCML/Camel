/**
 * Calls with no order between them print at the same time under a parallel scheduler. The
 * order of their lines is not defined, but every line comes out whole: 3000 map elements each
 * print one line, and the output is 3000 lines of the form "line <i> of the map", each i once.
 */

func show(i: int): int sync {
    println('line {} of the map'->format<i>)
    return i
}

func main(): int sync {
    let shown = (0..3000)->map<show>
    return if len(shown) == 3000 then 0 else 1
}
