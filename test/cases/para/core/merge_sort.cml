/**
 * Large recursive mergesort workload used to stress divide-and-conquer parallelism and deep task trees.
 */

import { now } from time
import { seed, rand, shuffle, next_key } from random
import { sort } from array

/// Merges two sorted arrays in one pass: the smaller front element goes out first, then what is
/// left of either side.
func merge(lhs: int[], rhs: int[]): int[] sync {
    let none: int[] = []
    let (i, j, out) = loop i = 0, j = 0, out = none while i < len(lhs) && j < len(rhs) do {
        let l = lhs[i]
        let r = rhs[j]
        return if l <= r then (i + 1, j, out->append<l>) else (i, j + 1, out->append<r>)
    }
    return concat(concat(out, lhs[i:]), rhs[j:])
}

func mergesort(arr: int[]): int[] sync {
    let start = now()
    let res = if len(arr) <= 1000000 then sort(arr) else {
        let mid = len(arr) / 2
        let lhs = arr[0:mid]->mergesort
        let rhs = arr[mid:len(arr)]->mergesort
        return merge(lhs, rhs)
    }
    let duration = now() - start
    println('MergeSorted {} elements in {:.2f} seconds.'->format<len(arr), duration>)
    return res
}

func main(): int sync {
    let n = 100000000
    let m = 100
    let s = 1

    seed(s)

    'Generating {} values (seed={})...'->format<n, s>->println
    let arr = 0..n->shuffle<next_key()>

    'First {} values (unsorted):'->format<m>->println
    arr[0:m]->println

    'Start sorting {} numbers...'->format<n>->println
    let start = now()
    let sorted = mergesort(arr)
    let duration = now() - start

    'Sorted (first {} shown):'->format<m>->println
    sorted[0:m]->println

    'Mergesort completed in {:.2f} seconds'->format<duration>->println
    return 0
}
