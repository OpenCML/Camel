/**
 * Feature-sized Monte Carlo estimator: the same parallel map-reduce as monte_carlo_pi, with a
 * workload that fits a routine test budget (the full-size case lives in the perf plan).
 */
module monte_carlo_pi_small

import { pi_hits } from sim

func main(): int sync {
    let repeat = 8
    let samples_per_worker = 1e5
    let total_samples = repeat * samples_per_worker
    let base_seed = 0

    let total_hits = range(0, repeat)
        ->map<(i: int): int => pi_hits(samples_per_worker, base_seed + i * 7919)>
        ->reduce<(acc: int, cur: int): int => acc + cur, 0>
    let pi = 4.0 * float(total_hits) / float(total_samples)

    'Estimated pi = {:.2f}'->format<pi>->println
    return 0
}
