module when_clause_format

func pick::<T>(x: T): T when is_ordered::<T>() {
return x
}

func total(xs: int[]): int when is_numeric::<int>() {
  return xs->reduce<(a, b) => a + b, 0>
}

func maybeSum(xs: float[]): float?   when is_numeric::<float>() {
    return xs->reduce<(a, b) => a + b, 0.0>
}

func sumOrZero(xs: int[], fallback: int): int
    when is_numeric::<int>()
{
    return xs->reduce<(a, b) => a + b, fallback>
}

rule add_zero::<T>(x: T)   when   is_integer::<T>() {
    x + 0 => x
}

rule drop_by_zero(x: int, const y: int)   when is_zero(y)   { x + y => x }