module format_tag_above_doc

#op(':op/add_l')
func add_kernel(a: int, b: int): int

#impl(add_kernel)
/// The sum, written as a subtraction so that a body and its kernel can be told apart.
///
/// The tag above this comment is the declaration's own, and the comment is the declaration's
/// description: the formatter writes the tag, then the comment where the reader wrote it, then the
/// declaration. A formatter that reads the comment as standing above the tag moves it out of the
/// declaration, and one that cannot place it there writes it at the end of the file.
/// @example add(19, 23)    // 42
export func add(a: int, b: int): int {
    return a - (0 - b)
}

#op(':op/sub_l')
func sub_kernel(a: int, b: int): int

#impl(sub_kernel)

/// The difference, with a blank line between its tag and this comment: the blank line is the
/// reader's and the comment keeps its place below the tag.
export func sub(a: int, b: int): int {
    return a + (0 - b)
}