// The gradient of an array (design principles 9.9): the tangent of `T[]` is the array of the
// tangents of its elements, and the reverse of reading `xs[i]` is a scatter-add into that array.
// So `xs[0] + xs[2]` gives [1, 0, 1], and a struct array sends each element's gradient back to
// its place with the fields of the tangent struct. The array is the first `with` parameter.
import { grad } from autodiff

type P = { x: float, y: float }

with <xs: float[]>
func pick(): float { return xs[0] + xs[2] }

with <ps: P[]>
func pick_x(): float { return ps[0].x + ps[1].x }

func main(): int sync {
    let xs = [1.0, 2.0, 3.0]
    let ps = [{ x: 1.0, y: 10.0 }, { x: 2.0, y: 20.0 }]
    println(grad(pick)<xs>())
    println(grad(pick_x)<ps>())
    return 0
}
