// A loop with no round keeps its first state: an empty string, an empty map, a tensor whose
// first extent is 0, an empty array; and `for ... while` whose condition is false at once
// takes no element.
module tensor_empty

import { zeros } from tensor

func main(): int sync {
    let none: int[] = []
    let s = loop n = 1 for c in '' do n + 1
    let m = loop n = 2 for kv in ([] as Map<int, int>) do n + 1
    let t = loop n = 3 for row in zeros([0, 2]) do n + 1
    let a = loop n = 4 for x in none do n + 1
    let c = loop n = 5 for x in [1, 2] while n < 5 do n + x
    println(s, m, t, a, c)
    return 0
}