// std::macro evaluates a macro function that runs a loop ahead of time, round by round: a
// thousand rounds take no depth (the evaluator's nesting limit is 64 calls).
macro func triangle(n: int): int {
    return (loop s = 0, i = 1 while i <= n do (s + i, i + 1)).0
}

func main(): int sync {
    println(triangle(1000))
    return 0
}
