// What a round of a `for` hands over is the type its port declares (design principles 5.4,
// ArrayType::firstDimensionElement): the element itself for a rank-1 array, the row one dimension
// shorter above it, and the same open-rank array when the rank is open. `f32[..]` is `f32[..]`
// (the spelling a tensor parameter uses), so `for v in x` declares `v: f32[..]` and the round of a
// value whose runtime rank is 1 is the array of no dimension holding the element — the sub-tensor
// one dimension fewer, which shares the element's data. `sum(v)` therefore reads the element
// itself; `v` is not a scalar here, and the scalar reading of this round is a compile-time type
// error (open_rank_round_scalar_read.cml).

import { sum } from tensor

func total(x: f32[..]): float {
    return loop s = 0.0 for v in x do s + float(sum(v))
}

func main(): int sync {
    let x: f32[] = [1.0, 2.0, 3.0]
    println(total(x))
    return 0
}