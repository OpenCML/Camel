// The same rule with a rank-2 value: `x` is passed to a parameter of open rank (`f32[..]` is
// `f32[..]`), so the round is declared as the open-rank array one dimension fewer (design
// principles 5.4); at run time each round is the row, and `sum(v)` reads that row's sum. The row
// sums are the proof that the round is read as an array of the row's elements and not as the
// scalar the rank-1 case of open_rank_round_rank1.cml holds.
module open_rank_round_rank2

import { sum } from tensor

func rowSums(x: f32[..]): float[] {
    return loop acc = [] for v in x do acc->append<sum(v)>
}

func main(): int sync {
    let x: f32[2, 2] = [[1.0, 2.0], [3.0, 4.0]]
    println(rowSums(x))
    return 0
}