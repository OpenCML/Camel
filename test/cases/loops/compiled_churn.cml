// A loop whose body allocates a string in every round, compiled by the JIT: the rounds stay
// interruptible at the safepoint FastVM has (LEND), so the collector runs while compiled code
// holds the state in its frame, and a reference kept anywhere but the frame would be moved out
// from under it.
module compiled_churn

import { get_env } from env

func churn(n: int): int {
    let (total, s) = loop total = 0, s = '' while total < n do (total + 1, string(total))
    return total
}

func main(): int sync {
    let n = int(get_env('N'))
    println(churn(n))
    println('done')
    return 0
}