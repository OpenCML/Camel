// Outside a sync block, a loop whose value nothing takes does not run (design principles 2.1):
// its effects are reported as not executed, as for any call.
func f(): int {
    loop i = 0 while i < 3 do sync { println(i); i + 1 }
    return 5
}

func main(): int sync {
    println(f())
    return 0
}
