// Outside a sync block a loop whose value nothing takes still runs when its body writes: what a region
// writes is a root of that region (the ruling of 2026-11-17), so the rounds run and nothing is reported.
func f(): int {
    loop i = 0 while i < 3 do sync { println(i); i + 1 }
    return 5
}

func main(): int sync {
    println(f())
    return 0
}
