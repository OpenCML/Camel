// Edges: a `for` over an empty array and a `while` whose condition is false at once leave the
// first state; three values of state; a loop at the top level of the module; a loop whose state
// is an array built round by round; a long loop that keeps the stack constant.
let none: int[] = []
let squares = loop acc = none for x in range(1, 6) do acc->append<x * x>

func fib(n: int): int {
    let (a, b, k) = loop a = 0, b = 1, k = 0 while k < n do (b, a + b, k + 1)
    return a
}

func main(): int sync {
    let empty = loop acc = 7 for x in none do acc + x
    let never = loop i = 5 while i < 0 do i + 1
    let long  = loop s = 0, i = 0 while i < 1000000 do (s + i % 7, i + 1)
    println(empty, never, fib(30), squares, long.0)
    return 0
}
