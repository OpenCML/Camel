// A constant is not a capture (H91; design principles 3.10): a value whose build-time value is
// known -- a literal, a folded literal, a static value -- is evaluated where it is read, in
// place, and the loop lowering passes no input for it. A value that is merely loop-invariant
// (here the parameter `n`) is not a constant and stays an input of the loop's regions.
//
// `test::loop_inputs` prints the two loops: with_runtime has one capture (the parameter `n`,
// read by its condition) and one constant left out (the body's `k`); constants_only has no
// capture and the same one constant. Both loops compute what they did before, so the graph
// shape and the run are checked together.
func with_runtime(n: int): int {
    let k = 7
    let xs = [1, 2, 3, 4]
    return loop acc = 0 for x in xs while acc < n do acc + x * k
}

func constants_only(): int {
    let k = 7
    let xs = [1, 2, 3, 4]
    return loop acc = 0 for x in xs do acc + x * k
}

func main(): int sync {
    println(with_runtime(20), constants_only())
    return 0
}