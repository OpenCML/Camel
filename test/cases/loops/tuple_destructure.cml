// Several values of state: the body gives a tuple of them, the loop's value is that tuple, and
// `let (a, b) = loop ...` takes it apart. The state names are seen by the condition and the body
// only.
func main(): int sync {
    let (q, r) = loop q = 0, r = 47 while r >= 5 do (q + 1, r - 5)
    let pair   = loop lo = 0, hi = 100 while hi - lo > 1 do if (lo + hi) / 2 * ((lo + hi) / 2) > 2000 then (lo, (lo + hi) / 2) else ((lo + hi) / 2, hi)
    println(q, r, pair.0, pair.1)
    return 0
}
