// Collection slots have no source syntax (camel/runtime/loop.h, "Collection slots"): the
// test-only pass `test::loop_collect` gives every LOOP node two of them, so each loop's value
// becomes (last state, tape of the states it went through, tape of those states plus one) and
// printing the loop prints all three. The four shapes, and the two ways a loop runs no rounds.
func main(): int sync {
    println(loop acc = 0 for x in [1, 2, 3] do acc + x)
    println(loop i = 0 while i < 4 do i + 1)
    println(loop hit = 0 for x in [3, 12, 7] while hit < 10 do hit + x)
    let none: int[] = []
    println(loop acc = 0 for x in none do acc + x)
    println(loop i = 0 while i > 0 do i + 1)
    println(loop hit = 10 for x in [1] while hit < 10 do hit + 1)
    return 0
}