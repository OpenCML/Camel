// Differentiating through a `loop` is refused where the loop is written: the derivative of a
// LOOP node (a forward loop keeping each round's pullback and a backward loop) is a later step.
module grad_refused
import { grad } from autodiff

func f(x: float): float {
    return loop y = x for k in [1, 2, 3] do y * x
}

func main(): int sync {
    println(f(2.0))
    println(grad(f)(2.0))
    return 0
}
