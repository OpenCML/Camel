// A differentiable value read through a struct and turned into data: `n` is an `int` field
// computed from `x`, and `float(n)` reads it as a number. An integer's derivative is zero by
// definition (design principles 9.9), so `float(p.n)` is a constant of the call -- 20 at x = 2 --
// and the gradient is the one of `x * x * 20`, 80, not a refusal.
import { grad } from autodiff

type P = { w: float, n: int }

with <x: float>
func f(): float {
    let p = { w: x * x, n: int(x * 10.0) }
    return p.w * float(p.n)
}

func main(): int sync {
    println(grad(f)<2.0>())
    return 0
}