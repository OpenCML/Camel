// A value produced by an effectful call whose type is discrete: `side` returns an `int`
// computed from `x`, and `float(n)` reads it as a number. The call boundary hides where the
// value came from, but an integer's derivative is zero by definition (design principles 9.9), so
// `float(n)` is the constant 20 at x = 2 and the gradient is 20, not a refusal.
import { grad } from autodiff

func side(x: float): int sync {
    println('side')
    return int(x * 10.0)
}

with <x: float>
func f(): float {
    let n = side(x)
    return x * float(n)
}

func main(): int sync {
    println(grad(f)<2.0>())
    return 0
}