// A value produced by an effectful call is data when its type has no gradient channel:
// `side` returns an `int` computed from `x`, and `float(n)` reads it as a number. The call
// boundary hides where the value came from, so the gradient would silently drop it; it is
// refused at the read (design principles 9.9).
import { grad } from autodiff

func side(x: float): int sync {
    println('side')
    return int(x * 10.0)
}

with <x: float>
func f(): float {
    let n = side(x)
    return x * float(n)
}

func main(): int sync {
    println(grad(f)<2.0>())
    return 0
}