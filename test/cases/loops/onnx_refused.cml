// A `loop` in a function exported to ONNX is refused where it is written: the translation of a
// LOOP node to an ONNX Loop is the next step (docs/design/loops 5.7).
module onnx_refused
import { Tensor, reshape, tanh } from tensor
import { export_model } from onnx

func model(x: Tensor, w: Tensor): Tensor {
    return (loop h = x, k = 0 while k < 3 do (tanh(h @ w), k + 1)).0
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0], [2, 2])
    let w = reshape([0.5, -0.25, 0.1, 0.3], [2, 2])
    println(model(x, w))
    export_model((x: Tensor, w: Tensor): Tensor => model(x, w), (x, w), 'tmp/test/onnx/loop_refused.onnx')
    println('exported')
    return 0
}
