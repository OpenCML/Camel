// A `loop` in a function exported to ONNX is refused where it is written: the translation of a
// LOOP node to an ONNX Loop is the next step (design principles 3.10).
import { reshape, tanh } from tensor
import { export_model } from onnx

func model(x: float[..], w: float[..]): float[..] {
    return (loop h = x, k = 0 while k < 3 do (tanh(h @ w), k + 1)).0
}

func main(): void! sync {
    let x = reshape<[2, 2]>([1.0, 2.0, 3.0, 4.0])
    let w = reshape<[2, 2]>([0.5, -0.25, 0.1, 0.3])
    println(model(x, w))
    export_model<out: 'tmp/test/onnx/loop_refused.onnx'>((x: float[..], w: float[..]): float[..] => model(x, w), (x, w))
}
