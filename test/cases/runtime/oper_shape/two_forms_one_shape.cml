// One operation, two writings, as long as the kind that wrote it still exists. `cast`, `copy`,
// `fill`, `access` and `access_key` are declared in stdlib/prelude.cml, so a call of one builds an
// OPER node that names the operator; a construction the language writes as an aggregate still builds
// the FILL kind. A copy, a member read and an entering have one writing each: `copy(t)`, the
// `:op/access` / `:op/access_key` a member read is lowered to, and the `:op/enter` the compiler
// inserts where `by_rank_zero` makes an `int` meet its declared `int[...]` return.
//
// A number's conversion is the target's own conversion function, so `float(x)` is a call of a
// declared function and answers none of the four operations; `:op/cast` is what the `cast::<T, U>`
// call writes, and this case writes no such call: `cast::<int, float>` is the pair the language
// refuses (a number converts through the target's function, not through the operator), and the
// graph's edge check stops a program that writes it.
//
// `test::oper_shape` prints the shape each form answers, one line per form, and the two writings of
// one construction must agree: the shape is the operator's, not the node kind's. The position and the
// field a member read names are `with` parameters of `access` / `access_key`, written in the call's
// own angle brackets (`access::<(int, int), int><0>(t)`).
//
// Every writing stands in a function of its own so that nothing folds: a conversion of a literal,
// or a member read of an aggregate the builder just made, could be computed before the graph is
// handed to the pass, and then a form would be missing from the reading.

type Point = { x: int, y: int }

func via_copy(t: (int, int)) => (int, int) {
    return copy(t)
}

func via_fill(a: int, b: int) => (int, int) {
    return fill((0, 0), a, b)
}

func via_access(t: (int, int)) => int {
    return access::<(int, int), int><0>(t)
}

func via_access_key(p: Point) => int {
    return access_key::<Point, int><'y'>(p)
}

func by_conversion(x: int) => float {
    return float(x)
}

func by_rank_zero(x: int) => int[...] {
    return x
}

func by_aggregate(a: int, b: int) => (int, int) {
    return (a, b)
}

func by_member(t: (int, int)) => int {
    return t.0
}

func main() => int sync {
    let point: Point = { x: 1, y: 2 }
    let pair = (5, 6)
    println(
        via_copy(pair).0,
        via_fill(3, 4).0,
        via_access(pair),
        via_access_key(point),
        int(by_conversion(1)),
        by_aggregate(7, 8).0,
        by_member(pair)
    )
    return 0
}