// WALL PROBE 11 -- `grad` over a model. `grad` is declared once, for one float parameter:
//
//     export func grad(f: (x: float) => float): (x: float) => float
//
// A model is not that: its parameters are a tree of tensors and its input is a sequence of token
// positions. The library's own `grad` cannot be pointed at one, whatever the rulesets hold -- the
// declaration is the first wall, before any rule is asked for.
import rulesets.jvp
import rulesets.transpose
import { grad } from vjp

type Weights = {
    w: float[]
}

with <m: Weights>
func scalar_loss(x: float): float {
    let d = x - m.w[0]
    return d * d
}

func main(): int sync {
    let m = { w: [1.0] as float[] }
    println(`grad of the model at 3 = ${grad(scalar_loss)<m>(3.0):.4f}`)
    return 0
}