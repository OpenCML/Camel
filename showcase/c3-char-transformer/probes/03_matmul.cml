// WALL PROBE 03 -- the matrix product, in the *forward* transform. Every attention block and every
// MLP layer is `x @ w`, and `w @ w` is the smallest program that reaches the operator with one
// parameter and no bias.
//
// This probe asks `jvp` rather than `vjp` on purpose: `jvp` is the forward half
// (`reinterp<jvp>(f)` as a call, `stdlib/transforms.cml`), and it needs only the forward rules of
// `stdlib/rulesets/jvp.cml`. If it stops here, the wall is a *missing rule*, not the type law that
// `vjp`'s composition is stuck on today.
import { ones, sum } from tensor
import rulesets.jvp
import { jvp } from transforms

func quadratic(w: float[..]): float {
    return sum(w @ w)
}

func main(): int sync {
    let w = [[1.0, 0.5], [0.5, 1.0]] as float[2, 2]
    let (value, tangent) = jvp(quadratic)(w, ones::<float>([2, 2]))
    println(`value = ${value:.6f}`)
    println(`tangent = ${tangent:.6f}`)
    return 0
}