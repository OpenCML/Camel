// WALL PROBE 08 -- the lookup itself. A character goes in as an index and comes out as a row of
// the embedding table; the row is read, not computed, and the gradient has to be scattered back
// into the row it came from. `w[1]` is that read on the smallest table that has two rows.
import { sum } from tensor
import rulesets.jvp
import rulesets.transpose
import { vjp } from vjp

func picked(w: f32[..]): f32 {
    return sum(w[1] * w[1])
}

func main(): int sync {
    let table = [[1.0, 2.0], [3.0, 4.0]] as f32[2, 2]
    let (value, pullback) = vjp(picked)(table)
    println(`value = ${value:.4f}`)
    let cotangents = pullback(f32(1.0))
    println(`cotangent of the table = ${cotangents.0}`)
    return 0
}