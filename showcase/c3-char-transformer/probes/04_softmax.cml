// WALL PROBE 04 -- softmax, which is what makes attention attention and what turns logits into a
// distribution. The library's `tensor:softmax` is the operator; written out it is `exp`, a
// reduction over an axis and a division (stdlib/tensor_definitions.cml, the normative definition),
// so the probe reaches the first of those three the rulesets know nothing about.
import { numel, softmax, sum } from tensor
import rulesets.jvp
import rulesets.transpose
import { vjp } from vjp

func spread(x: f32[..]): f32 {
    let p = softmax(x, 1)
    let n = f32(numel(p))
    return sum(p * p) / n
}

func main(): int sync {
    let x = [[0.5, -1.0, 2.0]] as f32[1, 3]
    let (value, pullback) = vjp(spread)(x)
    println(`value = ${value:.6f}`)
    let cotangents = pullback(f32(1.0))
    println(`cotangent of x = ${cotangents.0}`)
    return 0
}