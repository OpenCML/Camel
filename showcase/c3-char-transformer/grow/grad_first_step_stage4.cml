// Stage 4's gradient at its initial point, one tensor per line: the same reading
// `grow/grad_first_step.cml` takes of stage 2, on the whole model -- twenty-five tensors, ninety-two
// elements.  One forward, one pullback, nothing trained.
//
//     camel showcase/c3-char-transformer/grow/grad_first_step_stage4.cml
//     python showcase/c3-char-transformer/baseline/grad_first_step.py --stage 4 --engine engine.txt
import { layer_norm, relu, softmax, sum, take, transpose } from tensor
import { with_grad } from autodiff

type Model = {
    emb: float[...],
    g1a: float[...],
    b1a: float[...],
    wq1: float[...],
    wk1: float[...],
    wv1: float[...],
    g1b: float[...],
    b1b: float[...],
    f1_1: float[...],
    fb1_1: float[...],
    f2_1: float[...],
    fb2_1: float[...],
    g2a: float[...],
    b2a: float[...],
    wq2: float[...],
    wk2: float[...],
    wv2: float[...],
    g2b: float[...],
    b2b: float[...],
    f1_2: float[...],
    fb1_2: float[...],
    f2_2: float[...],
    fb2_2: float[...],
    gout: float[...],
    bout: float[...]
}

func mask(): float[...] {
    return [[0.0, -1000.0], [0.0, 0.0]] as float[2, 2]
}

func attention(x: float[...], wq: float[...], wk: float[...], wv: float[...]): float[...] {
    let q = x @ wq
    let k = transpose(x @ wk)
    let a = softmax<1>(q @ k * 0.70710678118654752 + mask())
    return a @ (x @ wv)
}

with <m: Model>
func loss_of(tokens: int[...]): float {
    let x = take(m.emb, tokens)
    let attended1 = x + attention(layer_norm(x, m.g1a, m.b1a), m.wq1, m.wk1, m.wv1)
    let hidden1 = relu(layer_norm(attended1, m.g1b, m.b1b) @ m.f1_1 + m.fb1_1)
    let first = attended1 + hidden1 @ m.f2_1 + m.fb2_1
    let attended2 = first + attention(layer_norm(first, m.g2a, m.b2a), m.wq2, m.wk2, m.wv2)
    let hidden2 = relu(layer_norm(attended2, m.g2b, m.b2b) @ m.f1_2 + m.fb1_2)
    let second = attended2 + hidden2 @ m.f2_2 + m.fb2_2
    return sum(layer_norm(second, m.gout, m.bout))
}

func initial(): Model {
    return {
        emb: [[1.0, 0.5], [0.5, 1.0]] as float[2, 2],
        g1a: [1.0, 1.0] as float[], b1a: [0.0, 0.0] as float[],
        wq1: [[1.0, 0.5], [0.5, 1.0]] as float[2, 2],
        wk1: [[0.5, 1.0], [1.0, 0.5]] as float[2, 2],
        wv1: [[1.0, -1.0], [-1.0, 1.0]] as float[2, 2],
        g1b: [1.0, 1.0] as float[], b1b: [0.0, 0.0] as float[],
        f1_1: [[0.75, -0.5, 0.5, 0.25], [1.0, 0.5, -0.25, 0.75]] as float[2, 4],
        fb1_1: [0.1, -0.1, 0.05, 0.0] as float[],
        f2_1: [[1.0, 0.5], [-0.5, 1.0], [0.25, -0.25], [0.5, 1.0]] as float[4, 2],
        fb2_1: [0.0, 0.1] as float[],
        g2a: [1.0, 1.0] as float[], b2a: [0.0, 0.0] as float[],
        wq2: [[0.75, 0.0], [0.0, 0.75]] as float[2, 2],
        wk2: [[0.0, 0.5], [0.5, 0.0]] as float[2, 2],
        wv2: [[1.0, 1.0], [1.0, 1.0]] as float[2, 2],
        g2b: [1.0, 1.0] as float[], b2b: [0.0, 0.0] as float[],
        f1_2: [[0.5, 0.25, 0.75, -0.5], [0.25, 0.75, 0.5, 0.5]] as float[2, 4],
        fb1_2: [0.0, 0.05, -0.05, 0.1] as float[],
        f2_2: [[0.5, 1.0], [1.0, 0.25], [-0.25, 0.5], [0.75, -0.5]] as float[4, 2],
        fb2_2: [0.1, 0.0] as float[],
        gout: [1.0, 1.0] as float[], bout: [0.0, 0.0] as float[]
    }
}

func main(): int sync {
    let tokens = [0, 1] as int[]
    let m = initial()
    let (value, g) = with_grad(loss_of)<m>(tokens)
    `grad loss=${value:.12f}`->println
    "grad emb "->print; g.emb->println
    "grad g1a "->print; g.g1a->println
    "grad b1a "->print; g.b1a->println
    "grad wq1 "->print; g.wq1->println
    "grad wk1 "->print; g.wk1->println
    "grad wv1 "->print; g.wv1->println
    "grad g1b "->print; g.g1b->println
    "grad b1b "->print; g.b1b->println
    "grad f1_1 "->print; g.f1_1->println
    "grad fb1_1 "->print; g.fb1_1->println
    "grad f2_1 "->print; g.f2_1->println
    "grad fb2_1 "->print; g.fb2_1->println
    "grad g2a "->print; g.g2a->println
    "grad b2a "->print; g.b2a->println
    "grad wq2 "->print; g.wq2->println
    "grad wk2 "->print; g.wk2->println
    "grad wv2 "->print; g.wv2->println
    "grad g2b "->print; g.g2b->println
    "grad b2b "->print; g.b2b->println
    "grad f1_2 "->print; g.f1_2->println
    "grad fb1_2 "->print; g.fb1_2->println
    "grad f2_2 "->print; g.f2_2->println
    "grad fb2_2 "->print; g.fb2_2->println
    "grad gout "->print; g.gout->println
    "grad bout "->print; g.bout->println
    return 0
}