// C2 — an MLP trained on MNIST, written as a parameter tree.
//
// The model is a struct of four tensors, so the starting weights, the gradient and the
// optimizer state are all values of the same type: `with_grad` gives a gradient of the
// model type and `adam` consumes it without the program naming a leaf.  The training run is
// one `loop` that also collects the loss of every step, the evaluation is one call, and the
// checkpoint is `save_tree`.
//
// The batch order comes from `train_order.npy`, which make_data.py wrote: one permutation
// per epoch, shared with the PyTorch counterpart so a step sees the same rows on both
// sides.  `take` gathers the rows and the labels of a batch from it.
//
// The `// == name ==` lines delimit the sections compare.py counts, so the two
// implementations can be lined up side by side in RESULTS.md.
//
// Run (with the data prepared by make_data.py; compare.py does all of this):
//   camel train.cml --arg data=artifacts/small --arg steps=200 --arg batch=50 \
//         --arg lr=0.001 --arg log_every=20 --arg threads=1 std::macro std::nvm
module c2_mlp_mnist

// == imports ==
import { abs, argmax, cast, load_npy, numel, relu, set_num_threads, shape, slice, sum, take } from tensor
import { with_grad } from autodiff
import { adam, adam_state, softmax_cross_entropy } from nn
import { load_tree, save_tree } from ckpt
import { tree_paths, tree_map, tree_reduce } from tree
import { read_text } from fs
import { trim } from str
import { now } from time

// The parameter tree: one type, four tensors.  `b1`/`b2` broadcast over the rows of the
// batch, the same way PyTorch's `nn.Linear` adds its bias.
type Mlp = {
    w1: f32[..],
    b1: f32[..],
    w2: f32[..],
    b2: f32[..]
}

// == model ==
// x: [batch, 784] -> hidden: [batch, 128] -> logits: [batch, 10].
with <m: Mlp>
func logits(x: f32[..]): f32[..] {
    let hidden = relu(x @ m.w1 + m.b1)
    return hidden @ m.w2 + m.b2
}

// == loss ==
// The training loss of one minibatch.  Its `with` parameter is the whole parameter tree, so
// `with_grad` gives back a tree of the same shape.  The targets are integer class labels;
// the cast says so to the overload, since a tensor loaded from a file has no static dtype.
with <m: Mlp>
func loss(x: f32[..], labels: f32[..]): float {
    return softmax_cross_entropy(logits<m>(x), cast(labels, 'int64'))
}

// == data ==
// Reading the four leaves: a tree and the files `make_data.py` wrote have the same shape.
func load_model(data: string): Mlp {
    let init = data + '/init'
    return {
        w1: load_npy::<f32>(init + '/w1.npy'),
        b1: load_npy::<f32>(init + '/b1.npy'),
        w2: load_npy::<f32>(init + '/w2.npy'),
        b2: load_npy::<f32>(init + '/b2.npy')
    }
}

// == evaluate ==
// Validation: the loss over all rows at once and the fraction classified correctly.
func evaluate(m: Mlp, x: f32[..], labels: f32[..]): (float, float) {
    let value = logits<m>(x)
    let class_ids = cast(labels, 'int64')
    let correct = float(sum(argmax(value, 1) === class_ids))
    return (softmax_cross_entropy(value, class_ids), float(correct) / float(shape(x)[0]))
}

// == entry ==
// The loop collects the loss of every step; the curve is printed afterwards, outside the
// timed region, in the order the steps produced it.
func report(losses: float[], steps: int, log_every: int) {
    0..steps->filter<(i: int): bool => i % log_every == 0>->foreach<sync (i: int) => sync {
        `c2 step=${i} loss=${losses[i]:.9f}`->println
        return null
    }>
}

func main(
    data: string, steps: int, batch: int, lr: float, log_every: int, threads: int
): int sync {
    set_num_threads(threads)

    // == data ==
    let train_x = load_npy::<f32>(data + '/train_images.npy')
    let train_labels = load_npy::<i64>(data + '/train_labels.npy')
    let val_x = load_npy::<f32>(data + '/val_images.npy')
    let val_labels = load_npy::<i64>(data + '/val_labels.npy')
    let order = load_npy::<i64>(data + '/train_order.npy')
    let dataset_id = trim(read_text(data + '/dataset.id'))

    let model = load_model(data)
    let leaves = tree_paths(model)
    let params = tree_reduce<(count: int, leaf: f32[..]): int => count + numel(leaf)>(model, 0)
    let rows = shape(train_x)[0]
    let batches = rows / batch
    let before = evaluate(model, val_x, val_labels)
    `c2 config steps=${steps} batch=${batch} lr=${lr} threads=${threads} params=${params} batches=${batches}`->println
    `c2 init val_loss=${before.0:.9f} val_accuracy=${before.1:.9f}`->println

    // == train ==
    // One loop carries the model, the optimizer state, the step number and the loss curve.
    // A step's rows come from the epoch's permutation in the flat `order` tensor: every
    // epoch reshuffles, and the PyTorch counterpart walks the same order.
    let started = now()
    let loss_with_grad = with_grad(loss)
    let (trained, state, final_step, losses) = loop m = model, opt = adam_state(model), step = 0, losses = [] as float[]
        while step < steps
        do {
            let offset = (step / batches) * rows + (step % batches) * batch
            let chosen = slice(order, 0, offset, offset + batch)
            let x = take(train_x, chosen)
            let y = take(train_labels, chosen)
            let (value, gradient) = loss_with_grad<m>(x, y)
            let next = adam(m, gradient, opt, lr)
            return (next.0, next.1, step + 1, losses->append<value>)
        }
    let elapsed = now() - started
    report(losses, steps, log_every)

    // == evaluate ==
    let after = evaluate(trained, val_x, val_labels)
    `c2 trained steps=${steps} seconds=${elapsed:.6f} val_loss=${after.0:.9f} val_accuracy=${after.1:.9f}`->println

    // == checkpoint ==
    // The checkpoint is the parameter tree and the identity of the data it was trained on;
    // reading it back checks that identity and the SHA-256 of every leaf.  `save_tree`
    // replaces a directory as a whole, so the next run writes over the previous one.
    let dir = data + '/checkpoint'
    save_tree(dir, trained, dataset_id)
    let restored = load_tree::<Mlp>(dir, dataset_id) !! model
    let after_restore = evaluate(restored, val_x, val_labels)
    let drift = tree_reduce<(total: float, leaf: float): float => total + leaf>(
        tree_map<(a: f32[..], b: f32[..]): float => sum(abs(a - b))>(trained, restored), 0.0)
    `c2 checkpoint val_loss=${after_restore.0:.9f} val_accuracy=${after_restore.1:.9f} l1_drift=${drift:.9f}`->println
    `c2 leaves ${leaves}`->println
    return 0
}