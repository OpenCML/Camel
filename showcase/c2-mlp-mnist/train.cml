// C2 — an MLP trained on MNIST, written as a parameter tree.
//
// The model is a struct of four tensors, so the starting weights, the gradient and the
// optimizer state are all values of the same type: `with_grad` gives a gradient of the
// model type and `adam` consumes it without the program naming a leaf.  The whole training
// run is one `loop`, the evaluation is one call, and the checkpoint is `save_tree`.
//
// The `// == name ==` lines delimit the sections compare.py counts, so the two
// implementations can be lined up side by side in RESULTS.md.
//
// Run (with the data prepared by make_data.py; compare.py does all of this):
//   camel train.cml --arg data=artifacts/small --arg steps=200 --arg batch=50 \
//         --arg lr=0.001 --arg log_every=20 --arg threads=1 std::macro std::nvm
module c2_mlp_mnist

// == imports ==
import { Tensor, abs, argmax, load_npy, numel, relu, set_num_threads, shape, slice, sum } from tensor
import { with_grad } from autodiff
import { adam, adam_state, softmax_cross_entropy } from nn
import { load_tree, save_tree, tree_map, tree_paths, tree_reduce } from tree
import { read_text } from fs
import { trim } from str
import { now } from time

// The parameter tree: one type, four tensors.  `b1`/`b2` broadcast over the rows of the
// batch, the same way PyTorch's `nn.Linear` adds its bias.
type Mlp = {
    w1: Tensor,
    b1: Tensor,
    w2: Tensor,
    b2: Tensor
}

// == model ==
// x: [batch, 784] -> hidden: [batch, 128] -> logits: [batch, 10].
with <m: Mlp>
func logits(x: Tensor): Tensor {
    let hidden = relu(x @ m.w1 + m.b1)
    return hidden @ m.w2 + m.b2
}

// == loss ==
// The training loss of one minibatch.  Its `with` parameter is the whole parameter tree,
// so `with_grad` gives back a tree of the same shape.  The targets are one-hot rows.
with <m: Mlp>
func loss(x: Tensor, targets: Tensor): float {
    return softmax_cross_entropy(logits<m>(x), targets)
}

// == data ==
// Reading the four leaves: a tree and the files `make_data.py` wrote have the same shape.
func load_model(data: string): Mlp {
    let init = data + '/init'
    return {
        w1: load_npy(init + '/w1.npy'),
        b1: load_npy(init + '/b1.npy'),
        w2: load_npy(init + '/w2.npy'),
        b2: load_npy(init + '/b2.npy')
    }
}

// == evaluate ==
// Validation: the loss over all rows at once and the fraction classified correctly.
func evaluate(m: Mlp, x: Tensor, targets: Tensor): (float, float) {
    let value = logits<m>(x)
    let correct = sum(argmax(value, 1) == argmax(targets, 1))
    return (softmax_cross_entropy(value, targets), float(correct) / float(shape(x)[0]))
}

// == entry ==
func main(
    data: string, steps: int, batch: int, lr: float, log_every: int, threads: int
): int sync {
    set_num_threads(threads)

    // == data ==
    let train_x = load_npy(data + '/train_images.npy')
    let train_targets = load_npy(data + '/train_targets.npy')
    let val_x = load_npy(data + '/val_images.npy')
    let val_targets = load_npy(data + '/val_targets.npy')
    let dataset_id = trim(read_text(data + '/dataset.id'))

    let model = load_model(data)
    let leaves = tree_paths(model)
    let params = tree_reduce<(count: int, leaf: Tensor): int => count + numel(leaf)>(model, 0)
    let batches = shape(train_x)[0] / batch
    let before = evaluate(model, val_x, val_targets)
    `c2 config steps=${steps} batch=${batch} lr=${lr} threads=${threads} params=${params} batches=${batches}`->println
    `c2 init val_loss=${before.0:.9f} val_accuracy=${before.1:.9f}`->println

    // == train ==
    // One loop carries the model, the optimizer state and the step number.  The batches
    // are contiguous slices of the shuffled file, so a step needs no shuffling machinery.
    let started = now()
    let loss_with_grad = with_grad(loss)
    let (trained, state) = loop m = model, opt = adam_state(model), step = 0
        while step < steps
        do sync {
            let start = (step % batches) * batch
            let x = slice(train_x, 0, start, start + batch)
            let y = slice(train_targets, 0, start, start + batch)
            let (value, gradient) = loss_with_grad<m>(x, y)
            let next = adam(m, gradient, opt, lr)
            if step % log_every == 0 then {
                `c2 step=${step} loss=${value:.9f}`->println
            }
            return (next.0, next.1, step + 1)
        }
    let elapsed = now() - started

    // == evaluate ==
    let after = evaluate(trained, val_x, val_targets)
    `c2 trained steps=${steps} seconds=${elapsed:.6f} val_loss=${after.0:.9f} val_accuracy=${after.1:.9f}`->println

    // == checkpoint ==
    // The checkpoint is the parameter tree and the identity of the data it was trained on;
    // reading it back checks that identity and the SHA-256 of every leaf.  `save_tree`
    // refuses a directory that already exists, so a second run needs a fresh `data` copy
    // (compare.py removes the directory first); see the README's "遇到的问题".
    let dir = data + '/checkpoint'
    save_tree(dir, trained, dataset_id)
    let restored = load_tree::<Mlp>(dir, dataset_id) !! model
    let after_restore = evaluate(restored, val_x, val_targets)
    let drift = tree_reduce<(total: float, leaf: float): float => total + leaf>(
        tree_map<(a: Tensor, b: Tensor): float => sum(abs(a - b))>(trained, restored), 0.0)
    `c2 checkpoint val_loss=${after_restore.0:.9f} val_accuracy=${after_restore.1:.9f} l1_drift=${drift:.9f}`->println
    `c2 leaves ${leaves}`->println
    return 0
}
