// D4 -- the self-play half, as the smallest loop that runs.
//
// The search half (`search.cml`) answers "what is this position worth" by playouts. The other half
// of the showcase design's D4 is the learned part: a policy/value network, self-play, and a step of
// training on what self-play produced. This program is that loop reduced to one game and one step:
// it plays a game to the end, reads the result, and takes one Adam step on the network's value
// prediction for the final board. It prints the result and the loss before and after.
//
// What it is not: a trainer. One game, one step, no replay buffer, no search in the policy (the
// move is scripted -- X takes the first free place, O the last), and no claim that the value head
// has learned anything. That is deliberate: the example's missing half is delivered as the smallest
// closed loop that runs, and the second commit is what adds games and steps.
//
// Run:
//   camel showcase/d4-mcts/selfplay.cml

import { relu, reshape, sum } from tensor
import { fold, key, normal } from random
import { with_grad } from autodiff
import { adam, adam_state } from nn

let LINES: int[][] = [
    [0, 1, 2], [3, 4, 5], [6, 7, 8],
    [0, 3, 6], [1, 4, 7], [2, 5, 8],
    [0, 4, 8], [2, 4, 6]
]

// The player whose line is complete, or 0 when neither has one (the same rule as `search.cml`).
func winner(board: int[]): int {
    return loop found = 0 for line in LINES while found == 0 do {
        let mark = board[line[0]]
        if mark != 0 && mark == board[line[1]] && mark == board[line[2]] then mark else 0
    }
}

// A value network over the nine places: 9 -> 16 -> 1. One number, the position's expected result.
type Net = {
    w1: float[..],
    b1: float[..],
    w2: float[..]
}

with <m: Net>
func value(board: int[]): float {
    let x = reshape<[1, 9]>([float(board[i]) for i in 0..9] as float[])
    return sum(relu(x @ m.w1 + m.b1) * m.w2)
}

with <m: Net>
func loss_of(board: int[], target: float): float {
    let predicted = value<m>(board)
    let difference = predicted - target
    return difference * difference
}

// One game, scripted: X takes the first free place, O takes the last. The result is X's score --
// 1 for a win, 0.5 for a draw, 0 for a loss -- which is what a value head is trained against.
func selfplay(): (int[], float) {
    let (board, moves) = loop b = [0, 0, 0, 0, 0, 0, 0, 0, 0] as int[], turn = 0
        while turn < 9 && winner(b) == 0
        do {
            let places = (0..9)->filter<(i: int): bool => b[i] == 0>
            let pick = places[0]
            let mark = turn % 2 + 1
            let nextb = (0..9)->map<(i: int): int => if i == pick then mark else b[i]>
            return (nextb, turn + 1)
        }
    let settled = winner(board)
    let result = if settled == 0 then 0.5 else if settled == 1 then 1.0 else 0.0
    let _ = moves
    return (board, result)
}

func main(): int sync {
    let k = key(42)
    let model: Net = {
        w1: normal::<float><shape: [9, 16]>(fold(k, 1)) * 0.3,
        b1: reshape<[16]>([0.0 for i in 0..16] as float[]),
        w2: reshape<[16]>([0.0 for i in 0..16] as float[])
    }
    let (board, result) = selfplay()
    let before = loss_of<model>(board, result)
    let grad = with_grad(loss_of)
    let (value, gradient) = grad<model>(board, result)
    let opt = adam_state(model)
    let next = adam(model, gradient, opt, 0.01)
    let after = loss_of<next.0>(board, result)
    let _ = value
    `mcts selfplay squares=9 result=${result:.1f} loss0=${before:.6f} loss1=${after:.6f}`->println
    return 0
}