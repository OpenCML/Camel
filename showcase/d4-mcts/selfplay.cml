// D4 -- the self-play half, at a size where its loss curve is a reading.
//
// The first version of this file was the smallest closed loop that runs: one scripted game, the
// value head's prediction for its final board, and one Adam step, with the loss before and after.
// This version is that same loop enlarged and nothing else -- sixteen games instead of one, ten
// steps instead of one, and both written out as a sequence. Still no replay buffer, still no search
// in the policy, no new operator.
//
// The games stay scripted: a player takes a free place drawn from the game's own key rather than
// the first one, so that sixteen games are sixteen samples and not one sample sixteen times. The
// target is still the game's result -- X's score, 1 for a win, 0.5 for a draw, 0 for a loss -- and
// the policy is still not the network.
//
// What the enlargement buys, and what it does not: it buys a loss sequence, which this program
// prints, and it raises the one question a bigger number raises -- whether the cost stayed linear
// in games x steps. `RESULTS.md`'s "Self-play" section records that reading and the losses of the
// run it was taken from. It does not buy a player: ten steps on sixteen scripted games make a curve
// visible, not a policy worth searching with.
//
// Run:
//   camel showcase/d4-mcts/selfplay.cml

import { relu, reshape, sum } from tensor
import { Key, choice, fold, key, normal } from random
import { with_grad } from autodiff
import { adam, adam_state } from nn

let LINES: int[][] = [
    [0, 1, 2], [3, 4, 5], [6, 7, 8],
    [0, 3, 6], [1, 4, 7], [2, 5, 8],
    [0, 4, 8], [2, 4, 6]
]

// The player whose line is complete, or 0 when neither has one (the same rule as `search.cml`).
func winner(board: int[]): int {
    return loop found = 0 for line in LINES while found == 0 do {
        let mark = board[line[0]]
        if mark != 0 && mark == board[line[1]] && mark == board[line[2]] then mark else 0
    }
}

// A value network over the nine places: 9 -> 16 -> 1. One number, the position's expected result.
type Net = {
    w1: float[..],
    b1: float[..],
    w2: float[..]
}

with <m: Net>
func value(board: int[]): float {
    let x = reshape<[1, 9]>([float(board[i]) for i in 0..9] as float[])
    return sum(relu(x @ m.w1 + m.b1) * m.w2)
}

with <m: Net>
func loss_of(board: int[], target: float): float {
    let predicted = value<m>(board)
    let difference = predicted - target
    return difference * difference
}

// The batch: one loss per game, averaged. This is what a step descends, and the reason the run
// needs more than one game -- a step on one sample is a step on noise.
with <m: Net>
func batch_loss(boards: int[][], targets: float[]): float {
    let total = loop acc = 0.0 for i in 0..len(boards) do {
        return acc + loss_of<m>(boards[i], targets[i])
    }
    return total / float(len(boards))
}

// One game, scripted: each player takes a free place drawn from the game's key (no search). The
// result is X's score, which is what a value head is trained against.
func selfplay(k: Key): (int[], float) {
    let (board, moves) = loop b = [0, 0, 0, 0, 0, 0, 0, 0, 0] as int[], turn = 0
        while turn < 9 && winner(b) == 0
        do {
            let places = (0..9)->filter<(i: int): bool => b[i] == 0>
            let pick = places->choice<fold(k, turn)>
            let mark = turn % 2 + 1
            let nextb = (0..9)->map<(i: int): int => if i == pick then mark else b[i]>
            return (nextb, turn + 1)
        }
    let settled = winner(board)
    let result = if settled == 0 then 0.5 else if settled == 1 then 1.0 else 0.0
    let _ = moves
    return (board, result)
}

func main(): int sync {
    let games = 16
    let steps = 10
    let k = key(42)
    let model: Net = {
        w1: normal::<float><shape: [9, 16]>(fold(k, 1)) * 0.3,
        b1: reshape<[16]>([0.0 for i in 0..16] as float[]),
        w2: reshape<[16]>([0.0 for i in 0..16] as float[])
    }
    // Sixteen games first: the batch a step descends is fixed while the model moves, which is what
    // makes the losses of the ten steps comparable with each other. The loop carries the games'
    // boards, their results and the count; the count is named `_` because the declaration that
    // takes the two arrays has no use for it (and a name too few is a diagnostic now).
    let (boards, results, _) = loop bs = [] as int[][], rs = [] as float[], g = 0
        while g < games
        do {
            let (b, r) = selfplay(fold(k, g + 1))
            return (concat(bs, [b]), concat(rs, [r]), g + 1)
        }
    let step_of = with_grad(batch_loss)
    // Ten steps, each one over the whole batch. The loop carries the model, the optimizer's state
    // and the losses it has taken so far; the tuple it returns has one entry per carried name, in
    // the order they were written, so the four names below must be four.
    let (trained, trained_opt, losses, done) = loop m = model, opt = adam_state(model), ls = [] as float[], s = 0
        while s < steps
        do {
            let (loss, gradient) = step_of<m>(boards, results)
            let (next, next_opt) = adam(m, gradient, opt, 0.01)
            return (next, next_opt, concat(ls, [loss]), s + 1)
        }
    let _ = trained
    let _ = trained_opt
    let _ = done
    let curve = '{:.6f}'->format<losses>
    let scores = '{:.1f}'->format<results>
    `mcts selfplay games=${games} steps=${steps} squares=9 results=${scores}`->println
    `mcts selfplay losses=${curve}`->println
    return 0
}
