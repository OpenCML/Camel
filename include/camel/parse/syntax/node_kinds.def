// The node kinds of the concrete syntax tree, one per production of the grammar
// (docs/language/08_top_level_and_grammar.md gives the productions under the same names;
// scripts/check-grammar.mjs checks that the three agree: this table, the parser's functions and
// the reference).
//
//   CAMEL_NODE(Name, Category)
//
// Category says what the node can stand for, which is how a parent finds its children without
// knowing their exact kind:
//   Expr   an expression (what `dataExpr` derives)
//   Type   a type expression (what `typeExpr` derives), or an argument of a type
//   Other  everything else: declarations, statements, lists, clauses
//
// A production that only passes to another one leaves no node: `a + b` is an AdditiveExpr whose
// operands are the two RefData nodes directly, not a chain of one-child nodes down to them.
//
// This file has no include guard: it is included with the macro defined.

CAMEL_NODE(Error, Other)               // tokens skipped while recovering from a syntax error

CAMEL_NODE(Program, Other)             // SEP? (decl SEP?)* EOF
CAMEL_NODE(StmtList, Other)            // stmt (SEP? stmt)* SEP?
CAMEL_NODE(ModuleName, Other)          // ('.' | '..' | '...')? IDENTIFIER ('.' IDENTIFIER)*
CAMEL_NODE(ModuleDecl, Other)          // 'module' identDef
CAMEL_NODE(ImportDecl, Other)          // 'import' (moduleName | (identDef | bracedImports) 'from' moduleName)
CAMEL_NODE(BracedImports, Other)       // '{' (importItem (',' importItem)*)? ','? '}'
CAMEL_NODE(ImportItem, Other)          // identDef ('as' identDef)?
CAMEL_NODE(ExportDecl, Other)          // 'export' (dataDecl | typeDecl | bracedIdents)
CAMEL_NODE(ResourceDecl, Other)        // 'export'? 'resource' identDef ('=' bracketIdents | 'unordered')?
CAMEL_NODE(UsingNamespaceDecl, Other)  // 'using' 'namespace' identRef
CAMEL_NODE(NamespaceDecl, Other)       // 'namespace' identRef '{' SEP? (namespaceItem SEP?)* '}'
CAMEL_NODE(BlockStmt, Other)           // 'wait' stmtBlock | frontMatter? ('#' tagUse)* ('sync'? stmtBlock | funcDecl | typeDecl)
CAMEL_NODE(StmtBlock, Other)           // 'sync'? '{' stmtList? '}'
CAMEL_NODE(FuncAnno, Other)            // '@' identRef (angledValues | parentIdents)?
CAMEL_NODE(TagDecl, Other)             // 'export'? 'tag' identDef angledParams? 'on' tagPositions ('read_by' tagReaders)? | 'export'? 'tag' identDef '=' bracketIdents
CAMEL_NODE(TagPositions, Other)        // identDef (',' identDef)* ','?
CAMEL_NODE(TagReaders, Other)          // identRef (',' identRef)* ','?
CAMEL_NODE(TagUse, Other)              // '#' (tagRef | '[' tagRef (',' tagRef)* ','? ']')
CAMEL_NODE(TagRef, Other)              // identRef angledValues?
CAMEL_NODE(FuncDecl, Other)            // frontMatter? ('with' angledParams)? 'export'? modifiers? 'func' (identRef | operatorName) parentParams (':' typeExpr)? resourceClause? stmtBlock? (no block: the declaration of a C++ operator, design principles 6.4)
CAMEL_NODE(ResourceClause, Other)      // 'uses' identRef (',' identRef)* | 'pure'
CAMEL_NODE(OperatorName, Other)        // IDENTIFIER (OPERATOR | '[' ']'): the name `operator`, read so only after 'func' (provisional notation)
CAMEL_NODE(RuleDecl, Other)            // 'export'? IDENTIFIER identDef ruleContext? parentParams '{' ruleBody '}' (IDENTIFIER dataExpr)?
CAMEL_NODE(RuleContext, Other)         // '<' identDef (',' identDef)* ','? '>'
CAMEL_NODE(RuleBody, Other)            // dataExpr ('=>' | '<=>') dataExpr
CAMEL_NODE(AnalysisDecl, Other)        // 'export'? 'analysis' identDef ':' typeExpr '{' analysisClause* '}'
CAMEL_NODE(AnalysisClause, Other)      // 'initial' '=>' dataExpr | ('join' | 'widen') '(' identList ')' '=>' dataExpr | 'on' '(' ('const' identDef ':' typeExpr | dataExpr) ')' '=>' dataExpr
CAMEL_NODE(DataDecl, Other)            // ('let' | 'var') carrier (':' typeList)? '=' dataList
CAMEL_NODE(TypeDecl, Other)            // 'type' identRef ('=' | '<' identDef (',' identDef)* ','? ('>' '=' | '>=')) (typeExpr | STRING), with the tag uses before it
CAMEL_NODE(RetStmt, Other)             // ('return' | 'throw') dataList
CAMEL_NODE(Modifiers, Other)           // 'sync'+
CAMEL_NODE(ParentIdents, Other)        // '(' identList? ','? ')'
CAMEL_NODE(BracedIdents, Other)        // '{' identList? ','? '}'
CAMEL_NODE(BracketIdents, Other)       // '[' identList? ','? ']'
CAMEL_NODE(KeyTypePair, Other)         // tagUse* identDef ':' typeExpr
CAMEL_NODE(KeyValuePair, Other)        // identDef ':' dataExpr | '...' dataExpr
CAMEL_NODE(KeyParamPair, Other)        // 'var'? identDef ':' typeExpr ('=' dataExpr)?
CAMEL_NODE(DataList, Other)            // dataExpr (',' dataExpr)*
CAMEL_NODE(IdentList, Other)           // identDef (',' identDef)*
CAMEL_NODE(IndexValues, Other)         // indexValue (',' indexValue)*
CAMEL_NODE(PairedValues, Other)        // keyValuePair (',' keyValuePair)*
CAMEL_NODE(PairedParams, Other)        // keyParamPair (',' keyParamPair)*
CAMEL_NODE(ArgumentList, Other)        // indexValues (',' pairedValues)? | pairedValues
CAMEL_NODE(Indices, Other)             // '[' (sliceIndices | dataExpr) (',' (sliceIndices | dataExpr))* ']'
CAMEL_NODE(SliceIndices, Other)        // dataExpr? ':' dataExpr? (':' dataExpr?)?, a part not written left out
CAMEL_NODE(ParentParams, Other)        // '(' pairedParams? ','? ')'
CAMEL_NODE(ParentArgues, Other)        // '(' argumentList? ','? ')'
CAMEL_NODE(AngledParams, Other)        // '<' pairedParams? ','? '>'
CAMEL_NODE(AngledValues, Other)        // '<' argumentList? ','? '>'
CAMEL_NODE(TypeArguments, Other)       // '::' '<' (typeList | namedTypeArgument (',' namedTypeArgument)*) ','? '>'
CAMEL_NODE(NamedTypeArgument, Other)   // IDENTIFIER '=' typeExpr
CAMEL_NODE(Pattern, Other)             // identRef (identDef | enumTuplePattern | enumStructPattern)? | literal | '(' (dataList | identList)? ','? ')' | '{' (pairedValues | identList)? ','? '}' | '_'
CAMEL_NODE(EnumTuplePattern, Other)    // '(' (pattern (',' pattern)*)? ','? ')', after a variant path
CAMEL_NODE(EnumStructPattern, Other)   // '{' (IDENTIFIER (':' pattern)? (',' ...)*)? ','? '}', after a variant path
CAMEL_NODE(MatchCase, Other)           // 'case' pattern ('|' pattern)* '=>' blockExpr
CAMEL_NODE(TypeCasePattern, Other)     // 'struct' | 'tuple' | '#' 'leaf' | '_'
CAMEL_NODE(TypeCase, Other)            // 'case' typeCasePattern ('|' typeCasePattern)* '=>' blockExpr
CAMEL_NODE(CatchClause, Other)         // 'catch' identDef ':' typeExpr stmtBlock
CAMEL_NODE(MemberAccess, Other)        // '.' (IDENTIFIER | INTEGER | REAL), after a call, a binding or an index
CAMEL_NODE(TypeList, Other)            // typeExpr (',' typeExpr)*
CAMEL_NODE(IdentDef, Other)            // IDENTIFIER
CAMEL_NODE(IdentRef, Other)            // (IDENTIFIER '::')* IDENTIFIER, where a name is required

CAMEL_NODE(SpreadValue, Expr)          // '...' dataExpr (an indexValue with the marker)
CAMEL_NODE(RestValue, Expr)            // '..' dataExpr (a rest argument, expanded at the call)
CAMEL_NODE(WaitExpr, Expr)             // 'wait' assignExpr
CAMEL_NODE(IfExpr, Expr)               // 'if' logicalOrExpr 'then' blockExpr ('else' blockExpr)?
CAMEL_NODE(MatchExpr, Expr)            // 'match' logicalOrExpr '{' matchCase+ '}'
CAMEL_NODE(MatchTypeExpr, Expr)        // 'match' 'type' typeExpr '{' typeCase* '}'
CAMEL_NODE(StaticForExpr, Expr)        // 'static' 'for' '(' identDef ',' identDef ')' 'in' 'fields' typeExpr '=>' blockExpr
CAMEL_NODE(StaticLoopExpr, Expr)       // 'static' 'loop' loopState (',' loopState)* 'for' '(' identDef ',' identDef ')' 'in' 'fields' typeExpr 'do' blockExpr
CAMEL_NODE(TryExpr, Expr)              // 'try' stmtBlock catchClause+ ('finally' stmtBlock)?
CAMEL_NODE(LoopExpr, Expr)             // 'loop' loopState (',' loopState)* loopFor? loopWhile? 'do' blockExpr
CAMEL_NODE(LoopState, Other)           // identDef '=' logicalOrExpr
CAMEL_NODE(LoopFor, Other)             // 'for' identDef 'in' logicalOrExpr
CAMEL_NODE(LoopWhile, Other)           // 'while' logicalOrExpr
CAMEL_NODE(AssignExpr, Expr)           // logicalOrExpr (('=' | '+=' | ...) logicalOrExpr)?
CAMEL_NODE(LogicalOrExpr, Expr)        // logicalAndExpr ('||' logicalAndExpr)*
CAMEL_NODE(LogicalAndExpr, Expr)       // orExpr ('&&' orExpr)*
CAMEL_NODE(OrExpr, Expr)               // andExpr ('|' andExpr)*
CAMEL_NODE(AndExpr, Expr)              // equalityExpr ('&' equalityExpr)*
CAMEL_NODE(EqualityExpr, Expr)         // relationalExpr (('===' | '!==' | '==' | '!=') relationalExpr)*
CAMEL_NODE(RelationalExpr, Expr)       // additiveExpr (('<' | '>' | '<=' | '>=') additiveExpr)*
CAMEL_NODE(AdditiveExpr, Expr)         // multiplicativeExpr (('+' | '-') multiplicativeExpr)*
CAMEL_NODE(MultiplicativeExpr, Expr)   // powerExpr (('*' | '/' | '@' | '%') powerExpr)*
CAMEL_NODE(PowerExpr, Expr)            // nullableExpr ('^' powerExpr)?; also the operand of a prefix operator
CAMEL_NODE(NullableExpr, Expr)         // unaryExpr (('??' | '!!') dataExpr)?
CAMEL_NODE(CastExpr, Expr)             // linkExpr ('as' | 'is') typeExpr
CAMEL_NODE(UnaryExpr, Expr)            // ('!' | '~') linkExpr, '-' negPower
CAMEL_NODE(LinkExpr, Expr)             // negExpr (('->' | '?->') compExpr)*
CAMEL_NODE(CompExpr, Expr)             // annoExpr (('..' | '?..') annoExpr)*
CAMEL_NODE(AnnoExpr, Expr)             // accessExpr (indices | parentArgues | structData | angledValues | typeArguments | '!' | memberAccess)*
CAMEL_NODE(AccessExpr, Expr)           // primaryData ('.' (IDENTIFIER | INTEGER | REAL))*
CAMEL_NODE(RefData, Expr)              // identRef, as an operand
CAMEL_NODE(ConstasData, Expr)          // 'constas' identDef: binds a named dimension (design principles 5.4)
CAMEL_NODE(Literal, Expr)              // ('+' | '-')? (INTEGER | REAL) | STRING | MULTI_STR | FSTRING | 'true' | 'false' | 'null'
CAMEL_NODE(ArrayData, Expr)            // '[' ((indexValues ','?) | dataExpr 'for' identRef 'in' dataExpr ('if' dataExpr)?)? ']'
CAMEL_NODE(StructData, Expr)           // '{' (pairedValues ','?)? '}'
CAMEL_NODE(TupleData, Expr)            // '(' dataList? ','? ')'; with one element and no comma, the parenthesized expression
CAMEL_NODE(FuncData, Expr)             // modifiers? angledParams? parentParams (':' typeExpr)? '=>' blockExpr

CAMEL_NODE(TypeExpr, Type)             // interType ('?' | '!')*
CAMEL_NODE(InterType, Type)            // diffType ('&' diffType)*
CAMEL_NODE(DiffType, Type)             // keyUnionDiffType ('\\' keyUnionDiffType)*
CAMEL_NODE(KeyUnionDiffType, Type)     // keyInterType (('+' | '-') keyInterType)*
CAMEL_NODE(KeyInterType, Type)         // typeUnit ('^' typeUnit)*
CAMEL_NODE(TypeUnit, Type)             // identDef 'of' arrayType
CAMEL_NODE(ArrayType, Type)            // specType arrayDim+
CAMEL_NODE(ArrayDim, Type)             // '[' (']' | arrayDimItem (',' arrayDimItem)*) ']'
                                       //   arrayDimItem: '?' | '..' identDef? | dataExpr
CAMEL_NODE(SpecType, Type)             // primaryType '<' typeOrData (',' typeOrData)* '>'
CAMEL_NODE(ConstData, Type)            // 'const' dataExpr (a typeOrData that is data)
CAMEL_NODE(StructType, Type)           // '{' (keyTypePair (',' keyTypePair)*)? ','? '}'
CAMEL_NODE(RefType, Type)              // identRef, as a type
CAMEL_NODE(ParenType, Type)            // '(' typeExpr ')'
CAMEL_NODE(TupleType, Type)            // '(' typeList? ','? ')'
CAMEL_NODE(FuncType, Type)             // modifiers? angledParams? parentParams '=>' typeExpr resourceClause?
CAMEL_NODE(TypeOfType, Type)           // 'typeof' dataExpr
CAMEL_NODE(TypeAsType, Type)           // 'typeas' identDef
CAMEL_NODE(EnumType, Type)             // 'enum' '{' (enumVariant (',' enumVariant)*)? ','? '}'
CAMEL_NODE(EnumVariant, Other)         // identDef ('(' typeList? ','? ')' | '{' (enumField (',' enumField)*)? ','? '}')?
CAMEL_NODE(EnumField, Other)           // identDef ':' typeExpr
CAMEL_NODE(TupleParam, Other)          // '(a, b)': a lambda parameter destructured as a tuple
