// The tokens of Camel: the one table the lexer, the parser, the dumps, the editor grammar check
// (scripts/check-keywords.mjs) and the language reference are generated from or checked against.
//
//   CAMEL_TOKEN(Name, "display")           a token without fixed text
//   CAMEL_KEYWORD(Name, "text", Group)     a reserved word; Group is the row of the keyword
//                                          table in the language reference (2.4)
//   CAMEL_PUNCT(Name, "text")              an operator or a separator
//
// This file has no include guard: it is included with the three macros defined.

CAMEL_TOKEN(Eof, "<EOF>")
CAMEL_TOKEN(Error, "<error>")            // text no token starts with, or an unclosed string
CAMEL_TOKEN(Command, "<command>")        // `#` to the end of the line
CAMEL_TOKEN(LineComment, "<comment>")    // `//` to the end of the line
CAMEL_TOKEN(DocComment, "<comment>")     // `///` to the end of the line: documentation of the
                                         // declaration right below (not `////`)
CAMEL_TOKEN(BlockComment, "<comment>")   // `/* ... */`
CAMEL_TOKEN(Identifier, "a name")
CAMEL_TOKEN(Integer, "a number")
CAMEL_TOKEN(Real, "a number")
CAMEL_TOKEN(String, "a string")          // '...' or "..."
CAMEL_TOKEN(MultiStr, "a string")        // '''...''' or """..."""
CAMEL_TOKEN(FString, "a string")         // `...`

CAMEL_KEYWORD(KwAs, "as", Type)
CAMEL_KEYWORD(KwIs, "is", Reserved)
CAMEL_KEYWORD(KwLet, "let", Declaration)
CAMEL_KEYWORD(KwVar, "var", Declaration)
CAMEL_KEYWORD(KwFrom, "from", Declaration)
CAMEL_KEYWORD(KwFunc, "func", Declaration)
CAMEL_KEYWORD(KwType, "type", Declaration)
CAMEL_KEYWORD(KwEnum, "enum", Reserved)
CAMEL_KEYWORD(KwWith, "with", Declaration)
CAMEL_KEYWORD(KwWait, "wait", Control)
CAMEL_KEYWORD(KwConst, "const", Type)
CAMEL_KEYWORD(KwKeyof, "keyof", Reserved)
CAMEL_KEYWORD(KwReturn, "return", Control)
CAMEL_KEYWORD(KwModule, "module", Declaration)
CAMEL_KEYWORD(KwImport, "import", Declaration)
CAMEL_KEYWORD(KwExport, "export", Declaration)
CAMEL_KEYWORD(KwTypeas, "typeas", Type)
CAMEL_KEYWORD(KwTypeof, "typeof", Reserved)
CAMEL_KEYWORD(KwUsing, "using", Declaration)
CAMEL_KEYWORD(KwNamespace, "namespace", Declaration)
CAMEL_KEYWORD(KwIf, "if", Control)
CAMEL_KEYWORD(KwThen, "then", Control)
CAMEL_KEYWORD(KwElse, "else", Control)
CAMEL_KEYWORD(KwMatch, "match", Control)
CAMEL_KEYWORD(KwCase, "case", Control)
CAMEL_KEYWORD(KwFor, "for", Control)
CAMEL_KEYWORD(KwIn, "in", Control)
CAMEL_KEYWORD(KwOf, "of", Reserved)
CAMEL_KEYWORD(KwTry, "try", Reserved)
CAMEL_KEYWORD(KwCatch, "catch", Reserved)
CAMEL_KEYWORD(KwFinally, "finally", Reserved)
CAMEL_KEYWORD(KwThrow, "throw", Control)
CAMEL_KEYWORD(KwLoop, "loop", Control)
CAMEL_KEYWORD(KwWhile, "while", Control)
CAMEL_KEYWORD(KwDo, "do", Control)
CAMEL_KEYWORD(KwSync, "sync", Control)
CAMEL_KEYWORD(KwMacro, "macro", Control)
CAMEL_KEYWORD(KwInner, "inner", Reserved)
CAMEL_KEYWORD(KwOuter, "outer", Reserved)
CAMEL_KEYWORD(KwAtomic, "atomic", Reserved)
CAMEL_KEYWORD(KwShared, "shared", Reserved)
CAMEL_KEYWORD(KwNull, "null", Literal)
CAMEL_KEYWORD(KwTrue, "true", Literal)
CAMEL_KEYWORD(KwFalse, "false", Literal)

CAMEL_PUNCT(Semi, ";")
CAMEL_PUNCT(Comma, ",")
CAMEL_PUNCT(Colon, ":")
CAMEL_PUNCT(ColonColon, "::")
CAMEL_PUNCT(Dot, ".")
CAMEL_PUNCT(DotDot, "..")
CAMEL_PUNCT(Ellipsis, "...")
CAMEL_PUNCT(LParen, "(")
CAMEL_PUNCT(RParen, ")")
CAMEL_PUNCT(LBracket, "[")
CAMEL_PUNCT(RBracket, "]")
CAMEL_PUNCT(LBrace, "{")
CAMEL_PUNCT(RBrace, "}")
// `<` that touches the token before it, where that token can end the callee of an angle-bracket
// argument list: it opens such a list (rule 1). Every other `<` is Lt.
CAMEL_PUNCT(LAngle, "<")
CAMEL_PUNCT(Lt, "<")
CAMEL_PUNCT(Gt, ">")
CAMEL_PUNCT(LtEq, "<=")
CAMEL_PUNCT(GtEq, ">=")
CAMEL_PUNCT(EqEq, "==")
CAMEL_PUNCT(NotEq, "!=")
CAMEL_PUNCT(EqEqEq, "===")
CAMEL_PUNCT(NotEqEq, "!==")
CAMEL_PUNCT(Assign, "=")
CAMEL_PUNCT(PlusAssign, "+=")
CAMEL_PUNCT(MinusAssign, "-=")
CAMEL_PUNCT(StarAssign, "*=")
CAMEL_PUNCT(SlashAssign, "/=")
CAMEL_PUNCT(PercentAssign, "%=")
CAMEL_PUNCT(CaretAssign, "^=")
CAMEL_PUNCT(AtAssign, "@=")
CAMEL_PUNCT(AmpAssign, "&=")
CAMEL_PUNCT(PipeAssign, "|=")
CAMEL_PUNCT(Plus, "+")
CAMEL_PUNCT(Minus, "-")
CAMEL_PUNCT(Star, "*")
CAMEL_PUNCT(Slash, "/")
CAMEL_PUNCT(Percent, "%")
CAMEL_PUNCT(Caret, "^")
CAMEL_PUNCT(At, "@")
CAMEL_PUNCT(Hash, "#")
CAMEL_PUNCT(Amp, "&")
CAMEL_PUNCT(Pipe, "|")
CAMEL_PUNCT(AmpAmp, "&&")
CAMEL_PUNCT(PipePipe, "||")
CAMEL_PUNCT(Bang, "!")
CAMEL_PUNCT(BangBang, "!!")
CAMEL_PUNCT(Tilde, "~")
CAMEL_PUNCT(Question, "?")
CAMEL_PUNCT(QuestionQuestion, "??")
CAMEL_PUNCT(Arrow, "->")
CAMEL_PUNCT(QuestionArrow, "?->")
CAMEL_PUNCT(QuestionDotDot, "?..")
CAMEL_PUNCT(FatArrow, "=>")
CAMEL_PUNCT(Backslash, "\\")
CAMEL_PUNCT(Underscore, "_")             // the wildcard pattern; `_x` is a name
