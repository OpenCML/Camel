type Shape = enum {
    Circle(float),
    Rect { w: float, h: float },
    Empty,
}

func f(s: Shape): float {
    return match s {
        case Shape::Circle(r) => r
        case Shape::Circle(r) => r * 2.0
        case Shape::Rect { w, h } => w * h
        case Shape::Empty => 0.0
        case _ => -1.0
        case Shape::Circle(r) => r
    }
}

func main(): void sync {
    println(f(Shape::Circle(1.0)))
}