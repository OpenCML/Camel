type Shape = enum {
    Circle(float),
    Rect { w: float, h: float },
    Empty,
}

func bad1(s: Shape): float {
    return match s {
        case Shape::Circle(r) => r
    }
}

func bad2(s: Shape): void sync {
    println(s.w)
}

func main(): void sync {
    let a = Shape::Circle(1.0, 2.0)
    let b = Shape::Rect { w: 1.0 }
    let c = Shape::Circl(1.0)
}