// `map`, `filter` and `reduce` over a large array with element functions of a few built-in
// operators each: the work of an element is far smaller than a task.

func main(): int sync {
    let n = 300000
    let values = (0..n)->map<(x: int): int => x * x % 1000 + 1>
    let kept = values->filter<(x: int): bool => x % 3 == 0>
    let total = kept->reduce<(acc: int, cur: int): int => acc + cur, 0>
    println(len(kept))
    println(total)
    return 0
}
