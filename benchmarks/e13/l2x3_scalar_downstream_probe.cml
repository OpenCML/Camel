/**
 * E13/T5 dissection X3: scalar branch arms whose result feeds a downstream op
 * (not returned directly as the loss). Companion to X1 (scalar arms returned
 * directly, exports fine) and X2 (tensor arms, fails).
 */
module e13_l2x3_scalar_downstream

import { relu, mean, reshape } from tensor
import { with_grad } from autodiff
import { sgd } from nn
import { get_env } from env
import { export_model } from onnx

type Mlp = { w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..] }

with <m: Mlp>
func loss(x: f32[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    let s = float(mean(y * y))
    let z = if s > 1.0 then s * 2.0 else s
    return z * 3.0
}

func step(m: Mlp, x: f32[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func main(): int sync {
    let m = {
        w1: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        b1: reshape([0.1, 0.0, -0.1], [3]),
        w2: reshape([1.0, -1.0, 0.5], [3, 1]),
        b2: reshape([0.2], [1])
    }
    let x = reshape([1.0, 2.0, -1.0, 0.5], [2, 2])
    export_model(step, (m, x), get_env('ONNX_OUT'))
    println('exported step')
    return 0
}
