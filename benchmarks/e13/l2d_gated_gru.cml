/**
 * E13/T5 Level-2 probe L2d: branch inside a loop (gated GRU).
 *
 * A small single-layer GRU (hidden 3, T = 3, batch 2, features 2; PyTorch gate
 * equations as in benchmarks/gru/model.cml) whose cell update at each time
 * step fires only when mean(|x_t|) > 0.5; otherwise the hidden state is
 * carried through unchanged. The branch sits inside the recurrent loop body,
 * so one unrolled training step contains one If per time step. Final hidden
 * state goes through a linear head; loss mean(y*y), one SGD step at lr 0.01.
 *
 *   arm a: gate pattern [update, skip, update] (g = 0.75 / 0.25 / 0.6875)
 *   arm b: [update, update, update] (g = 0.875 everywhere)
 *   arm 0: x = 0 -> [skip, skip, skip]; h stays 0, y = fc_b, and every GRU
 *          weight receives an exactly zero tangent.
 *
 * MODE=run    : native run; dumps init params, inputs, losses, updated params
 * MODE=export : WHAT=fwd exports the loss, WHAT=step exports the training step
 */
module e13_l2d_gated_gru

import { Tensor, sigmoid, tanh, slice, reshape, shape, zeros, mean, abs, save_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { export_model } from onnx

type Gru = {
    w_ir: f32[..], w_iz: f32[..], w_in: f32[..],
    w_hr: f32[..], w_hz: f32[..], w_hn: f32[..],
    b_ir: f32[..], b_iz: f32[..], b_in: f32[..],
    b_hr: f32[..], b_hz: f32[..], b_hn: f32[..],
    fc_w: f32[..], fc_b: f32[..]
}

with <m: Gru>
func cell(xt: f32[..], h: f32[..]): f32[..] {
    let r = sigmoid(xt @ m.w_ir + m.b_ir + h @ m.w_hr + m.b_hr)
    let z = sigmoid(xt @ m.w_iz + m.b_iz + h @ m.w_hz + m.b_hz)
    let n = tanh(xt @ m.w_in + m.b_in + r * (h @ m.w_hn + m.b_hn))
    return (1.0 - z) * n + z * h
}

/// One time step: update the hidden state only when the step's input is large.
with <m: Gru, x: f32[..]>
func gated(t: int, h: f32[..]): f32[..] {
    let xt = reshape(slice(x, 1, t, t + 1), [shape(x)[0], shape(x)[2]])
    return if mean(abs(xt)) > 0.5 then cell<m>(xt, h) else h
}

with <m: Gru, x: f32[..]>
func run(t: int, steps: int, h: f32[..]): f32[..] {
    return if t >= steps then h else run<m, x>(t + 1, steps, gated<m, x>(t, h))
}

with <m: Gru>
func forward(x: f32[..]): f32[..] {
    let h = run<m, x>(0, shape(x)[1], zeros([shape(x)[0], shape(m.w_hr)[0]]))
    return h @ m.fc_w + m.fc_b
}

with <m: Gru>
func loss(x: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(y * y))
}

func fwd(m: Gru, x: f32[..]): float {
    return loss<m>(x)
}

func step(m: Gru, x: f32[..]): (float, Gru) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func load(): Gru {
    return {
        w_ir: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        w_iz: reshape([0.25, 0.5, -0.75, -0.5, 1.0, 0.5], [2, 3]),
        w_in: reshape([0.75, -0.5, 0.5, 0.25, -1.0, 0.5], [2, 3]),
        w_hr: reshape([0.5, 0.25, -0.25, -0.5, 0.75, 0.5, 0.25, -0.75, 1.0], [3, 3]),
        w_hz: reshape([0.25, -0.5, 0.5, 0.75, 0.5, -1.0, 0.5, 0.25, -0.25], [3, 3]),
        w_hn: reshape([-0.5, 0.5, 0.25, 0.5, -0.75, 1.0, 0.25, 0.5, -0.5], [3, 3]),
        b_ir: reshape([0.1, 0.0, -0.1], [3]),
        b_iz: reshape([0.0, 0.1, 0.2], [3]),
        b_in: reshape([-0.1, 0.2, 0.0], [3]),
        b_hr: reshape([0.1, 0.1, 0.0], [3]),
        b_hz: reshape([0.0, -0.1, 0.1], [3]),
        b_hn: reshape([0.2, 0.0, -0.2], [3]),
        fc_w: reshape([0.5, -0.5, 1.0, 0.25, -0.75, 0.5], [3, 2]),
        fc_b: reshape([0.3, -0.2], [2])
    }
}

func input_a(): f32[..] {
    return reshape(
        [1.0, -1.0, 0.25, -0.25, 0.75, 0.5, 0.5, -0.5, -0.25, 0.25, -0.5, 1.0],
        [2, 3, 2]
    )
}

func do_run(m: Gru): int sync {
    let dump = get_env('DUMP')
    let xa = input_a()
    let xb = reshape(
        [1.0, -0.75, 0.75, 1.0, -1.0, 0.75, 0.75, -1.0, 1.0, -0.75, 0.75, 1.0],
        [2, 3, 2]
    )
    let x0 = zeros([2, 3, 2])
    save_params(m, dump + '/init')
    save_npy(xa, dump + '/xa.npy')
    save_npy(xb, dump + '/xb.npy')
    save_npy(x0, dump + '/x0.npy')
    let la = step(m, xa)
    let lb = step(m, xb)
    let l0 = step(m, x0)
    save_npy(reshape([la.0], [1]), dump + '/loss_a.npy')
    save_npy(reshape([lb.0], [1]), dump + '/loss_b.npy')
    save_npy(reshape([l0.0], [1]), dump + '/loss_0.npy')
    save_params(la.1, dump + '/arm_a')
    save_params(lb.1, dump + '/arm_b')
    save_params(l0.1, dump + '/arm_0')
    'loss_a={} loss_b={} loss_0={}'->format<la.0, lb.0, l0.0>->println
    return 0
}

func do_export(m: Gru): int sync {
    let out = get_env('ONNX_OUT')
    return if get_env('WHAT') == 'fwd' then sync {
        export_model(fwd, (m, input_a()), out)
        println('exported fwd')
        return 0
    } else sync {
        export_model(step, (m, input_a()), out)
        println('exported step')
        return 0
    }
}

func main(): int sync {
    let m = load()
    return if get_env('MODE') == 'export' then do_export(m) else do_run(m)
}
