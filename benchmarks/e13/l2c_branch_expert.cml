/**
 * E13/T5 Level-2 probe L2c: branch experts (input-routed subnetworks).
 *
 * A Mixture-of-Experts-style router: the sign of mean(x) routes the whole
 * batch to one of two structurally different subnetworks with disjoint
 * weights — expert A is a two-layer ReLU MLP, expert B is a single linear
 * layer. Loss mean(y*y), one SGD step at lr 0.01.
 *
 *   arm a: mean(x) =  0.75   > 0 -> expert A
 *   arm b: mean(x) = -0.5833 < 0 -> expert B
 *   arm 0: mean(x) =  0 exactly (dyadic literals sum to zero) -> expert B,
 *          locking the strict-> boundary semantics.
 *
 * MODE=run    : native run; dumps init params, inputs, losses, updated params
 * MODE=export : WHAT=fwd exports the loss, WHAT=step exports the training step
 */

import { relu, mean, reshape, save_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { export_model } from onnx

type Moe = { wa1: float[..], ba1: float[..], wa2: float[..], ba2: float[..], wb: float[..], bb: float[..] }

with <m: Moe>
func loss(x: float[..]): float {
    let y = if float(mean(x)) > 0.0 then relu(x @ m.wa1 + m.ba1) @ m.wa2 + m.ba2 else x @ m.wb + m.bb
    return float(mean(y * y))
}

func fwd(m: Moe, x: float[..]): float {
    return loss<m>(x)
}

func step(m: Moe, x: float[..]): (float, Moe) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func load(): Moe {
    return {
        wa1: reshape<[3, 4]>([0.5, 1.0, -0.5, 0.25, -0.75, 0.5, 1.0, -0.5, 0.25, -1.0, 0.5, 0.75]),
        ba1: reshape<[4]>([0.1, 0.0, -0.1, 0.2]),
        wa2: reshape<[4, 2]>([0.5, -1.0, 1.0, 0.5, -0.5, 0.75, 0.25, -0.25]),
        ba2: reshape<[2]>([0.0, 0.1]),
        wb: reshape<[3, 2]>([1.0, -0.5, 0.5, 1.0, -0.25, 0.75]),
        bb: reshape<[2]>([-0.1, 0.2])
    }
}

func input_a(): float[..] {
    return reshape<[2, 3]>([1.0, 2.0, -0.5, 0.5, 1.5, 0.0])
}

func do_run(m: Moe): int sync {
    let dump = get_env('DUMP') ?? ''
    let xa = input_a()
    let xb = reshape<[2, 3]>([-1.0, 0.5, -2.0, -0.5, 1.0, -1.5])
    let x0 = reshape<[2, 3]>([1.0, -1.0, 0.5, -0.5, 0.25, -0.25])
    save_params(m, dump + '/init')
    save_npy(xa, dump + '/xa.npy')
    save_npy(xb, dump + '/xb.npy')
    save_npy(x0, dump + '/x0.npy')
    let la = step(m, xa)
    let lb = step(m, xb)
    let l0 = step(m, x0)
    save_npy(reshape<[1]>([la.0]), dump + '/loss_a.npy')
    save_npy(reshape<[1]>([lb.0]), dump + '/loss_b.npy')
    save_npy(reshape<[1]>([l0.0]), dump + '/loss_0.npy')
    save_params(la.1, dump + '/arm_a')
    save_params(lb.1, dump + '/arm_b')
    save_params(l0.1, dump + '/arm_0')
    'loss_a={} loss_b={} loss_0={}'->format<la.0, lb.0, l0.0>->println
    return 0
}

func do_export(m: Moe): int sync {
    let out = get_env('ONNX_OUT') ?? ''
    return if (get_env('WHAT') ?? '') == 'fwd' then sync {
        let _ = export_model<out: out>(fwd, (m, input_a()))
        println('exported fwd')
        return 0
    } else sync {
        let _ = export_model<out: out>(step, (m, input_a()))
        println('exported step')
        return 0
    }
}

func main(): int sync {
    let m = load()
    return if (get_env('MODE') ?? '') == 'export' then do_export(m) else do_run(m)
}
