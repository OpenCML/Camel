/**
 * E13/T5 Level-2 probe L2a: data-dependent early exit.
 *
 * A three-layer MLP skips its third block when the "confidence" of the second
 * block is high: after h2 = relu(h1 @ w2 + b2), if mean(|h2|) > 0.5 the
 * network exits through a dedicated head (h2 @ we + be); otherwise it runs
 * the full third block (relu(h2 @ w3 + b3) @ wo + bo). The two arms use
 * disjoint parameter subsets. Loss mean(y*y), one SGD step at lr 0.01.
 *
 *   arm a: c = 0.890625  > 0.5 -> early exit
 *   arm b: c = 0.15      < 0.5 -> full network
 *   arm 0: c = 0.5 exactly (x = 0 zeroes every pre-activation; b2 = 0.5 is
 *          dyadic, so the equality is exact in float32) -> full network,
 *          locking the strict-> boundary semantics.
 *
 * MODE=run    : native run; dumps init params, inputs, losses, updated params
 * MODE=export : WHAT=fwd exports the loss, WHAT=step exports the training step
 */
module e13_l2a_early_exit

import { relu, mean, abs, reshape, zeros, save_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { export_model } from onnx

type Mlp = {
    w1: float[..], b1: float[..], w2: float[..], b2: float[..],
    w3: float[..], b3: float[..], wo: float[..], bo: float[..],
    we: float[..], be: float[..]
}

with <m: Mlp>
func loss(x: float[..]): float {
    let h1 = relu(x @ m.w1 + m.b1)
    let h2 = relu(h1 @ m.w2 + m.b2)
    let y = if float(mean(abs(h2))) > 0.5 then h2 @ m.we + m.be else relu(h2 @ m.w3 + m.b3) @ m.wo + m.bo
    return float(mean(y * y))
}

func fwd(m: Mlp, x: float[..]): float {
    return loss<m>(x)
}

func step(m: Mlp, x: float[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func load(): Mlp {
    return {
        w1: reshape([0.5, -0.25, 0.75, -1.0, -0.5, 0.25, 0.5, -0.75, 1.0, 0.5, -0.25, -0.25], [3, 4]),
        b1: zeros([4]),
        w2: reshape([0.4, -0.3, 0.2, 0.1, -0.2, 0.5, -0.4, 0.3, 0.3, 0.1, -0.1, 0.6, -0.5, -0.4, -0.3, -0.2], [4, 4]),
        b2: reshape([0.5, 0.5, 0.5, 0.5], [4]),
        w3: reshape([0.3, -0.2, 0.1, 0.4, 0.2, 0.5, -0.3, -0.1, -0.4, 0.1, 0.6, 0.2, 0.1, -0.5, 0.3, -0.3], [4, 4]),
        b3: reshape([0.1, -0.1, 0.2, 0.0], [4]),
        wo: reshape([0.5, -0.5, 1.0, 0.25, -0.75, 0.5, 0.25, -1.0], [4, 2]),
        bo: reshape([0.2, -0.1], [2]),
        we: reshape([1.0, 0.5, -0.5, 1.0, 0.75, -0.25, 0.0, 0.5], [4, 2]),
        be: reshape([0.1, 0.2], [2])
    }
}

func input_a(): float[..] {
    return reshape([1.0, 2.0, -1.0, 0.5, -1.5, 2.0], [2, 3])
}

func do_run(m: Mlp): int sync {
    let dump = get_env('DUMP')
    let xa = input_a()
    let xb = reshape([-0.5, -0.5, -0.5, -0.5, -0.5, -0.5], [2, 3])
    let x0 = zeros([2, 3])
    save_params(m, dump + '/init')
    save_npy(xa, dump + '/xa.npy')
    save_npy(xb, dump + '/xb.npy')
    save_npy(x0, dump + '/x0.npy')
    let la = step(m, xa)
    let lb = step(m, xb)
    let l0 = step(m, x0)
    save_npy(reshape([la.0], [1]), dump + '/loss_a.npy')
    save_npy(reshape([lb.0], [1]), dump + '/loss_b.npy')
    save_npy(reshape([l0.0], [1]), dump + '/loss_0.npy')
    save_params(la.1, dump + '/arm_a')
    save_params(lb.1, dump + '/arm_b')
    save_params(l0.1, dump + '/arm_0')
    'loss_a={} loss_b={} loss_0={}'->format<la.0, lb.0, l0.0>->println
    return 0
}

func do_export(m: Mlp): int sync {
    let out = get_env('ONNX_OUT')
    return if get_env('WHAT') == 'fwd' then sync {
        let _ = export_model<out: out>(fwd, (m, input_a()))
        println('exported fwd')
        return 0
    } else sync {
        let _ = export_model<out: out>(step, (m, input_a()))
        println('exported step')
        return 0
    }
}

func main(): int sync {
    let m = load()
    return if get_env('MODE') == 'export' then do_export(m) else do_run(m)
}
