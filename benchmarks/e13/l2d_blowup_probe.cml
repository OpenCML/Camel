/**
 * E13/T5 companion probe: how the exported gated-GRU forward scales with the
 * number of in-loop data-dependent branches.
 *
 * The exporter's symbolic branch evaluation duplicates the loop continuation
 * per arm, so an unrolled recurrence with T gated steps exports as a full
 * binary decision tree with 2^T - 1 nested If operators. STEPS=4 and STEPS=6
 * measure the growth (the delivered probe l2d_gated_gru.cml is T = 3 -> 7 Ifs,
 * 222 nodes). The example input is all zeros: the gate predicates stay
 * symbolic regardless, only the unroll depth matters.
 *
 * MODE=export STEPS=4|6 ONNX_OUT=...
 */

import { sigmoid, tanh, reshape, shape, zeros, mean, abs } from tensor
import { get_env } from env
import { export_model } from onnx

type Gru = {
    w_ir: f32[..], w_iz: f32[..], w_in: f32[..],
    w_hr: f32[..], w_hz: f32[..], w_hn: f32[..],
    b_ir: f32[..], b_iz: f32[..], b_in: f32[..],
    b_hr: f32[..], b_hz: f32[..], b_hn: f32[..],
    fc_w: f32[..], fc_b: f32[..]
}

with <m: Gru>
func cell(xt: f32[..], h: f32[..]): f32[..] {
    let r = sigmoid(xt @ m.w_ir + m.b_ir + h @ m.w_hr + m.b_hr)
    let z = sigmoid(xt @ m.w_iz + m.b_iz + h @ m.w_hz + m.b_hz)
    let n = tanh(xt @ m.w_in + m.b_in + r * (h @ m.w_hn + m.b_hn))
    return (1.0 - z) * n + z * h
}

with <m: Gru, x: f32[..]>
func gated(t: int, h: f32[..]): f32[..] {
    let xt = reshape<[shape(x)[0], shape(x)[2]]>(slice(x, 1, t, t + 1))
    return if mean(abs(xt)) > 0.5 then cell<m>(xt, h) else h
}

with <m: Gru, x: f32[..]>
func run(t: int, steps: int, h: f32[..]): f32[..] {
    return if t >= steps then h else run<m, x>(t + 1, steps, gated<m, x>(t, h))
}

with <m: Gru>
func loss(x: f32[..]): float {
    let h = run<m, x>(0, shape(x)[1], zeros::<f32>([shape(x)[0], shape(m.w_hr)[0]]))
    let y = h @ m.fc_w + m.fc_b
    return float(mean(y * y))
}

func fwd(m: Gru, x: f32[..]): float {
    return loss<m>(x)
}

func load(): Gru {
    return {
        w_ir: reshape<[2, 3]>([0.5, -0.25, 0.75, 1.0, -0.5, 0.25]),
        w_iz: reshape<[2, 3]>([0.25, 0.5, -0.75, -0.5, 1.0, 0.5]),
        w_in: reshape<[2, 3]>([0.75, -0.5, 0.5, 0.25, -1.0, 0.5]),
        w_hr: reshape<[3, 3]>([0.5, 0.25, -0.25, -0.5, 0.75, 0.5, 0.25, -0.75, 1.0]),
        w_hz: reshape<[3, 3]>([0.25, -0.5, 0.5, 0.75, 0.5, -1.0, 0.5, 0.25, -0.25]),
        w_hn: reshape<[3, 3]>([-0.5, 0.5, 0.25, 0.5, -0.75, 1.0, 0.25, 0.5, -0.5]),
        b_ir: reshape<[3]>([0.1, 0.0, -0.1]),
        b_iz: reshape<[3]>([0.0, 0.1, 0.2]),
        b_in: reshape<[3]>([-0.1, 0.2, 0.0]),
        b_hr: reshape<[3]>([0.1, 0.1, 0.0]),
        b_hz: reshape<[3]>([0.0, -0.1, 0.1]),
        b_hn: reshape<[3]>([0.2, 0.0, -0.2]),
        fc_w: reshape<[3, 2]>([0.5, -0.5, 1.0, 0.25, -0.75, 0.5]),
        fc_b: reshape<[2]>([0.3, -0.2])
    }
}

func main(): int sync {
    let m = load()
    let x = if (get_env('STEPS') ?? '') == '6' then zeros::<f32>([2, 6, 2]) else zeros::<f32>([2, 4, 2])
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>(fwd, (m, x))
    println('exported fwd steps=' + (get_env('STEPS') ?? ''))
    return 0
}
