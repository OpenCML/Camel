/**
 * E13/T5 companion probe: how the exported gated-GRU forward scales with the
 * number of in-loop data-dependent branches.
 *
 * The exporter's symbolic branch evaluation duplicates the loop continuation
 * per arm, so an unrolled recurrence with T gated steps exports as a full
 * binary decision tree with 2^T - 1 nested If operators. STEPS=4 and STEPS=6
 * measure the growth (the delivered probe l2d_gated_gru.cml is T = 3 -> 7 Ifs,
 * 222 nodes). The example input is all zeros: the gate predicates stay
 * symbolic regardless, only the unroll depth matters.
 *
 * MODE=export STEPS=4|6 ONNX_OUT=...
 */
module e13_l2d_blowup_probe

import { Tensor, sigmoid, tanh, slice, reshape, shape, zeros, mean, abs } from tensor
import { get_env } from sys
import { export_model } from onnx

type Gru = {
    w_ir: Tensor, w_iz: Tensor, w_in: Tensor,
    w_hr: Tensor, w_hz: Tensor, w_hn: Tensor,
    b_ir: Tensor, b_iz: Tensor, b_in: Tensor,
    b_hr: Tensor, b_hz: Tensor, b_hn: Tensor,
    fc_w: Tensor, fc_b: Tensor
}

with <m: Gru>
func cell(xt: Tensor, h: Tensor): Tensor {
    let r = sigmoid(xt @ m.w_ir + m.b_ir + h @ m.w_hr + m.b_hr)
    let z = sigmoid(xt @ m.w_iz + m.b_iz + h @ m.w_hz + m.b_hz)
    let n = tanh(xt @ m.w_in + m.b_in + r * (h @ m.w_hn + m.b_hn))
    return (1.0 - z) * n + z * h
}

with <m: Gru, x: Tensor>
func gated(t: int, h: Tensor): Tensor {
    let xt = reshape(slice(x, 1, t, t + 1), [shape(x)[0], shape(x)[2]])
    return if mean(abs(xt)) > 0.5 then cell<m>(xt, h) else h
}

with <m: Gru, x: Tensor>
func run(t: int, steps: int, h: Tensor): Tensor {
    return if t >= steps then h else run<m, x>(t + 1, steps, gated<m, x>(t, h))
}

with <m: Gru>
func loss(x: Tensor): float {
    let h = run<m, x>(0, shape(x)[1], zeros([shape(x)[0], shape(m.w_hr)[0]]))
    let y = h @ m.fc_w + m.fc_b
    return mean(y * y)
}

func fwd(m: Gru, x: Tensor): float {
    return loss<m>(x)
}

func load(): Gru {
    return {
        w_ir: reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3]),
        w_iz: reshape([0.25, 0.5, -0.75, -0.5, 1.0, 0.5], [2, 3]),
        w_in: reshape([0.75, -0.5, 0.5, 0.25, -1.0, 0.5], [2, 3]),
        w_hr: reshape([0.5, 0.25, -0.25, -0.5, 0.75, 0.5, 0.25, -0.75, 1.0], [3, 3]),
        w_hz: reshape([0.25, -0.5, 0.5, 0.75, 0.5, -1.0, 0.5, 0.25, -0.25], [3, 3]),
        w_hn: reshape([-0.5, 0.5, 0.25, 0.5, -0.75, 1.0, 0.25, 0.5, -0.5], [3, 3]),
        b_ir: reshape([0.1, 0.0, -0.1], [3]),
        b_iz: reshape([0.0, 0.1, 0.2], [3]),
        b_in: reshape([-0.1, 0.2, 0.0], [3]),
        b_hr: reshape([0.1, 0.1, 0.0], [3]),
        b_hz: reshape([0.0, -0.1, 0.1], [3]),
        b_hn: reshape([0.2, 0.0, -0.2], [3]),
        fc_w: reshape([0.5, -0.5, 1.0, 0.25, -0.75, 0.5], [3, 2]),
        fc_b: reshape([0.3, -0.2], [2])
    }
}

func main(): int sync {
    let m = load()
    let x = if get_env('STEPS') == '6' then zeros([2, 6, 2]) else zeros([2, 4, 2])
    export_model(fwd, (m, x), get_env('ONNX_OUT'))
    println('exported fwd steps=' + get_env('STEPS'))
    return 0
}
