/**
 * Camel implementation of the `lenet` benchmark model (benchmarks/README.md):
 * Conv(1->6,k5,pad2) -> ReLU -> MaxPool(2) -> Conv(6->16,k5) -> ReLU -> MaxPool(2)
 * -> Flatten -> Linear(400,120) -> ReLU -> Linear(120,84) -> ReLU -> Linear(84,10).
 */
module lenet

import { Tensor, relu, flatten } from tensor
import { conv2d, max_pool2d } from nn
import { weight, run_benchmark } from camel_bench

type LeNet = {
    conv1_w: Tensor, conv1_b: Tensor,
    conv2_w: Tensor, conv2_b: Tensor,
    fc1_w: Tensor, fc1_b: Tensor,
    fc2_w: Tensor, fc2_b: Tensor,
    fc3_w: Tensor, fc3_b: Tensor
}

with <m: LeNet>
func forward(x: Tensor): Tensor {
    let c1 = max_pool2d(relu(conv2d(x, m.conv1_w, m.conv1_b, 1, 2)), 2)
    let c2 = max_pool2d(relu(conv2d(c1, m.conv2_w, m.conv2_b)), 2)
    let f1 = relu(flatten(c2) @ m.fc1_w + m.fc1_b)
    let f2 = relu(f1 @ m.fc2_w + m.fc2_b)
    return f2 @ m.fc3_w + m.fc3_b
}

func main(): int sync {
    let m = {
        conv1_w: weight('conv1_w'), conv1_b: weight('conv1_b'),
        conv2_w: weight('conv2_w'), conv2_b: weight('conv2_b'),
        fc1_w: weight('fc1_w'), fc1_b: weight('fc1_b'),
        fc2_w: weight('fc2_w'), fc2_b: weight('fc2_b'),
        fc3_w: weight('fc3_w'), fc3_b: weight('fc3_b')
    }
    return run_benchmark((x: Tensor): Tensor => forward<m>(x))
}
