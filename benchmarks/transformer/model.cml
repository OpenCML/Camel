/**
 * Camel implementation of the `transformer` benchmark model (benchmarks/README.md):
 * pre-LN block over x[8,64,128] with 4-head self-attention and a GELU(tanh)
 * feed-forward network of width 512:
 *   h = x + MHA(LN1(x));  y = h + FFN(LN2(h)).
 */

import { layer_norm, softmax, gelu, reshape, permute, transpose, shape, mean } from tensor
import { sqrt } from math
import { grad, with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { export_model } from onnx
import { now } from time
import { weight, bench_input, run_benchmark, run_training, warm_count, step_count, log_step, log_final } from camel_bench

type Block = {
    ln1_gamma: f32[..], ln1_beta: f32[..],
    q_w: f32[..], q_b: f32[..], k_w: f32[..], k_b: f32[..],
    v_w: f32[..], v_b: f32[..], o_w: f32[..], o_b: f32[..],
    ln2_gamma: f32[..], ln2_beta: f32[..],
    ffn1_w: f32[..], ffn1_b: f32[..], ffn2_w: f32[..], ffn2_b: f32[..]
}

/// [B, S, D] -> [B, H, S, D / H]
func split_heads(t: f32[..], heads: int): f32[..] {
    let dims = shape(t)
    return permute(reshape(t, [dims[0], dims[1], heads, dims[2] / heads]), [0, 2, 1, 3])
}

/// [B, H, S, Dh] -> [B, S, H * Dh]
func merge_heads(t: f32[..]): f32[..] {
    let dims = shape(t)
    return reshape(permute(t, [0, 2, 1, 3]), [dims[0], dims[2], dims[1] * dims[3]])
}

with <m: Block>
func attention(x: f32[..]): f32[..] {
    let heads = 4
    let q = split_heads(x @ m.q_w + m.q_b, heads)
    let k = split_heads(x @ m.k_w + m.k_b, heads)
    let v = split_heads(x @ m.v_w + m.v_b, heads)
    let scale = 1.0 / sqrt(float(shape(q)[3]))
    let weights = softmax((q @ transpose(k)) * scale)
    return merge_heads(weights @ v) @ m.o_w + m.o_b
}

with <m: Block>
func forward(x: f32[..]): f32[..] {
    let h = x + attention<m>(layer_norm(x, m.ln1_gamma, m.ln1_beta))
    let f = gelu(layer_norm(h, m.ln2_gamma, m.ln2_beta) @ m.ffn1_w + m.ffn1_b)
    return h + (f @ m.ffn2_w + m.ffn2_b)
}

// Training workload (train.py): loss mean(y^2), one SGD step with lr 0.01.
with <m: Block>
func loss(x: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(y * y))
}

func train_step(m: Block, x: f32[..]): float sync {
    let vg = with_grad(loss)<m>(x)
    let next = sgd(m, vg.1, 0.01)
    return vg.0
}

/// The training step as a function of the parameters: the loss and the updated parameters.
func step(m: Block, x: f32[..]): (float, Block) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

/// Exports `step` to ONNX: the parameters and the input become graph inputs.
func export_step(m: Block, path: string): int sync {
    let _ = export_model<out: path>(step, (m, bench_input()))
    return 0
}

func dump_grads(m: Block, x: f32[..], dir: string): int sync {
    save_params(grad(loss)<m>(x), dir)
    return 0
}

/// The stateful training loop: step `i` starts from the parameters step `i - 1` produced.
/// Returns the parameters after step `total - 1`.
func train_loop(m: Block, x: f32[..], i: int, warm: int, total: int, t0: float): Block {
    return if i >= total then m else sync {
        let start = now()
        let r = step(m, x)
        let elapsed = now() - start
        let logged = log_step(i, warm, t0, elapsed, r.0)
        return train_loop(r.1, x, i + 1, warm, total, t0)
    }
}

func save_trained(m: Block, dir: string): int sync {
    save_params(m, dir)
    return 0
}

/// Runs the stateful loop and reports the loss at the final parameters; saves them when
/// CAMEL_BENCH_PARAMS names a directory.
func train_stateful(m: Block, x: f32[..]): int sync {
    let trained = train_loop(m, x, 0, warm_count(), step_count(), now())
    let reported = log_final(loss<trained>(x))
    let dir = get_env('CAMEL_BENCH_PARAMS') ?? ''
    return if dir != '' then save_trained(trained, dir) else 0
}

func main(): int sync {
    let m = {
        ln1_gamma: weight('ln1_gamma'), ln1_beta: weight('ln1_beta'),
        q_w: weight('q_w'), q_b: weight('q_b'), k_w: weight('k_w'), k_b: weight('k_b'),
        v_w: weight('v_w'), v_b: weight('v_b'), o_w: weight('o_w'), o_b: weight('o_b'),
        ln2_gamma: weight('ln2_gamma'), ln2_beta: weight('ln2_beta'),
        ffn1_w: weight('ffn1_w'), ffn1_b: weight('ffn1_b'),
        ffn2_w: weight('ffn2_w'), ffn2_b: weight('ffn2_b')
    }
    let workload = get_env('CAMEL_BENCH_WORKLOAD') ?? ''
    return if workload == 'train_export' then export_step(m, get_env('CAMEL_BENCH_EXPORT') ?? '') else if workload == 'train' then run_training(
        (x: f32[..]): float => { return train_step(m, x) },
        (x: f32[..], dir: string): int => { return dump_grads(m, x, dir) },
        (x: f32[..]): int => { return train_stateful(m, x) }
    ) else run_benchmark((x: f32[..]): f32[..] => forward<m>(x))
}
