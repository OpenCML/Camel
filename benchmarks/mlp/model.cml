/**
 * Camel implementation of the `mlp` benchmark model (benchmarks/README.md):
 * x[64,784] -> Linear(784,256) -> ReLU -> Linear(256,128) -> ReLU -> Linear(128,10).
 */
module mlp

import { Tensor, relu, mean } from tensor
import { grad, value_and_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from sys
import { weight, run_benchmark, run_training } from camel_bench

type Mlp = {
    fc1_w: Tensor, fc1_b: Tensor,
    fc2_w: Tensor, fc2_b: Tensor,
    fc3_w: Tensor, fc3_b: Tensor
}

with <m: Mlp>
func forward(x: Tensor): Tensor {
    let h1 = relu(x @ m.fc1_w + m.fc1_b)
    let h2 = relu(h1 @ m.fc2_w + m.fc2_b)
    return h2 @ m.fc3_w + m.fc3_b
}

// Training workload (train.py): loss mean(y^2), one SGD step with lr 0.01.
with <m: Mlp>
func loss(x: Tensor): float {
    let y = forward<m>(x)
    return mean(y * y)
}

func train_step(m: Mlp, x: Tensor): float sync {
    let vg = value_and_grad(loss)<m>(x)
    let next = sgd(m, vg.1, 0.01)
    return vg.0
}

func dump_grads(m: Mlp, x: Tensor, dir: string): int sync {
    save_params(grad(loss)<m>(x), dir)
    return 0
}

func main(): int sync {
    let m = {
        fc1_w: weight('fc1_w'), fc1_b: weight('fc1_b'),
        fc2_w: weight('fc2_w'), fc2_b: weight('fc2_b'),
        fc3_w: weight('fc3_w'), fc3_b: weight('fc3_b')
    }
    return if get_env('CAMEL_BENCH_WORKLOAD') == 'train' then run_training(
        (x: Tensor): float => { return train_step(m, x) },
        (x: Tensor, dir: string): int => { return dump_grads(m, x, dir) }
    ) else run_benchmark((x: Tensor): Tensor => forward<m>(x))
}
