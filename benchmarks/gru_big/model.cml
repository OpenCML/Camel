/**
 * Camel implementation of the `gru` benchmark model (benchmarks/README.md):
 * single-layer GRU (H=128) over x[32,16,64] written as an explicit cell
 * recurrence with PyTorch gate equations, h0 = 0, then Linear(128,10) on the
 * final hidden state.
 */

import { sigmoid, tanh, reshape, shape, zeros, mean } from tensor
import { grad, with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { export_model } from onnx
import { now } from time
import { weight, bench_input, run_benchmark, run_training, warm_count, step_count, log_step, log_final } from camel_bench

type Gru = {
    w_ir: f32[..], w_iz: f32[..], w_in: f32[..],
    w_hr: f32[..], w_hz: f32[..], w_hn: f32[..],
    b_ir: f32[..], b_iz: f32[..], b_in: f32[..],
    b_hr: f32[..], b_hz: f32[..], b_hn: f32[..],
    fc_w: f32[..], fc_b: f32[..]
}

with <m: Gru>
func cell(xt: f32[..], h: f32[..]): f32[..] {
    let r = sigmoid(xt @ m.w_ir + m.b_ir + h @ m.w_hr + m.b_hr)
    let z = sigmoid(xt @ m.w_iz + m.b_iz + h @ m.w_hz + m.b_hz)
    let n = tanh(xt @ m.w_in + m.b_in + r * (h @ m.w_hn + m.b_hn))
    return (1.0 - z) * n + z * h
}

/// Runs the recurrence over time steps [t, steps).
with <m: Gru, x: f32[..]>
func run(t: int, steps: int, h: f32[..]): f32[..] {
    let batch = shape(x)[0]
    let features = shape(x)[2]
    return if t >= steps then h else run<m, x>(t + 1, steps, cell<m>(reshape(slice(x, 1, t, t + 1), [batch, features]), h))
}

with <m: Gru>
func forward(x: f32[..]): f32[..] {
    let h = run<m, x>(0, shape(x)[1], zeros([shape(x)[0], shape(m.w_hr)[0]]))
    return h @ m.fc_w + m.fc_b
}

// Training workload (train.py): loss mean(y^2), one SGD step with lr 0.01.
with <m: Gru>
func loss(x: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(y * y))
}

func train_step(m: Gru, x: f32[..]): float sync {
    let vg = with_grad(loss)<m>(x)
    let next = sgd(m, vg.1, 0.01)
    return vg.0
}

/// The training step as a function of the parameters: the loss and the updated parameters.
func step(m: Gru, x: f32[..]): (float, Gru) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

/// Exports `step` to ONNX: the parameters and the input become graph inputs.
func export_step(m: Gru, path: string): int sync {
    export_model(step, (m, bench_input()), path)
    return 0
}

func dump_grads(m: Gru, x: f32[..], dir: string): int sync {
    save_params(grad(loss)<m>(x), dir)
    return 0
}

/// The stateful training loop: step `i` starts from the parameters step `i - 1` produced.
/// Returns the parameters after step `total - 1`.
func train_loop(m: Gru, x: f32[..], i: int, warm: int, total: int, t0: float): Gru {
    return if i >= total then m else sync {
        let start = now()
        let r = step(m, x)
        let elapsed = now() - start
        let logged = log_step(i, warm, t0, elapsed, r.0)
        return train_loop(r.1, x, i + 1, warm, total, t0)
    }
}

func save_trained(m: Gru, dir: string): int sync {
    save_params(m, dir)
    return 0
}

/// Runs the stateful loop and reports the loss at the final parameters; saves them when
/// CAMEL_BENCH_PARAMS names a directory.
func train_stateful(m: Gru, x: f32[..]): int sync {
    let trained = train_loop(m, x, 0, warm_count(), step_count(), now())
    let reported = log_final(loss<trained>(x))
    let dir = get_env('CAMEL_BENCH_PARAMS')
    return if dir != '' then save_trained(trained, dir) else 0
}

func main(): int sync {
    let m = {
        w_ir: weight('w_ir'), w_iz: weight('w_iz'), w_in: weight('w_in'),
        w_hr: weight('w_hr'), w_hz: weight('w_hz'), w_hn: weight('w_hn'),
        b_ir: weight('b_ir'), b_iz: weight('b_iz'), b_in: weight('b_in'),
        b_hr: weight('b_hr'), b_hz: weight('b_hz'), b_hn: weight('b_hn'),
        fc_w: weight('fc_w'), fc_b: weight('fc_b')
    }
    let workload = get_env('CAMEL_BENCH_WORKLOAD')
    return if workload == 'train_export' then export_step(m, get_env('CAMEL_BENCH_EXPORT')) else if workload == 'train' then run_training(
        (x: f32[..]): float => { return train_step(m, x) },
        (x: f32[..], dir: string): int => { return dump_grads(m, x, dir) },
        (x: f32[..]): int => { return train_stateful(m, x) }
    ) else run_benchmark((x: f32[..]): f32[..] => forward<m>(x))
}
