// RQ1 classic suite: fannkuch. Sums the flip counts over every permutation of 0..n-1 and
// reports the largest one, together with the number of permutations visited: the C++ column
// prints the same three numbers.

type Acc = { c: int, m: int, n: int }

func concat(xs: int[], ys: int[]) => int[] {
    let nx = len(xs)
    return [ (if i < nx then xs[i] else ys[i - nx]) for i in 0 .. (nx + len(ys)) ]
}

func flips(a: int[]) => int {
    if a[0] == 0 then 0 else {
        let k = a[0] + 1
        let head = [ a[k - 1 - i] for i in 0 .. k ]
        let tail = [ a[i] for i in k .. len(a) ]
        1 + flips(concat(head, tail))
    }
}

func value(a: int[]) => Acc {
    let f = flips(a)
    return { c: if f % 2 == 0 then f else -f, m: f, n: 1 }
}

func combine(p: Acc, q: Acc) => Acc {
    return { c: p.c + q.c, m: if p.m > q.m then p.m else q.m, n: p.n + q.n }
}

func perms(done: int[], rest: int[]) => Acc {
    if len(rest) == 0 then value(done) else {
        loop acc = { c: 0, m: 0, n: 0 } for i in 0 .. len(rest) do combine(acc, perms(concat(done, [rest[i]]), [ rest[j] for j in 0 .. len(rest) if j != i ]))
    }
}

func main() sync {
    let n = 7
    let r = perms([], [ i for i in 0 .. n ])
    println(r.c)
    println(r.m)
    println(r.n)
}