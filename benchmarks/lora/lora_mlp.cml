/**
 * E9 LoRA probe on the `mlp` backbone (benchmarks/mlp/model.cml layout):
 * every linear layer becomes  y = x @ W* + ((x @ B) @ A) * scale + b*,
 * where W*, b* are the frozen backbone (stop_gradient) and A [r,out], B [in,r]
 * are the trainable adapter (rank r = 8, scale = alpha/r = 2.0, B starts at
 * zero so the adapter is an exact identity at init).
 *
 * Workloads (CAMEL_BENCH_WORKLOAD):
 *   step_dump    one LoRA training step from the benchmark input; dumps the
 *                updated parameters to CAMEL_FT_DUMP (three-way alignment)
 *   export_lora  export the LoRA training step to ONNX (frozen backbone)
 *   export_full  export the same step with the backbone ALSO trainable — the
 *                node-count contrast pair for "freezing removes backbone
 *                gradient nodes" (the E9 structural data point)
 *   export_ce    export the cross-entropy SGD step (E9 on-device demo)
 *   train_ce     run the cross-entropy SGD fine-tune loop
 *   export_ce_adam / train_ce_adam
 *                the same with the in-graph Adam optimizer (T3): the exported
 *                graph carries the moments and the step count as extra I/O
 */

import { relu, mean, sum, log_softmax, load_npy } from tensor
import { with_grad, stop_gradient } from autodiff
import { OptimizerState, sgd, adam, adam_state, save_params } from nn
import { get_env } from env
import { export_model } from onnx
import { weight, bench_input } from camel_bench

type LoraMlp = {
    fc1_w: f32[..], fc1_b: f32[..], fc1_lora_a: f32[..], fc1_lora_b: f32[..],
    fc2_w: f32[..], fc2_b: f32[..], fc2_lora_a: f32[..], fc2_lora_b: f32[..],
    fc3_w: f32[..], fc3_b: f32[..], fc3_lora_a: f32[..], fc3_lora_b: f32[..]
}

/// LoRA path: backbone under stop_gradient, only adapters receive gradients.
with <m: LoraMlp>
func forward(x: f32[..]): f32[..] {
    let scale = 2.0
    let h1 = relu(x @ stop_gradient(m.fc1_w) + ((x @ m.fc1_lora_b) @ m.fc1_lora_a) * scale + stop_gradient(m.fc1_b))
    let h2 = relu(h1 @ stop_gradient(m.fc2_w) + ((h1 @ m.fc2_lora_b) @ m.fc2_lora_a) * scale + stop_gradient(m.fc2_b))
    return h2 @ stop_gradient(m.fc3_w) + ((h2 @ m.fc3_lora_b) @ m.fc3_lora_a) * scale + stop_gradient(m.fc3_b)
}

/// Same architecture with the backbone trainable (contrast export).
with <m: LoraMlp>
func forward_full(x: f32[..]): f32[..] {
    let scale = 2.0
    let h1 = relu(x @ m.fc1_w + ((x @ m.fc1_lora_b) @ m.fc1_lora_a) * scale + m.fc1_b)
    let h2 = relu(h1 @ m.fc2_w + ((h1 @ m.fc2_lora_b) @ m.fc2_lora_a) * scale + m.fc2_b)
    return h2 @ m.fc3_w + ((h2 @ m.fc3_lora_b) @ m.fc3_lora_a) * scale + m.fc3_b
}

with <m: LoraMlp>
func loss(x: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(y * y))
}

with <m: LoraMlp>
func loss_full(x: f32[..]): float {
    let y = forward_full<m>(x)
    return float(mean(y * y))
}

func step(m: LoraMlp, x: f32[..]): (float, LoraMlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func step_full(m: LoraMlp, x: f32[..]): (float, LoraMlp) {
    let vg = with_grad(loss_full)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

/// Cross-entropy against one-hot targets, composed from primitive tensor ops
/// (log_softmax + neg + multiply + sum_axis + mean — every differentiated node
/// uses already-registered ONNX lowerings; no dedicated CE lowering needed).
with <m: LoraMlp>
func loss_ce(x: f32[..], target: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(sum<1>(target * (-log_softmax<1>(y)))))
}

func step_ce(m: LoraMlp, x: f32[..], target: f32[..]): (float, LoraMlp) {
    let vg = with_grad(loss_ce)<m>(x, target)
    return (vg.0, sgd(m, vg.1, 0.1))
}

/// T3: the same step with the in-graph Adam optimizer (state carried explicitly).
func step_ce_adam(m: LoraMlp, st: OptimizerState, x: f32[..], target: f32[..], lr: float): (float, LoraMlp, OptimizerState) {
    let vg = with_grad(loss_ce)<m>(x, target)
    let next = adam(m, vg.1, st, lr)
    return (vg.0, next.0, next.1)
}

func loop_ce_adam(m: LoraMlp, st: OptimizerState, i: int, steps: int, nb: int, lr: float): (LoraMlp, OptimizerState) {
    return if i >= steps then (m, st) else sync {
        let bi = '{}'->format<i % nb>
        let dir = get_env('CAMEL_FT_BATCHES') ?? ''
        let x = load_npy::<f32>(dir + '/batch_' + bi + '.npy')
        let t = load_npy::<f32>(dir + '/target_' + bi + '.npy')
        let vg = step_ce_adam(m, st, x, t, lr)
        'CAMEL_BENCH step={} loss={}'->format<i, vg.0>->println
        return loop_ce_adam(vg.1, vg.2, i + 1, steps, nb, lr)
    }
}

/// The Adam learning rate, CAMEL_FT_LR or 0.001; shared by the export and the native loop.
/// (0.01 also converges, but the three-way trajectory comparison is then dominated by the
/// chaotic amplification of float32 rounding — see the T3 notes.)
func adam_lr(): float sync {
    let v = get_env('CAMEL_FT_LR') ?? ''
    return if v == '' then 0.001 else float(v)
}

func loop_ce(m: LoraMlp, i: int, steps: int, nb: int): LoraMlp {
    return if i >= steps then m else sync {
        let bi = '{}'->format<i % nb>
        let dir = get_env('CAMEL_FT_BATCHES') ?? ''
        let x = load_npy::<f32>(dir + '/batch_' + bi + '.npy')
        let t = load_npy::<f32>(dir + '/target_' + bi + '.npy')
        let vg = step_ce(m, x, t)
        'CAMEL_BENCH step={} loss={}'->format<i, vg.0>->println
        return loop_ce(vg.1, i + 1, steps, nb)
    }
}

func load(): LoraMlp {
    return {
        fc1_w: weight('fc1_w'), fc1_b: weight('fc1_b'),
        fc1_lora_a: weight('fc1_lora_a'), fc1_lora_b: weight('fc1_lora_b'),
        fc2_w: weight('fc2_w'), fc2_b: weight('fc2_b'),
        fc2_lora_a: weight('fc2_lora_a'), fc2_lora_b: weight('fc2_lora_b'),
        fc3_w: weight('fc3_w'), fc3_b: weight('fc3_b'),
        fc3_lora_a: weight('fc3_lora_a'), fc3_lora_b: weight('fc3_lora_b')
    }
}

func do_export_lora(m: LoraMlp): int sync {
    let _ = export_model<out: get_env('CAMEL_BENCH_EXPORT') ?? ''>(step, (m, bench_input()))
    return 0
}

func do_export_full(m: LoraMlp): int sync {
    let _ = export_model<out: get_env('CAMEL_BENCH_EXPORT') ?? ''>(step_full, (m, bench_input()))
    return 0
}

func do_step_dump(m: LoraMlp): int sync {
    let x = load_npy::<f32>(get_env('CAMEL_BENCH_INPUT') ?? '')
    let vg = step(m, x)
    'CAMEL_BENCH loss={}'->format<vg.0>->println
    save_params(vg.1, get_env('CAMEL_FT_DUMP') ?? '')
    return 0
}

func do_export_ce(m: LoraMlp): int sync {
    let dir = get_env('CAMEL_FT_BATCHES') ?? ''
    let x = load_npy::<f32>(dir + '/batch_0.npy')
    let t = load_npy::<f32>(dir + '/target_0.npy')
    let _ = export_model<out: get_env('CAMEL_BENCH_EXPORT') ?? ''>(step_ce, (m, x, t))
    return 0
}

func do_export_ce_adam(m: LoraMlp): int sync {
    let dir = get_env('CAMEL_FT_BATCHES') ?? ''
    let x = load_npy::<f32>(dir + '/batch_0.npy')
    let t = load_npy::<f32>(dir + '/target_0.npy')
    let lr = adam_lr()
    let _ = export_model<out: get_env('CAMEL_BENCH_EXPORT') ?? ''>(
        (mm: LoraMlp, st: OptimizerState, xx: f32[..], tt: f32[..]): (float, LoraMlp, OptimizerState) => step_ce_adam(mm, st, xx, tt, lr),
        (m, adam_state(m), x, t)
    )
    return 0
}

func do_train_ce(m: LoraMlp): int sync {
    let steps = int(get_env('CAMEL_FT_STEPS') ?? '')
    let nb = int(get_env('CAMEL_FT_NBATCHES') ?? '')
    let final = loop_ce(m, 0, steps, nb)
    let dump = get_env('CAMEL_FT_DUMP') ?? ''
    if dump != '' then save_params(final, dump)
    return 0
}

func do_train_ce_adam(m: LoraMlp): int sync {
    let steps = int(get_env('CAMEL_FT_STEPS') ?? '')
    let nb = int(get_env('CAMEL_FT_NBATCHES') ?? '')
    let final = loop_ce_adam(m, adam_state(m), 0, steps, nb, adam_lr())
    let dump = get_env('CAMEL_FT_DUMP') ?? ''
    if dump != '' then save_params(final.0, dump)
    return 0
}

func main(): int sync {
    let m = load()
    let workload = get_env('CAMEL_BENCH_WORKLOAD') ?? ''
    return if workload == 'export_lora' then do_export_lora(m) else if workload == 'export_full' then do_export_full(m) else if workload == 'export_ce' then do_export_ce(m) else if workload == 'export_ce_adam' then do_export_ce_adam(m) else if workload == 'train_ce' then do_train_ce(m) else if workload == 'train_ce_adam' then do_train_ce_adam(m) else do_step_dump(m)
}
