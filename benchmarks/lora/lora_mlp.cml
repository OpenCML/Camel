/**
 * E9 LoRA probe on the `mlp` backbone (benchmarks/mlp/model.cml layout):
 * every linear layer becomes  y = x @ W* + ((x @ B) @ A) * scale + b*,
 * where W*, b* are the frozen backbone (stop_gradient) and A [r,out], B [in,r]
 * are the trainable adapter (rank r = 8, scale = alpha/r = 2.0, B starts at
 * zero so the adapter is an exact identity at init).
 *
 * Workloads (CAMEL_BENCH_WORKLOAD):
 *   step_dump    one LoRA training step from the benchmark input; dumps the
 *                updated parameters to CAMEL_FT_DUMP (three-way alignment)
 *   export_lora  export the LoRA training step to ONNX (frozen backbone)
 *   export_full  export the same step with the backbone ALSO trainable — the
 *                node-count contrast pair for "freezing removes backbone
 *                gradient nodes" (the E9 structural data point)
 */
module lora_mlp

import { Tensor, relu, mean, sum, neg, log_softmax, load_npy } from tensor
import { value_and_grad, stop_gradient } from autodiff
import { sgd, save_params } from nn
import { get_env } from sys
import { export_model } from onnx
import { weight, bench_input } from camel_bench

type LoraMlp = {
    fc1_w: Tensor, fc1_b: Tensor, fc1_lora_a: Tensor, fc1_lora_b: Tensor,
    fc2_w: Tensor, fc2_b: Tensor, fc2_lora_a: Tensor, fc2_lora_b: Tensor,
    fc3_w: Tensor, fc3_b: Tensor, fc3_lora_a: Tensor, fc3_lora_b: Tensor
}

/// LoRA path: backbone under stop_gradient, only adapters receive gradients.
with <m: LoraMlp>
func forward(x: Tensor): Tensor {
    let scale = 2.0
    let h1 = relu(x @ stop_gradient(m.fc1_w) + ((x @ m.fc1_lora_b) @ m.fc1_lora_a) * scale + stop_gradient(m.fc1_b))
    let h2 = relu(h1 @ stop_gradient(m.fc2_w) + ((h1 @ m.fc2_lora_b) @ m.fc2_lora_a) * scale + stop_gradient(m.fc2_b))
    return h2 @ stop_gradient(m.fc3_w) + ((h2 @ m.fc3_lora_b) @ m.fc3_lora_a) * scale + stop_gradient(m.fc3_b)
}

/// Same architecture with the backbone trainable (contrast export).
with <m: LoraMlp>
func forward_full(x: Tensor): Tensor {
    let scale = 2.0
    let h1 = relu(x @ m.fc1_w + ((x @ m.fc1_lora_b) @ m.fc1_lora_a) * scale + m.fc1_b)
    let h2 = relu(h1 @ m.fc2_w + ((h1 @ m.fc2_lora_b) @ m.fc2_lora_a) * scale + m.fc2_b)
    return h2 @ m.fc3_w + ((h2 @ m.fc3_lora_b) @ m.fc3_lora_a) * scale + m.fc3_b
}

with <m: LoraMlp>
func loss(x: Tensor): float {
    let y = forward<m>(x)
    return mean(y * y)
}

with <m: LoraMlp>
func loss_full(x: Tensor): float {
    let y = forward_full<m>(x)
    return mean(y * y)
}

func step(m: LoraMlp, x: Tensor): (float, LoraMlp) {
    let vg = value_and_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func step_full(m: LoraMlp, x: Tensor): (float, LoraMlp) {
    let vg = value_and_grad(loss_full)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

/// Cross-entropy against one-hot targets, composed from primitive tensor ops
/// (log_softmax + neg + multiply + sum_axis + mean — every differentiated node
/// uses already-registered ONNX lowerings; no dedicated CE lowering needed).
with <m: LoraMlp>
func loss_ce(x: Tensor, target: Tensor): float {
    let y = forward<m>(x)
    return mean(sum(target * neg(log_softmax(y, 1)), 1))
}

func step_ce(m: LoraMlp, x: Tensor, target: Tensor): (float, LoraMlp) {
    let vg = value_and_grad(loss_ce)<m>(x, target)
    return (vg.0, sgd(m, vg.1, 0.1))
}

sync func loop_ce(m: LoraMlp, i: int, steps: int, nb: int): LoraMlp {
    return if i >= steps then m else sync {
        let bi = '{}'->format<i % nb>
        let dir = get_env('CAMEL_FT_BATCHES')
        let x = load_npy(dir + '/batch_' + bi + '.npy')
        let t = load_npy(dir + '/target_' + bi + '.npy')
        let vg = step_ce(m, x, t)
        'CAMEL_BENCH step={} loss={}'->format<i, vg.0>->println
        return loop_ce(vg.1, i + 1, steps, nb)
    }
}

func load(): LoraMlp {
    return {
        fc1_w: weight('fc1_w'), fc1_b: weight('fc1_b'),
        fc1_lora_a: weight('fc1_lora_a'), fc1_lora_b: weight('fc1_lora_b'),
        fc2_w: weight('fc2_w'), fc2_b: weight('fc2_b'),
        fc2_lora_a: weight('fc2_lora_a'), fc2_lora_b: weight('fc2_lora_b'),
        fc3_w: weight('fc3_w'), fc3_b: weight('fc3_b'),
        fc3_lora_a: weight('fc3_lora_a'), fc3_lora_b: weight('fc3_lora_b')
    }
}

func do_export_lora(m: LoraMlp): int sync {
    export_model(step, (m, bench_input()), get_env('CAMEL_BENCH_EXPORT'))
    return 0
}

func do_export_full(m: LoraMlp): int sync {
    export_model(step_full, (m, bench_input()), get_env('CAMEL_BENCH_EXPORT'))
    return 0
}

func do_step_dump(m: LoraMlp): int sync {
    let x = load_npy(get_env('CAMEL_BENCH_INPUT'))
    let vg = step(m, x)
    'CAMEL_BENCH loss={}'->format<vg.0>->println
    save_params(vg.1, get_env('CAMEL_FT_DUMP'))
    return 0
}

func do_export_ce(m: LoraMlp): int sync {
    let dir = get_env('CAMEL_FT_BATCHES')
    let x = load_npy(dir + '/batch_0.npy')
    let t = load_npy(dir + '/target_0.npy')
    export_model(step_ce, (m, x, t), get_env('CAMEL_BENCH_EXPORT'))
    return 0
}

func do_train_ce(m: LoraMlp): int sync {
    let steps = int(get_env('CAMEL_FT_STEPS'))
    let nb = int(get_env('CAMEL_FT_NBATCHES'))
    let final = loop_ce(m, 0, steps, nb)
    let dump = get_env('CAMEL_FT_DUMP')
    if dump != '' then save_params(final, dump)
    return 0
}

func main(): int sync {
    let m = load()
    let workload = get_env('CAMEL_BENCH_WORKLOAD')
    return if workload == 'export_lora' then do_export_lora(m) else if workload == 'export_full' then do_export_full(m) else if workload == 'export_ce' then do_export_ce(m) else if workload == 'train_ce' then do_train_ce(m) else do_step_dump(m)
}
