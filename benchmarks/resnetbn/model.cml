/**
 * Camel implementation of the `resnetbn` benchmark (T4, see benchmarks/README.md): the
 * literal ResNet-18 — RESNET (E6) with training-mode batch_norm after every conv (the
 * 1x1 shortcut convs included). The affine gamma/beta are trainable parameters inside the
 * model struct; the running mean/variance travel as a second struct (BnStats) so one
 * training step is the pure function (m, x, s) -> (loss, m', s') — the T3 single-step
 * pattern. Generated by tools/gen_model_cml.py.
 */
module resnetbn

import { Tensor, relu, mean, flatten } from tensor
import { grad, value_and_grad } from autodiff
import { conv2d, batch_norm_train, sgd, save_params } from nn
import { get_env } from sys
import { export_model } from onnx
import { weight, bench_input, run_benchmark, run_training } from camel_bench

type Resnet = {
    stem_w: Tensor,
    stem_b: Tensor, stem_bn_g: Tensor, stem_bn_b: Tensor,
    b11_c1_w: Tensor,
    b11_c1_b: Tensor, b11_c1_bn_g: Tensor, b11_c1_bn_b: Tensor,
    b11_c2_w: Tensor,
    b11_c2_b: Tensor, b11_c2_bn_g: Tensor, b11_c2_bn_b: Tensor,
    b12_c1_w: Tensor,
    b12_c1_b: Tensor, b12_c1_bn_g: Tensor, b12_c1_bn_b: Tensor,
    b12_c2_w: Tensor,
    b12_c2_b: Tensor, b12_c2_bn_g: Tensor, b12_c2_bn_b: Tensor,
    b21_c1_w: Tensor,
    b21_c1_b: Tensor, b21_c1_bn_g: Tensor, b21_c1_bn_b: Tensor,
    b21_c2_w: Tensor,
    b21_c2_b: Tensor, b21_c2_bn_g: Tensor, b21_c2_bn_b: Tensor,
    b21_ds_w: Tensor,
    b21_ds_b: Tensor, b21_ds_bn_g: Tensor, b21_ds_bn_b: Tensor,
    b22_c1_w: Tensor,
    b22_c1_b: Tensor, b22_c1_bn_g: Tensor, b22_c1_bn_b: Tensor,
    b22_c2_w: Tensor,
    b22_c2_b: Tensor, b22_c2_bn_g: Tensor, b22_c2_bn_b: Tensor,
    b31_c1_w: Tensor,
    b31_c1_b: Tensor, b31_c1_bn_g: Tensor, b31_c1_bn_b: Tensor,
    b31_c2_w: Tensor,
    b31_c2_b: Tensor, b31_c2_bn_g: Tensor, b31_c2_bn_b: Tensor,
    b31_ds_w: Tensor,
    b31_ds_b: Tensor, b31_ds_bn_g: Tensor, b31_ds_bn_b: Tensor,
    b32_c1_w: Tensor,
    b32_c1_b: Tensor, b32_c1_bn_g: Tensor, b32_c1_bn_b: Tensor,
    b32_c2_w: Tensor,
    b32_c2_b: Tensor, b32_c2_bn_g: Tensor, b32_c2_bn_b: Tensor,
    b41_c1_w: Tensor,
    b41_c1_b: Tensor, b41_c1_bn_g: Tensor, b41_c1_bn_b: Tensor,
    b41_c2_w: Tensor,
    b41_c2_b: Tensor, b41_c2_bn_g: Tensor, b41_c2_bn_b: Tensor,
    b41_ds_w: Tensor,
    b41_ds_b: Tensor, b41_ds_bn_g: Tensor, b41_ds_bn_b: Tensor,
    b42_c1_w: Tensor,
    b42_c1_b: Tensor, b42_c1_bn_g: Tensor, b42_c1_bn_b: Tensor,
    b42_c2_w: Tensor,
    b42_c2_b: Tensor, b42_c2_bn_g: Tensor, b42_c2_bn_b: Tensor,
    fc_w: Tensor,
    fc_b: Tensor
}

type BnStats = {
    stem_bn_rm: Tensor, stem_bn_rv: Tensor,
    b11_c1_bn_rm: Tensor, b11_c1_bn_rv: Tensor,
    b11_c2_bn_rm: Tensor, b11_c2_bn_rv: Tensor,
    b12_c1_bn_rm: Tensor, b12_c1_bn_rv: Tensor,
    b12_c2_bn_rm: Tensor, b12_c2_bn_rv: Tensor,
    b21_c1_bn_rm: Tensor, b21_c1_bn_rv: Tensor,
    b21_c2_bn_rm: Tensor, b21_c2_bn_rv: Tensor,
    b21_ds_bn_rm: Tensor, b21_ds_bn_rv: Tensor,
    b22_c1_bn_rm: Tensor, b22_c1_bn_rv: Tensor,
    b22_c2_bn_rm: Tensor, b22_c2_bn_rv: Tensor,
    b31_c1_bn_rm: Tensor, b31_c1_bn_rv: Tensor,
    b31_c2_bn_rm: Tensor, b31_c2_bn_rv: Tensor,
    b31_ds_bn_rm: Tensor, b31_ds_bn_rv: Tensor,
    b32_c1_bn_rm: Tensor, b32_c1_bn_rv: Tensor,
    b32_c2_bn_rm: Tensor, b32_c2_bn_rv: Tensor,
    b41_c1_bn_rm: Tensor, b41_c1_bn_rv: Tensor,
    b41_c2_bn_rm: Tensor, b41_c2_bn_rv: Tensor,
    b41_ds_bn_rm: Tensor, b41_ds_bn_rv: Tensor,
    b42_c1_bn_rm: Tensor, b42_c1_bn_rv: Tensor,
    b42_c2_bn_rm: Tensor, b42_c2_bn_rv: Tensor
}

func block(x: Tensor, c1w: Tensor, c1b: Tensor, g1: Tensor, b1: Tensor, rm1: Tensor, rv1: Tensor, c2w: Tensor, c2b: Tensor, g2: Tensor, b2: Tensor, rm2: Tensor, rv2: Tensor): (Tensor, Tensor, Tensor, Tensor, Tensor) {
    let r1 = batch_norm_train(conv2d(x, c1w, c1b, 1, 1), g1, b1, rm1, rv1)
    let r2 = batch_norm_train(conv2d(relu(r1.0), c2w, c2b, 1, 1), g2, b2, rm2, rv2)
    return (relu(r2.0 + x), r1.1, r1.2, r2.1, r2.2)
}

func block_ds(x: Tensor, c1w: Tensor, c1b: Tensor, g1: Tensor, b1: Tensor, rm1: Tensor, rv1: Tensor, c2w: Tensor, c2b: Tensor, g2: Tensor, b2: Tensor, rm2: Tensor, rv2: Tensor, dsw: Tensor, dsb: Tensor, gd: Tensor, bd: Tensor, rmd: Tensor, rvd: Tensor): (Tensor, Tensor, Tensor, Tensor, Tensor, Tensor, Tensor) {
    let r1 = batch_norm_train(conv2d(x, c1w, c1b, 2, 1), g1, b1, rm1, rv1)
    let r2 = batch_norm_train(conv2d(relu(r1.0), c2w, c2b, 1, 1), g2, b2, rm2, rv2)
    let rd = batch_norm_train(conv2d(x, dsw, dsb, 2, 0), gd, bd, rmd, rvd)
    return (relu(r2.0 + rd.0), r1.1, r1.2, r2.1, r2.2, rd.1, rd.2)
}

with <m: Resnet>
func forward(x: Tensor, s: BnStats): (Tensor, BnStats) {
    let r_stem = batch_norm_train(conv2d(x, m.stem_w, m.stem_b, 1, 1), m.stem_bn_g, m.stem_bn_b, s.stem_bn_rm, s.stem_bn_rv)
    let r_b11 = block(relu(r_stem.0), m.b11_c1_w, m.b11_c1_b, m.b11_c1_bn_g, m.b11_c1_bn_b, s.b11_c1_bn_rm, s.b11_c1_bn_rv, m.b11_c2_w, m.b11_c2_b, m.b11_c2_bn_g, m.b11_c2_bn_b, s.b11_c2_bn_rm, s.b11_c2_bn_rv)
    let r_b12 = block(r_b11.0, m.b12_c1_w, m.b12_c1_b, m.b12_c1_bn_g, m.b12_c1_bn_b, s.b12_c1_bn_rm, s.b12_c1_bn_rv, m.b12_c2_w, m.b12_c2_b, m.b12_c2_bn_g, m.b12_c2_bn_b, s.b12_c2_bn_rm, s.b12_c2_bn_rv)
    let r_b21 = block_ds(r_b12.0, m.b21_c1_w, m.b21_c1_b, m.b21_c1_bn_g, m.b21_c1_bn_b, s.b21_c1_bn_rm, s.b21_c1_bn_rv, m.b21_c2_w, m.b21_c2_b, m.b21_c2_bn_g, m.b21_c2_bn_b, s.b21_c2_bn_rm, s.b21_c2_bn_rv, m.b21_ds_w, m.b21_ds_b, m.b21_ds_bn_g, m.b21_ds_bn_b, s.b21_ds_bn_rm, s.b21_ds_bn_rv)
    let r_b22 = block(r_b21.0, m.b22_c1_w, m.b22_c1_b, m.b22_c1_bn_g, m.b22_c1_bn_b, s.b22_c1_bn_rm, s.b22_c1_bn_rv, m.b22_c2_w, m.b22_c2_b, m.b22_c2_bn_g, m.b22_c2_bn_b, s.b22_c2_bn_rm, s.b22_c2_bn_rv)
    let r_b31 = block_ds(r_b22.0, m.b31_c1_w, m.b31_c1_b, m.b31_c1_bn_g, m.b31_c1_bn_b, s.b31_c1_bn_rm, s.b31_c1_bn_rv, m.b31_c2_w, m.b31_c2_b, m.b31_c2_bn_g, m.b31_c2_bn_b, s.b31_c2_bn_rm, s.b31_c2_bn_rv, m.b31_ds_w, m.b31_ds_b, m.b31_ds_bn_g, m.b31_ds_bn_b, s.b31_ds_bn_rm, s.b31_ds_bn_rv)
    let r_b32 = block(r_b31.0, m.b32_c1_w, m.b32_c1_b, m.b32_c1_bn_g, m.b32_c1_bn_b, s.b32_c1_bn_rm, s.b32_c1_bn_rv, m.b32_c2_w, m.b32_c2_b, m.b32_c2_bn_g, m.b32_c2_bn_b, s.b32_c2_bn_rm, s.b32_c2_bn_rv)
    let r_b41 = block_ds(r_b32.0, m.b41_c1_w, m.b41_c1_b, m.b41_c1_bn_g, m.b41_c1_bn_b, s.b41_c1_bn_rm, s.b41_c1_bn_rv, m.b41_c2_w, m.b41_c2_b, m.b41_c2_bn_g, m.b41_c2_bn_b, s.b41_c2_bn_rm, s.b41_c2_bn_rv, m.b41_ds_w, m.b41_ds_b, m.b41_ds_bn_g, m.b41_ds_bn_b, s.b41_ds_bn_rm, s.b41_ds_bn_rv)
    let r_b42 = block(r_b41.0, m.b42_c1_w, m.b42_c1_b, m.b42_c1_bn_g, m.b42_c1_bn_b, s.b42_c1_bn_rm, s.b42_c1_bn_rv, m.b42_c2_w, m.b42_c2_b, m.b42_c2_bn_g, m.b42_c2_bn_b, s.b42_c2_bn_rm, s.b42_c2_bn_rv)
    let g = flatten(mean(mean(r_b42.0, 2), 2))
    let y = g @ m.fc_w + m.fc_b
    return (y, {
        stem_bn_rm: r_stem.1, stem_bn_rv: r_stem.2,
        b11_c1_bn_rm: r_b11.1, b11_c1_bn_rv: r_b11.2,
        b11_c2_bn_rm: r_b11.3, b11_c2_bn_rv: r_b11.4,
        b12_c1_bn_rm: r_b12.1, b12_c1_bn_rv: r_b12.2,
        b12_c2_bn_rm: r_b12.3, b12_c2_bn_rv: r_b12.4,
        b21_c1_bn_rm: r_b21.1, b21_c1_bn_rv: r_b21.2,
        b21_c2_bn_rm: r_b21.3, b21_c2_bn_rv: r_b21.4,
        b21_ds_bn_rm: r_b21.5, b21_ds_bn_rv: r_b21.6,
        b22_c1_bn_rm: r_b22.1, b22_c1_bn_rv: r_b22.2,
        b22_c2_bn_rm: r_b22.3, b22_c2_bn_rv: r_b22.4,
        b31_c1_bn_rm: r_b31.1, b31_c1_bn_rv: r_b31.2,
        b31_c2_bn_rm: r_b31.3, b31_c2_bn_rv: r_b31.4,
        b31_ds_bn_rm: r_b31.5, b31_ds_bn_rv: r_b31.6,
        b32_c1_bn_rm: r_b32.1, b32_c1_bn_rv: r_b32.2,
        b32_c2_bn_rm: r_b32.3, b32_c2_bn_rv: r_b32.4,
        b41_c1_bn_rm: r_b41.1, b41_c1_bn_rv: r_b41.2,
        b41_c2_bn_rm: r_b41.3, b41_c2_bn_rv: r_b41.4,
        b41_ds_bn_rm: r_b41.5, b41_ds_bn_rv: r_b41.6,
        b42_c1_bn_rm: r_b42.1, b42_c1_bn_rv: r_b42.2,
        b42_c2_bn_rm: r_b42.3, b42_c2_bn_rv: r_b42.4
    })
}

// Training workload (train.py): loss mean(y^2), one SGD step with lr 0.01. The
// batch_norm running statistics are updated inside the forward (and discarded with it,
// like every other activation — the timing protocol starts every step from the same
// weights and statistics, as in E6).
with <m: Resnet>
func loss(x: Tensor, s: BnStats): float {
    let r = forward<m>(x, s)
    return mean(r.0 * r.0)
}

func train_step(m: Resnet, s: BnStats, x: Tensor): float sync {
    let vg = value_and_grad(loss)<m>(x, s)
    let next = sgd(m, vg.1, 0.01)
    return vg.0
}

/// The training step as a function of the parameters, the input and the running
/// statistics: the loss, the updated parameters and the updated statistics.
func step(m: Resnet, x: Tensor, s: BnStats): (float, Resnet, BnStats) {
    let vg = value_and_grad(loss)<m>(x, s)
    let r = forward<m>(x, s)
    return (vg.0, sgd(m, vg.1, 0.01), r.1)
}

/// Exports `step` to ONNX: the parameters, the input and the running statistics become
/// graph inputs; the loss, the updated parameters and the updated statistics the outputs.
func export_step(m: Resnet, s: BnStats, path: string): int sync {
    export_model(step, (m, bench_input(), s), path)
    return 0
}

func dump_grads(m: Resnet, s: BnStats, x: Tensor, dir: string): int sync {
    save_params(grad(loss)<m>(x, s), dir)
    let r = forward<m>(x, s)
    save_params(r.1, dir)
    return 0
}

func main(): int sync {
    let m = {
        stem_w: weight('stem_w'),
        stem_b: weight('stem_b'), stem_bn_g: weight('stem_bn_g'), stem_bn_b: weight('stem_bn_b'),
        b11_c1_w: weight('b11_c1_w'),
        b11_c1_b: weight('b11_c1_b'), b11_c1_bn_g: weight('b11_c1_bn_g'), b11_c1_bn_b: weight('b11_c1_bn_b'),
        b11_c2_w: weight('b11_c2_w'),
        b11_c2_b: weight('b11_c2_b'), b11_c2_bn_g: weight('b11_c2_bn_g'), b11_c2_bn_b: weight('b11_c2_bn_b'),
        b12_c1_w: weight('b12_c1_w'),
        b12_c1_b: weight('b12_c1_b'), b12_c1_bn_g: weight('b12_c1_bn_g'), b12_c1_bn_b: weight('b12_c1_bn_b'),
        b12_c2_w: weight('b12_c2_w'),
        b12_c2_b: weight('b12_c2_b'), b12_c2_bn_g: weight('b12_c2_bn_g'), b12_c2_bn_b: weight('b12_c2_bn_b'),
        b21_c1_w: weight('b21_c1_w'),
        b21_c1_b: weight('b21_c1_b'), b21_c1_bn_g: weight('b21_c1_bn_g'), b21_c1_bn_b: weight('b21_c1_bn_b'),
        b21_c2_w: weight('b21_c2_w'),
        b21_c2_b: weight('b21_c2_b'), b21_c2_bn_g: weight('b21_c2_bn_g'), b21_c2_bn_b: weight('b21_c2_bn_b'),
        b21_ds_w: weight('b21_ds_w'),
        b21_ds_b: weight('b21_ds_b'), b21_ds_bn_g: weight('b21_ds_bn_g'), b21_ds_bn_b: weight('b21_ds_bn_b'),
        b22_c1_w: weight('b22_c1_w'),
        b22_c1_b: weight('b22_c1_b'), b22_c1_bn_g: weight('b22_c1_bn_g'), b22_c1_bn_b: weight('b22_c1_bn_b'),
        b22_c2_w: weight('b22_c2_w'),
        b22_c2_b: weight('b22_c2_b'), b22_c2_bn_g: weight('b22_c2_bn_g'), b22_c2_bn_b: weight('b22_c2_bn_b'),
        b31_c1_w: weight('b31_c1_w'),
        b31_c1_b: weight('b31_c1_b'), b31_c1_bn_g: weight('b31_c1_bn_g'), b31_c1_bn_b: weight('b31_c1_bn_b'),
        b31_c2_w: weight('b31_c2_w'),
        b31_c2_b: weight('b31_c2_b'), b31_c2_bn_g: weight('b31_c2_bn_g'), b31_c2_bn_b: weight('b31_c2_bn_b'),
        b31_ds_w: weight('b31_ds_w'),
        b31_ds_b: weight('b31_ds_b'), b31_ds_bn_g: weight('b31_ds_bn_g'), b31_ds_bn_b: weight('b31_ds_bn_b'),
        b32_c1_w: weight('b32_c1_w'),
        b32_c1_b: weight('b32_c1_b'), b32_c1_bn_g: weight('b32_c1_bn_g'), b32_c1_bn_b: weight('b32_c1_bn_b'),
        b32_c2_w: weight('b32_c2_w'),
        b32_c2_b: weight('b32_c2_b'), b32_c2_bn_g: weight('b32_c2_bn_g'), b32_c2_bn_b: weight('b32_c2_bn_b'),
        b41_c1_w: weight('b41_c1_w'),
        b41_c1_b: weight('b41_c1_b'), b41_c1_bn_g: weight('b41_c1_bn_g'), b41_c1_bn_b: weight('b41_c1_bn_b'),
        b41_c2_w: weight('b41_c2_w'),
        b41_c2_b: weight('b41_c2_b'), b41_c2_bn_g: weight('b41_c2_bn_g'), b41_c2_bn_b: weight('b41_c2_bn_b'),
        b41_ds_w: weight('b41_ds_w'),
        b41_ds_b: weight('b41_ds_b'), b41_ds_bn_g: weight('b41_ds_bn_g'), b41_ds_bn_b: weight('b41_ds_bn_b'),
        b42_c1_w: weight('b42_c1_w'),
        b42_c1_b: weight('b42_c1_b'), b42_c1_bn_g: weight('b42_c1_bn_g'), b42_c1_bn_b: weight('b42_c1_bn_b'),
        b42_c2_w: weight('b42_c2_w'),
        b42_c2_b: weight('b42_c2_b'), b42_c2_bn_g: weight('b42_c2_bn_g'), b42_c2_bn_b: weight('b42_c2_bn_b'),
        fc_w: weight('fc_w'),
        fc_b: weight('fc_b')
    }
    let s = {
        stem_bn_rm: weight('stem_bn_rm'), stem_bn_rv: weight('stem_bn_rv'),
        b11_c1_bn_rm: weight('b11_c1_bn_rm'), b11_c1_bn_rv: weight('b11_c1_bn_rv'),
        b11_c2_bn_rm: weight('b11_c2_bn_rm'), b11_c2_bn_rv: weight('b11_c2_bn_rv'),
        b12_c1_bn_rm: weight('b12_c1_bn_rm'), b12_c1_bn_rv: weight('b12_c1_bn_rv'),
        b12_c2_bn_rm: weight('b12_c2_bn_rm'), b12_c2_bn_rv: weight('b12_c2_bn_rv'),
        b21_c1_bn_rm: weight('b21_c1_bn_rm'), b21_c1_bn_rv: weight('b21_c1_bn_rv'),
        b21_c2_bn_rm: weight('b21_c2_bn_rm'), b21_c2_bn_rv: weight('b21_c2_bn_rv'),
        b21_ds_bn_rm: weight('b21_ds_bn_rm'), b21_ds_bn_rv: weight('b21_ds_bn_rv'),
        b22_c1_bn_rm: weight('b22_c1_bn_rm'), b22_c1_bn_rv: weight('b22_c1_bn_rv'),
        b22_c2_bn_rm: weight('b22_c2_bn_rm'), b22_c2_bn_rv: weight('b22_c2_bn_rv'),
        b31_c1_bn_rm: weight('b31_c1_bn_rm'), b31_c1_bn_rv: weight('b31_c1_bn_rv'),
        b31_c2_bn_rm: weight('b31_c2_bn_rm'), b31_c2_bn_rv: weight('b31_c2_bn_rv'),
        b31_ds_bn_rm: weight('b31_ds_bn_rm'), b31_ds_bn_rv: weight('b31_ds_bn_rv'),
        b32_c1_bn_rm: weight('b32_c1_bn_rm'), b32_c1_bn_rv: weight('b32_c1_bn_rv'),
        b32_c2_bn_rm: weight('b32_c2_bn_rm'), b32_c2_bn_rv: weight('b32_c2_bn_rv'),
        b41_c1_bn_rm: weight('b41_c1_bn_rm'), b41_c1_bn_rv: weight('b41_c1_bn_rv'),
        b41_c2_bn_rm: weight('b41_c2_bn_rm'), b41_c2_bn_rv: weight('b41_c2_bn_rv'),
        b41_ds_bn_rm: weight('b41_ds_bn_rm'), b41_ds_bn_rv: weight('b41_ds_bn_rv'),
        b42_c1_bn_rm: weight('b42_c1_bn_rm'), b42_c1_bn_rv: weight('b42_c1_bn_rv'),
        b42_c2_bn_rm: weight('b42_c2_bn_rm'), b42_c2_bn_rv: weight('b42_c2_bn_rv')
    }
    let workload = get_env('CAMEL_BENCH_WORKLOAD')
    return if workload == 'train_export' then export_step(m, s, get_env('CAMEL_BENCH_EXPORT')) else if workload == 'train' then run_training(
        (x: Tensor): float => { return train_step(m, s, x) },
        (x: Tensor, dir: string): int => { return dump_grads(m, s, x, dir) }
    ) else run_benchmark((x: Tensor): Tensor => { return forward<m>(x, s).0 })
}
