/**
 * T13 account 4 (Camel side): single-layer forward+backward micro-benchmark.
 *
 * Times one `with_grad` step of a one-layer function (a GEMM or a conv2d
 * with the exact shapes of an mlp_big / lenet_big layer) under std::nvm, with
 * CAMEL_TENSOR_OPSTATS=1 so the stderr op table gives the per-shape kernel time
 * of matmul / matmul_grad_lhs / matmul_grad_rhs (or conv2d + its grad kernels)
 * with one call site each -- no cross-shape aggregation.
 *
 * Env: MICRO_OP = lin | conv_s1_p2 | conv_s1_p0; MICRO_DIR = dir with x.npy,
 * w.npy (, b.npy); CAMEL_BENCH_{THREADS,WARMUP,REPS} as in camel_bench.
 * Prints CAMEL_BENCH latency_ms lines like camel_bench.timed_steps.
 */
module micro

import { Tensor, load_npy, set_num_threads, mean } from tensor
import { with_grad } from autodiff
import { conv2d, sgd } from nn
import { get_env } from env
import { now } from time

func lin(x: Tensor, w: Tensor): float {
    return mean(x @ w)
}

func conv_s1_p2(x: Tensor, w: Tensor, b: Tensor): float {
    return mean(conv2d(x, w, b, 1, 2))
}

func conv_s1_p0(x: Tensor, w: Tensor, b: Tensor): float {
    return mean(conv2d(x, w, b, 1, 0))
}

func warm(step: () => float, remaining: int): int {
    return if remaining <= 0 then 0 else sync {
        let v = step()
        return warm(step, remaining - 1)
    }
}

func timed(step: () => float, remaining: int): int {
    return if remaining <= 0 then 0 else sync {
        let start = now()
        let v = step()
        'CAMEL_BENCH latency_ms={}'->format<(now() - start) * 1000.0>->println
        return timed(step, remaining - 1)
    }
}

func main(): int sync {
    set_num_threads(int(get_env('CAMEL_BENCH_THREADS')))
    let dir = get_env('MICRO_DIR')
    let op = get_env('MICRO_OP')
    let x = load_npy::<f32>(dir + '/x.npy')
    let w = load_npy::<f32>(dir + '/w.npy')
    if op == 'lin' then sync {
        let step = (): float => { return with_grad(lin)(x, w).0 }
        let first = step()
        let warmed = warm(step, int(get_env('CAMEL_BENCH_WARMUP')) - 1)
        return timed(step, int(get_env('CAMEL_BENCH_REPS')))
    } else if op == 'sgd' then sync {
        // nn:sgd is not wrapped by op-stats; time the fused update kernel by wall
        // clock. x plays the parameter, w its gradient (same shape).
        let step = (): float => sync { let next = sgd(x, w, 0.01); return 0.0 }
        let first = step()
        let warmed = warm(step, int(get_env('CAMEL_BENCH_WARMUP')) - 1)
        return timed(step, int(get_env('CAMEL_BENCH_REPS')))
    } else sync {
        let b = load_npy::<f32>(dir + '/b.npy')
        let step = if op == 'conv_s1_p2' then (): float => { return with_grad(conv_s1_p2)(x, w, b).0 }
                   else (): float => { return with_grad(conv_s1_p0)(x, w, b).0 }
        let first = step()
        let warmed = warm(step, int(get_env('CAMEL_BENCH_WARMUP')) - 1)
        return timed(step, int(get_env('CAMEL_BENCH_REPS')))
    }
}
