/**
 * E10 first-order baseline for the graph-stats comparison: same MLP and loss as
 * e10_second.cml, but only the first derivative is materialized.
 * The differentiated quantity (input scale t) is the with-parameter.
 */

import { grad } from autodiff
import { relu, mean, reshape } from tensor

func fwd(w1: float[..], b1: float[..], w2: float[..], b2: float[..], x: float[..]): float[..] {
    let h = relu(x @ w1 + b1)
    return h @ w2 + b2
}

with <t: float>
func loss_s(): float {
    let w1 = reshape<[2, 3]>([0.5, -0.25, 0.75, 1.0, -0.5, 0.25])
    let b1 = reshape<[3]>([0.1, 0.0, -0.1])
    let w2 = reshape<[3, 1]>([1.0, -1.0, 0.5])
    let b2 = reshape<[1]>([0.2])
    let x = reshape<[1, 2]>([1.0, 2.0])
    let y = fwd(w1, b1, w2, b2, x * t)
    return float(mean(y * y))
}

func main(): int sync {
    let d1 = grad(loss_s)<1.0>()
    'd1={}'->format<d1>->println
    return 0
}
