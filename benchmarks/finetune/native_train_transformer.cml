/**
 * E1 Camel-native multi-step fine-tuning loop for the `transformer` benchmark
 * model. Same block/loss/SGD as benchmarks/transformer/model.cml (pre-LN
 * block over x[B,64,128], 4-head self-attention, GELU(tanh) FFN width 512;
 * loss mean(y*y); SGD lr 0.01), but the updated parameters are carried across
 * N steps. Step i reads batch `i % nb` from CAMEL_FT_BATCHES (pre-split by
 * make_data.py), prints `CAMEL_BENCH step=<i> loss=<v>`, and dumps the updated
 * parameters to CAMEL_FT_DUMP/step_<i>/ for the three-way alignment.
 */

import { layer_norm, softmax, gelu, reshape, permute, transpose, shape, mean, load_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { sqrt } from math
import { weight } from camel_bench

type Block = {
    ln1_gamma: f32[..], ln1_beta: f32[..],
    q_w: f32[..], q_b: f32[..], k_w: f32[..], k_b: f32[..],
    v_w: f32[..], v_b: f32[..], o_w: f32[..], o_b: f32[..],
    ln2_gamma: f32[..], ln2_beta: f32[..],
    ffn1_w: f32[..], ffn1_b: f32[..], ffn2_w: f32[..], ffn2_b: f32[..]
}

/// [B, S, D] -> [B, H, S, D / H]
func split_heads(t: f32[..], heads: int): f32[..] {
    let dims = shape(t)
    return permute(reshape(t, [dims[0], dims[1], heads, dims[2] / heads]), [0, 2, 1, 3])
}

/// [B, H, S, Dh] -> [B, S, H * Dh]
func merge_heads(t: f32[..]): f32[..] {
    let dims = shape(t)
    return reshape(permute(t, [0, 2, 1, 3]), [dims[0], dims[2], dims[1] * dims[3]])
}

with <m: Block>
func attention(x: f32[..]): f32[..] {
    let heads = 4
    let q = split_heads(x @ m.q_w + m.q_b, heads)
    let k = split_heads(x @ m.k_w + m.k_b, heads)
    let v = split_heads(x @ m.v_w + m.v_b, heads)
    let scale = 1.0 / sqrt(float(shape(q)[3]))
    let weights = softmax((q @ transpose(k)) * scale)
    return merge_heads(weights @ v) @ m.o_w + m.o_b
}

with <m: Block>
func forward(x: f32[..]): f32[..] {
    let h = x + attention<m>(layer_norm(x, m.ln1_gamma, m.ln1_beta))
    let f = gelu(layer_norm(h, m.ln2_gamma, m.ln2_beta) @ m.ffn1_w + m.ffn1_b)
    return h + (f @ m.ffn2_w + m.ffn2_b)
}

with <m: Block>
func loss(x: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(y * y))
}

/// One training step: the loss and the updated parameters (as exported to ONNX).
func step(m: Block, x: f32[..]): (float, Block) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func spin(m: Block, i: int, steps: int, nb: int): Block {
    return if i >= steps then m else sync {
        let si = '{}'->format<i>
        let bi = '{}'->format<i % nb>
        let x = load_npy::<f32>(get_env('CAMEL_FT_BATCHES') + '/batch_' + bi + '.npy')
        let vg = step(m, x)
        'CAMEL_BENCH step={} loss={}'->format<i, vg.0>->println
        let dump = get_env('CAMEL_FT_DUMP')
        if dump != '' then save_params(vg.1, dump + '/step_' + si)
        return spin(vg.1, i + 1, steps, nb)
    }
}

func main(): int sync {
    let m = {
        ln1_gamma: weight('ln1_gamma'), ln1_beta: weight('ln1_beta'),
        q_w: weight('q_w'), q_b: weight('q_b'), k_w: weight('k_w'), k_b: weight('k_b'),
        v_w: weight('v_w'), v_b: weight('v_b'), o_w: weight('o_w'), o_b: weight('o_b'),
        ln2_gamma: weight('ln2_gamma'), ln2_beta: weight('ln2_beta'),
        ffn1_w: weight('ffn1_w'), ffn1_b: weight('ffn1_b'),
        ffn2_w: weight('ffn2_w'), ffn2_b: weight('ffn2_b')
    }
    let steps = int(get_env('CAMEL_FT_STEPS'))
    let nb = int(get_env('CAMEL_FT_NBATCHES'))
    let final = spin(m, 0, steps, nb)
    return 0
}
