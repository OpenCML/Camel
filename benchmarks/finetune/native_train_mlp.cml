/**
 * E1 Camel-native multi-step fine-tuning loop for the `mlp` benchmark model.
 * Same model/loss/SGD as benchmarks/mlp/model.cml (x[B,784] -> Linear(784,256)
 * -> ReLU -> Linear(256,128) -> ReLU -> Linear(128,10); loss mean(y*y); SGD lr
 * 0.01), but the updated parameters are carried across N steps. Step i reads
 * batch `i % nb` from CAMEL_FT_BATCHES (pre-split by make_data.py), prints
 * `CAMEL_BENCH step=<i> loss=<v>`, and dumps the updated parameters to
 * CAMEL_FT_DUMP/step_<i>/ for the three-way alignment.
 */
module native_train_mlp

import { Tensor, relu, mean, load_npy } from tensor
import { with_grad } from autodiff
import { sgd, save_params } from nn
import { get_env } from env
import { weight } from camel_bench

type Mlp = {
    fc1_w: f32[..], fc1_b: f32[..],
    fc2_w: f32[..], fc2_b: f32[..],
    fc3_w: f32[..], fc3_b: f32[..]
}

with <m: Mlp>
func forward(x: f32[..]): f32[..] {
    let h1 = relu(x @ m.fc1_w + m.fc1_b)
    let h2 = relu(h1 @ m.fc2_w + m.fc2_b)
    return h2 @ m.fc3_w + m.fc3_b
}

with <m: Mlp>
func loss(x: f32[..]): float {
    let y = forward<m>(x)
    return float(mean(y * y))
}

/// One training step: the loss and the updated parameters (as exported to ONNX).
func step(m: Mlp, x: f32[..]): (float, Mlp) {
    let vg = with_grad(loss)<m>(x)
    return (vg.0, sgd(m, vg.1, 0.01))
}

func spin(m: Mlp, i: int, steps: int, nb: int): Mlp {
    return if i >= steps then m else sync {
        let si = '{}'->format<i>
        let bi = '{}'->format<i % nb>
        let x = load_npy::<f32>(get_env('CAMEL_FT_BATCHES') + '/batch_' + bi + '.npy')
        let vg = step(m, x)
        'CAMEL_BENCH step={} loss={}'->format<i, vg.0>->println
        let dump = get_env('CAMEL_FT_DUMP')
        if dump != '' then save_params(vg.1, dump + '/step_' + si)
        return spin(vg.1, i + 1, steps, nb)
    }
}

func main(): int sync {
    let m = {
        fc1_w: weight('fc1_w'), fc1_b: weight('fc1_b'),
        fc2_w: weight('fc2_w'), fc2_b: weight('fc2_b'),
        fc3_w: weight('fc3_w'), fc3_b: weight('fc3_b')
    }
    let steps = int(get_env('CAMEL_FT_STEPS'))
    let nb = int(get_env('CAMEL_FT_NBATCHES'))
    let final = spin(m, 0, steps, nb)
    return 0
}
