/**
 * E10 second-order, supported form: everything is a plain function; the inner
 * grad call uses plain application. Compare e10_first/e10_second for the
 * graph-stats table.
 */
module e10_wrap2

import { grad } from autodiff
import { relu, mean, reshape } from tensor

func branchy(x: float): float {
    return if x > 0.0 then x * x * x else x * x
}

func df(x: float): float {
    return grad(branchy)(x)
}

func fwd(w1: float[..], b1: float[..], w2: float[..], b2: float[..], x: float[..]): float[..] {
    let h = relu(x @ w1 + b1)
    return h @ w2 + b2
}

func loss_p(t: float): float {
    let w1 = reshape([0.5, -0.25, 0.75, 1.0, -0.5, 0.25], [2, 3])
    let b1 = reshape([0.1, 0.0, -0.1], [3])
    let w2 = reshape([1.0, -1.0, 0.5], [3, 1])
    let b2 = reshape([0.2], [1])
    let x = reshape([1.0, 2.0], [1, 2])
    let y = fwd(w1, b1, w2, b2, x * t)
    return float(mean(y * y))
}

func dloss_p(t: float): float {
    return grad(loss_p)(t)
}

func main(): int sync {
    let d2_branch = grad(df)(2.0)
    let d2_mlp = grad(dloss_p)(1.0)
    'd2_branch={} d2_mlp={}'->format<d2_branch, d2_mlp>->println
    return 0
}
