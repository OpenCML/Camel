#!/bin/sh
# Two rules, both about a branch that must not be written by accident: `develop` (who may push it)
# and `integration` (what shape an arrival on it must have).
#
# `develop` has one writer by rule (agents/dispatch.md section 8.3): one lane merges and pushes,
# every other lane hands its branch over. A rule kept by memory is kept until the next writer
# forgets it, and the moment it breaks is the moment two lanes have to rebase on each other -- so
# it is a hook. The rule is written the way it is enforced: whichever tree the settings file names
# may push; every other tree is refused with the reason and the key to set.
#
# What it reads: the refs git is about to send, on stdin, one per line as
#   <local ref> <local sha> <remote ref> <remote sha>
# and nothing else. A line whose remote ref is `refs/heads/develop` (a delete included -- `(delete)`
# in the local-ref column) is the one the tree rule is about. A line whose remote ref is
# `refs/heads/integration` is the one the shape rule is about. A working branch or an archive tag
# sent to the project's remote is refused (below). Everything else is allowed, which is the normal
# case, the gate's own staging push to the host's bare repository included (its refs are
# `refs/heads/lane-*`, and it goes to the host, not to the project's remote).
#
# Which tree is the merge worktree is machine-local, so it comes from
# `internal/tools/camel-gate.local.json` (git-ignored) under `mergeWorktree`: one absolute path, or
# a list of them when a machine keeps two. It is read with node, and there is no fallback: a value
# this hook cannot read is a refusal that names the file and the key, never a default of "allow".
# That matters on the day it is broken rather than on the day it is written -- a fresh worktree
# without the settings file must not be the one that writes develop by accident.
#
# The check is the tree doing the push (`git rev-parse --show-toplevel`), not the branch or the
# user: a worktree is what a lane has, and the same person runs the merge lane from another one.
#
# Both rules can be skipped: `git push --no-verify` runs no hook at all. That is said here rather
# than closed here, because a lock in a hook that git itself offers to skip is a lock in name only.
# A push made that way is a push whose conclusion line has to say so.
#
# Installed by `.husky/pre-push`, which calls this script before anything else reads stdin -- a
# reader that runs second may see a drained stream, and an empty stream reads as "no push to
# develop", which is exactly how this hook would let through what it exists to stop.
set -u

target_ref='refs/heads/develop'
integration_ref='refs/heads/integration'

refs=$(cat)
develop_push=''
develop_local=''
develop_remote=''
integration_pushes=''
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "$target_ref" ]; then
        develop_push="$target_ref"
        develop_local="$local_sha"
        develop_remote="$remote_sha"
    fi
    if [ "$remote_ref" = "$integration_ref" ]; then
        integration_pushes="$integration_pushes$local_ref $local_sha $remote_sha
"
    fi
done <<EOF
$refs
EOF

# --- the project's remote carries no working branches ----------------------------
#
# A lane's branch, a seat's batch branch and an archive tag are working state of the machine that
# made them: the merge tools read them from the shared repository, and the project's public remote
# shows only the lines people build on. So a push to the project's remote that would create or
# move one of them is refused here. A delete is allowed, so that one that went out can be taken
# back. The gate's staging pushes go to the build host by URL and are not to this remote.
case "${2:-}" in
    *github.com[:/]OpenCML/Camel | *github.com[:/]OpenCML/Camel.git)
        while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
            [ -n "${remote_ref:-}" ] || continue
            [ "$local_ref" != '(delete)' ] || continue
            case "$remote_ref" in
                refs/heads/lane/* | refs/heads/b/* | refs/heads/seat/* | refs/heads/meta/* | refs/tags/archive/*)
                    echo "pre-push: refusing to push $remote_ref to the project's remote: working branches and archive tags stay in the local repository." >&2
                    echo 'pre-push: the merge tools read lane branches locally; nothing needs them on the remote.' >&2
                    exit 1
                    ;;
            esac
        done <<EOF
$refs
EOF
        ;;
esac

# --- every arrival on `integration` is a merge onto the tip it landed on ---------
#
# The tree rule below says *who* may write develop. This says what shape the commits entering
# `integration` may have, and it is checked here because a push can bypass the tool that makes the
# merges: a seat that merges integration into itself and fast-forwards the seat onto it publishes a
# history whose first-parent chain reads lane commits as arrivals.
#
# A push may carry one merge or a batch of them. Walked by first parent from the pushed tip down to
# the remote tip, every commit is a merge, and the oldest of them has the remote tip as its first
# parent: each merge lands on the tip the one before it left. A single-parent commit on that chain
# is a lane commit that went in without a merge, and a chain that does not end at the remote tip is
# integration having been merged into the seat.
check_integration_shape() {
    while IFS=' ' read -r local_ref local_sha remote_sha; do
        # A delete carries no commit to have a shape.
        [ "$local_ref" != '(delete)' ] || continue
        [ -n "$local_sha" ] || continue
        case "$local_sha" in
            *[!0]*) : ;;
            *) continue ;;
        esac
        # Creating the branch: there is no tip for the chain to end at. All zeros is git's
        # "nothing is there", and a shape check has nothing to compare against.
        case "$remote_sha" in
            '' | *[!0]*) : ;;
            *) continue ;;
        esac
        chain=$(git rev-list --first-parent --parents "$remote_sha..$local_sha" 2>/dev/null)
        state=$?
        if [ "$state" -ne 0 ]; then
            echo "pre-push: refusing to push $local_sha to $integration_ref: the commits in $remote_sha..$local_sha could not be read" >&2
            echo "pre-push: (git rev-list exit $state). A commit this hook cannot read is not a merge." >&2
            exit 1
        fi
        [ -n "$chain" ] || continue
        oldest=''
        while IFS=' ' read -r commit first rest; do
            [ -n "$commit" ] || continue
            if [ -z "$rest" ]; then
                echo "pre-push: refusing to push $local_sha to $integration_ref: $commit is a lane commit that went straight in" >&2
                echo 'pre-push: (it has one parent) every arrival is a merge: merge the lane into integration and push that.' >&2
                exit 1
            fi
            oldest="$first"
        done <<EOF3
$chain
EOF3
        if [ "$oldest" != "$remote_sha" ]; then
            echo "pre-push: refusing to push $local_sha to $integration_ref: the oldest merge in the push has first parent $oldest, and $integration_ref is $remote_sha." >&2
            echo 'pre-push: integration was merged into the seat instead of the lanes into integration;' >&2
            echo 'pre-push: redo it with scripts/merge-batch.mjs, or git checkout -B tmp origin/integration; git merge --no-ff <lane>.' >&2
            exit 1
        fi
    done <<EOF
$integration_pushes
EOF
}

if [ -n "$integration_pushes" ]; then
    check_integration_shape
fi

# --- every merge that arrives on `integration` says what it carries --------------
#
# Lanes are merged onto `integration` in batches without a test run (scripts/merge-batch.mjs), so
# the one thing a push can still be asked is whether each merge in it says what it brought in. The
# merge tool writes the lane's own one-line reading into the merge message as a
# `Lane-Reading:` trailer; a merge that only changes documentation carries
# `Lane-Reading: docs-only`. A merge without the trailer was made by hand, and its reader has
# nothing to go on when the promotion later finds a red.
#
# The range is the one the push sends, walked by first parent: the merges inside a lane's own
# history are part of what that lane brought in, and a single-parent commit such as a documentation
# page is not a merge and is not asked for a reading. A push that creates the branch has no range.
check_integration_readings() {
    while IFS=' ' read -r local_ref local_sha remote_sha; do
        [ "$local_ref" != '(delete)' ] || continue
        [ -n "$local_sha" ] || continue
        case "$local_sha" in
            *[!0]*) : ;;
            *) continue ;;
        esac
        case "$remote_sha" in
            '' | *[!0]*) : ;;
            *) continue ;;
        esac
        merges=$(git rev-list --first-parent --merges "$remote_sha..$local_sha" 2>/dev/null)
        state=$?
        if [ "$state" -ne 0 ]; then
            echo "pre-push: refusing to push $local_ref to $integration_ref: the merges in $remote_sha..$local_sha could not be listed (git rev-list exit $state)." >&2
            echo "pre-push: an unreadable range is not an empty one." >&2
            exit 1
        fi
        missing=''
        for merge in $merges; do
            reading=$(git log -n 1 --format='%(trailers:key=Lane-Reading,valueonly)' "$merge" 2>/dev/null | tr -d '[:space:]')
            if [ -z "$reading" ]; then
                missing="$missing $merge"
            fi
        done
        if [ -n "$missing" ]; then
            echo "pre-push: refusing to push $local_ref to $integration_ref: merge(s) without a Lane-Reading trailer:" >&2
            for merge in $missing; do
                echo "pre-push:   $merge $(git log -n 1 --format=%s "$merge")" >&2
            done
            echo 'pre-push: merge lanes with scripts/merge-batch.mjs, which writes the lane reading into the message;' >&2
            echo 'pre-push: a merge that only changes documentation carries "Lane-Reading: docs-only".' >&2
            exit 1
        fi
    done <<EOF2
$integration_pushes
EOF2
}

if [ -n "$integration_pushes" ]; then
    check_integration_readings
fi

# Nothing here is about another branch: a hook that speaks on every push is read as noise.
[ -n "$develop_push" ] || exit 0

top=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-push: refusing to push $develop_push: this is not inside a worktree, so which tree is" >&2
    echo "pre-push: pushing cannot be answered -- and 只有合并位能推 develop (only the merge worktree may)." >&2
    exit 1
}
config="$top/internal/tools/camel-gate.local.json"

if ! command -v node >/dev/null 2>&1; then
    echo "pre-push: refusing to push $develop_push: node is not on PATH, so $config cannot be read." >&2
    echo "pre-push: an unreadable rule is not an absent one -- 只有合并位能推 develop." >&2
    exit 1
fi

allowed=$(node -e '
const fs = require("fs")
let doc
try {
    doc = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
} catch (error) {
    process.exit(4)
}
const value = doc.mergeWorktree
const list = (Array.isArray(value) ? value : [value])
    .flatMap((one) => String(one).split(";"))
    .map((one) => one.trim())
    .filter(Boolean)
if (list.length === 0) process.exit(3)
process.stdout.write(list.join("\n"))
' "$config")
state=$?

if [ "$state" -eq 3 ]; then
    echo "pre-push: refusing to push $develop_push: $config has no 'mergeWorktree'." >&2
    echo "pre-push: 只有合并位能推 develop -- write that key with the merge worktree's absolute path" >&2
    echo "pre-push: (internal/tools/camel-gate.example.json shows the shape; the file is git-ignored)." >&2
    exit 1
elif [ "$state" -ne 0 ]; then
    echo "pre-push: refusing to push $develop_push: $config could not be read as JSON (node exit $state)." >&2
    echo "pre-push: 只有合并位能推 develop -- an unreadable setting is not an absent one." >&2
    exit 1
fi

# Paths on one machine, written by different tools: `D:\Projects\X`, `D:/Projects/X` and a trailing
# separator are the same tree, and a comparison that says otherwise would refuse the merge lane.
normalize() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr '\\' '/' | sed -e 's:/*$::'
}

here=$(normalize "$top")
match=''
while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    if [ "$(normalize "$candidate")" = "$here" ]; then
        match="$candidate"
    fi
done <<EOF
$allowed
EOF

if [ -z "$match" ]; then
    echo "pre-push: refusing to push $develop_push from this tree: 只有合并位能推 develop" >&2
    echo "pre-push: (only the merge worktree may push develop)." >&2
    echo "pre-push:   this tree:      $top" >&2
    echo "pre-push:   merge worktree: $(printf '%s' "$allowed" | tr '\n' ' ')" >&2
    echo "pre-push:   $config, key 'mergeWorktree', names the tree that may write develop." >&2
    echo "pre-push: push your own branch and hand it to the merge lane; develop is merged there." >&2
    exit 1
fi

# The tree rule above says *who* may write develop. This says *what* may be written: the tip this
# push publishes has to carry a promotion record -- the whole layer measured on that tip, the
# comparison with the previous promotion case by case, and what its timeouts said once they were run
# alone. A tip is read against the layer, not against the tree it lands on.
if [ -n "$develop_local" ]; then
    node "$top/scripts/promotion-record.mjs" "$develop_local" >&2
    state=$?
    if [ "$state" -eq 1 ]; then
        echo "pre-push: refusing to push $develop_push: 缺晋级记录" >&2
        echo "pre-push: (the tip $develop_local has no promotion record -- the reading that covers a tip is the" >&2
        echo "pre-push: layer measured on it, the comparison with the previous promotion, and its timeouts run" >&2
        echo "pre-push: alone)." >&2
        exit 1
    elif [ "$state" -ne 0 ]; then
        echo "pre-push: refusing to push $develop_push: the promotion record could not be read (node exit $state)." >&2
        echo "pre-push: an unreadable record is not an absent one." >&2
        exit 1
    fi
fi

echo "pre-push: $develop_push from the merge worktree ($top): allowed"
exit 0
