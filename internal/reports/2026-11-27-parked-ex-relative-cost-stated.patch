+/// trusting a sentence in a document.
+slot_t relativeCostStatedKernel(ArgsView &, ArgsView &norm, Context &) {
+    const auto *handle             = norm.get<Handle *>(0);
+    const NodeView node            = viewOf(handle, "graph.relative_cost_stated");
+    const camel::core::OperId oper = operOf(node, handle, "graph.relative_cost_stated");
+    if (oper == camel::core::kNoOper) {
+        return toSlot<Bool>(false);
+    }
+    const camel::ops::Record *record = OperatorTable::instance().recordOf(oper);
+    return toSlot<Bool>(record != nullptr && record->relativeCost.stated());
+}
