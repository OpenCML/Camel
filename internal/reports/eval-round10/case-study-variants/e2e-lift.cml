// Item A's first rewrite of the e2e program: the closure's body lifted into a named declaration, so
// the lambda only calls it. It must print the same five lines as e2e/program.cml.

func closure_body(base: int, label: string, x: int) => int sync {
    let weight = base + 1
    let value = weight + x
    '{} {} -> {}'->format<label, x, weight + x>->println
    return value
}

func apply(f: (x: int) => int, x: int) => int sync {
    return f(x)
}

func run(n: int, base: int) => int sync {
    let label = 'step'
    let twice = base * 2
    let thrice = base * 3
    let f = func (x: int) => int sync {
        return closure_body(base, label, x)
    }
    let (_, total) = loop i = 0, total = twice + thrice while i < n do sync {
        (i + 1, total + apply(f, i))
    }
    let tail = apply(f, n)
    'total {} tail {}'->format<total, tail>->println
    return total
}

func main() => int sync {
    let _ = run(3, 10)
    return 0
}
