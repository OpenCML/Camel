// (3) Scoped: a node in one arm of a branch is made to read a value of the other arm. The exit is not
// touched, so the exit rule cannot be the one that answers.
import { Graph, Node, RegionKind, commit, graphs_of, id, inputs, nodes, open, region_kind, region_of, replace } from graph
import { is_function } from types

/// Every node of a graph that sits in an arm.
func arm_nodes(g: Graph) => Node[] {
    return nodes(g)->filter<func (n: Node) => bool {
        region_kind(region_of(n)) == RegionKind::Arm
    }>
}

/// The inputs of a node that come from the body (region 0).
func body_inputs(n: Node) => Node[] {
    return inputs(n)->filter<func (m: Node) => bool {
        region_kind(region_of(m)) == RegionKind::Root
    }>
}

/// The nodes of an arm that read exactly one value of the body.
func arm_readers(g: Graph) => Node[] {
    return arm_nodes(g)->filter<func (n: Node) => bool {
        len(body_inputs(n)) >= 1
    }>
}

/// The nodes of an arm other than the one `mine` is in.
func other_arm_nodes(g: Graph, mine: Node) => Node[] {
    return arm_nodes(g)->filter<func (n: Node) => bool {
        !(region_of(n) == region_of(mine))
    }>
}

/// The one graph with two or more arm regions.
func two_arm_graph::<F>(p: F) => Graph? when is_function::<F>() {
    let found = graphs_of(p)->filter<func (g: Graph) => bool {
        len(arm_nodes(g)) >= 2
    }>
    return if len(found) == 1 then found[0] else null
}

func cross_arm_commit::<F>(p: F, g: Graph) => F! sync {
    let reader = arm_readers(g)[0]
    let ins = body_inputs(reader)
    let bodyValue = ins[len(ins) - 1]
    let other = other_arm_nodes(g, reader)[0]
    'cross_arm: the reader {} is in region kind {}; it reads {} (region kind {}); that read becomes {} (region kind {})'->format<
        string(id(reader)),
        string(region_kind(region_of(reader))),
        string(id(bodyValue)),
        string(region_kind(region_of(bodyValue))),
        string(id(other)),
        string(region_kind(region_of(other)))
    >->println
    let t = open(p)
    replace(t, bodyValue, other)
    'cross_arm: the step check accepted the replace; committing'->println
    return commit(t)
}

export func cross_arm::<F>(p: F) => F! sync {
    return match two_arm_graph(p) {
        case null => p
        case g => cross_arm_commit(p, g)
    }
}
