+# The words a failed push ends in. It is a function because the sentence is a reading, not a
+# decoration: "git push failed after 0 attempt(s)" was printed while the network was down, and it
+# sent this seat looking for a broken retry loop. The three numbers are what a reader acts on --
+# attempted, failed, and skipped because nothing could be sent -- and a zero denominator now says
+# "nothing was attempted" in those words.
+function Format-PushFailure {
+    param([hashtable] $Push, [string] $Target)
+    switch ($Push.Kind) {
+        'unreachable' {
+            return @{
+                Why = "could not reach origin, so no push was attempted (attempted 0, failed 0, skipped $(if ($Push.ContainsKey('Skipped')) { $Push.Skipped } else { 3 }))"
+                How = "The shape check reads origin before anything is pushed, and origin did not answer: this is a network or a remote that is down, not a refusal and not a bad shape. Nothing was sent, so there is nothing to retry. The merge is committed locally and not on origin/$Target."
+            }
+        }
+        default {
+            $attempted = [int]$Push.Tries
+            $skipped = if ($attempted -lt 3) { 3 - $attempted } else { 0 }
+            return @{
+                Why = "the push failed (attempted $attempted, failed $attempted, skipped $skipped)"
+                How = "The merge is committed locally and not on origin/$Target. The push output is above."
+            }
+        }
+    }
+}
