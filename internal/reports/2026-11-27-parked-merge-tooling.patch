+# --- 5. a real git, a real unreachable remote --------------------------------
+# Sections above read the sentence this run prints; this one makes git fail for real. `origin` is
+# pointed at a closed port, so the fetch inside the shape check fails the way the network failed on
+# this seat at 00:20 -- and the run has to say "nothing was attempted" rather than "0 attempt(s)".
+$e = New-Scenario -Name 'unreachable'
+& git -C $e.Work remote set-url origin 'ssh://git@127.0.0.1:1/nothing-here.git' 2>&1 | Out-Null
+$pushE = Invoke-PushWithRecovery -Tree $e.Work -Target develop -ReRun { @{ Exit = 0; Targets = @(); Rows = 0; Reds = 0; Text = '' } }
+Check 'an origin that cannot be reached is not a failed push' ($pushE.Kind -eq 'unreachable') "kind=$($pushE.Kind)"
+Check 'and it reports zero attempted, zero failed, three skipped' ([int]$pushE.Tries -eq 0 -and [int]$pushE.Skipped -eq 3) "tries=$($pushE.Tries) skipped=$($pushE.Skipped)"
+$unreachableReal = Format-PushFailure -Push $pushE -Target develop
