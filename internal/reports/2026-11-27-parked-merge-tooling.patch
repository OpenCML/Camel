+            # this seat looking for a bug in the retry loop while the network was down.
+            Kind = $(if ($shape.Kind -eq 'single parent') { 'not a merge' } else { 'unreachable' })
             Recovered = $false; Sha = (& $head)
             Targets = @(); Rows = 0; Reds = 0; Shas = @($shape.FirstParent, $shape.Tip); Tries = 0
+            Skipped = 3
