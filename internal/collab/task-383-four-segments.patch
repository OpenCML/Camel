+/// The element facts a carried sequence needs: the collection's element type, with rank 1 when the
+/// collection holds scalars. `ConcatFromSequence` concatenates whole elements, so an element of rank
+/// 0 (the element of `float[]`) cannot be one; such a collection is carried as
+/// `sequence(tensor(float[1]))` and each element is unsqueezed on the way in.
+TensorFacts sequenceElementFacts(const TensorFacts &elem) {
+    if (elem.shape && !elem.shape->empty()) {
+        return elem;
+    }
+    return {elem.dtype, tensor::StaticShape{int64_t{1}}};
+}
+
+/// `SequenceEmpty` for a collection carried as a sequence: the init of a Loop state. The caller
+/// checks that the element type is known (a model states it).
+Value sequenceEmptyValue(const TensorFacts &elem, Emitter &emitter) {
+    const std::string name = emitter.node(
+        "SequenceEmpty",
+        {},
+        {Attribute::makeInt("dtype", static_cast<int64_t>(*elem.dtype))},
+        "seq_empty");
+    return Value::symbolicSequence(name, *elem.dtype, elem.shape);
+}
+
+/// The value an `append` inserts into a carried sequence: rank 0 is unsqueezed to `[1]` (see
+/// `sequenceElementFacts`), rank 1 or more goes in as it is.
+Value sequenceElementValue(const Value &element, Emitter &emitter) {
+    const TensorFacts facts = factsOf(element);
+    if (facts.shape && !facts.shape->empty()) {
+        return element;
+    }
+    const std::string name = emitter.node(
+        "Unsqueeze",
+        {emitter.operand(element, facts.dtype)},
+        {Attribute::makeInts("axes", std::vector<int64_t>{0})},
+        "seq_element");
+    return Value::symbolic(name, facts.dtype, tensor::StaticShape{int64_t{1}});
+}
+
+/// The array a carried sequence stands for, read out where a tensor is wanted: the round's state is
+/// the *prefix* the array has before that round, and `ConcatFromSequence` is `SequenceInsert`'s
+/// inverse. The first dimension is the run's, so it stays open.
+Value concatFromSequence(const Value &sequence, Emitter &emitter) {
+    const TensorFacts elem = factsOf(sequence);
+    const std::string name = emitter.node(
+        "ConcatFromSequence",
+        {emitter.operand(sequence, elem.dtype)},
+        {Attribute::makeInt("axis", 0)},
+        "seq_concat");
+    tensor::StaticShape shape{std::nullopt};
+    if (elem.shape) {
+        shape.insert(shape.end(), elem.shape->begin(), elem.shape->end());
+    }
+    return Value::symbolic(name, elem.dtype, shape);
+}
