// Temporary instrument of the lane `mmtypeof`: the same generator shape as
// `gen_local_depends_on_local.cml` with the dependency between the two locals removed. It is the
// control for that case's reading: if this one runs, the dependency is what the red belongs to; if
// it does not, a generator with two locals is what is red. Deleted before the commit.
//
// It sits under docs/handover/, which the AST corpus walks past, so it moves no recorded reading.

func gen(): int.. sync {
    let a = 1
    let b = 2
    yield a + b
}

func drain(): int sync {
    loop acc = 0 for v in gen() do sync { acc + v }
}

func main(): int sync {
    println(drain())
    return 0
}