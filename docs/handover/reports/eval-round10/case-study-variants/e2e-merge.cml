// Item A's third rewrite: a copy of `apply` is declared and the copy is called instead, so the
// text has one more declaration and one more call site and no new node. Same five lines.

func apply_copy(f: (x: int) => int, x: int): int sync {
    return f(x)
}

func run(n: int, base: int): int sync {
    let label = 'step'
    let twice = base * 2
    let thrice = base * 3
    let f = (x: int): int => sync {
        let weight = base + 1
        let value = weight + x
        '{} {} -> {}'->format<label, x, weight + x>->println
        return value
    }
    let (_, total) = loop i = 0, total = twice + thrice while i < n do sync {
        (i + 1, total + apply_copy(f, i))
    }
    let tail = apply_copy(f, n)
    'total {} tail {}'->format<total, tail>->println
    return total
}

func main(): int sync {
    let _ = run(3, 10)
    return 0
}