// Item A's second rewrite: the call through a known function value made a direct call (let ap = apply\n// then p(f, i)). It must print the same five lines as e2e/program.cml.

func apply(f: (x: int) => int, x: int): int sync {
    return f(x)
}

func run(n: int, base: int): int sync {
    let label = 'step'
    let twice = base * 2
    let thrice = base * 3
    let f = (x: int): int => sync {
        let weight = base + 1
        let value = weight + x
        '{} {} -> {}'->format<label, x, weight + x>->println
        return value
    }
    let ap = apply
    let (_, total) = loop i = 0, total = twice + thrice while i < n do sync {
        (i + 1, total + ap(f, i))
    }
    let tail = ap(f, n)
    'total {} tail {}'->format<total, tail>->println
    return total
}

func main(): int sync {
    let _ = run(3, 10)
    return 0
}