// Item A's fifth rewrite: a function nobody calls. The text produces no node in any graph the
// program runs; the question this row asks is whether the canonical document gains a graph
// for it. Same five lines as e2e/program.cml.

func unused(x: int): int {
    return x + 1
}

func apply(f: (x: int) => int, x: int): int sync {
    return f(x)
}

func run(n: int, base: int): int sync {
    let label = 'step'
    let twice = base * 2
    let thrice = base * 3
    let f = (x: int): int => sync {
        let weight = base + 1
        let value = weight + x
        '{} {} -> {}'->format<label, x, weight + x>->println
        return value
    }
    let (_, total) = loop i = 0, total = twice + thrice while i < n do sync {
        (i + 1, total + apply(f, i))
    }
    let tail = apply(f, n)
    'total {} tail {}'->format<total, tail>->println
    return total
}

func main(): int sync {
    let _ = run(3, 10)
    return 0
}