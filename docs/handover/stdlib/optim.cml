/**
 * The optimizers, as pure state transitions. An optimizer is the function
 *
 *     (params, grads, state) => (params, state)
 *
 * with its hyperparameters fixed beforehand: `sgd<schedule: constant<rate: 0.1>>` is the SGD that
 * takes steps of 0.1, `adam<schedule: cosine_decay<peak: 0.001, total: 1000>>` is Adam on a cosine
 * schedule, and either is an ordinary function value that a training loop calls once a step.
 * Nothing is an object: a state is a plain value (`sgd_state`, `adam_state` make the first one) that
 * the loop carries.
 *
 *     let opt = adam<schedule: cosine_decay<peak: 0.001, total: steps>>
 *     let (loss, grads) = with_grad(loss_of)<model>(x, y)
 *     let (model, state) = opt(model, grads, state)
 *
 * `params` is a tree of nested structs and tuples whose leaves are floating numbers and arrays of
 * them, and `grads` is the gradient of that tree, which `with_grad` or `grad` gives. A leaf that is an
 * integer or a bool is not trained: its gradient is a zero of its own type, and the update leaves it
 * as it is. The walk over the tree is expanded where the
 * call is compiled (`static for`), and the type of every leaf is settled by then, so a leaf is
 * updated by the one definition written for its element type and nothing asks a value what it is.
 *
 * A schedule is a function `(step: int) => float` and the rate of the update of step `n` is
 * `schedule(n)`, with `n` numbered from one. The three below are configured functions of the step:
 * `constant<rate: r>`, `linear_decay<peak: p, total: t>` and `cosine_decay<peak: p, total: t>`.
 *
 * Every number is computed in double and rounded once, when it is stored in the element type of its
 * leaf; the rate of `sgd` on an array leaf is first rounded to the element type, as its kernel does
 * (modules/tensor/kernels/update.h).
 */

import math
import { sqrt, zeros_like } from tensor
import { is_bool, is_float, is_integer } from types
import { tree_unzip } from tree

// ---- schedules ----

/// The same rate at every step.
/// @example 3->constant<rate: 0.1>    // 0.1
with <rate: float>
export func constant(step: int): float {
    return rate
}

/// A rate that falls from `peak` to `floor` in a straight line: `peak * (1 - step / total)` below
/// step `total`, and exactly `floor` from there on. `total` is at least one.
/// @example 2->linear_decay<peak: 0.1, total: 4>    // 0.05
with <peak: float, total: int, floor: float = 0.0>
export func linear_decay(step: int): float {
    return if step >= total then floor else peak * (1.0 - float(step) / float(total))
}

/// A rate that falls from `peak` to `floor` along a cosine: `floor + (peak - floor) *
/// (1 + cos(pi * step / total)) / 2` below step `total`, and exactly `floor` from there on.
/// @example 1->cosine_decay<peak: 0.1, total: 4>    // 0.08535533905932738
with <peak: float, total: int, floor: float = 0.0>
export func cosine_decay(step: int): float {
    return if step >= total then floor
        else floor + (peak - floor) * (1.0 + math::cos(math::pi * float(step) / float(total))) * 0.5
}

// ---- states ----

/// The state of `sgd`: the number of updates made, which is the step its schedule reads.
export type SgdState = { step: int }

/// The state of `adam` and `adamw`: a tree of the first moments and a tree of the second moments,
/// both shaped like the parameters, and the number of updates made, which is the step the
/// schedule reads.
export type AdamState<P> = { m: P, v: P, step: int }

/// The state `sgd` starts from: no moments to carry, only the step count.
/// @example sgd_state({ w: 1.0 })    // { step: 0 }
export func sgd_state::<P>(params: P): SgdState {
    return { step: 0 }
}

/// The state `adam` and `adamw` start from: both moment trees at zero, shaped like the
/// parameters and with the same leaf types, and the step count.
/// @example adam_state({ w: 1.0 })    // { m: { w: 0.0 }, v: { w: 0.0 }, step: 0 }
export func adam_state::<P>(params: P): AdamState<P> {
    return { m: zeros_tree(params), v: zeros_tree(params), step: 0 }
}

// ---- the optimizers ----

/// Plain stochastic gradient descent: `p - rate * g` at every leaf, with the rate of the step
/// taken. The step count of the state advances by one.
/// @example sgd<schedule: constant<rate: 0.1>>({ w: 1.0 }, { w: 0.5 }, sgd_state({ w: 1.0 }))    // ({ w: 0.95 }, { step: 1 })
with <schedule: (step: int) => float>
export func sgd::<P, G>(params: P, grads: G, state: SgdState): (P, SgdState) {
    let step = state.step + 1
    return (sgd_tree(params, grads, schedule(step)), { step: step })
}

/// Adam. `beta1` and `beta2` are the decay rates of the two moments and `eps` keeps the division
/// away from zero. A `decay` other than zero is the decoupled weight decay of `adamw`: the
/// parameter first moves by `rate * decay` of itself, and the adaptive update then works on the
/// moved parameter, while the moments see the gradient alone.
/// @example adam<schedule: constant<rate: 0.1>>({ w: 1.0 }, { w: 0.5 }, adam_state({ w: 1.0 }))    // ({ w: 0.9 }, ...), w to within eps
with <schedule: (step: int) => float, beta1: float = 0.9, beta2: float = 0.999, eps: float = 1e-8, decay: float = 0.0>
export func adam::<P, G>(params: P, grads: G, state: AdamState<P>): (P, AdamState<P>) {
    let step = state.step + 1
    let rate = schedule(step)
    let c: Rates = {
        rate: rate,
        beta1: beta1,
        beta2: beta2,
        eps: eps,
        correct1: 1.0 - math::pow(beta1, float(step)),
        correct2: 1.0 - math::pow(beta2, float(step)),
        keep: 1.0 - rate * decay
    }
    let parts = tree_unzip(adam_tree(params, grads, state.m, state.v, c), params)
    return (parts.0, { m: parts.1, v: parts.2, step: step })
}

/// `adam` with a decoupled weight decay, 0.01 unless given.
/// @example adamw<schedule: constant<rate: 0.1>, decay: 0.1>({ w: 1.0 }, { w: 0.5 }, adam_state({ w: 1.0 }))    // ({ w: 0.89 }, ...), w to within eps
with <schedule: (step: int) => float, beta1: float = 0.9, beta2: float = 0.999, eps: float = 1e-8, decay: float = 0.01>
export func adamw::<P, G>(params: P, grads: G, state: AdamState<P>): (P, AdamState<P>) {
    return adam<schedule, beta1, beta2, eps, decay>(params, grads, state)
}

// ---- the walks over a tree ----

// The numbers of one Adam step: the rate, the decay rates, `eps`, the bias corrections
// `1 - beta^step`, and the factor `1 - rate * decay` the parameter keeps before the update.
type Rates = {
    rate: float,
    beta1: float,
    beta2: float,
    eps: float,
    correct1: float,
    correct2: float,
    keep: float
}

// A tree of zeros shaped like `t`, with the same leaf types.
func zeros_tree::<P>(t: P): P {
    return match type P {
        case struct | tuple => P { static for n, _ in fields P => zeros_tree(t.[n]) }
        case _ => zero_leaf(t)
    }
}

func sgd_tree::<P, G>(p: P, g: G, rate: float): P {
    return match type P {
        case struct | tuple => P { static for n, _ in fields P => sgd_tree(p.[n], g.[n], rate) }
        case _ => sgd_leaf(p, g, rate)
    }
}

// A tree of leaf triples (the new parameter and the two new moments), shaped like the parameters.
func adam_tree::<P, G>(p: P, g: G, m: P, v: P, c: Rates) {
    return match type P {
        case struct | tuple =>
            P { static for n, _ in fields P => adam_tree(p.[n], g.[n], m.[n], v.[n], c) }
        case _ => adam_leaf(p, g, m, v, c)
    }
}

// ---- the leaves ----

// A leaf that is an integer or a bool is not trained: its gradient is a zero of its own type, and
// the update leaves it as it is. The moments such a leaf carries are never read.
func untrained::<T>(): bool {
    return is_integer::<T>() || is_bool::<T>()
}

// A zero of the leaf's own type: the moments of a leaf have the element type of the leaf, so a
// state that went through an update has the type it started with and can be a loop state.
func zero_leaf::<T>(x: T): T when is_float::<T>() {
    return T(0.0)
}

func zero_leaf::<T>(x: T[..]): T[..] when is_float::<T>() {
    return zeros_like(x)
}

func zero_leaf::<T>(x: T): T when untrained::<T>() {
    return x
}

func zero_leaf::<T>(x: T[..]): T[..] when untrained::<T>() {
    return x
}

func sgd_leaf::<T>(p: T, g: T, rate: float): T when is_float::<T>() {
    return T(float(p) - rate * float(g))
}

func sgd_leaf::<T>(p: T[..], g: T[..], rate: float): T[..] when is_float::<T>() {
    return p - T(rate) * g
}

func sgd_leaf::<T>(p: T, g: T, rate: float): T when untrained::<T>() {
    return p
}

func sgd_leaf::<T>(p: T[..], g: T[..], rate: float): T[..] when untrained::<T>() {
    return p
}

// The Adam formula of one number, in double, in the order the reference kernel writes it
// (modules/tensor/kernels/update.h, `adaptiveUpdateOne`).
func adam_leaf::<T>(p: T, g: T, m: T, v: T, c: Rates): (T, T, T) when is_float::<T>() {
    let moved = float(T(float(p) * c.keep))
    let nm = c.beta1 * float(m) + (1.0 - c.beta1) * float(g)
    let nv = c.beta2 * float(v) + (1.0 - c.beta2) * float(g) * float(g)
    let np = moved - c.rate * (nm / c.correct1) / (math::sqrt(nv / c.correct2) + c.eps)
    return (T(np), T(nm), T(nv))
}

// The same formula on whole arrays: the conversions apply to every element, so the arithmetic is
// in double, one pass per operator, and the three results are stored once into T.
func adam_leaf::<T>(p: T[..], g: T[..], m: T[..], v: T[..], c: Rates): (T[..], T[..], T[..]) when is_float::<T>() {
    let moved = float(p * T(c.keep))
    let g64 = float(g)
    let nm = c.beta1 * float(m) + (1.0 - c.beta1) * g64
    let nv = c.beta2 * float(v) + (1.0 - c.beta2) * g64 * g64
    let np = moved - c.rate * (nm / c.correct1) / (sqrt(nv / c.correct2) + c.eps)
    return (T(np), T(nm), T(nv))
}

func adam_leaf::<T>(p: T, g: T, m: T, v: T, c: Rates): (T, T, T) when untrained::<T>() {
    return (p, m, v)
}

func adam_leaf::<T>(p: T[..], g: T[..], m: T[..], v: T[..], c: Rates): (T[..], T[..], T[..]) when untrained::<T>() {
    return (p, m, v)
}
