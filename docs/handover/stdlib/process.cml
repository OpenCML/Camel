/**
 * The process and the machine it runs on: waiting, ending, who runs it and how many threads it can have. Durations are seconds as a `float`, like `time::now` and the timeouts of the
 * network functions. The terminal is `io`'s, the environment `env`'s.
 */

/// Suspends the program for the given number of seconds. The wait is on the clock, so a call is
/// never folded away and the work of other ready nodes goes on meanwhile.
/// @fails fault `InvalidArgument` when seconds is negative or not a number
/// @example sleep(0.1)
export func sleep(seconds: float): void uses clock

/// Ends the program with the given exit code, after the buffered output is written and the
/// external resources are released. Nothing that is written after the call runs.
/// @example exit(2)
export func exit(code: int): never uses process

/// The name of the user the process runs as.
/// @fails error value `NotFound` when the system has no name for the user
/// @example user_name() !! 'unknown'    // 'alice'
export func user_name(): string! uses env

/// The number of hardware threads, at least 1.
/// @example cpu_count()    // 8
export func cpu_count(): int uses env
