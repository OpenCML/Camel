/**
 * A loop written only for its effect, as a tail recursion. `quiet` has an ordinary body: the
 * println is not used by anything and does not run. `loud` has a sync body: it prints 0 1 2.
 */
module effect_loop

func quiet(i: int, n: int): int {
    println(i)
    return if i + 1 >= n then 0 else quiet(i + 1, n)
}

func loud(i: int, n: int): int sync {
    println(i)
    return if i + 1 >= n then 0 else loud(i + 1, n)
}

func main(): int sync {
    let a = quiet(0, 3)
    let b = loud(0, 3)
    return a + b
}
