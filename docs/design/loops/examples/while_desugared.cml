/**
 * Option (a) for the statement form
 *
 *     var i = 1
 *     var acc = 0
 *     while i <= n sync { acc = acc + i; i = i + 1 }
 *
 * written by hand as the self-recursive subgraph it would desugar to: the state stays in the
 * variables (shared cells), the recursion has no parameters and captures the cells and `n`.
 *   camel while_desugared.cml std::rgir
 */
module while_desugared

func sum_to(n: int): int sync {
    var i = 1
    var acc = 0
    sync func step(): int sync {
        return if i <= n then sync {
            acc = acc + i
            i = i + 1
            return step()
        } else 0
    }
    step()
    return acc
}

func main(): int sync {
    println(sum_to(100000))
    return 0
}
