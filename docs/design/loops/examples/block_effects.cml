/**
 * How assignments in an ordinary block and in a sync block behave today. This decides what a
 * loop body that only assigns to variables would do.
 */
module block_effects

func plain(c: bool): int sync {
    var a = 0
    var b = 0
    if c then {
        a = 1
        b = 2
    } else {
        b = 3
    }
    return a * 10 + b
}

func synced(c: bool): int sync {
    var a = 0
    var b = 0
    if c then sync {
        a = 1
        b = 2
    } else sync {
        b = 3
    }
    return a * 10 + b
}

func main(): int sync {
    println(plain(true))
    println(synced(true))
    return 0
}
