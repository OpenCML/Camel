/**
 * `return` inside a block ends that block and gives its value; it does not leave the function.
 */
module block_return

func f(c: bool): int sync {
    let a = if c then sync {
        return 1
    } else 2
    println(a)
    return 10 + a
}

func main(): int sync {
    println(f(true))
    return 0
}
