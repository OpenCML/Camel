/**
 * A pure program whose `main` is a loop of data-dependent length, written as a tail recursion.
 *   camel export_tail.cml std::macro std::opt 'onnx::export(out="/tmp/loop.onnx")'
 * exports it as one ONNX Loop; with `grad`, as paired Loops (docs/technical/26, section 7).
 */
module export_tail
import { Tensor, sum, tanh } from tensor

func iterate(i: int, n: int, v: Tensor): Tensor {
    return if i >= n then v else iterate(i + 1, n, tanh(v) + v * 0.5)
}

func main(x: Tensor<f32, const [2, 2]>): Tensor {
    return iterate(0, int(sum(x * x) * 0.5), x)
}
