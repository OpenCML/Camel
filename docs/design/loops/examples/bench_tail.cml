// The tail recursion bench_loop.cml means: the state as parameters.
import { get_env } from sys

func spin(i: int, n: int, s: int): int {
    return if i >= n then s else spin(i + 1, n, s + i % 7)
}

func main(): int sync {
    let text = get_env('N')
    let n    = if text == '' then 10000000 else int(text)
    println(spin(0, n, 0))
    return 0
}
