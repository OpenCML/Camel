/**
 * The same sum with the state in a `var` written by the recursion instead of in parameters.
 */
module var_tail

func main(): int sync {
    var acc = 0
    sync func step(i: int, n: int): int sync {
        acc = acc + i
        return if i >= n then 0 else step(i + 1, n)
    }
    step(1, 1000)
    println(acc)
    return 0
}
