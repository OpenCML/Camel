/// Ten million loop steps written as tail recursion, in chunks of a thousand so that the
/// emitted program, which turns every Camel call into a C++ call, stays within the native
/// stack (one loop of ten million overflows it: defects/d10).
module a03_tail_loop

func chunk(i: int, acc: int): int {
    return if i == 0 then acc else chunk(i - 1, acc + i % 7)
}

func rounds(k: int, acc: int): int {
    return if k == 0 then acc else rounds(k - 1, chunk(1000, acc))
}

func main(): int sync {
    println(rounds(10000, 0))
    return 0
}
