/// A string held in a local, then passed to a function and returned.
/// std::cpp accepts it; the C++ it writes does not compile (const String * to String *).
module d08_string_local

func greet(name: string, n: int): string {
    return 'hello, ' + name + ' #' + string(n)
}

func main(): int sync {
    let a = greet('camel', 1)
    let b = greet(a, 2)
    println(b)
    return 0
}
