/// Not a defect of std::cpp: an observation for section 3. `append` used to take its array as
/// a `var` parameter and change it in place (`:struct/append_arr`), so this program was refused
/// with ImmutablePassedToVarParam, while design principles 2.9 describe `append` as returning
/// a new value. Settled by design principles 2.12: `append` returns a new array, and the
/// program prints 10.
module o01_append_needs_var

func build(i: int, n: int, acc: int[]): int[] {
    return if i == n then acc else build(i + 1, n, acc->append<i>)
}

func main(): int sync {
    let empty: int[] = []
    println(len(build(0, 10, empty)))
    return 0
}
