// What `a && b` and `a || b` become: `if a then b else false`, `if a then true else b`.
func noisy(tag: string, v: bool): bool sync {
    println(tag)
    return v
}

func main(): int sync {
    let a = if noisy('l1', false) then noisy('r1', true) else false
    let b = if noisy('l2', true) then true else noisy('r2', false)
    println(a, b)
    return 0
}
