import { Tensor, reshape, sum, tanh } from tensor
import { grad } from autodiff

let w = reshape([0.5, -0.25, 0.1, 0.3], [2, 2])

func loss(x: Tensor): float {
    return sum(tanh(x @ w))
}

func main(): int sync {
    let x = reshape([1.0, 2.0, 0.5, -1.0], [2, 2])
    println(loss(x))
    println(grad(loss)(x))
    return 0
}
