func noisy(tag: string): int sync {
    println(tag)
    return 7
}

let common = noisy('evaluating common')

func left(x: int): int {
    return x + common
}

func right(x: int): int {
    return x * common
}

func main(): int sync {
    let rs = [1, 2, 3, 4, 5, 6, 7, 8]->map<(x: int) => left(x) + right(x)>
    println(rs)
    return 0
}
