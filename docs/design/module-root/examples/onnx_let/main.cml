import { Tensor, tanh, reshape } from tensor

// Weights written where they are natural to write: at the top of the module.
let w = reshape([0.5, -0.25, 0.1, 0.3], [2, 2])

func forward(x: Tensor): Tensor {
    return tanh(x @ w)
}

func main(x: Tensor<f32, const [2, 2]>): Tensor {
    return forward(x)
}
