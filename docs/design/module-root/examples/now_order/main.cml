func noisy(tag: string): int sync {
    println(tag)
    return 7
}

let cfg = noisy('evaluating cfg')
let other = noisy('evaluating other')

func pick(flag: bool): int {
    return if flag then other else 0
}

func main(): int sync {
    println('main starts')
    println(cfg)
    println(pick(false))
    println(cfg)
    return 0
}
