var cnt = 0
var log = ''

sync func bump(): int sync {
    cnt += 1
    log += 'b'
    return cnt
}

func read(): int {
    return cnt
}

func twice_read(): int {
    return read() + read()
}

sync func main(): int sync {
    let a = read()
    bump()
    let b = read()
    [1, 2, 3]->foreach<sync (x: int) => sync { bump() }>
    let c = twice_read()
    println(a, b, c, cnt, log)
    return 0
}
