// @refused-example top-level statements are a syntax error (module-root README section 1.2 names examples/misc/top_stmt.cml)
func noisy(tag: string): int sync {
    println(tag)
    return 7
}

println('top-level println')
let unused = noisy('unused let')
let used = noisy('used let')

func main(): int sync {
    println('main', used)
    return 0
}
