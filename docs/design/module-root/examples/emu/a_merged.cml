// What option (a) yields for
//     config.cml:  export let cfg = read_config();  export let table = build_table()
//     main.cml:    import { cfg } from config; func port_of() ...; func host_len() ...
// written as ONE file: under (a) both modules' top-level nodes are in one __root__.
func read_config(): (string, int) sync {
    println('read_config runs')
    return ('localhost', 8080)
}

func build_table(): int sync {
    println('build_table runs')
    return 3
}

let cfg = read_config()
let table = build_table()        // exported by config, not used by this program

func port_of(): int {
    return cfg.1
}

func host_len(): int {
    return len(cfg.0)
}

func main(): int sync {
    println(port_of())
    println(host_len())
    return 0
}
