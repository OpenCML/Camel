// Option (c) taken literally: an importing module's root calls the root of the module it
// imports. With a diamond (b and c both import d) the root of d is called twice.
func d_root(): int sync {
    println('d.__root__ runs')
    return 1
}

func b_root(): int {
    return d_root() + 10
}

func c_root(): int {
    return d_root() + 100
}

let b_value = b_root()
let c_value = c_root()

func main(): int sync {
    println(b_value + c_value)
    return 0
}
