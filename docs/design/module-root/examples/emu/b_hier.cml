// Option (b)/(c): every module's root is a subgraph of its own. The module root returns its
// exported values; the common root calls it once and hands the values on.
func read_config(): (string, int) sync {
    println('read_config runs')
    return ('localhost', 8080)
}

func build_table(): int sync {
    println('build_table runs')
    return 3
}

// stands for config.__root__ : its exports (cfg, table) are its result
func config_root(): ((string, int), int) {
    let cfg = read_config()
    let table = build_table()
    return (cfg, table)
}

// stands for the common root: one call per imported module, then the selections.
// Only cfg is used by this program.
let config_exports = config_root()
let cfg = config_exports.0

func port_of(): int {
    return cfg.1
}

func host_len(): int {
    return len(cfg.0)
}

func main(): int sync {
    println(port_of())
    println(host_len())
    return 0
}
