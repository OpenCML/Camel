// Option (c) without sharing: the exported value is a function of no arguments and every
// user calls it (what `math::pi()` is today).
func read_config(): (string, int) sync {
    println('read_config runs')
    return ('localhost', 8080)
}

func cfg(): (string, int) {
    return read_config()
}

func port_of(): int {
    return cfg().1
}

func host_len(): int {
    return len(cfg().0)
}

func main(): int sync {
    println(port_of())
    println(host_len())
    return 0
}
