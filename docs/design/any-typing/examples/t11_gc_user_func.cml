module t11_gc_user_func

// `any` as a parameter and a result of a user function, and captured by a closure.
func churn(n: int): int { return len(range(0, n)->map<(i: int): string => 'item-' + string(i)>) }
func keep(x: any, n: int): any {
    let c = churn(n)
    return if c > 0 then x else x
}
func main(n: int): int sync {
    let v = keep(('abc' + string(1)) as any, n)
    let get = (): any => v
    let c = churn(n)
    println(c, v as string, get() as string)
    return 0
}
