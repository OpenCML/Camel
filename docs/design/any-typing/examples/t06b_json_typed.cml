module t06b_json_typed
import { decode_as } from json

// The typed alternative that exists today: the result is `T!`, checked while decoding.
func main(): int sync {
    let xs = decode_as('[1, 2, 3]', [0]) !! [0]
    println(xs)
    let bad = decode_as('["a"]', [0]) !! [-1]
    println(bad)
    return 0
}
