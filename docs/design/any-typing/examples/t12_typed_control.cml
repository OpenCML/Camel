module t12_typed_control

// Control: t08 with the variable typed. Must print the same with every collector setting.
func churn(n: int): int { return len(range(0, n)->map<(i: int): string => 'item-' + string(i)>) }
func make(n: int): string[] { return range(0, n)->map<(i: int): string => 'v' + string(i)> }
func main(n: int): int sync {
    let d = make(3)
    let c = churn(n)
    println(c, d)
    return 0
}
