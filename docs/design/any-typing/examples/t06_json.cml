module t06_json
import { decode, encode } from json

// json.decode is the one operator that returns `any`.
func main(): int sync {
    let d = decode('[1, 2, 3]')
    println(d)
    println(d as int[])
    println(d as float[])
    let o = decode('{"b": 1, "a": "x"}')
    let s = o as { b: int, a: string }
    println(s.b)
    let n = decode('[[1, 2], [3]]') as int[][]
    println(n)
    println(encode(d as int[]))
    return 0
}
