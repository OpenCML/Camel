module t06d_json_shapes
import { decode } from json

// What the unchecked `as` after decode does when the JSON text and the type disagree.
func main(): int sync {
    // The object is built with its keys in sorted order (a, b); the type names b first.
    let o = decode('{"b": 1, "a": 7}') as { b: int, a: int }
    println(o.b, o.a)
    // An integer and a fraction in one array: each element keeps the representation of its
    // own JSON token, the type says they are all float.
    let xs = decode('[1, 2.5]') as float[]
    println(xs)
    // An array of arrays read as an array of ints: the elements are addresses.
    let ys = decode('[[1], [2]]') as int[]
    println(len(ys), ys[0] > 1000)
    return 0
}
