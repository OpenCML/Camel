module t05j_match
// `match` on an `any` value against literals of two types.
func wrap_s(x: string): any { return x }
func main(): int sync {
    let v = wrap_s('a' + 'b')
    let r = match v {
        case 1 => 'one'
        case 'ab' => 'ab'
        case _ => 'other'
    }
    println(r)
    return 0
}
