module d2_array_literal

// Defect D2: in an array literal an `any` element followed by a typed one takes the type of
// the typed one, without `as` and without a check.
func wrap_s(x: string): any { return x }
func main(): int sync {
    let xs = [wrap_s('a' + 'b'), 5]
    println(xs[1], xs[0] > 1000)
    println(xs[0] + xs[1] > 1000)
    return 0
}
