module t04_print

// What printing and conversion to text do with a value whose static type is `any`.
func boxed(i: int): any { return 't' + string(i) }
func main(): int sync {
    let ys = [1, 2, 3]
    let a = ys as any
    println(a)
    println(string(a))
    println('{}'->format<a>)
    let xs = range(0, 2)->map<boxed>
    println(xs)
    println(('k', a))
    return 0
}
