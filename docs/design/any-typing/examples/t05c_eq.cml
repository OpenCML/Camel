module t05c_eq
// `==` on two `any` values: what is compared?
func main(): int sync {
    let a = ('ab' + 'c') as any
    let b = ('a' + 'bc') as any
    println(a == b)
    println((a as string) == (b as string))
    let n = 7
    let i = n as any
    let j = n as any
    println(i == j)
    return 0
}
