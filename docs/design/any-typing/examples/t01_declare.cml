module t01_declare

// Where a program can write `any` today: a parameter, a return type, `as any` on a computed
// value, an element type reached through a function. (Not: an annotated `let`, see
// t01b_literal.cml and t01c_let.cml.)
func id(x: any): any { return x }
func wrap(x: int): any { return x }

func main(): int sync {
    let n = 40 + 2
    let t = 'te' + 'xt'
    let b = t as any
    let c = id(3.5)
    let d = wrap(n)
    println(b)
    println(c)
    println(d)
    println(b as string, c as float, d as int)
    return 0
}
