module t18_inline_changes_print

// The static type `any` is erased by inlining: the same program prints `<any>` without passes
// and the value after std::opt::inline, except where `as any` was written.
func wrap(x: int): any { return x }
func main(): int sync {
    let n = 40 + 2
    println(wrap(n))
    println(n as any)
    return 0
}
