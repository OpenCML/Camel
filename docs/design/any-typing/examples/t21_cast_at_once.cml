module t21_cast_at_once
import { decode } from json

// The pattern docs/technical/36 section 9 calls safe: the result of decode converted at once.
// The conversion is a pure node; where it runs is up to the back end.
func churn(n: int): int { return len(range(0, n)->map<(i: int): string => 'item-' + string(i)>) }
func main(n: int): int sync {
    let xs = decode('["alpha", "beta", "gamma"]') as string[]
    let c = churn(n)
    println(c, xs)
    return 0
}
