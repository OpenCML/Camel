-            .dataIndex    = header->dataIndex,
-            .dataType     = header->dataType,
-            .kind         = GCNodeKind::Func,
-            .runtimeFlags = header->runtimeFlags,
-            .payload      = payload,
-            .normInputs   = recNorm,
