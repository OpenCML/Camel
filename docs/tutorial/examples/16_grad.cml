// Gradients: `grad` turns the graph of a function into the graph of its derivative with respect
// to the function's first normal parameter; the others are data.
// Run: camel docs/tutorial/examples/16_grad.cml std::macro
module grad_demo

import { grad, value_and_grad } from autodiff

// The first normal parameter is x: grad(f) differentiates with respect to x, and y is data.
// d/dx (x*x*y + y) = 2*x*y, so at (3, 2) it is 12.
func f(x: float, y: float): float {
    return x * x * y + y
}

func main(): int sync {
    println(f(3.0, 2.0))
    println(grad(f)(3.0, 2.0))                 // df/dx = 2xy = 12
    println(value_and_grad(f)(3.0, 2.0))       // (value, gradient) = (20, 12)
    // Another parameter is differentiated by moving it to the front with a lambda:
    // d/dy = x*x + 1 = 10.
    println(grad((y: float): float => f(3.0, y))(2.0))
    return 0
}