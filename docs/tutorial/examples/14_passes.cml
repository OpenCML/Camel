// One source, several pipelines.
// Run: camel docs/tutorial/examples/14_passes.cml
//      camel docs/tutorial/examples/14_passes.cml std::opt std::fvm
module passes_demo

func square(x: int): int {
    return x * x
}

func sum_squares(n: int, acc: int): int {
    return if n == 0 then acc else sum_squares(n - 1, acc + square(n))
}

func main(): int sync {
    println(sum_squares(1000, 0))
    return 0
}
