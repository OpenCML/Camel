// Generic functions bind a type variable in place with `typeas`; type declarations may take parameters.
// Run: camel docs/tutorial/examples/08_generics.cml
module generics

type Pair<T> = (T, T)

func first(xs: (typeas T)[]): T {
    return xs[0]
}

func swap(p: Pair<typeas T>): Pair<T> {
    return (p.1, p.0)
}

func my_map(xs: (typeas T)[], f: (x: T) => typeas U): U[] {
    return xs->map<f>
}

func main(): int sync {
    println(first([1, 2, 3]))
    println(first(['a', 'b']))
    println(swap((1, 2)), swap(('x', 'y')))
    println(my_map([1, 2, 3], (x: int): string => string(x) + '!'))
    return 0
}
