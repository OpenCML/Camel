// A function's behaviour is decided by its own body, not by its caller.
// Run: camel docs/tutorial/examples/06_callee_decides.cml

func log(x: int): int {
    println(x)          // result unused, body is not a sync block: not executed
    return x + 1
}

func main(): int sync {
    let a = log(1)
    let b = log(a)
    println(b)          // prints 3, and nothing else
    return 0
}
