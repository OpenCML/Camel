// Arrays and the higher-order operators map, filter, reduce and foreach.
// Run: camel docs/tutorial/examples/05_arrays.cml

func main() => int sync {
    let xs = (1 .. 11)->to_array() // [1, ..., 10]
    let squares = xs->map<func (x: int) => int {
        x * x
    }>
    let evens = squares->filter<func (x: int) => bool {
        x % 2 == 0
    }>
    let total = evens->reduce<func (acc: int, x: int) => int {
        acc + x
    }, 0>
    
    println(xs)
    println(squares)
    println(evens)
    println(total)
    
    // Arrays are values: slice and concat return new arrays.
    let ys = concat(xs[0..3], [99])
    println(ys, len(ys), ys[0])
    
    // foreach runs its function for each element, in order.
    ['a', 'b', 'c']->foreach<func (s: string) sync {
        println('item', s)
    }>
    return 0
}
