digraph GraphIR {
    graph [rankdir=LR, fontsize=18];
    node [fixedsize=true, width=1, height=1, fontsize=18];
    edge [minlen=2];
    subgraph cluster_F01 {
        label="main";
        tooltip="() => int uses stdout";
        O01 [label="EXIT", type="EXIT", style=dashed, shape=circle];
        N00 [label="Hello,\nCamel!", type="DATA", shape=circle, style=solid, value_type="string", tooltip="Hello, Camel!"];
        N01 [label=":io/p\nrintln", type="OPER", shape=diamond, style=solid, value_type="string", tooltip=":io/println"];
        N02 [label="0", type="DATA", shape=circle, style=solid, value_type="int", tooltip="0"];
        N03 [label="GATE", type="GATE", shape=diamond, style=dashed, value_type="int", tooltip="GATE"];
        N03 -> O01 [label="0", type="EXIT", style=solid];
        N00 -> N01 [label="0|0", type="NORM"];
        N02 -> N03 [label="0|0", type="NORM"];
        N01 -> N03 [label="0|0", type="CTRL", style=dashed, arrowhead=empty];
    }
    O00 [label="EXIT", type="EXIT", style=dashed, shape=circle];
    N04 [label="Functio\nn(gr...", type="DATA", shape=circle, style=solid, value_type="() => int uses stdout", tooltip="Function(graph=main, tupleSlots=0)"];
    N05 [label="CALL", type="CALL", shape=diamond, style=solid, value_type="int", tooltip="CALL"];
    N05 -> O00 [label="0", type="EXIT", style=solid];
    N04 -> N05 [label="0|0", type="WITH", style=dashed];
}
