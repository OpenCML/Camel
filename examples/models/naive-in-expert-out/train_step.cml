// A Transformer training step written the way the textbook writes it, with no numerical care:
// a plain softmax (exp / sum), a plain log of that softmax for the cross-entropy, separate Q, K
// and V projections, and an RMSNorm, a two-layer MLP and Adam.
//
// It is deliberately naive.  Large logits overflow `exp`; very negative logits underflow it and
// `log(0)` gives -inf.  The program only needs the ordinary range of its own fixed seed, so it
// trains and the loss falls.  The PyTorch expert counterpart (stable softmax, log_softmax, a
// fused QKV projection) and the measurement of where the naive forms break are in the same
// directory.
//
// Run (b=8, t=16, d=64, heads=4 of width 16, FFN=128, vocabulary=32, two blocks):
//   camel -t 1 examples/models/naive-in-expert-out/train_step.cml \
//       --arg bench=false --arg init_dir= --arg final_dir=
//   camel -t 1 .../train_step.cml std::fvm --arg bench=false --arg init_dir= --arg final_dir=
//   camel -t 1 .../train_step.cml std::jit --arg bench=false --arg init_dir= --arg final_dir=
//
// The three values are the program's inputs: `bench` prints one timing line per step,
// `init_dir` writes the initial model and the data there, and `final_dir` writes the trained
// model there (an empty string writes nothing).  The thread count is the command line's `-t 1`;
// the program itself reads no environment variable.
module naive_in_expert_out

import {
    Tensor, argmax, exp, gelu, log, mean, one_hot, permute, randn, reshape, seed, shape, slice,
    sqrt as tensor_sqrt, sum, transpose
} from tensor
import { sqrt as scalar_sqrt } from math
import { with_grad } from autodiff
import { adam, adam_state, save_params } from nn
import { now } from time

let batch = 8
let sequence = 16
let d_model = 64
let n_heads = 4
let d_head = 16
let d_ff = 128
let vocab = 32
let steps = 16
let warmup = 3
let lr = 0.003

// 1 / sqrt(d_head), computed once from the width the model actually uses.
let attention_scale = f32(scalar_sqrt(d_head))

// The shapes the program works in.  A named alias keeps a signature short; the alias itself
// shows every extent, so a reader never has to guess what `Tensor` means here.
type TokenStates = Tensor<f32, [8, 16, 64]>
type HeadStates = Tensor<f32, [8, 4, 16, 16]>
type Scores = Tensor<f32, [8, 4, 16, 16]>
type FeedForward = Tensor<f32, [8, 16, 128]>
type Logits = Tensor<f32, [8, 16, 32]>

type Block = {
    norm1: Tensor<f32, [64]>,
    wq: Tensor<f32, [64, 64]>,
    wk: Tensor<f32, [64, 64]>,
    wv: Tensor<f32, [64, 64]>,
    wo: Tensor<f32, [64, 64]>,
    norm2: Tensor<f32, [64]>,
    w1: Tensor<f32, [64, 128]>,
    b1: Tensor<f32, [128]>,
    w2: Tensor<f32, [128, 64]>,
    b2: Tensor<f32, [64]>
}

// The blocks are one value, not two fields.  They are a tuple because H17 cannot yet
// differentiate a loop that iterates an array of tensors (an array element has no zero tangent),
// while a tuple is an ordinary aggregate the derivative and the optimizer already walk.  The
// loop below therefore walks the tuple at instantiation; no block is named in the forward pass.
type Model = {
    blocks: (Block, Block),
    norm_f: Tensor<f32, [64]>,
    head: Tensor<f32, [64, 32]>
}

// RMSNorm over the last axis.  The epsilon is the usual one, not a numerical trick.
func rmsnorm(x: TokenStates, gain: Tensor<f32, [64]>): TokenStates {
    let scale = mean(x * x, -1, true)
    return x / tensor_sqrt(scale + 1e-6) * gain
}

/// [B, S, D] -> [B, H, S, D / H]: head i owns the feature columns [i * Dh, (i + 1) * Dh).
func split_heads(t: TokenStates): HeadStates {
    return permute(reshape(t, [batch, sequence, n_heads, d_head]), [0, 2, 1, 3])
        as HeadStates
}

/// [B, H, S, Dh] -> [B, S, H * Dh].
func merge_heads(t: HeadStates): TokenStates {
    return reshape(permute(t, [0, 2, 1, 3]), [batch, sequence, d_model])
        as TokenStates
}

// One pre-norm block: attention with three separate projections, then the MLP.  The softmax is
// the textbook definition, with no maximum subtracted.
func block_forward(b: Block, x: TokenStates): TokenStates {
    let h = rmsnorm(x, b.norm1)
    let q = split_heads(h @ b.wq)
    let k = split_heads(h @ b.wk)
    let v = split_heads(h @ b.wv)
    // The scale is 1 / sqrt(d_head), not a literal chosen for one width.
    let scores: Scores = (q @ transpose(k)) / attention_scale
    let p = exp(scores) / sum(exp(scores), -1, true)
    let attended = merge_heads(p @ v) @ b.wo
    let y = x + attended
    let f: FeedForward = gelu(rmsnorm(y, b.norm2) @ b.w1 + b.b1)
    return y + (f @ b.w2 + b.b2)
}

// The logits of every position: every block in turn, a final RMSNorm and a projection to the
// vocabulary.  The loop walks the blocks value; no block is named in this function.
func logits(m: Model, x: TokenStates): Logits {
    let h = static loop h = x
        for (i, B) in fields (Block, Block) do block_forward(m.blocks.[i], h)
    return rmsnorm(h, m.norm_f) @ m.head
}

// The textbook cross-entropy: normalise exp(logits), take log of the result, and read the true
// class.  No log_softmax and no gather; the one-hot product does the reading.
with <m: Model>
func loss(x: TokenStates, labels: Tensor<i64, [8, 16]>): float {
    let z = logits(m, x)
    let p = exp(z) / sum(exp(z), -1, true)
    // one_hot reads a rank-1 index tensor, so flatten the labels and restore the position grid.
    let oh = reshape(one_hot(reshape(labels, [batch * sequence]), vocab),
                     [batch, sequence, vocab])
    // `oh` is int64 and `p` is f32: the product's numeric promotion gives f32.  H17 has no dtype
    // conversion written as a type (`f32(oh)` and `oh as f32[...]` are both refused), so this is
    // the typed form available today; no stringly `cast` is needed.
    let picked = sum(log(p) * oh, -1)
    return -mean(picked)
}

func init_block(std: float): Block {
    return {
        norm1: randn([d_model], 1.0, 0.0) as Tensor<f32, [64]>,
        wq: randn([d_model, d_model], 0.0, std) as Tensor<f32, [64, 64]>,
        wk: randn([d_model, d_model], 0.0, std) as Tensor<f32, [64, 64]>,
        wv: randn([d_model, d_model], 0.0, std) as Tensor<f32, [64, 64]>,
        wo: randn([d_model, d_model], 0.0, std) as Tensor<f32, [64, 64]>,
        norm2: randn([d_model], 1.0, 0.0) as Tensor<f32, [64]>,
        w1: randn([d_model, d_ff], 0.0, std) as Tensor<f32, [64, 128]>,
        b1: randn([d_ff], 0.0, std) as Tensor<f32, [128]>,
        w2: randn([d_ff, d_model], 0.0, std) as Tensor<f32, [128, 64]>,
        b2: randn([d_model], 0.0, std) as Tensor<f32, [64]>
    }
}

func init_model(): Model {
    let std = 0.02
    return {
        blocks: (init_block(std), init_block(std)),
        norm_f: randn([d_model], 1.0, 0.0) as Tensor<f32, [64]>,
        head: randn([d_model, vocab], 0.0, std) as Tensor<f32, [64, 32]>
    }
}

// The parameter count is read from the model's own shapes, not repeated as a formula at the
// print site.
func count_block(b: Block): int {
    return shape(b.norm1)[0] + shape(b.wq)[0] * shape(b.wq)[1] +
        shape(b.wk)[0] * shape(b.wk)[1] + shape(b.wv)[0] * shape(b.wv)[1] +
        shape(b.wo)[0] * shape(b.wo)[1] + shape(b.norm2)[0] +
        shape(b.w1)[0] * shape(b.w1)[1] + shape(b.b1)[0] +
        shape(b.w2)[0] * shape(b.w2)[1] + shape(b.b2)[0]
}

func param_count(m: Model): int {
    return static loop n = shape(m.norm_f)[0] + shape(m.head)[0] * shape(m.head)[1]
        for (i, B) in fields (Block, Block) do n + count_block(m.blocks.[i])
}

func main(bench: bool, init_dir: string, final_dir: string): int sync {
    // One fixed seed drives the starting weights and the data.  The labels are the largest of the
    // first `vocab` features of each position, so the task is deterministic and learnable.
    seed(42)
    let model = init_model()
    let x: TokenStates = randn([batch, sequence, d_model], 0.0, 1.0) as TokenStates
    let labels: Tensor<i64, [8, 16]> = argmax(slice(x, 2, 0, vocab), -1)

    if init_dir != '' then {
        save_params({ model: model, x: x, labels: labels }, init_dir)
    }

    let before = loss<model>(x, labels)
    `naive config batch=${batch} sequence=${sequence} d_model=${d_model} heads=${n_heads} d_ff=${d_ff} vocab=${vocab} blocks=2 params=${param_count(model)}`
        ->println
    `naive init loss=${before:.9f}`->println

    let loss_grad = with_grad(loss)
    let (trained, state, done) = loop m = model, st = adam_state(model), i = 0
        while i < steps
        do sync {
            let start = if bench then now() else 0.0
            let (value, gradient) = loss_grad<m>(x, labels)
            let next = adam(m, gradient, st, lr)
            let elapsed = if bench then now() - start else 0.0
            if bench && i >= warmup then {
                `naive bench step=${i} ms=${elapsed * 1000.0:.6f}`->println
            }
            `naive step=${i} loss=${value:.9f}`->println
            return (next.0, next.1, i + 1)
        }

    let after = loss<trained>(x, labels)
    `naive final steps=${done} loss=${after:.9f}`->println
    if final_dir != '' then {
        save_params(trained, final_dir)
    }
    return 0
}