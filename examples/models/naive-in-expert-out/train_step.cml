// A Transformer training step written the way the textbook writes it, with no numerical care:
// a plain softmax (exp / sum), a plain log of that softmax for the cross-entropy, separate Q, K
// and V projections, and an RMSNorm, a two-layer MLP and Adam.
//
// It is deliberately naive.  Large logits overflow `exp`; very negative logits underflow it and
// `log(0)` gives -inf.  The program only needs the ordinary range of its own fixed seed, so it
// trains and the loss falls.  The PyTorch expert counterpart (stable softmax, log_softmax, a
// fused QKV projection) and the measurement of where the naive forms break are in the same
// directory.
//
// Run:
//   camel examples/models/naive-in-expert-out/train_step.cml
//   camel examples/models/naive-in-expert-out/train_step.cml std::fvm
//   camel examples/models/naive-in-expert-out/train_step.cml std::jit
//
// Environment (all optional):
//   NAIVE_BENCH=1     also print one `naive bench step=<i> ms=<t>` line per step
//   NAIVE_INIT_DIR    write the initial model and the data there, as .npy files
//   NAIVE_FINAL_DIR   write the trained model there, as .npy files
module naive_in_expert_out

import {
    Tensor, argmax, cast, exp, gelu, log, mean, one_hot, permute, randn, reshape, seed,
    set_num_threads, shape, slice, sqrt, sum, transpose
} from tensor
import { with_grad, stop_gradient } from autodiff
import { adam, adam_state, save_params } from nn
import { get_env } from env
import { now } from time

// batch 8, sequence 16, model 64, 4 heads of width 16, FFN 128, vocabulary 32, two blocks.
let batch = 8
let sequence = 16
let d_model = 64
let n_heads = 4
let d_head = 16
let d_ff = 128
let vocab = 32
let steps = 16
let warmup = 3
let lr = 0.003

type Block = {
    norm1: Tensor,
    wq: Tensor,
    wk: Tensor,
    wv: Tensor,
    wo: Tensor,
    norm2: Tensor,
    w1: Tensor,
    b1: Tensor,
    w2: Tensor,
    b2: Tensor
}

type Model = {
    block0: Block,
    block1: Block,
    norm_f: Tensor,
    head: Tensor
}

// RMSNorm over the last axis.  The epsilon is the usual one, not a numerical trick.
func rmsnorm(x: Tensor, gain: Tensor): Tensor {
    let scale = mean(x * x, -1, true)
    return x / sqrt(scale + 1e-6) * gain
}

/// [B, S, D] -> [B, H, S, D / H]: head i owns the feature columns [i * Dh, (i + 1) * Dh).
func split_heads(t: Tensor): Tensor {
    return permute(reshape(t, [batch, sequence, n_heads, d_head]), [0, 2, 1, 3])
}

/// [B, H, S, Dh] -> [B, S, H * Dh].
func merge_heads(t: Tensor): Tensor {
    return reshape(permute(t, [0, 2, 1, 3]), [batch, sequence, d_model])
}

// One pre-norm block: attention with three separate projections, then the MLP.  The softmax is
// the textbook definition, with no maximum subtracted.
func block_forward(b: Block, x: Tensor): Tensor {
    let h = rmsnorm(x, b.norm1)
    let q = split_heads(h @ b.wq)
    let k = split_heads(h @ b.wk)
    let v = split_heads(h @ b.wv)
    // d_head is 16, so the scale is 1 / sqrt(16) = 1 / 4.
    let scores = (q @ transpose(k)) / 4.0
    let p = exp(scores) / sum(exp(scores), -1, true)
    let attended = merge_heads(p @ v) @ b.wo
    let y = x + attended
    let f = gelu(rmsnorm(y, b.norm2) @ b.w1 + b.b1)
    return y + (f @ b.w2 + b.b2)
}

// The logits of every position: two blocks, a final RMSNorm and a projection to the vocabulary.
func logits(m: Model, x: Tensor): Tensor {
    let h = block_forward(m.block0, x)
    let h2 = block_forward(m.block1, h)
    return rmsnorm(h2, m.norm_f) @ m.head
}

// The textbook cross-entropy: normalise exp(logits), take log of the result, and read the true
// class.  No log_softmax and no gather; the one-hot product does the reading.
with <m: Model>
func loss(x: Tensor, labels: Tensor): float {
    let z = logits(m, x)
    let p = exp(z) / sum(exp(z), -1, true)
    // one_hot reads a rank-1 index tensor, so flatten the labels and restore the position grid.
    let oh = reshape(one_hot(reshape(labels, [batch * sequence]), vocab), [batch, sequence, vocab])
    let picked = sum(log(p) * stop_gradient(cast(oh, 'float32')), -1)
    return -mean(picked)
}

func init_block(std: float): Block {
    return {
        norm1: randn([d_model], 1.0, 0.0),
        wq: randn([d_model, d_model], 0.0, std),
        wk: randn([d_model, d_model], 0.0, std),
        wv: randn([d_model, d_model], 0.0, std),
        wo: randn([d_model, d_model], 0.0, std),
        norm2: randn([d_model], 1.0, 0.0),
        w1: randn([d_model, d_ff], 0.0, std),
        b1: randn([d_ff], 0.0, std),
        w2: randn([d_ff, d_model], 0.0, std),
        b2: randn([d_model], 0.0, std)
    }
}

func init_model(): Model {
    let std = 0.02
    return {
        block0: init_block(std),
        block1: init_block(std),
        norm_f: randn([d_model], 1.0, 0.0),
        head: randn([d_model, vocab], 0.0, std)
    }
}

func main(): int sync {
    set_num_threads(1)

    // One fixed seed drives the starting weights and the data.  The labels are the largest of the
    // first `vocab` features of each position, so the task is deterministic and learnable.
    seed(42)
    let model = init_model()
    let x = randn([batch, sequence, d_model], 0.0, 1.0)
    let labels = argmax(slice(x, 2, 0, vocab), -1)

    let bench = get_env('NAIVE_BENCH') == '1'
    let init_dir = get_env('NAIVE_INIT_DIR')
    let final_dir = get_env('NAIVE_FINAL_DIR')
    if init_dir != '' then {
        save_params({ model: model, x: x, labels: labels }, init_dir)
    }

    let before = loss<model>(x, labels)
    `naive config batch=${batch} sequence=${sequence} d_model=${d_model} heads=${n_heads} d_ff=${d_ff} vocab=${vocab} blocks=2 params=${8 * d_model * d_model + 4 * d_model * d_ff + 7 * d_model + 2 * d_ff + d_model * vocab}`
        ->println
    `naive init loss=${before:.9f}`->println

    let loss_grad = with_grad(loss)
    let (trained, state, done) = loop m = model, st = adam_state(model), i = 0
        while i < steps
        do sync {
            let start = if bench then now() else 0.0
            let (value, gradient) = loss_grad<m>(x, labels)
            let next = adam(m, gradient, st, lr)
            let elapsed = if bench then now() - start else 0.0
            if bench && i >= warmup then {
                `naive bench step=${i} ms=${elapsed * 1000.0:.6f}`->println
            }
            `naive step=${i} loss=${value:.9f}`->println
            return (next.0, next.1, i + 1)
        }

    let after = loss<trained>(x, labels)
    `naive final steps=${done} loss=${after:.9f}`->println
    if final_dir != '' then {
        save_params(trained, final_dir)
    }
    return 0
}