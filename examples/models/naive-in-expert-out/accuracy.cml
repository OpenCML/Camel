// The f32 side of the accuracy framework: the same naive forms as train_step.cml, at the input
// offsets where they stop being finite, next to the stable operators the design names.
//
// Run:
//   camel examples/models/naive-in-expert-out/accuracy.cml std::fvm
//
// The Python script accuracy.py measures bf16 and fp64; this program measures the f32 tensor
// type the language has today, so the two agree on where the naive form breaks.
module naive_accuracy

import {
    Tensor, cast, exp, log, log_softmax, new, one_hot, reshape, softmax, sum, transpose, zeros
} from tensor
import { is_inf, is_nan } from math
import { softmax_cross_entropy } from nn

func naive_softmax(x: f32[..]): f32[..] {
    let e = exp(x)
    return e / sum(e, -1, true)
}

func naive_log_softmax(x: f32[..]): f32[..] {
    return log(naive_softmax(x))
}

func naive_cross_entropy(logits: f32[..], labels: int): float {
    let p = naive_softmax(logits)
    let picked = float(sum(log(p) * cast(one_hot(new([labels]), 8), 'float32')))
    return -picked
}

func finite(x: float): bool {
    return !is_nan(x) && !is_inf(x)
}

func main(): int sync {
    // A logit of 89 is the first one whose exp exceeds the f32 maximum; a logit of about -104
    // is the first one whose exp becomes zero.  The scan prints every probed value.
    let softmax_values = [85.0, 88.0, 89.0, 90.0, 100.0, 1000.0]
    let _ = loop n = 0 for m in softmax_values do sync {
        let x = new([m, 0.0])
        let bad = !finite(sum(naive_softmax(x)))
        let ok = finite(sum(softmax(x)))
        'accuracy camel softmax m={} naive_bad={} stable_finite={}'->format<m, bad, ok>->println
        return n + 1
    }

    let underflow_values = [90.0, 93.0, 100.0, 103.0, 104.0, 105.0, 1000.0]
    let _ = loop n = 0 for m in underflow_values do sync {
        let x = new([0.0 - m, -1.0 - m])
        let bad = !finite(sum(naive_softmax(x)))
        let ok = finite(sum(softmax(x)))
        'accuracy camel softmax_underflow m={} naive_bad={} stable_finite={}'->format<m, bad, ok>->println
        return n + 1
    }

    let _ = loop n = 0 for m in underflow_values do sync {
        let x = new([0.0 - m, -1.0 - m])
        let bad = !finite(sum(naive_log_softmax(x)))
        let ok = finite(sum(log_softmax(x)))
        'accuracy camel log_softmax m={} naive_bad={} stable_finite={}'->format<m, bad, ok>->println
        return n + 1
    }

    let offsets = [85.0, 87.0, 88.0, 89.0, 100.0, 1000.0]
    let _ = loop n = 0 for k in offsets do sync {
        let logits = zeros([1, 8]) + k
        let bad = !finite(naive_cross_entropy(logits, 0))
        let ok = finite(softmax_cross_entropy(logits, new([0])))
        'accuracy camel cross_entropy_offset k={} naive_bad={} expert_finite={}'->format<k, bad, ok>->println
        return n + 1
    }

    let _ = loop n = 0 for m in underflow_values do sync {
        let logits = zeros([1, 8]) - cast(one_hot(new([0]), 8), 'float32') * m
        let bad = !finite(naive_cross_entropy(logits, 0))
        let ok = finite(softmax_cross_entropy(logits, new([0])))
        'accuracy camel cross_entropy_true_class m={} naive_bad={} expert_finite={}'->format<m, bad, ok>->println
        return n + 1
    }

    // 1e8 + 1 is not representable in f32; the matmul accumulates left to right and rounds the
    // 1 away, while the f64 `sum` of the same elementwise products keeps it.
    let a = reshape([1.0e8, 1.0, -1.0e8], [1, 3])
    let b = reshape([1.0, 1.0, 1.0], [3, 1])
    let product = sum(a @ b)
    let reference = sum(a * transpose(b))
    'accuracy camel matmul f32_matmul={:.6f} fp64_sum={:.6f}'->format<product, reference>->println
    return 0
}