// Lookups that may find nothing return T?: `find` and `index_of` of `array`, a Map lookup.
// `??` supplies a default and `match` tells the two cases apart.
// Run: camel examples/data/nullable_lookup.cml

import { find, index_of } from array

type Product = { id: int, name: string, price: float }

func by_id(items: Product[], id: int): Product? {
    return items->find<(p: Product): bool => p.id == id>
}

func label(p: Product?): string {
    return match p {
        case null => 'no such product'
        case v => v.name + ' costs ' + format<v.price>('{:.2f}')
    }
}

func main(): int sync {
    let catalog: Product[] = [
        { id: 10, name: 'lamp', price: 19.5 },
        { id: 20, name: 'desk', price: 120.0 },
        { id: 30, name: 'chair', price: 64.25 }
    ]
    println(label(by_id(catalog, 20)))
    println(label(by_id(catalog, 99)))

    let names = catalog->map<(p: Product): string => p.name>
    println('desk is at', names->index_of<'desk'> ?? -1, 'and sofa at', names->index_of<'sofa'> ?? -1)

    // A Map lookup is nullable as well.
    let stock = [('lamp', 4), ('desk', 0)] as Map<string, int>
    println('lamps:', stock['lamp'] ?? 0, 'chairs:', stock['chair'] ?? 0)
    println('chair is listed:', stock->has<'chair'>)

    let nothing: int? = null
    println(nothing, nothing ?? -1)
    return 0
}
