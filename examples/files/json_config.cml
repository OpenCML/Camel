// Keeps settings in a JSON file: writes it, reads it back into a typed struct, and falls
// back to defaults when the file is missing or does not have the expected shape.
// Run: camel examples/files/json_config.cml
module json_config

import json
import { mkdirs, write_text, read_text } from fs
import { get_env } from env

type Config = { host: string, port: int, verbose: bool }

func decode(text: string): Config! {
    return json::decode_as::<Config>(text)
}

func load(path: string, defaults: Config): Config {
    return path->read_text ?-> decode !! defaults
}

func show(c: Config): string {
    return format<c.host, c.port, c.verbose>('{}:{} verbose={}')
}

func main(): int sync {
    let defaults: Config = { host: 'localhost', port: 8080, verbose: false }
    // The test runner gives every test its own scratch directory (CAMEL_TEST_TMPDIR), so the
    // four back ends (and two runs) do not share these files. A direct run keeps the path the
    // header names.
    let root = get_env('CAMEL_TEST_TMPDIR') ?? ''
    let dir = if root == '' then 'tmp/examples' else root
    let _ = dir->mkdirs

    let path = dir + '/config.json'
    let custom: Config = { host: 'example.org', port: 443, verbose: true }
    let _ = (custom->json::encode<indent: 2>)->write_text<path>
    println('from file:    ', show(load(path, defaults)))

    let broken = dir + '/broken.json'
    let _ = '{"host": "example.org", "port": "https"}'->write_text<broken>
    println('wrong shape:  ', show(load(broken, defaults)))

    println('missing file: ', show(load(dir + '/absent.json', defaults)))
    return 0
}
