// Two rewrites of the training program, written in Camel against the graph module.
//
// Neither rewrite reads how the program is written. A pass is handed the program's entry function
// value and edits the graphs that value reaches; a node is chosen by what it is -- the operator it
// runs, the type it carries, whether it is a constant -- and by a count that has to be one. No choice
// takes the first of a list: `nodes` returns node-id order, which is the order the writer created the
// nodes in, so renaming a value or swapping two independent declarations would silently change which
// node a rewrite edits.
import { flatten } from array
import { Graph, Node, erase, graphs, graphs_of, is_constant, nodes, op, op_name, replace, type_name, type_of } from graph
import { is_function } from types

// What a node runs and what type it carries, or `-` where it has none. `op(n)` is the module's own
// answer to "is this an operator node", so no rendered text is compared to decide it.
func looks(n: Node) => string {
    let operator = match op(n) {
        case null => '-'
        case o => op_name(o)
    }
    let carried = match type_of(n) {
        case null => '-'
        case t => type_name(t)
    }
    return operator + ' : ' + carried
}

// Whether the node is a constant carrying the type named.
func constant_of(n: Node, wanted: string) => bool {
    let carried = match type_of(n) {
        case null => '-'
        case t => type_name(t)
    }
    return is_constant(n) && carried == wanted
}

// Whether the node runs the printing operator.
func is_print(n: Node) => bool {
    return match op(n) {
        case null => false
        case o => op_name(o) == ':io/println'
    }
}

// Every node of every graph the entry function value reaches. A program is a root graph whose one
// call goes to the entry function, so its graphs are reached by following calls, never by comparing
// a graph name.
func all_nodes::<F>(p: F) => Node[] when is_function::<F>() {
    return flatten(graphs_of(p)->map<nodes>)
}

// The `float` constants of one graph.
func floats_in(g: Graph) => Node[] {
    return nodes(g)->filter<func (n: Node) => bool {
        constant_of(n, 'float')
    }>
}

// The constants of type `Linear` in one graph.
func models_in(g: Graph) => Node[] {
    return nodes(g)->filter<func (n: Node) => bool {
        constant_of(n, 'Linear')
    }>
}

// Whether one graph holds both of the constants the rewrite pairs, each exactly once.
func holds_the_pair(g: Graph) => bool {
    return len(floats_in(g)) == 1 && len(models_in(g)) == 1
}

/// Lists every node the program is made of: the operator each one runs, and the type it carries.
export func list::<F>(p: F) => F! sync {
    all_nodes(p)->foreach<func (n: Node) {
        println(looks(n))
    }>
    return p
}

/// Drops every printing call of the program: a rewrite that loses an effect.
///
/// The edit block's draft is the function plus every graph the function can reach, so the printing
/// calls are chosen across the whole program, not in one graph of it, and the block's commit makes
/// the changed function.
export func drop_print::<F>(p: F) => F! sync {
    return edit d = p {
        // The calls are read out of the draft before any of them is erased, and the count is taken
        // first, so the reading happens while the draft is still open.
        let prints = flatten(graphs(d)->map<nodes>)->filter<is_print>
        if len(prints) > 0 then {
            prints->foreach<func (n: Node) => void {
                erase(n)
            }>
        }
    }
}

/// Passes the starting model where the learning rate goes: a rewrite that breaks a type.
///
/// The rate is the one constant of type `float` in the graph that also holds the one constant of type
/// `Linear` (the model), and the rewrite refuses when no single graph holds that pair. The count that
/// has to be one is taken per graph, not over the whole program: the count over `all_nodes` used to
/// find exactly one `float` constant, and it no longer does, because a derivative carries constants of
/// its own -- the seed `grad` reads `vjp` at, and the ones the transpose builds. Those are not the
/// learning rate, and the graph the rate is written in still holds exactly one.
///
/// A count that is not one has to answer "nothing to do" rather than pick one of them, and that is
/// the whole cost of this rewrite: the program runs unchanged, exit 0, and the reading the pass
/// existed to make is simply gone. Silence costs more than a refusal -- a refusal names the type and
/// the place, and a rewrite that quietly declines to pick names nothing at all.
export func break_rate::<F>(p: F) => F! sync {
    return edit d = p {
        let where = graphs(d)->filter<holds_the_pair>
        if len(where) == 1 then {
            let g = where[0]
            // `holds_the_pair` says this graph holds each of the two constants exactly once, so the
            // two nodes are the rate and the model, and no other graph is asked.
            replace(floats_in(g)[0], models_in(g)[0])
        }
    }
}
