// Functions as values: returning a closure, composing functions, a table of operations,
// `with` parameters, and state threaded through a function as values.
// Run: camel examples/functions/closures.cml
//
// State a closure would keep for itself is state the program writes as values that go in and come
// back out (design principles 3.5, rule two; the author's ruling of 2026-11-14): a `var` lives in
// the call that declares it, so a closure may capture one by reference only while it stays inside
// that call. The shape this example used to show -- a factory returning a closure over its own
// `var count` -- is a compile error now, and it is worth seeing what it says:
//
//     func make_counter(): () => int {
//         var count = 0
//         return (): int => sync { count = count + 1 return count }
//     }
//
//     error: 'count' cannot leave the call that declares it: a closure captures it by reference,
//     and this value is carried out. (SemanticDiag::ClosureCaptureEscapes, 0x03000210)
//
// The report names two rewrites, and the counter below uses the second: pass the state as a value,
// in as a parameter and back out as the result. A cell a program really must share, rather than
// thread, is written with `Ref<T>`.

type IntFn = (x: int) => int

func adder(n: int): IntFn {
    return (x: int): int => x + n
}

func compose(f: IntFn, g: IntFn): IntFn {
    return (x: int): int => g(f(x))
}

// Applies every function of `steps` in turn.
func pipeline(steps: IntFn[]): IntFn {
    return steps->reduce<compose, (x: int): int => x>
}

// A `with` parameter is given in angle brackets, before the ordinary argument.
with <factor: int>
func scale(x: int): int {
    return x * factor
}

// One count, taken as a value and given back as the next one: three calls read 1, 2 and 3, and a
// second count that starts at 0 reads 1 -- the same reading the factory gave, with nothing kept
// between the calls.
func tick(count: int): int {
    return count + 1
}

func main(): int sync {
    let add3 = adder(3)
    let double = (x: int): int => x * 2
    println(add3(4), double(4), compose(add3, double)(4))

    let steps = [add3, double, adder(-1)]
    println(pipeline(steps)(4))
    println([1, 2, 3]->map<pipeline(steps)>)

    let direct = scale<10>(7)
    let piped = 7->scale<10>
    println(direct, piped)

    let once = tick(0)
    let twice = tick(once)
    let thrice = tick(twice)
    let other = tick(0)
    println(once, twice, thrice, other)
    return 0
}