// Formats an aligned table: the first column is as wide as its longest entry (`max` of
// `array`, `repeat` of `str`), the headings are made with `to_upper`, the total with `sum`.
// Run: camel examples/text/table_report.cml
module table_report

import { repeat, to_upper } from str
import { max, sum } from array

type Item = { name: string, qty: int, price: float }

// `s` followed by spaces up to `width` bytes.
func pad(s: string, width: int): string {
    return s + ' '->repeat<width - len(s)>
}

func amount(it: Item): float {
    return float(it.qty) * it.price
}

func line(it: Item, width: int): string {
    return format<pad(it.name, width), it.qty, it.price, amount(it)>('{}{:>5}{:>9.2f}{:>10.2f}')
}

func main(): int sync {
    let items: Item[] = [
        { name: 'notebook', qty: 3, price: 2.5 },
        { name: 'pen', qty: 12, price: 0.8 },
        { name: 'water bottle', qty: 2, price: 7.25 },
        { name: 'backpack', qty: 1, price: 34.99 }
    ]

    let longest = max(items->map<(it: Item): int => len(it.name)>) ?? 0
    let width = longest + 2
    let rule = '-'->repeat<width + 24>
    let heads = ['item', 'qty', 'price', 'amount']->map<(h: string): string => to_upper(h)>

    println(format<pad(heads[0], width), heads[1], heads[2], heads[3]>('{}{:>5}{:>9}{:>10}'))
    println(rule)
    println(items->map<(it: Item): string => line(it, width)>->join<'\n'>)
    println(rule)
    println(format<pad('total', width), sum(items->map<amount>)>('{}{:>24.2f}'))
    return 0
}
