// Exports a small two-layer model to an ONNX file with `onnx.export_model`: the function to
// export, an example input (its type and shape become the model input) and the file path.
// Run: camel examples/ml/export_onnx.cml
//      camel examples/ml/export_onnx.cml std::macro std::opt onnx::export
// The first command runs the program; the second translates it without running it and
// writes the same model.
module export_onnx

import { tanh, reshape } from tensor
import { export_model } from onnx
import { mkdirs, file_size } from fs
import { get_env } from env

type Weights = { hidden: f32[..], out: f32[..] }

func forward(x: f32[..], w: Weights): f32[..] {
    return tanh(x @ w.hidden) @ w.out
}

func weights(): Weights {
    return {
        hidden: reshape([0.5, -0.25, 0.1, 0.3, 0.2, -0.4] as f32[], [2, 3]),
        out: reshape([1.0, -1.0, 0.5] as f32[], [3, 1])
    }
}

func main(): int sync {
    let w = weights()
    let x = reshape([1.0, 2.0, 0.5, -1.0] as f32[], [2, 2])       // two samples with two features
    println(forward(x, w))

    // The runner's per-test scratch directory (the translate test names the file with the pass's
    // `out` parameter instead); a direct run keeps the header's fixed path.
    let root = get_env('CAMEL_TEST_TMPDIR')
    let dir = if root == '' then 'tmp/examples' else root
    let path = dir + '/tiny_model.onnx'
    mkdirs(dir)
    // The closure captures the weights, so they are stored in the model; `[0]` leaves the
    // first axis (the batch size) open.
    export_model((t: f32[..]): f32[..] => forward(t, w), x, path, [0])
    println('model file written:', file_size(path) > 0)
    return 0
}
