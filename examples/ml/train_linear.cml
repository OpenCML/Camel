// A minimal training loop: a linear model as a struct of tensors, the gradient of the loss
// from `autodiff.grad`, the update from `nn.sgd`, and the loop as a tail recursion.
// Run: camel examples/ml/train_linear.cml
module train_linear

import { grad } from autodiff
import { Tensor, reshape, shape, sum } from tensor
import { sgd } from nn

type Linear = { weight: f32[..] }

// Mean squared error of the model on (X, y). The model is the first `with`
// parameter, so `grad` differentiates it; the targets are captured `with` data and stay
// constant.
with <layer: Linear, y: f32[..]>
func mse_loss(X: f32[..]): float {
    let errors = X @ layer.weight - y
    return float(sum(errors * errors)) / float(shape(X)[0])
}

func train(layer: Linear, X: f32[..], y: f32[..], rate: float, steps: int): Linear {
    let loss_grad = grad(mse_loss)
    let grads = loss_grad<layer, y>(X)       // a Linear: the gradient of the first `with` parameter
    return if steps == 0 then layer
        else train(sgd(layer, grads, rate), X, y, rate, steps - 1)
}

func init(): Linear {
    return { weight: reshape([0.0, 0.0] as f32[], [2, 1]) }
}

func main(): int sync {
    // Four samples of y = 2 * x1 - 1 * x2.
    let X = reshape([1.0, 0.0, 0.0, 1.0, 1.0, 1.0, 2.0, 1.0] as f32[], [4, 2])
    let y = reshape([2.0, -1.0, 1.0, 3.0] as f32[], [4, 1])
    let start = init()

    println(format<mse_loss<start, y>(X)>('loss before training: {:.4f}'))
    let after10 = train(start, X, y, 0.1, 10)
    println(format<mse_loss<after10, y>(X)>('loss after 10 steps:  {:.4f}'))
    let after200 = train(start, X, y, 0.1, 200)
    println(format<mse_loss<after200, y>(X)>('loss after 200 steps: {:.4f}'))
    println(after200.weight)
    return 0
}
