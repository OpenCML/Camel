// Integrates the cooling equation dT/dt = -k (T - T_room) with Euler steps written as a
// tail recursion, and compares the result with the exact solution.
// Run: camel examples/numeric/ode_euler.cml

import { exp } from math

type Cooling = { k: float, room: float }

func rate(c: Cooling, temp: float): float {
    return 0.0 - c.k * (temp - c.room)
}

// `steps` Euler steps of size `dt`; the state is passed along as an argument.
func integrate(c: Cooling, temp: float, dt: float, steps: int): float {
    return if steps == 0 then temp
        else integrate(c, temp + dt * rate(c, temp), dt, steps - 1)
}

func exact(c: Cooling, start: float, t: float): float {
    return c.room + (start - c.room) * exp(0.0 - c.k * t)
}

func main(): int sync {
    let coffee: Cooling = { k: 0.1, room: 20.0 }
    let start = 90.0
    let minutes = 30.0
    let truth = exact(coffee, start, minutes)
    println(format<truth>('exact after 30 min: {:.4f}'))

    // A smaller step gives a smaller error; one million steps do not grow the stack.
    let step_counts = [30, 300, 3000, 1000000]
    let rows = step_counts->map<(n: int): string => report(coffee, start, minutes, n, truth)>
    println(rows->join<'\n'>)
    return 0
}

func report(c: Cooling, start: float, t: float, steps: int, truth: float): string {
    let value = integrate(c, start, t / float(steps), steps)
    return format<steps, value, value - truth>('{:>8} steps: {:.4f}  error {:+.5f}')
}
