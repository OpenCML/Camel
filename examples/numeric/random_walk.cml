// Seeded random walks: the `random` module with a fixed seed, summary with `statistics`.
// The steps are a tail recursion, not a `map`, because they must happen in order. The calls
// of a `map` on different elements have no order among them, and a parallel back end may run
// them at the same time; a call that depends on state, such as `randint`, placed in the
// function given to `map` therefore gives a result that is stable on the sequential back
// ends and may differ from run to run under `std::prl`. Steps that happen one after another
// are written with `foreach`, `reduce` or a tail recursion.
// Run: camel examples/numeric/random_walk.cml

import { seed, randint } from random
import { mean, stdev } from statistics
import { max } from array
import { abs } from math

// Position after `steps` moves of -1 or +1.
func walk(steps: int, position: int): int sync {
    return if steps == 0 then position
        else walk(steps - 1, position + randint(0, 1) * 2 - 1)
}

// End positions of `count` walks made one after another. The walks share one generator, so
// the order in which they are made is part of the result: it is fixed by the recursion.
func walks(count: int, ends: int[]): int[] sync {
    return if count == 0 then ends
        else walks(count - 1, concat(ends, [walk(100, 0)]))
}

func main(): int sync {
    seed(2024)
    let no_ints: int[] = []
    let ends = walks(12, no_ints)
    println(ends)

    let distances = ends->map<(e: int): int => abs(e)>
    println(format<mean(distances), stdev(distances)>('mean distance {:.2f}  stdev {:.2f}'))
    println('farthest:', max(distances) ?? 0)
    return 0
}
