// A check for scripts: `exit(n)` is what sets the exit code of the process and ends the program at
// once. The value `main` returns is the function's own -- it is not the exit code (design
// principles 9.8), so this program says its status with `exit` and its return value is unused.
// Run: camel examples/cli/exit_status.cml --arg used=91 --arg limit=80     (exit code 1)
//      camel examples/cli/exit_status.cml --arg used=40 --arg limit=80     (exit code 0)

import { exit } from process

func main(used: int, limit: int) => int sync {
    if limit <= 0 then sync {
        println('limit must be positive')
        exit(2)
    }
    println(`usage ${used}%, limit ${limit}%`)
    let over = used > limit
    println(if over then 'over the limit' else 'ok')
    if over then sync {
        exit(1)
    }
    return 0
}