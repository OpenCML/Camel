/**
 * The definitions of operators of the tensor module (docs/design/op-semantics, section 9).
 *
 * Each function here is the normative definition of the operator of its name (design
 * principles 7.1: a definition graph is normative): it computes exactly what the operator
 * computes, the axis, the numeric stabilization, the accumulator type and every conversion
 * included, from operators simpler than it. A kernel of the operator, fused or written by hand,
 * on any back end, must agree with it: bit for bit, except that a bounded function (exp, log)
 * is within its declared bound.
 *
 * The tensor module declares each function as the definition of its operator
 * (OperatorTable::declareDefinition, with how the operator's operands bind the parameters).
 * The core compiles this file the first time a definition is asked for; nothing expands an
 * operator into its definition unless a pass or a back end asks to (camel/runtime/
 * definitions.h). The functions take f32 tensors: an operator applied to another element type
 * is not expanded. This file imports modules written in C++ only.
 */
module tensor_definitions

import { max, sum, exp, log, maximum, numel, cast } from tensor

/// tensor:softmax along `axis` (negative counts from the end), made stable by subtracting the
/// maximum: m = max(x, axis) (IEEE maximum: a NaN gives NaN), e = exp(x - m) (an f32
/// subtraction, then exp within its bound), s = sum(e, axis) (from +0 in f64, in ascending
/// order, rounded to f32 once), and e / s (an f32 division, not a multiplication by 1 / s).
/// A tensor without elements is its own result (there is no lane to normalize).
export func softmax(x: f32[..], axis: int): f32[..] {
    if numel(x) == 0 then {
        return x
    } else {
        let m = max(x, axis, true)
        let e = exp(x - m)
        return e / sum(e, axis, true)
    }
}

/// tensor:log_softmax along `axis`: (x - m) - log(s) with m the maximum and s the sum of
/// exp(x - m) as in softmax (f32 steps; log within its bound). A tensor without elements is
/// its own result.
export func log_softmax(x: f32[..], axis: int): f32[..] {
    if numel(x) == 0 then {
        return x
    } else {
        let d = x - max(x, axis, true)
        return d - log(sum(exp(d), axis, true))
    }
}

/// tensor:mean of a whole tensor: the sum and the division both happen in f64 and their result is
/// rounded into the element type once, never a sum rounded to the element type and divided again,
/// which would round twice — the canonical form of the element type T is
/// `mean::<T>(x: T[..]): T = T(sum(float(x)) / float(numel(x)))` (stdlib/signatures/tensor.cml).
/// A definition has one graph and is written at the element type this library serves, f32; a mean
/// of another element type is the operator's own kernel, not an expansion. The widening is written
/// `cast(x, "f64")` because `float(x)` is a scalar conversion and a conversion does not map over an
/// array (measured: `No matching function found for argument types: <> (f32[..])`). A tensor
/// without elements is a fault.
export func mean(x: f32[..]): f32 {
    return f32(sum(cast(x, "f64")) / float(numel(x)))
}

/// tensor:relu: maximum(x, +0) (design principles 7.7): a NaN gives NaN, -0 gives +0.
export func relu(x: f32[..]): f32[..] {
    return maximum(x, 0.0)
}

/// tensor:sigmoid: 1 / (1 + exp(-x)), each step in f32 (exp within its bound).
export func sigmoid(x: f32[..]): f32[..] {
    return 1.0 / (1.0 + exp(-x))
}
