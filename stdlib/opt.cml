/**
 * The optimizations of the standard library written in Camel: the reference implementation of
 * what the C++ pass does, held to it by `test/plans/feat/opt/camel_passes.plan.toml`. A pass here
 * is a function `(p: Program) => Program!` exported by this module, so the pipeline names it
 * `opt::fold`, `opt::cse` and `opt::dce` and `test/tools/check-pass-declarations.mjs` reads it as
 * one.
 *
 * What a pass does is a transaction over the snapshot the `graph` module hands out: read a node,
 * `replace` it by another, `erase` one nobody reads, evaluate an operator over constants with
 * `eval`, `commit`, and read the next round from the new snapshot. Three of the four passes of
 * handover H227's first layer are here and one is not, and that time the reason is a missing
 * operation rather than a missing idea:
 *
 *   `opt::cse`   here. Constants of a type whose `==` is the equality of the graph's values
 *                (int, i32, bool) are one value, and pure operations with the same operator,
 *                type, inputs, region and permissions are one node; each set of equal nodes
 *                keeps its first node. A value that may be written in place, and an operation
 *                that reads such a value, is left alone. Rounds repeat until none is left,
 *                because merging two constants can make the operations over them equal.
 *   `opt::dce`   here, as the value-only half of `std::opt::dce values_only=true`: a constant, a
 *                conversion, a copy, an access, a fill or a pure operation that no node reads is
 *                erased, until none is left. The gates and the syncs stay: bypassing a forwarding
 *                gate moves its waits to its consumers, which is edge surgery a transaction
 *                cannot write.
 *   `opt::fold`  here. A pure operation whose operands are all constants is replaced by the value
 *                its operator computes (`eval`). The C++ pass also folds a conversion, a copy, a
 *                fill and an access, and answers from an operator's *type* folder when the
 *                operand types alone fix the result; the `graph` module evaluates an operation
 *                over values, so those cases are the C++ pass's own and are not folded here. Two
 *                more cases are the C++ pass's own: a branch over constants, because evaluating an
 *                operation is not folding the branch structure around it, and a *returned*
 *                constant expression, because the C++ pass moves the graph's exit, output and
 *                return anchors onto the value it computed (`replaceFoldResult`) and a transaction
 *                has no operation that moves an anchor. A constant expression that can only fault
 *                is evaluated and left as written by both, so that the program is the same with
 *                and without the pass and the fault is still reported where it is written.
 *   `opt::ctrl`  not here. It removes a control edge that a mandatory data or control path
 *                already implies, and a transaction can only replace or erase a whole node; it
 *                has no way to drop one edge and no way to add one.
 *
 * Two more gaps, both recorded in `docs/technical/45_graph_module.md`, are worked around rather
 * than closed. The bits of a scalar are not readable from Camel (`bytes` encodes arrays and
 * tensors, `math` has no `signbit`), so `0.0` and `-0.0` are equal by `==` and distinct in the
 * graph, and no float constant is merged here although the C++ pass merges one. A node's
 * attributes are readable as text (`tags`) but not writable, so two nodes whose attributes differ
 * are kept apart, where the C++ pass merges the attributes of the nodes it merges.
 */
module opt

import { flatten, all, any } from array
import { Program, Node, Graph, Txn, NodeKind, graphs, nodes, inputs, with_inputs, value_users, id, kind, op, op_name, is_pure, is_anchor, is_written_slot, is_constant, type_of, type_name, region_of, permissions, tags, constant, open, replace, erase, eval, commit, abort } from graph

// ---- reading a node as the key of a comparison ----

func opText(n: Node): string {
    return match op(n) {
        case null => ''
        case o => op_name(o)
    }
}

func typeText(n: Node): string {
    return match type_of(n) {
        case null => ''
        case t => type_name(t)
    }
}

func allNodes(p: Program): Node[] {
    return flatten(graphs(p)->map<(g: Graph): Node[] => nodes(g)>)
}

// ---- common subexpressions ----

/// The types whose `==` in Camel is the equality of the graph's values too. A float is left out
/// on purpose: Camel cannot read the bits of a scalar, so `0.0 == -0.0` holds while the two
/// constants are different values of the graph, and merging them would change the program.
func bitEqualType(ty: string): bool {
    return ty == 'int' || ty == 'i32' || ty == 'bool'
}

func sameIntValue(b: Node, x: int): bool {
    return match constant(b, 0) {
        case null => false
        case y => x == y
    }
}

func sameI32Value(b: Node, x: i32): bool {
    let zero: i32 = 0
    return match constant(b, zero) {
        case null => false
        case y => x == y
    }
}

func sameBoolValue(b: Node, x: bool): bool {
    return match constant(b, false) {
        case null => false
        case y => x == y
    }
}

/// Whether the two nodes are constants of the same type and the same value.
func sameConstant(a: Node, b: Node, ty: string): bool {
    return if ty == 'int' then sameIntConstant(a, b) else if ty == 'i32' then sameI32Constant(a, b) else sameBoolConstant(a, b)
}

func sameIntConstant(a: Node, b: Node): bool {
    return match constant(a, 0) {
        case null => false
        case x => sameIntValue(b, x)
    }
}

func sameI32Constant(a: Node, b: Node): bool {
    let zero: i32 = 0
    return match constant(a, zero) {
        case null => false
        case x => sameI32Value(b, x)
    }
}

func sameBoolConstant(a: Node, b: Node): bool {
    return match constant(a, false) {
        case null => false
        case x => sameBoolValue(b, x)
    }
}

/// A constant the sweep may merge: a static value of a type whose `==` is bit equality, which no
/// node may write in place.
func mergeableConstant(n: Node): bool {
    return kind(n) == NodeKind::Data && is_constant(n) && bitEqualType(typeText(n)) && !is_written_slot(n)
}

/// Whether the two lists name the same nodes in the same order.
func sameNodes(xs: Node[], ys: Node[]): bool {
    return len(xs) == len(ys) && range(0, len(xs))->all<(i: int): bool => xs[i] == ys[i]>
}

/// Whether one of the nodes may be written in place. An operation over such a value is not one
/// value: the two times it is written are two results.
func anyWritten(ns: Node[]): bool {
    return ns->any<is_written_slot>
}

/// A pure operation the sweep may merge: reading no value that may be written in place, and not
/// one itself.
func mergeableOperation(n: Node): bool {
    return kind(n) == NodeKind::Oper && is_pure(n) && opText(n) != '' && !is_written_slot(n) && !anyWritten(inputs(n)) && !anyWritten(with_inputs(n))
}

/// Whether the two operations are the same computation: the same operator on values of the same
/// type, the same operands in the same order, in the same region, with the same permissions and
/// the same attributes.
func sameOperation(a: Node, b: Node): bool {
    return opText(a) == opText(b) && typeText(a) == typeText(b) && permissions(a) == permissions(b) && tags(a) == tags(b) && region_of(a) == region_of(b) && sameNodes(inputs(a), inputs(b)) && sameNodes(with_inputs(a), with_inputs(b))
}

/// Whether one node may stand for the other in a graph: as a constant of the same value, or as
/// the same operation.
func sameValue(a: Node, b: Node): bool {
    return (mergeableConstant(a) && mergeableConstant(b) && sameConstant(a, b, typeText(a))) || (mergeableOperation(a) && mergeableOperation(b) && sameOperation(a, b))
}

/// The node `n` is replaced by: the first node of its graph that has the same value, or `n`
/// itself when it is the first. That first node is never a node the same round merges away,
/// which is what makes one transaction enough for a round.
func keepOf(ns: Node[], n: Node): Node {
    let earlier = ns->filter<(m: Node): bool => id(m) < id(n) && sameValue(n, m)>
    return if len(earlier) == 0 then n else earlier[0]
}

func isHit(ns: Node[], n: Node): bool {
    return keepOf(ns, n) != n
}

func graphHasHit(g: Graph): bool {
    let ns = nodes(g)
    return ns->any<(n: Node): bool => isHit(ns, n)>
}

func hasHit(p: Program): bool {
    return graphs(p)->any<graphHasHit>
}

func mergeHitsOf(t: Txn, g: Graph): void {
    let ns = nodes(g)
    ns->filter<(n: Node): bool => isHit(ns, n)>->foreach<(n: Node) => replace(t, n, keepOf(ns, n))>
}

func mergeHits(p: Program): Program! sync {
    let t = open(p)
    graphs(p)->foreach<(g: Graph) => mergeHitsOf(t, g)>
    return commit(t)
}

/// Equal values written twice are one node, until none is left.
export func cse(p: Program): Program! {
    return if hasHit(p) then mergeHits(p) ?-> cse else p
}

// ---- dead values ----

/// Whether the node computes a value: a constant, a conversion, a copy, an access, a fill or a
/// pure operation. This is `isValueOnly` of the C++ pass, which the `graph` module reads as the
/// kinds of a node and the declarations of its operator.
func valueOnly(n: Node): bool {
    let k = kind(n)
    return (k == NodeKind::Data && is_constant(n)) || k == NodeKind::Cast || k == NodeKind::Copy || k == NodeKind::Accs || k == NodeKind::Fill || (k == NodeKind::Oper && is_pure(n))
}

/// Whether the node computes a value no node reads. A node that anchors its graph is not one:
/// a transaction refuses to erase it, and the graph would lose its exit.
func deadValue(n: Node): bool {
    return valueOnly(n) && len(value_users(n)) == 0 && !is_anchor(n)
}

func eraseHits(p: Program, hits: Node[]): Program! sync {
    let t = open(p)
    hits->foreach<(n: Node) => erase(t, n)>
    return commit(t)
}

func deadValues(p: Program): Program! sync {
    let hits = allNodes(p)->filter<deadValue>
    return if len(hits) == 0 then p else eraseHits(p, hits) ?-> deadValues
}

/// Values nobody reads are erased, until none is left: the value half of `std::opt::dce`.
export func dce(p: Program): Program! {
    return deadValues(p)
}

// ---- constant folding ----

/// Whether the node is one this pass may put a value in the place of: not one that anchors its
/// graph, and not one whose value may be written in place. In a function graph the returned value
/// is also the graph's exit and output value: the C++ fold replaces it and re-points those anchors
/// (`replaceFoldResult`), and the module's `replace` refuses a node that anchors its graph, so a
/// returned constant expression is left as written here (docs/technical/45_graph_module.md). A
/// value that may be written in place is left too: a constant replacing it would share one object
/// between every run of the graph.
func foldable(n: Node): bool {
    return is_anchor(n) == false && is_written_slot(n) == false
}

/// Whether the node is a pure operation: the one kind of node this pass evaluates. The
/// conversions, copies, accesses and fills the C++ fold also folds are not evaluated here; the
/// `graph` module evaluates an operation (docs/technical/45_graph_module.md).
func operation(n: Node): bool {
    return kind(n) == NodeKind::Oper && is_pure(n)
}

/// Whether every value the node reads is a constant of the graph: what its operator is computed
/// over. An operation that reads nothing is not one: `eval` has nothing to compute it from.
func constantOperands(n: Node): bool {
    let ins = inputs(n)
    return len(ins) > 0 && ins->all<is_constant>
}

/// Whether the round evaluates this node: a pure operation whose operands are all constants. A
/// node the round may not replace is evaluated all the same, because `eval` is what warns about a
/// constant expression that can only fault: the C++ fold evaluates such a node "to tell the user of
/// a constant that faults where it is written" (`generic.cpp`) and leaves it where it is.
func evaluated(n: Node): bool {
    return operation(n) && constantOperands(n)
}

/// The value the round computes for this node, or null when there is nothing to compute or when the
/// expression can only fault — which is left as written and warned about.
func computed(t: Txn, n: Node): Node? {
    let can = evaluated(n)
    return if can then eval(t, n) else null
}

/// Replaces one operation by the value its operator computes; the answer is whether it did.
func foldOne(t: Txn, n: Node): bool sync {
    return match computed(t, n) {
        case null => false
        case v => putValue(t, n, v)
    }
}

/// Puts the value in the place of the node it was computed from, when the node may be replaced at
/// all: a node that anchors its graph is evaluated for the warning and then left as written.
func putValue(t: Txn, n: Node, value: Node): bool sync {
    return if foldable(n) then replaced(t, n, value) else false
}

/// Performs the replacement. The arm of a `match` is a graph of its own, so the edit is a call of
/// its own: a statement inside an arm has nothing that depends on it and does not run.
func replaced(t: Txn, n: Node, value: Node): bool sync {
    replace(t, n, value)
    return true
}

/// One round over the whole program: whether it replaced anything.
func foldRound(t: Txn, hits: Node[]): bool {
    return hits->map<(n: Node): bool => foldOne(t, n)>->any<(did: bool): bool => did>
}

/// The nodes one round evaluates, read off the program the round starts from.
func foldHits(p: Program): Node[] {
    return allNodes(p)->filter<evaluated>
}

/// Commits a round that replaced something. The commit is a function of its own because the round
/// that replaced nothing is not the only outcome: an effect written inside an arm of a `match` or
/// an `if` does not run, so the one branch cannot commit inline while the other abandons.
func committed(t: Txn): Program! sync {
    return commit(t)
}

/// Abandons a transaction: nothing the round did takes effect, and the program is the one the
/// round started from.
func abandoned(t: Txn, p: Program): Program! sync {
    abort(t)
    return p
}

/// Folds round after round until a round replaces nothing, which is the end. A round whose nodes
/// `eval` all refused — a constant expression that can only fault is left as written and warned
/// about — is such a round, and recursing on the program it started from would not stop, so it is
/// abandoned and the program the round started from is the answer.
func foldRounds(p: Program): Program! sync {
    let t = open(p)
    let changed = foldRound(t, foldHits(p))
    return if changed then committed(t) ?-> foldRounds else abandoned(t, p)
}

/// A pure operation whose operands are all constants is the value they compute, until none is
/// left: `opt::fold` against `std::opt::fold` (H227's first layer). A program that holds no node to
/// evaluate at all is answered without opening a transaction.
export func fold(p: Program): Program! {
    return if len(foldHits(p)) > 0 then foldRounds(p) else p
}

