/**
 * The `transpose` ruleset: the transpose (the pullback) of a linear primitive, written where the
 * primitive is (design principles 9.9, program transforms).
 *
 * A transpose rule's right side is "the cotangent of the result => the cotangent of the operand that
 * carries the data", and it is linear in that cotangent: `x + c` passes it through, `x * c` scales
 * it by `c`, and `-x` negates it. The value the primitive was given is a value here, not a constant
 * of the rule, so `mul_t` is also the transpose of `x * 3`.
 *
 * A left side that names two values answers two cotangents, in the order it names them: the right
 * side's value is a tuple of two, and the transform that answers the second name takes the second
 * component. The two answers share nothing -- `x - c` negates one and passes the other through, and
 * `x / c` divides by `c` in one and needs both values in the other -- so each is written once,
 * where its own law is.
 *
 * A rule belongs to the family of the module it is declared in, and to a primitive by the operator
 * of its left side and the number of operands that operator was given. The forward rules of the
 * same primitives are in `rulesets.jvp`: the two left sides are the same text, and a module holds
 * one rule per operator, so the two families live in two modules -- a module does not serve two
 * families, just as it does not serve both a library and a ruleset.
 *
 * Adding a rule changes docs/stdlib-reference.md; regenerate it with
 * `node scripts/stdlib-reference.mjs --write`.
 */

import { is_float } from types
import {
    add_cotangent,
    add_cotangent_c,
    div_cotangent,
    div_cotangent_c,
    mul_cotangent,
    mul_cotangent_c,
    neg_cotangent,
    sub_cotangent,
    sub_cotangent_c,
} from autodiff
import { zeros_like } from tensor
import { mean_axis, numel, ones_like } from tensor

/// The transpose of `x + c`: the cotangent of the sum, of `x` and of `c`.
export rule add_t::<T>(x: T, c: T) when is_float::<T>() {
    x + c => (ct: T) => (add_cotangent(ct), add_cotangent_c(ct))
}

/// The transpose of `x - c`: `ct` for `x`, `-ct` for `c`.
export rule sub_t::<T>(x: T, c: T) when is_float::<T>() {
    x - c => (ct: T) => (sub_cotangent(ct), sub_cotangent_c(ct))
}

/// The transpose of `x * c`: `ct * c` for `x`, `ct * x` for `c`.
export rule mul_t::<T>(x: T, c: T) when is_float::<T>() {
    x * c => (ct: T) => (mul_cotangent(c, ct), mul_cotangent_c(x, ct))
}

/// The transpose of `x / c`: `ct / c` for `x`, `-ct * x / (c * c)` for `c`.
export rule div_t::<T>(x: T, c: T) when is_float::<T>() {
    x / c => (ct: T) => (div_cotangent(c, ct), div_cotangent_c(x, c, ct))
}

/// The transpose of `-x`: `-ct`.
export rule neg_t::<T>(x: T) when is_float::<T>() {
    -x => (ct: T) => neg_cotangent(ct)
}
// ---- the transpose rule of `:op/idx_arr` ----
//
// `ct` goes back to position `i` and every other position is zero: the cotangent of `xs[i]` is that
// one element, written into an array of zeros shaped like `xs`. The write is `:tangent/scatter_add_arr`
// (`base, index, delta[, axis]`); its declaration below is **private to this ruleset** -- the library
// keeps no public name for it, because the only caller is the rule and a public name would be one more
// shape the registry has to hold in step for no other user.
//
// The operator takes three or four operands: `axis` is optional (src/builtin/operators/derivative.cpp#scatterAddArrayVjp)
// and omitting it means the operand's last axis, which is the axis an index of this shape reads.

/// `x[i]`: what `:op/idx_arr` means, and the left side this rule is filed under.
/// @example index_into([1.0, 2.0, 3.0], 2)    // 3.0
func index_into::<T>(x: T[], i: int): T {
    return x[i]
}

/// `xs` with `delta` added at position `i`: the write a transposed read needs. Private to this module.
#op(':tangent/scatter_add_arr')
func scatter_into::<T>(xs: T[], i: int, delta: T): T[]

/// The transpose of `xs[i]`: `ct` at `i`, zero everywhere else.
export rule idx_arr_t::<T>(xs: T[], i: int) {
    index_into(xs, i) => (ct: T) => scatter_into(zeros_like(xs), i, ct)
}

// ---- the transpose of `mean` over an axis ----
//
// `mean(xs, axis, keepdims)` is the spelling of `tensor:mean_axis` that names every parameter in
// parentheses, and it is the one a rule has to use: the operator's other spelling states the axis in
// angle brackets (`mean<axis>(xs)`), and a rule cannot name that position today
// (`stdlib/rulesets/jvp.cml`, the `reshape`/`softmax` pair, says the same thing at the left side).
//
// The law: the lane's mean spreads its cotangent back over exactly the elements it averaged, so
// every position of `xs` that fed lane `k` gets `ct[k] / lane length`. `ones_like(xs)` is the shape
// the broadcast needs, and `numel(xs) / numel(ct)` is the lane length -- the count the average
// divided by, read off the two shapes rather than written down.
//
// The left side names three values, and the transposed walk asks a cotangent of each position that
// wants one: `axis` is an `int` and `keepdims` a `bool`, and neither has a tangent space, so the
// right side answers one value -- for `xs` -- and nothing for the other two
// (`camel/core/tangent_space.h`).

/// The cotangent of a lane-mean: `ct` spread back over the lane it was averaged from.
func mean_axis_cotangent(xs: float[..], ct: float[..]): float[..] {
    let lanes = float(numel(xs)) / float(numel(ct))
    return ones_like(xs) * (ct / lanes)
}

/// The transpose of `mean(xs, axis, keepdims)`: the cotangent spread back over the averaged lane.
export rule mean_axis_t(xs: float[..], axis: int, keepdims: bool) {
    mean_axis(xs, axis, keepdims) => (ct: float[..]) => mean_axis_cotangent(xs, ct)
}
