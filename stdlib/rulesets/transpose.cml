/**
 * The `transpose` ruleset: the transpose (the pullback) of a linear primitive, written where the
 * primitive is (design principles 9.9, program transforms).
 *
 * A transpose rule's right side is "the cotangent of the result => the cotangent of the operand that
 * carries the data", and it is linear in that cotangent: `x + c` passes it through, `x * c` scales
 * it by `c`, and `-x` negates it. The value the primitive was given is a value here, not a constant
 * of the rule, so `mul_t` is also the transpose of `x * 3`.
 *
 * A left side that names two values answers two cotangents, in the order it names them: the right
 * side's value is a tuple of two, and the transform that answers the second name takes the second
 * component. The two answers share nothing -- `x - c` negates one and passes the other through, and
 * `x / c` divides by `c` in one and needs both values in the other -- so each is written once,
 * where its own law is.
 *
 * A rule belongs to the family of the module it is declared in, and to a primitive by the operator
 * of its left side and the number of operands that operator was given. The forward rules of the
 * same primitives are in `rulesets.jvp`: the two left sides are the same text, and a module holds
 * one rule per operator, so the two families live in two modules -- a module does not serve two
 * families, just as it does not serve both a library and a ruleset.
 *
 * Adding a rule changes docs/stdlib-reference.md; regenerate it with
 * `node scripts/stdlib-reference.mjs --write`.
 */

import { is_float, is_same } from types
import {
    add_cotangent,
    add_cotangent_c,
    div_cotangent,
    div_cotangent_c,
    mul_cotangent,
    mul_cotangent_c,
    neg_cotangent,
    sub_cotangent,
    sub_cotangent_c,
} from autodiff
import { full, matmul, mean_axis, numel, ones_like, shape, subtract, sum, sum_to, take, transpose, zeros_like } from tensor

/// The transpose of `x + c`: the cotangent of the sum, of `x` and of `c`.
export rule add_t::<T>(x: T, c: T) when is_float::<T>() {
    x + c => (ct: T) => (add_cotangent(ct), add_cotangent_c(ct))
}

/// The transpose of `x - c`: `ct` for `x`, `-ct` for `c`.
export rule sub_t::<T>(x: T, c: T) when is_float::<T>() {
    x - c => (ct: T) => (sub_cotangent(ct), sub_cotangent_c(ct))
}

/// The transpose of `x * c`: `ct * c` for `x`, `ct * x` for `c`.
export rule mul_t::<T>(x: T, c: T) when is_float::<T>() {
    x * c => (ct: T) => (mul_cotangent(c, ct), mul_cotangent_c(x, ct))
}

/// The transpose of `x / c`: `ct / c` for `x`, `-ct * x / (c * c)` for `c`.
export rule div_t::<T>(x: T, c: T) when is_float::<T>() {
    x / c => (ct: T) => (div_cotangent(c, ct), div_cotangent_c(x, c, ct))
}

/// The transpose of `-x`: `-ct`.
export rule neg_t::<T>(x: T) when is_float::<T>() {
    -x => (ct: T) => neg_cotangent(ct)
}

/// The transpose of `float(x)` where `x` is a double already: the conversion changes nothing, so the
/// cotangent goes back unchanged.
///
/// This is the transpose half of `jvp_dtod` (`stdlib/rulesets/jvp.cml`), and it was missing while the
/// forward half was there: a program that writes `float(...)` around a value that is a double already
/// keeps the conversion as a node, so the pullback met `:op/dtod` where the forward walk met it and
/// found a law, and stopped there with `skip=rule uri=:op/dtod reason=no-rule` -- on the first step of
/// the walk, since the conversion is what the function returns. The family filed laws for the
/// operators in the body and for none of the conversions in front of them.
export rule dtod_t::<T>(x: T) when is_same::<T, float>() {
    float(x) => (ct: T) => ct
}


// ---- the transpose rule of the array product ----
//
// `x * w` on two arrays is `tensor:multiply`, the operator whose key cannot be derived from its
// name -- `*/2` is `:op/mul_d`'s key, and one key holds one rule -- so the core names it in
// `ruleKeyExceptions()` and the family files the key as the call `mul_tensor(x, w)`, declared here
// the way `rulesets.jvp` declares its own: a module cannot read another module's private function.
//
// It is the adjoint of `jvp_mul_tensor`: a product is linear in each operand while the other is a
// known value, so an operand's cotangent is `ct * other`, and the second half of the law is "then
// summed back to the shape the operand states". That second half is not a detail. The operator is
// called with an array and a *number* as well as with two arrays, and the number's cotangent is a
// reduction: the number fed every lane the broadcast spread it over, so its cotangent is the sum
// of what it fed. One law covers both shapes because it names the shape instead of assuming it --
// `sum_to(ct * other, operand)` is the identity when the shapes are equal, and `T[..]` includes
// rank 0, a rank-zero array being that element and nothing else (design principles 5.4), so the
// number's shape is a shape like any other and its reduction is the total sum.
//
// This is one rule and cannot be two: the index tells two rules of one key apart by their `when`
// condition, so a second rule `(T[..], T)` -- no position of which overlaps the shapes above --
// was refused where it was written:
//
//     The rule 'mul_tensor_t' and the rule 'mul_tensor_scalar_t' both have 'mul_tensor' with 2
//     operand(s) as the head of their left side, and one ruleset has one rule per operator.
//
// The shapes differ in the operand list, not in the condition, so no wording of the condition
// lets them share this key; past that the walk asks for one rule per key by name
// (`camel/core/forward.cpp#transposeRuleOf`). Writing the reduction into the law is what makes the
// one rule correct for both shapes, and the sum is the engine's own reduction for the same operand
// (`modules/tensor/ops/vjp.cpp#accumulateOperand`: a tensor operand gets `tensor:sum_to`, a float
// one gets `tensor:sum`) -- read here as one expression rather than as a branch on the type.

/// `x + w` on two arrays: what `tensor:add` means, and the left side this rule is filed under.
func add::<T>(x: T[..], w: T[..]): T[..] when is_float::<T>() {
    return x + w
}

/// The transpose of `x + w` on two arrays: each operand's cotangent is `ct`. A sum is its own
/// adjoint, which is what the engine's own `addVjp` says too (`modules/tensor/ops/elementwise_ops.cpp`:
/// both operands accumulate `dy`).
///
/// It is here because the array product's law is unreachable without it: the product rule's right
/// side is `dx * w + x * dw`, so the linear graph a product's pullback walks holds an array add, and
/// the walk refused there -- `TRANSPOSE ... skip=rule uri=tensor:add reason=unbound` -- before this
/// rule existed. Filed under the call `add(x, w)` for the same reason `mul_tensor` is: the key is
/// the operator's own name, and `+` at two operands is `:op/add_d`'s.
export rule add_tensor_t::<T>(x: T[..], w: T[..]) when is_float::<T>() {
    add(x, w) => (ct: T[..]) => (ct, ct)
}

/// `x * w` on two arrays: what `tensor:multiply` means, and the left side this rule is filed under.
func mul_tensor::<T>(x: T[..], w: T[..]): T[..] when is_float::<T>() {
    return x * w
}

/// The transpose of `x * w`: `ct * w` reduced to `x`'s shape for `x`, `ct * x` reduced to `w`'s
/// shape for `w`. The reduction is the one `sum_to` names, so the law is written once for both
/// shapes the operator is called with -- two arrays, and an array and a number.
export rule mul_tensor_t::<T, X, W>(x: X, w: W) {
    mul_tensor(x, w) => (ct: T[..]) => (sum_to(ct * w, x), sum_to(ct * x, w))
}

/// `x - w` on two arrays: what `tensor:subtract` means, and the left side this rule is filed under.
func subtract::<T>(x: T[..], w: T[..]): T[..] when is_float::<T>() {
    return x - w
}

/// The transpose of `x - w` on two arrays: `ct` for `x`, `-ct` for `w`. It is the mirror of
/// `add_tensor_t` above and the adjoint of `jvp_subtract` (`stdlib/rulesets/jvp.cml`), and it is here
/// because a loss written `pred - target` -- the one line every training step has -- puts this
/// operator in the backward graph between the product's law and the sum's.
export rule subtract_t::<T>(x: T[..], w: T[..]) when is_float::<T>() {
    subtract(x, w) => (ct: T[..]) => (ct, -ct)
}

// ---- the transpose rule of the matrix product ----
//
// A product's cotangent is written with two more products: `a · b` passes `ct · bᵀ` back to `a` and
// `aᵀ · ct` back to `b`. Both are the operator itself, so the law needs no arithmetic of its own and
// no operator the library does not already publish -- the transposition of the *known* operand is
// `tensor:transpose` (the last two axes swapped, `stdlib/signatures/tensor.cml#transpose`), which
// reads a value the cut already carries, not the cotangent. Nothing here asks for a shape: the
// extents are the operands' own, `transpose` carries them through, and `matmul` checks the pair where
// the node is built -- the same place the forward rule's `matmul(da, b)` is checked
// (`stdlib/rulesets/jvp.cml#jvp_matmul`). So the law reads no linear operand's value and needs no
// count of anything: this is the shape the primitives' own declarations already state.
//
// It is the adjoint of `jvp_matmul` and it is filed under the operator's own name, `matmul(a, b)`,
// the way that forward rule is -- the key `tensor:matmul` needs no exception in `ruleKeyExceptions()`
// because the name derives it.
//
// **Every shape `matmul` takes is served, and the shapes are told apart by the cotangent helpers.** A
// vector operand is not the matrix shape with a smaller extent: the product reads a rank-one operand
// as a row or a column and drops that axis from the answer (`modules/tensor/kernels/gemm.cpp#planMatmul`),
// so the cotangent that comes back is a rank-one value where the operand is rank one, and the cotangent
// that goes to the *other* operand is an outer product the matmul cannot write -- the product of a
// rank-one value with a rank-one value is a number. That outer product is what `sum_to` is for, and it
// is written in the two lane orderings the shapes allow:
//
//   * `a` a vector, `b` a matrix: `bᵀ` is (n, k) and both the cotangent of the answer (n) and `a` (k)
//     spread into that shape from the right -- `sum_to(ct, bᵀ) * sum_to(a, bᵀ)` is (n, k) with
//     `ct[i] * a[j]` in it, and the transpose of it is the (k, n) outer product `a ⊗ ct` that goes
//     back to `b`. The shape is `bᵀ`'s own, read from a known operand; no extent is reconstructed.
//   * `a` a matrix, `b` a vector: `a` is (m, k) and the cotangent of the answer (m) spreads along its
//     leading axis while `b` (k) spreads along its last -- `sum_to(ct, a) * sum_to(b, a)` is `ct ⊗ b`.
//
// Both are the same law `matmul` states, read at the rank the operands have; nothing here reads a
// linear operand's value or asks for a count. What the matrix form needs is the reduction
// `sum_to(matmul(ct, bᵀ), a)`: the identity when the shapes agree, and the sum over a batch axis the
// day an operand carries one -- the reduction half of this law, written where it belongs rather than
// left to the day a batch appears.
//
// **The rank dispatch lives in the helpers, because a ruleset files one rule per operator and arity.**
// A second `matmul(a, b)` rule is refused by name (`SemanticDiag::DuplicateRuleForOperator`, 0x03000205:
// the transform would otherwise choose between them by the order they are written in), and a pattern
// cannot name a set of ranks. The head of the instance is type variables for a second reason: the walk
// hands a rule one type per value it can see -- the cotangent's element type, then each operand's own
// type (`ruleCotangent`, `modules/transforms/transpose.cpp`) -- so a head that wrote `T[?, k], T[k, ?]`
// would state *one* shape and be instantiated for all three numbers anyway. `mul_tensor_t` above is
// `<T, X, W>` for the same reason. The shapes are therefore stated by the two cotangent helpers,
// overloaded on the operands' ranks.
//
// What a helper must not do is build a shape: every one of them ends by reading its answer at the
// *known* operand -- `sum_to(..., a)` or `sum_to(..., b)` -- so the extents come from a value the cut
// already carries and a shape is never reconstructed from a count (design principles 5.4, and the
// author's 11:10 note: a shape may be taken from an operand, never read off the linear operand).
// `sum_to` is also where the reduction half of this law lives: for two matrices the call is the
// identity, and it becomes the sum over a batch axis the day an operand has one.
//
// **What is outside the law stops in the helpers, and the walk has a word for it.** Rank three and
// above, and the vector-vector product whose answer is a number, have no overload; the law is chosen,
// its own body has nothing for these operands, and the walk refuses that by name -- the law, the
// operator and the ranks:
//
//     skip=rule-ranks uri=tensor:matmul rule=matmul_t node=6 position=0 ranks=(3, 2) operands=2
//     reason=No matching function found for argument types: <> (float[..], float[3, 2, 2], float[2, 2]).
//
// `rule-ranks` is not `rule-shape`, and the two must not be merged: `rule-shape` means the law's
// *pattern* rejected the operand types and nothing was built, which is where this reading stood while
// the law named its ranks in the pattern (commit `5a2fed990`, when one pattern could serve only one
// shape). A reader fixes those two differently -- widen the pattern, or write the missing shape's law
// -- so they are two words. Until 2026-11-03 the second arrived as `skip=cotangent-needs-a-value`
// carrying this expansion's own sentence, which named a helper instead of the law and said nothing
// about a rank; both sentences below are pinned by
// `test/cases/compile/transforms/matmul_transpose_rank_three.cml`, and the day a batch axis is served
// that case fails and names what replaced them.
//
// The two matrices are also what makes the law checkable: the model it was written for multiplies a
// batch by a weight, both two-dimensional (`test/cases/compile/transforms/matmul_transpose_law.cml`),
// and the vector lanes are read in `matmul_transpose_vector_lhs.cml` and
// `matmul_transpose_vector_rhs.cml`.

/// The cotangent of the left operand, both operands matrices: `ct · bᵀ`, read at `a`'s shape.
func ct_of_a(ct: float[..], a: float[?, ?], b: float[?, ?]): float[?, ?] {
    return sum_to(matmul(ct, transpose(b)), a)
}

/// The cotangent of the left operand when it is a row: `ct · bᵀ` is already its own shape.
func ct_of_a(ct: float[..], a: float[?], b: float[?, ?]): float[?] {
    return sum_to(matmul(ct, transpose(b)), a)
}

/// The cotangent of the left operand when the right one is a column: the outer product `ct ⊗ b`,
/// which is `a`'s shape, read off `a` itself.
func ct_of_a(ct: float[..], a: float[?, ?], b: float[?]): float[?, ?] {
    return sum_to(ct, a) * sum_to(b, a)
}

/// The cotangent of the right operand, both matrices: `aᵀ · ct`, read at `b`'s shape.
func ct_of_b(ct: float[..], a: float[?, ?], b: float[?, ?]): float[?, ?] {
    return sum_to(matmul(transpose(a), ct), b)
}

/// The cotangent of the right operand when the left one is a row: the outer product `a ⊗ ct`, built
/// in `bᵀ`'s lanes and turned round, because a row's cotangent is where the missing axis is.
func ct_of_b(ct: float[..], a: float[?], b: float[?, ?]): float[?, ?] {
    return sum_to(transpose(sum_to(ct, transpose(b)) * sum_to(a, transpose(b))), b)
}

/// The cotangent of the right operand when it is a column: `aᵀ · ct` is already its own shape.
func ct_of_b(ct: float[..], a: float[?, ?], b: float[?]): float[?] {
    return sum_to(matmul(transpose(a), ct), b)
}

// The head takes three type parameters because the walk hands a rule one type per value it can see:
// the cotangent's element type first, then the operands' own types (`modules/transforms/transpose.cpp`
// `ruleCotangent`). `mul_tensor_t` above is written `<T, X, W>` for the same reason. `A` and `B` are
// the operand types whole -- their ranks live in them, which is what the helpers above dispatch on --
// and `T` is only the element type every cotangent here has.
export rule matmul_t::<T, A, B>(a: A, b: B) when is_float::<T>() {
    matmul(a, b) => (ct: T[..]) => (ct_of_a(ct, a, b), ct_of_b(ct, a, b))
}
// ---- the transpose rules of the reductions and the layout ----
//
// A forward rule that answers with the operator itself (`d(sum(xs)) = sum(dxs)`, `rulesets.jvp`)
// leaves the pullback one question: the adjoint of that operator. A sum is linear in the value, so
// its adjoint is the move it makes read backwards -- a reduction's adjoint spreads.
//
// `sum` is the one of these whose pattern can be written, because it is the one whose declaration
// takes a single ordinary argument. What the other three need is described below.

/// `xs` with one number at every element: the shape a reduction's cotangent is spread over. Written
/// as `full` of the operand's own shape so that the spread carries the operand's extents rather than
/// a shape this ruleset would have to reconstruct from the axis.
func spread_like::<T>(xs: T[..], value: T): T[..] when is_float::<T>() {
    return full(shape(xs), value)
}

/// The cotangent of `sum(xs)`: the one number it answers is the sum of every element, so its adjoint
/// gives that number to every element of the operand.
export rule sum_t::<T>(xs: T[..]) when is_float::<T>() {
    sum(xs) => (ct: T) => spread_like(xs, ct)
}

// `mean_axis`, `reshape` and `softmax` have no rule here. Their laws are the adjoints of the moves
// their forward rules make -- a reduction's adjoint spreads a lane's cotangent over the lane, a
// re-reading's adjoint re-reads, and the softmax's Jacobian `diag(y) - y·y^T` is symmetric so it is
// the same matrix in both directions -- but the **pattern** cannot be written: a rule's left side is
// compiled as an ordinary call, and each of the three takes an argument in angle brackets only
// (`stdlib/signatures/tensor.cml`: `mean<axis, keepdims>(t)`, `reshape<dims>(t)`, `softmax<axis>(t)`).
// `mean_axis_t` was written and measured: the transpose walk hands a rule one cotangent per *normal*
// operand, so the rule's second and third parameters were never bound and `transpose` refused the
// operator by name (`skip=arity uri=tensor:mean_axis operands=3`). Making the pullback reach these
// three is the same port-order change `modules/transforms/jvp.cpp` just took, in
// `modules/transforms/transpose.cpp`, plus a spelling for the angle-bracket argument in a rule's two
// sides. It is not a law anybody still has to find.

// ---- the transpose rule of `:op/idx_arr` ----
//
// `ct` goes back to position `i` and every other position is zero: the cotangent of `xs[i]` is that
// one element, written into an array of zeros shaped like `xs`. The write is `:tangent/scatter_add_arr`
// (`base, index, delta[, axis]`); its declaration below is **private to this ruleset** -- the library
// keeps no public name for it, because the only caller is the rule and a public name would be one more
// shape the registry has to hold in step for no other user.
//
// The operator takes three or four operands: `axis` is optional (src/builtin/operators/derivative.cpp#scatterAddArrayVjp)
// and omitting it means the operand's last axis, which is the axis an index of this shape reads.

/// `x[i]`: what `:op/idx_arr` means, and the left side this rule is filed under.
/// @example index_into([1.0, 2.0, 3.0], 2)    // 3.0
func index_into::<T>(x: T[], i: int): T {
    return x[i]
}

/// `xs` with `delta` added at position `i`: the write a transposed read needs. Private to this module.
#op(':tangent/scatter_add_arr')
func scatter_into::<T>(xs: T[], i: int, delta: T): T[]

/// The transpose of `xs[i]`: `ct` at `i`, zero everywhere else.
export rule idx_arr_t::<T>(xs: T[], i: int) {
    index_into(xs, i) => (ct: T) => scatter_into(zeros_like(xs), i, ct)
}

// ---- the transpose rule of `tensor:take` ----
//
// A take picks rows, so its adjoint puts each row's cotangent back where that row came from and
// sums where an index repeats -- `take(t, [1, 1])` reads one row twice, and its cotangent is the sum
// of the two. The write is `:tangent/scatter_take_arr(base, indices, delta[, axis])`
// (src/builtin/operators/derivative.cpp): the core's scatter for a read along a named axis, whose
// own gradient is the take back along the same axis -- which is why it is the adjoint and not a
// second implementation of one.
//
// The engine's own route names `tensor:take_grad` for this (modules/tensor/ops/layout_ops.cpp
// #takeVjp), and a ruleset cannot: that operator is declared by the tensor module, and a second
// declaration of it is refused by name ("The declaration 'take_into' names the operator
// 'tensor:take_grad', which another module declares"). `:tangent/scatter_take_arr` is the core's,
// so it can be declared here, privately, like `scatter_into` above.

/// `take(t, indices)`'s adjoint: `dy` added back at the rows the indices name, along the first axis.
#op(':tangent/scatter_take_arr')
func scatter_rows::<T>(xs: T[..], indices: int[], delta: T[..], axis: int): T[..]

/// The transpose of `take(t, indices)`: the indices are an `int[..]` and take no cotangent, so the
/// rule's right side reads one -- and it needs `t` only for the shape the cotangent goes back into,
/// which is why the value is read and not just the cotangent. The axis is `0` because that is the
/// axis `take` reads (`tensor:take` names its first dimension).
export rule take_t::<T>(t: T[..], indices: int[]) {
    take(t, indices) => (ct: T[..]) => scatter_rows(zeros_like(t), indices, ct, 0)
}

// ---- the transpose of `mean` over an axis ----
//
// `mean(xs, axis, keepdims)` is the spelling of `tensor:mean_axis` that names every parameter in
// parentheses, and it is the one a rule has to use: the operator's other spelling states the axis in
// angle brackets (`mean<axis>(xs)`), and a rule cannot name that position today
// (`stdlib/rulesets/jvp.cml`, the `reshape`/`softmax` pair, says the same thing at the left side).
//
// The law: the lane's mean spreads its cotangent back over exactly the elements it averaged, so
// every position of `xs` that fed lane `k` gets `ct[k] / lane length`. `ones_like(xs)` is the shape
// the broadcast needs, and `numel(xs) / numel(ct)` is the lane length -- the count the average
// divided by, read off the two shapes rather than written down.
//
// The left side names three values, and the transposed walk asks a cotangent of each position that
// wants one: `axis` is an `int` and `keepdims` a `bool`, and neither has a tangent space, so the
// right side answers one value -- for `xs` -- and nothing for the other two
// (`camel/core/tangent_space.h`).

/// The cotangent of a lane-mean: `ct` spread back over the lane it was averaged from.
func mean_axis_cotangent::<T>(xs: T[..], ct: T[..]): T[..] when is_float::<T>() {
    let lanes = float(numel(xs)) / float(numel(ct))
    return ones_like(xs) * (ct / lanes)
}

/// The transpose of `mean(xs, axis, keepdims)`: the cotangent spread back over the averaged lane.
export rule mean_axis_t::<T>(xs: T[..], axis: int, keepdims: bool) when is_float::<T>() {
    mean_axis(xs, axis, keepdims) => (ct: float[..]) => mean_axis_cotangent(xs, ct)
}
