/**
 * The standard rules of arithmetic (rewrite design 7): the ones that hold bit for bit, for the
 * integers and for the floats, written as rules. `check_rules.cml`-style checking runs over every
 * one of them (the plan modules.rules_library): no rule enters this file before it passes.
 *
 * `simplify` applies the rules that always make an expression smaller, one way, to a fixpoint;
 * `saturate_all` adds the rules that rearrange (commutation, association, distribution) to the
 * saturation and extracts the smallest writing of each value.
 *
 * A rule is a `Rule` value, so a rule set is an ordinary `Rule[]`. The scheduling combinators at
 * the end compose rule sets without new syntax (rewrite design 2 (second version) 8.5): `seq` runs
 * the stages in the written order once each, `first` takes the first stage that rewrites
 * something, `repeat` applies one round at a time to a fixpoint, `until` stops on a predicate of
 * the program, and `alternate` alternates two stages until a full pair changes nothing. Each
 * answers the program and what the application cost.
 */
module rules
import { Program, Node, constant } from graph
import { abs, trunc } from math
import { Rule, Run, rewrite, saturate, extract, run } from rewrite
import { Tensor, exp, log, log_softmax, sigmoid, softmax, sum } from tensor

// ---- Integers: wrapping arithmetic, every law is exact ----

export rule int_add_zero(x: int) { x + 0 => x }
export rule int_zero_add(x: int) { 0 + x => x }
export rule int_sub_zero(x: int) { x - 0 => x }
export rule int_mul_one(x: int) { x * 1 => x }
export rule int_one_mul(x: int) { 1 * x => x }
export rule int_mul_zero(x: int) { x * 0 => 0 }
export rule int_zero_mul(x: int) { 0 * x => 0 }
export rule int_div_one(x: int) { x / 1 => x }
export rule int_neg_neg(x: int) { -(-x) => x }
export rule int_sub_self(x: int) { x - x => 0 }
export rule int_add_self(x: int) { x + x => x * 2 }
export rule int_combine(x: int, const c1: int, const c2: int) { x * c1 + x * c2 => x * (c1 + c2) }
export rule int_fold(x: int, const c1: int, const c2: int) { (x * c1) * c2 => x * (c1 * c2) }
export rule int_fold_add(x: int, const c1: int, const c2: int) { (x + c1) + c2 => x + (c1 + c2) }

/// The bare operand: `x*c + x` is `x*c + x*1`. No rule can write `1*x` (a rule matches the graph
/// it is given, it cannot add a multiplication to read a coefficient), so the coefficient 1 is
/// implicit here. The law wraps exactly like `int_combine`, so it needs no permission and the
/// guard set is the same one (none): the rule only adds the `1` that the pass would read.
export rule int_combine_one(x: int, const c: int) { x * c + x => x * (c + 1) }
export rule int_one_combine(x: int, const c: int) { x + x * c => x * (1 + c) }

export rule int_add_comm(a: int, b: int) { a + b <=> b + a }
export rule int_mul_comm(a: int, b: int) { a * b <=> b * a }
export rule int_add_assoc(a: int, b: int, c: int) { (a + b) + c <=> a + (b + c) }
export rule int_mul_assoc(a: int, b: int, c: int) { (a * b) * c <=> a * (b * c) }
export rule int_distribute(a: int, b: int, c: int) { a * (b + c) <=> a * b + a * c }

// ---- Int32: the same wrapping laws at 32 bits ----
//
// The language has two integer element types, and a rule is written for one of them: the pattern
// operators are the typed ones (`add_i`, `mul_i`, ...), so these rules never match an `int`
// expression and the `int` rules above never match an `i32` one. The laws are the same because
// two's-complement wraparound is a ring: the neutral elements, the inverse laws, association,
// commutation and distribution are all exact. Only the constant-folded coefficients differ: the
// rule's `c1 + c2` (or `c1 * c2`) is an i32 operation and wraps exactly as the program does.
//
// A coefficient the rule reads must be an i32 too. `constant` compares type codes, so a constant
// of another type reads as null; the guards below keep a malformed graph (an `add_i` with an
// `int` constant) from matching, mirroring algebra.cpp's typed scalar constant lookup.

/// Whether the matched constant has the i32 element type.
func isI32(c: Node): bool {
    return match constant(c, i32(0)) {
        case null => false
        case _ => true
    }
}

export rule int32_add_zero(x: i32) { x + 0 => x }
export rule int32_zero_add(x: i32) { 0 + x => x }
export rule int32_sub_zero(x: i32) { x - 0 => x }
export rule int32_mul_one(x: i32) { x * 1 => x }
export rule int32_one_mul(x: i32) { 1 * x => x }
export rule int32_mul_zero(x: i32) { x * 0 => i32(0) }
export rule int32_zero_mul(x: i32) { 0 * x => i32(0) }
export rule int32_div_one(x: i32) { x / 1 => x }
export rule int32_neg_neg(x: i32) { -(-x) => x }
export rule int32_sub_self(x: i32) { x - x => i32(0) }
export rule int32_add_self(x: i32) { x + x => x * 2 }
export rule int32_combine(x: i32, const c1: i32, const c2: i32) {
    x * c1 + x * c2 => x * (c1 + c2)
} when isI32(c1) && isI32(c2)
export rule int32_fold(x: i32, const c1: i32, const c2: i32) {
    (x * c1) * c2 => x * (c1 * c2)
} when isI32(c1) && isI32(c2)
export rule int32_fold_add(x: i32, const c1: i32, const c2: i32) {
    (x + c1) + c2 => x + (c1 + c2)
} when isI32(c1) && isI32(c2)

/// The bare operand laws, as `int_combine_one` explains. The coefficient is read as an i32 (the
/// pattern is typed by the i32 operators), and `c + 1` wraps in i32 exactly as the program would.
export rule int32_combine_one(x: i32, const c: i32) { x * c + x => x * (c + 1) }
export rule int32_one_combine(x: i32, const c: i32) { x + x * c => x * (1 + c) }

export rule int32_add_comm(a: i32, b: i32) { a + b <=> b + a }
export rule int32_mul_comm(a: i32, b: i32) { a * b <=> b * a }
export rule int32_add_assoc(a: i32, b: i32, c: i32) { (a + b) + c <=> a + (b + c) }
export rule int32_mul_assoc(a: i32, b: i32, c: i32) { (a * b) * c <=> a * (b * c) }
export rule int32_distribute(a: i32, b: i32, c: i32) { a * (b + c) <=> a * b + a * c }

// ---- Floats: only what rounding does not touch ----

export rule float_mul_one(x: float) { x * 1.0 => x }
export rule float_one_mul(x: float) { 1.0 * x => x }
export rule float_add_minus_zero(x: float) { x + -0.0 => x }
export rule float_sub_zero(x: float) { x - 0.0 => x }
export rule float_div_one(x: float) { x / 1.0 => x }
export rule float_neg_neg(x: float) { -(-x) => x }

/// `x + x => x * 2.0`: doubling is exact in IEEE arithmetic for every value, including the
/// infinities, the NaNs and the subnormals (the exponent grows by one, the significand is
/// unchanged), so the law needs no permission.
export rule float_add_self(x: float) { x + x => x * 2.0 }

export rule float_add_comm(a: float, b: float) { a + b <=> b + a }
export rule float_mul_comm(a: float, b: float) { a * b <=> b * a }

// ---- Floats: the laws a numeric permission allows (design principles 7.2-7.4) ----
//
// A rule that changes the rounding path needs the permission for it, and the check compares its
// two sides with the error bound of that permission (camel/core/operator_semantics.h,
// rewriteErrorBound). The conditions read the matched constants from the draft: the coefficients
// decide which permission the law really needs.

/// Whether a value is finite: NaN and the infinities are the only values that are not equal to
/// themselves after a subtraction.
func finiteValue(x: float): bool {
    return x - x == 0.0
}

/// Whether a number is one the f32 element type holds exactly. The tensor coefficients are
/// written as plain numbers (f64); the guard reads one of them and this is what makes the
/// reading exact: `f32(v) == v` compares the rounded f32 with the original, so it holds only for
/// the values f32 represents (the infinities are excluded by `finiteValue`).
func exactIn32(v: float): bool {
    return finiteValue(v) && float(f32(v)) == v
}

/// `x*c1 + x*c2 => x*(c1+c2)` with two finite, nonzero coefficients of the same sign: the
/// reassociation changes rounding only, so the default `reassociate` grant suffices.
func combineSameSign(c1: Node, c2: Node): bool {
    return match constant(c1, 0.0) {
        case null => false
        case a => match constant(c2, 0.0) {
            case null => false
            case b => finiteValue(a) && finiteValue(b) && a != 0.0 && b != 0.0 &&
                          (a > 0.0) == (b > 0.0) && finiteValue(a + b)
        }
    }
}

/// The opposite-sign case: cancellation can turn an infinity into a finite value or lose the
/// sign of a zero, so the rule also needs the assumptions that rule those out. A sum of zero
/// (the coefficients cancel) is left alone: the rewrite would only change the sign of the zero.
func combineMixedSign(c1: Node, c2: Node): bool {
    return match constant(c1, 0.0) {
        case null => false
        case a => match constant(c2, 0.0) {
            case null => false
            case b => finiteValue(a) && finiteValue(b) && a != 0.0 && b != 0.0 &&
                          (a > 0.0) != (b > 0.0) && a + b != 0.0
        }
    }
}

/// `(x*c1)*c2 => x*(c1*c2)`: both coefficients finite and nonzero, and their product finite and
/// nonzero. The product is the new coefficient: an overflowing product would become an infinity
/// (the rewrite then computes `x*inf`), and one that underflows to zero would erase the term.
/// Removing the intermediate product may remove an overflow, which `no_infs` allows.
func foldCoefficients(c1: Node, c2: Node): bool {
    return match constant(c1, 0.0) {
        case null => false
        case a => match constant(c2, 0.0) {
            case null => false
            case b => finiteValue(a) && finiteValue(b) && a != 0.0 && b != 0.0 &&
                          finiteValue(a * b) && a * b != 0.0
        }
    }
}

/// `x*c + x*c => x*(2c)` is exact when `c` is a finite integer with `1 <= |c| <= 2^52`: doubling
/// a rounded product commutes with rounding there, and `2c` is exactly representable. The rule
/// therefore needs no permission at all; the condition is what makes that true.
func exactDoubling(c: Node): bool {
    return match constant(c, 0.0) {
        case null => false
        case v => finiteValue(v) && abs(v) >= 1.0 && trunc(v) == v &&
                      abs(v) <= 4503599627370496.0
    }
}

/// The bare term in `x*c + x => x*(c+1)`: the same two conditions as `combineSameSign` and
/// `combineMixedSign` read at the implicit second coefficient `1`. Same sign means `c > 0`;
/// opposite sign means `c < 0`, and `c == -1` (the coefficients cancel) stays as it is. The
/// doubled rounding of the sum and of `c + 1` is the same reassociation the two-product law
/// makes, so the permission set does not change.
func combineOneSameSign(c: Node): bool {
    return match constant(c, 0.0) {
        case null => false
        case a => finiteValue(a) && a != 0.0 && a > 0.0 && finiteValue(a + 1.0)
    }
}

func combineOneMixedSign(c: Node): bool {
    return match constant(c, 0.0) {
        case null => false
        case a => finiteValue(a) && a != 0.0 && a < 0.0 && a + 1.0 != 0.0
    }
}

#requires<reassociate>
export rule float_combine(x: float, const c1: float, const c2: float) {
    x * c1 + x * c2 => x * (c1 + c2)
} when combineSameSign(c1, c2)

#requires<reassociate, no_infs, no_signed_zeros>
export rule float_combine_mixed(x: float, const c1: float, const c2: float) {
    x * c1 + x * c2 => x * (c1 + c2)
} when combineMixedSign(c1, c2)

#requires<reassociate, no_infs>
export rule float_fold(x: float, const c1: float, const c2: float) {
    (x * c1) * c2 => x * (c1 * c2)
} when foldCoefficients(c1, c2)

export rule float_double(x: float, const c: float) {
    x * c + x * c => x * (c + c)
} when exactDoubling(c)

/// The bare operand, in both orders; `combineOneSameSign`/`combineOneMixedSign` say why the
/// permission set is the `combine` one.
#requires<reassociate>
export rule float_combine_one(x: float, const c: float) {
    x * c + x => x * (c + 1.0)
} when combineOneSameSign(c)

#requires<reassociate, no_infs, no_signed_zeros>
export rule float_combine_one_mixed(x: float, const c: float) {
    x * c + x => x * (c + 1.0)
} when combineOneMixedSign(c)

#requires<reassociate>
export rule float_one_combine(x: float, const c: float) {
    x + x * c => x * (1.0 + c)
} when combineOneSameSign(c)

#requires<reassociate, no_infs, no_signed_zeros>
export rule float_one_combine_mixed(x: float, const c: float) {
    x + x * c => x * (1.0 + c)
} when combineOneMixedSign(c)

// ---- Float32: the float laws at 32 bits ----
//
// The same laws as the float ones, and the same distinction: the exact ones need no permission,
// the ones that change rounding need the numeric permission that allows it. The guards are
// separate functions because `constant` compares type codes: reading an f32 constant with the
// float sample `0.0` returns null and the rule would silently never fire.

func finite32(x: f32): bool {
    return x - x == 0.0
}

func combineSameSign32(c1: Node, c2: Node): bool {
    return match constant(c1, f32(0.0)) {
        case null => false
        case a => match constant(c2, f32(0.0)) {
            case null => false
            case b => finite32(a) && finite32(b) && a != 0.0 && b != 0.0 &&
                          (a > 0.0) == (b > 0.0) && finite32(a + b)
        }
    }
}

func combineMixedSign32(c1: Node, c2: Node): bool {
    return match constant(c1, f32(0.0)) {
        case null => false
        case a => match constant(c2, f32(0.0)) {
            case null => false
            case b => finite32(a) && finite32(b) && a != 0.0 && b != 0.0 &&
                          (a > 0.0) != (b > 0.0) && a + b != 0.0
        }
    }
}

func foldCoefficients32(c1: Node, c2: Node): bool {
    return match constant(c1, f32(0.0)) {
        case null => false
        case a => match constant(c2, f32(0.0)) {
            case null => false
            case b => finite32(a) && finite32(b) && a != 0.0 && b != 0.0 &&
                          finite32(a * b) && a * b != 0.0
        }
    }
}

/// `x*c + x*c => x*(2c)` is exact when `c` is a finite integer with `1 <= |c| <= 2^23`: doubling
/// a rounded product commutes with rounding there, and `2c` is exactly representable.
func exactDoubling32(c: Node): bool {
    return match constant(c, f32(0.0)) {
        case null => false
        case v => finite32(v) && abs(v) >= 1.0 && trunc(v) == v && abs(v) <= 8388608.0
    }
}

/// The bare term at 32 bits, as `combineOneSameSign` explains. The sum `c + 1` rounds in f32,
/// which is what `finite32` reads; no exactness beyond `finite32` is needed, exactly as in
/// `float32_combine`.
func combineOneSameSign32(c: Node): bool {
    return match constant(c, f32(0.0)) {
        case null => false
        case a => finite32(a) && a != 0.0 && a > 0.0 && finite32(a + 1.0)
    }
}

func combineOneMixedSign32(c: Node): bool {
    return match constant(c, f32(0.0)) {
        case null => false
        case a => finite32(a) && a != 0.0 && a < 0.0 && a + 1.0 != 0.0
    }
}

export rule float32_mul_one(x: f32) { x * 1.0 => x }
export rule float32_one_mul(x: f32) { 1.0 * x => x }
export rule float32_add_minus_zero(x: f32) { x + -0.0 => x }
export rule float32_sub_zero(x: f32) { x - 0.0 => x }
export rule float32_div_one(x: f32) { x / 1.0 => x }
export rule float32_neg_neg(x: f32) { -(-x) => x }

/// The f32 `x + x => x * 2.0`, exact for the same reason.
export rule float32_add_self(x: f32) { x + x => x * 2.0 }

export rule float32_add_comm(a: f32, b: f32) { a + b <=> b + a }
export rule float32_mul_comm(a: f32, b: f32) { a * b <=> b * a }

#requires<reassociate>
export rule float32_combine(x: f32, const c1: f32, const c2: f32) {
    x * c1 + x * c2 => x * (c1 + c2)
} when combineSameSign32(c1, c2)

#requires<reassociate, no_infs, no_signed_zeros>
export rule float32_combine_mixed(x: f32, const c1: f32, const c2: f32) {
    x * c1 + x * c2 => x * (c1 + c2)
} when combineMixedSign32(c1, c2)

#requires<reassociate, no_infs>
export rule float32_fold(x: f32, const c1: f32, const c2: f32) {
    (x * c1) * c2 => x * (c1 * c2)
} when foldCoefficients32(c1, c2)

export rule float32_double(x: f32, const c: f32) {
    x * c + x * c => x * (c + c)
} when exactDoubling32(c)

/// The bare operand at 32 bits, in both orders; the permission set is `combine`'s.
#requires<reassociate>
export rule float32_combine_one(x: f32, const c: f32) {
    x * c + x => x * (c + 1.0)
} when combineOneSameSign32(c)

#requires<reassociate, no_infs, no_signed_zeros>
export rule float32_combine_one_mixed(x: f32, const c: f32) {
    x * c + x => x * (c + 1.0)
} when combineOneMixedSign32(c)

#requires<reassociate>
export rule float32_one_combine(x: f32, const c: f32) {
    x + x * c => x * (1.0 + c)
} when combineOneSameSign32(c)

#requires<reassociate, no_infs, no_signed_zeros>
export rule float32_one_combine_mixed(x: f32, const c: f32) {
    x + x * c => x * (1.0 + c)
} when combineOneMixedSign32(c)

// ---- Tensors: the elementwise laws of the f32 element type ----
//
// The elementwise tensor operators declare their laws once for float32 elements (`add`,
// `subtract`, `multiply` in modules/tensor/ops/semantics.cpp: neutral elements, `multiply`
// distributing over `add`), and those are the laws below. Two things make the tensor case
// different from the scalar one, and both are visible in every rule here:
//
// 1. **The operator id does not carry the element type.** `tensor:add` is addition for f32, i64
//    and bool elements alike, so a rule must also say which type it is about. The pattern types
//    are `Tensor<f32>`, and the matcher requires the type of a pattern term to accept the type of
//    the node it matches (`acceptsType` in src/runtime/writings.cpp); a `Tensor<i64>` expression
//    therefore never matches these rules, whose rounding argument is f32's. A `Tensor<f32, [3]>`
//    still matches: a less informed type is assignable from a more informed one.
// 2. **The coefficients are plain numbers, not f32.** The tensor operators take any numeric
//    scalar (registry.cpp, `ParamKind::TensorOrScalar`), so `x * 3.0` has an f64 constant, while
//    the element type is f32. Each guard reads that constant with the `float` sample and requires
//    it to be *exactly representable in f32* (`exactIn32`): reading a coefficient that f32 rounds
//    would rewrite `x * 0.1` as if its coefficient were f32(0.1), which is the bug `algebra.cpp`
//    avoids with its `exactIn<float>` lookup. The rule's own coefficient arithmetic (`c1 + c2`,
//    `c1 * c2`, `c + 1`) runs in f64 and the kernel converts the result to f32 once; the f64
//    result of a sum/product of two f32-exact values is exact, so that one conversion is the
//    correctly rounded f32 operation the program would perform (Gosper: 53 >= 2*24 + 2 bits).
//
// The guards mirror algebra.cpp's constant reading and the element f32 guards one for one; the
// permission sets are the element families' (reassociate for a regrouping, plus the assumptions a
// cancellation needs). What a tensor law cannot do is the `x*0`/`x-x` family: an f32 zero
// *tensor* cannot be written in a rule (the program has no tensor constant of the right shape),
// and a rule's replacement is what it writes. Those laws stay in `algebra.cpp` only because a
// zero tensor of the matched shape cannot be written -- a rule reports it as a question, it does
// not weaken `x*0 => 0` into a shape-dependent claim.

/// `x*c1 + x*c2 => x*(c1+c2)` for f32 elements: both coefficients exactly f32, finite, nonzero,
/// the same sign, and the f32 sum finite. The sum is computed in f64 and rounded to f32 by the
/// kernel, which is the same value f32 addition gives.
func tensorCombineSameSign(c1: Node, c2: Node): bool {
    return match constant(c1, 0.0) {
        case null => false
        case a => match constant(c2, 0.0) {
            case null => false
            case b => exactIn32(a) && exactIn32(b) && a != 0.0 && b != 0.0 &&
                          (a > 0.0) == (b > 0.0) && finite32(f32(a + b))
        }
    }
}

func tensorCombineMixedSign(c1: Node, c2: Node): bool {
    return match constant(c1, 0.0) {
        case null => false
        case a => match constant(c2, 0.0) {
            case null => false
            case b => exactIn32(a) && exactIn32(b) && a != 0.0 && b != 0.0 &&
                          (a > 0.0) != (b > 0.0) && a + b != 0.0 && finite32(f32(a + b))
        }
    }
}

func tensorFoldCoefficients(c1: Node, c2: Node): bool {
    return match constant(c1, 0.0) {
        case null => false
        case a => match constant(c2, 0.0) {
            case null => false
            case b => exactIn32(a) && exactIn32(b) && a != 0.0 && b != 0.0 &&
                          finite32(f32(a * b)) && f32(a * b) != 0.0
        }
    }
}

func tensorExactDoubling(c: Node): bool {
    return match constant(c, 0.0) {
        case null => false
        case v => exactIn32(v) && abs(v) >= 1.0 && trunc(v) == v && abs(v) <= 8388608.0
    }
}

func tensorCombineOneSameSign(c: Node): bool {
    return match constant(c, 0.0) {
        case null => false
        case a => exactIn32(a) && a != 0.0 && a > 0.0 && finite32(f32(a + 1.0))
    }
}

func tensorCombineOneMixedSign(c: Node): bool {
    return match constant(c, 0.0) {
        case null => false
        case a => exactIn32(a) && a != 0.0 && a < 0.0 && a + 1.0 != 0.0 &&
                      finite32(f32(a + 1.0))
    }
}

export rule tensor_f32_mul_one(x: Tensor<f32>) { x * 1.0 => x }
export rule tensor_f32_one_mul(x: Tensor<f32>) { 1.0 * x => x }
export rule tensor_f32_add_minus_zero(x: Tensor<f32>) { x + -0.0 => x }
export rule tensor_f32_sub_zero(x: Tensor<f32>) { x - 0.0 => x }
export rule tensor_f32_div_one(x: Tensor<f32>) { x / 1.0 => x }
export rule tensor_f32_neg_neg(x: Tensor<f32>) { -(-x) => x }

/// `t + t => t * 2.0`: exactly the f32 doubling, elementwise.
export rule tensor_f32_add_self(x: Tensor<f32>) { x + x => x * 2.0 }

#requires<reassociate>
export rule tensor_f32_combine(x: Tensor<f32>, const c1: float, const c2: float) {
    x * c1 + x * c2 => x * (c1 + c2)
} when tensorCombineSameSign(c1, c2)

#requires<reassociate, no_infs, no_signed_zeros>
export rule tensor_f32_combine_mixed(x: Tensor<f32>, const c1: float, const c2: float) {
    x * c1 + x * c2 => x * (c1 + c2)
} when tensorCombineMixedSign(c1, c2)

#requires<reassociate, no_infs>
export rule tensor_f32_fold(x: Tensor<f32>, const c1: float, const c2: float) {
    (x * c1) * c2 => x * (c1 * c2)
} when tensorFoldCoefficients(c1, c2)

export rule tensor_f32_double(x: Tensor<f32>, const c: float) {
    x * c + x * c => x * (c + c)
} when tensorExactDoubling(c)

/// The bare operand: `t*c + t` is `t*c + t*1.0`, the same law and the same permission as
/// `tensor_f32_combine`, with the coefficient 1 implicit (the element families' `*_combine_one`).
#requires<reassociate>
export rule tensor_f32_combine_one(x: Tensor<f32>, const c: float) {
    x * c + x => x * (c + 1.0)
} when tensorCombineOneSameSign(c)

#requires<reassociate, no_infs, no_signed_zeros>
export rule tensor_f32_combine_one_mixed(x: Tensor<f32>, const c: float) {
    x * c + x => x * (c + 1.0)
} when tensorCombineOneMixedSign(c)

#requires<reassociate>
export rule tensor_f32_one_combine(x: Tensor<f32>, const c: float) {
    x + x * c => x * (1.0 + c)
} when tensorCombineOneSameSign(c)

#requires<reassociate, no_infs, no_signed_zeros>
export rule tensor_f32_one_combine_mixed(x: Tensor<f32>, const c: float) {
    x + x * c => x * (1.0 + c)
} when tensorCombineOneMixedSign(c)

/// `a*(b+c) <=> a*b + a*c`, elementwise and with the same broadcasting on both sides. It grows
/// a writing (an add becomes two products), so it belongs to the saturation, not to `simplify`.
///
/// It is an i64 law only: for f32 it is not a law under any permission the design grants, because
/// the products may overflow where the sum does not (`a*(b+c)` is 0 where `a*b + a*c` is
/// `inf + -inf`, a NaN). The element library has no float distribute either, for the same reason,
/// and `algebra.cpp` has none at all.
#requires<reassociate>
export rule tensor_i64_distribute(a: Tensor<int>, b: Tensor<int>, c: Tensor<int>) {
    a * (b + c) <=> a * b + a * c
}

/// The rules that make an expression smaller, applied one way to a fixpoint, under the numeric
/// policy of the pass. `tensor_i64_distribute` is not here: it grows a writing, and `simplify`
/// only takes steps that make one smaller.
func simplifyWith(p: Program, strict: bool): Program! {
    return rewrite(p, [
        int_add_zero, int_zero_add, int_sub_zero, int_mul_one, int_one_mul, int_mul_zero,
        int_zero_mul, int_div_one, int_neg_neg, int_sub_self, int_combine, int_fold,
        int_fold_add, int_add_self, int_combine_one, int_one_combine,
        int32_add_zero, int32_zero_add, int32_sub_zero, int32_mul_one, int32_one_mul,
        int32_mul_zero, int32_zero_mul, int32_div_one, int32_neg_neg, int32_sub_self,
        int32_combine, int32_fold, int32_fold_add, int32_add_self, int32_combine_one,
        int32_one_combine,
        float_mul_one, float_one_mul, float_add_minus_zero, float_sub_zero, float_div_one,
        float_neg_neg, float_combine, float_combine_mixed, float_fold, float_double,
        float_add_self, float_combine_one, float_combine_one_mixed, float_one_combine,
        float_one_combine_mixed,
        float32_mul_one, float32_one_mul, float32_add_minus_zero, float32_sub_zero,
        float32_div_one, float32_neg_neg, float32_combine, float32_combine_mixed, float32_fold,
        float32_double, float32_add_self, float32_combine_one, float32_combine_one_mixed,
        float32_one_combine, float32_one_combine_mixed,
        tensor_f32_mul_one, tensor_f32_one_mul, tensor_f32_add_minus_zero, tensor_f32_sub_zero,
        tensor_f32_div_one, tensor_f32_neg_neg, tensor_f32_add_self, tensor_f32_combine,
        tensor_f32_combine_mixed, tensor_f32_fold, tensor_f32_double, tensor_f32_combine_one,
        tensor_f32_combine_one_mixed, tensor_f32_one_combine, tensor_f32_one_combine_mixed,
    ], strict)
}

export func simplify(p: Program): Program! {
    return simplifyWith(p, false)
}

/// The same laws under the strict numeric policy (design principles 7.4, 7.5): the pass grants no
/// permission, as `std::opt(safe_fp=true)` does, so only the laws that need none fire.
export func simplify_strict(p: Program): Program! {
    return simplifyWith(p, true)
}

/// Every rule, both ways where it holds both ways; the smallest writing of each value, under the
/// numeric policy of the pass.
func saturateWith(p: Program, strict: bool): Program! {
    let tabled = saturate(p, [
        int_add_zero, int_zero_add, int_sub_zero, int_mul_one, int_one_mul, int_mul_zero,
        int_zero_mul, int_div_one, int_neg_neg, int_sub_self, int_combine, int_fold,
        int_fold_add, int_add_self, int_combine_one, int_one_combine, int_add_comm,
        int_mul_comm, int_add_assoc, int_mul_assoc, int_distribute,
        int32_add_zero, int32_zero_add, int32_sub_zero, int32_mul_one, int32_one_mul,
        int32_mul_zero, int32_zero_mul, int32_div_one, int32_neg_neg, int32_sub_self,
        int32_combine, int32_fold, int32_fold_add, int32_add_self, int32_combine_one,
        int32_one_combine, int32_add_comm, int32_mul_comm, int32_add_assoc, int32_mul_assoc,
        int32_distribute,
        float_mul_one, float_one_mul, float_add_minus_zero, float_sub_zero, float_div_one,
        float_neg_neg, float_add_comm, float_mul_comm, float_combine, float_combine_mixed,
        float_fold, float_double, float_add_self, float_combine_one, float_combine_one_mixed,
        float_one_combine, float_one_combine_mixed,
        float32_mul_one, float32_one_mul, float32_add_minus_zero, float32_sub_zero,
        float32_div_one, float32_neg_neg, float32_add_comm, float32_mul_comm, float32_combine,
        float32_combine_mixed, float32_fold, float32_double, float32_add_self,
        float32_combine_one, float32_combine_one_mixed, float32_one_combine,
        float32_one_combine_mixed,
        tensor_f32_mul_one, tensor_f32_one_mul, tensor_f32_add_minus_zero, tensor_f32_sub_zero,
        tensor_f32_div_one, tensor_f32_neg_neg, tensor_f32_add_self, tensor_f32_combine,
        tensor_f32_combine_mixed, tensor_f32_fold, tensor_f32_double, tensor_f32_combine_one,
        tensor_f32_combine_one_mixed, tensor_f32_one_combine, tensor_f32_one_combine_mixed,
        tensor_i64_distribute,
    ], 6, strict)
    return match tabled {
        case error e => tabled
        case q => extract(q, 'nodes')
    }
}

export func saturate_all(p: Program): Program! {
    return saturateWith(p, false)
}

/// The saturation under the strict numeric policy, as `simplify_strict` is the simplification.
export func saturate_all_strict(p: Program): Program! {
    return saturateWith(p, true)
}

// ---- scheduling rule sets (rewrite design 2 (second version) 8.5) ----
//
// A stage is a `Rule[]`: `run` applies it one way to a fixpoint. The combinators are ordinary
// Camel functions over stages, written with `loop` and `?->`: no helper carries an index or an
// accumulator. Each answers a `Run`: the program, the rewrites applied, the rounds made, the nodes
// visited, the nodes erased, whether the last application reached a fixpoint, and the wall time
// (H226). No combinator reorders a stage's rules or drops a match: a stage that applies nothing
// stays applied nothing.
//
// The rule sets and the choices are configuration, so they are `with` parameters (design
// principles 4.4): `f->seq<[[algebra], [fusion]], false>`, `f->repeat<algebra, 8, false>`. A
// pass that only wants the program reads `.result`.

/// The schedule before its first stage: `f` unchanged, nothing applied, no fixpoint reached.
func start(f: Program): Run<Program> {
    return {
        result: f,
        rewrites: 0,
        rounds: 0,
        visited: 0,
        erased: 0,
        fixpoint: false,
        seconds: 0.0,
    }
}

// The same value as a run that has not failed, so a loop can start from it and go on with `?->`.
func started(f: Program): Run<Program>! {
    return start(f)
}

/// The state after one more application `next`: its program, and the costs of `r` and `next`
/// added. `fixpoint` is the last application's, so it says whether the schedule has just stopped
/// changing, which is what `repeat` and `alternate` read.
func plus(r: Run<Program>, next: Run<Program>): Run<Program> {
    return {
        result: next.result,
        rewrites: r.rewrites + next.rewrites,
        rounds: r.rounds + next.rounds,
        visited: r.visited + next.visited,
        erased: r.erased + next.erased,
        fixpoint: next.fixpoint,
        seconds: r.seconds + next.seconds,
    }
}

/// One application of `rules` on the result of `r`, at most `rounds` rounds, its cost added.
func stage(r: Run<Program>, rules: Rule[], rounds: int, strict: bool): Run<Program>! {
    return run(r.result, rules, rounds, strict) ?-> (next: Run<Program>) => plus(r, next)
}

/// Whether the last application reached a fixpoint. An error stops the loop that asks, and the
/// loop's value is then that error.
func settled(r: Run<Program>!): bool {
    return (r ?-> (x: Run<Program>) => x.fixpoint) !! false
}

/// Whether `r` has not rewritten anything yet; an error stops the loop and is handed on.
func untouched(r: Run<Program>!): bool {
    return (r ?-> (x: Run<Program>) => x.rewrites == 0) !! false
}

/// Whether `done` holds for the program `r` holds; an error stops the loop and is handed on.
func finished(r: Run<Program>!, done: (q: Program) => bool): bool {
    return (r ?-> (x: Run<Program>) => done(x.result)) !! true
}

/// `seq`: the stages once each, in the written order, each to a fixpoint; a stage that fails fails
/// the whole sequence. The stages are not interleaved or reordered.
/// @effect runs the rules' functions
/// @fails error value `RuleInvalid` when a rule does not compile; error value `RuleTwoWay` when a rule is applied in a direction it does not allow; error value `RewriteInvalid` when a rewrite cannot be carried out
/// @example-fragment the tests apply a schedule to a real graph
with <stages: Rule[][], strict: bool>
export func seq(f: Program): Run<Program>! {
    return loop r = started(f) for s in stages do
        r ?-> (x: Run<Program>) => stage(x, s, 16, strict)
}

/// `first`: the stages tried in the written order, and the first one that rewrites something is
/// the result. A stage that matches nothing does not stop the choice; when no stage rewrites
/// anything the program is returned unchanged. A failing stage fails the choice.
/// @effect runs the rules' functions
/// @fails error value `RuleInvalid` when a rule does not compile; error value `RuleTwoWay` when a rule is applied in a direction it does not allow; error value `RewriteInvalid` when a rewrite cannot be carried out
/// @example-fragment the tests apply a schedule to a real graph
with <stages: Rule[][], strict: bool>
export func first(f: Program): Run<Program>! {
    return loop r = started(f) for s in stages while untouched(r) do
        r ?-> (x: Run<Program>) => stage(x, s, 16, strict)
}

/// `repeat`: one round of the rule set at a time, until a round applies nothing or `rounds`
/// rounds were made. A rule is therefore applied at most once per round, and the round that
/// proves the fixpoint is made and counted.
/// @effect runs the rules' functions
/// @fails error value `RuleInvalid` when a rule does not compile; error value `RuleTwoWay` when a rule is applied in a direction it does not allow; error value `RewriteInvalid` when a rewrite cannot be carried out
/// @example-fragment the tests apply a schedule to a real graph
with <rules: Rule[], rounds: int, strict: bool>
export func repeat(f: Program): Run<Program>! {
    return loop r = started(f) for i in range(0, rounds) while !settled(r) do
        r ?-> (x: Run<Program>) => stage(x, rules, 1, strict)
}

/// `until`: a round at a time, while `done` is false for the program; stops at a fixpoint, at
/// `rounds` rounds, or when `done` holds. `done` is read before a round, so the program it holds
/// for already has every rewrite before it.
/// @effect runs the rules' functions
/// @fails error value `RuleInvalid` when a rule does not compile; error value `RuleTwoWay` when a rule is applied in a direction it does not allow; error value `RewriteInvalid` when a rewrite cannot be carried out
/// @example-fragment a predicate, a rule set and a program come from the caller
with <rules: Rule[], done: (q: Program) => bool, rounds: int, strict: bool>
export func until(f: Program): Run<Program>! {
    return loop r = started(f) for i in range(0, rounds) while !finished(r, done) do
        r ?-> (x: Run<Program>) => stage(x, rules, 1, strict)
}

/// `alternate`: one round of `left`, then one round of `right`, until a full pair applies nothing
/// or `rounds` pairs were made. Both stages see the program the other produced, in that order.
/// @effect runs the rules' functions
/// @fails error value `RuleInvalid` when a rule does not compile; error value `RuleTwoWay` when a rule is applied in a direction it does not allow; error value `RewriteInvalid` when a rewrite cannot be carried out
/// @example-fragment two rule sets and a program come from the caller
with <left: Rule[], right: Rule[], rounds: int, strict: bool>
export func alternate(f: Program): Run<Program>! {
    return loop r = started(f) for i in range(0, rounds) while !settled(r) do
        r ?-> (x: Run<Program>) => pair(x, left, right, strict)
}

/// One round of `left` and one round of `right`, in that order; `fixpoint` says whether the pair
/// changed anything, which ends `alternate`.
func pair(r: Run<Program>, left: Rule[], right: Rule[], strict: bool): Run<Program>! {
    return stage(r, left, 1, strict) ?-> (a: Run<Program>) => {
        return stage(a, right, 1, strict) ?-> (b: Run<Program>) => {
            let out: Run<Program> = {
                result: b.result,
                rewrites: b.rewrites,
                rounds: b.rounds,
                visited: b.visited,
                erased: b.erased,
                fixpoint: b.rewrites == r.rewrites,
                seconds: b.seconds,
            }
            return out
        }
    }
}

// ---- rules::accuracy (rewrite design 2 (second version) 8.10) ----
//
// These rules compute the same value in a form with no larger error. They are not part of
// `simplify`: they change the rounding path on purpose, and the numeric permission that 8.10 puts
// around that (`refine_accuracy`, default not granted, not applicable under `#strict`) is not in
// the engine yet -- `operator_semantics.h` stops at `nondeterministic`, and no tag registers the
// name. `check`, for the same reason, compares the two sides bit for bit (a rule with no
// permission) or inside a rounding bound; it cannot state "the right side is the more accurate
// one". So the three rules below carry no `#requires`, they are applied only by the opt-in
// `rules::accuracy` pass, and they must not be added to `simplify` or to any default pipeline.
// When `refine_accuracy` lands, they take `#requires<refine_accuracy>` and the existing policy
// makes them drop out under `#strict` and under `std::opt(safe_fp=true)`; that, and the
// accuracy-aware check of 8.10, is the whole remaining work of this library.

/// The naive softmax of the showcase: `exp(x) / sum(exp(x), axis, true)`.
///
/// Numeric argument. Over f32, `exp` overflows to +inf above ln(FLT_MAX) = 88.722839 (exp(88)
/// = 1.65e38 is finite, exp(89) = 4.49e38 is +inf) and underflows to +0 below ln(2^-150) =
/// -103.97208. The naive form then sums +infs (so inf/inf = NaN) or sums zeros (so 0/0 = NaN
/// when every term is zero), and its error is unbounded there. The stable form subtracts
/// m = max(x, axis, true) first: x - m <= 0, so exp(x - m) <= 1, the sum lies in [1, n] (the
/// maximum contributes exp(0) = 1 exactly), and the division gives a value in [0, 1] with no
/// overflow and no 0/0. Rounding: both forms pay exp (<= 2 ulp, its declared bound), one f32
/// division, and a sum that the definition accumulates in f64 and rounds once; the stable form
/// adds one f32 subtraction, which is exact when x and m are within a factor of two (Sterbenz)
/// and at most 0.5 ulp otherwise. So where the naive form is finite the error grows by at most
/// half an ulp, and over the whole f32 domain it does not grow at all: the naive error is
/// unbounded (NaN), the stable one is bounded by the operators' declarations. That is "no
/// worse" in the sense of the library: the worst case over the domain is not larger.
export rule tensor_softmax_naive(x: Tensor<f32>, const axis: int) {
    exp(x) / sum(exp(x), axis, true) => softmax(x, axis)
}

/// The naive log-softmax of the showcase: `log(exp(x) / sum(exp(x), axis, true))`.
///
/// Numeric argument. Same overflow/underflow as `tensor_softmax_naive`, plus `log(0) = -inf`
/// for every probability that underflowed to zero. `log_softmax(x, axis)` is, by its definition
/// (stdlib/tensor_definitions.cml), `d - log(sum(exp(d), axis, true))` with `d = x - max(x)`;
/// that is the same expression mathematically (log(e/s) = (x-m) - log s) with no division --
/// so the rounding of `e/s` disappears -- and no log of a rounded probability. The direct form's
/// error is the stable softmax's minus one rounding (a division, <= 0.5 ulp) and without the
/// log(0) failure; the value it computes is the same one, and no input maps to -inf that has a
/// finite log-softmax. Strictly no worse.
export rule tensor_log_softmax_naive(x: Tensor<f32>, const axis: int) {
    log(exp(x) / sum(exp(x), axis, true)) => log_softmax(x, axis)
}

/// `log(softmax(x, axis))` where the program already calls `softmax`: the showcase's
/// `let p = softmax(logits); ... log(p)` (or `log(exp/sum(exp))` after `tensor_softmax_naive`).
///
/// Numeric argument. softmax rounds each probability to f32 before `log` sees it: a relative
/// rounding of at most 2^-24 (0.5 ulp) becomes an absolute error of up to 2^-24 in log(p), and a
/// probability that rounds to zero gives log(0) = -inf while the true log-softmax is finite at
/// (x - m) - log(s). `log_softmax` computes that value without the division and without the log
/// of a value in [0, 1]; it adds no rounding the softmax path did not already make. No worse.
export rule tensor_log_softmax_of_softmax(x: Tensor<f32>, const axis: int) {
    log(softmax(x, axis)) => log_softmax(x, axis)
}

/// The accuracy library, as the opt-in pass `rules::accuracy`: the direct log-softmax pattern
/// first, so `log(exp(x)/sum(exp(x)))` is one rewrite (`log_softmax_naive`); then the softmax
/// pattern and the log-of-softmax one, for a program that computes a softmax first. The two
/// stages are the schedule: whichever stage is written first decides which rule is the one that
/// fires on a source both can match (the test `rules.accuracy_schedule_order` pins both counts).
export func accuracy(p: Program): Program! {
    return p->seq<[[tensor_log_softmax_naive], [tensor_softmax_naive, tensor_log_softmax_of_softmax]], false>
        ?-> (r: Run<Program>) => r.result
}

// ---- rules::fusion ----
//
// What is here: one chain of elementwise operators replaced by one operator whose kernel does the
// same work in a single pass over the data, bit for bit.
//
// What is deliberately *not* here, and the mechanism each would need. Writing a rule that only
// renames the same chain would not be a fusion, and a fusion that changes a bit is not a rule of
// this library.
//
//   - `exp` then `sum` (a fused logsumexp): no such operator is registered. A rule's right side
//     can only write operators, constants and its parameters (src/runtime/rules.cpp,
//     SideReader::term), so the fused form has to exist as an operator with a kernel and a
//     normative definition. Needed: a `tensor:logsumexp` operator, its definition in
//     stdlib/tensor_definitions.cml, and a kernel that agrees with it.
//   - `mul` then `add` (a fused multiply-add): no `tensor:mul_add` operator, and the two
//     roundings of `a*b + c` must not collapse into one without `#contract` (design principles
//     7.2), so the operator has to say which of the two it rounds. Needed: the operator and its
//     permission.
//   - a fusion *region*: `tensor::fuse` marks `x @ w + b` with the `tensor.fusion` attribute and
//     a backend runs the group as one kernel while the graph keeps the operators (modules/tensor/
//     passes/fuse.h). A rule cannot do that: its right side writes nodes, and neither the rule
//     form nor the `graph` module's transaction has an attribute or region writer. Needed: an
//     attribute/region form on a rule's right side (rewrite design 2 (second version) 4 and 7).
//   - the QKV multi-root fusion `(x @ wq, x @ wk, x @ wv) => split(x @ concat(...))`: a rule's
//     left side must be one operator applied to something (src/runtime/rules.cpp refuses a tuple),
//     so the multi-root patterns of v2 section 3 are the missing piece.
//
// These are gaps in the engine, not in this file: none of them can be written as a rule today
// without either changing the answer or merely renaming the chain.

/// The sigmoid chain of the showcase and of every hand-written logistic: `1/(1+exp(-x))`.
///
/// It is exactly the definition of `tensor:sigmoid` (stdlib/tensor_definitions.cml:
/// `1.0 / (1.0 + exp(-x))`), and a kernel must agree with its operator's definition bit for bit
/// (design principles 7.1; the definition file's header). The same `vmath::exp` runs on both
/// sides, the negation is exact, and the `+` and `/` are the same f32 IEEE operations in the same
/// order, so the rewrite changes no bit -- the test `rules.fusion_bit_identical` prints the chain
/// and `sigmoid(x)` next to each other before the pass and the same text after it. What changes
/// is the cost: neg, exp, add and divide are four kernels and four passes over the data; sigmoid
/// is one kernel and one pass.
export rule tensor_sigmoid_chain(x: Tensor<f32>) {
    1.0 / (1.0 + exp(-x)) => sigmoid(x)
}

/// The fusion library, as the opt-in pass `rules::fusion`.
export func fusion(p: Program): Program! {
    return rewrite(p, [tensor_sigmoid_chain])
}
