/**
 * Array functions and higher-order functions, written in Camel on top of the built-in
 * operators (map, filter, reduce, range, zip, slice, len) and a few native primitives of this
 * module (the sorts, argsort, flatten, unique). Every function returns a new value; none changes
 * its argument.
 *
 * - The array a function works on is its ordinary argument; a function or a value that
 *   configures it is a with-argument, as for the built-in `map<f>(xs)` and `slice<a, b>(xs)`,
 *   so calls chain: `xs->filter<p>->sort_by<key>->take<3>`.
 * - A result that may not exist is `T?` (`find`, `index_of`, `min`, `max`). Nothing here
 *   returns an error value, and a wrong argument is a fault of the operator that meets it.
 * - A function passed to any of these must be pure. The implementation may stop early
 *   (`find`, `index_of`, `any`, `all`) or, when a fast path is added under `#impl`, apply it to
 *   several elements at once; the result is the same either way, and no call observes another.
 *   A function with side effects belongs in `foreach` or `reduce`, which run in order.
 * - The functions written here are generic: there is one instance per set of element types in
 *   the whole program, whichever module calls it (one root graph, design principles 10.1).
 *   `group_by` is not here: it needs the map type.
 */
module array

import math
import { is_bool, is_numeric, is_ordered, is_string } from types

// The native primitives are declared here, as body-less declarations of this module: each stands
// for the operator its `#op` tag names (`array:argsort_i`, `array:sort_d`, ...), implemented in
// C++ and answered on this module's protocol. They are pure and return a new array.
//
// One declaration per element type, and each declaration names the operator of its own element
// type. The executor a declaration names takes exactly the element type its signature names
// (builtin/operators/array.cpp), so the element type is known where the executor is chosen and no
// run-time switch on the element type is left anywhere in the module. This is the shape the
// reductions' kernels got (H228: one operator, per-type executors; design principles 10.4), and
// the shape `abs`, `min` and `max` in `stdlib/math.cml` already had: the element type is named by
// the signature, which is what the operator path resolves a call by, so `sort(xs)` is written as
// it always was and no kernel's name is ever written.
//
// The sorts order the four numeric element types the C++ sorts hold an order on. An element type
// no declaration names (bf16, f16, bool, string) has no sort at all: the call is refused where it
// is written, listing the declarations, rather than at run time by the executor.
// `argsort` takes the keys it can order, which is those four and `bool` and `string`.

// ---- sorting ----

/// The positions of the keys in ascending order of key; equal keys keep their order (a stable
/// sort). Keys are numbers, strings (ordered by byte) or bools; NaN keys come last. The
/// primitive behind `sort_by`.
/// @pure
/// @example argsort([30, 10, 20])    // [1, 2, 0]
#op<'array:argsort_i'>
export func argsort(keys: i32[]): int[]
#op<'array:argsort_l'>
export func argsort(keys: int[]): int[]
#op<'array:argsort_f'>
export func argsort(keys: f32[]): int[]
#op<'array:argsort_d'>
export func argsort(keys: float[]): int[]
#op<'array:argsort_b'>
export func argsort(keys: bool[]): int[]
#op<'array:argsort_s'>
export func argsort(keys: string[]): int[]

/// A sorted copy of xs (quicksort).
/// @pure
/// @example sort([3, 1, 2])    // [1, 2, 3]
#op<'array:sort_i'>
export func sort(xs: i32[]): i32[]
#op<'array:sort_l'>
export func sort(xs: int[]): int[]
#op<'array:sort_f'>
export func sort(xs: f32[]): f32[]
#op<'array:sort_d'>
export func sort(xs: float[]): float[]

/// A sorted copy of xs, by insertion sort.
/// @pure
/// @example insert_sort([3, 1, 2])    // [1, 2, 3]
#op<'array:insert_sort_i'>
export func insert_sort(xs: i32[]): i32[]
#op<'array:insert_sort_l'>
export func insert_sort(xs: int[]): int[]
#op<'array:insert_sort_f'>
export func insert_sort(xs: f32[]): f32[]
#op<'array:insert_sort_d'>
export func insert_sort(xs: float[]): float[]

/// A sorted copy of xs, by quicksort.
/// @pure
/// @example quick_sort([3, 1, 2])    // [1, 2, 3]
#op<'array:quick_sort_i'>
export func quick_sort(xs: i32[]): i32[]
#op<'array:quick_sort_l'>
export func quick_sort(xs: int[]): int[]
#op<'array:quick_sort_f'>
export func quick_sort(xs: f32[]): f32[]
#op<'array:quick_sort_d'>
export func quick_sort(xs: float[]): float[]

/// A sorted copy of xs, by merge sort.
/// @pure
/// @example merge_sort([3, 1, 2])    // [1, 2, 3]
#op<'array:merge_sort_i'>
export func merge_sort(xs: i32[]): i32[]
#op<'array:merge_sort_l'>
export func merge_sort(xs: int[]): int[]
#op<'array:merge_sort_f'>
export func merge_sort(xs: f32[]): f32[]
#op<'array:merge_sort_d'>
export func merge_sort(xs: float[]): float[]

/// The sorted array made of the elements of two sorted arrays of numbers. The two must hold the
/// same element type: `T` is one of the four the sorts order, not one per argument.
/// @pure
/// @example merge_sorted_arrays([1, 4], [2, 3])    // [1, 2, 3, 4]
#op<'array:merge_sorted_arrays_i'>
export func merge_sorted_arrays(left: i32[], right: i32[]): i32[]
#op<'array:merge_sorted_arrays_l'>
export func merge_sorted_arrays(left: int[], right: int[]): int[]
#op<'array:merge_sorted_arrays_f'>
export func merge_sorted_arrays(left: f32[], right: f32[]): f32[]
#op<'array:merge_sorted_arrays_d'>
export func merge_sorted_arrays(left: float[], right: float[]): float[]

// ---- rearranging ----

/// The elements in reverse order.
/// @example reverse([1, 2, 3])    // [3, 2, 1]
export func reverse::<T>(xs: T[]): T[] {
    return xs[::-1]
}

/// The first n elements; all of them when there are fewer, none when n is not positive.
/// @example [1, 2, 3, 4]->take<2>    // [1, 2]
with <n: int>
export func take::<T>(xs: T[]): T[] {
    return xs[:math::clamp(n, 0, len(xs))]
}

/// The elements after the first n; none when there are fewer, all when n is not positive.
/// @example [1, 2, 3, 4]->drop<1>    // [2, 3, 4]
with <n: int>
export func drop::<T>(xs: T[]): T[] {
    return xs[math::clamp(n, 0, len(xs)):]
}

/// Each element with its index.
/// @example enumerate(['a', 'b'])    // [(0, 'a'), (1, 'b')]
export func enumerate::<T>(xs: T[]): (int, T)[] {
    return zip(0..len(xs), xs)
}

/// The elements of the inner arrays, in order. The primitive behind `flat_map`.
/// @pure
/// @example flatten([[1, 2], [3]])    // [1, 2, 3]
export func flatten::<T>(xss: T[][]): T[]

/// The first occurrence of every value, in order; values are compared as `==` compares them
/// (a NaN equals nothing, so every NaN is kept).
/// @pure
/// @example unique([3, 1, 3, 2, 1])    // [3, 1, 2]
export func unique::<T>(xs: T[]): T[]

// ---- searching ----

/// The index of the first element equal to x, or null.
/// @example [3, 9, 2]->index_of<9> ?? -1    // 1
with <x: T>
export func index_of::<T>(xs: T[]): int? {
    let i = loop i = 0 while i < len(xs) && xs[i] != x do i + 1
    return if i < len(xs) then i else null
}

/// The first element for which pred is true, or null.
/// @example [3, 9, 2]->find<(x: int) => x > 4> ?? -1    // 9
with <pred: (x: T) => bool>
export func find::<T>(xs: T[]): T? {
    let i = loop i = 0 while i < len(xs) && !pred(xs[i]) do i + 1
    return if i < len(xs) then xs[i] else null
}

/// True when pred is true for at least one element; false for an empty array.
/// @example [3, 9, 2]->any<(x: int) => x > 4>    // true
with <pred: (x: T) => bool>
export func any::<T>(xs: T[]): bool {
    return loop hit = false for x in xs while !hit do pred(x)
}

/// True when pred is true for every element; true for an empty array.
/// @example [3, 9, 2]->all<(x: int) => x > 4>    // false
with <pred: (x: T) => bool>
export func all::<T>(xs: T[]): bool {
    return loop ok = true for x in xs while ok do pred(x)
}

/// The number of elements for which pred is true.
/// @example [3, 9, 2]->count<(x: int) => x > 2>    // 2
with <pred: (x: T) => bool>
export func count::<T>(xs: T[]): int {
    return loop n = 0 for x in xs do if pred(x) then n + 1 else n
}

// ---- aggregating ----

// A reduction of floating-point elements follows a rule of the language, not a choice of this
// module: it returns the element type and accumulates in f64, rounding once at the end (design
// principles 7.3: "浮点数组的归约在 f64 中累加、舍入一次，返回元素类型（与张量归约一致）"),
// and the rule is the same for an f32 array. Writing the f64 accumulator and the single conversion
// back into the element type is what makes it a definition rather than a precision the compiler
// chose: the additions the source asks for are f64 additions, so nothing here is an f32
// accumulation that the compiler raised, and `change_precision` (7.2, which governs what the
// compiler changes) is neither needed nor consumed by this module. The addition order is
// unchanged too: ascending from +0, as it was.
#impl<sum_kernel>
/// The sum of the elements, 0 for an empty array.
///
/// A floating-point element type accumulates in f64 and rounds once into the element type at the
/// end: the additions are f64 additions and the result is one conversion of their sum, not a
/// rounding after every addition (an f32 accumulator rounds at every step and answers
/// differently). This is the same rule the tensor axis `sum` follows (modules/tensor/kernels/
/// reduce.cpp: a double accumulator, one rounding when the element is stored), so the two paths
/// agree bit for bit on the same elements. An integer element type accumulates in itself and
/// wraps around on overflow, as `+` does on it; a complex element type accumulates in itself as
/// well, the f64 rule being stated for the floating-point element types.
/// @example sum([1, 2, 3])    // 6
export func sum::<T>(xs: T[]): T when is_numeric::<T>() {
    return match type T {
        // The accumulator of the integer arms is T itself; a complex value accumulates in
        // itself too, and its zero is the complex zero (a c64/c128 accumulator does not take 0).
        case int | i32 => xs->reduce<(a, b) => a + b, 0>
        case c64 => xs->reduce<(a, b) => a + b, c64(0)>
        case c128 => xs->reduce<(a, b) => a + b, c128(0)>
        // A floating-point T accumulates in f64 (`sumF64`, from +0 in order) and converts once
        // into the element type, and that conversion is the only rounding of the whole reduction.
        // bf16 and f16 are floating-point element types of the same kind (design principles 7.3),
        // and their arms are written the same way.
        case float => float(sumF64(xs))
        case f32 => f32(sumF64(xs))
        case bf16 => bf16(sumF64(xs))
        case f16 => f16(sumF64(xs))
    }
}

/// The f64 sum of the elements, from +0 in ascending order: the accumulator of `sum` for every
/// floating-point element type (design principles 7.3, ruling reduced-precision.md item (d)).
/// `float(x)` reads each element into the f64 accumulator, so no addition is done at a narrower
/// width; the caller converts the result into the element type, once.
func sumF64::<T>(xs: T[]): float {
    return xs->reduce<(acc: float, x: T): float => acc + float(x), 0.0 as float>
}
#impl<min_kernel>
/// The smallest number (IEEE 754 minimum: a NaN anywhere makes the result NaN, and -0 is below
/// +0), or null for an empty array.
///
/// No accumulator and no accumulation width take part in this fold: it carries an element of T
/// and combines it with `math::min`, which is IEEE 754 minimum — exactly associative and
/// commutative (design principles 7.7) — so the order does not change the bits and there is
/// nothing to round.
/// @example min([3, 9, 2]) ?? 0    // 2
export func min::<T>(xs: T[]): T? when is_ordered::<T>() {
    return if len(xs) == 0 then null else xs->reduce<math::min, xs[0]>
}
#impl<max_kernel>
/// The largest number (IEEE 754 maximum: a NaN anywhere makes the result NaN, and +0 is above
/// -0), or null for an empty array.
///
/// As `min`: the fold carries an element of T, and `math::max` is IEEE 754 maximum, exactly
/// associative and commutative (design principles 7.7), so no accumulator type enters.
/// @example max([3, 9, 2]) ?? 0    // 9
export func max::<T>(xs: T[]): T? when is_ordered::<T>() {
    return if len(xs) == 0 then null else xs->reduce<math::max, xs[0]>
}

// ---- transforming ----

/// f applied to every element, the resulting arrays joined in order.
/// @example [1, 2]->flat_map<(x: int) => [x, x * 10]>    // [1, 10, 2, 20]
with <f: (x: T) => U[]>
export func flat_map::<T, U>(xs: T[]): U[] {
    return flatten(xs->map<f>)
}

/// The elements in ascending order of key(x); elements with equal keys keep their order (the
/// sort is stable, so sorting by one key and then by another works). A key is a number, a string
/// (ordered by byte) or a bool; NaN keys come last. For a descending order of numbers use the
/// negated key.
/// @example ['pear', 'fig', 'apple']->sort_by<(w: string) => len(w)>    // ['fig', 'pear', 'apple']
with <key: (x: T) => K>
export func sort_by::<T, K>(xs: T[]): T[] {
    return xs[argsort(xs->map<key>)]
}

/// f(xs[i], ys[i]) for every i.
/// @fails fault `InvalidArgument` (of zip) when the two arrays differ in length
/// @example zip_with<(a: int, b: int) => a + b>([1, 2], [10, 20])    // [11, 22]
with <f: (a: T, b: U) => V>
export func zip_with::<T, U, V>(xs: T[], ys: U[]): V[] {
    return zip(xs, ys)->map<((a, b)) => f(a, b)>
}

// ---- the kernels of the reductions ----

// A reduction's kernel is the body-less declaration below: the function above is the semantics and
// what a call of the name takes when no kernel applies, and the declaration is what a call may take
// instead (design principles 10.4, "常用而热的定义带原生内核"). The declaration's own `when` is what
// says which element type has an executor: `Builder::declaredRuleApplies` binds the declaration's
// type parameter from the instance's element type and evaluates the condition, an element type it
// refuses has no executor and keeps the body, which is the semantics (H228: one operator, per-type
// executors).
//
// One declaration per element type, and each declaration names the operator of its own element type
// (`#op<'array:sum_i'>` for `i32`, `#op<'array:sum_d'>` for `float`, and so on). That is the shape
// the executors ask for: the executor a declaration names takes exactly the element type its
// condition admits (builtin/operators/array_reduce.cpp), so the element type is known where the
// executor is chosen and no run-time switch on the element type is left anywhere. The conditions are
// exact element types (`is_elem_i32` and its siblings below), so no two of them hold for one type;
// two same-named declarations whose conditions overlap are refused where the second is written, as
// `SemanticDiag::WhenDeclarationOverlap` naming the type both hold for and both declarations — the
// compiler asks both conditions about every registered type (`signaturesCanAgree`), and two
// declarations whose conditions are mutually exclusive both stand.
//
// A call is written `sum(xs)`, `min(xs)`, `max(xs)`, never a kernel's name: the kernel is chosen at
// instantiation (`Builder::adoptImplKernel`), which is the only `when`-aware selection there is.
//
// Nothing here states how to compare or how to add. That is written once, in modules/math/minmax.h,
// which these kernels and the tensor kernels both call (the tensor header forwards to it rather than
// holding a second copy). The executors differ in the type they accumulate or carry, not in the
// comparison. The kernel and the body are pinned against each other by
// test/cases/modules/stdlib/array_reduction_kernels.cml, element type by element type, including the
// two reduced-precision ones and the sign of a zero.
//
// These declarations stand at the end of the module: one of them above the fault line would move it,
// and the line `zip`'s fault is on is how the fault is located (stdlib.fault.zip_with,
// attempt.library's golden output).

// ---- the element types of the reductions, one predicate each ----

// The reductions are declared for a family of element types (`is_numeric` for `sum`, `is_ordered`
// for `min` and `max`), and the executors are one per element type. A declaration's `when` therefore
// has to name one element type, not a family: these predicates are what it names, and each holds for
// exactly one type, so the declarations are mutually exclusive by construction. `is_integer` and
// `is_float` (types.cml) are the families themselves; a declaration conditioned on one of those
// covers several executors at once, which is what the run-time switch used to answer.

/// The element type `i32` alone, for the kernel declaration of `sum`/`min`/`max` over an `i32[]`.
func is_elem_i32::<T>(): bool {
    return match type T {
        case i32 => true
        case _ => false
    }
}

/// The element type `int` alone, for the kernel declaration over an `int[]`.
func is_elem_int::<T>(): bool {
    return match type T {
        case int => true
        case _ => false
    }
}

/// The element type `f32` alone, for the kernel declaration over an `f32[]`.
func is_elem_f32::<T>(): bool {
    return match type T {
        case f32 => true
        case _ => false
    }
}

/// The element type `float` (f64) alone, for the kernel declaration over a `float[]`.
func is_elem_f64::<T>(): bool {
    return match type T {
        case float => true
        case _ => false
    }
}

/// The element type `bf16` alone, for the kernel declaration over a `bf16[]`.
func is_elem_bf16::<T>(): bool {
    return match type T {
        case bf16 => true
        case _ => false
    }
}

/// The element type `f16` alone, for the kernel declaration over an `f16[]`.
func is_elem_f16::<T>(): bool {
    return match type T {
        case f16 => true
        case _ => false
    }
}

// ---- the kernels of `sum`, one per element type ----

// An integer element type accumulates in itself and wraps on overflow, as `+` does on it; a
// floating-point element type accumulates in f64 and is rounded once into the element type at the
// end. A complex element type is numeric and `sum` accepts it, but no declaration below names one,
// so `sum` over a complex array has no executor and runs its body — the complex arm of the body is
// the only place that says what summing complex numbers means.

/// The kernel of `sum` for an `i32[]`: the accumulator is `i32`, wrapping on overflow.
#op<'array:sum_i'>
func sum_kernel::<T>(xs: T[]): T when is_elem_i32::<T>()

/// The kernel of `sum` for an `int[]`: the accumulator is `int`, wrapping on overflow.
#op<'array:sum_l'>
func sum_kernel::<T>(xs: T[]): T when is_elem_int::<T>()

/// The kernel of `sum` for an `f32[]`: an f64 accumulator, rounded once into `f32`.
#op<'array:sum_f'>
func sum_kernel::<T>(xs: T[]): T when is_elem_f32::<T>()

/// The kernel of `sum` for a `float[]`: an f64 accumulator, rounded once into `float`.
#op<'array:sum_d'>
func sum_kernel::<T>(xs: T[]): T when is_elem_f64::<T>()

/// The kernel of `sum` for a `bf16[]`: an f64 accumulator, rounded once into `bf16`.
#op<'array:sum_bf'>
func sum_kernel::<T>(xs: T[]): T when is_elem_bf16::<T>()

/// The kernel of `sum` for an `f16[]`: an f64 accumulator, rounded once into `f16`.
#op<'array:sum_f6'>
func sum_kernel::<T>(xs: T[]): T when is_elem_f16::<T>()

// ---- the kernels of `min` and `max`, one per element type ----

// The fold carries an element of T and combines it with `math::min`/`math::max` (IEEE 754 minimum
// and maximum), so the result is one of the elements and nothing rounds; an empty array answers
// null. The two reduced-precision element types carry the winning element's own 16-bit pattern.

/// The kernel of `min` for an `i32[]`.
#op<'array:min_i'>
func min_kernel::<T>(xs: T[]): T? when is_elem_i32::<T>()

/// The kernel of `min` for an `int[]`.
#op<'array:min_l'>
func min_kernel::<T>(xs: T[]): T? when is_elem_int::<T>()

/// The kernel of `min` for an `f32[]`.
#op<'array:min_f'>
func min_kernel::<T>(xs: T[]): T? when is_elem_f32::<T>()

/// The kernel of `min` for a `float[]`.
#op<'array:min_d'>
func min_kernel::<T>(xs: T[]): T? when is_elem_f64::<T>()

/// The kernel of `min` for a `bf16[]`.
#op<'array:min_bf'>
func min_kernel::<T>(xs: T[]): T? when is_elem_bf16::<T>()

/// The kernel of `min` for an `f16[]`.
#op<'array:min_f6'>
func min_kernel::<T>(xs: T[]): T? when is_elem_f16::<T>()

/// The kernel of `min` for a `bool[]`: `false` is below `true`.
#op<'array:min_b'>
func min_kernel::<T>(xs: T[]): T? when is_bool::<T>()

/// The kernel of `min` for a `string[]`: the comparison is on the bytes of the two values.
#op<'array:min_s'>
func min_kernel::<T>(xs: T[]): T? when is_string::<T>()

/// The kernel of `max` for an `i32[]`.
#op<'array:max_i'>
func max_kernel::<T>(xs: T[]): T? when is_elem_i32::<T>()

/// The kernel of `max` for an `int[]`.
#op<'array:max_l'>
func max_kernel::<T>(xs: T[]): T? when is_elem_int::<T>()

/// The kernel of `max` for an `f32[]`.
#op<'array:max_f'>
func max_kernel::<T>(xs: T[]): T? when is_elem_f32::<T>()

/// The kernel of `max` for a `float[]`.
#op<'array:max_d'>
func max_kernel::<T>(xs: T[]): T? when is_elem_f64::<T>()

/// The kernel of `max` for a `bf16[]`.
#op<'array:max_bf'>
func max_kernel::<T>(xs: T[]): T? when is_elem_bf16::<T>()

/// The kernel of `max` for an `f16[]`.
#op<'array:max_f6'>
func max_kernel::<T>(xs: T[]): T? when is_elem_f16::<T>()

/// The kernel of `max` for a `bool[]`: `false` is below `true`.
#op<'array:max_b'>
func max_kernel::<T>(xs: T[]): T? when is_bool::<T>()

/// The kernel of `max` for a `string[]`: the comparison is on the bytes of the two values.
#op<'array:max_s'>
func max_kernel::<T>(xs: T[]): T? when is_string::<T>()
