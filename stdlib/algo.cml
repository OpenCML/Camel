/**
 * Signatures of the `algo` module (C++ operators, modules/algo).
 *
 * Sorting works on arrays of numbers (i32, int, f32, float) in ascending order. Every function
 * returns a new array and leaves its argument unchanged (design principles 11.3); to sort a
 * variable, bind it to the result: `xs = xs->sort`. That rebinding sorts the variable's own
 * array in place when nothing else refers to it, an optimisation that does not change what the
 * program means (11.3). To sort anything else, or by a key, use `sort_by` of the `array` module.
 */

// The declarations of the operators of the C++ module `algo` (`modules/algo`). This file is the
// one source of their signatures (design principles 6.4; handover H19, step 10): the C++ side
// keeps the kernels, the executor, the operator traits and the in-place forms. Every name of the
// module is declared here and no computed signature is left: the seven names whose result type is
// the element type of their array argument are generic declarations (`(typeas T)[]`), which
// reproduce the resolver's accept set exactly (handover H202, after H194).

module algo

/// The positions of the keys in ascending order of key; equal keys keep their order (a stable
/// sort). Keys are numbers, strings (ordered by byte) or bools; NaN keys come last. The
/// primitive behind `sort_by` of the `array` module.
/// @pure
/// @example argsort([30, 10, 20])    // [1, 2, 0]
export func argsort(keys: i32[]): int[]
export func argsort(keys: int[]): int[]
export func argsort(keys: f32[]): int[]
export func argsort(keys: float[]): int[]
export func argsort(keys: bool[]): int[]
export func argsort(keys: string[]): int[]

/// A sorted copy of xs (quicksort).
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example sort([3, 1, 2])    // [1, 2, 3]
export func sort(xs: (typeas T)[]): T[]

/// A sorted copy of xs, by insertion sort.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example insert_sort([3, 1, 2])    // [1, 2, 3]
export func insert_sort(xs: (typeas T)[]): T[]

/// A sorted copy of xs, by quicksort.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example quick_sort([3, 1, 2])    // [1, 2, 3]
export func quick_sort(xs: (typeas T)[]): T[]

/// A sorted copy of xs, by merge sort.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example merge_sort([3, 1, 2])    // [1, 2, 3]
export func merge_sort(xs: (typeas T)[]): T[]

/// The sorted array made of the elements of two sorted arrays of numbers.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example merge_sorted_arrays([1, 4], [2, 3])    // [1, 2, 3, 4]
export func merge_sorted_arrays(left: (typeas T)[], right: T[]): T[]

/// The elements of the inner arrays, in order. The primitive behind `flatten` and `flat_map`
/// of the `array` module.
/// @pure
/// @example flatten([[1, 2], [3]])    // [1, 2, 3]
export func flatten(xss: (typeas T)[][]): T[]

/// The first occurrence of every value, in order; values are compared as `==` compares them
/// (a NaN equals nothing, so every NaN is kept). The primitive behind `unique` of the `array`
/// module.
/// @pure
/// @example unique([3, 1, 3, 2, 1])    // [3, 1, 2]
export func unique(xs: (typeas T)[]): T[]
