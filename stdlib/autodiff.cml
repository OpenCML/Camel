/**
 * Automatic differentiation: function transforms that turn a function into the function of its
 * gradient. `grad(f)` and `with_grad(f)` take the function as an ordinary argument (it is what is
 * transformed, not a configuration) and give a function of the same parameters, so
 * `with_grad(loss)<model>(x, y)` is the loss together with the gradient of the model, and the two
 * steps can be written apart: `let step = with_grad(loss)`, then `step<model>(x, y)` in the loop.
 *
 * What is differentiated is the first `with` parameter of `f` (the weights); every other `with`
 * parameter is a constant, and so is every ordinary parameter. To differentiate the data, bind it
 * as a `with` parameter with a lambda. A function with no `with` parameter, or whose first one has
 * no tangent, or a result that is not a scalar float, is refused where the call is compiled.
 * There is no `argnums`: which value is differentiated is what the `with` binding says, not a
 * position, so a call that would name one is refused as the unknown parameter it is.
 *
 * `has_aux: true` is for a function whose result is the pair `(value, aux)`, the shape JAX uses it
 * for: the first element is the loss and the second is anything the caller wants carried (a count,
 * a norm). The pair is split, the first element is differentiated and the second is handed back
 * unchanged: `grad(f, has_aux: true)` gives `(gradient, aux)` and
 * `with_grad(f, has_aux: true)` gives `((value, aux), gradient)`, which are JAX's orders.
 * The argument has to be the constant `true` -- a call has one result type, so whether the pair is
 * split cannot follow a value -- and `has_aux: false` is refused with the plain call to write.
 *
 * The gradient has the type of the parameter it is the gradient of: a struct gives a struct of
 * gradients, a tuple a tuple, an array of floats an array of the same element type and shape, a
 * float a float of its own type. An integer or a bool leaf is not a continuous quantity: its
 * gradient is a zero of its own type, so a parameter tree that carries a counter can be updated by
 * leaving the counter as it is. A string or a function leaf has no gradient and is refused with
 * the path of the leaf named. A value that depends on the differentiated parameter but has no way
 * for its gradient to flow (an array of strings read inside a loop) is refused as well, never
 * dropped.
 *
 * `grad` and `with_grad` are the transforms of reverse mode, built on the pass mechanism: they
 * need `std::macro` to have expanded what they differentiate, and they leave a call whose callee is
 * not known when they run to a run-time refusal. `vjp` is reverse mode for a result that is not a
 * scalar (it gives the result and the pullback from the cotangent of the result to the gradient),
 * and `jvp` is forward mode (the result and its tangent along a direction); both land with the
 * autodiff lane, not before they work.
 *
 * `stop_gradient` marks a value as a constant. A transform's local rules are the tags on a
 * declaration and the `rule` declarations below: the tags give a function's own rules
 * (`#jvp(rule)` forward, `#transpose(rule)` for a linear function, `#vjp(rule)` the pullback) and
 * are read back by structure (`graph::rule_of`); a primitive's rules are the rules whose pattern
 * is the primitive, one family at a time, starting with the scalar arithmetic.
 */

import { is_float, is_function } from types

/// The rule of the function it is written on for forward mode: along the tangents of the
/// function's arguments it gives the tangent of its result. The rule has the signature of the
/// forward derivative of the function (`stdlib/signatures/autodiff.cml`).
export tag jvp::<F>(rule: F) on func when is_function::<F>()

/// The rule of the function it is written on for the transpose, when the function is linear in
/// its arguments: from the cotangent of the result it gives the cotangents of the arguments. The
/// values the function was given are known when the transpose runs, so a rule is written only for
/// the arguments that carry the data.
export tag transpose::<F>(rule: F) on func when is_function::<F>()

/// The custom derivative of the function it is written on: calls of that function use `rule`
/// instead of differentiating its body. The rule has the signature of the pullback of the
/// function (`stdlib/signatures/autodiff.cml`).
export tag vjp::<F>(rule: F) on func when is_function::<F>()

/// Gives its argument unchanged and cuts the gradient at this point: a value passed through
/// `stop_gradient` is a constant to `grad`. Any value is accepted, and the result has the
/// argument's own type.
/// @example stop_gradient(3.0)    // 3.0
export func stop_gradient::<T>(x: T): T pure

// ---- the local rules of the scalar arithmetic ----
// One law, written once: the pattern names the primitive and the right side what the transform
// makes of it. Forward mode's right side is "the tangents of the arguments => the tangent of the
// result", linear in the tangents; a linear primitive's transpose's right side is "the cotangent
// of the result => the cotangent of the argument that carries the data". The value the primitive
// was given is a value here, not a constant of the rule, so `mul_t` is also the transpose of
// `x * 3`.
//
// Each right side is the named function below it, so the tangent a transform produces is a value
// a program can call and compare with the derivative it claims, and the library keeps one writing
// of the mathematics (design principles: one law, one writing).
//
// A constant of a graph and a reference to a parameter are not primitives: a constant has no
// tangent and a parameter's tangent is its own, so a transform lifts the first to a zero tangent
// and passes the second through, without a rule.

/// The tangent of `x + w` along `(dx, dw)`: `dx + dw`.
/// @example add_tangent(3.0, 5.0, 1.0, 0.0)    // 1.0
export func add_tangent::<T>(x: T, w: T, dx: T, dw: T): T when is_float::<T>() {
    return dx + dw
}

/// `d(x + w) = dx + dw`.
export rule add_jvp::<T>(x: T, w: T) when is_float::<T>() {
    x + w => (dx: T, dw: T) => add_tangent(x, w, dx, dw)
}

/// The tangent of `x - w` along `(dx, dw)`: `dx - dw`.
/// @example sub_tangent(3.0, 5.0, 1.0, 0.0)    // 1.0
export func sub_tangent::<T>(x: T, w: T, dx: T, dw: T): T when is_float::<T>() {
    return dx - dw
}

/// `d(x - w) = dx - dw`.
export rule sub_jvp::<T>(x: T, w: T) when is_float::<T>() {
    x - w => (dx: T, dw: T) => sub_tangent(x, w, dx, dw)
}

/// The tangent of `x * w` along `(dx, dw)`: `dx * w + x * dw`.
/// @example mul_tangent(3.0, 5.0, 1.0, 0.0)    // 5.0
export func mul_tangent::<T>(x: T, w: T, dx: T, dw: T): T when is_float::<T>() {
    return dx * w + x * dw
}

/// `d(x * w) = dx * w + x * dw`.
export rule mul_jvp::<T>(x: T, w: T) when is_float::<T>() {
    x * w => (dx: T, dw: T) => mul_tangent(x, w, dx, dw)
}

/// The tangent of `x / w` along `(dx, dw)`: `dx / w - x * dw / (w * w)`.
/// @example div_tangent(6.0, 4.0, 1.0, 0.0)    // 0.25
export func div_tangent::<T>(x: T, w: T, dx: T, dw: T): T when is_float::<T>() {
    return dx / w - x * dw / (w * w)
}

/// `d(x / w) = dx / w - x * dw / (w * w)`.
export rule div_jvp::<T>(x: T, w: T) when is_float::<T>() {
    x / w => (dx: T, dw: T) => div_tangent(x, w, dx, dw)
}

/// The tangent of `-x` along `dx`: `-dx`.
/// @example neg_tangent(3.0, 1.0)    // -1.0
export func neg_tangent::<T>(x: T, dx: T): T when is_float::<T>() {
    return -dx
}

/// `d(-x) = -dx`.
export rule neg_jvp::<T>(x: T) when is_float::<T>() {
    -x => (dx: T) => neg_tangent(x, dx)
}

/// The cotangent of `x` in `x + c`: the cotangent of the sum, unchanged.
/// @example add_cotangent(3.0, 5.0, 2.0)    // 2.0
export func add_cotangent::<T>(x: T, c: T, ct: T): T when is_float::<T>() {
    return ct
}

/// The transpose of `x + c`.
export rule add_t::<T>(x: T, c: T) when is_float::<T>() {
    x + c => (ct: T) => add_cotangent(x, c, ct)
}

/// The cotangent of `x` in `x - c`: the cotangent of the difference, unchanged.
/// @example sub_cotangent(3.0, 5.0, 2.0)    // 2.0
export func sub_cotangent::<T>(x: T, c: T, ct: T): T when is_float::<T>() {
    return ct
}

/// The transpose of `x - c`.
export rule sub_t::<T>(x: T, c: T) when is_float::<T>() {
    x - c => (ct: T) => sub_cotangent(x, c, ct)
}

/// The cotangent of `x` in `x * c`: `ct * c`.
/// @example mul_cotangent(3.0, 5.0, 2.0)    // 10.0
export func mul_cotangent::<T>(x: T, c: T, ct: T): T when is_float::<T>() {
    return ct * c
}

/// The transpose of `x * c`.
export rule mul_t::<T>(x: T, c: T) when is_float::<T>() {
    x * c => (ct: T) => mul_cotangent(x, c, ct)
}

/// The cotangent of `x` in `x / c`: `ct / c`.
/// @example div_cotangent(6.0, 4.0, 2.0)    // 0.5
export func div_cotangent::<T>(x: T, c: T, ct: T): T when is_float::<T>() {
    return ct / c
}

/// The transpose of `x / c`.
export rule div_t::<T>(x: T, c: T) when is_float::<T>() {
    x / c => (ct: T) => div_cotangent(x, c, ct)
}

/// The cotangent of `x` in `-x`: `-ct`.
/// @example neg_cotangent(3.0, 2.0)    // -2.0
export func neg_cotangent::<T>(x: T, ct: T): T when is_float::<T>() {
    return -ct
}

/// The transpose of `-x`.
export rule neg_t::<T>(x: T) when is_float::<T>() {
    -x => (ct: T) => neg_cotangent(x, ct)
}