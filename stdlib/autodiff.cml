/**
 * Automatic differentiation: `grad` turns a function into its gradient function, `with_grad`
 * returns the value together with that gradient, and `stop_gradient` marks a value as a
 * constant. The gradient of a function is a function of the same parameters, so the useful
 * signature is the type of the function it differentiates.
 */

// The declaration of the one fixed signature of the C++ module `modules/autodiff` (design
// principles 6.4; handover H19, step 10; H165). This file is the one source of `stop_gradient`'s
// signature; the C++ side keeps the kernel, the executor, the operator traits and the semantics.
//
// `grad` and `with_grad` compute their signature from their argument: the result is a function
// whose parameter list is the argument function's and whose result type is the gradient of the
// argument's result (`gradientSignature(f)`). A declaration cannot write that rule; the two stay
// in C++ as `GradResolver`, and `stdlib/signatures/autodiff.cml` keeps their reference entries
// (as `json` and `random` do with their computed signatures; handover H115, H128).
//
// No operator of this module needs PyTorch or a GPU: `stop_gradient` is the identity on its
// argument, and the declarations here describe C++ operators of the core tensor stack.

module autodiff

/// Returns its argument unchanged, and cuts the gradient at this point: a value passed through
/// `stop_gradient` is a constant to `grad`. Any value is accepted, and the result has the
/// argument's own type.
/// @pure
/// @example stop_gradient(3.0)    // 3.0
export func stop_gradient(x: typeas T): T