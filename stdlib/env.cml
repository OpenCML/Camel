/**
 * Both functions read the environment of the process and are declared with effects.
 */

// The declarations of the operators of the C++ module `modules/env` (design principles 6.4;
// handover H19, step 10; H163). This file is the one source of their signatures; the C++ side
// keeps the kernels, the executor, the purity and the resource. Both names read the environment
// of the process (`env`, read), declared at the module's load (design principles 3.3), so both
// are effectful and no pass may fold, merge or drop a call.
//
// No signature of this module is computed from an argument: the two answers are `string` whatever
// the values are. `modules/env` therefore exports no operator group of its own, and the module
// needs no `stdlib/signatures/env.cml`.

module env

/// The value of an environment variable, or the empty string when it is not set.
/// @effect reads the environment
/// @example get_env('HOME')    // '/home/alice'
export func get_env(name: string): string

/// The current working directory.
/// @effect reads the environment
/// @example get_cwd()    // '/home/alice/project'
export func get_cwd(): string