// The declarations of the operators of the C++ module `modules/hash` (design principles 6.4;
// handover H19, step 10; H163). This file is the one source of their signatures; the C++ side
// keeps the kernels, the executor and the purity.
//
// `sha256` accepts a `string` and a `Bytes` value, which are two operators with two URIs
// (`hash:sha256_str`, `hash:sha256_bytes`); a declaration names one URI, so each of the two
// declarations carries the `#op` tag that names its operator (H113). No signature of this module
// is computed from an argument, so the module needs no `stdlib/signatures/hash.cml`.

module hash

/// The SHA-256 digest of the bytes of s, as 64 lower-case hexadecimal digits.
/// @pure
/// @example sha256('abc')    // 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'
#op<'hash:sha256_str'>
export func sha256(s: string): string
/// The SHA-256 digest of a `Bytes` value, as 64 lower-case hexadecimal digits. The two overloads are
/// two operators (`hash:sha256_str`, `hash:sha256_bytes`); the one is chosen when the program is
/// compiled.
/// @pure
/// @example sha256(encode('abc')) == sha256('abc')    // true
#op<'hash:sha256_bytes'>
export func sha256(s: Bytes): string

/// SHA-256 applied rounds times, each round to the hexadecimal text of the one before;
/// 0 rounds gives s itself.
/// @pure
/// @fails fault `InvalidArgument` when rounds is negative
/// @example sha256_rounds('abc', 1) == sha256('abc')    // true
export func sha256_rounds(s: string, rounds: int): string