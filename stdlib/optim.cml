/**
 * The optimizers: `sgd` and `adam`, each a value, with `init` and `update` the two pure functions
 * a training loop calls.
 *
 *     let opt = adam(cosine_decay(0.001, steps, 0.0001));
 *     let state = init(opt, model);
 *     let (model, state) = update(opt, model, gradient, state);
 *
 * A schedule is a function `(step: int) => float`: `constant(rate)`, `linear_decay(peak, total,
 * floor)` and `cosine_decay(peak, total, floor)` build one, and the rate the update of step `n`
 * uses is `schedule(n)`, with `n` numbered from one. `params` is a tree of nested structs and
 * tuples whose leaves are numbers and tensors, and `grads` is the gradient of that tree, which
 * `with_grad` or `grad` gives; a tree that merely has the same type as the parameters is refused.
 *
 * Every number is computed in double and rounded once, when it is stored. The arithmetic follows the
 * element type the leaf's value has: a tensor leaf of `adam` is widened to f64 and updated there,
 * and stored back at the element type the leaf has, so a trajectory written here is the trajectory
 * `modules/tensor/kernels/update.h` defines, bit for bit.
 */
module optim

import math
import { Tensor, cast, numel, sqrt, to_bytes, zeros_like } from tensor
import { size } from bytes
import { tree_unzip } from tree

// A schedule is a function value `(step: int) => float`, written out at every signature: the rate
// of the update at step `n` is `schedule(n)`, and `n` counts from one.

/// The same rate at every step.
/// @pure
/// @example constant(0.1)(3)    // 0.1
export func constant(rate: float): (step: int) => float {
    return (step: int) => rate
}

/// A rate that falls from `peak` to `floor` in a straight line: `peak * (1 - step / total)` below
/// step `total`, and exactly `floor` from there on. `total` is at least one.
/// @pure
/// @example linear_decay(0.1, 4, 0.0)(2)    // 0.05
export func linear_decay(peak: float, total: int, floor: float): (step: int) => float {
    return (step: int) => linear_rate(peak, total, floor, step)
}

// The rate of one step of the ramp above, as a function of the step alone.
func linear_rate(peak: float, total: int, floor: float, step: int): float {
    return if step >= total then floor else peak * (1.0 - float(step) / float(total))
}

/// A rate that falls from `peak` to `floor` along a cosine: `floor + (peak - floor) *
/// (1 + cos(pi * step / total)) / 2` below step `total`, and exactly `floor` from there on.
/// @pure
/// @example cosine_decay(0.1, 4, 0.0)(1)    // 0.08535533905932738
export func cosine_decay(peak: float, total: int, floor: float): (step: int) => float {
    return (step: int) => cosine_rate(peak, total, floor, step)
}

// The rate of one step of the cosine above. The double nearest pi is written out here: the module
// imports `math` for `cos`, and `pi` is one number, not a parameter.
func cosine_rate(peak: float, total: int, floor: float, step: int): float {
    return if step >= total then floor else floor + (peak - floor) * (1.0 + math::cos(3.141592653589793 * float(step) / float(total))) * 0.5
}

/// The optimization `sgd`: a rate schedule, and nothing else.
export type Sgd = { schedule: (step: int) => float }

/// The optimization `adam`: a rate schedule and the constants of the update. `decay` is the
/// decoupled weight decay of `adamw`, which moves the parameter by `rate * decay` of itself before
/// the adaptive update; it is zero, the plain `adam`.
export type Adam = {
    schedule: (step: int) => float,
    beta1: float,
    beta2: float,
    eps: float,
    decay: float
}

/// The state of `sgd`: the number of updates made, which is the step its schedule reads.
export type SgdState = { step: int }

/// The state of `adam`: a tree of zeros for each moment, shaped like the parameters, and the number
/// of updates made, which is the step the schedule reads.
export type AdamState<P> = { m: P, v: P, step: int }

/// Plain stochastic gradient descent: `p - rate * g` at every leaf, the rate of the step taken.
/// @pure
/// @example sgd(constant(0.1))
export func sgd(schedule: (step: int) => float): Sgd {
    return { schedule: schedule }
}

/// Adam. The constants default to the ones the reference kernel's callers use: beta1 0.9, beta2
/// 0.999, eps 1e-8, and a decoupled weight decay of zero.
/// @pure
/// @example adam(constant(0.001))
/// @example adam(constant(0.001), beta1: 0.5, eps: 0.0001)
export func adam(schedule: (step: int) => float, beta1: float = 0.9, beta2: float = 0.999, eps: float = 0.00000001, decay: float = 0.0): Adam {
    return { schedule: schedule, beta1: beta1, beta2: beta2, eps: eps, decay: decay }
}

/// `adam` with a decoupled weight decay, 0.01 by default: the parameter is first moved by
/// `rate * decay` of itself, and the adaptive update then works on the moved parameter; the moments
/// see the gradient alone, which is what makes the decay decoupled.
/// @pure
/// @example adamw(constant(0.001))
/// @example adamw(constant(0.001), decay: 0.1)
export func adamw(schedule: (step: int) => float, beta1: float = 0.9, beta2: float = 0.999, eps: float = 0.00000001, decay: float = 0.01): Adam {
    return { schedule: schedule, beta1: beta1, beta2: beta2, eps: eps, decay: decay }
}

/// The state `sgd` starts from: no moments to carry, only the step count.
/// @pure
/// @example init(sgd(constant(0.1)), { w: 1.0 })    // { step: 0 }
export func init::<P>(opt: Sgd, params: P): SgdState {
    return { step: 0 }
}

/// The state `adam` starts from: the two moment trees at zero, shaped like the parameters, and the
/// step count.
/// @pure
/// @example init(adam(constant(0.1)), { w: 1.0 })    // { m: { w: 0.0 }, v: { w: 0.0 }, step: 0 }
export func init::<P>(opt: Adam, params: P): AdamState<P> {
    return moments(params)
}

/// One `sgd` update: `(params, state)`, with the step advanced by one and the rate taken from
/// `opt.schedule` at the step this update takes, numbered from one.
/// @pure
/// @example update(sgd(constant(0.1)), { w: 1.0 }, { w: 0.5 }, init(sgd(constant(0.1)), { w: 1.0 }))
export func update::<P, G>(opt: Sgd, params: P, grads: G, state: SgdState): (P, SgdState) {
    let step = state.step + 1
    return (sgd_tree(params, grads, opt.schedule(step)), { step: step })
}

/// One `adam` update: `(params, state)`, with the step advanced by one and the rate taken from
/// `opt.schedule` at the step this update takes, numbered from one. A `decay` other than zero moves
/// the parameters by the decoupled weight decay first.
/// @pure
/// @example update(adam(constant(0.1)), { w: 1.0 }, { w: 0.5 }, init(adam(constant(0.1)), { w: 1.0 }))
export func update::<P, G>(opt: Adam, params: P, grads: G, state: AdamState<P>): (P, AdamState<P>) {
    return adam_update(opt.schedule, opt.beta1, opt.beta2, opt.eps, opt.decay, params, grads, state)
}

// The numbers one update uses: the rate of this step, the two decay rates, `eps`, and the bias
// corrections `1 - beta1^step` and `1 - beta2^step`, which the native path computes with `pow`
// (modules/nn/optim.cpp). `step` is one-based, as it is there.
type Rates = {
    rate: float,
    beta1: float,
    beta2: float,
    eps: float,
    correct1: float,
    correct2: float
}

// The numbers of one step, from the schedule's rate at it.
func rates(rate: float, beta1: float, beta2: float, eps: float, step: int): Rates {
    return {
        rate: rate,
        beta1: beta1,
        beta2: beta2,
        eps: eps,
        correct1: 1.0 - math::pow(beta1, float(step)),
        correct2: 1.0 - math::pow(beta2, float(step))
    }
}

// The two moment trees of a fresh state and the step: the moments start at zero, at every leaf.
func moments::<P>(params: P) {
    return { m: zeros_tree(params), v: zeros_tree(params), step: 0 }
}

// A tree of zeros of the same shape as `t`, with the same leaf types.
func zeros_tree::<P>(t: P) {
    return match type P {
        case struct | tuple => P { static for n, _ in fields P => zeros_tree(t.[n]) }
        case _ => zero_leaf(t)
    }
}

// A zero of the leaf's own type: an f32 number stays f32, and a tensor becomes a tensor of zeros of
// the element type the leaf's value has -- `zeros_like` follows the value, so a leaf whose element
// type the program does not write gets the moments its value asks for, which is what the native
// `adam_state` builds (modules/nn/optim.cpp, `zerosLeaf` reads the value's element type). The
// moments have to come back at the leaf's own element type: a state whose leaves changed type after
// one update could not be a loop state (the state's type is the initial value's type,
// docs/language/06_expressions.md, "状态").
func zero_leaf::<L>(x: L) {
    return match type L {
        case float => 0.0
        case f32 => f32(0.0)
        case Tensor<f32, [?]> => cast(zeros_like(x), 'float32')
        case Tensor<f64, [?]> => cast(zeros_like(x), 'float64')
        case _ => zeros_like(x)
    }
}

// One `sgd` step of a whole tree: `p - rate * g` at every leaf.
func sgd_tree::<P, G>(p: P, g: G, rate: float) {
    return match type P {
        case struct | tuple => P { static for n, _ in fields P => sgd_tree(p.[n], g.[n], rate) }
        case _ => sgd_leaf(p, g, rate)
    }
}

// One leaf of `sgd`. A number is updated in double and rounded once on the store, as the native
// leaf does (`floatSlot`); a tensor leaf is updated at the element type its value has, with the
// rate rounded to it first, which is the arithmetic the native loop does (`pp[i] - float(lr) *
// pg[i]` for an f32 leaf, `pp[i] - lr * pg[i]` for an f64 one). A leaf whose element type the
// program does not write is not converted: `p - rate * g` takes the element type of `p`, and a
// `float` rate does not widen a tensor (`floatTensor` in the native path converted both the
// parameter and the gradient to f32 first, which narrowed an f64 value; design principles 7.4: the
// element type is exact).
func sgd_leaf::<P, G>(p: P, g: G, rate: float) {
    return match type P {
        case f32 => f32(float(p) - rate * float(g))
        case float => p - rate * g
        case Tensor<f32, [?]> => p - f32(rate) * g
        case Tensor<f64, [?]> => p - rate * g
        case _ => p - rate * g
    }
}

// One `adam` step of a whole tree, from a state. The walk answers one triple per leaf -- the new
// parameter and the two new moments -- and `tree_unzip` turns the tree of triples into the three
// trees. `state.m` and `state.v` are shaped like `grads`, so the walk can read them leaf by leaf.
func adam_update::<P, G>(
    schedule: (step: int) => float, beta1: float, beta2: float, eps: float, decay: float,
    params: P, grads: G, state: AdamState<P>
) {
    let step = state.step + 1
    let c = rates(schedule(step), beta1, beta2, eps, step)
    let moved = decay_tree(params, c.rate * decay)
    let parts = tree_unzip(adam_tree(moved, grads, state.m, state.v, c), params)
    return (parts.0, { m: parts.1, v: parts.2, step: step })
}

// The whole parameter tree moved by one decoupled weight decay, before the adaptive update
// (`decay` is zero for plain Adam, and `p * (1 - 0)` is `p` exactly, so a zero decay leaves the
// parameters alone).
func decay_tree::<P>(p: P, rate_decay: float) {
    return match type P {
        case struct | tuple => P { static for n, _ in fields P => decay_tree(p.[n], rate_decay) }
        case _ => decay_leaf(p, rate_decay)
    }
}

// One leaf of the decay: `p * (1 - rate * decay)`, the expression the reference AdamW computes
// (`param.mul_(1 - lr * weight_decay)`), at the leaf's own element type: a tensor leaf keeps its
// element type, because the rate is a `float` and a `float` does not widen a tensor, and the
// factors are rounded to the leaf's element type as the native kernel rounds its rate (design
// principles 7.4). A number written as f32 is computed in double and rounded once, like every other
// f32 number here, and a leaf whose element type the program does not write is not converted: the
// multiplication takes the element type of `x`.
func decay_leaf::<L>(x: L, rate_decay: float) {
    return match type L {
        case f32 => f32(float(x) * (1.0 - rate_decay))
        case float => x * (1.0 - rate_decay)
        case Tensor<f32, [?]> => x * f32(1.0 - rate_decay)
        case Tensor<f64, [?]> => x * (1.0 - rate_decay)
        case _ => x * (1.0 - rate_decay)
    }
}

// One `adam` step of a whole tree: a tree of leaf triples, in the shape of the parameter tree.
func adam_tree::<P, G, M, V>(p: P, g: G, m: M, v: V, c: Rates) {
    return match type P {
        case struct | tuple =>
            P { static for n, _ in fields P => adam_tree(p.[n], g.[n], m.[n], v.[n], c) }
        case _ => adam_leaf(p, g, m, v, c)
    }
}

// One leaf of `adam`, as a triple of the new parameter and the two new moments. A number is
// updated in double and stored once into its own type; a tensor leaf whose element type is written
// as f64 stays f64; a tensor leaf whose element type is written as f32 keeps f32, computed in
// double and stored once; and a leaf whose element type the program does not write is neither
// narrowed nor widened -- it is updated as the leaf whose element type is the one its value has,
// which is what the native leaf does for the same spelling (modules/nn/optim.cpp,
// `leafElementType` reads the element type of the value).
func adam_leaf::<P, G, M, V>(p: P, g: G, m: M, v: V, c: Rates) {
    return match type P {
        case f32 => narrow_numbers(adam_number(float(p), float(g), float(m), float(v), c))
        case float => adam_number(p, g, m, v, c)
        case Tensor<f32, [?]> => narrow_tensors(adam_wide(p, g, m, v, c))
        case Tensor<f64, [?]> => adam_wide(p, g, m, v, c)
        case _ => adam_value_leaf(p, g, m, v, c)
    }
}

// One `adam` leaf whose element type the program does not write. The element type of the value
// decides: "unstated" only means the type does not say it, so narrowing it would be an unlicensed
// loss of precision. The two element types are two writings of the formula: an f32 leaf is computed
// in double and rounded once on the store, which is the pass the fused kernel takes for it
// (modules/tensor/kernels/update.h), and an f64 leaf keeps the double result. The type states no
// element type, so there is no arm to dispatch on, and no operator names a tensor's element type at
// run time; the value answers for itself, with the width of one element read from its own bytes.
// (A tensor leaf of any other element type never reaches an optimizer -- it has no tangent,
// `tensorTangentType` -- and the native leaf refuses it by name rather than converting it.)
func adam_value_leaf::<P, G, M, V>(p: P, g: G, m: M, v: V, c: Rates) {
    if size(to_bytes(p)) == numel(p) * 8 then unstated(adam_wide(p, g, m, v, c))
    else unstated(narrow_tensors(adam_wide(p, g, m, v, c)))
}

// The same triple with the element type left out of the type, which is what the leaf's own type
// states: the two writings above answer at different element types and the walk carries one type for
// the leaf, so this is the seam between them. The values are handed on unchanged.
func unstated::<A, B, C>(t: (A, B, C)): (Tensor, Tensor, Tensor) {
    return (t.0, t.1, t.2)
}

// The Adam formula of one number, in double, in the order the reference kernel writes it
// (modules/tensor/kernels/update.h, `adaptiveUpdateOne`): `m` and `v` are the stored moments and
// `correct1`/`correct2` the bias corrections of this step.
func adam_number(p: float, g: float, m: float, v: float, c: Rates): (float, float, float) {
    let nm = c.beta1 * m + (1.0 - c.beta1) * g
    let nv = c.beta2 * v + (1.0 - c.beta2) * g * g
    let np = p - c.rate * (nm / c.correct1) / (math::sqrt(nv / c.correct2) + c.eps)
    return (np, nm, nv)
}

// The same formula on whole tensors, from leaves widened to f64, left in f64: the caller stores
// the result back. Every operator is one pass over the buffer, and a pass over f64 keeps the
// double result exactly, so the three double divisions and the square root of the fused kernel
// come out the same numbers.
func adam_wide::<P, G, M, V>(p: P, g: G, m: M, v: V, c: Rates) {
    let p64 = cast(p, 'float64')
    let g64 = cast(g, 'float64')
    let m64 = cast(m, 'float64')
    let v64 = cast(v, 'float64')
    let nm = c.beta1 * m64 + (1.0 - c.beta1) * g64
    let nv = c.beta2 * v64 + (1.0 - c.beta2) * g64 * g64
    let np = p64 - c.rate * (nm / c.correct1) / (sqrt(nv / c.correct2) + c.eps)
    return (np, nm, nv)
}

// The three numbers of one leaf stored once each into f32.
func narrow_numbers(t: (float, float, float)): (f32, f32, f32) {
    return (f32(t.0), f32(t.1), f32(t.2))
}

// The three tensors of one leaf stored once each into f32, with the shape they have.
func narrow_tensors::<A, B, C>(t: (A, B, C)) {
    return (cast(t.0, 'float32'), cast(t.1, 'float32'), cast(t.2, 'float32'))
}