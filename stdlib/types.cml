/**
 * The properties of types that an applicability condition asks about. These are ordinary Camel
 * functions: each one matches the type it is given with `match type` and returns a constant, so
 * `func f::<T>(x: T) when is_float::<T>()` is applicable exactly where `T` is a float. There is
 * no run-time inspection of a type: a predicate is settled when the call is compiled.
 *
 * One family, one spelling: `is_<property>::<T>()` asks one type, and `is_same::<T, U>()` asks two.
 * The identity predicates (`is_integer`, `is_float`, `is_complex`, `is_string`, `is_bool`,
 * `is_function`) carry the `match type` cases; the others ask them (`is_numeric`, `is_ordered`,
 * `is_plain`), so a type is named in one place and a new integer width is added to `is_integer`
 * alone. A single type (`i32`, `f32`, `int`) is asked with `is_same`.
 *
 * `match type` compares a type's identity as well as its shape (design principles 5.5): the
 * cases below name the types the language spells (`int`, `i32`, `float`, `f32`, `bf16`, `f16`,
 * `c64`, `c128`, `string`, `bool`), and `case func` is the shape of every function type.
 * `bf16` and `f16` are floating-point types (design principles 7.3), so they belong to
 * `is_float` and inherit `is_numeric` and `is_ordered` from it.
 */

/// True when `T` and `U` are the same type. Identity, not shape: two named types with the same
/// fields are different, `i32` and `int` are different.
/// @example is_same::<int, int>()    // true
/// @example is_same::<i32, int>()    // false
export func is_same::<T, U>(): bool {
    return match type T {
        case U => true
        case _ => false
    }
}

/// True when `T` is an integer type (`int` is 64-bit, `i32` is 32-bit).
/// @example is_integer::<int>()    // true
/// @example is_integer::<float>()    // false
export func is_integer::<T>(): bool {
    return match type T {
        case int | i32 => true
        case _ => false
    }
}

/// True when `T` is a floating-point type (`float` is 64-bit, `f32` is 32-bit, `bf16` and
/// `f16` are the two reduced-precision floating types).
/// @example is_float::<float>()    // true
/// @example is_float::<bf16>()    // true
/// @example is_float::<int>()    // false
export func is_float::<T>(): bool {
    return match type T {
        case float | f32 | bf16 | f16 => true
        case _ => false
    }
}

/// True when `T` is a complex number (`c64` is 64-bit, `c128` is 128-bit).
/// @example is_complex::<c64>()    // true
/// @example is_complex::<float>()    // false
export func is_complex::<T>(): bool {
    return match type T {
        case c64 | c128 => true
        case _ => false
    }
}

/// True when `T` is a number: an integer, a float or a complex number.
///
/// The three families are asked, not listed again: a type spelled in one of them is numeric
/// without appearing here, so adding an integer width changes `is_integer` alone. The complex
/// branch is `is_complex`, which is why `c64` is numeric.
/// @example is_numeric::<int>()    // true
/// @example is_numeric::<string>()    // false
/// @example is_numeric::<c64>()    // true
export func is_numeric::<T>(): bool {
    return is_real::<T>() || is_complex::<T>()
}

/// True when `T` is a real number: an integer or a float. A complex number is not.
/// @example is_real::<float>()    // true
/// @example is_real::<c64>()    // false
export func is_real::<T>(): bool {
    return is_integer::<T>() || is_float::<T>()
}

/// True when `T` has a total order: the number types, `string` and `bool`.
/// @example is_ordered::<string>()    // true
/// @example is_ordered::<bool>()    // true
export func is_ordered::<T>(): bool {
    return is_real::<T>() || is_string::<T>() || is_bool::<T>()
}

/// True when `T` is a function type, whatever its parameters and result.
/// @example is_function::<(x: int) => int>()    // true
export func is_function::<T>(): bool {
    return match type T {
        case func => true
        case _ => false
    }
}

/// True when `T` is `string`.
/// @example is_string::<string>()    // true
/// @example is_string::<int>()    // false
export func is_string::<T>(): bool {
    return match type T {
        case string => true
        case _ => false
    }
}

/// True when `T` is `bool`.
/// @example is_bool::<bool>()    // true
/// @example is_bool::<int>()    // false
export func is_bool::<T>(): bool {
    return match type T {
        case bool => true
        case _ => false
    }
}

/// True when `T` is pure data: a number, `bool`, or a struct or tuple whose fields are all pure
/// data.
///
/// Pure data is what a value can be stored as itself: the bytes contain the value and every read of
/// them is the value again, because no field of the type is a reference. It is the element type an
/// array is allocated and copied for, the element type `to_bytes` writes and `from_bytes` reads, and
/// the element type the interchange with other frameworks names. A `string` holds a reference to
/// its characters, an array holds a reference to its block, and a function, an enum and a tagged
/// form hold something a copy of the bytes would not carry, so none of them is pure data.
///
/// The families are asked here as everywhere else: a number is pure data because `is_numeric` says
/// so, and a struct or tuple is asked field by field.
/// @example is_plain::<float>()    // true
/// @example is_plain::<bool>()    // true
/// @example is_plain::<{ x: int, y: f32 }>()    // true
/// @example is_plain::<string>()    // false
/// @example is_plain::<int[]>()    // false
export func is_plain::<T>(): bool {
    return match type T {
        case struct | tuple => every_field_plain::<T>()
        case _ => is_numeric::<T>() || is_bool::<T>()
    }
}

// Every field of a struct or tuple is pure data. The walk over the fields is static, like every
// other walk over a known shape: the answer is a constant of the instantiation and no field is read
// when the program runs, so a type whose fields are pure data is settled when the call is compiled.
func every_field_plain::<T>(): bool {
    return static loop every = true for n, F in fields T do every && is_plain::<F>()
}