import { now } from time
import { sqrt } from math
import { mean } from array
import { stdev } from statistics

// The durations, one per repetition, the first repetition first. `timeit` used to take the array as
// a `var` parameter and hand it on through a partial application, which is a `var` captured by a
// value; a closure may not assign an outer name (the ruling of 2026-11-15, design principles 3.5).
// The answer is a value now, so nothing is carried.
with <repeat: int>
export func timeit(fn: () => void): float[] sync {
    if repeat <= 0 then {
        return []
    } else sync {
        let start = now()
        fn()
        let duration = now() - start
        '[{:>3}] {:.6f} s'->format<repeat, duration>->println
        let rest = timeit<repeat - 1>(fn)
        return concat([duration], rest)
    }
}

with <repeat: int>
export func perfms(fn: () => void): (float, float) sync {
    let results = timeit<repeat>(fn)

    // 计算均值和标准差
    let average = mean(results) * 1000.0
    let std_dev = stdev(results) * 1000.0

    // 95% 置信区间（Z 值 1.96）
    let z_value = 1.96
    let margin_error = z_value * (std_dev / sqrt(float(repeat)))

    return (average, margin_error)
}