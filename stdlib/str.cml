/**
 * A string is always valid UTF-8, and its length and indices count Unicode code points:
 * `len('中文')` is 2 and `'中文'[0]` is `'中'`. Binary data is `Bytes`; `bytes` and `from_bytes`
 * below convert to and from the UTF-8 bytes of a string.
 * The string a function works on is its ordinary argument; everything else is a with-argument,
 * so calls chain: `s->trim->split<','>`.
 */

// The declarations of the operators of the C++ module `modules/str` (design principles 6.4;
// handover H19, step 10). This file is the one source of their signatures; the C++ side keeps the
// kernels, the executor and the operator traits. A declaration names `str:<function>` by
// convention, so no `#op` tag is needed.

module str

/// The pieces of s between occurrences of sep. An empty s gives one empty piece; a separator
/// at the start or the end gives an empty piece there.
/// @pure
/// @fails fault `InvalidArgument` when sep is empty
/// @example 'a,b,,c'->split<','>    // ['a', 'b', '', 'c']
with <sep: string>
export func split(s: string): string[]

/// s without the ASCII white space (space, tab, line feed, carriage return, vertical tab, form
/// feed) at both ends. Other white space, such as U+00A0, is kept.
/// @pure
/// @example trim('  hi \n')    // 'hi'
export func trim(s: string): string

/// s without the ASCII white space at its start.
/// @pure
/// @example trim_start('  hi  ')    // 'hi  '
export func trim_start(s: string): string

/// s without the ASCII white space at its end.
/// @pure
/// @example trim_end('  hi  ')    // '  hi'
export func trim_end(s: string): string

/// s with the ASCII letters a-z in upper case. Every other character is kept as it is, so letters
/// outside ASCII do not change: to_upper('é') is 'é'.
/// @pure
/// @example to_upper('héllo')    // 'HéLLO'
export func to_upper(s: string): string

/// s with the ASCII letters A-Z in lower case. Every other character is kept as it is.
/// @pure
/// @example to_lower('HeLLo')    // 'hello'
export func to_lower(s: string): string

/// s with every occurrence of from_ replaced by to, found from left to right without overlap.
/// @pure
/// @fails fault `InvalidArgument` when from_ is empty
/// @example 'a-b-c'->replace<'-', '+'>    // 'a+b+c'
with <from_: string, to: string>
export func replace(s: string): string

/// The index (in code points) of the first occurrence of sub in s, or null when there is none. An empty
/// sub is found at 0.
/// @pure
/// @example 'hello'->find<'l'> ?? -1    // 2
with <sub: string>
export func find(s: string): int?

/// The length characters of s that start at character start.
/// @pure
/// @fails fault `IndexOutOfRange` when start or start + length lies outside the string; fault `InvalidArgument` when length is negative
/// @example 'hello'->substr<1, 3>    // 'ell'
with <start: int, length: int>
export func substr(s: string): string

/// Whether s begins with prefix. Every string begins with the empty string.
/// @pure
/// @example 'hello'->starts_with<'he'>    // true
with <prefix: string>
export func starts_with(s: string): bool

/// Whether s ends with suffix.
/// @pure
/// @example 'hello'->ends_with<'lo'>    // true
with <suffix: string>
export func ends_with(s: string): bool

/// s written count times in a row.
/// @pure
/// @fails fault `InvalidArgument` when count is negative or the result would be longer than a string can be (4 GiB of UTF-8)
/// @example 'ab'->repeat<3>    // 'ababab'
with <count: int>
export func repeat(s: string): string

/// The bytes of s as numbers 0 to 255.
/// @pure
/// @example bytes('hé')    // [104, 195, 169]
export func bytes(s: string): int[]

/// The string made of the given UTF-8 bytes.
/// @pure
/// @fails fault `InvalidArgument` when an element is not in 0 to 255 or the bytes are not valid UTF-8 (a string is always valid UTF-8; binary data is `Bytes`)
/// @example from_bytes([104, 105])    // 'hi'
/// @example from_bytes([255])         // fault: not valid UTF-8
export func from_bytes(xs: int[]): string

// ---- code points as numbers ----

/// The code points of s.
/// @pure
/// @example codepoints('h€')    // [104, 8364]
export func codepoints(s: string): int[]

/// The string made of the given code points.
/// @pure
/// @fails error `EncodingError` when an element is not a code point (negative, above 0x10FFFF, or a surrogate)
/// @example from_codepoints([104, 8364]) !! ''    // 'h€'
export func from_codepoints(xs: int[]): string!
