/**
 * The `tensor` module: multi-dimensional numeric arrays, their element type and extents, their
 * binary form, a NumPy file, and the module's worker threads and random generator.
 *
 * The declarations written here are the operators whose signature is fixed. The ones whose element
 * type or shape follows their arguments — elementwise arithmetic, the reshaping operators, the
 * axis forms of a reduction — cannot be written as a declaration; they are implemented in
 * `modules/tensor` and listed in `stdlib/signatures/tensor.cml`, whose entries this page renders
 * under the same sections (design principles 6.4). `show`'s umbrella parameter
 * — a tensor, or any array — is written as one declaration per accepted type.
 */

// The fixed signatures of the operators of `modules/tensor` (design principles 6.4).
// This file is the one source of those signatures; the C++ side keeps the kernels, the
// executors, the operator traits, the resources and the folds (`shape`, `numel` and `dim` still
// fold from a type that fixes every extent). A declaration names `tensor:<function>` by
// convention, so no `#op` tag is needed.

module tensor

import { is_numeric } from types

// The shape of a signature (design principles 4.1 and 5.5; the language author's ruling of
// 2026-10-24 on `bare-tensor-parameter-instantiation-measured`,
// docs/handover/reviews/questions-2026-10-23.md): the element type of a tensor operand is an
// explicit type variable of the head, written `func f::<T>(x: T[..]) when is_numeric::<T>()`, and
// the call site's argument type instantiates it. That is the spelling P4's endpoint keeps: no
// signature writes the bare `Tensor` name.
//
// Two arms stand side by side here, and they take disjoint arguments, so neither shadows the
// other and no call becomes ambiguous. Each function below therefore declares the array spelling
// first (the target) and the module spelling second (the transition):
//
//   * `t: T[..]` takes a native array of any rank and any numeric element type — `f32[3]`,
//     `f32[2, 3]`, `f32[..]`, `int[3]` — and the body sees the element type the call bound.
//   * `t: Tensor` (the bare module spelling) is what the operators of this module still return:
//     `ones`, `zeros`, `new` and every elementwise operator produce the module's tensor type, and
//     a `T[..]` parameter cannot bind `T` from it while `Tensor` is a type of its own rather than
//     the array alias (`f32[..]`). Removing this arm is the rest of P4 — it needs the alias first;
//     see docs/handover/questions/bare-tensor-signature-rewrite.md for the measurement.
//
// `show` keeps the two arms it had. Its second arm is the umbrella parameter the C++ resolver had
// (a tensor, or *any* array), and a test pins that it narrows nothing: `show([])` binds the empty
// array's element type and the kernel faults at run time
// (test/plans/feat/compile/native_declarations.plan.toml, tensor_show_empty_array.cml). A third
// arm over `T[..]` would make every rank-1 numeric array ambiguous with that umbrella.

// ---- shape and reshaping ----

/// The extents of a tensor, in order.
/// @pure
/// @example shape(new([[1.0, 2.0], [3.0, 4.0]]))    // [2, 2]
export func shape::<T>(t: T[..]): int[] when is_numeric::<T>()
export func shape(t: Tensor): int[]

/// The number of elements in a tensor: the product of its extents.
/// @pure
/// @example numel(zeros([2, 3]))    // 6
export func numel::<T>(t: T[..]): int when is_numeric::<T>()
export func numel(t: Tensor): int

/// The extent of one axis; a negative axis counts from the last one (`-1` is the last axis).
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank
/// @example dim(new([[1.0, 2.0], [3.0, 4.0]]), 1)    // 2
export func dim::<T>(t: T[..], axis: int): int when is_numeric::<T>()
export func dim::<T>(t: T[..], axis: i32): int when is_numeric::<T>()
export func dim(t: Tensor, axis: int): int
export func dim(t: Tensor, axis: i32): int

// ---- binary form ----

/// The elements of a tensor as little-endian bytes, in row-major order: the payload `from_bytes`
/// reads back.
/// @pure
/// @example to_bytes(new([1.0, 2.0]))    // [0, 0, 128, 63, 0, 0, 0, 64]
export func to_bytes::<T>(t: T[..]): Bytes when is_numeric::<T>()
export func to_bytes(t: Tensor): Bytes

/// The tensor a NumPy `.npy` file holds: its element type and extents are the file's, known when
/// the program runs (check them with `as`, or read them with `shape`).
/// @effect reads a file
/// @fails fault `RuntimeError` when the file is missing, is not a NumPy file, or holds a storage type the module does not read
/// @example load_npy('x.npy') as Tensor<f32, [2, 2]>
export func load_npy(path: string): Tensor

/// Writes a tensor to a NumPy `.npy` file, replacing it.
/// @effect writes a file
/// @fails fault `RuntimeError` when the file cannot be written
/// @example save_npy(zeros([2, 2]), 'x.npy')
export func save_npy::<T>(t: T[..], path: string): void when is_numeric::<T>()
export func save_npy(t: Tensor, path: string): void

// ---- conversion and display ----

/// Prints t to the console, in the module's layout.
/// @effect writes the console
/// @example show(new([[1.0, 2.0]]))
export func show(t: Tensor): void
export func show::<A>(t: A[]): void

// ---- module state ----

/// The size of the module's worker pool.
/// @effect reads the size of the worker pool
/// @example num_threads()
export func num_threads(): int

/// Sets the size of the module's worker pool; a value below 1 is read as 1.
/// @effect changes the size of the worker pool
/// @example set_num_threads(4)
export func set_num_threads(n: int): void
export func set_num_threads(n: i32): void

/// The name of the matrix-multiplication kernel the module dispatches to.
/// @pure
/// @example gemm_backend()
export func gemm_backend(): string

/// The thread count the matrix multiplication had for its most recent call: the tensor-pool
/// chunks that split a whole-work library product, the worker pool's width for a canonical call,
/// and 1 inside a region or for a library call inside a batch chunk. The count is what one
/// product got: `num_threads()` is what the run was given, and this is what one product spent.
/// @effect reads the size of the worker pool
/// @example gemm_threads()
export func gemm_threads(): int

/// The library's own thread count for the most recent call: 1 when a library call ran (each chunk
/// of a split product is one such call), 0 when the canonical kernel did. `gemm_threads()` is the
/// pool that split the product; this is what each of its library calls got.
/// @effect reads the thread count of the last library call
/// @example gemm_library_threads()
export func gemm_library_threads(): int

/// The name of the matrix-multiplication kernel the library path calls: `cblas` in a build with a
/// CBLAS, otherwise the canonical kernel's name, which is what the path forwards to.
/// @pure
/// @example gemm_library()
export func gemm_library(): string

/// Reseeds the module's random generator, which `random` and `randn` draw from.
/// @effect writes the random generator
/// @example seed(42)
export func seed(seed: int): void
export func seed(seed: i32): void

// -----------------------------------------------------------------------------
// Passes: functions the pipeline applies to the program
// -----------------------------------------------------------------------------

/// Writes the implementation choices of the tensor operators as node attributes, changing no
/// operator (design principles 9.3). `safe_fp` keeps a matmul on the canonical algorithm (design
/// principles 7.4); the default lets a matmul the 7.3 rule permits use the library GEMM.
with <safe_fp: bool = false>
export func fuse::<F>(f: F): F! when is_function::<F>()
