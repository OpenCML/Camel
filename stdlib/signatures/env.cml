/**
 * Signatures of the `env` module (C++ operators, modules/env).
 *
 * Both functions read the environment of the process and are declared with effects.
 *
 * For reference only: these declarations are not compiled. They are checked against the
 * operators the module registers, and docs/stdlib-reference.md is generated from them
 * (scripts/stdlib-reference.mjs).
 */

/// The value of an environment variable, or the empty string when it is not set.
/// @effect reads the environment
/// @example get_env('HOME')    // '/home/alice'
export func get_env(name: string): string

/// The current working directory.
/// @effect reads the environment
/// @example get_cwd()    // '/home/alice/project'
export func get_cwd(): string
