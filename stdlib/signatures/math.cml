/**
 * The computed signatures of the `math` module: the operators whose result type C++ computes
 * from the argument, so a declaration cannot state it (`sqrt` converts an integer argument to
 * the corresponding float type; `shl`/`shr` take the type of their first argument and accept a
 * count of either integer type). The C++ operators in `modules/math` are the one source of these
 * types; this file is for reference only (it is not compiled) and feeds
 * `docs/stdlib-reference.md` and the `--verify-ops` check. The fixed signatures are declared in
 * `stdlib/math.cml` (design principles 6.4; handover H19, H113, H180).
 *
 * The section lines follow `stdlib/math.cml`, including the sections that hold no computed
 * signature, so the reference page reads in the module's order (handover H180).
 */

// ---- constants ----

// ---- elementary functions ----

/// The square root. An integer argument is converted: i32 gives f32, int gives float.
/// @pure
/// @example sqrt(9.0)    // 3
export func sqrt(x: i32): f32
export func sqrt(x: int): float
export func sqrt(x: f32): f32
export func sqrt(x: float): float

// ---- rounding ----

// ---- comparing ----

// ---- integers ----

// ---- bits ----

/// x shifted left by count bits: bits shifted out are lost and zeros come in, so the sign may
/// change. The count may be of either integer type.
/// @pure
/// @fails fault `InvalidArgument` when count is negative or not below the width of x (64 for int, 32 for i32)
/// @example shl(1, 4)    // 16
export func shl(x: i32, count: i32): i32
export func shl(x: int, count: int): int

/// x shifted right by count bits, keeping the sign (an arithmetic shift): shr(-8, 1) is -4.
/// @pure
/// @fails fault `InvalidArgument` when count is negative or not below the width of x
/// @example shr(256, 4)    // 16
export func shr(x: i32, count: i32): i32
export func shr(x: int, count: int): int