/**
 * Signatures of the `math` module (C++ operators, modules/math).
 *
 * Numeric types are not converted implicitly. A function over floats takes `f32` or `float`
 * and returns the type it was given; a function of several numbers takes numbers of one type.
 * Outside its domain a float function gives the IEEE result (NaN or an infinity), not a fault.
 * A constant is a value, written without parentheses: `pi`.
 *
 * For reference only: these declarations are not compiled. They are checked against the
 * operators the module registers, and docs/stdlib-reference.md is generated from them
 * (scripts/stdlib-reference.mjs).
 */

// ---- constants ----
// Values the module exports (design principles 10.1), written without parentheses.

/// The ratio of a circle's circumference to its diameter.
/// @example pi    // 3.14159...
export let pi: float = 3.141592653589793

/// The base of the natural logarithm.
/// @example log(e)    // 1
export let e: float = 2.718281828459045

/// Positive infinity; negative infinity is -inf.
/// @example is_inf(-inf)    // true
export let inf: float = 1.0e308 * 10.0

/// A NaN. It equals nothing, itself included: test with is_nan.
/// @example is_nan(nan)    // true
export let nan: float = inf - inf

// ---- elementary functions ----

/// The absolute value. The smallest integer has no positive counterpart: its absolute value is
/// not defined.
/// @pure
/// @example abs(-3)    // 3
#op<'math:abs_*'>
export func abs(x: i32): i32
#op<'math:abs_*'>
export func abs(x: int): int
#op<'math:abs_*'>
export func abs(x: f32): f32
#op<'math:abs_*'>
export func abs(x: float): float
#op<'math:abs_*'>
export func abs(x: c64): f32
#op<'math:abs_*'>
export func abs(x: c128): float

/// The real part of a complex number.
/// @pure
/// @example re(3+4i)    // 3.0
#op<'math:re_*'>
export func re(x: c64): f32
#op<'math:re_*'>
export func re(x: c128): float

/// The imaginary part of a complex number.
/// @pure
/// @example im(3+4i)    // 4.0
#op<'math:im_*'>
export func im(x: c64): f32
#op<'math:im_*'>
export func im(x: c128): float

/// The conjugate of a complex number: the imaginary part is negated.
/// @pure
/// @example conj(3+4i)    // 3-4i
#op<'math:conj_*'>
export func conj(x: c64): c64
#op<'math:conj_*'>
export func conj(x: c128): c128

/// The square root. An integer argument is converted: i32 gives f32, int gives float.
/// @pure
/// @example sqrt(9.0)    // 3
export func sqrt(x: i32): f32
export func sqrt(x: int): float
export func sqrt(x: f32): f32
export func sqrt(x: float): float

/// e raised to the power x.
/// @pure
/// @example exp(0.0)    // 1
#op<'math:exp_*'>
export func exp(x: f32): f32
#op<'math:exp_*'>
export func exp(x: float): float
#op<'math:exp_*'>
export func exp(x: c64): c64
#op<'math:exp_*'>
export func exp(x: c128): c128

/// exp(x) - 1, accurate for x near 0.
/// @pure
/// @example expm1(0.0)    // 0
#op<'math:expm1_*'>
export func expm1(x: f32): f32
#op<'math:expm1_*'>
export func expm1(x: float): float

/// The natural logarithm. log(0.0) is -inf, the logarithm of a negative number is NaN.
/// @pure
/// @example log(1.0)    // 0
#op<'math:log_*'>
export func log(x: f32): f32
#op<'math:log_*'>
export func log(x: float): float

/// The logarithm to base 2.
/// @pure
/// @example log2(8.0)    // 3
#op<'math:log2_*'>
export func log2(x: f32): f32
#op<'math:log2_*'>
export func log2(x: float): float

/// The logarithm to base 10.
/// @pure
/// @example log10(1000.0)    // 3
#op<'math:log10_*'>
export func log10(x: f32): f32
#op<'math:log10_*'>
export func log10(x: float): float

/// log(1 + x), accurate for x near 0.
/// @pure
/// @example log1p(0.0)    // 0
#op<'math:log1p_*'>
export func log1p(x: f32): f32
#op<'math:log1p_*'>
export func log1p(x: float): float

/// x raised to the power y. pow(0.0, 0.0) is 1; a negative x with a fractional y gives NaN.
/// @pure
/// @example pow(2.0, 10.0)    // 1024
#op<'math:pow_*'>
export func pow(x: f32, y: f32): f32
#op<'math:pow_*'>
export func pow(x: float, y: float): float

/// The square root of x*x + y*y, without overflow in the squares.
/// @pure
/// @example hypot(3.0, 4.0)    // 5
#op<'math:hypot_*'>
export func hypot(x: f32, y: f32): f32
#op<'math:hypot_*'>
export func hypot(x: float, y: float): float

/// The sine of x, x in radians.
/// @pure
/// @example sin(0.0)    // 0
#op<'math:sin_*'>
export func sin(x: f32): f32
#op<'math:sin_*'>
export func sin(x: float): float

/// The cosine of x, x in radians.
/// @pure
/// @example cos(0.0)    // 1
#op<'math:cos_*'>
export func cos(x: f32): f32
#op<'math:cos_*'>
export func cos(x: float): float

/// The tangent of x, x in radians.
/// @pure
/// @example tan(0.0)    // 0
#op<'math:tan_*'>
export func tan(x: f32): f32
#op<'math:tan_*'>
export func tan(x: float): float

/// The arc sine, in radians; NaN outside -1 to 1.
/// @pure
/// @example asin(1.0)    // 1.5708
#op<'math:asin_*'>
export func asin(x: f32): f32
#op<'math:asin_*'>
export func asin(x: float): float

/// The arc cosine, in radians; NaN outside -1 to 1.
/// @pure
/// @example acos(1.0)    // 0
#op<'math:acos_*'>
export func acos(x: f32): f32
#op<'math:acos_*'>
export func acos(x: float): float

/// The arc tangent, in radians.
/// @pure
/// @example atan(1.0)    // 0.785398
#op<'math:atan_*'>
export func atan(x: f32): f32
#op<'math:atan_*'>
export func atan(x: float): float

/// The angle of the point (x, y) in radians, between -pi and pi. Note the order: y first.
/// @pure
/// @example atan2(1.0, 1.0)    // 0.785398
#op<'math:atan2_*'>
export func atan2(y: f32, x: f32): f32
#op<'math:atan2_*'>
export func atan2(y: float, x: float): float

/// The hyperbolic sine.
/// @pure
/// @example sinh(0.0)    // 0
#op<'math:sinh_*'>
export func sinh(x: f32): f32
#op<'math:sinh_*'>
export func sinh(x: float): float

/// The hyperbolic cosine.
/// @pure
/// @example cosh(0.0)    // 1
#op<'math:cosh_*'>
export func cosh(x: f32): f32
#op<'math:cosh_*'>
export func cosh(x: float): float

/// The hyperbolic tangent.
/// @pure
/// @example tanh(0.0)    // 0
#op<'math:tanh_*'>
export func tanh(x: f32): f32
#op<'math:tanh_*'>
export func tanh(x: float): float

// ---- rounding ----

/// The largest whole number not above x, as a float.
/// @pure
/// @example floor(-2.5)    // -3
#op<'math:floor_*'>
export func floor(x: f32): f32
#op<'math:floor_*'>
export func floor(x: float): float

/// The smallest whole number not below x, as a float.
/// @pure
/// @example ceil(2.1)    // 3
#op<'math:ceil_*'>
export func ceil(x: f32): f32
#op<'math:ceil_*'>
export func ceil(x: float): float

/// The nearest whole number, halves away from zero, as a float.
/// @pure
/// @example round(2.5)    // 3
#op<'math:round_*'>
export func round(x: f32): f32
#op<'math:round_*'>
export func round(x: float): float

/// x without its fraction (rounded toward zero), as a float.
/// @pure
/// @example trunc(-2.7)    // -2
#op<'math:trunc_*'>
export func trunc(x: f32): f32
#op<'math:trunc_*'>
export func trunc(x: float): float

// ---- comparing ----

/// The smaller of two numbers of one type (IEEE 754 minimum). With a NaN on either side
/// the result is NaN; -0 is below +0.
/// @pure
/// @example min(3, 5)    // 3
#op<'math:min_*'>
export func min(a: i32, b: i32): i32
#op<'math:min_*'>
export func min(a: int, b: int): int
#op<'math:min_*'>
export func min(a: f32, b: f32): f32
#op<'math:min_*'>
export func min(a: float, b: float): float

/// The larger of two numbers of one type (IEEE 754 maximum). With a NaN on either side
/// the result is NaN; -0 is below +0.
/// @pure
/// @example max(3, 5)    // 5
#op<'math:max_*'>
export func max(a: i32, b: i32): i32
#op<'math:max_*'>
export func max(a: int, b: int): int
#op<'math:max_*'>
export func max(a: f32, b: f32): f32
#op<'math:max_*'>
export func max(a: float, b: float): float

/// x held between lo and hi: lo when x is below, hi when above. A NaN x stays NaN.
/// @pure
/// @fails fault `InvalidArgument` when lo is above hi, or a bound is NaN
/// @example clamp(15, 0, 10)    // 10
#op<'math:clamp_*'>
export func clamp(x: i32, lo: i32, hi: i32): i32
#op<'math:clamp_*'>
export func clamp(x: int, lo: int, hi: int): int
#op<'math:clamp_*'>
export func clamp(x: f32, lo: f32, hi: f32): f32
#op<'math:clamp_*'>
export func clamp(x: float, lo: float, hi: float): float

/// -1, 0 or 1 by the sign of x, in the type of x. The sign of a NaN is NaN.
/// @pure
/// @example sign(-2.5)    // -1
#op<'math:sign_*'>
export func sign(x: i32): i32
#op<'math:sign_*'>
export func sign(x: int): int
#op<'math:sign_*'>
export func sign(x: f32): f32
#op<'math:sign_*'>
export func sign(x: float): float

/// Whether x is a NaN.
/// @pure
/// @example is_nan(inf - inf)    // true
#op<'math:is_nan_*'>
export func is_nan(x: f32): bool
#op<'math:is_nan_*'>
export func is_nan(x: float): bool

/// Whether x is positive or negative infinity.
/// @pure
/// @example is_inf(1.0)    // false
#op<'math:is_inf_*'>
export func is_inf(x: f32): bool
#op<'math:is_inf_*'>
export func is_inf(x: float): bool

// ---- integers ----

/// The greatest common divisor, never negative; gcd(0, 0) is 0.
/// @pure
/// @fails fault `InvalidArgument` when the result does not fit the type (the smallest integer with itself or with 0)
/// @example gcd(12, 18)    // 6
#op<'math:gcd_*'>
export func gcd(a: i32, b: i32): i32
#op<'math:gcd_*'>
export func gcd(a: int, b: int): int

/// The least common multiple, never negative; 0 when either argument is 0.
/// @pure
/// @fails fault `InvalidArgument` when the result does not fit the type
/// @example lcm(4, 6)    // 12
#op<'math:lcm_*'>
export func lcm(a: i32, b: i32): i32
#op<'math:lcm_*'>
export func lcm(a: int, b: int): int

/// The digits of x in base 2 with the prefix 0b; a negative number is shown as its 64-bit
/// two's complement.
/// @pure
/// @example bin(5)    // '0b101'
#op<'math:bin_*'>
export func bin(x: i32): string
#op<'math:bin_*'>
export func bin(x: int): string

/// The digits of x in base 8 with the prefix 0o.
/// @pure
/// @example oct(8)    // '0o10'
#op<'math:oct_*'>
export func oct(x: i32): string
#op<'math:oct_*'>
export func oct(x: int): string

/// The digits of x in base 16, in upper case, with the prefix 0x.
/// @pure
/// @example hex(255)    // '0xFF'
#op<'math:hex_*'>
export func hex(x: i32): string
#op<'math:hex_*'>
export func hex(x: int): string

// ---- bits ----
//
// Bit operations are functions, not operators. Integers are two's complement: `int` has 64
// bits, `i32` has 32.

/// The bits set in both a and b.
/// @pure
/// @example bit_and(12, 10)    // 8
#op<'math:bit_and_*'>
export func bit_and(a: i32, b: i32): i32
#op<'math:bit_and_*'>
export func bit_and(a: int, b: int): int

/// The bits set in a or in b.
/// @pure
/// @example bit_or(12, 10)    // 14
#op<'math:bit_or_*'>
export func bit_or(a: i32, b: i32): i32
#op<'math:bit_or_*'>
export func bit_or(a: int, b: int): int

/// The bits set in exactly one of a and b.
/// @pure
/// @example bit_xor(12, 10)    // 6
#op<'math:bit_xor_*'>
export func bit_xor(a: i32, b: i32): i32
#op<'math:bit_xor_*'>
export func bit_xor(a: int, b: int): int

/// Every bit of x inverted; the same as the operator ~.
/// @pure
/// @example bit_not(0)    // -1
#op<'math:bit_not_*'>
export func bit_not(x: i32): i32
#op<'math:bit_not_*'>
export func bit_not(x: int): int

/// x shifted left by count bits: bits shifted out are lost and zeros come in, so the sign may
/// change. The count may be of either integer type.
/// @pure
/// @fails fault `InvalidArgument` when count is negative or not below the width of x (64 for int, 32 for i32)
/// @example shl(1, 4)    // 16
export func shl(x: i32, count: i32): i32
export func shl(x: int, count: int): int

/// x shifted right by count bits, keeping the sign (an arithmetic shift): shr(-8, 1) is -4.
/// @pure
/// @fails fault `InvalidArgument` when count is negative or not below the width of x
/// @example shr(256, 4)    // 16
export func shr(x: i32, count: i32): i32
export func shr(x: int, count: int): int
