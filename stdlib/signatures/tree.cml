// Signatures of the parameter-tree module: operations on a value made of structs and tuples
// (design principles 2.16, 2.17), and the checkpoints that save such a value to a directory and
// read it back. These declarations are reference metadata.
//
// A tree is a struct or an ordinary tuple (not a `T?`/`T!`) and everything else is a leaf; the
// leaves come depth first in declaration order. The path of a leaf is its field names (tuple
// indices) joined by dots, `blocks.0.w`; the root's path is empty. The tree operations are
// expanded by the compiler, for the types of the call, into ordinary nodes; a checkpoint's
// file for a leaf is named by the same path.

/// Applies f to the leaves in the same place of the trees (one tree, or several of the same
/// shape: the callback then takes one leaf of each), and gives a tree of the results. The shape
/// is that of the first tree.
/// @effect whatever the callback does
/// @example tree_map<(x: int): int => x + 1>({ a: 1, b: (2, 3) })    // { a: 2, b: (3, 4) }
with <f: (leaf: A) => B>
inner func tree_map(tree: T): U {
    return 'tree:tree_map'
}

/// Folds the leaves from the first to the last with f, starting from init.
/// @effect whatever the callback does
/// @example tree_reduce<(acc: int, x: int): int => acc + x>({ a: 1, b: (2, 3) }, 0)    // 6
with <f: (acc: R, leaf: A) => R>
inner func tree_reduce(tree: T, init: R): R {
    return 'tree:tree_reduce'
}

/// Turns a tree of tuples into a tuple of trees: the shape is that of `reference`, and every
/// leaf of `tree` at a leaf of the reference is a tuple of the same length.
/// @pure
/// @example tree_unzip({ a: (1, 2.0) }, { a: 0 })    // ({ a: 1 }, { a: 2.0 })
inner func tree_unzip(tree: T, reference: S): U {
    return 'tree:tree_unzip'
}

/// The leaves of a tree, as a tuple.
/// @pure
/// @example tree_leaves({ a: 1, b: (2, 3) })    // (1, 2, 3)
inner func tree_leaves(tree: T): L {
    return 'tree:tree_leaves'
}

/// The paths of the leaves, as a tree of the same shape.
/// @pure
/// @example tree_paths({ a: 1, b: (2, 3) })    // { a: 'a', b: ('b.0', 'b.1') }
inner func tree_paths(tree: T): P {
    return 'tree:tree_paths'
}

/// Saves a tree to a directory, one file per leaf named by its path (`blocks.0.w.npy` for a
/// tensor), with a manifest that records the types, sizes and SHA-256 sums. The directory is
/// replaced as a whole or not at all. A leaf type a checkpoint cannot hold (anything but a
/// tensor, `Bytes`, `string`, `bool`, `i32`, `int`, `f32`, `f64`) is a compile-time error that
/// names the path.
/// @effect writes the directory
/// @fails fault `FileSystemError` when the directory cannot be written
/// @example save_tree('out/ckpt', { w: zeros([2, 2]), step: 10 })
inner func save_tree(dir: string, tree: T, dataset_manifest_sha256: string): void {
    return 'tree:save_tree'
}

/// Reads a tree of the type T back from a directory `save_tree` wrote, checking the structure,
/// the types, the sizes and the SHA-256 sums first: a directory that does not fit T is a
/// `CheckpointError` value, nothing is partly loaded. T is the explicit type argument or the
/// expected type of the result.
/// @effect reads the directory
/// @example load_tree::<{ w: Tensor<f32>, step: int }>('out/ckpt') !! initial()
inner func load_tree(dir: string, dataset_manifest_sha256: string): T! {
    return 'tree:load_tree'
}
