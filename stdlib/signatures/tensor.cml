/**
 * The computed signatures of the `tensor` module: the operators whose element type or shape
 * follows their arguments, so a declaration cannot state them (a declaration has one signature
 * per name, and no `TensorLike`, `TensorOrScalar` or optional parameter). The C++ operators in
 * `modules/tensor` are the one source of these types; this file is for reference only (it is not
 * compiled) and feeds `docs/stdlib-reference.md` and the `--verify-ops` check. The fixed
 * signatures are declared in `stdlib/tensor.cml` (design principles 6.4).
 */

// ---- creation ----

/// An array of the given extents whose elements are all 0. The element type is written
/// (`zeros::<f32>([2, 3])`) or comes from the position of the call (`let x: f32[2, 3] =
/// zeros([2, 3])`); there is no default.
/// @pure
/// @example zeros::<f32>([2, 3])
export func zeros::<T>(shape: int[]): T[..] when is_numeric::<T>()

/// An array of the given extents whose elements are all 1; the element type is the call's, as for
/// `zeros`.
/// @pure
/// @example ones::<f32>([2, 3])
export func ones::<T>(shape: int[]): T[..] when is_numeric::<T>()

/// A tensor of the given extents whose elements are all value; the element type is the value's.
/// @pure
/// @example full([2, 2], -1.0)
export func full(shape: int[], value: number): float[..]

/// The n by n identity matrix; the element type is the call's, as for `zeros`.
/// @pure
/// @example eye::<f32>(2)
export func eye::<T>(n: int): T[..] when is_numeric::<T>()

// ---- elementwise ----

/// IEEE 754-2019 maximum per element, with NumPy broadcasting: NaN on either side gives the
/// canonical quiet NaN, and -0 is below +0.
/// @pure
/// @example maximum([1.0, -0.0] as float[], 0.0)    // [1.0, 0.0]
export func maximum(lhs: float[..] | number, rhs: float[..] | number): float[..]

/// IEEE 754-2019 minimum per element, with NumPy broadcasting: NaN on either side gives the
/// canonical quiet NaN, and -0 is below +0.
/// @pure
/// @example minimum([1.0, -0.0] as float[], 0.0)    // [0.0, -0.0]
export func minimum(lhs: float[..] | number, rhs: float[..] | number): float[..]

/// lhs where cond holds, rhs elsewhere, broadcast to one shape; the element type is the wider of
/// lhs and rhs.
/// @pure
/// @example where([true, false] as bool[], [1.0, 2.0] as float[], 0.0)    // [1.0, 0.0]
export func where(cond: bool[..], lhs: float[..] | number, rhs: float[..] | number): float[..]

/// |x| per element: the sign cleared.
/// @pure
/// @example abs([-1.5, 2.0] as float[])    // [1.5, 2.0]
export func abs(t: float[..]): float[..]

/// e^x per element, within 2 ulp, subnormal results included.
/// @pure
/// @example exp([0.0, 1.0] as float[])    // [1.0, 2.7182817]
export func exp(t: float[..]): float[..]

/// ln x per element, within 2 ulp; NaN, +-inf, +-0 and negative x are exact (negative x gives
/// NaN).
/// @pure
/// @example log([1.0, 2.7182817] as float[])    // [0.0, 1.0]
export func log(t: float[..]): float[..]

/// sqrt(x) per element, rounded once in `f32`.
/// @pure
/// @example sqrt([4.0, 9.0] as float[])    // [2.0, 3.0]
export func sqrt(t: float[..]): float[..]

/// 1 / sqrt(x) per element: two steps, each rounded in `f32`.
/// @pure
/// @example rsqrt([4.0] as float[])    // [0.5]
export func rsqrt(t: float[..]): float[..]

/// The logistic function 1 / (1 + e^-x) per element.
/// @pure
/// @example sigmoid([0.0] as float[])    // [0.5]
export func sigmoid(t: float[..]): float[..]

/// The hyperbolic tangent per element.
/// @pure
/// @example tanh([0.0] as float[])    // [0.0]
export func tanh(t: float[..]): float[..]

/// maximum(x, +0) per element: NaN gives the canonical NaN, and -0 gives +0.
/// @pure
/// @example relu([-1.0, 2.0] as float[])    // [0.0, 2.0]
export func relu(t: float[..]): float[..]

/// The Gaussian error linear unit per element, computed as its normative definition in Camel.
/// @pure
/// @example gelu([0.0] as float[])    // [0.0]
export func gelu(t: float[..]): float[..]

/// The Gauss error function per element.
/// @pure
/// @example erf([0.0] as float[])    // [0.0]
export func erf(t: float[..]): float[..]

// ---- shape and reshaping ----

/// The elements in row-major order, in a new shape; one extent may be -1, which the element
/// count fills.
/// @pure
/// @example reshape<[2, 2]>([1.0, 2.0, 3.0, 4.0] as float[])
export func reshape(t: float[..] | number[], shape: int[]): float[..]

/// The elements unchanged, with an axis of extent 1 added at axis.
/// @pure
/// @example unsqueeze<0>([1.0, 2.0] as float[])    // shape [1, 2]
export func unsqueeze(t: float[..], axis: int): float[..]

/// The last two axes swapped (a vector becomes a column, a matrix its transpose).
/// @pure
/// @example transpose([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])
export func transpose(t: float[..]): float[..]

/// The axes reordered as perm lists them.
/// @pure
/// @example permute<[1, 0]>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])
export func permute(t: float[..], perm: int[]): float[..]

/// a and b joined along axis; every other extent must agree.
/// @pure
/// @example concat<0>([[1.0]] as float[1, 1], [[2.0]] as float[1, 1])    // shape [2, 1]
export func concat(a: float[..] | number[], b: float[..] | number[], axis: int): float[..]

/// The entries of the first axis that indices name, in that order.
/// @pure
/// @fails fault `RuntimeError` when an index is outside the first axis
/// @example take([[1.0], [2.0], [3.0]] as float[3, 1], [2, 0])    // [[3.0], [1.0]]
export func take(t: float[..], indices: int64[..] | number[]): float[..]

/// Each label (an integer below classes) expanded to a row of classes with a 1 at its position:
/// an `int64` tensor of shape [labels, classes].
/// @pure
/// @fails fault `IndexOutOfRange` when a label is outside [0, classes), and fault `InvalidArgument` when classes is negative
/// @example one_hot([0, 2] as int[], 3)    // [[1, 0, 0], [0, 0, 1]]
export func one_hot(labels: int64[..] | number[], classes: int): int64[..]

// ---- reduction ----

/// The sum of every element, in the operand's element type: the canonical form of the element
/// type `T` is `sum::<T>(x: T[..]): T = T(sum(float(x)))`, so the elements are widened into an
/// `f64` accumulator (`float(x)`), the additions happen in `f64` in row-major order from +0, and
/// their sum is rounded into `T` once, at the end — the same element type and the same one
/// rounding as the axis form below, so the full form and the axis form agree bit for bit
/// (design principles 7.3). An `int64`, `int32` or `bool` tensor has no float accumulator: it is
/// summed exactly in `int64`, wrapping on overflow as integer arithmetic does (design principles
/// 5.1, 7.7), and that exact value is the answer — `int64` as it stands, `int32` truncated into
/// its element type, `bool` as `int64`.
/// @pure
/// @example sum([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // 10.0
export func sum::<T>(t: T[..]): T

/// The same sum over one axis, in an `f64` accumulator; keepdims keeps the axis with extent 1.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank
/// @example sum<0>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // [4.0, 6.0]
#op('tensor:sum_axis')
export func sum(t: float[..], axis: int, keepdims?: bool): float[..]

/// The mean of every element, in the operand's element type, with one rounding: the canonical
/// form of the element type `T` is `mean::<T>(x: T[..]): T = T(sum(float(x)) / float(numel(x)))`.
/// The sum and the division by the element count both happen in `f64`, and their result is
/// rounded into `T` once — never a sum rounded to the element type and divided again, which
/// would round twice. A mean of an integer or bool tensor is `f32`, as by axis; an empty tensor
/// is a fault.
/// @pure
/// @fails fault `DivisionByZero` when the tensor has no element
/// @example mean([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // 2.5
export func mean::<T>(t: T[..]): T

/// The same mean over one axis; keepdims keeps the axis with extent 1.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank, and fault `DivisionByZero` when the axis is empty
/// @example mean<1>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // [1.5, 3.5]
#op('tensor:mean_axis')
export func mean(t: float[..], axis: int, keepdims?: bool): float[..]

/// IEEE 754-2019 maximum over the axis (exactly associative and commutative: any order gives
/// the same bits); keepdims keeps the axis with extent 1.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank, and fault `RuntimeError` when the axis is empty
/// @example max<0>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // [3.0, 4.0]
#op('tensor:max_axis')
export func max(t: float[..], axis: int, keepdims?: bool): float[..]

/// IEEE 754-2019 minimum over the axis (exactly associative and commutative); keepdims keeps the
/// axis with extent 1.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank, and fault `RuntimeError` when the axis is empty
/// @example min<1>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // [1.0, 3.0]
#op('tensor:min_axis')
export func min(t: float[..], axis: int, keepdims?: bool): float[..]

/// The position (`int64`) of the first maximum over the axis by IEEE 754-2019 maximum: the first
/// NaN if there is one, +0 above -0, the earlier position on a tie.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank, and fault `RuntimeError` when the axis is empty
/// @example argmax<1>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // [1, 1]
#op('tensor:argmax_axis')
export func argmax(t: float[..], axis: int, keepdims?: bool): int64[..]

/// The position (`int64`) of the first minimum over the axis by IEEE 754-2019 minimum: the first
/// NaN if there is one, -0 below +0, the earlier position on a tie.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank, and fault `RuntimeError` when the axis is empty
/// @example argmin<0>([[1.0, 2.0], [3.0, 4.0]] as float[2, 2])    // [0, 0]
#op('tensor:argmin_axis')
export func argmin(t: float[..], axis: int, keepdims?: bool): int64[..]

/// The softmax over the axis (-1, the last axis, by default), computed as its normative
/// definition in Camel, in `f32`.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank
/// @example softmax([[1.0, 1.0]] as float[1, 2])    // [[0.5, 0.5]]
export func softmax(t: f32[..], axis?: int): f32[..]

/// The log of the softmax over the axis (-1 by default), computed as its normative definition in
/// Camel, in `f32`.
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank
/// @example log_softmax([[1.0, 1.0]] as float[1, 2])    // [[-0.6931472, -0.6931472]]
export func log_softmax(t: f32[..], axis?: int): f32[..]

/// The gradient of the softmax of y with the incoming gradient dy, over the axis (-1 by default).
/// @pure
/// @fails fault `RuntimeError` when the axis is outside the rank
/// @example softmax_grad(y, dy)
export func softmax_grad(y: f32[..], dy: f32[..], axis?: int): f32[..]

/// Layer normalization of x with gamma and beta, whose extents are the trailing ones of x, over
/// the trailing axes; eps is 1e-5 by default. The result is `f32`.
/// @pure
/// @fails fault `TensorDimensionMismatch` when gamma or beta does not match the trailing extents of x
/// @example layer_norm(x, gamma, beta)
export func layer_norm(x: f32[..], gamma: f32[..], beta: f32[..], eps?: number): f32[..]

// ---- linear algebra ----

/// The matrix product of lhs and rhs: per output element acc = +0, then acc = fma(a[i][k],
/// b[k][j], acc) for k ascending, every fused multiply-add rounded once in `f32`.
/// @pure
/// @fails fault `TensorDimensionMismatch` when the inner extents do not agree
/// @example matmul([[1.0, 2.0]] as float[1, 2], [[3.0], [4.0]] as float[2, 1])    // [[11.0]]
export func matmul(lhs: float[..], rhs: float[..]): float[..]

/// The affine transform of x by a rank-2 weight [in, out] whose rows are the features of x, plus
/// a rank-1 bias [out] when given.
/// @pure
/// @fails fault `TensorDimensionMismatch` when the features of x are not the rows of weight, or bias is not rank 1 of the output extent
/// @example linear(x, weight, bias)
export func linear(x: f32[..], weight: f32[..], bias?: f32[..]): f32[..]

// ---- gradient ----

/// A tensor of zeros shaped and typed like t.
/// @pure
/// @example zeros_like([[1.0, 2.0]] as float[1, 2])
export func zeros_like(t: float[..]): float[..]

/// A tensor of ones shaped and typed like t.
/// @pure
/// @example ones_like([[1.0, 2.0]] as float[1, 2])
export func ones_like(t: float[..]): float[..]

// ---- conversion and display ----

// `show` is declared: its result is fixed `void` and its umbrella parameter is two declarations
// (a tensor, and any array). See `stdlib/tensor.cml`.

// `load_npy` is computed: the element type of its result is the one the call declares, and a
// declaration's parameters cannot mention a type variable that only the result mentions. Its
// group is `loadNpyOperatorGroup` in `modules/tensor` (the `#op` tag below names its rules): one
// per element type a `.npy` file can hold.

/// The tensor a NumPy `.npy` file holds, as the element type the program declares: the extents are
/// the file's (read them with `shape`, or check them with `as`), and the file's element type must
/// be `T` -- a file of another element type is a fault, never a conversion (design principles 5.1,
/// 5.5). `T` is `f32`, `f64`, `i32`, `i64` or `bool`, the element types the format's storage types
/// (`'<f4'`, `'<f8'`, `'<i4'`, `'<i8'`, `'|b1'`) map to, exactly the type given. It is written at
/// the call (`load_npy::<f32>(p)`) or taken from the type of the position the call stands in
/// (`f32[3]`, `f32[..]`); `T` is the one type variable no parameter mentions, so a call
/// that says neither is not a use of this operator.
/// @effect reads a file
/// @fails fault `RuntimeError` when the file is missing, is not a NumPy file, holds a storage type the module does not read, or holds another element type than `T`
/// @example load_npy::<f32>('x.npy')
#op('tensor:load_npy_*')
export func load_npy::<T>(path: string): T[..]

// ---- binary form ----

/// An array of the given shape made of little-endian elements: the payload `to_bytes` wrote. The
/// element type is the explicit type argument (`from_bytes::<f32>(b, [2])`) or comes from the
/// expected type of the result; it is `f32`, `f64`, `bf16`, `f16`, `i32`, `i64` or `bool`, exactly
/// the type given, or a struct or tuple whose fields are all pure data, which takes its element
/// type from the call (`from_bytes::<P>(b, [2])`) -- a declaration's parameters cannot mention a
/// type variable that only the result mentions. The element's bytes are its layout's, written as
/// `to_bytes` wrote them. A byte count that does not fit the shape is a fault. The bits are
/// copied: reading `bf16` or `f16` here passes the stored values through without rounding, so it
/// needs no numeric permission.
/// @pure
/// @fails fault `TensorDimensionMismatch` when the number of bytes does not fit the shape and the element type
/// @example from_bytes::<f32>(to_bytes([1.0, 2.0] as float[]), [2])
#op('tensor:from_bytes_*')
export func from_bytes::<T>(bytes: Bytes, shape: int[]): T[..] when is_plain::<T>()
