/**
 * Computed signatures of the `random` module (C++ operators, modules/random).
 *
 * `choice`, `sample` and `shuffle` take their result type from the element type of their array
 * argument; the `DynamicFuncTypeResolver` of modules/random is the one source of that signature,
 * so they are not declared in stdlib/random.cml. Their documentation and `#op` tags live here,
 * and scripts/stdlib-reference.mjs reads this file (the module's `computed:` entry) together
 * with stdlib/random.cml.
 *
 * For reference only: these declarations are not compiled. They are checked against the
 * operators the module registers, and docs/stdlib-reference.md is generated from them.
 */

/// One element of xs, drawn uniformly.
/// @effect advances the generator
/// @fails fault `InvalidArgument` when xs is empty
/// @example choice(['a', 'b', 'c'])    // 'b'
#op<'rand:choice'>
export func choice(xs: T[]): T

/// n elements of xs drawn without replacement, as a new array.
/// @effect advances the generator
/// @fails fault `InvalidArgument` when n is negative or above the number of elements
/// @example sample([1, 2, 3, 4], 2)    // [3, 1]
#op<'rand:sample'>
export func sample(xs: T[], n: int): T[]

/// The elements of xs in a random order, as a new array; xs is not changed.
/// @effect advances the generator
/// @example shuffle([1, 2, 3])    // [2, 3, 1]
#op<'rand:shuffle'>
export func shuffle(xs: T[]): T[]