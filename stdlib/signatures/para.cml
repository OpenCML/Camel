/**
 * Signatures of the `para` module (C++ operators, modules/para).
 *
 * The unordered counterparts of the built-in `foreach` and `reduce`: the scheduler may run the
 * calls of the function in any order and at the same time.
 *
 * For reference only: these declarations are not compiled. They are checked against the
 * operators the module registers, and docs/stdlib-reference.md is generated from them
 * (scripts/stdlib-reference.mjs).
 */

/// Calls f for every element; the calls have no order among them.
/// @effect what f does
/// @example xs->unordered_foreach<work>
with <f: (item: T) => void>
inner func unordered_foreach(xs: T[]): void {
    return ':mark/unordered_foreach_arr'
}

/// Combines the elements with f starting from initial; the order in which elements are
/// combined is not fixed, so f should be associative and commutative.
/// @effect what f does
/// @example xs->unordered_reduce<add, 0>
with <f: (acc: T, item: T) => T, initial: T>
inner func unordered_reduce(xs: T[]): T {
    return ':mark/unordered_reduce_arr'
}

/// Blocks until `parties` calls are waiting at the one meeting point of the process, or until
/// timeout_ms milliseconds have passed; returns how many calls met (after a timeout, how many
/// were waiting). A tool for showing that calls really run at the same time.
/// @effect waits for other calls
/// @fails fault `RuntimeError` when parties is below 1 or timeout_ms is negative
/// @example rendezvous(2, 1000)    // 2 when another call arrived in time
inner func rendezvous(parties: int, timeout_ms: int): int {
    return 'para:rendezvous'
}
