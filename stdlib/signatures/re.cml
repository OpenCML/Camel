/**
 * Signatures of the `re` module (C++ operators, modules/re).
 *
 * For reference only: these declarations are not compiled. They are checked against the
 * operators the module registers, and docs/stdlib-reference.md is generated from them
 * (scripts/stdlib-reference.mjs).
 */

/// Whether the regular expression (ECMAScript syntax) matches somewhere in text.
/// @pure
/// @fails fault `RegexInvalid` when pattern is not a regular expression
/// @example test('[0-9]+', 'room 42')    // true
inner func test(pattern: string, text: string): bool {
    return 're:test'
}
