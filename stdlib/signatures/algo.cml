/**
 * Signatures of the `algo` module (C++ operators, modules/algo).
 *
 * Sorting works on arrays of numbers (i32, int, f32, float) in ascending order. Each algorithm
 * comes in two forms: `xxx_sorted` returns a new array, `xxx_sort` sorts a `var` array in place.
 * To sort anything else, or by a key, use `sort_by` of the `array` module.
 *
 * For reference only: these declarations are not compiled. They are checked against the
 * operators the module registers, and docs/stdlib-reference.md is generated from them
 * (scripts/stdlib-reference.mjs).
 */

/// A sorted copy of xs (quicksort).
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example sorted([3, 1, 2])    // [1, 2, 3]
inner func sorted(xs: T[]): T[] {
    return 'algo:sorted'
}

/// A sorted copy of xs, by insertion sort.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example insert_sorted([3, 1, 2])    // [1, 2, 3]
inner func insert_sorted(xs: T[]): T[] {
    return 'algo:insert_sorted'
}

/// A sorted copy of xs, by quicksort.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example quick_sorted([3, 1, 2])    // [1, 2, 3]
inner func quick_sorted(xs: T[]): T[] {
    return 'algo:quick_sorted'
}

/// A sorted copy of xs, by merge sort.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example merge_sorted([3, 1, 2])    // [1, 2, 3]
inner func merge_sorted(xs: T[]): T[] {
    return 'algo:merge_sorted'
}

/// Sorts xs in place (quicksort) and returns it.
/// @effect changes its argument
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example sort(xs)    // xs is now sorted
inner func sort(var xs: T[]): T[] {
    return 'algo:sort'
}

/// Sorts xs in place by insertion sort and returns it.
/// @effect changes its argument
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example insert_sort(xs)    // xs is now sorted
inner func insert_sort(var xs: T[]): T[] {
    return 'algo:insert_sort'
}

/// Sorts xs in place by quicksort and returns it.
/// @effect changes its argument
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example quick_sort(xs)    // xs is now sorted
inner func quick_sort(var xs: T[]): T[] {
    return 'algo:quick_sort'
}

/// Sorts xs in place by merge sort and returns it.
/// @effect changes its argument
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example merge_sort(xs)    // xs is now sorted
inner func merge_sort(var xs: T[]): T[] {
    return 'algo:merge_sort'
}

/// The sorted array made of the elements of two sorted arrays of numbers.
/// @pure
/// @fails fault `OperandTypeUnsupported` when the elements are not numbers
/// @example merge_sorted_arrays([1, 4], [2, 3])    // [1, 2, 3, 4]
inner func merge_sorted_arrays(left: T[], right: T[]): T[] {
    return 'algo:merge_sorted_arrays'
}

/// The elements of the inner arrays, in order. The primitive behind `flatten` and `flat_map`
/// of the `array` module.
/// @pure
/// @example flatten([[1, 2], [3]])    // [1, 2, 3]
inner func flatten(xss: T[][]): T[] {
    return 'algo:flatten'
}

/// The first occurrence of every value, in order; values are compared as `==` compares them
/// (a NaN equals nothing, so every NaN is kept). The primitive behind `unique` of the `array`
/// module.
/// @pure
/// @example unique([3, 1, 3, 2, 1])    // [3, 1, 2]
inner func unique(xs: T[]): T[] {
    return 'algo:unique'
}

/// The positions of the keys in ascending order of key; equal keys keep their order (a stable
/// sort). Keys are numbers, strings (ordered by byte) or bools; NaN keys come last. The
/// primitive behind `sort_by` of the `array` module.
/// @pure
/// @example argsort([30, 10, 20])    // [1, 2, 0]
inner func argsort(keys: (i32 | int | f32 | float | bool | string)[]): int[] {
    return 'algo:argsort'
}
