/**
 * The computed signatures of the `json` module: `encode` and `decode_as`, whose types come from
 * a type rule rather than from a written signature. The C++ resolvers in `modules/json` are the
 * one source of these types; this file is for reference only (it is not compiled), and feeds
 * `docs/stdlib-reference.md` and the `--verify-ops` check for these two entries. The other ten
 * names of the module are declared in `stdlib/json.cml` (handover H115).
 */

/// The JSON text of a value, on one line. The type of the value must have a JSON form:
/// numbers, bool, string, null, and arrays, tuples, structs, sets and maps with string keys
/// of those; a function or a tensor is refused when the call is compiled.
/// @pure
/// @example encode([1, 2])    // '[1,2]'
export func encode(value: T): string

/// The JSON text of a value, indented by indent spaces per level; a negative indent gives one
/// line.
/// @pure
/// @example encode([1, 2], 2)    // '[\n  1,\n  2\n]'
export func encode(value: T, indent: int): string

/// The value a JSON text (or a Json decoded before) describes, decoded to the type of shape;
/// the value of shape is not read. The result is an error value when the JSON does not have
/// that type, or when the text nests deeper than the limit. A part of the shape typed `Json`
/// takes whatever is there.
/// @pure
/// @fails error value `JsonTypeError` when the text is JSON of another type (the message gives the path of the mismatch); error value `JsonParseError` when the text is not JSON; error value `JsonTooDeep` when the document nests deeper than the limit
/// @example decode_as<[] as Map<string, int>>('{"a": 1}')    // {a: 1}
with <shape: T>
export func decode_as(text: string): T!
with <shape: T>
export func decode_as(text: Json): T!