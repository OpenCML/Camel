/**
 * Export-time capability check: `relu` of an int64 tensor is valid ONNX (Relu
 * accepts integers since opset 14), but ONNX Runtime's CPU provider has no
 * int64 Relu kernel at opset 17. The export stops at the call instead of
 * producing a model that ONNX Runtime refuses to load. With the check
 * disabled (target 'none') the same model is written.
 *
 * The refusal is the error value of the export call: nothing handles it, so
 * writing it as the last statement of `main` makes it the program's result and
 * the exit reports it (design principles 3.9). The export that is expected to
 * succeed is dropped on purpose with `let _ =`.
 */
module export_capability_exemplar

import { reshape, relu, cast } from tensor
import { export_model } from onnx
import { get_env } from env

func counts(t: f32[..]): i64[..] {
    return relu(cast(t, 'int64') - 2)
}

func main(): void! sync {
    let x = reshape([1.0, 2.0, 3.0, 4.0] as f32[], [2, 2])
    println(counts(x))
    let _ = export_model(counts, x, get_env('ONNX_OUT_UNCHECKED'), [], 'none')
    println('written without the check')
    export_model(counts, x, get_env('ONNX_OUT'))
}
