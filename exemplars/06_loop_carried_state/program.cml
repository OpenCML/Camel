/**
 * Loop-carried graph state. A training loop is a recursion whose carried
 * state is the whole model: each step computes the gradient with
 * with_grad (a graph transformation, not a tape) and passes the
 * SGD-updated parameter struct to the next step. The loss falls step by step,
 * and the same program runs unchanged after std::opt.
 */

import { reshape, relu, mean } from tensor
import { with_grad } from autodiff
import { sgd } from nn

type Mlp = { w1: f32[..], b1: f32[..], w2: f32[..], b2: f32[..] }

with <m: Mlp>
func loss(x: f32[..]): float {
    let h = relu(x @ m.w1 + m.b1)
    let y = h @ m.w2 + m.b2
    return float(mean(y * y))
}

func train(m: Mlp, x: f32[..], step: int, steps: int): Mlp {
    return if step >= steps then m else sync {
        let vg = with_grad(loss)<m>(x)
        `step ${step} loss ${vg.0}`->println
        return train(sgd(m, vg.1, 0.1), x, step + 1, steps)
    }
}

func main(): int sync {
    let m = {
        w1: reshape<[2, 3]>([0.5, -0.25, 0.75, 1.0, -0.5, 0.25] as f32[]),
        b1: reshape<[3]>([0.1, 0.0, -0.1] as f32[]),
        w2: reshape<[3, 1]>([1.0, -1.0, 0.5] as f32[]),
        b2: reshape<[1]>([0.2] as f32[])
    }
    let x = reshape<[2, 2]>([1.0, 2.0, -1.0, 0.5] as f32[])
    let trained = train(m, x, 0, 5)
    `final loss ${loss<trained>(x)}`->println
    return 0
}
