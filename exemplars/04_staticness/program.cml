/**
 * Staticness. `run` recurses over the time axis of its input; its depth is
 * `shape(x)[1]`, which shape specialization turns into a constant, so
 * std::opt unrolls the recursion into straight-line code
 * (std::stats: no calls left) and the model exports. `shrink` recurses until
 * a value computed from the input is small: its depth is not static, so it
 * cannot unroll; because the recursive call is the last thing it does, it is a
 * loop over its argument and exports as an ONNX Loop. `pile` has the same
 * dynamic depth but uses the result of the recursive call. It is a linear
 * recursion (one recursive call, on one side of one if / else), which is a
 * pair of loops: one finds the last arguments and counts the calls, one
 * applies what is done with the result in reverse order; it exports as
 * ONNX Loops. `settle` is not of that shape: two branches decide whether it
 * calls itself, and the export stops with a diagnostic at the recursion.
 * Not supported and not shown here: a function that calls itself more than
 * once on one path (tree recursion); the export refuses it at the second
 * recursive call.
 */
module staticness

import { ones, zeros, shape, reshape, sum } from tensor
import { export_model } from onnx
import { get_env } from env

func run(t: int, steps: int, x: f32[..], h: f32[..]): f32[..] {
    let batch = shape(x)[0]
    let features = shape(x)[2]
    return if t >= steps then h else run(t + 1, steps, x, h + reshape(slice(x, 1, t, t + 1), [batch, features]))
}

func forward(x: f32[..]): f32[..] {
    return run(0, shape(x)[1], x, zeros([shape(x)[0], shape(x)[2]]))
}

func shrink(t: f32[..]): f32[..] {
    return if sum(t) > 1.0 then shrink(t * 0.5) else t
}

func pile(t: f32[..]): f32[..] {
    return if sum(t) > 1.0 then pile(t * 0.5) + t else t
}

func settle(t: f32[..]): f32[..] {
    return if sum(t) > 1.0 then (if sum(t * t) > 50.0 then t * 0.1 else settle(t * 0.5) + t) else t
}

func export_static(x: f32[..]): void! sync {
    let _ = export_model<out: get_env('ONNX_OUT')>(forward, x)
    println('exported forward')
    return null
}

func export_dynamic(x: f32[..]): void! sync {
    let _ = export_model<out: get_env('ONNX_OUT')>(shrink, x)
    println('exported shrink')
    return null
}

func export_linear(x: f32[..]): void! sync {
    let _ = export_model<out: get_env('ONNX_OUT')>(pile, x)
    println('exported pile')
    return null
}

/// `settle` is refused, and its refusal is this function's result: nothing
/// handles it, so writing the call as the result of the body carries it to the
/// exit of `main` (design principles 3.9).
func export_nontail(x: f32[..]): void! sync {
    return export_model<out: get_env('ONNX_OUT')>(settle, x)
}

/// No mode was asked for: nothing is exported and the result is not an error.
func no_mode(): void! {
    return null
}

func main(): void! sync {
    let x = ones([2, 3, 4])
    println(forward(x))
    let mode = get_env('MODE')
    return if mode == 'static' then sync {
        export_static(x)
    } else if mode == 'dynamic' then sync {
        export_dynamic(x)
    } else if mode == 'linear' then sync {
        export_linear(x)
    } else if mode == 'nontail' then sync {
        export_nontail(x)
    } else sync {
        no_mode()
    }
}
