/**
 * Structured control flow. The branch in `gate` depends on the model input
 * (an element read compared with a threshold), so it cannot be decided at
 * export time: it becomes an ONNX If with one subgraph per arm. Branches
 * whose condition is static are pruned before export instead. The JOIN's
 * contract (both arms produce a float32 tensor) is what makes the If valid.
 *
 * `gate` is written with its element type and shape (`f32[4]`), the terminal spelling: a bare
 * A parameter that writes no element type leaves it unstated, so `t[0]` had no type for `t[0] > 0.5`.
 */
module structured_control_flow

import { reshape, relu } from tensor
import { export_model } from onnx
import { get_env } from env

func gate(t: f32[4]): f32[4] {
    return if t[0] > 0.5 then relu(t) * 2.0 else t * (t[1] * 2.0) - 1.0
}

func main(): int sync {
    let x = reshape([1.0, -2.0, 3.0, 0.5] as f32[], [4])
    let y = gate(x)
    'camel gate={} {} {} {}'->format<y[0], y[1], y[2], y[3]>->println
    let _ = export_model<out: get_env('ONNX_OUT') ?? ''>((t: f32[..]): f32[..] => gate(t as f32[4]), x)
    println('exported')
    return 0
}
